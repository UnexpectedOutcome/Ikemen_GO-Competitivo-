;[ステージ名]　：Miku Polkka
;[制作者]　　　：Ts

;このファイルは「0から始めるMUGEN」様より、
;『stage0.sffを軽量化し、stage0.defを改造した「トレーニングルーム００」』
;を元に作成しております。

;========================================================
[Info]
name = "Miku Polkka"    ;ステージセレクト時の名前

;--------------------------------------------------------
[Camera]
startx         =  0     ;カメラＸ軸の位置（この場合の標準位置は画面中央上になる）
starty         =  0     ;カメラＹ軸の位置
boundleft      = -180   ;ステージ左側の長さ（負の数）
boundright     =  180   ;ステージ右側の長さ
boundhigh      = -170   ;ステージの高さ（負の数が上方向）
boundlow       =  0     ;下画面端の位置
verticalfollow =  0.7   ;縦方向スクロールを追うカメラスピード
tension        =  60    ;画面端からこの値以内に入ると横スクロールを開始する
floortension   =  110   ;地面からこの値より上に行くと縦スクロールを開始する

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -70          ;１Ｐキャラの初期位置Ｘ軸
p1starty =  0           ;１Ｐキャラの初期位置Ｙ軸
p1startz =  0           ;１Ｐキャラの初期位置Ｚ軸（下の[Scaling]の項目をいじれば変更可能）
p1facing =  1           ;１Ｐキャラの向き　これは右向き

;--- Player 2 ---
p2startx =  70          ;２Ｐキャラの初期位置Ｘ軸
p2starty =  0           ;２Ｐキャラの初期位置Ｙ軸
p2startz =  0           ;２Ｐキャラの初期位置Ｚ軸（下の[Scaling]の項目をいじれば変更可能）
p2facing = -1           ;２Ｐキャラの向き　これは左向き

;--- Common ---
leftbound  = -1000      ;ステージ左側の行動限界範囲
rightbound =  1000      ;ステージ右側の行動限界範囲
topbound   =  0         ;
botbound   =  0         ;

;--------------------------------------------------------
[Scaling]               ;ここの項目は特殊なステージ作る時以外はいじらなくて良い
topz     = 0            ;
botz     = 50           ;
topscale = 1            ;キャラの縮尺を設定できる（非推奨）
botscale = 1.2          ;

;--------------------------------------------------------
[Bound]
screenleft  = 15        ;左画面端の壁の存在距離
screenright = 15        ;右画面端の壁の存在距離

;--------------------------------------------------------
[StageInfo]
zoffset  = 220          ;キャラの立ち位置（値が小さいほど高い）
autoturn = 1            ;1だとキャラが自動的に相手の方に振り向く
resetBG  = 1            ;1だとラウンド終了後ごとに画像などを元の位置に戻す

HIres    = 1            ;Plus用追加記述

;--------------------------------------------------------
[Shadow]
color      =  80,80,80  ;影の色（数値が多いほど濃くなる）
yscale     =  -0.3      ;影の方向（数値を０未満に指定すると影が奥に伸びる）
reflect    =  0         ;キャラの姿を床に反射させるかどうか（1=反射,0=反射させない）
intensity  =  64        ;影の濃さ（0薄い、255濃い）
fade.range = -180,-30   ;影のフェードアウト設定（影の方向を奥側にした場合に特に有効）
                        ;※初めの値は影が完全に消える高さ、後ろの値は影が消え始める高さ

[Reflection]
intensity  =  0         ;反射の強さ(0から256)　デフォルトは0

;--------------------------------------------------------
[Music]
bgmusic  = sound/miku.mp3             ;ステージに流すBGM（プラグインに応じてVorbis,MP3,MIDIなど）
;bgmusic  = stages/Miku_Polkka/IevanPolkka_miku.mp3    ;フォルダに纏める奇特な方向け
bgvolume = 255                                        ;音量

;--------------------------------------------------------
[BGdef]
spr     = stages/Miku_Polkka.sff                      ;ステージ画像をまとめたスプライトファイル（ＳＦＦ）を指定
;spr     = stages/Miku_Polkka/Miku_Polkka.sff          ;フォルダに纏める奇特な方向け
debugbg = 0                                           ;1だとデバッグモード、製作終了したら0に戻す（必須）

;========================================================
;========================================================
;下に行くほど画像表示優先度が高くなります。複数絵ステージです。
;「　[BG *]　」を同じように下の順に加えれば、さらに増やせます。
;--------------------------------------------------------
;[BG 0]
;type        = normal    ;画像表示タイプ。Normal=静止画、Anim=アニメ画、Parallax=立体静止画（一点透視図法）
;spriteNo    = 0,0       ;画像ファイル（*.sff）の画像を表示。Animの時は必要無し
;layerNo     = 0         ;レイヤー属性。0=奥、1=手前に表示
;start       = 0,0       ;軸位置。このdefファイルで設定した軸位置から数える
;delta       = 0,0       ;キャラが動いた時のスクロールスピード。小数点以下可能
;trans       = none      ;透過処理。Add=加算処理（輝く半透明）,Add1=半透明,Sub=減算処理（影の半透明）,None=透過しない
;mask        = 0         ;画像の背景色を透過させるかどうか。1=Yes,0=No
;tile        = 0,0       ;タイル化して同じ画像を複数表示させるかどうか（それぞれX,Y）
;tilespacing = 0,0       ;タイル化した画像同士の間隔。
;ActionNo    = 0         ;使用するアニメのナンバー。
;velocity    = 0,0       ;画像の移動速度

;--------------------------------------------------------
;◆◇◆レイヤー記述◆◇◆
[BG 0] ;背景
type        = normal
spriteno    = 0,0
layerno     = 0
start       = -500,-170
delta       = 1,1
trans       = none
mask        = 0

[BG 1] ;影（ミク）
type        = normal
spriteno    = 1,0
layerno     = 0
start       = -500,-170
delta       = 1,1
trans       = none
mask        = 1

[BG 2] ;影（ネギ）
type        = anim
layerno     = 0
start       = -500,-170
delta       = 1,1
trans       = None
mask        = 0
ActionNo    = 1

[BG 3] ;髪
type        = normal
spriteno    = 2,0
layerno     = 0
start       = -500,-170
delta       = 1,1
trans       = none
mask        = 1

[BG 4] ;ネギ
type        = anim
layerno     = 0
start       = -500,-170
delta       = 1,1
trans       = None
mask        = 0
ActionNo    = 2

[BG 5] ;ミク
type        = normal
spriteno    = 4,0
layerno     = 0
start       = -500,-170
delta       = 1,1
trans       = none
mask        = 1

;--------------------------------------------------------
;◆◇◆アニメーション記述◆◇◆
[Begin Action 1] ;影のアニメーション
1,1,0,0,12    ;最上…影の高さ
1,2,0,0,2     ;高い
1,3,0,0,2     ;中上
1,4,0,0,2     ;中下
1,5,0,0,2     ;低い
1,6,0,0,2     ;最下
1,5,0,0,2     ;低い
1,4,0,0,2     ;中下
1,3,0,0,2     ;中上
1,2,0,0,2     ;高い
;       ↑
;     この列

[Begin Action 2] ;ネギのアニメーション
3,0,0,0,12    ;最上…ネギの高さ
3,1,0,0,2     ;高い
3,2,0,0,2     ;中上
3,3,0,0,2     ;中下
3,4,0,0,2     ;低い
3,5,0,0,2     ;最下
3,4,0,0,2     ;低い
3,3,0,0,2     ;中下
3,2,0,0,2     ;中上
3,1,0,0,2     ;高い
;       ↑
;     この列
;========================================================
