[INFO]
name = "Uchiha District"
displayname = "Uchiha District"
versiondate = 25,05,2021
mugenversion = 1.0
author = "Slayer"

;----------------------------------------------------------------------------
[CAMERA]
startx = 0
starty = 0
boundleft  =-224
boundright = 224
boundhigh  =-350
boundlow   = 0
verticalfollow = 0.9
floortension   = 90  
tension        = 80 
cuthigh        = 0
cutlow         = 0
overdrawhigh   = 28
overdrawlow    = 28
zoomin = 0.92 ;Nuevo
zoomout = 0.67
;----------------------------------------------------------------------------
[PLAYERINFO]     
;--- Player 1 ---
p1startx =-90    
p1starty = 0     
p1startz = 0     
p1facing = 1     

;--- Player 2 ---
p2startx = 90    
p2starty = 0     
p2startz = 0     
p2facing =-1     

;--- Common ---  
leftbound  =-1000
rightbound = 1000
topbound   = 0  
botbound   = 0  

;----------------------------------------------------------------------------
[SCALING]
topz     = 0  
botz     = 50 
topscale = 1  
botscale = 1.2

;----------------------------------------------------------------------------
[BOUND]
screenleft  = 22
screenright = 22

;----------------------------------------------------------------------------
[STAGEINFO]
localcoord = 320,240
zoffset  = 216
autoturn = 1
resetBG  = 0
xscale   = 1
yscale   = 1
portraitscale = 1

;----------------------------------------------------------------------------
[SHADOW]
intensity = 128
color = 0,0,0
yscale = 0.08
fade.range =-150,0

;----------------------------------------------------------------------------
[REFLECTION]
intensity = 0

;----------------------------------------------------------------------------
[MUSIC]
bgmusic  = sound/prinny.mp3
bgmvolume= 100
bgmloopstart= 6177833
bgmloopend  = 12011827

;----------------------------------------------------------------------------
[BGDEF]
spr = NNC3-UchihaDistrict.sff
debugbg = 0

;----------------------------------------------------------------------------
;-IKEMEN GO ONLY, Select screen animation
[Begin Action 9000]
9000,1, 0,0,-1
;------------------------------------------

[BG SKY]
type  = normal
spriteno = 1,0
start = 0,0
delta = 0.4,0.4
mask  = 1


[BG MOUNTAIN]
type  = normal
spriteno = 1,1
start = 0,0
delta = 0.65,0.65
mask  = 1


[BG BACK]
type  = normal
spriteno = 2,0
start = 0,0
delta = 0.93,0.93
mask  = 1


[BG HOUSE]
type  = normal
spriteno = 2,1
start = 0,0
delta = 0.96,0.96 
mask  = 1


[BG TREE]
type  = normal
spriteno = 2,2
start = 0,0
delta = 0.97,0.97 
mask  = 1


[BG MAIN]
