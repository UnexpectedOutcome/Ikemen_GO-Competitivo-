;철권5 달빛 스테이지

[Info]   
name = "UK - Moonlit Wilderness"
;This version created by:  enzo25
;All sprites, etc.. acquired or created by Hihoshi
;originally created by 악당(akdang)
;homepage : http://akdang.xo.st
;Special Thanks to Most Unbalance & Envymask666

[Camera]      ;카메라의 시작위치 그냥냅두는게좋다. 
startx = 0    ;카메라 x좌표의 시작위치 <-옆-> 값이 낮을수록 왼쪽으로간다.
starty = 0    ;카메라 y좌표의 시작위치 위,아래 값이 낮을수록 위로올라간다.

boundleft = -90   ;배경의 전체길이 왼쪽길이조정 늘리려면 값을낮게..
boundright = 90  ;배경의 전체길이 오른쪽길이조정 늘리려면 값을높게..
boundhigh = -100   ;배경의 최고높이.. 수치가 낮을수록 높아진다.
boundlow = 0       ;배경의 최저수치.. 높을수록 최저높이가 낮아진다..(당연한가 -_-;)

verticalfollow = .50
floortension = 45    
tension = 60        

[PlayerInfo]     ;캐릭터의 처음위치를 지정한다.
p1startx = -70   ;1플레이어의 x좌표의 시작위치 <-옆-> 값이 낮을수록 왼쪽으로간다. 
p1starty = 0     ;1플레이어의 y좌표의 시작위치 위,아래 값이 낮을수록 위로올라간다.
p1startz = 0     ;1플레이어의 z좌표의 시작위치 헌데 z좌표가 뭣이다냐;;
p1facing = 1     ;플레이어가 마주볼것인지에 대한설정 : 1=오른쪽을향함.(기본), -1=왼쪽을향한다
p2startx = 70    ;2플레이어의 x좌표의 시작위치 <-옆-> 값이 낮을수록 왼쪽으로간다. 
p2starty = 0     ;2플레이어의 y좌표의 시작위치 위,아래 값이 낮을수록 위로올라간다.
p2startz = 0     ;2플레이어의 z좌표의 시작위치 z좌표라니 음음...;
p2facing = -1    ;플레이어가 마주볼것인지에 대한설정  : 1=오른쪽을향함., -1=왼쪽을향한다(기본)

leftbound = -1000 
rightbound = 1000 
topbound = 0
botbound = 0 


[Scaling]         ;잘은 모르겠지만 배경안의 캐릭터의 크기조절옵션같다.. 내경우에는 쓸일이 없어서;;
topz = 0          ;Top z-coordinate for scaling늘리는 것을 위한 최고 z-coordinate
botz = 50         ;Bottom z-coordinate for scaling늘리는 것을 위한 장정한 z-coordinate
topscale = 1      ;Scale to use at top꼭대기에(서) 사용할 저울
botscale = 1.2    ;Scale to use at bottom바닥에(서) 사용할 저울


[Bound]             ;캐릭터가 화면끝까지 움직일수있는범위 15가 기본값 
screenleft = 15     ;왼쪽
screenright = 15    ;오른쪽


[StageInfo]
zoffset = 216        ;캐릭터가 서있는위치 위,아래로만 조정가능하다.
autoturn = 1         ;뭘까..;;
resetBG = 1          ;한라운드가 끝난후 배경을 초기형태로 1-yes 0-no  
hires = 1


[Shadow]             ;그림자 설정관련
color = 92,92,92     ;rgb코드같은데.. 모르겠다 --;
yscale = .3          ;그림자의 길이...  참고로 숫자수치에 마침표(.)가 붙으면 소수점으로 인식된다. 
reflect = 0          ;그림자를 투명처리  물에비치는것처럼.. 

[Music]                                  ;배경음악설정 안써주거나 경로가 틀리면 음악이안나온다..(당연한가..;)
bgmusic = sound/UK - Moonlit Wilderness.mp3             ;음악경로설정 mp3,mid등등이 지원되나? --;;
bgvolume = 255                           ;음악볼륨

[BGdef] 
spr = stages/UK - Moonlit Wilderness.sff              ;배경에쓰일 스프라이트파일sff의 위치 
debugbg = 0          

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;[BG XX] <-- 이옵션은 스프라이트의 상태,위치,애니메이션,기타옵션설정을 하는것이다.
;;            XX부분에 알아볼수있게 아무이름이나 써주면 되겠다.. 대신 같은이름이 2개이상이면 안됀다.  
;;            [BG XX]아래에 쓰일옵션
;; [BG xx]
;; type = ?       "Normal"/"Parallax"/"Height"   (def:"Normal")
;; spriteno = ?, ? 나타낼 스프라이트의 그룹넘버와 이미지넘버 mcm으로 넘버를 작성할수있다. 
;; start = ?, ?   스프라이트의 시작위치 (쓰지않을시의 기본값: 0, 0)
;; delta = ?, ?   원근감-_-; 설명이 힘들다. 직접수치를 바꿔보면 해본다면 이해하기쉬울것이다.  (기본값: 1,1)
;; trans = ?      투명효과: "none"(사용안함)/"add"(투명효과)/"sub"(모름..;)/"avg"(얘도;) (기본값: "none")
;; mask = ?       팔렛의 마지막 칼라를 투명색으로 사용할것인가에 대한설정 : 0 - 안해, 1 - 한다  (기본값: 0)
;; velocity = ?, ? 속력: x, y (흐르는거시기): 좌우상하로 스프를 움직이게 할수있다 (기본값: 0, 0)
;; tile = ?, ?    Tiling: xtile, ytile (int): 0 - 안해, 1 - 무한반복,
;;                        >1 - tile that number of times  (def: 0, 0)
                  타일... 잘모르겠다;; 수행부족이다.. velocity명령에 같이쓰인다; 정확한용도는 잘..--;
;; tilespacing = ?, ? Tiling: x, y (int) : velocity를 쓸때 무한반복될시의 딜레이다..  (def: 0, 0)
;;  Parallax-only: Parallax명령에만쓰이는 옵션... 이거.. 쓰기가 애매하다.. 스파시리즈배경의 바닥울렁거림을 표현할때 주로쓰인다.. 필자도 대충대충껄렁껄렁사용하므로 자세한언급은 피한다 (후다닥)
;; xscale = ?, ?    Top xscale, bottom xscale (float) (if used, then no tiling)
;; width = ?, ?     Top width, bottom width (int)  (if used, then tiles;
;;                             use either this or above, but not both)
;; yscalestart = ?  Starting y-scale (float, in percent)  (def: 100)
;; yscaledelta = ?  Change in y-scale per unit (float, in percent)  (def: 0)  
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
