[info]
name = "Sky Secret(Z)"
author = "Roach / Brujolino"
Author.Edit = "KenJou_Lirt"
AttachedChar= attachedchar\KI.chr
;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -100
boundright = 100
boundhigh = -200
boundlow = -11
verticalfollow = 1
floortension=88
tension = 60
startzoom = 1
zoomin = 1
zoomout = .7
tensionhigh = 90
tensionlow = 20

;--------------------------------------------------------

[PlayerInfo]
p1startx = -80          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 80
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1100 ;Left bound (x-movement)
rightbound =  1100 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

;--------------------------------------------------------
[Bound]
screenleft = 30    ;Dist from left of screen that player can move to
screenright = 30   ;Right edge

;--------------------------------------------------------
[StageInfo]
zoffset        = 220
zoffsetlink    = 1
autoturn       = 1
resetBG        = 1

;--------------------------------------------------------
[Shadow]
intensity = 33
color = 128,128,128
yscale = 1
fade.range = -400,-100

;--------------------------------------------------------
[Music]

bgmusic = .\stages\Nintendo\KI\Orchid.mp3
bgvolume = 255
bgmloop = 1

;--------------------------------------------------------
[BGdef]
spr = KI_SKY-STAGE.sff
debugbg = 0

;--------------------------

[BG SKY GOING down]
type  = normal
spriteno = 2,1
layerno = 0
start = 0,0
delta = .0,.1 ;.403 ;.20,.430
trans = none
mask  = 1 
velocity = 0,1
tile = 1, 1
tilespacing = 0,0
zoomdelta = .0

;--------------------------------------------------------

[BG SKY GOING UP]
type  = anim
actionno = 0
layerno = 0
start = 100,120
delta = .0,.1 ;.403 ;.20,.430
trans = none
mask  = 1 
velocity = 0
tile = 1, 1
tilespacing = 0, 400
window = 0,0, 319, 120
zoomdelta = .0

[BG SKY GOING UP]
type  = anim
actionno = 0
layerno = 0
start = -156,120
delta = .0,.1 ;.403 ;.20,.430
trans = none
mask  = 1 
velocity = 0
tile = 1, 1
tilespacing = 0, 400
window = 0,0, 319, 120
zoomdelta = .0

;--------------------------

[BG LIGHT]
type  = normal
spriteno = 1,0
start = 0,0
delta = .0,.0 ;.403
mask = 1
tile = 1,0
trans = add
zoomdelta = .0

;--------------------------

[BG FLOOR]
type = parallax
spriteno = 0,0
start = 0,0
xscale = 1,1.643   
mask  = 1
delta = .65,1  

