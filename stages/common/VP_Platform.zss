	if player(map(_vnix_skeleton_hit)), helperVar(helpertype) != 1 && player(map(_vnix_skeleton_hit)), playerNo = player(map(_vnix_skeleton_hit)), teamLeader {		
		powerAdd{value: 200; redirectID: player(map(_vnix_skeleton_hit)), ID;}
