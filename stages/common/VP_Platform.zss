juggle: 4; velset: 0, 0; facep2: 1;
anim: 13; ctrl: 0; sprpriority: 2;]

if time = 0 {
	playSnd{value: 0, 9; volume: 200;}
	playSnd{value: 0, 10; volume: 200;}
	playSnd{value: 0, 10; volume: 200;}
	explod{
		anim: 2;
		postype: p1;
		pos: 0,0;
		scale: .25,.25;
		angle: 0;
		facing: 1;
		ontop: 0;
		sprpriority: -5;
		removetime: -2;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
	palFx{time: 30; add: 225,225,225; sinadd: -225,-225,-225,120; redirectID: player(map(_vnix_bat_hit)), ID;}
}

palfx{time: 1; hue: map(_vnix_bat_color);}

if time <= 60 {
	trans{
		trans: addalpha;
		alpha: 256 - (time * 4.2667), time * 4.2667;
	}
}

if time = 5 {
	if player(map(_vnix_bat_hit)), helperVar(helpertype) != 1 && player(map(_vnix_bat_hit)), playerNo = player(map(_vnix_bat_hit)), teamLeader {		
		powerAdd{value: 200; redirectID: player(map(_vnix_bat_hit)), ID;}
	}
}

if time = 5 {	
	destroySelf{}
}


