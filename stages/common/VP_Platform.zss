#-------------------------------------------------------------------------------
# Attack
[StateDef 65123; type: S; movetype: I; physics: N;
juggle: 4; velset: 0, 0; facep2: 1;
anim: 16; ctrl: 0; sprpriority: 2;]

hitOverride{attr: SCA,AA,AP,AT; stateno: 65122; time: -1; forceair: 1;}

if animElem = 5 {
	playSnd{value: 0, 14; volume: 200;}
	playSnd{value: 0, 14; volume: 200;}
}

if animElem = 6 || animElem = 7 {
	stateTypeSet{movetype: A;}
	hitDef{
		attr: S, SA;
		damage: 10,3;
		animtype: Medium; 
		guardflag: MA;
		hitflag: MAFD;
		priority: 3;
		pausetime: 20,10;
		sparkno: 1;
		sparkxy: 0,-20;
		hitsound: S 0, 15;
		guardsound: F 6,0; 
		ground.type: Low;
		ground.slidetime: 18;
		ground.hittime: 20;
		ground.velocity: 0;
		air.type: High;
		air.velocity: -3,-1.5;
	}
} else {
	stateTypeSet{movetype: I;}
}

palfx{time: 1; hue: map(_vnix_skeleton_color);}

velset{x: 0; y: 0}

if animTime = 0 || moveGuarded || moveContact {
	changestate{value: 65121; ctrl: 0;}
}

if roundState = 3 || stageFrontEdgeDist < 10 || stageBackEdgeDist < 10 {	
	destroySelf{}
}

# ========================================================================================================================================

[Statedef 175; anim:-2;]

[Statedef 5900; anim:-2;]
changestate{value:0;}

# ==================================================

[Statedef -4] 
ignorehitpause {
	if roundState = 0 && time = 0 {
		# Run Config
		call F_Vnix_Platform_Config();
		# Reset Maps
		map(_vnix_crystal_power) := 0;
		for i = 1; 8; 1 {
			if playerNoExist($i) {
				player($i), map(_vnix_potion_power) := 0;
				player($i), map(_vnix_potion_agility) := 0;
				player($i), map(_vnix_weapon_sword) := 0;
				player($i), map(_vnix_weapon_shield) := 0;
				player($i), map(_vnix_weapon_cloak) := 0;
			}
		}
	}
	screenBound{value: 0; movecamera: 0,0}
	if roundState != 2 {
		assertSpecial{flag: invisible;}
	}
	assertSpecial{flag: noturntarget; flag2: noinput}
	#notHitBy{value: SCA}
	width{value: 0,0}

	
	for i = 1; 8; 1 {
		if playerNoExist($i) && helperVar(helpertype) != 1 {
			if roundState = [0,1] {
				groundLevelOffset{value: 0; redirectID: player($i), ID;}
				posSet{y: 0; redirectID: player($i), ID;}
			}
			if roundState > 1 {
				# Inputs
				# Decrease input timers
				if player($i), map(_vnix_platform_cmd_222) > 0 && gameTime % 5 = 0 {
					mapadd{map: "_vnix_platform_cmd_222"; value: -1; redirectID: player($i), ID;}
				}

				if player($i), inputtime(D) = 1 && cond(player($i), teamMode = Tag, player($i), playerNo = player($i), teamleader, 1) {
					mapAdd{map: "_vnix_platform_cmd_222"; value: 8; redirectID: player($i), ID;}
				}

				# Only D is allowed
				if player($i), inputtime(B) > 0 || player($i), inputtime(F) > 0 || player($i), inputtime(U) > 0 || player($i), stateNo = 52 || (player($i), stateNo = 50 && player($i), time >= 10) {
					mapset{map: "_vnix_platform_cmd_222"; value: 0; redirectID: player($i), ID;}
				}
				
				# AI Precaution
				if player($i), AILevel > 0 && player($i), moveType = I && (player($i), stateType = S || player($i), stateType = C) && gameTime % 5 = 0
				&& (player($i), pos y + player($i), groundLevel) < (player($i), enemy, pos y + player($i), enemy, groundLevel) {
					mapset{map: "_vnix_platform_cmd_222"; value: 50; redirectID: player($i), ID;}
				}
				
				if roundstate = 2 {
					if player($i), playerNo = player($i), teamLeader && player($i), alive {
						zoom{
							scale: 1.0;
							time: 1;
							pos: ((player($i), pos x + player($i), cameraPos x) + (player($i), p2, pos x + player($i), p2, cameraPos x)) / 2.0,
								 max(stagevar(camera.boundhigh), ((player($i), pos y + player($i), groundLevel) + (player($i), p2, pos y + player($i), p2, groundLevel)) / 8.0);
							lag: 0.92;
							stagebound: 1;
							camerabound: 1;
						}
					}
					if player($i), map(_vnix_aircontrol_cfg_enable) && player($i), getHitVar(isbound) = 0 && player($i), incustomstate = 0 {
						if player($i), vel y < 0 && player($i), moveType != H && player($i), moveType != A
						&& (player($i), pos y + player($i), groundLevel) >= -500 && player($i), alive
						{
							velAdd{y: -.1 + ((-1 + (player($i), life * 1.0 / player($i), lifeMax)) * 0.2); redirectID: player($i), ID;}
						}
						if player($i), stateType = A && player($i), moveType != H && player($i), vel x <= 4 && player($i), command = "holdfwd" && player($i), ctrl = 1 {
							velAdd{x: .2; redirectID: player($i), ID;}
						}
						if player($i), stateType = A && player($i), moveType != H && player($i), vel x >= -4 && player($i), command = "holdback" && player($i), ctrl = 1 {
							velAdd{x: -.2; redirectID: player($i), ID;}
						}
					}
					
					# Double Jump Ability in VP_Plains
					if stagevar(info.name) = "V-Nix Plains" {
						if player($i), map(_vnix_double_jump) && player($i), stateType = A && player($i), moveType = I {
							if player($i), player($i), inputTime(F) = 1 && player($i), inputTime(U) = 1 {
								velSet{x: 5; y: -8; redirectID: player($i), ID;}
								player($i), map(_vnix_double_jump) := 0;
								palfx{time: 30; add: 255,255,255; sinadd: -255,-255,-255,120; redirectID: player($i), ID;}
								lifebarAction{text: "Double Jump"; redirectID: player($i), ID;}
								selfState{value: 50; ctrl: 1; redirectID: player($i), ID;}
							}
							if player($i), player($i), inputTime(B) = 1 && player($i), inputTime(U) = 1 {
								velSet{x: -5; y: -8; redirectID: player($i), ID;}
								player($i), map(_vnix_double_jump) := 0;
								palfx{time: 30; add: 255,255,255; sinadd: -255,-255,-255,120; redirectID: player($i), ID;}
								lifebarAction{text: "Double Jump"; redirectID: player($i), ID;}
								selfState{value: 50; ctrl: 1; redirectID: player($i), ID;}
							}
							if player($i), inputTime(U) = 1 {
								velSet{y: -8; redirectID: player($i), ID;}
								player($i), map(_vnix_double_jump) := 0;
								palfx{time: 30; add: 255,255,255; sinadd: -255,-255,-255,120; redirectID: player($i), ID;}
								lifebarAction{text: "Double Jump"; redirectID: player($i), ID;}
								selfState{value: 50; ctrl: 1; redirectID: player($i), ID;}
							}
						}
						# Reset Double Jump Stock
						if player($i), stateType = S {
							player($i), map(_vnix_double_jump) := 1;
						}
					}
				}
			}
			
			if roundState = 3 {
				if player($i), alive && player($i), stateType != A {
					posFreeze{redirectID: player($i), ID;}
					velSet{x: 0; y: 0; redirectID: player($i), ID;}
					#posSet{y: 0; redirectID: player($i), ID;}
				}
			}
		}
	}
}

# Buffs
for i = 1; 8; 1 {
	if playerNoExist($i) {
		ignorehitpause if player($i), ishelper = 0 && (player($i), teamside = 1 || player($i), teamside = 2) {
			# Strength Potion
			if player($i), map(_vnix_potion_power) {
				palfx{time: 1; add: 125, 60, 0; redirectID: player($i), ID;}
				if player($i), enemy, getHitVar(frame) && player($i), enemy, getHitVar(guarded) = 0 && player($i), enemy, getHitVar(attr) = SCA, AA, AP {
					lifeAdd{value: player($i), enemy, getHitVar(damage) * -0.2; absolute: 1; kill: 0; redirectID: player($i), enemy, ID;}
					if player($i), map(_vnix_potion_power_cd) = 0 {
						mapAdd{map: "_vnix_potion_power"; value: -1; redirectID: player($i), ID;}
						player($i), map(_vnix_potion_power_cd) := 1;
					}
				} else {
					player($i), map(_vnix_potion_power_cd) := 0;
				}
			}
			# Agility Potion
			if player($i), map(_vnix_potion_agility) {
				if player($i), map(_vnix_potion_agility) > 0 && helperVar(helpertype) != 1 {
					mapAdd{map: "_vnix_potion_agility"; value: -1; redirectID: player($i), ID;}
				}
				palfx{time: 1; add: 125, 0, 125; redirectID: player($i), ID;}
				modifyPlayer{hitpausetime: 0; redirectID: player($i), ID;}
				if (player($i), stateno = 20 || player($i), stateno = 50 || player($i), stateno = 100) && player($i), pauseTime = 0  {
					posadd{x: player($i), vel x * 0.3; redirectID: player($i), ID;}
				}
			}
			# Sword
			if player($i), map(_vnix_weapon_sword) {
				palfx{time: 1; add: 125, 0, 0; redirectID: player($i), ID;}
				assertSpecial{flag: unguardable; redirectID: player($i), ID;}
				if player($i), enemy, getHitVar(frame) && player($i), enemy, getHitVar(guarded) = 0 && player($i), enemy, getHitVar(attr) = SCA, AA {
					if player($i), map(_vnix_weapon_sword_cd) = 0 {
						mapAdd{map: "_vnix_weapon_sword"; value: -1; redirectID: player($i), ID;}
						player($i), map(_vnix_weapon_sword_cd) := 1;
					}
				} else {
					player($i), map(_vnix_weapon_sword_cd) := 0;
				}
			}
			# Shield
			if player($i), map(_vnix_weapon_shield) {
				palfx{time: 1; add: 0, 0, 125; redirectID: player($i), ID;}
				if player($i), getHitVar(frame) && player($i), getHitVar(guarded) = 0 && player($i), getHitVar(attr) = SCA, AA, AP {
					if player($i), map(_vnix_weapon_shield_cd) = 0 {
						getHitVarSet{damage: 1; redirectID: player($i), ID;}
						mapAdd{map: "_vnix_weapon_shield"; value: -1; redirectID: player($i), ID;}
						player($i), map(_vnix_weapon_shield_cd) := 1;
					}
				} else {
					player($i), map(_vnix_weapon_shield_cd) := 0;
				}
			}
			# Cloak
			if player($i), map(_vnix_weapon_cloak) {
				if player($i), map(_vnix_weapon_cloak) > 0 && helperVar(helpertype) != 1 {
					mapAdd{map: "_vnix_weapon_cloak"; value: -1; redirectID: player($i), ID;}
				}
				notHitBy{value: SCA; redirectID: player($i), ID;}
				palfx{time: 1; add: 0, 125, 0; redirectID: player($i), ID;}
			}
			# Crystal Buff
			if player($i), map(_vnix_crystal_buff) {
				if player($i), map(_vnix_crystal_buff) > 0 && helperVar(helpertype) != 1 {
					mapAdd{map: "_vnix_crystal_buff"; value: -1; redirectID: player($i), ID;}
				}
				modifyPlayer{hitpausetime: 0; redirectID: player($i), ID;}
				powerSet{value: player($i), powerMax; redirectID: player($i), ID;}
				assertSpecial{flag: unguardable; redirectID: player($i), ID;}
				if (player($i), stateno = 20 || player($i), stateno = 50 || player($i), stateno = 100) && player($i), pauseTime = 0  {
					posadd{x: player($i), vel x * 0.3; redirectID: player($i), ID;}
				}
				palfx{time: 1; add: 30, 30, 30; redirectID: player($i), ID;}
				if helperVar(helpertype) != 1 {
					explod{
						anim: player($i), anim;
						animfreeze: 1;
						animelem: player($i), animelemno(0);
						postype: none;
						pos: 0,0;
						bindID: player($i), ID;
						scale: 1 * player($i), const(size.xscale), 1 * player($i), const(size.yscale);
						angle: player($i), angle;
						facing: player($i), facing;
						ontop: 0;
						removetime: 10;
						sprpriority: player($i), sprpriority - 1;
						pausemovetime: -1;
						supermovetime: -1;
						ownpal: 1;
						palfx.time: -1;
						trans: addalpha;
						alpha: 128,256;
						interpolation.time: 10;
						interpolation.alpha: 0,256;
						redirectID: player($i), ID;
					}
				}
			}
		}
	}
}

[StateDef +1]
ignorehitpause {

	for i = 1; 8; 1 {
		if playerNoExist($i) {
			if roundState > 1 {
				if player($i), map(_vnix_platform_a) = 0 && player($i), map(_vnix_platform_b) = 0 && player($i), map(_vnix_platform_c) = 0
				&& player($i), pos y < 0 && player($i), moveType != H && player($i), stateType != A {
					stateTypeSet{statetype: A; physics: A; redirectID: player($i), ID;}
					if player($i), stateNo != 50 {
						selfState{value: 50; redirectID: player($i), ID;}
					}
				}
			}
			
			if roundState > 2 && player($i), alive {
				groundLevelOffset{value: 0; redirectID: player($i), ID;}
			}
		}
	}
}
