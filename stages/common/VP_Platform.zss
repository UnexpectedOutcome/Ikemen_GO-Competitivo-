		value: 1;
	}
	modifyBGCtrl {
		id: 2;
		time: 0,0;
		value: 0;
	}
}

for i = 1; 8; 1 {
	if playerNoExist($i) {
		if (player($i), pos x + player($i), cameraPos x) = [340, 420] && (player($i), pos y + player($i), groundLevel) = -138
		&& player($i), moveType = I && player($i), stateType != A && player($i), power >= 1000 && player($i), isHelper = 0 {
			if cond(player($i), AILevel = 0, player($i), inputTime(s) = 1, 1) {
				if random = [0, 199] {
					map(_vnix_player_agility) := player($i), playerNo;
					changeState{value: 65023;}				
				} else if random = [200, 600] {
					map(_vnix_player_power) := player($i), playerNo;
					changeState{value: 65022;}
				} else {
					if player($i), life <= player($i), life * 0.75 {
						map(_vnix_player_heal) := player($i), playerNo;
						changeState{value: 65021;}
					} else {
						if random = [0, 300] {
							map(_vnix_player_agility) := player($i), playerNo;
							changeState{value: 65023;}				
						} else {
							map(_vnix_player_power) := player($i), playerNo;
							changeState{value: 65022;}
						}					
					}
				}
			}
		}
	}
}

