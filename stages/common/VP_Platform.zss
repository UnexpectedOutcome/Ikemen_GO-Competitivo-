
#===============================================================================
# Configuration
#===============================================================================

[Function F_Vnix_Platform_Config()]

for i = 1; 8; 1 {
	if playerNoExist($i) {
		mapset{map: "_vnix_aircontrol_cfg_enable"; value: 1; redirectID: player($i), ID;}			# Enable Air Acceleration, 0 to disable
		mapset{map: "_vnix_plathold_cfg_enable"; value: 0; redirectID: player($i), ID;}				# Enable Platform Ledge Hold, 0 to disable
	}
}

mapset{map: "_vnix_enemy_cfg_enable"; value: 1;}													# Enable Enemies, 0 to disable

#===============================================================================

[Statedef 0; anim:-2;]

if roundState > 1 {
	if stagevar(info.name) = "V-Nix Miiverse" {
		# Platform A
		persistent(0) if numHelper(64000) = 0 {
			helper{id: 64000; stateno: 64000;}
		}

		# Platform B
		persistent(0) if numHelper(64010) = 0 {
			helper{id: 64010; stateno: 64010;}
		}

		# Platform C
		persistent(0) if numHelper(64020) = 0 {
			helper{id: 64020; stateno: 64020;}
		}
		
		# Main Platform
		persistent(0) if numHelper(64100) = 0 {
			helper{id: 64100; stateno: 64100;}
		}
	}
	
	if stagevar(info.name) = "V-Nix Plains" {
		# Platform A
		persistent(0) if numHelper(65000) = 0 {
			helper{id: 65000; stateno: 65000;}
		}
	}
}

if stagevar(info.name) = "V-Nix Plains" {
	# Crystal
	persistent(0) if numHelper(65010) = 0 {
		helper{id: 65010; stateno: 65010;}
	}
	# Shop
	persistent(0) if numHelper(65020) = 0 {
		helper{id: 65020; stateno: 65020;}
	}
	# Weapon Shop
	persistent(0) if numHelper(65030) = 0 {
		helper{id: 65030; stateno: 65030;}
	}
	
	# Enemy Monsters
	if roundState = 2 {
		if map(_vnix_enemy_cfg_enable) {
			if numHelper(65100) < 8 && gameTime % 300 = 0 {
				if random = [0, 300] {
					helper{
						helpertype: normal;
						id: 65100;
						stateno: 65110;
						name: "Bat Monster";
						postype: p1;
						pos: randomRange(-400,400), cond(random <= 500, 0, -138);
						supermovetime: 0;
						pausemovetime: 0;
						size.xscale: .75;
						size.yscale: .75;
						ownclsnscale: 1;
						ownpal: 1;
					}
				} else if random = [301, 600] {
					helper{
						helpertype: normal;
						id: 65100;
						stateno: 65120;
						name: "Skeleton Monster";
						postype: p1;
						pos: randomRange(-400,400), cond(random <= 500, 0, -138);
						supermovetime: 0;
						pausemovetime: 0;
						size.xscale: .55;
						size.yscale: .55;
						ownclsnscale: 1;
						ownpal: 1;
					}
				} else {
					helper{
						helpertype: normal;
						id: 65100;
						stateno: 65100;
						name: "Slime Monster";
						postype: p1;
						pos: randomRange(-400,400), cond(random <= 500, 0, -138);
						supermovetime: 0;
						pausemovetime: 0;
						size.xscale: .5;
						size.yscale: .5;
						ownclsnscale: 1;
						ownpal: 1;
					}		
				}
			}
		}
	}
	
	if time = 0 || gameTime % 780 = 0 {
		playSnd{value: 0, 3; volume: 200;}
	}
	if time = 0 || gameTime % 170 = 0 {
		playSnd{value: 0, 4; volume: 200;}
	}
}

# ========================================================================================================================================
# Platfrom A - Miiverse
[StateDef 64000; anim: -2;]

for i = 1 ; 8; 1 {
	if playerNoExist($i) {
		if (player($i), pos x + player($i), cameraPos x) = [-495, -90] && (player($i), pos y + player($i), groundLevel) = [-120, -107]
		&& player($i), getHitVar(isbound) = 0 && player($i), p2, getHitVar(isbound) = 0 && player($i), incustomstate = 0 {
			player($i), map(_vnix_platform_a) := 1;
			player($i), map(_vnix_platform_b) := 0;
			player($i), map(_vnix_platform_c) := 0;
		}
		
		if player($i), map(_vnix_platform_a) {
			groundLevelOffset{value: -107; redirectID: player($i), ID;}
		}
		
		if player($i), map(_vnix_platform_cmd_222) > 20 {
			groundLevelOffset{value: 0; redirectID: player($i), ID;}
			player($i), map(_vnix_platform_a) := 0;	
		}
		
		# Ledges
		if player($i), map(_vnix_plathold_cfg_enable) {
			if (player($i), pos x + player($i), cameraPos x) = [-550, -496] && (player($i), pos y + player($i), groundLevel) = [-20, -10]
			&& player($i), moveType != H && player($i), map(_vnix_platform_a_left) = 0 && player($i), vel y > 0 {
				playSnd{value: 0, 1; volume: 200;}
				palfx{time: 30; add: 255,255,255; sinadd: -255,-255,-255,120; redirectID: player($i), ID;}
				player($i), map(_vnix_platform_a_left) := 1;
			}
			
			if (player($i), pos x + player($i), cameraPos x) = [-90, -60] && (player($i), pos y + player($i), groundLevel) = [-20, -10]
			&& player($i), moveType != H && player($i), map(_vnix_platform_a_right) = 0 && player($i), vel y > 0 {
				playSnd{value: 0, 1; volume: 200;}
				palfx{time: 30; add: 255,255,255; sinadd: -255,-255,-255,120; redirectID: player($i), ID;}
				player($i), map(_vnix_platform_a_right) := 1;
			}
			
			# Holding Ledge
			if player($i), map(_vnix_platform_a_left) {
				if player($i), facing = -1 {
					turn{redirectID: player($i), ID;}
				}
				posSet{y: -10; redirectID: player($i), ID;}
				velSet{x: 0; y: 0; redirectID: player($i), ID;}
				
				# StateNo while holding
				if player($i), stateNo != 50 {
					selfState{value: 50; redirectID: player($i), ID;}
				}
				if player($i), stateNo = 50 {
					changeAnim{value: 50; elem: 1; redirectID: player($i), ID;}
					assertSpecial{flag: animfreeze; redirectID: player($i), ID;}
				}
				
				# Release Ledge
				if player($i), command = "holdup" {
					player($i), map(_vnix_platform_a_left) := 0;
					selfState{value: 50; redirectID: player($i), ID;}
					velSet{y: -10; redirectID: player($i), ID;}
				}
				if player($i), command = "holddown" || player($i), command = "holdfwd" || player($i), command = "holdback"
				|| (player($i), pos x + player($i), cameraPos x) != [-550, -496] {
					player($i), map(_vnix_platform_a_left) := 0;
					velSet{y: 5; redirectID: player($i), ID;}
				}
				if player($i), getHitVar(frame) {
					player($i), map(_vnix_platform_a_left) := 0;
					selfState{value: 5000; redirectID: player($i), ID;}
				}
			}
			
			if player($i), map(_vnix_platform_a_right) {
				if player($i), facing = 1 {
					turn{redirectID: player($i), ID;}
				}
				posSet{y: -10; redirectID: player($i), ID;}
				velSet{x: 0; y: 0; redirectID: player($i), ID;}
				
				# StateNo while holding
				if player($i), stateNo != 50 {
					selfState{value: 50; redirectID: player($i), ID;}
				}
				if player($i), stateNo = 50 {
					changeAnim{value: 50; elem: 1; redirectID: player($i), ID;}
					assertSpecial{flag: animfreeze; redirectID: player($i), ID;}
				}
				
				# Release Ledge
				if player($i), command = "holdup" {
					player($i), map(_vnix_platform_a_right) := 0;
					selfState{value: 50; redirectID: player($i), ID;}
					velSet{y: -10; redirectID: player($i), ID;}
				}
				if player($i), command = "holddown" || player($i), command = "holdfwd" || player($i), command = "holdback"
				|| (player($i), pos x + player($i), cameraPos x) != [-90, -60] {
					player($i), map(_vnix_platform_a_right) := 0;
					velSet{y: 5; redirectID: player($i), ID;}
				}
				if player($i), getHitVar(frame) {
					player($i), map(_vnix_platform_a_right) := 0;
					selfState{value: 5000; redirectID: player($i), ID;}
				}
			}
		}
		
		if (player($i), pos x + player($i), cameraPos x) != [-495, -90] && (player($i), pos y + player($i), groundLevel) < 0
		{
			player($i), map(_vnix_platform_a) := 0;			
		}
	}
}

