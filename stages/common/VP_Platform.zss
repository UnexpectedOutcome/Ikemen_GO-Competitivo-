# ========================================================================================================================================
# Platfrom C
[StateDef 64020; anim: -2;]

for i = 1 ; 8; 1 {
	if playerNoExist($i) {
		if (player($i), pos x + player($i), cameraPos x) = [-325, 325] && (player($i), pos y + player($i), groundLevel) <= -204
		&& player($i), getHitVar(isbound) = 0 && player($i), p2, getHitVar(isbound) = 0 && player($i), incustomstate = 0 {
			player($i), map(_vnix_platform_c) := 1;
			player($i), map(_vnix_platform_b) := 0;
			player($i), map(_vnix_platform_a) := 0;
		}
		
		if player($i), map(_vnix_platform_c) {
			groundLevelOffset{value: -204; redirectID: player($i), ID;}
		}
		
		if player($i), map(_vnix_platform_cmd_222) > 20 {
			groundLevelOffset{value: 0; redirectID: player($i), ID;}
			player($i), map(_vnix_platform_c) := 0;	
		}
		
		# Ledges
		if player($i), map(_vnix_plathold_cfg_enable) {
			if (player($i), pos x + player($i), cameraPos x) = [-355, -326] && (player($i), pos y + player($i), groundLevel) = [-120, -110]
			&& player($i), moveType != H && player($i), map(_vnix_platform_c_left) = 0 && player($i), vel y > 0 {
				playSnd{value: 0, 1; volume: 200;}
				palfx{time: 30; add: 255,255,255; sinadd: -255,-255,-255,120; redirectID: player($i), ID;}
				player($i), map(_vnix_platform_c_left) := 1;
			}
			
			if (player($i), pos x + player($i), cameraPos x) = [326, 355] && (player($i), pos y + player($i), groundLevel) = [-120, -110]
			&& player($i), moveType != H && player($i), map(_vnix_platform_c_right) = 0 && player($i), vel y > 0 {
				playSnd{value: 0, 1; volume: 200;}
				palfx{time: 30; add: 255,255,255; sinadd: -255,-255,-255,120; redirectID: player($i), ID;}
				player($i), map(_vnix_platform_c_right) := 1;
			}
			
