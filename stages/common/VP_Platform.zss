		{
			player($i), map(_vnix_platform_c) := 0;			
		}
	}
}

# ========================================================================================================================================
# Main Platform
[StateDef 64100; anim: -2;]

for i = 1 ; 8; 1 {
	if playerNoExist($i) && player($i), alive {
		# ----------------------------------------
		# Ledges
		# ----------------------------------------
		if (player($i), pos x + player($i), cameraPos x) = [-640, -590] && (player($i), pos y + player($i), groundLevel) = [50, 80]
		&& player($i), moveType != H && player($i), map(_vnix_platform_main_left) = 0 && player($i), vel y > 0 {
			playSnd{value: 0, 1; volume: 200;}
			palfx{time: 30; add: 255,255,255; sinadd: -255,-255,-255,120; redirectID: player($i), ID;}
			player($i), map(_vnix_platform_main_left) := 1;
		}
		
		if (player($i), pos x + player($i), cameraPos x) = [590, 640] && (player($i), pos y + player($i), groundLevel) = [50, 80]
		&& player($i), moveType != H && player($i), map(_vnix_platform_main_right) = 0 && player($i), vel y > 0 {
			playSnd{value: 0, 1; volume: 200;}
			palfx{time: 30; add: 255,255,255; sinadd: -255,-255,-255,120; redirectID: player($i), ID;}
			player($i), map(_vnix_platform_main_right) := 1;
		}
		
		# Holding Ledge
		if player($i), map(_vnix_platform_main_left) {
			if player($i), facing = -1 {
				turn{redirectID: player($i), ID;}
			}
			hitBy{value: SCA, AA, AP, AT; redirectID: player($i), ID;}
			posSet{y: -180; redirectID: player($i), ID;}
			velSet{x: 0; y: 0; redirectID: player($i), ID;}
			
			# StateNo while holding
			if player($i), stateNo != 50 {
				selfState{value: 50; redirectID: player($i), ID;}
			}
			if player($i), stateNo = 50 {
				changeAnim{value: 50; elem: 1; redirectID: player($i), ID;}
				assertSpecial{flag: animfreeze; redirectID: player($i), ID;}
			}
			
			# Release Ledge
			if player($i), command = "holdup" || player($i), command = "holdfwd" || player($i), command = "holdback" {
				player($i), map(_vnix_platform_main_left) := 0;
				selfState{value: 50; redirectID: player($i), ID;}
				velSet{y: -10; redirectID: player($i), ID;}
				if player($i), command = "holdfwd" {
					velSet{x: 5; redirectID: player($i), ID;}
				}
				if player($i), command = "holdback" {
					velSet{x: -5; redirectID: player($i), ID;}
				}
			}
			if player($i), command = "holddown"
			|| (player($i), pos x + player($i), cameraPos x) != [-640, -590] {
				player($i), map(_vnix_platform_main_left) := 0;
				velSet{y: 5; redirectID: player($i), ID;}
			}
			if player($i), getHitVar(frame) {
				player($i), map(_vnix_platform_main_left) := 0;
				selfState{value: 5000; redirectID: player($i), ID;}
			}
			
			if player($i), AILevel > 0 {
				player($i), map(_vnix_platform_main_left) := 0;
				selfState{value: 50; redirectID: player($i), ID;}
				velSet{x: 5; y: -10; redirectID: player($i), ID;}			
			}
		}
		
		if player($i), map(_vnix_platform_main_right) {
			if player($i), facing = 1 {
				turn{redirectID: player($i), ID;}
			}
			hitBy{value: SCA, AA, AP, AT; redirectID: player($i), ID;}
			posSet{y: -180; redirectID: player($i), ID;}
			velSet{x: 0; y: 0; redirectID: player($i), ID;}
			
			# StateNo while holding
			if player($i), stateNo != 50 {
				selfState{value: 50; redirectID: player($i), ID;}
			}
			if player($i), stateNo = 50 {
				changeAnim{value: 50; elem: 1; redirectID: player($i), ID;}
				assertSpecial{flag: animfreeze; redirectID: player($i), ID;}
			}
			
			# Release Ledge
			if player($i), command = "holdup" || player($i), command = "holdfwd" || player($i), command = "holdback" {
				player($i), map(_vnix_platform_main_right) := 0;
				selfState{value: 50; redirectID: player($i), ID;}
				velSet{y: -10; redirectID: player($i), ID;}
				if player($i), command = "holdfwd" {
					velSet{x: 5; redirectID: player($i), ID;}
				}
				if player($i), command = "holdback" {
					velSet{x: -5; redirectID: player($i), ID;}
				}
			}
			if player($i), command = "holddown"
			|| (player($i), pos x + player($i), cameraPos x) != [590, 640] {
				player($i), map(_vnix_platform_main_right) := 0;
				velSet{y: 5; redirectID: player($i), ID;}
			}
			if player($i), getHitVar(frame) {
				player($i), map(_vnix_platform_main_right) := 0;
				selfState{value: 5000; redirectID: player($i), ID;}
			}
			
			if player($i), AILevel > 0 {
				player($i), map(_vnix_platform_main_right) := 0;
				selfState{value: 50; redirectID: player($i), ID;}
				velSet{x: 5; y: -10; redirectID: player($i), ID;}			
			}
		}
		
		# ----------------------------------------
	}
}


