#===============================================================================
# Slime Monster
#===============================================================================

# Appear
[StateDef 65100; type: S; movetype: I; physics: N; anim: 10;]

if time = 0 {
	playSnd{value: 0, 11; volume: 200;}
	palfx{time: 90; add: 255, 255, 255; sinadd: -255, -255, -255, 360}
	map(_vnix_slime_color) := randomRange(-255,255);
}

notHitBy{value: SCA;}

palfx{time: 1; hue: map(_vnix_slime_color);}

if time <= 60 {
	trans{
		trans: addalpha;
		alpha: time * 4.2667, 256 - (time * 4.2667);
	}
}

if time = 100 {
	changestate{value: 65101; ctrl: 0;}
}

if roundState = 3 {	
	destroySelf{}
}

#-------------------------------------------------------------------------------
# Walk
[StateDef 65101; type: S; movetype: I; physics: N;
juggle: 4; velset: 0, 0; facep2: 1;
anim: 10; ctrl: 0; sprpriority: 2;]

hitOverride{attr: SCA,AA,AP,AT; stateno: 65102; time: -1; forceair: 1;}

for i = 1; 8; 1 {
	if playerNoExist($i) {	
		if clsnOverlap(clsn2, player($i),ID, clsn1) {
			map(_vnix_slime_hit) := player($i), playerNo;
		}
	}
}

palfx{time: 1; hue: map(_vnix_slime_color);}

if stageFrontEdgeDist < 100 || stageBackEdgeDist < 100 {
	turn{}
}

velset{x: 1; y: 0}

if roundState = 3 || stageFrontEdgeDist < 10 || stageBackEdgeDist < 10 {	
	destroySelf{}
}

#-------------------------------------------------------------------------------
# Hit
[StateDef 65102; type: S; movetype: I; physics: N;
juggle: 4; velset: 0, 0; facep2: 1;
anim: 11; ctrl: 0; sprpriority: 2;]

if time = 0 {
	playSnd{value: 0, 9; volume: 200;}
	playSnd{value: 0, 12; volume: 200;}
	playSnd{value: 0, 12; volume: 200;}
	explod{
		anim: 2;
		postype: p1;
		pos: 0,0;
		scale: .25,.25;
		angle: 0;
		facing: 1;
		ontop: 0;
		sprpriority: -5;
		removetime: -2;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
	palFx{time: 30; add: 225,225,225; sinadd: -225,-225,-225,120; redirectID: player(map(_vnix_slime_hit)), ID;}
}

palfx{time: 1; hue: map(_vnix_slime_color);}

if time <= 60 {
	trans{
		trans: addalpha;
		alpha: 256 - (time * 4.2667), time * 4.2667;
	}
}

if time = 5 {
	if player(map(_vnix_slime_hit)), helperVar(helpertype) != 1 && player(map(_vnix_slime_hit)), playerNo = player(map(_vnix_slime_hit)), teamLeader {	
		powerAdd{value: 200; redirectID: player(map(_vnix_slime_hit)), ID;}
	}
}

if time = 5 {	
	destroySelf{}
}


#===============================================================================
# Bat Monster
#===============================================================================

# Appear
[StateDef 65110; type: A; movetype: I; physics: N; anim: 12;]

if time = 0 {
	playSnd{value: 0, 11; volume: 200;}
	palfx{time: 90; add: 255, 255, 255; sinadd: -255, -255, -255, 360}
	map(_vnix_bat_color) := randomRange(-255,255);
	posAdd{y: -70;}
}

notHitBy{value: SCA;}

palfx{time: 1; hue: map(_vnix_bat_color);}

if time <= 60 {
	trans{
		trans: addalpha;
		alpha: time * 4.2667, 256 - (time * 4.2667);
	}
}

if time = 100 {
	changestate{value: 65111; ctrl: 0;}
}

if roundState = 3 {	
	destroySelf{}
}

#-------------------------------------------------------------------------------
# Walk
[StateDef 65111; type: A; movetype: I; physics: N;
juggle: 4; velset: 0, 0; facep2: 1;
anim: 12; ctrl: 0; sprpriority: 2;]

hitOverride{attr: SCA,AA,AP,AT; stateno: 65112; time: -1; forceair: 1;}

for i = 1; 8; 1 {
	if playerNoExist($i) {	
		if clsnOverlap(clsn2, player($i),ID, clsn1) {
			map(_vnix_bat_hit) := player($i), playerNo;
		}
		if clsnOverlap(clsn2, player($i),ID, clsn2) {
			powerAdd{value: -5; redirectID: player($i), ID;}
			if player($i), power > 0 {
				palfx{time: 1; add: 0,-50,-50; redirectID: player($i), ID;}
			}
		}
	}
}

palfx{time: 1; hue: map(_vnix_bat_color);}

if stageFrontEdgeDist < 100 || stageBackEdgeDist < 100 {
	turn{}
}

velset{x: 1; y: 0}

if roundState = 3 || stageFrontEdgeDist < 10 || stageBackEdgeDist < 10 {	
	destroySelf{}
}

