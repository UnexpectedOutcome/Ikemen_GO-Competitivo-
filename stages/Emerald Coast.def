;ソニックアドベンチャーDXより、
;「エメラルドコースト」
[Info]
name	= "Sonic Adventure DX : Emerald Coast"
					;ステージ名　必ず半角英数
author	= "Luneth"	;制作者名


;======================================================================
;実は記述の順番はある程度無視できるので、
;必ずしも[BGdef]の上でなければならないわけではない
[Music]

bgmusic = sound/sailor-moon-s-ost-daimon-battle-1.mp3

BGMusic.Loop	= 1	;音楽をループ再生するかどうか。1でループ再生する。

bgvolume	= 0	;場合により機能が変化する
;			(例1：in_mp3.dll	音声の再読み込み時の追加音量
;				0 = １ループしたりや超必時にBGMを停止しても２週目、再々生時も同じ音量
;				255 = BGMの再読み込みの度に音量+100%
;			例2：M.U.G.E.N. Stage Viewer	BGMファイルの再生音量
;				255を等倍とし、普通に再生する)


;======================================================================
[Camera]

startx		= 0
starty		= 0
boundleft	= -520
boundright	= 520
boundhigh	= -180
boundlow	= 20
verticalfollow	= 0.8
tension		= 70
floortension	= 80


;======================================================================
[PlayerInfo]
;--- Player 1 ---
p1startx	= -75
p1starty	= 0
p1startz	= 0
p1facing	= 1

;--- Player 2 ---
p2startx	= 75
p2starty	= 0
p2startz	= 0
p2facing	= -1

;--- Common ---
leftbound	= -3000
rightbound	= 3000
topbound	= 0
botbound	= 0


;======================================================================
[Scaling]

topz		= 0
botz		= 50
topscale	= 1
botscale	= 1.2

;======================================================================
[Bound]
screenleft	= 15
screenright	= 15


;======================================================================
[StageInfo]
zoffset		= 225
autoturn	= 1
resetBG		= 0

hires		= 1


;======================================================================
[Shadow]

color		= 32,32,32
yscale		= 0.175
intensity 	= 64
fade.range	= -300,-5

;======================================================================
[BGdef]

spr		= Emerald Coast.sff	;使うスプライトデータを宣言、
					;Defと同じフォルダにあるならパスは書かなくてよい
debug	= 0				;1にすると全レイヤーより後ろにマゼンタ色の画像が表示される
					;(僅かに重くなるらしい)

