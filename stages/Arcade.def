; From Pretty Guardian Sailormoon

[Info]
name = "Arcade"
displayname = "Arcade" ;Name to display
author = "Ryoucchi"         ;Stage author name

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0

boundleft = -94
boundright = 94
boundhigh = -5
boundlow = 0
verticalfollow = .94
floortension = 90
tension = 50


;--------------------------------------------------------
[PlayerInfo]
p1startx = -70         
p1starty = 0            
p1startz = 0            
p1facing = 1       
  
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000 
rightbound =  1000 
topbound  =  0     
botbound  =  0

[Scaling]
topz     = 0       
botz     = 50      
topscale = 1      
botscale = 1.2

[Bound]
screenleft = 25    ;Dist from left of screen that player can move to
screenright = 25   ;Right edge

;--------------------------------------------------------
[StageInfo]
zoffset = 190
autoturn = 1

resetBG = 1

;--------------------------------------------------------
[Shadow]
color = 30,30,30   
yscale = .3           
reflect = 0  

;--------------------------------------------------------
[Reflection]
intensity = 0

[Music]
bgmusic = sound/06-Port Town.mp3
bgmvolume = 255

[BGdef]
spr = Arcade.sff

debugbg = 0

[BG 1]
type  = normal
spriteno = 1, 0
layerno = 0
start = 0, 200
delta = 1, 1
mask = 1

[BG 0]
type  = normal
spriteno = 1, 2
layerno = 0
start = 0, 200
delta = 1, 1
mask  = 1

[BG 0]
type  = normal
spriteno = 1, 5
layerno = 0
start = 0, 200
delta = 1, 1
mask  = 1

[BG 0]
type  = normal
spriteno = 1, 3
