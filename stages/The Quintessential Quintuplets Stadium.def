;--------------------------------------------------------
[Info]
Name = "The Quintessential Quintuplets Stadium"
Author = "EXShadow" edited by "Daniel Alanis"

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -320
boundright = 320
boundhigh = -170
boundlow = 0
verticalfollow = .95
floortension = 30
tension = 80
zoomin = 0.97 ;Nuevo
zoomout = 0.62
;--------------------------------------------------------
[PlayerInfo]
p1startx = -85          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 85
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000 
rightbound =  1000 
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

;--------------------------------------------------------
[Bound]
screenleft = 15    ;Dist from left of screen that player can move to
screenright = 15   ;Right edge

;--------------------------------------------------------
[StageInfo]
zoffset = 216
autoturn = 1
resetBG = 0
hires = 1

;--------------------------------------------------------
[Shadow]
intensity = 0
color = 0,0,0
yscale = .4
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 70

;--------------------------------------------------------
[Music]
bgmusic = sound/videoplayback (3).mp3
bgvolume = 255
bgmloopstart= 6177833
bgmloopend  = 12011827
;--------------------------------------------------------Main background definition
[BGdef]
spr = The Quintessential Quintuplets Stadium.sff
debugbg = 0

