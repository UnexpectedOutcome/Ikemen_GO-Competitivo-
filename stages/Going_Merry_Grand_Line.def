[Info]
name = "Going Merry"
displayname = "Going Going_Merry_Grand_Line"
autor= "Team One Piece OPOS"

[Camera]
startx = 0
starty = 0
boundleft = -140
boundright = 116
boundhigh = -100
boundlow = 0
verticalfollow = 0.8
floortension = 60
tension = 80
zoomin = 1
zoomout = 0.85

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -70          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
 ;Don't change these values.
leftbound = -1200
rightbound = 1200
topbound = 120
botbound = 0

[Scaling]
topz = 0
botz = 50
topscale = 1
botscale = 1

[Bound]
screenleft = 40
screenright = 40

[StageInfo]
zoffset = -140
zoffsetlink = 30
autoturn = 1
resetBG = 1
hires = 1


[Shadow]
color = 26,26,26
yscale = .20

[Music]
bgmusic = sound/One Piece Super Grand Battle! X OST - Title.mp3
bgvolume =255

