
[Info]
name= "EMPRESS PLACE:CLEOPATRA" 
;-----------------------
;■カメラ
[Camera]
startx         = 0                ;一番最初のｶﾒﾗ位置(X軸)
starty         = 0　　　　　　　　;一番最初のｶﾒﾗ位置(Y軸)
boundleft      = -140                ;左画面端の距離
boundright     = 140              ;右画面端の距離
boundhigh      = -16                ;上にｽｸﾛｰﾙする距離。0だとｽｸﾛｰﾙしない
boundlow       = 0　　　　   　　;下画面端の距離
verticalfollow = 0.4               ;ｼﾞｬﾝﾌﾟした時、ｽﾃｰｼﾞ全体が上下する強さ
tension        = 50               ;ﾄﾞｯﾄ数だけ画面端に行くと、ｽｸﾛｰﾙする
floortension = 30      ;地面からこの値より上に行くと縦スクロールを開始する
;-----------------------
;■キャラ
[PlayerInfo]
;--- Player 1 ---
p1startx   = -80                  ;1Pキャラの最初の立ち位置X軸
p1starty   = 0                    ;1Pキャラの最初の立ち位置Y軸
p1startz   = 0                    ;使用しない
p1facing   = 1                    ;1Pキャラの最初の向き。1だと、左向き 
;--- Player 2 ---
p2startx   = 80
p2starty   = 0
p2startz   = 0
p2facing   = -1
;--- Common ---　　　　         　;変える必要無し
leftbound  = -1000          
rightbound =  1000           
topbound   =  0           
botbound   =  0            

;-----------------------
;大きさ
[Scaling]                   
topz     = 0
botz     = 50
topscale = 1
botscale = 1.2

;-----------------------
;座標
[Bound]                   
screenleft  = 15                  ;左画面端の壁の存在距離
screenright = 15                  ;右画面端の壁の存在距離

;-----------------------
;情報
[StageInfo]
zoffset  = 220            
autoturn = 1                       ;ｷｬﾗが自動的に振り向くか(1で振り向く。基本的に1
resetBG  = 1                       ;ﾗｳﾝﾄﾞ終了後ｱﾆﾒをﾘｾｯﾄするか(1でon)

;-----------------------
;影
[Shadow]
color = 100, 100, 100              ;影のｶﾗｰ    
yscale = .4                        ;影のｻｲｽﾞ             
reflect = 0                        ;影の反射                

;-----------------------
;音声
[Music]
bgmusic= sound/Arabian Rave Night.mp3      ;ｽﾃｰｼﾞ専用曲の指定(midやmp3やmodが使用可能)
bgvolume = 205                     ;BGMの音量(0～255)

;-----------------------
;画像ファイルの指定
[BGdef]
spr=stages/Cleopatra.sff         ;ｽﾃｰｼﾞの画像ﾌｧｲﾙの指定
debugbg = 1  　　　　　　　　      ;1にすると、画像が無い部分に、残像がつかない。

