[Info]
 ;Name of the stage.
name = "Ume arena"

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -304
boundright = 304
boundhigh = -70
boundlow = 0
verticalfollow = .3
floortension = 0
tension = 60
zoomin		= 1.11
zoomout		= 1

;--------------------------------------------------------
[PlayerInfo]
p1startx = -70          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
topz     = 0       
botz     = 50      
topscale = 1       
botscale = 1.2     

;--------------------------------------------------------
[Bound]
screenleft = 15    ;Dist from left of screen that player can move to
screenright = 15   ;Right edge

;--------------------------------------------------------
[StageInfo]
zoffset = 215
autoturn = 1
resetBG = 0

;--------------------------------------------------------
[Shadow]
color = 70,70,70
yscale = 0.9
reflect = 0

;--------------------------------------------------------
