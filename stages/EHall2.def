;--------------------------------------------------------
[Info]
name = "Entrance Hall: Requiem of Darkness"
;Programmed by Saiyajin Mui
;Tested by Saiyajin Mui
;
;Images Edited from Umineko no Naku koro ni: Ougon Musou Kyoku
;
;site: http://saiyajinmui.mugen-infantry.net/
;email: Saiyajin.mui@gmail.com
;
;--------------------------------------------------------
[Camera]
startx = 0
starty = 0

boundleft = -240
boundright = 240

boundhigh = -140
boundlow = 0

verticalfollow = 0.75
tension = 50
floortension = 90


;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
 ;p1startx is typically -70 and p2startx is 70.
 ;p1starty and p1startz should be 0.
p1startx = -70      ;Starting x coordinates
p1starty = 0    ;Starting y coordinates
p1startz = 0    ;Starting z coordinates
p1facing = 1    ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
 ;Don't change these values.
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
 ;No need to change these values
topz     = 0   ;Top z-coordinate for scaling
botz     = 50  ;Bottom z-coordinate for scaling
topscale = 1   ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

;--------------------------------------------------------
[Bound]
 ;Distance from left/right edge of screen that player can move to
 ;Typically 15
screenleft = 20    ;Dist from left of screen that player can move to
screenright = 20   ;Right edge

;--------------------------------------------------------
[StageInfo]
zoffset = 215
autoturn = 1
resetBG = 1
Hires = 1

;--------------------------------------------------------
[Shadow]
 ;This controls the darkness of the shadow. Valid values range
 ;from 0 (lightest) to 256 (darkest). Defaults to 128 if omitted.
intensity = 128

 ;This is the shadow color given in r,g,b. Valid values for each
 ;range from 0 (lightest) to 255 (darkest).
 ;Defaults to 0,0,0 if omitted.
 ;intensity and color's effects add up to give the final shadow
 ;result.
color = 0,0,0

 ;This is the scale factor of the shadow. Use a big scale factor
 ;to make the shadow longer. You can use a NEGATIVE scale factor
 ;to make the shadow fall INTO the screen.
 ;Defaults to 0.4 if omitted.
yscale = 0.4

 ;This parameter lets you set the range over which the shadow is
 ;visible. The first value is the high level, and the second is
 ;the middle level. Both represent y-coordinates of the player.
 ;A shadow is invisible if the player is above the high level,
 ;and fully visible if below the middle level. The shadow is
 ;faded in between the two levels. This gives an effect of the
 ;shadow fading away as the player gets farther away from the
 ;ground. If omitted, defaults to no level effects (shadow is
 ;always fully visible).
fade.range = -300,-1

;--------------------------------------------------------
[Reflection]
 ;Intensity of reflection (from 0 to 256). Set to 0 to have no
 ;reflection. Defaults to 0.
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/ODF.mp3
bgvolume = 155

;-------------------------------------
; Main background definition
[BGdef]
spr = stages/EHall2.sff
debugbg = 0

;-------------
[BG Sky]
type = anim
actionno = 0
start = 0,0
delta = 1.8,1.7
mask = 0

[BG Rain]
type = anim
actionno = 4
start = 0,0
delta = 1.8,1.7
mask = 0

[BG Rain2]
type = anim
actionno = 5
start = 450,200
delta = 1.8,1.7
mask = 0

[BG Rain3]
type = anim
actionno = 6
start = 1100,200
delta = 1.8,1.7
mask = 0

[BG Hall]
type =normal
spriteno = 0,1
start = 0,0
delta = 2,2
mask =1

[BG Portrait]
type =normal
spriteno = 0,3
start = 0,0
delta = 2,2
mask =1

[BG Portrait Glow]
type = anim
actionno = 1
start = 0,0
delta = 2,2
mask = 0

[BG Thing]
type =normal
spriteno = 0,4
start = 0,0
delta = 2,2
mask =1

[BG Glow on Thing]
type =normal
spriteno = 2,0
trans = add
start = 0,0
delta = 2,2
mask =1

[BG Pendulum]
type = anim
actionno = 2
start = 0,0
delta = 2,2
mask = 0

[BG Clock Front]
type =normal
spriteno = 0,7
start = 0,0
delta = 2,2
mask =1

[BG Peoples]
type =normal
spriteno = 0,5
start = 0,0
delta = 2,2
mask =1

[BG Peoples2]
type =normal
spriteno = 0,6
start = 0,0
delta = 2,2
mask =1

[BG Candles]
type = anim
actionno = 3
start = 0,0
delta = 2,2
mask = 0

