[Info]
name = "SCHOOL JAPAN"

[Camera]
	startx=0
	starty=0
	boundleft= -190
	boundright= 190
	boundhigh= 0
	boundlow=0
	verticalfollow=1
	tension=100;50
	floortension=150

	;;--- * v1.1 (zoom) *---
;;	cuthigh=30 ;;c_hi
	cutlow=10 ;;c_lo
	;;---
	overdrawhigh=5
	overdrawlow=5
	;;---
	tensionhigh=85
	tensionlow=25
	startzoom=1
	zoomout=0.85 ;;c_zo
	zoomin=1 ;;c_zi
	;;--- * v1.1 (zoom) *---

[PlayerInfo]
	p1startx=-70
	p1starty=0
	p1startz=0
	p1facing=1

	p2startx=70
	p2starty=0
	p2startz=0
	p2facing=-1

	leftbound=-1000
	rightbound=1000
	topbound=0
	botbound=0

[Scaling]
	topz=0
	botz=50
	topscale=1
	botscale=1.2

[Bound]
	screenleft=15
	screenright=15

[StageInfo]
	zoffset=215
	autoturn=1
	resetBG=0
hires=1


;---------------------------------
[Shadow]
intensity = 100
color = 0,0,0
yscale = .18
fade.range = -100,-10

;---------------------------------
[Reflection]
intensity = 0

;---------------------------------
[Music]
bgmusic = sound/08.ESAKA!!.mp3
bgvolume = 255
;---------------------------------
[BGdef]
spr = stages\KOF-2002-um school japan.sff
debugbg = 0



