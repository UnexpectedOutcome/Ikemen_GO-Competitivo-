;--------------------------------------------------------
[Info]
name = "Tatsunoko vs. Capcom - Daigo Temple (Moonlight)"
displayname = "Tatsunoko vs. Capcom - Daigo Temple (Moonlight)"
versiondate = 04,29,2026
author = "SuperFromND"

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -640
boundright = 640
boundhigh = -2600
boundlow = 50
verticalfollow = .95
floortension = 200
tension = 175

overdrawhigh = 120
overdrawlow = 120
cuthigh = 0
cutlow = 30
zoomin=1
zoomout=0.8

fov = 25
;--------------------------------------------------------
[PlayerInfo]
p1startx = -140
p1starty = 0
p1facing = 1

p2startx = 140
p2starty = 0
p2facing = -1

p3startx = -210
p3starty = 0
p3facing = 1

p4startx = 210
p4starty = 0
p4facing = -1

;--- Common ---
leftbound  = -4000
rightbound =  4000

;--------------------------------------------------------
[Bound]
screenleft = 30
screenright = 30

;--------------------------------------------------------
[StageInfo]
zoffset = 660
autoturn = 1
resetBG = 1
localcoord = 640, 480

xscale = 1
yscale = 1
portraitscale = 1

;--------------------------------------------------------
[Shadow]
intensity = 160
color = 16, 16, 0
yscale = .3
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/TatsunokoVsCapcom_DaigoTempleMoonlight.ogg
bgmvolume = 100

[BGdef]
model = tvc-daigotemplemoonlight.glb
spr = tvc-daigotemplemoonlight.sff

;-------------------------------------
[Model]
offset = 0,-0.15,-0.7
scale = 0.07, 0.07, 0.07
;-------------------------------------
; Preview animation on stage select screen
[Begin Action 9000]
9000,1, 0,0,-1
;-------------------------------------
