[Info]
name = "City Crossroad"
author = "Ryoucchi & Swordsman-Kai"

[Camera]
startx = 0
starty = 0
boundleft = -115
boundright = 115
boundhigh = -135
boundlow = 0
verticalfollow = .5
floortension = 55
tension = 50

[PlayerInfo]
;--- Player 1 ---
p1startx = -70          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left
;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1
;--- Common ---
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

[Scaling]
 ;No need to change these values
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

[Bound]
screenleft = 15    ;Dist from left of screen that player can move to
screenright = 15   ;Right edge

[StageInfo]
zoffset = 215
autoturn = 1
resetBG = 0
hires = 1

[Shadow]
intensity = 15
color = 50,50,50
yscale = 0.1
fade.range = 0,0

[Music]
bgmusic = sound/[Touhou Jazzy-Mix] TOKYO Active NEETs - Battle Theme#1.mp3
bgvolume = 255

[BGdef]
spr = City_Crossroad.sff

[BG RGB]
type  = normal
spriteno = 0, 0
delta = 2,2

[BG RGB]
type  = normal
spriteno = 0, 1
delta = 2,2
trans = add

[BG RGB]
type = normal
spriteno = 0, 2
delta = 2,2
trans = add

