[Info]
name = "AFTER THE DESTRACTION"
;--------------------------------------------------------
[Music]
bgmusic = sound/CaptivAte-CHIKAI-.mp3
bgvolume = 205
;--------------------------------------------------------
[BGdef]
spr = stages/AFTER THE DESTRACTION.sff
debugbg = 1             ;無画像部分残像    有[0] / 無[1]
;--------------------------------------------------------
[Camera]
startx = 0              ;開始位置　横
starty = 0              ;開始位置　縦
boundleft = -203        ;左スクロール限界
boundright = 198        ;右スクロール限界
boundhigh = -114        ;上スクロール限界
boundlow = 0            ;下スクロール限界
verticalfollow = .3     ;ｙ軸移動時のカメラ追跡速度  [0]追跡しない / [1]追跡（小数可）
floortension = 0
tension = 60
;--------------------------------------------------------
[PlayerInfo]
p1startx = -65          ;１Ｐスタート位置　横軸
p1starty = 0            ;１Ｐスタート位置　縦軸
p1startz = 0            ;１Ｐスタート位置　奥行き？
p1facing = 1            ;１Ｐの向き        右[1] / 左[-1]

p2startx = 65           ;２Ｐスタート位置　横軸
p2starty = 0            ;２Ｐスタート位置　縦軸
p2startz = 0            ;２Ｐスタート位置　奥行き？
p2facing = -1           ;２Ｐの向き        右[1] / 左[-1]

;↓ここは変えない
leftbound  = -1000      ;Left bound (x-movement)
rightbound =  1000      ;Right bound
topbound  =  0          ;Top bound (z-movement)
botbound  =  0          ;Bottom bound
;--------------------------------------------------------
[Scaling]
topz     = 0            ;Top z-coordinate for scaling
botz     = 50           ;Bottom z-coordinate for scaling
topscale = 1            ;Scale to use at top
botscale = 1.2          ;Scale to use at bottom
;--------------------------------------------------------
[Bound]
screenleft = 15         ;ここより左には入れない
screenright = 15        ;ここより右には入れない
;--------------------------------------------------------
[StageInfo]
zoffset = 221           ;地面の高さ
autoturn = 1            ;相手側に振り向く  　無[0] / 有[1]
resetBG = 0             ;ラウンド毎の初期化　無[0] / 有[1]
;--------------------------------------------------------
[Shadow]
color = 150,150,150     ;影の濃さ0,0,0～255,255,255
yscale = .4             ;影の大きさ [-]にすると画面奥に影が伸びる
reflect = 0             ;地面の鏡像  無[0] / 有[1]
;========================================================
[BG A]
type  = normal
spriteno = 0, 0
layerno = 0             ;この絵はキャラより　奥[0] / 手前[1]
start = 0, 0            ;この画像の開始位置sff登録時の座標も考慮
delta = .8, 1           ;x/y軸移動時の移動速度　多重スクロール時はパーツ毎に数値差を付ける
mask  = 0               ;背景色透明に  しない[0] / する[1]
tile  = 0, 0            ;タイルパターン　有[1] / 無[0]
tilespacing = 0,0       ;タイルパターンの間隔
;trans = none           ;[none]通常　[add]スポットライト　[sub]影
;window = 0,0, 319, 239
;windowdelta = 0,0

[BG KEMURI]
type  = anim 
actionno = 0
layerno = 0
start = 0, 0
delta = .8, 1
mask  = 1
[Begin action 0]
-1,0,0,0, 15
 1,0,0,0, 15
 1,1,0,0, 15
 1,2,0,0, 15

[BG SUIMEN]
type  = anim 
actionno = 1
layerno = 0
start = 0, 0
delta = .8, 1
mask  = 1
[Begin action 1]
-1,0,0,0, 15
 2,0,0,0, 15
 2,1,0,0, 15
 2,2,0,0, 15

[BG building]
type  = normal
spriteno = 3,0
layerno= 0
mask     = 1
delta = 0.60,0.70
start    =-162,0

[BG the Statue of Liberty]
type  = normal
spriteno = 4,0
layerno= 0
mask     = 1
delta = 0.70,0.79
start    =-162,5

[BG base]
type  = normal
spriteno = 5,0
layerno= 0
mask     = 1
delta = 0.8,0.84
start    =-162,0
