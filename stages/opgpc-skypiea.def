[Info]
name = "One Piece Great Pirate Colosseum - Skypiea"
displayname = "One Piece Great Pirate Colosseum - Skypiea"
versiondate = 06,03,2026
mugenversion = 1.1
author = "SuperFromND"

[Camera]
startx = 0
starty = 0
boundleft = -576
boundright = 576
boundhigh = -1400
boundlow = 0
verticalfollow = .95
floortension = 200
tension = 200

overdrawhigh = 120
overdrawlow = 120
cuthigh = 0
cutlow = 30
zoomin=1
zoomout=0.75

fov = 50 ;Higher FOV than usual!

[PlayerInfo]
p1startx = -280
p1starty = 0
p1facing = 1

p2startx = 280
p2starty = 0
p2facing = -1

p3startx = -420
p3starty = 0
p3facing = 1

p4startx = 420
p4starty = 0
p4facing = -1

leftbound  = -4000
rightbound =  4000

[Bound]
screenleft = 15
screenright = 15

[StageInfo]
zoffset = 660
autoturn = 1
resetBG = 1
localcoord = 1280, 720 ;3DS res. is technically 15:9 (400x240/5:3) but 16:9 is close enough!
xscale = 1
yscale = 1
portraitscale = 2

[Shadow]
intensity = 192
color = 0,0,0
yscale = .3
fade.range = 0,0

[Reflection]
intensity = 0

[Music]
bgmusic = sound/OnePieceGreatPirateColosseum_Skypiea.ogg
bgmloopstart = 323132
bgmloopend = 1356564
bgmvolume = 100

[BGdef]
model = opgpc-skypiea.glb
spr = opgpc-skypiea.sff

[Model]
offset = 0,-0.15,-0.4
scale = 0.06, 0.06, 0.06

; Preview animation on stage select screen
[Begin Action 9000]
9000,1, 0,0,-1
