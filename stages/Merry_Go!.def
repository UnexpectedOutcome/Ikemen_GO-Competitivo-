[Info]
name ="Merry Go!"
author = "SavageD"

[Camera]
startx =0
starty =0
boundleft  = -0 ;Å¶
boundright = 194 ;Å¶
boundhigh  = -192 ;Å¶
boundlow   = 0
verticalfollow = -1    ;antes 2. Negativo = camara vertical de Ikemen (se aleja al saltar)
floortension = 120
tension =50
zoomout = 1            ;el dibujo apenas es mas ancho que la pantalla: con menos de 1 se ven los bordes
zoomin = 1.25          ;cerca: la camara se acerca cuando estan juntos en el suelo
zoomindelay = 0
zoominspeed = 1
zoomoutspeed = 1
tensionhigh = 155      ;= zoffset, mantiene el encuadre normal con zoom 1
tensionlow = 37        ;con los dos en el suelo permite zoom 1.25; al saltar se aleja hacia 1

[PlayerInfo]
p1startx =-80
p1starty =0
p1startz =0
p1facing =1

p2startx =80
p2starty =0
p2startz =0
p2facing =-1

leftbound =-1000
rightbound =1000
topbound =0
botbound =0


[Scaling]
topz =0
botz =50
topscale =1
botscale =1.2


[Bound]
screenleft  =15
screenright =15


[StageInfo]
zoffset  = 155
autoturn = 1
resetBG  = 1


[Shadow]
intensity = 20
yscale =-0.1
fade.range = -400,-1


[Music]
bgmusic  = sound/The Going Merry Flies.mp3
bgvolume = 500

;-----------------------------------------------------------------
[BGdef]
spr = Merry_Go!.sff
debugbg = 0

;===============================================================================
;Sky & Sun
;===============================================================================
[BG Sky]
type =normal
spriteno =0,0
start = 0,0
delta =1.5,1.5 ;Å¶
mask = 1

[BG Sun]
type  = normal
spriteno = 0, 2
layerno = 0
start = -180,-180
mask  = 1
trans = add
delta = .8,.8
tilespacing = 0,0

[BG Sun Effect]
