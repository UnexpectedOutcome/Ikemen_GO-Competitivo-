;--------------------------------------------------------
[Info]
name = "Crystal Area"
displayname = "Crystal Area"
versiondate = 30,03,2020 ;15,10,2019
mugenversion = 1.0
author = "Gudine"

;--------------------------------------------------------
[Camera]
 ;Camera starting position: Usually 0 for both
startx = 0
starty = 0

boundleft = -236
boundright = 236

boundhigh = -75
boundlow = 0

verticalfollow = .4

floortension = 0

;tensionhigh = 95
;tensionlow = -5

tension = 60

overdrawhigh = 0
overdrawlow = 0

cuthigh = 35
cutlow = 25

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
 ;p1startx is typically -70 and p2startx is 70.
 ;p1starty should be 0.
p1startx = -70          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2facing = -1

;--- Common ---
 ;Don't change these values.
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound

;--------------------------------------------------------
[Bound]
 ;Distance from left/right edge of screen that player can move to
 ;Typically 15
screenleft = 15    ;Dist from left of screen that player can move to
screenright = 15   ;Right edge

;--------------------------------------------------------
[StageInfo]
zoffset = 174

autoturn = 1

resetBG = 1

localcoord = 320, 240

xscale = 1
yscale = 1

;--------------------------------------------------------
[Shadow]
intensity = 0
color = 0,0,0
yscale = 0
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]

bgmusic = sound/Strong Performer.mp3
bgmloopstart = 254946

;========================================================
;--------------------------------------------------------
; Main background definition
[BGdef]
spr = CrystalArea.sff
debugbg = 0

;====================================
;============ BG & Floor ============
;====================================
[BG Main BG]
type  = normal
spriteno = 0,0
layerno = 0
start = 0,-45
delta = .8,0.6
mask  = 0
tile  = 1, 0
tilespacing = 0,0

;----------
[BG Top BG]
type  = anim
actionno = 1
layerno = 0
start = 0,-25
delta = .75,.3
mask  = 1
tile  = 1, 0
tilespacing = 336,0

;----------
[BG Bot BG]
type  = anim
actionno = 2
layerno = 0
start = 0,180
delta = .75,0.85
mask  = 1
tile  = 1, 0
tilespacing = 336,0

;----------
[BG Floor]
type  = normal
spriteno = 10,0
start = -12, 170
delta = 1,1
tile = 1,0

