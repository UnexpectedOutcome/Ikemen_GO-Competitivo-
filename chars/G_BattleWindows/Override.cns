;---------------------------------------------------------------------------
; Introduction
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 191, 3]
type = PosSet
trigger1 = time = 0
x = 0

[State 191, 3]
type = ChangeState
trigger1 = ctrl = 1
value = 0

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
ctrl = 0

[State 0, 1]
type = CtrlSet
trigger1 = ctrl
value = 0

[State 191, 3]
type = PosSet
trigger1 = time = 0
x = 0

[State 0, Helper]
type = Helper
trigger1 = Var(20) = 0
trigger1 = time = 0 && !NumHelper(200)
name = "Windows"
ID = 200
stateno = 200
pos = 0,0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999

[State 0, Helper]
type = Helper
trigger1 = Var(20) < 4
trigger1 = time = 0 && !NumHelper(1000)
name = "Camera Controller"
ID = 1000
stateno = 1000
pos = 0,0
postype = p1
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 99999
pausemovetime = 99999

[State 0, Helper]
type = ChangeState
trigger1 = Var(5) = -1 && Var(6) = -1
value = 180

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = S
physics = S

[State 10, 3]
type = ChangeState
trigger1 = time = 0
value = 0
ctrl = 0

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 10 && AnimElemNo(0) < 4
value = 12
elem = 2

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = !(Anim = 10 && AnimElemNo(0) < 4)
trigger1 = Anim != 12
value = 12

[State 10, 1]
type = Explod
trigger1 = time > 0
trigger1 = AnimElemTime(2) = 0
anim = 14
ID = 14
pos = 0,0
postype = p1
facing = 1
bindtime = 1
removetime = -2
ownpal = 1
removeongethit = 1
scale = .5,.5
supermovetime = 9999
pausemovetime = 9999

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 10, 3]
type = ChangeState
trigger1 = time = 0
value = 0
ctrl = 0

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
sprpriority = 1

[State 10, 3]
type = ChangeState
trigger1 = time = 0
value = 0
ctrl = 0

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
value = 3,4
volumescale = 100
channel = -1
loop = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElemTime(14) = 0
value = 3,5
volumescale = 100
channel = -1
loop = 0

[State 0, Helper]
type = Helper
trigger1 = AnimElemTime(14) = 0
name = "Tablet"
ID = 171
stateno = 171
pos = 10,-45
postype = p1
facing = 1
ownpal = 1

[State 170, 1]
type = AssertSpecial
trigger1 = time < 100
flag = roundnotover

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state
[Statedef 180]
type = S
ctrl = 1

[State 0, Null]
type = ctrlset
trigger1 = time = 1
value = 0

