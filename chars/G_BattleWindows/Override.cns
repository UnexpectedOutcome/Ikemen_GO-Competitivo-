;---------------------------------------------------------------------------
; Air get-hit (falling)
[Statedef 5050]
type    = A
movetype= H
physics = N

[State 5050, 6]
type = ChangeState
trigger1 = 1
value = 5150

;---------------------------------------------------------------------------
; Downed get-hit (lying defeated)
[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = -3
ctrl = 0

[State 5900, Variables]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, Start Var]
type = Null
trigger1 = PalNo%6 != [4,5]
trigger1 = Var(2) := 1
trigger2 = Var(2) := 3

[State 5900, End Var]
type = Null
trigger1 = PalNo%6 = [1,3]
trigger1 = Var(3) := 3
trigger2 = Var(3) := 5

[State 5900, Other Variables]
type = Null
trigger1 = 1
;trigger1 = Var(2) := 3 ;Starting Character
;trigger1 = Var(3) := 5 ;Last Character
trigger1 = Var(57) := 120 || 1 ; Time Delay Constant
trigger1 = Var(58) := 320 || 1 ; Base Life for characters (Magician's life)
trigger1 = Var(58) := Floor(Var(58) * Cond(enemy(0), TeamMode = Simul && TeamMode != Simul, 1.5,1)) ;Double life when fighting Simul Team
trigger1 = Var(59) := -9 || 1 ; Space between ground and windows
trigger1 = FVar(1) := 0.64 || 1 ; Life Multipliers: Slime
trigger1 = FVar(2) := 0.8 || 1 ; Puppet
trigger1 = FVar(3) := 1 || 1 ; Magician
trigger1 = FVar(4) := 2.25 || 1 ; Evil Knight
trigger1 = FVar(5) := 3.125 || 1 ; Great Dragon

[State 5900, 5]
type = ChangeState
trigger1 = 1
value = 190
ctrl = 0