;==============================
;Post-Game Start
[Statedef 6600]
anim = 0

[State 0, Clean Up]
type = VarRangeSet
trigger1 = time = 0
value = 0

[State 0, Clean Up]
type = VarRangeSet
trigger1 = time = 0
fvalue = 0

[State 0, Phrase Setup]
type = Null
trigger1 = time = 0
trigger1 = root, Cond(1, Var(20) := 1, 0)
trigger1 = Var(20) := 11 ;Initial range of phrases to choose
trigger1 = Var(21) := 2  ;Amount of partner-only phrases to choose (comes after normal phrases)
trigger1 = Var(21) := Var(21)*(root, Var(5) = 1 && root, Var(6) = 1) || 1

[State 0, EXP]
type = ChangeState
trigger1 = root, Var(0) = 0
value = 6610

;==============================
;Post-Game Standby
[Statedef 6601]
anim = 0

[State 0, Sorting 1]
type = Null
triggerall = Var(40) := 0 || 1
triggerall = root, Var(0) = 0
trigger1 = Var(1) > Var(5)
trigger1 = Var(50) := Var(1)
trigger1 = Var(1) := Var(5) || 1
trigger1 = Var(5) := Var(50)

[State 0, Sorting 2]
type = Null
triggerall = root, Var(0) = 0
trigger1 = Var(1) > Var(4)
trigger1 = Var(50) := Var(1)
trigger1 = Var(1) := Var(4) || 1
trigger1 = Var(4) := Var(50)

[State 0, Sorting 3]
type = Null
triggerall = root, Var(0) = 0
trigger1 = Var(1) > Var(3)
trigger1 = Var(50) := Var(1)
trigger1 = Var(1) := Var(3) || 1
trigger1 = Var(3) := Var(50)

[State 0, Sorting 4]
type = Null
triggerall = root, Var(0) = 0
trigger1 = Var(1) > Var(2)
trigger1 = Var(50) := Var(1)
trigger1 = Var(1) := Var(2) || 1
trigger1 = Var(2) := Var(50)

[State 0, Sorting 5]
type = Null
triggerall = root, Var(0) = 0
trigger1 = Var(2) > Var(5)
trigger1 = Var(50) := Var(2)
trigger1 = Var(2) := Var(5) || 1
trigger1 = Var(5) := Var(50)

[State 0, Sorting 6]
type = Null
triggerall = root, Var(0) = 0
trigger1 = Var(2) > Var(4)
trigger1 = Var(50) := Var(2)
trigger1 = Var(2) := Var(4) || 1
trigger1 = Var(4) := Var(50)

[State 0, Sorting 7]
type = Null
triggerall = root, Var(0) = 0
trigger1 = Var(2) > Var(3)
trigger1 = Var(50) := Var(2)
trigger1 = Var(2) := Var(3) || 1
trigger1 = Var(3) := Var(50)

[State 0, Sorting 8]
type = Null
triggerall = root, Var(0) = 0
trigger1 = Var(3) > Var(5)
trigger1 = Var(50) := Var(3)
trigger1 = Var(3) := Var(5) || 1
trigger1 = Var(5) := Var(50)

[State 0, Sorting 9]
type = Null
triggerall = root, Var(0) = 0
trigger1 = Var(3) > Var(4)
trigger1 = Var(50) := Var(3)
trigger1 = Var(3) := Var(4) || 1
trigger1 = Var(4) := Var(50)

[State 0, Sorting 10]
type = Null
triggerall = root, Var(0) = 0
trigger1 = Var(4) > Var(5)
trigger1 = Var(50) := Var(4)
trigger1 = Var(4) := Var(5) || 1
trigger1 = Var(5) := Var(50)

[State 0, Skip Used Numbers]
type = Null
triggerall = root, Var(0) = 0
triggerall = Var(10) := (Var(1) != 0)+(Var(2) != 0)+(Var(3) != 0)+(Var(4) != 0)+(Var(5) != 0) || 1
triggerall = Var(0) := random%(Var(20)+Var(21)-Var(10)) || 1
trigger1 = Cond(Var(1), Cond((Var(0) >= Var(1)-1), Var(0) := Var(0) + 1, 1), 1) || 1
trigger1 = Cond(Var(2), Cond((Var(0) >= Var(2)-1), Var(0) := Var(0) + 1, 1), 1) || 1
trigger1 = Cond(Var(3), Cond((Var(0) >= Var(3)-1), Var(0) := Var(0) + 1, 1), 1) || 1
trigger1 = Cond(Var(4), Cond((Var(0) >= Var(4)-1), Var(0) := Var(0) + 1, 1), 1) || 1
trigger1 = Cond(Var(5), Cond((Var(0) >= Var(5)-1), Var(0) := Var(0) + 1, 1), 1) || 1

[State 0, Skip Used Numbers]
type = DisplayToClipboard
trigger1 = 1
text = "%d"
params = Var(10)

[State 0, Skip Used Numbers]
type = AppendToClipboard
trigger1 = 1
text = "\n%d, %d, %d, %d, %d"
params = Var(1),Var(2),Var(3),Var(4),Var(5)

[State 0, Add To Used Numbers]
type = Null
triggerall = root, Var(0) = 0
trigger1 = !Var(1)
trigger1 = Var(1) := Var(0)+1 || 1
trigger2 = !Var(2)
trigger2 = Var(2) := Var(0)+1 || 1
trigger3 = !Var(3)
trigger3 = Var(3) := Var(0)+1 || 1
trigger4 = !Var(4)
trigger4 = Var(4) := Var(0)+1 || 1
trigger5 = !Var(5)
trigger5 = Var(5) := Var(0)+1 || 1

[State 0, Countdown]
type = Null
trigger1 = root, Var(0) = 0
trigger1 = Var(45) >= 4
trigger1 = root, Cond(1, Var(20) := Var(20) + 1, 0)

[State 0, ChangeState]
type = ChangeState
trigger1 = root, Var(0) = 0
trigger1 = Var(45) < 6
trigger1 = Var(45) := Var(45) + 1
value = 6620+Var(0)

[State 0, ChangeState]
type = ChangeState
trigger1 = root, Var(0) = 0
trigger1 = Var(45) = 6
value = 6602

