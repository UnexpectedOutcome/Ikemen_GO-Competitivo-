air.velocity = -3*Cond(Vel X < 0, -1, 1),-5
fall = 1
fall.xvelocity = -1
fall.yvelocity = -4
palfx.time = 80
palfx.add = 240,50,0
palfx.mul = 250,224,120
palfx.sinadd = 110,55,85,10
palfx.invertall = 1
palfx.color = 0

[State 0, Hit P1]
type = Null
triggerall = NumTarget && NumEnemy && movecontact = 1
trigger1 = target, ID = Enemy(0), ID
trigger1 = Cond(moveguarded, (root, Cond(1,Var(7) := 2,0)), (root, Cond(1,Var(7) := 1,0)))
trigger2 = target, ID = Enemy(1), ID
trigger2 = Cond(moveguarded, (root, Cond(1,Var(8) := 2,0)), (root, Cond(1,Var(8) := 1,0)))

[State 0, Bork]
type = TargetDrop
trigger1 = NumTarget

[State 0, Hit P2]
