;==============================
;Aggro Star
[Statedef 601]
anim = 600
sprpriority = 2
movetype = A

[State 0, Turn around]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 0, Init]
type = Null
trigger1 = time = 0
trigger1 = FVar(0) := (parent, fvar(13)/parent, fvar(15))
trigger1 = FVar(1) := (parent, fvar(14)/parent, fvar(15))
trigger1 = Var(5) := 1
trigger1 = Var(6) := 1
trigger1 = Var(43) := 1

[State 0, Flip Horizontal]
type = Null
triggerall = Var(7) = 0
trigger1 = ScreenPos X < 11 || ScreenPos X > GameWidth-11
trigger1 = Var(7) := 1
trigger1 = Var(5) := -1
trigger1 = Var(43) := 1

[State 0, Flip Vertical]
type = Null
triggerall = Var(7) = 0
trigger1 = Pos Y > -11 || ScreenPos Y < 11
trigger1 = Var(7) := 1
trigger1 = Var(6) := -1

[State 0, Turn around]
type = VelSet
trigger1 = 1
x = Const(size.head.pos.x)*FVar(0)*Var(5)
y = Const(size.head.pos.x)*FVar(1)*Var(6)

[State 0, RIP]
type = DestroySelf
trigger1 = ScreenPos X != [-22, GameWidth+22]
trigger2 = ScreenPos y != [-22, GameHeight+22]

[State 0, HitDef]
type = HitDef
trigger1 = Var(43) = 1
trigger1 = Var(43) := 0 || 1
attr = S,SP
hitflag = MA
guardflag = MA
animtype = hard
air.animtype = hard
damage = Floor(0.3*Const(size.head.pos.y)),0
pausetime = 0,3
sparkno = -1
guard.sparkno = -1
hitsound = S0,3
guardsound = S0,4
ground.type = High
ground.slidetime = 15
ground.hittime = 20
air.hittime = 20
ground.velocity = -5*Cond(Vel X < 0, -1, 1)
air.velocity = -3*Cond(Vel X < 0, -1, 1),-1
id = 600+ID
nochainid = 600+ID

[State 0, Hit P1]
type = Null
triggerall = NumTarget && NumEnemy && movecontact = 1
trigger1 = target, ID = Enemy(0), ID
trigger1 = Cond(moveguarded, (root, Cond(1,Var(7) := 2,0)), (root, Cond(1,Var(7) := 1,0)))
trigger2 = target, ID = Enemy(1), ID
trigger2 = Cond(moveguarded, (root, Cond(1,Var(8) := 2,0)), (root, Cond(1,Var(8) := 1,0)))

[State 0, Bork]
