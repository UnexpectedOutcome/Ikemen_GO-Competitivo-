trigger1 = Cond(moveguarded, (root, Cond(1,Var(7) := 2,0)), (root, Cond(1,Var(7) := 1,0)))
trigger2 = target, ID = Enemy(1), ID
trigger2 = Cond(moveguarded, (root, Cond(1,Var(8) := 2,0)), (root, Cond(1,Var(8) := 1,0)))

