[State 0, Turn around]
type = DisplayToClipboard
trigger1 = 1
text = "Argh = %d"
params = Var(16)

[State 0, Turn around]
type = Null
trigger1 = time = 0
trigger1 = fvar(16) := (pi/2)*Var(16) || 1;Basic snap (0,90,180,270,360,etc.)
trigger1 = fvar(16) := fvar(16) + (pi/8) || 1;22.5 degrees offset
trigger1 = fvar(16) := fvar(16) - (pi/16)*(Const(size.height)-1) || 1;Offset based on special value defined in helper generation

[State 0, Turn around]
type = VelSet
trigger1 = 1
x = 10*sin(fvar(16))
y = 10*cos(fvar(16))

[State 0, HitDef]
type = HitDef
trigger1 = uniqhitcount < NumEnemy
attr = S,SP
hitflag = MA-
guardflag = MA
animtype = DiagUp
damage = 150,0
pausetime = 0,3
sparkno = -1
hitsound = S600,2
guardsound = S0,4
guard.sparkno = -1
ground.type = High
ground.slidetime = 15
ground.hittime = 20
air.hittime = 20
