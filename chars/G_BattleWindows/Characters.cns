triggerall = (gametime/2)%4 = 0
trigger1 = Var(25) || Var(26)
time = 1
add = 256,256,256
mul = 256,256,256
invertall = 0
color = 256

[State 0, Turn around]
type = Turn
trigger1 = time = 0
trigger1 = NumEnemy
