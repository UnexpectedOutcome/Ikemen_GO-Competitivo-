;Character Hit
[Statedef 2022]
anim = Const(size.head.pos.x)+1
movetype = H

[State 0, PalFXWiz]
type = VarSet
trigger1 = time = 0
v = 40
value = gametime

[State 0, Delta]
type = Null
trigger1 = Var(25)
trigger1 = Var(15) := Var(15) + Ceil(GetHitVar(damage)/4.0) || 1
trigger1 = Root, Cond(1, Var(1) := Var(1) - Cond(NumHelper(2000+100*Var(2)), Ceil((Helper(2000+100*Var(2)), GetHitVar(damage))/4.0), 0), 0) || 1
trigger2 = Var(15) := Var(15) + GetHitVar(damage) || 1
trigger2 = Root, Cond(1, Var(1) := Var(1) - Cond(NumHelper(2000+100*Var(2)), Helper(2000+100*Var(2)), GetHitVar(damage), 0), 0) || 1

[State 0, Test]
type = DisplayToClipboard
trigger1 = GetHitVar(damage)
text = "%d, %d"
params = Var(15), Root, Var(1)

[State 0, Yikes]
