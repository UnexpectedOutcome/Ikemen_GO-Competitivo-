;==============================
;Character Intro
[Statedef 2000]
anim = Const(size.head.pos.x)

[State 0, Hey, Pal!]
type = RemapPal
trigger1 = root, PalNo > 6
source = Const(size.head.pos.x)-2000, 1
dest = Const(size.head.pos.x)-2000, 2

[State 0, Life Start]
type = Null
triggerall = time = 0 && root, Var(1) <= 0
trigger1 = Root, Cond(1, Var(1) := Floor(Var(58)*FVar(Var(2))), 0) || 1

[State 0, PalFX]
type = PalFX
trigger1 = 1
time = 1

[State 0, PalFX]
type = PalFX
trigger1 = time < 8
time = 1
mul = 0,0,0

[State 0, PalFX]
type = PalFX
trigger1 = time = [8,80)
time = 1
add = Cond(((time-8)/4)%6 = 0, 256, Cond((((time-8)/4)%6 = [3,4]), 256, 0)),Cond(((time-8)/12)%2 = 0, 256, 0),Cond(((time-8)/4)%2 = 1, 256,0)
mul = Cond(((time-8)/4)%6 = 0, 256, Cond((((time-8)/4)%6 = [3,4]), 256, 0)),Cond(((time-8)/12)%2 = 0, 256, 0),Cond(((time-8)/4)%2 = 1, 256,0)

[State 0, PalFX]
type = PalFX
trigger1 = time >= 80
time = 1
add = 256,256,256

[State 300, Null]
type = PosSet
trigger1 = 1
x = root, pos x + const(size.mid.pos.x)
y = 36 - 7 + root, Var(59) -16; + ((PalNo <= 6)*-16)

[State 0, Turn around]
type = Turn
trigger1 = time = 0
trigger1 = NumEnemy
trigger1 = Cond(Facing = 1, EnemyNear, Pos X < Pos X, EnemyNear, Pos X > Pos X)

[State 300, State]
type = ChangeState
trigger1 = time = 87
value = Const(size.head.pos.x)

;==============================
;Character Fall
[Statedef 2020]
anim = Const(size.head.pos.x)

[State 0, Guarding Blink]
type = PalFX
triggerall = (gametime/2)%4 = 0
trigger1 = Var(25) || Var(26)
time = 2
add = 256,256,256
mul = 256,256,256
invertall = 0
color = 256

[State 0, Delta]
type = Null
trigger1 = time = 0
trigger1 = Var(15) := 0

[State 0, Gravity]
type = VelAdd
trigger1 = Pos Y < Const(size.mid.pos.y)
y = 0.2

[State 0, Snap]
type = VelSet
trigger1 = Vel Y != 0 && Pos Y >= Const(size.mid.pos.y)
y = 0

[State 0, Snap]
type = PosSet
trigger1 = Pos Y > Const(size.mid.pos.y)
y = Const(size.mid.pos.y)

[State 0, Heavy]
type = PlaySnd
trigger1 = Pos Y = Const(size.mid.pos.y)
persistent = 0
value = 0, 2

[State 0, Message]
type = Explod
trigger1 = Pos Y = Const(size.mid.pos.y)
anim = 7
ID = 7
pos = 0, -Const(size.mid.pos.y)
postype = p1
facing = 1
bindtime = 1
removetime = -2
sprpriority = 0
ontop = 1
ownpal = 1

[State 0, Snap]
type = EnvShake
trigger1 = Pos Y = Const(size.mid.pos.y)
time = 10
freq = 60
ampl = -4
persistent = 0

[State 0, Snap]
type = ChangeState
trigger1 = Pos Y = Const(size.mid.pos.y)
trigger1 = Root, Cond(1, Var(0) := 360, 0) || 1
value = 2021

