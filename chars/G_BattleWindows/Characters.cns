trigger1 = Root, Cond(1, Var(0) := Var(0)/2, 0) || 1

[State 0, Dead]
type = PlaySnd
trigger1 = root, Var(1) <= 0
trigger1 = Root, Cond(1, Var(0) := 6000, 0) || 1
value = 10, 0

[State 0, Snap]
