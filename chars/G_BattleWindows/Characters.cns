[State 300, Angry]
type = ChangeAnim
trigger1 = time = 30
value = 2410

[State 300, Slime]
type = Helper
trigger1 = time = 30
name = "Ice Spell Gen"
ID = 650
stateno = 650
pos = 3,-37
postype = p1
facing = 1
keyctrl = 0
supermovetime = 100
pausemovetime = 100
size.height = Cond(Var(26), 175, 100)

[State 300, Fall]
type = ChangeState
