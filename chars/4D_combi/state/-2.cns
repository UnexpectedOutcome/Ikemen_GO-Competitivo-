;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]
;-----------------------------------------
;技の使用制限関係
;空中ダッシュリセット
[State -2, ]
type = VarSet
trigger1 = var(2) >= 1
trigger1 = statetype = S
var(2) = 0

;スペースヴォルテックス
[State -2, ]
type = VarSet
trigger1 = var(6) >= 1
trigger1 = statetype = S
var(6) = 0

[State -2, ]
type = VarRandom
trigger1 = time%2 = 0
v = 10
range = 1
;-----------------------------------
;コンボ補正用
[State -2, ]
type = VarSet
triggerall = var(50) = 0
triggerall = var(51) = 0
TriggerAll = NumEnemy 
TriggerAll = Alive 
trigger1 = Enemy,GetHitVar(HitCount) < 8
trigger1 = P2movetype = H
fvar(5) = Enemy,GetHitVar(HitCount)

[State -2, ]
type = VarSet
TriggerAll = NumEnemy 
TriggerAll = Alive 
triggerall = Enemy,GetHitVar(HitCount) < 8
triggerall = P2movetype = H
trigger1 = var(50) = 1
trigger2 = var(51) = 1
fvar(5) = Enemy,GetHitVar(HitCount)*0.5

[State -2, ]
type = VarSet
TriggerAll = NumEnemy 
TriggerAll = Alive 
triggerall = var(50) = 0
triggerall = var(51) = 0
trigger1 = Enemy,GetHitVar(HitCount) >= 8
trigger1 = P2movetype = H
fvar(5) = 8

[State -2, ]
type = VarSet
TriggerAll = NumEnemy 
TriggerAll = Alive 
triggerall = Enemy,GetHitVar(HitCount) >= 16
triggerall = P2movetype = H
trigger1 = var(50) = 1
trigger2 = var(51) = 1
fvar(5) = 8

[State -2, ]
type = VarSet
trigger1 = fvar(5) > 0
trigger1 = P2movetype != H
fvar(5) = 0
;-----------------------------------------
;ブラックホール使用制限関係
[state -2, アイコン1P側 ]
type = Helper
triggerall = var(50) != 1
trigger1 = teamside = 1
trigger1 = RoundState = 2
trigger1 = var(44) != 3 
trigger1 = numhelper(4900) = 0
helpertype = normal
name = "4900"
ID = 4900
pos = 30,-30
postype = left
facing = 1
stateno = 4900
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0
size.xscale = 0.5
size.yscale = 0.5

[state -2, アイコン2P側 ]
type = Helper
triggerall = var(50) != 1
trigger1 = teamside = 2
trigger1 = RoundState = 2
trigger1 = var(44) != 3 
trigger1 = numhelper(4901) = 0
helpertype = normal
name = "4901"
ID = 4901
pos = -30,-30
postype = right
facing = 1
stateno = 4901
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0
size.xscale = 0.5
size.yscale = 0.5

[State -2, 変数];
type = Varset
triggerall = numhelper(4905) = 0
triggerall = var(4) <= 60
trigger1 = helper(4000),var(4) = 1
trigger2 = helper(4005),var(4) = 1
trigger3 = helper(4010),var(4) = 1
trigger4 = helper(4015),var(4) = 1
trigger5 = helper(4050),var(4) = 1
trigger6 = helper(3065),var(4) = 1
var(4) = 240

[State -2, 変数];
type = Varset
triggerall = numhelper(4905) = 0
triggerall = var(4) <= 450
trigger1 = helper(4000),var(4) = 2
trigger2 = helper(4005),var(4) = 2
trigger3 = helper(4010),var(4) = 2
trigger4 = helper(4015),var(4) = 2
trigger5 = helper(4050),var(4) = 2
var(4) = 450

[State -2, 変数];
type = Varset
triggerall = numhelper(4905) = 1
trigger1 = var(4) <= 60
trigger1 = helper(4905),var(4) = 2
var(4) = 480

[State -2, 変数];
type = Varadd
trigger1 = var(4) > 0
var(4) = -1
;-----------------------------------------
;ストップザタイム中無敵
[State -2, ]
type = Varadd
trigger1 = var(20) > 0
var(20) = -1

[State -2]
type = nothitby
trigger1 = var(20) > 0
value = SCA
time = 1

;ストップザタイム中ガード不能
[state -2]
type = AssertSpecial
trigger1 = var(20) > 0
flag = UnGuardable
