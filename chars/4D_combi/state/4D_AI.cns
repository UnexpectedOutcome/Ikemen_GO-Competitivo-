trigger57 = Command = "AI56"
trigger58 = Command = "AI57"
trigger59 = Command = "AI58"
trigger60 = Command = "AI59"
trigger61 = Command = "AI60"
;trigger62 = RoundState = 2 ;AI常時起動 ONにしたい場合は左端の;を削除
var(59) = 3   ;ここを1～5でレベル設定。0にするとAIオフ。
ignorehitpause = 1
;----------------------------------------------------------------------
;AIレベルについて
;　・1はほとんどガードとかしません。大体3以上から全ての技を使ってきます。
;
;----------------------------------------------------------------------
;プレイヤーID取得
[State -3];変数設定
Type = varset
triggerall = !ishelper
triggerall = var(59) >= 1
trigger1 = numenemy = 1
var(40) = enemynear,ID

[State -3];変数設定
Type = varset
triggerall = !ishelper
triggerall = var(59) >= 1
trigger1 = numenemy=2
var(40) = ifelse(EnemyNear(0),alive,enemynear(0),ID,enemynear(1),ID)
;---------------------------------------------------------------------------
[State -3, 四次元交差]
type = ChangeState
value = 3500
triggerall = var(59) >= 1 && RoundState = 2
triggerall = var(50) != 1
triggerall = statetype != A
triggerall = (p2statetype = S) || (p2statetype = C)
triggerall = ctrl
triggerall = p2statetype != L
triggerall = p2stateno != [5000,5400]
triggerall = numhelper(4910) = 0
triggerall = var(44) = 1
triggerall = var(20) = 0
trigger1 = p2bodydist X = [0,50]
trigger1 = p2movetype != H
trigger1 = random <= 800

