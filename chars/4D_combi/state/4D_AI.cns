trigger3 = ctrl
trigger3 = P2bodydist Y = [-10,80]

[State -3, 四次元エネミーステップ]
type = ChangeState
value = 620
triggerall = var(59) >= 1 && RoundState = 2 
triggerall = statetype = A
triggerall = p2statetype != L
triggerall = Pos Y < -55
triggerall = stateno != 462
triggerall = stateno != 1120
triggerall = stateno != 900
trigger1 = ctrl
trigger1 = P2bodydist X = [-5,10]
trigger1 = random <= 80

[State -3, 四次元ボディプレス]
