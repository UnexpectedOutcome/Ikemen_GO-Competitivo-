type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, ]
type = ScreenBound
trigger1 = AnimElemTime(11) > 0
value = 0
movecamera = 0,0

[State 181, ]
type = VelSet
trigger1 = AnimElem = 3
x = -2.5
Y = -7.5

[State 181, ]
type = Veladd
trigger1 = AnimElemTime(3) > 0 && AnimElemTime(11) < 0
y = 0.4

[State 181, ]
type = VelSet
trigger1 = AnimElem = 11
x = 7
Y = -1

[State 181, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 3
value = 800, 0

[State 181, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 11
value = 100, 0

[State 181, 声]
type = PlaySnd
trigger1 = Animelem = 3
trigger1 = Var(10) = 0
value = 1200, 2
channel = 0
volume = 220

[State 181, 声]
type = PlaySnd
trigger1 = Animelem = 3
trigger1 = Var(10) = 1
value = 1200, 1
channel = 0
volume = 220

[State 181, 特殊効果]
type = AssertSpecial
trigger1 = time <= 280
flag = roundnotover
