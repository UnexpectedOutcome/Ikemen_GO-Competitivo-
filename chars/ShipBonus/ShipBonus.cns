;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 190


;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, NotHitBy]
type = nothitby
trigger1 = !ishelper
time = -1
value = SCA, AA, AP, AT
ignorehitpause = 1

[State -2, No Push]
type = playerpush
trigger1 = !ishelper
value = 0


[State -2, Not Bound]
type = turn
trigger1 = ishelper && (facing = -1)
ignorehitpause = 1
value = 1


[State -2, Be Unseen!]
type = assertspecial
trigger1 = !ishelper
flag = invisible











