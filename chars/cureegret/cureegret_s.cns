;【コマンド技のステート】
;
;600	 ダブル・スレッジ・ハンマー/ジャンプかかと落とし
;605	 ダブル・スレッジ・ハンマーEX/ジャンプかかと落としEX
;606	 ダブル・スレッジ・ハンマーEXアーマー/ジャンプかかと落としEXアーマー
;
;650	 ラッシュアタック
;655	 ラッシュアタックEX
;
;750	 スマッシュパンチ
;751	 スマッシュパンチやられ
;755	 スマッシュパンチEX
;756	 スマッシュパンチEXアーマー
;757	 スマッシュパンチEXやられ
;
;850	 めくり裏拳
;851	 めくり裏拳やられ
;855	 めくり裏拳EX
;856	 めくり裏拳EXやられ
;
;900	 OP光弾/巻き起こす風
;901	 巻き起こす風用ヘルパー
;905	 OP光弾EX/巻き起こす風EX
;906	 巻き起こす風EX用ヘルパー
;
;950	 アンダートス/サマーソルトキック
;952	 飛び道具打消し用ヘルパー
;955	 アンダートスEX/サマーソルトキックEX
;========================================================================
;========================================================================
;========================================================================
;ダブル・スレッジ・ハンマー/ジャンプかかと落とし
[Statedef 600]
type = U
movetype = A
physics = N
juggle = 2
velset = 0,0
ctrl = 0
poweradd = -50

[State 600, チェーンコンボ用var50]
type = VarSet
trigger1 = !var(59) && (Time = 0)
var(50) = 0
IgnoreHitPause = 1

[State 600, パワーマイナス]
type = PowerAdd
triggerall = Time = 0
trigger1 = (Prevstateno = 650) || (Prevstateno = 655) || (Prevstateno = 750) || (Prevstateno = 755)
trigger2 = (Prevstateno = 850) || (Prevstateno = 855) || (Prevstateno = 900) || (Prevstateno = 905) || (Prevstateno = 950) || (Prevstateno = 955)
value = -100

[State 600, 光る]
type = PalFX
triggerall = Time = 0
trigger1 = (Prevstateno = 650) || (Prevstateno = 655) || (Prevstateno = 750) || (Prevstateno = 755)
trigger2 = (Prevstateno = 850) || (Prevstateno = 855) || (Prevstateno = 900) || (Prevstateno = 905) || (Prevstateno = 950) || (Prevstateno = 955)
time = 6
add = 100,100,100

[State 600, 効果音]
type = PlaySnd
triggerall = Time = 0
trigger1 = (Prevstateno = 650) || (Prevstateno = 655) || (Prevstateno = 750) || (Prevstateno = 755)
trigger2 = (Prevstateno = 850) || (Prevstateno = 855) || (Prevstateno = 900) || (Prevstateno = 905) || (Prevstateno = 950) || (Prevstateno = 955)
value = S100,10

[State 600, 振り向き]
type = Turn
trigger1 = (Time = 0) && (P2dist x < 0)

[State 600, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),600,601)+ifelse((var(0) < 0),7000,0)

[State 600, ターゲット速度ｘｙ]
type = TargetVelSet
trigger1 = (var(0) < 0) && (Time = [0,6]) && (Prevstateno = 950) && Numtarget(7950)
trigger1 = fvar(10) := (target(7950),vel x)*0.5 || 1
x = fvar(10)
y = 0
ID = 7950

[State 600, ターゲット速度ｘｙ]
type = TargetVelSet
trigger1 = (Time = [0,6]) && (Prevstateno = 955) && Numtarget(ifelse((var(0) < 0),7955,955))
trigger1 = fvar(10) := (target(ifelse((var(0) < 0),7955,955)),vel x)*0.5 || 1
x = fvar(10)
y = 0
ID = ifelse((var(0) < 0),7955,955)

[State 600, 速度ｘｙ]
type = VelSet
trigger1 = (var(0) >= 0) && (Anim = Ifelse((Facing = 1),600,601)) && (Animelemtime(2) = 0)
trigger2 = (var(0) < 0) && (Anim = Ifelse((Facing = 1),7600,7601)) && (Animelemtime(3) = 0)
x = 9
y = -ifelse((P2bodydist x > 200),6.5,ifelse((P2bodydist x > 100),5.75,4.75))
persistent = 0

[State 600, アニメ]
type = ChangeAnim
trigger1 = (var(0) >= 0) && (Anim = Ifelse((Facing = 1),600,601)) && (Animelemtime(2) > 0)
trigger1 = ((P2bodydist x <= 45) && (Abs(p2dist y) <= 50)) || ((Vel y > 0) && (Pos y >= 0))
trigger2 = (var(0) < 0) && (Anim = Ifelse((Facing = 1),7600,7601)) && (Animelemtime(3) > 0)
trigger2 = ((P2bodydist x <= 60) && (Abs(p2dist y) <= 100)) || ((Vel y > 0) && (Pos y >= 0))
value = ifelse((Facing = 1),602,603)+ifelse((var(0) < 0),7000,0)
persistent = 0

[State 600, 速度ｘｙ]
type = VelSet
trigger1 = Movecontact
x = 0
y = 0
IgnoreHitPause = 1

[State 600, 重力]
type = Gravity
trigger1 = (var(0) >= 0) && (Anim = Ifelse((Facing = 1),600,601)) && (Animelemtime(2) > 0)
trigger2 = (var(0) < 0) && (Anim = Ifelse((Facing = 1),7600,7601)) && (Animelemtime(3) > 0)

[State 600, ステートタイプ]
type = StateTypeSet
trigger1 = (var(0) >= 0) && (Anim = Ifelse((Facing = 1),600,601)) && (Animelemtime(2) = 0)
trigger2 = (var(0) < 0) && (Anim = Ifelse((Facing = 1),7600,7601)) && (Animelemtime(3) = 0)
statetype = A
IgnoreHitPause = 1

[State 600, ダメージ]
type = HitDef
trigger1 = (var(55) < 30) && Ifelse((var(0) < 0),(Anim = [7602,7603]),(Anim = [602,603]))
attr = A,SA
hitflag = MAF
guardflag = MA
guard.dist = 100
animtype = Up
ground.type = Low
priority = 3,Hit
damage = ceil(60*fvar(38)-0.4),ceil(30*fvar(38)-0.4)
getpower = 0,0
givepower = ceil(30*fvar(38)-0.4),ceil(15*fvar(38)-0.4)
sparkno = Sifelse((var(0) < 0),6001,6000)
sparkxy = -20,ifelse((var(0) < 0),0,-50)
hitsound = S100,2
guardsound = F6,0
pausetime = 15,15
ground.slidetime = 3
ground.hittime = 15
guard.hittime = 13
guard.ctrltime = 13
air.hittime = 15
air.velocity = -5,ifelse((var(0) < 0),7,11)
fall = 1
fall.recover = 0
ID = ifelse((var(0) < 0),7600,600)
guard.kill = 0
persistent = 0

[State 600, 効果音]
type = PlaySnd
trigger1 = (var(0) >= 0) && (Anim = Ifelse((Facing = 1),600,601)) && (Animelemtime(2) = 0)
trigger2 = (var(0) < 0) && (Anim = Ifelse((Facing = 1),7600,7601)) && (Animelemtime(3) = 0)
value = S100,0

[State 600, 台詞]
type = PlaySnd
trigger1 = ((var(0) >= 0) && (Time = 9)) || ((var(0) < 0) && (Time = 0))
channel = 0
value = Sifelse((var(0) < 0),210,200),2

[State 600, ターゲット速度ｘｙ]
type = TargetVelSet
trigger1 = Numtarget(ifelse((var(0) < 0),7600,600)) && Target(ifelse((var(0) < 0),7600,600)),hitshakeover && (var(50) = 605)
y = 0
ID = ifelse((var(0) < 0),7600,600)
IgnoreHitPause = 1

[State 600, ジャンプヘ]
type = SelfState
trigger1 = (Movecontact >= 15) || ((Anim = Ifelse((Facing = 1),602,603)+Ifelse((var(0) < 0),7000,0)) && (Animelemtime(1) >= 15)) || ((Vel y > 0) && (Pos y >= 0))
value = 50
ctrl = 1

