;===============================================================================
;===============================================================================
[Statedef -2]
;===============================================================================
;設定できる項目
;===============================================================================
[State 相方用var0]
type = VarSet
trigger1 = !Ishelper
var(0) = 0
IgnoreHitPause = 1

[State AIレベル用var1]
type = VarSet
trigger1 = !Ishelper || Ishelper(7777)
var(1) = 3
IgnoreHitPause = 1

[State 攻撃力用fvar38]
type = VarSet
trigger1 = !Ishelper || Ishelper(7777)
fvar(38) = 1.0
IgnoreHitPause = 1

[State 防御力用fvar39]
type = VarSet
trigger1 = !Ishelper || Ishelper(7777)
fvar(39) = 1.0
IgnoreHitPause = 1

[State 初期パワー値用var58]
type = VarSet
trigger1 = (!Ishelper || Ishelper(7777)) && (Roundno = 1) && (Roundstate < 2)
var(58) = 1000
IgnoreHitPause = 1

;===============================================================================
;コモンシステム
;===============================================================================
[State デバック]
type = DisplayToClipboard
trigger1 = !Ishelper || Ishelper(7777)
text = "X:%d\tY:%d\tP2X:%f\tP2Y:%f\t"
params = ceil(pos x-0.4),ceil(pos y-0.4),(p2bodydist x),abs(p2dist y)
IgnoreHitPause = 1

[State デバック]
type = AppendToClipboard
trigger1 = !Ishelper || Ishelper(7777)
text = "v55:%d\tv50:%d\tv0:%d\tv59:%d"
params = var(55),var(50),var(0),var(59)
IgnoreHitPause = 1

[State 相方召喚]
type = Helper
trigger1 = !Ishelper && !Numhelper(7777) && (var(0) > 0) && (Numenemy = 1) && (Name = "cureegret") && (P3name != "curebloom")
helpertype = normal
name = "curebloom"
ID = 7777
pos = -30,0
postype = p1
keyctrl = 1
ownpal = 1
IgnoreHitPause = 1

[State 相方召喚]
type = Helper
trigger1 = !Ishelper && !Numhelper(7777) && (var(0) > 0) && (Numenemy = 2) && (Name = "cureegret") && (P3name != "curebloom")
helpertype = player
name = "curebloom"
ID = 7777
pos = -30,0
postype = p1
keyctrl = 1
ownpal = 1
IgnoreHitPause = 1

[State 相方用var0]
type = VarSet
trigger1 = !Ishelper && (var(0) = 0)
var(0) = ifelse((Name = "curebloom"),0,-1)
IgnoreHitPause = 1

[State 相方用var0]
type = VarSet
trigger1 = !Ishelper && (var(0) = 1)
var(0) = ifelse((Name = "curebloom"),ifelse((P3name = "cureegret"),1,0),ifelse((P3name = "curebloom"),-2,-1))
IgnoreHitPause = 1

[State ゲージ非表示]
type = AssertSpecial
trigger1 = Roundstate != 2
flag = Nobardisplay
IgnoreHitPause = 1

[State 無敵]
type = NotHitBy
trigger1 = Roundstate != 2
value = SCA
value2 = SCA
time = 1
IgnoreHitPause = 1

[State パワーセット]
type = PowerSet
trigger1 = (Roundno = 1) && (Roundstate < 2) && (Power < var(58))
value = var(58)
IgnoreHitPause = 1

[State パワー増加]
type = PowerAdd
trigger1 = (!Ishelper || Ishelper(7777)) && Gethitvar(damage)
value = gethitvar(damage)*abs(var(1))/3
IgnoreHitPause = 1

[State 防御力補正ダメージ]
type = LifeAdd
trigger1 = (!Ishelper || Ishelper(7777)) && Gethitvar(damage)
value = -ceil(gethitvar(damage)*(fvar(39)-1)-0.4)
IgnoreHitPause = 1

;===============================================================================
;飛び道具系
;===============================================================================
[State 飛び道具ステート記憶用var30]
type = VarSet
triggerall = (!Ishelper || Ishelper(7777)) && !var(30) && !var(31) && !var(32)
trigger1 = Enemy(0),numproj && (Enemy(0),movetype = A)
trigger2 = Enemy(1),numproj && (Enemy(1),movetype = A)
var(30) = ifelse((Enemy(0),numproj),(Enemy(0),stateno),(Enemy(1),stateno))
IgnoreHitPause = 1

[State 飛び道具ステート記憶用var31]
type = VarSet
triggerall = (!Ishelper || Ishelper(7777)) && var(30) && !var(31) && !var(32)
trigger1 = Enemy(0),numproj && (Enemy(0),movetype = A) && (Enemy(0),stateno != var(30))
trigger2 = Enemy(1),numproj && (Enemy(1),movetype = A) && (Enemy(1),stateno != var(30))
var(31) = ifelse((Enemy(0),numproj),(Enemy(0),stateno),(Enemy(1),stateno))
IgnoreHitPause = 1

[State 飛び道具ステート記憶用var32]
type = VarSet
triggerall = (!Ishelper || Ishelper(7777)) && var(30) && var(31) && !var(32)
trigger1 = Enemy(0),numproj && (Enemy(0),movetype = A) && (Enemy(0),stateno != var(30)) && (Enemy(0),stateno != var(31))
trigger2 = Enemy(1),numproj && (Enemy(1),movetype = A) && (Enemy(1),stateno != var(30)) && (Enemy(1),stateno != var(31))
var(32) = ifelse((Enemy(0),numproj),(Enemy(0),stateno),(Enemy(1),stateno))
IgnoreHitPause = 1

[State OP光弾/OP光弾EX効果音]
type = PlaySnd
trigger1 = !Ishelper || Ishelper(7777)
trigger1 = (var(33) = 60) || (var(34) = 60) || (var(35) = 60) || (var(36) = 60) || (var(37) = 60)
value = S100,5
volume = 50
IgnoreHitPause = 1

[State OP光弾効果音用var33]
type = VarAdd
trigger1 = (!Ishelper || Ishelper(7777)) && NumprojID(900)
v = 33
value = 1
IgnoreHitPause = 1

[State OP光弾効果音用var33]
type = VarSet
trigger1 = !Ishelper || Ishelper(7777)
trigger1 = (var(33) > 60) || !NumprojID(900)
var(33) = 0
