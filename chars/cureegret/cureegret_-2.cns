trigger1 = (!Ishelper || Ishelper(7777)) && NumprojID(901)
v = 34
value = 1
IgnoreHitPause = 1

[State OP光弾効果音用var34]
type = VarSet
trigger1 = !Ishelper || Ishelper(7777)
trigger1 = (var(34) > 60) || !NumprojID(901)
var(34) = 0
IgnoreHitPause = 1

[State OP光弾EX効果音用var35]
type = VarAdd
trigger1 = (!Ishelper || Ishelper(7777)) && NumprojID(905)
v = 35
value = 1
IgnoreHitPause = 1

[State OP光弾EX効果音用var35]
type = VarSet
trigger1 = !Ishelper || Ishelper(7777)
trigger1 = (var(35) > 60) || !NumprojID(905)
var(35) = 0
IgnoreHitPause = 1

[State OP光弾EX効果音用var36]
type = VarAdd
trigger1 = (!Ishelper || Ishelper(7777)) && NumprojID(906)
v = 36
value = 1
IgnoreHitPause = 1

[State OP光弾EX効果音用var36]
type = VarSet
trigger1 = !Ishelper || Ishelper(7777)
trigger1 = (var(36) > 60) || !NumprojID(906)
var(36) = 0
IgnoreHitPause = 1

[State OP光弾EX効果音用var37]
type = VarAdd
trigger1 = (!Ishelper || Ishelper(7777)) && NumprojID(907)
v = 37
value = 1
IgnoreHitPause = 1

[State OP光弾EX効果音用var37]
type = VarSet
trigger1 = !Ishelper || Ishelper(7777)
trigger1 = (var(37) > 60) || !NumprojID(907)
var(37) = 0
IgnoreHitPause = 1

[State 巻き起こす風エフェクト消し]
type = RemoveExplod
trigger1 = (var(0) < 0) && (Stateno != 900)
ID = 7902
IgnoreHitPause = 1

[State 巻き起こす風EXエフェクト消し]
type = RemoveExplod
trigger1 = (var(0) < 0) && (Stateno != 905)
ID = 7907
IgnoreHitPause = 1

;===============================================================================
;相方系
;===============================================================================
[State 相方用ステート奪われ時影無不可視]
type = AssertSpecial
triggerall = Ishelper(7777) && (Movetype = H) && (Stateno != [120,155])
trigger1 = (Stateno != [5000,5001]) && (Stateno != [5010,5011]) && (Stateno != 5020) && (Stateno != 5030) && (Stateno != 5035) && (Stateno != 5040)
trigger1 = (Stateno != 5050) && (Stateno != [5070,5071]) && (Stateno != [5080,5081]) && (Stateno != [5100,5101]) && (Stateno != 5110) && (Stateno != 5120)
trigger1 = (Stateno != 5150) && (Stateno != [5200,5201]) && (Stateno != 5210)
flag = NoShadow
flag2 = Invisible
IgnoreHitPause = 1

[State 相方用ステート奪われ時残像終了]
type = AfterImageTime
triggerall = Ishelper(7777) && (Movetype = H) && (Stateno != [120,155])
trigger1 = (Stateno != [5000,5001]) && (Stateno != [5010,5011]) && (Stateno != 5020) && (Stateno != 5030) && (Stateno != 5035) && (Stateno != 5040)
trigger1 = (Stateno != 5050) && (Stateno != [5070,5071]) && (Stateno != [5080,5081]) && (Stateno != [5100,5101]) && (Stateno != 5110) && (Stateno != 5120)
trigger1 = (Stateno != 5150) && (Stateno != [5200,5201]) && (Stateno != 5210)
time = 0
IgnoreHitPause = 1

[State 相方用ステート奪われ時代わりアニメ]
type = Explod
triggerall = Ishelper(7777) && (Movetype = H) && (Stateno != [120,155]) && !Numexplod(12031)
trigger1 = (Stateno != [5000,5001]) && (Stateno != [5010,5011]) && (Stateno != 5020) && (Stateno != 5030) && (Stateno != 5035) && (Stateno != 5040)
trigger1 = (Stateno != 5050) && (Stateno != [5070,5071]) && (Stateno != [5080,5081]) && (Stateno != [5100,5101]) && (Stateno != 5110) && (Stateno != 5120)
trigger1 = (Stateno != 5150) && (Stateno != [5200,5201]) && (Stateno != 5210)
anim = ifelse((Facing = 1),12031,11031)
ID = 12031
bindtime = -1
shadow = -1
scale = const(size.xscale),const(size.yscale)
IgnoreHitPause = 1

[State 相方用ステート奪われ時代わりアニメ終了]
type = RemoveExplod
trigger1 = (Helper(7777),stateno = [5000,5001]) || (Helper(7777),stateno = [5010,5011]) || (Helper(7777),stateno = 5020)
trigger2 = (Helper(7777),stateno = 5030) || (Helper(7777),stateno = 5035) || (Helper(7777),stateno = 5040) || (Helper(7777),stateno = 5050)
trigger3 = (Helper(7777),stateno = [5070,5071]) || (Helper(7777),stateno = [5080,5081]) || (Helper(7777),stateno = [5100,5101])
trigger4 = (Helper(7777),stateno = 5110) || (Helper(7777),stateno = 5120) || (Helper(7777),stateno = 5150) || (Helper(7777),stateno = [5200,5201])
trigger5 = (Helper(7777),stateno = 5210) || (Helper(7777),movetype != H) || (Helper(7777),stateno = [120,155])
ID = 12031
IgnoreHitPause = 1

[State 相方ライフバー]
type = Explod
trigger1 = Ishelper(7777) && (Roundstate = 2) && (Numenemy = 2) && !Numpartner && (Teamside = 1)
anim = 12301
pos = 140,15
postype = left
bindtime = -1
scale = ((Helper(7777),life)/7.85),0.5
sprpriority = -10
IgnoreHitPause = 1

[State 相方ライフバー]
type = Explod
trigger1 = Ishelper(7777) && (Roundstate = 2) && (Numenemy = 2) && !Numpartner && (Teamside = 1)
anim = 12302
pos = 140,15
postype = left
bindtime = -1
scale = (1000/7.85),0.5
sprpriority = -11
ownpal = 1
IgnoreHitPause = 1

[State 相方ライフバー]
type = Explod
trigger1 = Ishelper(7777) && (Roundstate = 2) && (Numenemy = 2) && !Numpartner && (Teamside = 2)
anim = 11301
pos = -142,15
postype = right
bindtime = -1
facing = -1
scale = ((Helper(7777),life)/7.85),0.5
sprpriority = -10
IgnoreHitPause = 1

[State 相方ライフバー]
type = Explod
trigger1 = Ishelper(7777) && (Roundstate = 2) && (Numenemy = 2) && !Numpartner && (Teamside = 2)
anim = 11302
pos = -142,15
postype = right
bindtime = -1
facing = -1
scale = (1000/7.85),0.5
sprpriority = -11
ownpal = 1
IgnoreHitPause = 1

;===============================================================================
;チェーン系
;===============================================================================
[State チェーン制限用var55]
type = Null
triggerall = !Ishelper || Ishelper(7777)
trigger1 = ((Stateno = 200) || (Stateno = 250) || (Stateno = 300) || (Stateno = 400) || (Stateno = 450)) && (Prevstateno = Stateno) && (Movecontact = 1)
trigger1 = var(55) := var(55)+1
trigger2 = (((Stateno = 200) && (Prevstateno = 300)) || ((Stateno = 300) && (Prevstateno = 200))) && (Movecontact = 1)
trigger2 = var(55) := var(55)+1
trigger3 = ((Stateno = [201,202]) || (Stateno = [251,252]) || (Stateno = [301,302]) || (Stateno = [401,402]) || (Stateno = [451,452])) && (Movecontact = 1)
trigger3 = var(55) := var(55)+1
trigger4 = ((Stateno = 600) || (Stateno = 605)) && (Movecontact = 1)
trigger4 = var(55) := var(55)+9
trigger5 = ((Stateno = 650) || (Stateno = 655)) && (Movecontact = 1)
trigger5 = var(55) := var(55)+ifelse((Animelemtime(12) >= 0),2,1)
trigger6 = ((Stateno = 750) || (Stateno = 755) || (Stateno = 756)) && (Movecontact = 1)
trigger6 = var(55) := var(55)+10
trigger7 = ((Stateno = 850) || (Stateno = 855)) && (Movecontact = 1)
trigger7 = var(55) := var(55)+7
trigger8 = var(0) >= 0
trigger8 = (Projcontacttime(900) = 0) || (Projcontacttime(901) = 0) || (Projcontacttime(905) = 0) || (Projcontacttime(906) = 0) || (Projcontacttime(907) = 0)
trigger8 = var(55) := var(55)+3
trigger9 = var(0) < 0
trigger9 = (Helper(7900),movecontact = 1) || (Helper(7905),movecontact = 1)
trigger9 = var(55) := var(55)+9
trigger10 = var(0) >= 0
trigger10 = ((Stateno = 950) || (Stateno = 955)) && (Movecontact = 1)
trigger10 = var(55) := ifelse((var(55) < 6),0,(var(55)-6))
trigger11 = var(0) < 0
trigger11 = ((Stateno = 950) || (Stateno = 955)) && (Movecontact = 1)
trigger11 = var(55) := ifelse((Pos y < 0),(var(55)+8),ifelse((var(55) < 6),0,(var(55)-6)))
trigger12 = ((Stateno = 1000) && (Movecontact = 1)) || ((Stateno = 1500) && (Helper(ifelse((var(0) < 0),1511,1501)),movecontact = 1))
trigger12 = var(55) := var(55)+15
trigger13 = (!Numtarget && !Numexplod(5000) && Ifelse(Numhelper(7777),((Numenemy = 2) || !(Helper(7777),numtarget)),1)) || (var(55) < 0)
trigger13 = var(55) := 0

[State 攻撃力用fvar38]
type = Null
triggerall = !Ishelper || Ishelper(7777)
trigger1 = (var(55)*0.075 >= 1) && (Stateno != 1000) && (Stateno != 1500)
trigger1 = fvar(38) := fvar(38)/(var(55)*0.075)
IgnoreHitPause = 1

[State バーストアタックダメージ]
type = LifeAdd
trigger1 = !Ishelper || Ishelper(7777)
trigger1 = (Movetype = H) && Gethitvar(damage) && (Prevstateno = 1000)
value = -gethitvar(damage)*fvar(39)*0.5
IgnoreHitPause = 1