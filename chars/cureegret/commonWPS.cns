trigger1 = Time = 0
value = S20,3
volume = -50

[State 115, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),110,111)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),110,111)+ifelse(Ishelper,7000,0)

[State 115, 回らない]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 115, コントロール]
type = CtrlSet
trigger1 = (Time > 6) || Inguarddist
value = 1

[State 115, ジャンプへ]
type = SelfState
trigger1 = (Time > 15) || (Pos y > -5)
value = 50
ctrl = 1

;========================================================================
;ガードスタート
[Statedef 120]
type = U
physics = U

[State 120, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),120,123)+ifelse(Ishelper,7000,0)+(Statetype = C)+(Statetype = A)*2

[State 120, 立ち判定]
type = StateTypeSet
trigger1 = (Time = 0) && (Statetype = S)
physics = S

[State 120, 屈み判定]
type = StateTypeSet
trigger1 = (Time = 0) && (Statetype = C)
physics = C

[State 120, 空中判定]
type = StateTypeSet
trigger1 = (Time = 0) && (Statetype = A)
physics = A

[State 120, 立ちから屈み判定]
type = StateTypeSet
trigger1 = !var(59) && (Statetype = S) && (command = "holddown")
statetype = C
physics = C

[State 120, 屈みから立ち判定]
type = StateTypeSet
trigger1 = !var(59) && (Statetype = C) && (command != "holddown")
statetype = S
physics = S

[State 120, ガード解除へ]
type = SelfState
trigger1 = (!var(59) && (command != "holdback")) || !Inguarddist
value = 140

[State 120, ガードへ]
type = SelfState
trigger1 = 1
value = 130+(Statetype = C)+(Statetype = A)*2

