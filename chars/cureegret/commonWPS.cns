;【コモンステート】
;
;0	立ち
;10	立ちから屈みへ
;11	屈み
;12	屈みから立ちへ
;20	歩く
;21	前進AI用
;22	後退AI用
;23	相方後ろへ回り込む・前進
;24	相方後ろへ回り込む・後退
;40	立ちからジャンプヘ
;45	空中ジャンプ
;50	ジャンプ
;52	着地
;100	ダッシュ
;101	ダッシュ終了
;105	後退ジャンプ
;110	空中前進
;115	空中後退
;120	ガードスタート
;130	立ちガード
;131	屈みガード
;132	空中ガード
;140	ガード解除
;150	立ちガード硬直
;151	立ちガード硬直解除
;152	屈みガード硬直
;153	屈みガード硬直解除
;154	空中ガード硬直
;155	空中ガード硬直解除
;
;5000~	やられ
;========================================================================
;========================================================================
;========================================================================
;立ち
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, イントロへ]
type = SelfState
trigger1 = Ishelper(7777) && (Root,stateno = [190,191])
value = 190

[State 0, 死へ]
type = SelfState
trigger1 = (Life <= 0) || (Alive = 0) || (Ishelper(7777) && (Life <= 1))
value = 5050
ctrl = 0

[State 0, 消滅]
type = DestroySelf
trigger1 = Ishelper && !Ishelper(7777)

[State 0, 残像終了]
type = AfterImageTime
trigger1 = Time = 0
time = 0

[State 0, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),0,1)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),0,1)+ifelse(Ishelper,7000,0)

[State 0, 画像優先度]
type = SprPriority
trigger1 = Ishelper(7777) && (Roundstate != 2)
value = -5

[State 0, 速度ｘ]
type = VelSet
trigger1 = (Abs(vel x) < 2) || (Time = 4)
x = 0

[State 0, 速度ｙ]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 0, コントロール]
type = CtrlSet
trigger1 = var(59)
value = ifelse((Time < (5-var(59))),0,1)

[State 0, 振り向き]
type = Turn
trigger1 = var(59) && !ctrl && (P2dist x < 0)
trigger2 = Ishelper(7777) && (P2dist x < 0)

;---------------------------------------------------------------------------
;立ちから屈みへ
[Statedef 10]
type = C
physics = C

[State 10, 立ちへ]
type = SelfState
trigger1 = var(59)
value = 0
ctrl = 1

[State 10, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),10,13)+ifelse(Ishelper,7000,0)

[State 10, 速度ｘ]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 効果音]
type = PlaySnd
trigger1 = Time = 0
value = S20,0

[State 10, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 10, 屈みへ]
type = SelfState
trigger1 = Animtime = 0
value = 11

;========================================================================
;屈み
[Statedef 11]
type = C
physics = C
sprpriority = 0

[State 11, 死へ]
type = SelfState
trigger1 = Life <= 0
value = 5050
ctrl = 0

[State 11, 残像終了]
type = AfterImageTime
trigger1 = Time = 0
time = 0

[State 11, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),11,14)+ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),11,14)+ifelse(Ishelper,7000,0)

[State 11, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 11, 屈みから立ちへ]
type = SelfState
trigger1 = var(59) || (Ishelper(7777) && (var(45) = 1) && (command != "holddown"))
value = 12

;---------------------------------------------------------------------------
;屈みから立ちへ
[Statedef 12]
type = S
physics = S

[State 12, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),12,15)+ifelse(Ishelper,7000,0)

[State 12, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 12, 立ちへ]
type = SelfState
trigger1 = Animtime = 0
value = 0
ctrl = 1

;========================================================================
;歩く
[Statedef 20]
type = S
physics = S
sprpriority = 0

[State 20, AI制御]
type = SelfState
trigger1 = (Time = 0) && var(59) && !var(50)
value = 21
ctrl = 1

[State 20, 速度ｘ]
type = VelSet
trigger1 = 1
x = ifelse((command = "holdfwd"),const(velocity.walk.fwd.x),const(velocity.walk.back.x))
y = 0

[State 20, アニメ]
type = ChangeAnim
trigger1 = (Vel x > 0) && (Anim != Ifelse((Facing = 1),20,23)+Ifelse(Ishelper,7000,0))
value = ifelse((Facing = 1),20,23)+ifelse(Ishelper,7000,0)

[State 20, アニメ]
type = ChangeAnim
trigger1 = (Vel x < 0) && (Anim != Ifelse((Facing = 1),21,22)+Ifelse(Ishelper,7000,0))
value = ifelse((Facing = 1),21,22)+ifelse(Ishelper,7000,0)

[State 20, 効果音]
type = PlaySnd
trigger1 = (Animelemtime(3) = 0) || (Animelemtime(6) = 0)
value = S20,0

[State 20, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

;---------------------------------------------------------------------------
;前進AI用
[Statedef 21]
type = S
physics = S
ctrl = 0
sprpriority = 0

[State 21, 振り向き]
type = Turn
trigger1 = (Time = 0) && (P2dist x < 0)

[State 21, アニメ]
type = ChangeAnim
trigger1 = (Vel x > 0) && (Anim != (ifelse((Facing = 1),20,23)+ifelse(Ishelper,7000,0)))
value = ifelse((Facing = 1),20,23)+ifelse(Ishelper,7000,0)

[State 21, 速度ｘ]
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x)

[State 21, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 21, 効果音]
type = PlaySnd
trigger1 = (Animelemtime(3) = 0) || (Animelemtime(6) = 0)
value = S20,0

[State 21, 立ちへ]
type = SelfState
trigger1 = Inguarddist || (P2movetype = A) || (Roundstate != 2) || (Frontedgebodydist <= 10) || ((Time >= 6) && (P2bodydist x = [-15,15]))
value = 0
ctrl = 1

;------------------------------------------------------------------------
;後退AI用
[Statedef 22]
type = S
physics = S
ctrl = 0
sprpriority = 0

[State 22, 振り向き]
type = Turn
trigger1 = (Time = 0) && (P2dist x < 0)

[State 22, アニメ]
type = ChangeAnim
trigger1 = (Vel x < 0) && (Anim != Ifelse((Facing = 1),21,22)+Ifelse(Ishelper,7000,0))
value = ifelse((Facing = 1),21,22)+ifelse(Ishelper,7000,0)

[State 22, 速度ｘ]
type = VelSet
trigger1 = 1
x = const(velocity.walk.back.x)

[State 22, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 22, 効果音]
type = PlaySnd
trigger1 = (Animelemtime(3) = 0) || (Animelemtime(6) = 0)
value = S20,0

[State 22, 立ちへ]
type = SelfState
trigger1 = Inguarddist || (P2movetype = A) || (Roundstate != 2) || (Backedgebodydist <= 10) || (P2bodydist x > 150) || ((Time >= 6) && (P2bodydist x <= 25))
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;相方後ろへ回り込む・前進
[Statedef 23]
type = S
physics = S
ctrl = 0
sprpriority = -1

[State 23, アニメ]
type = ChangeAnim
trigger1 = (Vel x > 0) && (Anim != (ifelse((Facing = 1),20,23)+ifelse(Ishelper,7000,0)))
value = ifelse((Facing = 1),20,23)+ifelse(Ishelper,7000,0)

[State 23, アニメ]
type = ChangeAnim
trigger1 = (Vel x < 0) && (Anim != Ifelse((Facing = 1),21,22)+Ifelse(Ishelper,7000,0))
value = ifelse((Facing = 1),21,22)+ifelse(Ishelper,7000,0)

[State 23, 速度ｘ]
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x)

[State 23, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 23, 効果音]
type = PlaySnd
trigger1 = (Animelemtime(3) = 0) || (Animelemtime(6) = 0)
value = S20,0

[State 23, 立ちへ]
type = SelfState
trigger1 = (Facing != Root,facing) && Ifelse((Root,facing = 1),(Pos x <= -30+(root,pos x)),(Pos x >= 30+(root,pos x)))
trigger2 = (Facing != Root,facing) && ((Frontedgedist <= 10) || (Backedgedist <= 10))
trigger3 = (Facing = Root,facing) && Ifelse((Root,facing = 1),(Pos x >= -30+(root,pos x)),((Pos x <= 30+(root,pos x))))
value = 0
ctrl = 1

;------------------------------------------------------------------------
;相方後ろへ回り込む・後退
[Statedef 24]
type = S
physics = S
ctrl = 0
sprpriority = -1

[State 24, アニメ]
type = ChangeAnim
trigger1 = (Vel x > 0) && (Anim != (ifelse((Facing = 1),20,23)+ifelse(Ishelper,7000,0)))
value = ifelse((Facing = 1),20,23)+ifelse(Ishelper,7000,0)

[State 24, アニメ]
type = ChangeAnim
trigger1 = (Vel x < 0) && (Anim != Ifelse((Facing = 1),21,22)+Ifelse(Ishelper,7000,0))
value = ifelse((Facing = 1),21,22)+ifelse(Ishelper,7000,0)

[State 24, 速度ｘ]
type = VelSet
trigger1 = 1
x = const(velocity.walk.back.x)

[State 24, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 24, 効果音]
type = PlaySnd
trigger1 = (Animelemtime(3) = 0) || (Animelemtime(6) = 0)
value = S20,0

[State 24, 立ちへ]
type = SelfState
trigger1 = Ifelse((Root,facing = 1),(Pos x <= -30+(root,pos x)),(Pos x >= 30+(root,pos x))) || (Backedgedist <= 10)
value = 0
ctrl = 1

;========================================================================
;立ちからジャンプヘ
[Statedef 40]
type = U
physics = S
ctrl = 0
sprpriority = 1

[State 40, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),40,30)+ifelse(Ishelper,7000,0)

[State 40, システムVar]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, システムVar]
type = VarSet
trigger1 = Ifelse(var(59),((Abs(p2bodydist x) <= 100) || (P2stateno = 40) || (P2stateno = 45)),(command = "holdfwd"))
sysvar(1) = 1

[State 40, システムVar]
type = VarSet
trigger1 = Ifelse(var(59),(Inguarddist || (P2movetype = A)),(command = "holdback"))
sysvar(1) = -1

[State 40, 速度ｘｙ]
type = VelSet
trigger1 = Animtime = 0
x = ifelse(sysvar(1),ifelse((sysvar(1) = 1),const(velocity.jump.fwd.x),const(velocity.jump.back.x)),const(velocity.jump.neu.x))
y = const(velocity.jump.y)

[State 40, 速度ｘｙダッシュ中]
type = VelSet
trigger1 = (Animtime = 0) && (Prevstateno = [100,101]) && (sysvar(1) = 1)
x = const(velocity.runjump.fwd.x)

[State 40, 効果音]
type = PlaySnd
trigger1 = Animtime = 0
value = S20,2

[State 40, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 40, ジャンプヘ]
type = SelfState
trigger1 = Animtime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;空中ジャンプ
[Statedef 45]
type = A
physics = N
ctrl = 0

[State 45, ジャンプ戻し]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0
persistent = 0

[State 45, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),40,30)+ifelse(Ishelper,7000,0)

[State 45, システムVar]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, システムVar]
type = VarSet
trigger1 = Ifelse(var(59),((Abs(p2bodydist x) <= 100) || (P2stateno = 40) || (P2stateno = 45)),(command = "holdfwd"))
sysvar(1) = 1

[State 45, システムVar]
type = VarSet
trigger1 = Ifelse(var(59),(Inguarddist || (P2movetype = A)),(command = "holdback"))
sysvar(1) = -1

[State 45, 速度ｘｙ]
type = VelSet
trigger1 = Animtime = 0
x = ifelse(sysvar(1),ifelse((sysvar(1) = 1),const(velocity.airjump.fwd.x),const(velocity.airjump.back.x)),const(velocity.airjump.neu.x))
y = const(velocity.airjump.y)

[State 45, 効果音]
type = PlaySnd
trigger1 = Animtime = 0
value = S20,2

[State 45, ジャンプヘ]
type = SelfState
trigger1 = Animtime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;ジャンプ
[Statedef 50]
type = A
physics = A

[State 50, システムVar]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),41,31)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),41,31)+ifelse(Ishelper,7000,0)

[State 50, 速度ｘ]
type = VelAdd
trigger1 = (Vel x < Const(velocity.jump.fwd.x)) && Ifelse(var(59),((P2bodydist x > 75)  || (P2dist x < 0)),(command = "holdfwd"))
x = 0.09*const(velocity.jump.fwd.x)

[State 50, 速度ｘ]
type = VelAdd
trigger1 = (Vel x < Const(velocity.jump.back.x)) && Ifelse(var(59),((P2bodydist x = [0,75]) || ((P2bodydist x >= 0) && Inguarddist)),(command = "holdback"))
x = 0.09*const(velocity.jump.back.x)

;---------------------------------------------------------------------------
;着地
[Statedef 52]
type = S
physics = S
ctrl = 0

[State 52, 効果音]
type = PlaySnd
trigger1 = Time = 0
value = S20,1

[State 52, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),47,37)+ifelse(Ishelper,7000,0)

[State 52, 速度ｙ]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 52, ジャンプヘ]
type = SelfState
triggerall = Roundstate = 2
trigger1 = !var(59) && (command = "holdup")
value = 40

[State 52, 立ちか後退ジャンプへ]
type = SelfState
trigger1 = Animtime = 0
value = ifelse((var(59) && (var(14) >= 15)),105,0)
ctrl = 1

;========================================================================
;ダッシュ
[Statedef 100]
type = S
physics = S
sprpriority = 1

[State 100, チェーンコンボ用var50]
type = VarSet
trigger1 = !var(59) && (Time = 0)
var(50) = 0
IgnoreHitPause = 1

[State 100, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),100,101)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),100,101)+ifelse(Ishelper,7000,0)

[State 100, 速度ｘ]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)
y = 0

[State 100, 効果音]
type = PlaySnd
trigger1 = (Animelemtime(3) = 0) || (Animelemtime(6) = 0)
value = S20,0

[State 100, 歩いてない回らない]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, 土埃]
type = MakeDust
trigger1 = Vel x > 0
pos = -10,0
spacing = 4

[State 100, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 100, ダッシュ終了へ]
type = SelfState
trigger1 = Ifelse(var(59),((Time > 6) && (P2bodydist x < 0)),(command != "holdfwd")) || (Roundstate != 2)
value = 101
ctrl = 0

;------------------------------------------------------------------------
;ダッシュ終了
[Statedef 101]
type = S
physics = S
ctrl = 0
sprpriority = 1

[State 101, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),100,101)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),100,101)+ifelse(Ishelper,7000,0)

[State 101, 速度ｘ]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)
y = 0

[State 101, 効果音]
type = PlaySnd
trigger1 = (Animelemtime(3) = 0) || (Animelemtime(6) = 0)
