trigger1 = Vel x > 0
pos = -10,0
spacing = 4

[State 101, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 101, ジャンプヘ]
type = SelfState
triggerall = Roundstate = 2
trigger1 = !var(59) && (command = "holdup")
value = 40

[State 101, 立ちへ]
type = SelfState
trigger1 = Time > 10
value = 0
ctrl = 1

;========================================================================
;空中前進
[Statedef 110]
type = A
physics = N
velset = 6,-1
ctrl = 0

[State 110, 効果音]
type = PlaySnd
trigger1 = Time = 0
value = S20,3
volume = -50

[State 110, アニメ]
type = ChangeAnim
