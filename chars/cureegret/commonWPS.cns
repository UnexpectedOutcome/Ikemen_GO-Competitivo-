value = 140

;---------------------------------------------------------------------------
;空中ガード
[Statedef 132]
type = A
physics = N

[State 132, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),132,135)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),132,135)+ifelse(Ishelper,7000,0)

[State 132, 速度ｙ]
