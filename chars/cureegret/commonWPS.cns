physics = C

[State 131, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),131,134)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),131,134)+ifelse(Ishelper,7000,0)

