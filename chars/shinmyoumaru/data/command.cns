[state ];jump
type=changestate
trigger1=(var(2)<=1)*(stateno=50)*(prevstateno!=11)*(time>=5)*(command="holdup")*((command="y")+(command="holdy"))
value=45
[state ]
type=changestate
triggerall=(statetype=s)*(ctrl)
trigger1=(command="FF")+(command="FB")+((command="holdfwd")*((command="y")+(command="holdy")))+(command="BB")+(command="BF")+((command="holdback")*((command="y")+(command="holdy")))
value=100*((command="FF")+(command="FB")+((command="holdfwd")*((command="y")+(command="holdy"))))+105*((command="BB")+(command="BF")+((command="holdback")*((command="y")+(command="holdy"))))
[state ]
