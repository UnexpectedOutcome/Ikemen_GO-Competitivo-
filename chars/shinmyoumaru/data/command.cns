name="FB"
command=F,B,F,B
time=15
buffer.time=10
[command]
name="BF"
command=B,F,B,F
time=15
buffer.time=10
[command]
name="FF"
command=F,F
time=15
buffer.time=10
[command]
name="BB"
command=B,B
time=15
buffer.time=10
[command]
name="recovery"
command=x+y
[command]
name="a"
command=a
[command]
name="b"
command=b
[command]
name="c"
