[state ];jump
type=changestate
triggerall=(statetype=s)*((ctrl)+((stateno=100)*(time>=5)))
trigger1=(command="holddown")+(command="holdup")
value=10*(command="holddown")+40*(command="holdup")
[state ];jump
type=changestate
triggerall=(pos y=0)
triggerall=(command="holddown")+(command="holdup")
trigger1=(stateno=210)*(time>=31)
trigger2=(stateno=221)*(time>=33)
trigger3=(stateno=212)*(time>=45)
value=10*(command="holddown")+40*(command="holdup")
[state ];jump
type=changestate
trigger1=(var(2)<=1)*(stateno=50)*(prevstateno!=11)*(time>=5)*(command="holddown")*((command="y")+(command="holdy"))
