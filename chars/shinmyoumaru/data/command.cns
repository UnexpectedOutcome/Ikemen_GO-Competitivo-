;---------
[command]
name="holdfwd"
command=/$F
[command]
name="holdback"
command=/$B
[command]
name="holdup"
command=/$U
[command]
name="holddown"
command=/$D
;-------------------
[statedef -1]
;---------
[state ];AAA2A,2A,AAA8A,8A
type=changestate
triggerall=(command="a")
trigger1=(stateno=10)*(command="holddown")
trigger2=(stateno=40)*(command="holdup")
trigger3=(var(1)=3)*(stateno=201)*(movecontact)*((command="holddown")+(command="holdup"))
value=206*(command="holddown")+204*(command="holdup")
[state ];A,AA,4A
type=changestate
triggerall=(var(1)=[0,1])*(statetype=s)*(command="a")
trigger1=(p2dist x<=75)*(ctrl)*(command!="holdfwd")
trigger2=((p2dist x>75)*(ctrl)+(stateno=101))*(command="holdback")
trigger3=(stateno=200)*(movecontact)
value=200
[state ];AAA,‰“A,DA
type=changestate
triggerall=(command="a")
trigger1=(ctrl)*(command!="holdfwd")*(command!="holdback")
trigger2=(stateno= 11)*(time>4)
trigger3=(stateno= 50)*(time>4)
trigger4=(stateno=100)*(time>4)
trigger5=(stateno=101)
trigger6=(stateno=110)*(time>9)
trigger7=(stateno=111)
trigger8=(var(1)=2)*(stateno=200)*(movecontact)
value=201
[state ];AAAA,6A
type=changestate
triggerall=(command="a")
trigger1=(ctrl)*(command="holdfwd")
trigger2=(var(1)=3)*(stateno=201)*(movecontact)*(command!="holdup")*(command!="holddown")
value=202
[state ];AAAAA
type=changestate
triggerall=(var(10)>0)*(statetype=s)
trigger1=(stateno=10)*(command="holddown")*(command="c")
trigger2=(var(1)=4)*(stateno=202)*(movecontact)*(command!="holdup")*(command!="holddown")*(command="a")
trigger3=(stateno=202)*(movehit)*(command="holddown")*(command="c")
value=215
[state ];B
type=changestate
triggerall=(var(10)>0)*(pos y=0)*(command="b")
trigger1=((ctrl)+(stateno=101))*(command!="holdfwd")*(command!="holdup")*(command!="holddown")
trigger2=(stateno=100)*(command!="holdfwd")*(command!="holdup")*(command!="holddown")
value=210
[state ];6B
type=changestate
triggerall=(var(10)>0)*(command="b")*(command="holdfwd")
trigger1=(ctrl)
trigger2=(stateno= 11)*(time>4)
trigger3=(stateno= 50)*(time>4)
trigger4=(stateno=201)*(movecontact)
trigger5=(stateno=202)*(movecontact)
value=212
[state ];C
type=changestate
triggerall=(var(10)>0)*(var(11)<4)*(command="c")
trigger1=ctrl
trigger2=(stateno=230)
trigger2=time=[22,36]
value=230
[state ];éŒ¾
type=changestate
triggerall=(var(6)>=0)*(var(7)=var(8))*(pos y=0)*(command="x")*(command!="y")
trigger1=(ctrl)
trigger2=(hitdefattr=sca,na)*(movehit)
value=990*(var(6)=0)+2200*(var(6)=1)
