trigger12 = stateno = 1048 || stateno = 1050 || stateno = 1051
trigger13 = stateno = 1052 || stateno = 1054 || stateno = 1055
trigger14 = stateno = 1056 || stateno = 1057 || stateno = 460
trigger15 = stateno = 462 || stateno = 1063 || stateno = 1065
trigger16 = stateno = 1066 || stateno = 1067 || stateno = 1068
