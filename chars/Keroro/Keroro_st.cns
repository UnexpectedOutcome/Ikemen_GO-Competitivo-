; RUN_BACK
[Statedef 105]
type    = S
physics = S
anim = 105
sprpriority = 1

[State 0]
type = PlayerPush
trigger1 = 1
value = 0

[State 100, 1]
type = VelSet
trigger1 = 1
x = -const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn


[State 0]
type = MakeDust
trigger1 = vel X > 0
pos = 0, 0
pos2 = -20, 0
spacing = 8

[State 100, 4]
type = ChangeState
trigger1 = command != "holdback"
value = 102
