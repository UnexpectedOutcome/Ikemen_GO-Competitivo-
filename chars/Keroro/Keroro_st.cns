;=====================================================
[state -2];CP初期設定
type = varset
trigger1 = roundstate = 1
trigger1 = roundno = 1
var(15) = 10

[state -2];上限設定
type = varset
trigger1 = var(15) > 10
var(15) = 10

[state -2];下限設定
type = varset
trigger1 = var(15) < 0
var(15) = 0

[state -2];CP未満で回復
type = varadd
trigger1 = movetype != A
trigger1 = time > 5
trigger1 = (GameTime%50)=0
trigger1 = var(15) < 10
var(15) = 10

;----------------------------

[state -2];ACP初期設定
type = varset
trigger1 = roundstate = 1
trigger1 = roundno = 1
var(16) = 10

[state -2];上限設定
type = varset
trigger1 = var(16) > 10
var(16) = 10

[state -2];下限設定
type = varset
trigger1 = var(16) < 0
var(16) = 0

[state -2];CP未満で回復
type = varadd
trigger1 = movetype != A
trigger1 = time > 5
trigger1 = (GameTime%50)=0
trigger1 = var(16) < 10
var(16) = 10

;-----------------------------------------------------
;CP消費
;-----------------------------------------------------
[state -2];消費
type = varadd
triggerall = animelemtime(2) = 0
trigger1 = stateno = 300 || stateno = 310 || stateno = 320
trigger2 = stateno = 340 || stateno = 345 || stateno = 350
trigger3 = stateno = 360 || stateno = 370 || stateno = 320
trigger4 = stateno = 410 || stateno = 420 || stateno = 423
trigger5 = stateno = 440 || stateno = 450 || stateno = 330
trigger6 = stateno = 354 || stateno = 390 || stateno = 430
trigger7 = stateno = 460
var(15) = -6

[state -2];奥義以上消費
type = varadd
triggerall = animelemtime(2) = 0
trigger1 = stateno = 1000 || stateno = 1700 || stateno = 2000
trigger2 = stateno = 1007 || stateno = 1010 || stateno = 1014
trigger3 = stateno = 1016 || stateno = 1024 || stateno = 1029
trigger4 = stateno = 1034 || stateno = 1038 || stateno = 1048
trigger5 = stateno = 1049 || stateno = 1054 || stateno = 1063
trigger6 = stateno = 1058
var(15) = -8

[state -2];空中消費
type = varadd
triggerall = animelemtime(2) = 0
trigger1 = stateno = 314
var(16) = -8

;-----------------------------------------------------
[State -2, 8];乱数発生0~24
type = VarRandom
trigger1 = Time = 1
v = 7
range = 0,24

[State -2, ヒットカウント保存]
type = VarSet
trigger1 = Var(8) != HitCount
var(8) = HitCount
ignorehitpause = 1

;ダメージボイス
[State -2 ,2]
Type = PlaySnd
triggerall = alive = 1
TriggerAll = (Time = 0) && (Random < 500) && (Anim = [5000,5090])
Trigger1 = (StateNo = [5000,5002]) || (StateNo = [5010,5012]) || (StateNo = [5020,5022])
Trigger2 = StateNo = 5030 || StateNo = 5070 || StateNo = 5080 || StateNo = 5090
value = s2,random&7
volume = 256
channel = 0

;コンボ補正
[State -2, damage];attackmulに実際に入れる値の式、剛招来適用
type = VarSet
triggerall = var(0) >1
trigger1 = roundstate = 2
trigger1 = enemy,GethitVar(hitcount) >= 2
fv = 10
value = 1.0 - (enemy,GethitVar(hitcount) * 0.0075)

[State -2, damage];attackmulに実際に入れる値の式
type = VarSet
triggerall = var(0) = 0
trigger1 = roundstate = 2
trigger1 = enemy,GethitVar(hitcount) >= 2
fv = 10
value = 1.0 - (enemy,GethitVar(hitcount) * 0.035)

[State -2, damage_reset];攻撃が途切れたら値をリセット
type = VarSet
trigger1 = p2movetype != H
trigger2 = enemy,GethitVar(hitcount) = 0
fv = 10
value = 1.0

[State -2, damage];最小値。0にするとｺﾝﾎﾞ入れまくると全く減らなくなる
type = VarSet
trigger1 = fVar(10) < 0
fv = 10
value = 0.01

[State -2, damage]
type = AttackMulSet
triggerall = roundstate = 2
trigger1 = stateno != 1710
trigger1 = stateno != 1715
trigger1 = stateno != 1720
trigger1 = stateno != [1600,1670]
value = fVar(10)

;=====================================================
;---------------------------------------------------------------------------
;特殊ロールダッシュ＆バックダッシュ
;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 0]
type = PlayerPush
trigger1 = 1
value = 0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn




[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 101
