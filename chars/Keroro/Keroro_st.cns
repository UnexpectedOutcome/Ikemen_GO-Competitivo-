trigger1 = stateno = 440
trigger2 = stateno = 300 || stateno = 310 || stateno = 320
trigger3 = stateno = 340 || stateno = 345 || stateno = 350
trigger4 = stateno = 360 || stateno = 370 || stateno = 320
trigger5 = stateno = 410 || stateno = 420 || stateno = 423
