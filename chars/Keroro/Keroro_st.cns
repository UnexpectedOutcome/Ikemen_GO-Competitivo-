;---------------------------------------------------------------------------
;=====================================================
[Statedef -2];コンフィグ
;=====================================================
;どうでもよさそうな設定ができます。
;=====================================================
;カットイン変更
[State -2 , c]; 
type = varset 
trigger1 = 1 
var(3) = 2          ;0:NDXver　1:PXver　2:ランダム　それ以外:カットイン無し
;　　　　　　　　　　 好きな方でお楽しみください 


;設定ここまで。
;=====================================================
;剛招来攻撃力上昇時間

[State -2 , v];上昇時間設定 
type = varset 
trigger1 = stateno = 400 && time = 9 
var(0) = 600
ignorehitpause=1 

[State -2 , v];時間経過 
type = varadd 
trigger1 = var(0) >=1 
var(0) = -1 
ignorehitpause=1 

[State 400 , a];上昇値 
type = attackmulset 
trigger1 = var(0) >= 1 
value = 1.25 
ignorehitpause=1 

[State -2 , a];もとに戻ろう 
type = attackmulset 
trigger1 = var(0) <=0 
value = 1.0 
ignorehitpause=1

[State 1000, 5];オーラ
type = explod
trigger1 = var(0) != 0
trigger1 = time%18 = 0
anim = 2500
id = 2500
pos = 0,-20
scale = .25,.5
random = 40,60
postype = p1
sprpriority = 3
vel = 0,0
bindtime = 1
removeongethit = 1
supermovetime = 99999
pausemovetime = 99999
ownpal = 1


[State 1600, h]
type = Helper
triggerall = stateno = [1755,1760]
trigger1 = time >= 80
trigger1 = time <= 136
trigger1 = time %13 = 8
name = "kokuu"
stateno = 10099
ID = 10099
ownpal = 1
keyctrl = 0
pos  = 80,0

[State 1600, h2]
type = Helper
triggerall = stateno = [1755,1760]
trigger1 = time >= 80
trigger1 = time <= 136
trigger1 = time %13 = 8
name = "hikari"
stateno = 10100
ID = 10100
ownpal = 1
keyctrl = 0
pos  = -80,0
facing = -1


