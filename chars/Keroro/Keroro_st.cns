triggerall = MoveHit
trigger1 = stateno = 350 || stateno = 351
trigger2 = stateno = 352 || stateno = 353 || stateno = 354
trigger3 = stateno = 1029 || stateno = 1030 || stateno = 1031
trigger4 = stateno = 1032 || stateno = 1033 || stateno = 1034
trigger5 = stateno = 1035 || stateno = 1036 || stateno = 1037
var(1) = 1

;緋凰絶炎衝スイッチOFF
[State -2 , h]
