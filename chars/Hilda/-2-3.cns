;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]

;Asymetrical Palette Swapping

[State -2]
type = remappal
trigger1 = var(51)!=1
trigger1 = facing = 1
Source = 1,1
dest = 1+0*(var(51):=1),palno
ignorehitpause = 1
persistent = 0

[State -2]
type = remappal
trigger1 = var(51)!=2
trigger1 = facing != 1
Source = 1,1
dest = 2+0*(var(51):=2),palno
ignorehitpause = 1
persistent = 0

[State 1300]
type = helper
trigger1 = !numhelper(6010)
helpertype = normal
stateno = 6010
ID = 6010
name = "chair"
postype = p1
pos = 0,0
ownpal = 1
pausemovetime = 99999
Supermovetime = 99999

