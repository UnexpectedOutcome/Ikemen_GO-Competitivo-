trigger1 = Time = 0
value = 3321

;左右反転でも対応出来るように0,0からのposaddで指定
[State 0, Posadd]
type = Posadd
trigger1 = time=0
x = 72;6F速度12で進む距離
y = 48;良い感じの高さ
ignorehitpause = 0
persistent = 1


;最初の一枚でヒットストップを再現する（6F）
;-----------【ヒットストップ再現】-----------
[State 0, VelSet]
type = VelSet
trigger1 = animelemtime(1)>=0 && animelemtime(2)<0
trigger2 = animelemtime(5)>=0 && animelemtime(6)<0
trigger3 = animelemtime(9)>=0 && animelemtime(10)<0
trigger4 = animelemtime(13)>=0 && animelemtime(14)<6
x = ifelse(time%2!=0,-2,2);ぷるぷるする
y = 0;
ignoreHitPause = 0 
persistent= 1


;左右ふっとびを交互に繰り返す。重力は0.8とする
;timeから減算する値はヒットストップの分
;-----------【右吹っ飛び1】-----------
[State 0, VelSet]
type = VelSet
trigger1 = animelemtime(2)>=0 && animelemtime(5)<0
x = -8.0
y = -8.0+0.6*((time-6)%18);timeを12で割った余りだけ減速する。0~11
ignoreHitPause = 0 
persistent= 1;毎フレーム更新

;-----------【左吹っ飛び1】-----------
[State 0, VelSet]
type = VelSet
trigger1 = animelemtime(6)>=0 && animelemtime(9)<0
x = 8.0
y = -8.0+0.6*((time-12)%18);timeを12で割った余りだけ減速する。0~11
ignoreHitPause = 0
persistent= 1;毎フレーム更新

;左右ふっとびを交互に繰り返す。
;-----------【右吹っ飛び2】-----------
[State 0, VelSet]
type = VelSet
trigger1 = animelemtime(10)>=0 && animelemtime(13)<0
x = -8.0
y = -8.0+0.6*((time-18)%18);timeを12で割った余りだけ減速する。0~11
ignoreHitPause = 0 
persistent= 1;毎フレーム更新

;-----------【左吹っ飛び2】-----------
[State 0, VelSet]
type = VelSet
trigger1 = animelemtime(14)>=0 && animelemtime(16)<4
x = 8.0
y = -12.0+0.6*((time-6)%18);timeを12で割った余りだけ減速する。0~11
ignoreHitPause = 0
persistent= 1;毎フレーム更新



