;---------------------------------------------------------------------------
;空振り戻り(硬直中の無敵切りのため)
;3004以降がうまくいかなかったらこっちに戻せ。3001からの飛ばし先を変えるだけでよい
[Statedef 3003]
type    = S
movetype= I
physics = S
ctrl = 0
anim = 3003
sprpriority = 2


[State 3001, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;初撃外したときの隙
;基本的な流れは3002といっしょ。入る条件と出て行く先が違う。あと無敵はない
;攻撃力半減（実装）、空ガ不とダウン効果切る（まだ）
;入る条件:アッパーの攻撃判定が消えたとき
;出て行く先:落下やられ、着地までコントロール無効
[Statedef 3004]
type    = S
movetype= A
physics = S
anim = 3001
ctrl = 0
velset = 0, 0
sprpriority = 2


[State 3004, PlayerPush]
type = PlayerPush
trigger1	= 1
value = 0
persistent = 1



