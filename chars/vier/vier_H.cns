;---------------------------------------------------------------------------
;初撃後の隙続き
;落下ステート5050とほぼ同じ。リカバリーはきかずただ堕ちていく
[Statedef 3005]
type    = A
movetype= A
physics = N

[State 3005, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 3005, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 3005, 3] ;Gravityただし通常時の2/3の速度
type = VelAdd
trigger1 = 1
y = 0.16

[State 3005, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5100 ;HIT_BOUNCE

;落下中は攻撃範囲が存在しない攻撃状態とし、カウンターヒットのリスクを負え
[State 3103, 攻撃範囲]
Type     = AttackDist
Trigger1 =  1
value    = 0

[State 0,ハイジャンプスイッチオフ]
type = varset
trigger1 = 1
var(11) = 0
ignorehitpause=1

