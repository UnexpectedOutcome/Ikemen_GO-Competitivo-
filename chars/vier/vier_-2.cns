;===========================================================================
; 常時監視ステート（‐２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

;超必殺技が増えたら散華以外の残像処理を確認せよ


;やられ系ボイスと常時監視が必要なシステム系
[Statedef -2]

;***********************************<<音声切り替えスイッチ>>*****************************************************

;水龍飛翔拳ボイス切り替え
;0：ランダム、1：負けるものかああああ固定、2：ドラゴンアッパー固定、3：水龍飛翔拳固定
[State -2]
type=Varset
trigger1=1
var(54)=0
ignorehitpause=1

;天馬流転ボイス切り替え
;0：ランダム、1：いくぞそこだあああ固定、2：ペガサスゲイザー固定、3：天馬流転固定
[State -2]
type=Varset
trigger1=1
var(55)=0
ignorehitpause=1

;神天墜ボイス切り替え
;0：ランダム、1：くだけちれ固定、2：タイタンハイロウ固定、3：神天墜固定
[State -2]
type=Varset
trigger1=1
var(56)=0
ignorehitpause=1

;アルティメットフォースボイス切り替え
;0：ランダム、1：さあかかって来なよ固定、2：全ての力いまここに固定、3：さあ刮目せよ固定
[State -2]
type=Varset
trigger1=1
var(57)=0
ignorehitpause=1


;***********************************<<音声切り替えスイッチ終わり>>*****************************************************

;先行入力認識用ヘルパー暴走防止
[state -2, ステートリセット]
type = changestate
trigger1 = ishelper(99999)
value = 99999
ignorehitpause = 1


[state -2, ステートリセット]
type = changestate
trigger1 = ishelper(99998)
value = 99999
ignorehitpause = 1



;ダメージ乗算補正が万が一マイナスになったら0にするよ
[State -2]
type=Varset
trigger1=fvar(1)<0.2
fvar(1)=0.2
ignorehitpause=1


;やられじゃなくなったらかガード中は補正を1に戻すよ
[State -2]
type=Varset
TriggerAll = NumEnemy > 0;敵がいるとき
trigger1=enemy,movetype!=H
trigger2=enemy,stateno=[120,155]
fvar(1)=1.0
ignorehitpause=1

;ノックバック補正
;[State -2]
;type=Varset
;TriggerAll = StateNo = [200,2999];超必以外の時にカウントするよ
;Trigger1 = MoveHit = 1 
;fv=2
;Value = ifelse(var(3)=1,(Enemy,GetHitVar(HitCount)*0.12),(Enemy,GetHitVar(HitCount)*0.2));相手のHit*0.2の補正をかけるよ
;IgnoreHitPause = 1 
;persistent= 0



;ノックバック補正キャンセル
[State -2]
type=Varset
TriggerAll = NumEnemy > 0;敵がいるとき
trigger1=enemy,movetype!=H
trigger2=enemy,stateno=[120,155]
;Trigger1 = FVar(2) != 0
;Trigger1 = (enemynear(0),MoveType != H || (enemynear(0),StateNo != [120,155])) ;一番近い相手がやられじゃなくなったら
fvar(2)=0
IgnoreHitPause = 1
;persistent= 1

[State -2,空中ダッシュ回数リセット]
type = Varset
trigger1 = StateType != A
var(8) = 0 

;---------------------------------------------------------------------------

;魔種アイコン関連


[State -2, 魔種 開始時 苗状態]
type = VarSet
trigger1 = roundsexisted = 0
;trigger1 = RoundNo = 1
trigger1 = RoundState = 0
var(58)=2;無=0,種=1,芽=2,花=3
ignorehitpause = 1
persistent = 0

[State -2, 散華じゃない時チェックタイマー0]
type = VarSet
trigger1=var(3)=0;最初の1Fのみ実行
var(2)=0
ignorehitpause = 1
persistent = 0

;ラウンド終了時散華を消す。var(2)=1で退化フラグが立つ。散華タイマーが出ているときはvar(2)>1なので1を入れてチェック
[State -2, ラウンド終了時散華ならチェックタイマー1で散華を切る]
type = VarSet
trigger1 = Roundstate = 3
trigger1=numhelper(7550) >= 1
trigger1=var(2)>0;最初の1Fのみ実行
var(2)=1
ignorehitpause = 1
persistent = 0


;発芽まではラウンド終了で成長する
[State -2, ラウンド終了後成長処理]
type = VarAdd
trigger1 = var(58) <= 1
trigger1 = RoundState = 4
trigger1=time=1;最初の1Fのみ実行
v =58
value = 1
ignorehitpause = 1
persistent = 0

;ラウンド終了時開花ならば退化する
[State -2, ラウンド終了後退化処理]
type = VarAdd
trigger1 = var(58) = 3
trigger1 = RoundState = 4
trigger1=time=1;最初の1Fのみ実行
v =58
value = -1
ignorehitpause = 1
persistent = 0

[State -2, 散華中は他の残像フラグは切っておくこと（保険）]
type = varset
trigger1 = var(3)=1
var(17) =0
ignorehitpause=1

;超必殺技が増えたら必ず確認せよ
[State -2, ハイジャンプ移行とハイジャンプ・超必殺技攻撃中のどれでもなければその他残像フラグは切れ]
type = varset
trigger1 = stateno != [45,50];ハイジャンプ
trigger1 = stateno != [3000,3001];ドラゴン攻撃中。下降や戻りは切ってよい
trigger1 = stateno != 3100;ペガサス間欠泉が出るまで
trigger1 = stateno != 3200;タイタンハイロウ
trigger1 = stateno != 3300;アルティメット
trigger1 = stateno != 3301;アルティメット
trigger1 = stateno != 3302;アルティメット
;trigger1 = Helper(11000),stateno != 11000;アルティメット
;trigger1 = Helper(11001),stateno != 11001;アルティメット
var(17) =0
ignorehitpause=1

;var(2)に残り時間がセットされたタイミング(stateno=7500のtime=12+1で残像起動)
;state処理は-3→-2→-1→通常番号らしい
;var(2)に残り時間がセットされたあと最速で残像をつけたいならばセットされた次のtimeで残像処理を入れればよい。
[State -2, 散華中 残像]
type = AfterImage
;散華スイッチがオンになったら一度だけセット
trigger1 = var(3)=1
trigger1 = stateno=7500&&time = 13
time = 4
length = 24
palcolor = 256
palinvertall = 0
palbright = 32,32,32
palcontrast = 128,128,192
palpostbright = 12,12,12
paladd = 12,12,24
palmul = 0.64,0.64,0.80
timegap = 1
framegap = 2
trans = add

;散華スイッチがついている間は残像表示の残り時間を更新し続けろ
[State -2, 散華中残像時間更新]
type = AfterImageTime
Trigger1 = var(3) = 1
time = 2

;アルティメットフォース用残像。基本的に色などは散華と同じ。ヘルパーにはヘルパー側のステートで残像作ってる
[State -2, アルティメットフォース中 残像]
type = AfterImage
triggerall = time=1;cnsの処理順序的にstate-2からそれぞれのstateでvar(17)=1を認識できるのはtime=1から
trigger1 = stateno = 3300;アルティメット構え
trigger2 = stateno = 3301;アルティメット投げ
trigger3 = stateno = 3302;パンチ
time = 4
length = 24
palcolor = 256
palinvertall = 0
palbright = 32,32,32
palcontrast = 128,128,192
palpostbright = 12,12,12
paladd = 12,12,24
palmul = 0.64,0.64,0.80
timegap = 1
framegap = 2
trans = add

;指定したステートにいる間は残り時間の更新をする
[State -2, アルティメットフォース中残像時間更新]
type = AfterImageTime
trigger1 = stateno = 3300;アルティメット構え
trigger2 = stateno = 3301;アルティメット投げ
trigger3 = stateno = 3302;パンチ
time = 2

;散華中は出しちゃダメ
;超必殺技が増えたらチェックせよ
[State -2, 散華以外の残像]
type = afterimage
triggerall = var(3)=0;非散華時
triggerall = var(17)=1;残像フラグがオンだったら
triggerall = time=1;cnsの処理順序的にstate-2からそれぞれのstateでvar(17)=1を認識できるのはtime=1から
trigger1 = stateno=[45,47]
trigger2 = stateno=3000;上昇まで滑らかに残像がつながってほしいのでドラゴンの残像起動タイミングはショートアッパー
trigger3 = stateno=3100;ペガサス間欠泉が出るまで
trigger4 = stateno=3200;タイタンハイロウ
trigger5 = stateno=3300;アルティメット
time = 4
timegap = 1
framegap = ifelse((stateno=[45,47]),4,2);ハイジャンプ中は2だとくどいので4になれ
length = 24
palcolor = 256
palinvertall = 0
palbright	= 24,24,24
palcontrast = 48,48,192
palpostbright = 12,12,12
paladd = 8,8,12
palmul = 0.64,0.64,0.80
trans = add1

;非散華中かつ残像が必要な行動の場合は残り時間を更新し続けろ
[State -2, 散華以外の残像時間更新]
type = AfterImageTime
Trigger1 =  var(3)=0;非散華時
trigger1 = var(17)=1;残像フラグがオンだったら
time = 2

;hitdefのdamageにかかる補正
[State -2, 散華の時は攻撃アップ]
type = varset
trigger1 = var(3)=1
fvar(3)=1.2
ignorehitpause=1

[State -2, 散華じゃなく種以上があるときは攻撃普通]
type = varset
trigger1 = var(3)=0
trigger1 = var(58)>=1
fvar(3)=1.0
ignorehitpause=1


[state -2, 花の時は体力自動回復]
type = LifeAdd
triggerall = RoundState = 2
Triggerall = movetype != H
;花の時は20Fにつき1回復する、花かつ散華のときは10Fに1回復する
trigger1 = Var(58) = 3
trigger1 = ifelse(var(3)=1,gametime%10,gametime%20) = 0
;発芽かつ散華のときは20Fに1回復する
trigger2 = Var(58) = 2 && var(3)=1
trigger2 = gametime%10 = 0
value = 1
ignorehitpause = 1

[State -2, 苗以上はの時は防御普通]
type =  DefenceMulSet
trigger1 = var(58) >=2
value = 1

[State -2, 種の時は防御ダウン]
type =  DefenceMulSet
trigger1 = var(58) =1
value = 1.1


[State -2, 無の時はさらに防御ダウン]
type =  DefenceMulSet
trigger1 = var(58) =0
value = 1.2


[State -2, 無の時はさらに加えて攻撃ダウン]
type = varset
trigger1 = var(58)=0
fvar(3)=0.9
ignorehitpause=1


;万が一var(58)がマイナスになったら0にするよ
[State -2]
type=Varset
trigger1=var(58)<=0
var(58)=0
ignorehitpause=1
persistent = 0

;万が一var(58)が4になったら3にするよ
[State -2]
type=Varset
trigger1=var(58)>=3
var(58)=3
ignorehitpause=1
persistent = 0

[State -2, 種表示]
type = Explod
triggerALL =  NumExplod(8000) = 0
trigger1 = var(58) = 1
anim = 8000
ID = 8000
pos = ifelse(TeamSide=1,18,300), 50;1P側か2P側かで条件分岐
postype = left  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
vel = 0,0
accel = 0,0
random = 0,0
removetime = -1;永久表示
scale = 0.5,0.5
sprpriority = 5
ontop = 1;すべてのスプライトより手前に
shadow = 0,0,0
ownpal = 0
removeongethit = 0
ignorehitpause =1
trans = default ;default,none,add,add2,sub,addalpha
persistent =0
supermovetime = 999999
pausemovetime = 999999 ;supermove pausetimeを無視する時間

[State -2, 種 消去]
type = RemoveExplod
triggerall = NumExplod(8000) = 1
trigger1 = Var(58) != 1
ID = 8000

[State -2, 苗表示]
type = Explod
triggerALL =  NumExplod(8001) = 0
trigger1 = var(58) = 2
anim = 8001
ID = 8001
pos = ifelse(TeamSide=1,18,300), 50;1P側か2P側かで条件分岐
postype = left  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
vel = 0,0
accel = 0,0
random = 0,0
removetime = -1;永久表示
scale = 0.5,0.5
sprpriority = 5
ontop = 1;すべてのスプライトより手前に
shadow = 0,0,0
ownpal = 0
removeongethit = 0
ignorehitpause =1
trans = default ;default,none,add,add2,sub,addalpha
persistent =0
supermovetime = 999999
pausemovetime = 999999 ;supermove pausetimeを無視する時間

[State -2, 苗 消去]
type = RemoveExplod
triggerall = NumExplod(8001) = 1
trigger1 = Var(58) != 2
ID = 8001

[State -2, 花表示]
type = Explod
triggerALL =  NumExplod(8002) = 0
trigger1 = var(58) = 3
anim = 8002
ID = 8002
pos = ifelse(TeamSide=1,18,300), 50;1P側か2P側かで条件分岐
postype = left  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
vel = 0,0
accel = 0,0
random = 0,0
removetime = -1;永久表示
scale = 0.5,0.5
sprpriority = 5
ontop = 1;すべてのスプライトより手前に
shadow = 0,0,0
ownpal = 0
removeongethit = 0
ignorehitpause =1
trans = default ;default,none,add,add2,sub,addalpha
persistent =0
supermovetime = 999999
pausemovetime = 999999 ;supermove pausetimeを無視する時間

[State -2, 花 消去]
type = RemoveExplod
triggerall = NumExplod(8002) = 1
trigger1 = Var(58) != 3
ID = 8002

;ゲージの表示
[State -2]
type = Explod
triggerALL =  NumExplod(8006) = 0
trigger1 = var(3) = 1;散華カウントヘルパーがいれば表示
anim = 8006
ID = 8006
pos = ifelse(TeamSide=1,32,288), 50;1P側か2P側かで条件分岐
postype = left
facing = ifelse(teamside=1,1,-1)
bindtime = -1
removetime = -1
scale = 0.5,0.5
sprpriority = 5
ontop = 1

;ゲージ枠の表示
[State -2]
type = Explod
triggerALL =  NumExplod(8005) = 0
trigger1 = var(3) = 1;散華カウントヘルパーがいれば表示
anim = 8005
ID = 8005
pos = ifelse(TeamSide=1,32,288), 50;1P側か2P側かで条件分岐
postype = left
facing = ifelse(teamside=1,1,-1)
bindtime = -1
removetime = -1
scale = 0.5,0.5
sprpriority = 4
ontop = 1

;ゲージの伸縮
;maxで0.5,0.5になり、時間経過で0に向けて減少。散華はそのまま、強制散華は倍速で減る
[State -2, ModifyExplod]
type = ModifyExplod
trigger1 = NumExplod(8006) = 1
ID =8006
scale = ifelse(var(58)=3,var(2),var(2)*2)/1920.0,0.5

;ゲージの削除
[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = var(3)=0
id = 8006
ignorehitpause = 1
persistent = 0

;ゲージ枠の削除
[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = var(3)=0
id = 8005
ignorehitpause = 1
persistent = 0


;---------------------------------------------------------------------------
; 先行入力用暗転感知
[State -2, gametime取得]
type = varset
trigger1 = 1
var(19) = gametime
ignorehitpause = 1

;---------------------------------------------------------------------------
;喰らい等、セリフ再生

[State -2, あくび]
type = playsnd
triggerall = (stateno = 11)
trigger1 = AnimElemTime(3)>=0
value = 13,0
channel = 1
lowpriority = 1
ignorehitpause = 1

[State -2, 喰らいボイス弱]
type = playsnd
triggerall = alive && time = 1
triggerall = stateno=5000 || stateno=5010 || stateno=5020
trigger1 = gethitvar(animtype) = 0
value = 5000,random%2
channel = 2
lowpriority = 1
ignorehitpause = 1

[State -2, 喰らいボイス中]
type = playsnd
triggerall = alive && time = 1
triggerall = stateno=5000 || stateno=5010 || stateno=5020
trigger1 = gethitvar(animtype) = 1
value = 5010,random%3
channel = 2
lowpriority = 1
ignorehitpause = 1

[State -2, 喰らいボイス強]
type = playsnd
triggerall = alive && time = 1
triggerall = stateno=5000 || stateno=5010 || stateno=5020
trigger1 = gethitvar(animtype) >= 2
value = 5020,random%4
channel = 2
lowpriority = 1
ignorehitpause = 1

[State -2, 吹っ飛びボイス]
type = playsnd
triggerall = alive && time = 1
trigger1 = (stateno = 5000 || stateno = 5010) && numenemy
trigger1 = gethitvar(fall) || (enemynear, hitdefattr = SCA, SA, HA)
trigger2 = (stateno = 5020 || stateno = 5070 || stateno = 5080)
trigger3 = (stateno = 5050 || stateno = 5100) && (prevstateno != [5000, 5199])
value = 5020,random%4
channel = 2
lowpriority = 1
ignorehitpause = 1

[State -2, ダウンボイス]
type = playsnd
triggerall = alive && time = 1
trigger1 = stateno=5100
value = 5020,3
channel = 2
lowpriority = 0
ignorehitpause = 1

[State -2, 起き上がりボイス]
type = playsnd
triggerall = alive && time = 1
trigger1 = stateno=5120
value = 5120,random%2
channel = 2
lowpriority = 0
ignorehitpause = 1

[State -2, 受身ボイス]
type = playsnd
triggerall = alive && time = 1
trigger1 = stateno=5200
value = 5120,random%2
channel = 2
lowpriority = 0
ignorehitpause = 1

[State -2, 気絶ボイス]
type = playsnd
triggerall = alive
trigger1 = Anim = 5300
trigger1 = AnimElem = 1, = 1
value = 5000,2
channel = 2
lowpriority = 1
ignorehitpause = 1


[State -2, KOボイス]
type = playsnd
trigger1 = alive = 0
trigger1 = Var(16) = 0
value = 181,1
channel = 2
lowpriority = 0
ignorehitpause = 1

[state -2];裸エプロンやられボイス
type=PlaySnd
trigger1=(anim=88260&&time=24)
value=s8826,0

;KOボイスを出したあとに変数をオンにする（KOボイスの下に記述でOK）
[State -2, 変数 KOボイス重複防止]
type = VarSet
trigger1 = Alive = 0
var(16)=1
ignorehitpause = 1


;ジャギ「おい、そこへ座れ」対応ステート
[state -2]
type=AssertSpecial
trigger1=numenemy
trigger1=movetype=H&&stateno=901&&enemynear,name="JAGI"&&enemynear,Authorname="Drowin hokuto"
flag=invisible

[state -2]
type=Explod
trigger1=!numexplod(810)&&numenemy
trigger1=movetype=H&&stateno=901&&enemynear,name="JAGI"&&enemynear,Authorname="Drowin hokuto"
anim=810
ID=810
postype=p1
scale=0.5,0.5
pos=0,0
bindtime=-1
removetime=-1
shadow=-1

[State -2]
type=RemoveExplod
trigger1=numexplod(810)=1&&(anim!=6||stateno!=901||(stateno=901&&time=120))
ID=810

[state -2]
type=ChangeAnim
trigger1=numenemy
trigger1=movetype=H&&stateno=805&&((enemynear,name="JAGI"&&enemynear,Authorname="Ahuron"&&time>=10)||(enemynear,name="JagiMeirin"&&enemynear,Authorname="Ts"&&(time=[10,141]))||(enemynear,name="JAGI"&&enemynear,Authorname="Ts"))
value=810

[State -2, 対応ボイス]
type = playsnd
triggerall=numenemy
trigger1=movetype=H&&stateno=805&&((enemynear,name="JAGI"&&enemynear,Authorname="Ahuron"&&time=60)||(enemynear,name="JagiMeirin"&&enemynear,Authorname="Ts"&&(time=60))||(enemynear,name="JAGI"&&enemynear,Authorname="Ts")&&(time=60))
trigger2=movetype=H&&stateno=901&&enemynear,name="JAGI"&&enemynear,Authorname="Drowin hokuto"&&time=60
value = 810,random%2
channel = 2
lowpriority = 0
ignorehitpause = 1


;-----------------------------------
;デバッグ時
[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
text = "C_hosei=%d,V_hosei=%d,S_hosei=%d,enemyhelpernum=%d\n"
params = fvar(1),fvar(2),helper(99999),var(19),var(57)
Ignorehitpause=1

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "Pos_X=%d,Pos_Y=%d, Vel_X=%f,Vel_Y=%f, Hit=%d \n"
params = P2bodydist x,P2bodydist y,(Vel X),(Vel Y),(MoveHit)

;---------------------------------------------------------------------------
