
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "Vier"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Vier"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 02,11,2018     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 01,18,2011     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Yakan2"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3,4        ;ＣＰＵで出てきた時のカラーパレットの順番

;--| 必要なファイルの設定 |---------------------------------------------------
;
; def・sff・snd・act以外のファイルは全てメモ帳などで書き換えられる
; テキスト形式のファイルなので、拡張子は何でもＯＫです。
; しかしファイルの認識で不正終了が起こる可能性もあるので、
; 無難に行くならM.U.G.E.Nでサポートされている拡張子にしておきましょう。
;
; def（定義ファイル）のみ、テキスト形式のファイルですが拡張子の変更は不可です。
;
; ※StCommonは書き換えない限り、dataフォルダにある「common1.cns」を
; 　直接読み込んでますが、あなたが独自に作ったコモンファイルを設定する場合は
; 　各キャラクターの「defファイルのあるフォルダ」を基準に
; 　ディレクトリ階層が認識されます。
;-----------------------------------------------------------------------------

[Files]
Cmd     = vier.cmd       ;コマンドファイルの登録
Cns     = vier.cns       ;コンスタンツファイルの登録
St      = vier.cns 
st0     = vier_N.cns       ;ステートファイルの登録・最大１１個まで増やせます
st1     = vier_S.cns       ;St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
st2     = vier_H.cns
st3     = vier_-2.cns 
st4     = vier_-3.cns 
st5     = vier_commom1.cns ;「St」のみ必要な項目なので省略出来ません
StCommon = common1.cns  ;コモンステートファイルの登録
Sprite  = vier.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = vier.air       ;アニメーションファイルの登録
Sound   = vier.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録

;--| カラーパレットファイル |-------------------------------------------------
;
; キャラクターの色を定義するファイルは最大１２個まで登録が可能です。
;
; なお、Pal7～12（７Ｐ～１２Ｐカラー）を選びたい時は、
; スタートボタン（Ｓボタン）を押しながらキャラクターを決定すれば使えます。
; この要素を利用して『裏キャラ』や『殺意の波動に目覚めたリュウ』などの
; 別性能バージョンも１体のキャラの中で作る事が可能。
;
;-----------------------------------------------------------------------------

Pal1 = vier1.act  ;Ａボタンで決定した色が使えます
Pal2 = vier2.act  ;Ｂ
Pal3 = vier3.act  ;Ｃ
Pal4 = vier4.act  ;Ｘ
Pal5 = vier5.act  ;Ｙ
Pal6 = vier6.act  ;Ｚ
Pal7 = vier7.act  ;Ｓ押しながらＡボタンで決定した色が使えます
Pal8 = vier8.act  ;Ｓ押しながらＢ
Pal9 = vier9.act  ;Ｓ押しながらＣ
Pal10= vier10.act  ;Ｓ押しながらＸ
Pal11= vier11.act  ;Ｓ押しながらＹ
Pal12= vier12.act  ;Ｓ押しながらＺ

;--| ストーリーボード設定 |---------------------------------------------------
;
; キャラクター固有のオープニングやエンディングのファイル（ストーリーボード）を
; 登録する場合はここで設定をします。
;
; ※ここで設定したストーリーボードが有効になるゲームモードは
; 「アーケードモード（ARCADE）」
; 「チームアーケードモード（TEAM ARCADE）」
; 「１Ｐと２ＰがペアになってＣＰＵと闘うモード（TEAM CO-OP）」の三種類のみ。
;
; 　しかしチームを組んだ場合、有効になるのは『選んだ最初の一人目』のみ。
;
;-----------------------------------------------------------------------------

;[Arcade]
;Intro.Storyboard = intro.def   ;オープニングのファイルを登録します
;Ending.Storyboard = ending.def ;エンディングのファイルを登録します

;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------

