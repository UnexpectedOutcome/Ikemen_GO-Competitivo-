;===========================================================================
; 超必殺技
;===========================================================================
;---------------------------------------------------------------------------
; 最初のM.U.G.E.Nから存在するカンフーマンの超必殺技。
; 超必なので攻撃を当ててもゲージを増やさないようにする事に気を付けるだけで、
; 後は結構簡単な処理にまとめられてる。
; 超必時の暗転用の処理（SuperPause）にも刮目せよ！m9っ｀Д´)
;---------------------------------------------------------------------------


;===========================================================================
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;超変身！水龍飛翔拳
[Statedef 3000]
type    = S
movetype= A
physics = S
juggle  = 10
velset = 0,0
anim = 3000
ctrl = 0
sprpriority = 2

[State 3000, 相手の特定の攻撃属性無効]
type = NotHitBy
trigger1		= animelemtime(4) < 0;攻撃判定終了まで
value = SCA
time=1
ignorehitpause = 1
persistent=1

[State 3000, 超必殺技暗転時間停止]
type = SuperPause
trigger1 = time =0
time = 60
movetime= 60
p2defmul	= 1
darken = 1
pos = -5, -55
anim = 100
sound = 20, 0
poweradd = -1000
unhittable = 1

[State 3000, 魔種成長]
type = VarAdd
trigger1 = var(58) != 0
trigger1 = var(3)= 0
trigger1=time=1
;trigger1 = movehit = 1
var(58) = 1
ignorehitpause = 1
persistent = 0

[State 3000, ヘルパー];カットイン用
type = Helper
trigger1 = time = 0
;trigger1 = (Facing = 1)
helpertype = normal
name = "cutin_helper"
size.xscale = 1.0
size.yscale = 1.0
stateno = 10000
ID = 10000
pos = 0, -40
postype = left
facing = 1
keyctrl = 0
supermovetime = 60
pausemovetime = 60


[State 3000, 残像フラグオン]
type = varset
trigger1 = time=0
var(17)=1
ignorehitpause=1


[State 3000, 残像]
type = afterimage
triggerall = var(3)=0;非散華時
triggerall = var(17)=1;残像フラグがオンだったら
trigger1 = time=1
time = 120
timegap = 1
framegap = 2
length = 20
palcolor = 256
palinvertall = 0
palbright	= 24,24,24
palcontrast = 48,48,192
palpostbright = 12,12,12
paladd = 8,8,12
palmul = 0.64,0.64,0.80
trans = add1	

[State 3000, 戻りは残像を消す]
type = varset
trigger1 = animelem = 4
var(17)=0
ignorehitpause=1




[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem=3
value = 0, 3


[State 3000, ヒット定義]
type = HitDef
trigger1 = Time = 0
ID = 3000
attr = S, HA
animtype  = Hard
air.animtype = Hard
fall.animtype = Hard
damage    = ceil(72*fvar(1)*fvar(3)), ceil(9*fvar(1)*fvar(3))
priority  = 4,Hit
guardflag = M
hitflag = MAF
pausetime	= 60, 48
guard.pausetime = 12, 12
sparkno =s7010
sparkxy = 0,-110
hitsound   = s3000, 0
guardsound = s150,2
p2facing = 1
ground.type = Low
air.type = Low
ground.slidetime = 15
ground.hittime  = 16
guard.hittime = 13
guard.ctrltime= 12
ground.velocity = .8, -7.2
guard.velocity = -8
air.velocity = .8, -7.2
ground.cornerpush.veloff = 0
getpower = 0
givepower = 36, 36
envshake.time = 24        ;攻撃を当てた場合の画面振動の処理
envshake.ampl = 8
envshake.freq = 120
fall = 1
fall.recover = 0          ;相手は空中受け身が出来なくなる
yaccel = .6
kill = 0
forcestand = 1

[State 3000, Explod]
type = Explod
trigger1 = movecontact
anim = 7000
ID = 7000
pos = 10,-80
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
vel = 0,0
accel = 0,0
random = 5,5
removetime = -2
pausemovetime = 0
scale = 1,1
sprpriority = 9
ontop = 1
pausemovetime = 99999
supermovetime = 99999
shadow = 0,0,0
ownpal = 1
removeongethit = 0
ignorehitpause =1
persistent =0



[State 3000, VarSet]
type = VarSet
trigger1 = movehit=1
fv = 1
value = Ifelse(fvar(1)=1,0.80,fvar(1)*0.91)
ignorehitpause = 1
persistent = 0

;ノックバック補正
[State 3000, varset]
type=Varset
;TriggerAll = StateNo = [200,2999];超必以外の時にカウントするよ
Trigger1 = MoveHit = 1 
fv=2
Value = ifelse(var(3)=1,fvar(2)+0.04,fvar(2)+0.08);相手のHit*0.2の補正をかけるよ
IgnoreHitPause = 1
persistent= 0


[State 3000, PlayerPush]
type		= PlayerPush
trigger1	= 1
value		= 0
persistent	= 1

[State 3000, ステート変更];攻撃がヒットした場合
type = ChangeState
trigger1 = MoveHit
value = 3001
ctrl = 0



[State 3000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 3003
ctrl = 0




;---------------------------------------------------------------------------
;ネオ・ドラゴンアッパー：ヒット後
[Statedef 3001]
type    = S
movetype= A
physics = S
anim = 3001
ctrl = 0
velset = 0, 0
sprpriority = 2




[State 3001, 無敵]
type = NotHitBy
trigger1 = 1;常に実行
value = SCA
ignorehitpause = 1
time=1
persistent=1

[State 3001, PlayerPush]
type = PlayerPush
trigger1	= 1
value = 0
persistent = 1



[State 3001, 速度セット1]
type = velset
trigger1	= animelem = 5
x = 2
y = -14

[State 3001, 乗算速度セット]
type = velmul
trigger1	= 1
x = .88

[State 3001, 上昇を始めたらx方向の速度を消す]
type = velmul
trigger1	= vel y>0
x = 0

[State 3001, 7枚目から上に飛ぶ]
type = veladd
trigger1	= animelemtime(6)>0
y = 0.34



