trigger1 = random =[901,999];ランダム値が0から200であれば
;------------------------------------------------------------------------------
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;空中立ち回り技振り 
;Ctrl Random EnemyNear,Movetype = I inguarddist P2bodyDist Y P2bodyDist X
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1, 空中投げ];空中投げ技
type = ChangeState
value = 810
triggerall = var(59)=1;AI専用
triggerall = roundstate = 2
triggerall = EnemyNear,StateType != L;直近の敵がダウンしてない
;空中で操作可能なときステップ中でなければ可能
triggerall = stateno != 110
triggerall = statetype = A
trigger1 = ctrl
trigger1 = Random = [0,30]
trigger1 = p2bodydist X <= 20
trigger1 = p2bodydist Y = [-72,60]


[State -1, 空レバー入れ投げ];後ろ入れ投げ技
type = ChangeState
value = 815
triggerall = var(59)=1;AI専用
triggerall = roundstate = 2
triggerall = stateno != 110
triggerall = statetype = A
trigger1 = ctrl
trigger1 = Random = [31,60]
trigger1 = p2bodydist X <= 20
trigger1 = p2bodydist Y = [-72,60]


[State -1, JA]
type = ChangeState
value = 600
triggerall = var(59)=1;AI専用
triggerall = roundstate = 2
;空中で操作できるなら出せる
trigger1 = statetype = A
trigger1 = ctrl
trigger1 = P2StateType=A;相手が空中にいれば
trigger1 = P2moveType!=A;相手攻撃中じゃなければ
trigger1 = P2BodyDist x=[0,40];相手との距離が近ければ
trigger1 = p2bodydist Y = [-80,70]
trigger1 = random =[0,150];ランダム値が0から200であれば
;攻撃が当たったときキャンセル
trigger2 = (stateno = 600) && MoveContact=[1,8]
trigger2 = P2BodyDist x=[0,30];相手との距離が近ければ
trigger2 = p2bodydist Y = [-80,70]
trigger2 = random =[0,50]
;空ダ後
trigger3 =  stateno = 110  && time>= 8
trigger3 = P2BodyDist x=[0,40]
trigger3 = random =[0,100]

[State -1, JB]
type = ChangeState
value = 610
triggerall = var(59)=1;AI専用
triggerall = roundstate = 2 
;空中で操作できるなら出せる
trigger1 = statetype = A
trigger1 = ctrl
trigger1 = P2StateType=A;相手が空中にいれば
trigger1 = P2moveType!=A;相手攻撃中じゃなければ
trigger1 = P2BodyDist x=[0,120];相手との距離が近ければ
trigger1 = random =[201,700];ランダム値が0から200であれば
;JAがヒットしたらキャンセルできる
trigger2 =(stateno = 600) && MoveContact=[1,8]
trigger2 = P2BodyDist x=[0,120];相手との距離が近ければ
trigger2 = random =[51,950]
;空ダ後
trigger3 =  stateno = 110  && time>= 8
trigger3 = P2BodyDist x=[0,120]
trigger3 = random =[101,600]
;空バダ後
trigger4 =  stateno = 115  && time>= 8
trigger4 = random =[0,600]

[State -1, JC]
type = ChangeState
value = 630
triggerall = var(59)=1;AI専用
triggerall = roundstate = 2
;空中で操作できるなら出せる
trigger1 = statetype = A
trigger1 = ctrl
trigger1 = P2StateType!=A;相手が空中にいなければ
trigger1 = P2moveType!=A;相手攻撃中じゃなければ
trigger1 = P2BodyDist x=[0,10];相手との距離が近ければ
trigger1 = random =[701,800];ランダム値が0から200であれば
;JBがヒットしたらキャンセルできる
trigger2 =(stateno = 610) && MoveContact=[1,8]
trigger2 =(stateno = 610) &&AnimElem = 3 >=1
trigger2 = P2BodyDist x=[0,10];相手との距離が近ければ
trigger2 = random =[0,100]
;空ダ後
trigger3 =  stateno = 110  && time>= 8
trigger3 = P2BodyDist x=[0,10]
trigger3 = random =[601,700]

[State -1, JX]
type = ChangeState
value = 640
triggerall = var(59)=1;AI専用
;空中で操作できるなら出せる
trigger1 = statetype = A
trigger1 = ctrl
trigger1 = P2moveType!=A;相手攻撃中じゃなければ
trigger1 = P2BodyDist x=[0,90];相手との距離が近ければ
trigger1 = random =[801,999];ランダム値が0から200であれば
;JBがヒットしたらキャンセルできる
trigger2 =(stateno = 610) && MoveContact=[1,8]
trigger2 =(stateno = 610) &&AnimElem = 3 >=1
trigger2 = P2BodyDist x=[0,90]
;JCがヒットしたらキャンセルできる
trigger3 =(stateno = 630) && MoveContact=[1,8] 
trigger3 =(stateno = 630) &&AnimElem = 7 >=1
trigger3 = P2BodyDist x=[0,90]
;空ダ後
