type = PlaySnd
triggerall = (stateno = 3000)||(stateno = 3100)
trigger1 = time=1
value = 10000, 1
volume = 100
channel = 0          ;0=セリフ、1=システム用ボイス
lowpriority = 0      ;0以外=音が鳴ってる場合は、PlaySndが実行されない
ignorehitpause = 1


[State -2, セリフ 水龍飛翔拳]
type = PlaySnd
triggerall = (stateno = 3000)
trigger1 = movehit=1
trigger1 = AnimElemTime(3)>=0
trigger1=(Enemynear,Time=12)&&(Enemynear,Movetype=H)
value = 3000, 3
volume = 100
channel = 0          ;0=セリフ、1=システム用ボイス
lowpriority = 0      ;0以外=音が鳴ってる場合は、PlaySndが実行されない
persistent = 0
ignorehitpause = 1

[State -2, セリフ 天馬流転]
