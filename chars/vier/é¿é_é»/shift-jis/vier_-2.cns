trigger1 = time =65
value = 3100, 0
volume = 100
channel = 0          ;0=セリフ、1=システム用ボイス、2=イントロ用
lowpriority = 0      ;0以外=音が鳴ってる場合は、PlaySndが実行されない


;---------------------------------------------------------------------------
;-----------------------------------
;デバッグ時
[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
text = "C_hosei=%d,V_hosei=%d,S_hosei=%d,AICheck=%d\n"
params = fvar(1),fvar(2),fvar(3),var(59)
Ignorehitpause=1

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "Pos_X=%d,Pos_Y=%d, Vel_X=%f,Vel_Y=%f, Hit=%d \n"
params = P2bodydist x,Pos y,(Vel X),(Vel Y),(MoveHit)

