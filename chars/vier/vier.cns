;---------------------------------------------------------------------------
;常駐ヘルパー
;helper(99999)とhelper(99998)がここに来る（地上用と空中用）
;先行入力,ガードチェック、投げ抜け可能チェック
[statedef 99999]
type = A
movetype = I
physics = N
ctrl = 0
anim = 7550

[state 99999, 間違いで本体が来たら立ちへ帰れ]
type = selfstate
trigger1 = !ishelper
value = 0

[state 99999, 不可視化]
type = assertspecial
trigger1 = 1
flag = invisible
flag2= noshadow

[state 99999, 無敵化]
type = nothitby
trigger1 = 1
value = SCA

[state 99999, posset]
type = posset
trigger1 = 1
x = root,pos X
y = 99999

;親が生きてなければ反応するな
[state 99999, 消滅]
type = null;destroyself
trigger1 =!(root,alive)

;空中先行入力ヘルパー用の処理
;親とヘルパーが同じ向きを向いていなければturnで同じ向きを向け
[state 99999, turn]
type = turn
trigger1 = ishelper(99998)
trigger1 = root,facing != facing
ignorehitpause = 1

;地上先行入力ヘルパー用の処理
[state 99999, turn]
trigger1 = ishelper(99999)
type = turn
trigger1 = p2dist X < 0
ignorehitpause = 1

[state 99999, ctrl無効]
type = ctrlset
trigger1 = 1
value = 0
ignorehitpause = 1

;---------------------------------------------------------------------------
;投げ抜けチェック
[State 99999, 保存]
type = Null
trigger1 = 1 || var(59) := Enemy,ctrl
trigger1 = 1 || var(58) := Enemy,StateNo

;---------------------------------------------------------------------------
[State 99999, 暗転感知フラグリセット]
type = varset
trigger1 = 1
var(57)=0
ignorehitpause = 1

;未実装。上下とも必要であれば今後なんかする
[State 99999, 暗転感知フラグセット]
type = varset
trigger1 = gametime - root,var(19) >= 17
var(57)=1
ignorehitpause = 1

[State 99999, ステート奪取感知フラグリセット]
type = varset
trigger1 = 1
var(56)=0
ignorehitpause = 1

;未実装。上下とも必要であれば今後なんかする
[State 99999, ステート奪取感知フラグセット]
type = varset
trigger1 = gametime - root,var(18) >= 5
var(56)=1
ignorehitpause = 1


;---------------------------------------------------------------------------
[State 99999, ドラゴン先行入力フレーム減算]
type = varadd
triggerall =!(root,hitpausetime);親がhitpauseじゃなければ処理せよ
;通常技の攻撃判定が終わったらもしくは攻撃を受けるなどしてmovetypeがAではなくなったら減算せよ
triggerall = !(root,StateNo = 200 && root,animelemtime(3) < 0) || root,movetype != A
triggerall = !(root,StateNo = 210 && root,animelemtime(5) < 0) || root,movetype != A
triggerall = !(root,StateNo = 230 && root,animelemtime(7) < 0) || root,movetype != A
triggerall = !(root,StateNo = 240 && root,animelemtime(6) < 0) || root,movetype != A
triggerall = !(root,StateNo = 400 && root,animelemtime(4) < 0) || root,movetype != A
triggerall = !(root,StateNo = 410 && root,animelemtime(4) < 0) || root,movetype != A
triggerall = !(root,StateNo = 430 )|| root,movetype != A
triggerall = !(root,StateNo = 440 && root,animelemtime(10) < 0) || root,movetype != A
;必殺技の攻撃判定が終わったらもしくは攻撃を受けるなどしてmovetypeがAではなくなったら減算せよ。ドルフィンのみキャンセルタイミングの都合上statetypeが地上となるタイミングまで減算するな
triggerall =!((root,stateno = 1100&&root,AnimElemtime(12)<0)||(root,stateno = 1110&&root,AnimElemtime(12)<0)||(root,stateno = 1120 &&root,AnimElemtime(12)<0))|| root,movetype != A
;変数が0よりも大きかったら減算せよ
trigger1 = var(0) > 0
var(0) = -1


[State 99999, ペガサス先行入力フレーム減算]
type = varadd
triggerall =!(root,hitpausetime);親がhitpauseじゃなければ処理せよ
;通常技の攻撃判定が終わったらもしくは攻撃を受けるなどしてmovetypeがAではなくなったら減算せよ
triggerall = !(root,StateNo = 200 && root,animelemtime(3) < 0) || root,movetype != A
triggerall = !(root,StateNo = 210 && root,animelemtime(5) < 0) || root,movetype != A
triggerall = !(root,StateNo = 230 && root,animelemtime(7) < 0) || root,movetype != A
triggerall = !(root,StateNo = 240 && root,animelemtime(6) < 0) || root,movetype != A
triggerall = !(root,StateNo = 400 && root,animelemtime(4) < 0) || root,movetype != A
triggerall = !(root,StateNo = 410 && root,animelemtime(4) < 0) || root,movetype != A
triggerall = !(root,StateNo = 430 )|| root,movetype != A
triggerall = !(root,StateNo = 440 && root,animelemtime(10) < 0) || root,movetype != A
;必殺技の攻撃判定が終わったらもしくは攻撃を受けるなどしてmovetypeがAではなくなったら減算せよ。ドルフィンのみキャンセルタイミングの都合上statetypeが地上となるタイミングまで減算するな
triggerall =!((root,stateno = 1100&&root,AnimElemtime(12)<0)||(root,stateno = 1110&&root,AnimElemtime(12)<0)||(root,stateno = 1120 &&root,AnimElemtime(12)<0))|| root,movetype != A
trigger1 = var(1) > 0
var(1) = -1


[State 99999, タイタン先行入力フレーム減算]
