trigger1		= animelemtime(3) < 0;攻撃判定終了まで
value = SCA
time=1
ignorehitpause = 1
persistent=1

;散華中に散華しないようにしたり散華専用残像出したり散華タイムキーパーヘルパー出したり他の残像出さないようにしたりノックバック補正下げたり攻撃力上げたりのフラグ
