;---------------------------------------------------------------------------
; 先行入力ヘルパー変数
;---------------------------------------------------------------------------
;Var(0)  ドラゴン
;var(1)  ペガサス
;var(2)  タイタン（予定）
;var(3)  ウルテマ
;var(4)  キャノンa
;var(5)  キャノンｂ
;var(6)  キャノンc
;var(7)  フィッシュa
;var(8)  フィッシュb
;var(9)  フィッシュc
;var(10) バルーンa
;var(11) バルーンb
;var(12) バルーンc
;var(13) ドリルa
;var(14) ドリルb
;var(15) ドリルc
;var(16) 5a
;var(17) 5b
;var(18) 5c
;var(19) 5x
;var(20) 2a
;var(21) 2b
;var(22) 2c
;var(23) 2x
;var(24) ja
;var(25) jb
;var(26) jc
;var(27) jx
;var(28) フロントステップ
;var(29) バックステップ
;var(30) 空中ダッシュ
;var(31) 空中バックダッシュ
;var(32) NHJ
;var(33) FHJ
;var(34) BHJ
;var(35) 
;var(36) 
;var(37)
;var(38)
;var(39)　5B最終段コンタクト確認
;var(40) 5C最終段コンタクト確認
;var(41) 2B最終段コンタクト確認
;var(42) 2C最終段コンタクト確認
;var(43) 2X最終段コンタクト確認 
;var(44) JB最終段コンタクト確認 
;var(45) JC最終段コンタクト確認 
;var(46) Aドルフィン最終段コンタクト確認 
;var(47) Bドルフィン最終段コンタクト確認 
;var(48) Cドルフィン最終段コンタクト確認  
;var(49) 5B最終段ヒット確認
;var(50) 2B最終段ヒット確認
;var(51) 2X最終段ヒット確認 
;var(52) 
;var(53) 
;var(54) 
;var(55) 
;var(56) ステート奪取感知
;var(57) 暗転感知チェック
;var(58) 相手の直前ステート
;var(59) 相手の直前コントロール
;------------------------------

