;ドラゴン===========================
;ドルフィンはstatetypeAのゾーンがあるのでstatetypeを縛ってはいけない
[State -1, ドラゴン先行猶予フレーム設定]
type =varset
triggerall = root,var(59)=0
trigger1 = root,statetype != A
trigger1 = (command = "Doragon")
trigger2 = (root,stateno = 1100)||(root,stateno = 1110)||(root,stateno = 1120)
trigger2 = (command = "Doragon")
var(0)=6;先行猶予6フレーム



