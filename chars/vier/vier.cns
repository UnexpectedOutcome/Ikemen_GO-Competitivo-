;---------------------------------------------------------------------------
;散華残り時間管理用ヘルパー
[Statedef 7550]
type    = A
movetype= I
physics = N
anim = 7550
sprpriority = 2
ctrl = 0

[State 7550, 0];完全無敵やったぜべいべー
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 7550, 0]; 不具合対策ヘルパーじゃなかったら0に行くという確認
type = ChangeState
trigger1 = !IsHelper
value = 0
ctrl = 1

[State 7550, 影消去]
Type = AssertSpecial
Trigger1 = 1
IgnoreHitPause = 1
Flag = NoShadow

;戦闘中のみ減少。もしvar(2)が有限のまま戦闘が終わった場合は-2stateで強制的にvar(2)=1にして散華終了処理にする
[State 7550, 残り時間タイマー]
type = parentVaradd
triggerall=root,stateno!=7500;散華動作中はタイマーを減らさない
trigger1=roundstate=2
trigger1 = root,var(2)>0;マイナスにならないようにする
var(2) = -1

;残り時間1になったら退化
[State 7550, 散華終了時二段階退化]
type = parentVarAdd
trigger1 = root,var(2)=1
v =58
value = -2
ignorehitpause =1 
persistent = 0

;残り時間1になったらスイッチオフ
[State 7550, 散華スイッチオフ]
type = parentVarset
trigger1 = root,var(2)=1
var(3)=0
ignorehitpause =1 
persistent = 0

;残り時間1になったらタイムキーパー消去。
[State 3473, ヘルパー消去]
type = DestroySelf
trigger1 = root,var(2) =1
trigger2 = stateno=3300;アルティメットフォース始動に来たときも消える。タイマーオフ、退化、散華スイッチオフの後処理は3300でやる
