;===========================================================================
; 準常時監視ステート（‐３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; ‐１や‐２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

;通常ボイスとgametime取得
[Statedef -3]
;裏回り防止。やられ、例外的に発動したくないものを除いて画面端から3ドット押し出されるようにすればいいらしい
[State -3]
type = width
trigger1 = movetype != H
;trigger1 = stateno != 801;例外的に発動したくないstatenoをここに入れる
;trigger1 = stateno != 811
edge = 3,0
ignorehitpause = 1

;-----------------------------------
;先行入力認識用ヘルパー暴走防止
[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(99999)
value = 99999
ignorehitpause = 1

[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(99998)
value = 99999
ignorehitpause = 1

;-----------------------------------

;先行入力認識用ヘルパー
[state -3, 先行入力認識用ヘルパー地上]
type = helper
trigger1 = !numhelper(99999);helper(99999)の数が0だったら発動
trigger1 = !ishelper
helpertype = normal
name = "commandhelper"
stateno = 99999
ID = 99999
postype = p1
pos = 0,9999
keyctrl = 1
pausemovetime = 2147483647
supermovetime = 2147483647


[state -3, 空中コマンド認識用ヘルパー]
type = helper
trigger1 = !numhelper(99998);helper(99999)の数が0だったら発動
trigger1 = !ishelper
trigger1 = alive
helpertype = normal
name = "commandhelperA"
stateno = 99999;同じく99999で管理
ID = 99998;ただしIDは地上と変えること
postype = p1
pos = 0,9999
keyctrl = 1
pausemovetime = 2147483647
supermovetime = 2147483647

;-----------------------------------


; 先行入力用ステート奪取感知
[State -3, gametime取得]
type = varset
trigger1 = 1
var(18) = gametime
ignorehitpause = 1

;-----------------------------------
;-----------------------------------
;通常セリフ再生(ステートを奪われたときに出して欲しくない声)
[State -3, セリフ 散華]
type = PlaySnd
triggerall =  time=1
trigger1 = (stateno = 7500)
value = 750, (Random%2)
channel = 0          ;0=セリフ、1=システム用ボイス、2=イントロ用
lowpriority = 0      ;0以外=音が鳴ってる場合は、PlaySndが実行されない


[State -3, セリフ バースト]
