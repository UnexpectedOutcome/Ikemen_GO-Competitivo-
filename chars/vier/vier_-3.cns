triggerall = (stateno = 3000)
trigger1 = var(25)=0
trigger1 = movehit=1
trigger1 = AnimElemTime(3)>=0
trigger1=(Enemynear,Time=12)&&(Enemynear,Movetype=H)
value = 3000, 4;演出をver0.872以前に戻したいときは3000,3にする。state3000とstate3001のヒットストップも設定せよ
volume = 0
channel = 0          ;0=セリフ、1=システム用ボイス
lowpriority = 0      ;0以外=音が鳴ってる場合は、PlaySndが実行されない
persistent = 0
ignorehitpause = 1

