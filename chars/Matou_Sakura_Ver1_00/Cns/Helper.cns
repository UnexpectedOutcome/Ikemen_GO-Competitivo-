;------------------------------------------------------------------------------
;■変数表（helper(25000)）

;var(0)  =	プレイヤーID検索ループ回数
;var(1)  =	検索ID
;var(2)  =	発見した最大プレイヤーID
;var(3)  =	探索しうるヘルパー数+1

;var(4)～var(59)  =	1～56番ヘルパー


;fvar(0)  =	到達F順格納ループ回数

;fvar(1)  =	攻撃ヘルパーX軸到達F
;fvar(2)  =	設置ヘルパーXY距離

;fvar(3)  =	P3攻撃ヘルパー発生中

;fvar(4)  =	記録したプレイヤーID数合計

;fvar(5)～fvar(9)   =	近い設置ヘルパー
;fvar(10)～fvar(19) =	近い攻撃ヘルパー

;fvar(20)～fvar(24) =	設置ヘルパーX距離代入用
;fvar(25)～fvar(29) =	設置ヘルパーY距離代入用

;fvar(30)～fvar(39) =	到達ヘルパーX軸F代入用

