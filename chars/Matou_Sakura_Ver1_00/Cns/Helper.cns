trigger1 = 1
time = 1
facing = 1
pos = 0, 0
IgnoreHitPause = 1

[State -1, アニメ同期]
type = ChangeAnim
trigger1 = root,Anim=210
trigger1 = AnimExist(Anim)
trigger1 = AnimTime<0
value = 211
elem = 2+time-var(0)-var(1)-root,var(13)
IgnoreHitPause = 1

[State -1, 影無し]
type = AssertSpecial
trigger1 = 1
Flag = Noshadow
IgnoreHitPause = 1

[State 211, END]
type = DestroySelf
trigger1 = AnimTime=0
trigger2 = root,stateno!=210
IgnoreHitPause = 1


