trigger1 = Time=0
var(13) = 0
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;■停止時間観測

[State -1, 時間経過初期化]
type = null
trigger1 = time=0
trigger1 = var(0):=0
IgnoreHitPause = 1

[State -1, ヒットストップ時間計測]
type = null
trigger1 = root,HitPauseTime>=1
trigger1 = var(0):=var(0)+1
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;■ヘルパー格納場所の処理順による誤差修正

[State -1, 時間経過初期化]
type = null
trigger1 = var(1)<0
trigger1 = var(1):=0
IgnoreHitPause = 1

[State -1, 時間停止除外時間経過]
type = null
trigger1 = var(1):=var(1)-1||1

[State -1, ヒットストップ除外時間計測]
type = null
trigger1 = root,HitPauseTime<=0
trigger1 = var(1):=var(1)+1
IgnoreHitPause = 1

