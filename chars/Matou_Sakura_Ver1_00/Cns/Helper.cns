trigger1 = time=0
trigger1 = Ishelper(6100)
trigger1 = numenemy>0
fvar(1) = IfElse(enemynear(root,var(16)),statetype=A,50+Random%200,50+Random%160)

[State -1, テレポ投げ発射角]
