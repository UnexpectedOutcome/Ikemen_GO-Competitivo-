trigger1 = time=0
trigger1 = Ishelper(6103)
fvar(1) = Random%360

[State -1, 相対距離]
type = VarSet
trigger1 = 1
fvar(10) = ParentDist Y+0.001

[State -1, 相対距離]
type = VarSet
trigger1 = 1
fvar(11) = ParentDist X+0.001

[State -1, 角度]
type = VarSet
trigger1 = time>=15
trigger1 = fvar(11)!=0
fvar(0) = -atan(fvar(10)/fvar(11))*(180/pi)-IfElse(fvar(11)<0,IfElse(fvar(10)>0,180,-180),0)

[State -1, 角度変更]
type = VarSet
trigger1 = time=1
fvar(2) = 5

[State -1, 角度増加]
type = VarAdd
trigger1 = Ishelper(6100)
trigger1 = (abs(ParentDist Y)>=80&&abs(ParentDist X)<=80)||time=[25,85]
trigger2 = Ishelper(6101)||Ishelper(6102)||Ishelper(6103)
trigger2 = time=[0,60]
fvar(2) = 0.25

[State -1, 角度増加]
type = null
triggerall = time=[25,39]
trigger1 = fvar(2):=fvar(2)+10

[State -1, 誘導]
type = VarAdd
trigger1 = Ishelper(6100)
trigger1 = (abs(ParentDist Y)>=80&&abs(ParentDist X)<=80)||time>=24
trigger2 = Ishelper(6101)||Ishelper(6102)||Ishelper(6103)
trigger2 = time>=14
fvar(1) = IfElse(fvar(0)-fvar(1)>fvar(2),IfElse(fvar(0)-fvar(1)>180,-fvar(2),fvar(2)),IfElse(fvar(0)-fvar(1)<-fvar(2),IfElse(fvar(0)-fvar(1)<-180,fvar(2),-fvar(2)),fvar(0)-fvar(1)))

[State -1]
type = VarAdd
trigger1 = fvar(1)>180
fvar(1) = -360

[State -1]
type = VarAdd
trigger1 = fvar(1)<-180
fvar(1) = 360

[State -1, 速度]
type = VelSet
trigger1 = time=[0,4]
trigger1 = fvar(1)!=0
x = cos((pi/180)*fvar(1))*(10)
y = sin((pi/180)*fvar(1))*(-10)

[State -1, 速度]
type = VelSet
trigger1 = time=[5,24]
trigger1 = fvar(1)!=0
x = cos((pi/180)*fvar(1))*(10-(time-4)*0.5)
y = sin((pi/180)*fvar(1))*(-10+(time-4)*0.5)

[State -1, 速度]
type = VelSet
trigger1 = time=[25,39]
trigger1 = fvar(1)!=0
x = 0
y = 0

[State -1, 速度]
type = VelSet
trigger1 = time=[40,49]
trigger1 = fvar(1)!=0
x = cos((pi/180)*fvar(1))*((time-39)/2.0+time/2.5)
y = sin((pi/180)*fvar(1))*(-(time-39)/2.0-(time/12.5))

[State -1, 速度]
type = VelSet
trigger1 = time>=49
trigger1 = fvar(1)!=0
x = cos((pi/180)*fvar(1))*(5+time/2.5)
y = sin((pi/180)*fvar(1))*(-5-(time/12.5))

;■接触処理
[State -1, 削除スイッチ]
type = VarSet
trigger1 = time>=10
trigger1 = (ParentDist X=[-10,10])&&(ParentDist Y=[-25,45])
var(0) = 1

[State 810, SE]
type = PlaySnd
triggerall = root,stateno!=2810
trigger1 = var(0)
value = S70, 19

;■聖杯ゲージ追加増加
[State -1, スイッチ]
type = ParentVarSet
triggerall = var(0)
trigger1 = Ceil(root,var(52)/100%10)<=1&&root,fvar(20)<2800
trigger2 = Ceil(root,var(52)/100%10)>=2&&root,fvar(20)<5600
var(25) = root,var(25)+(1*!(root,var(25)&(1)))

[State -1, 増加]
type = ParentVarAdd
triggerall = var(0)
trigger1 = Ceil(root,var(52)/100%10)<=1&&root,fvar(20)<2800
trigger1 = var(1):=1
trigger2 = Ceil(root,var(52)/100%10)>=2&&root,fvar(20)<5600
trigger2 = var(1):=4
fvar(20) = IfElse(Ishelper(6101),var(1)*16,IfElse(Ishelper(6102),var(1)*12,var(1)*8))

;■体力回復
[State -1, 回復量スイッチ]
type = ParentVarSet
triggerall = var(0)
triggerall = root,fvar(20)>=2800
trigger1 = Ceil(root,var(52)/100%10)<=1
trigger1 = var(2):=1
trigger2 = Ceil(root,var(52)/100%10)>=2
trigger2 = var(2):=2
var(26) = IfElse(Ishelper(6101),var(2)*10,IfElse(Ishelper(6102),var(2)*6,var(2)*2))

[State 6100, END]
type = DestroySelf
trigger1 = time>=180
trigger2 = var(0)
IgnoreHitPause = 1


