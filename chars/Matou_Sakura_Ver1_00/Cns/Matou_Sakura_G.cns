trigger5 = root,MoveType!=H||(root,stateno=[120,155])||Ceil(root,var(52)/100%10)>=2||Ceil(root,var(54)%10)>=5
trigger5 = var(5):=time&&var(6):=7070

;中攻撃
trigger6 = (root,var(59)<=0&&(root,var(59)<=0&&root,command="M_giant")||(root,var(59)>=1&&(root,var(46)&(Ceil(2.0**13)))))||(root,var(59)>=1&&(root,var(46)&(Ceil(2.0**13))))
trigger6 = root,MoveType!=H||(root,stateno=[120,155])||Ceil(root,var(52)/100%10)>=2||Ceil(root,var(54)%10)>=5
trigger6 = var(5):=time&&var(6):=7060

;弱攻撃
