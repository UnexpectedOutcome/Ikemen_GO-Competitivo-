;------------------------------------------------------------------------------
;■ステート移動

[State 7050, セット]
type = null
triggerall = RoundState>=2

;死亡
trigger1 = var(8)<=0
trigger1 = var(5):=time&&var(6):=7006

;強攻撃
trigger2 = NumHelper(7005)&&IsHelper(7005)
trigger2 = AnimElemTime(10)>=1
trigger2 = helper(7005),MoveContact
trigger2 = (root,var(59)<=0&&root,command="S_giant")||(root,var(59)>=1&&(root,var(46)&(Ceil(2.0**14))))
trigger2 = root,MoveType!=H||(root,stateno=[120,155])||Ceil(root,var(52)/100%10)>=2||Ceil(root,var(54)%10)>=5
trigger2 = var(5):=time&&var(6):=7070

;中攻撃
trigger3 = NumHelper(7005)&&IsHelper(7005)
trigger3 = AnimElemTime(10)>=1
trigger3 = helper(7005),MoveContact
trigger3 = (root,var(59)<=0&&root,command="M_giant")||(root,var(59)>=1&&(root,var(46)&(Ceil(2.0**13))))
trigger3 = root,MoveType!=H||(root,stateno=[120,155])||Ceil(root,var(52)/100%10)>=2||Ceil(root,var(54)%10)>=5
trigger3 = var(5):=time&&var(6):=7060

;前進
trigger4 = AnimTime=-1
trigger4 = RootDist x>20
trigger4 = FrontEdgeBodyDist>=125
trigger4 = var(5):=time&&var(6):=7011

;後退
trigger5 = AnimTime=-1
trigger5 = RootDist x<-20
trigger5 = var(5):=time&&var(6):=7012

;待機
trigger6 = AnimTime=-1
trigger6 = var(5):=time&&var(6):=7010

Persistent = 0
IgnoreHitPause = 1

[State 7050, END]
type = ChangeState
trigger1 = var(6)&&time>=var(5)+1
value = var(6)

Persistent = 0
IgnoreHitPause = 1


