;強制前進
trigger4 = (root,var(59)<=0&&(root,var(59)<=0&&root,command="front_giant")||(root,var(59)>=1&&(root,var(46)&(Ceil(2.0**11)))))||(root,var(59)>=1&&(root,var(46)&(Ceil(2.0**11))))
