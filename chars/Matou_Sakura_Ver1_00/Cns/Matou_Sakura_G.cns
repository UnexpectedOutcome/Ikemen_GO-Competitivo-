;==============================================================================
;■■影の巨人

	;var(0) = 
	;var(1) = 開幕フライング対策
	;var(2) = 
	;var(3) = 攻撃力　var(3) = Ceil(100+root,fvar(20)/40)　（700%で70%増加）
	;var(4) = 防御力　var(4) = Ceil(100-root,fvar(20)/120) （700%で23%減少）
	;var(5) = カウント
	;var(6) = ステート移動先記録
	;var(7) = 右腕ID
	;var(8) = 現在HP
	;var(9) = 最大HP = Ceil((聖杯ゲージ量＾2)/300) （700%で1634）
	;var(10)= 

	;fvar(3)= 対防御力補正

	;7004　召喚（開幕）
	;7005　召喚（通常）

	;7006　死亡

	;7010　待機
	;7011　前進
	;7012　後進
	;7013　強制後進

	;7015　振り向き

	;7025　ガード
	;7026　ガード戻り

	;7050　弱攻撃
	;7060　中攻撃
	;7070　強攻撃


;==============================================================================
;■開幕召喚済み処理

[Statedef 7004]
type = S
movetype= I
Physics = N

ctrl = 0
anim = 10039

movetype = A
physics = N
velset = 0,0

sprpriority = -3

[State -1, カメラ]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1,0

[State -1, 押し合い]
type = PlayerPush
trigger1 = 1
value = 0

[State -1, 影無し]
type = AssertSpecial
trigger1 = 1
Flag = Noshadow
IgnoreHitPause = 1

;==============================================================================
;■変数セット

[State -1, 最大HPセット]
type = VarSet
trigger1 = time=0
var(9) = Ceil((Ceil(root,var(51)/10000%10)*Ceil(root,var(51)/10000%10))/0.03+1)

[State -1, 現在HPセット]
type = VarSet
trigger1 = time=0
var(8) = IfElse(Ceil(root,var(52)/100%10)<=1&&var(9)>1634,1634,var(9))

[State -1, 攻撃力補正]
type = VarSet
trigger1 = time=0
var(3) = Ceil(100+Ceil(root,var(51)/10000%10)/0.1)

[State -1, 対防御力補正]
type = VarSet
trigger1 = time=0
fvar(3) = IfElse(enemynear(var(16)),Const(data.defence)>100,(enemynear(var(16)),Const(data.defence)/100),1.00)

[State -1, 防御力補正]
type = VarSet
trigger1 = time=0
var(4) = Ceil(100-Ceil(root,var(51)/10000%10)/0.3)

;==============================================================================
;■アーマー呼出

[State -1]
type = Helper
trigger1 = !NumHelper(9001)&&MoveType!=H

name = "Armor2"
stateno = 9001
ID = 9001
size.xscale = 0.5
size.yscale = 0.5
postype = p1
pos = 0,0
ownpal = 1

;------------------------------------------------------------------------------
;■分身対策

[State -1, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA, AA,AT,AP
Time = 1
IgnoreHitPause = 1

[State -1, 反射消滅]
type = HitOverride
trigger1 = 1
attr = SCA, AA,AT,AP
stateno = 5
time = 1
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;■ステート移動

[State 7004, END]
type = ChangeState
trigger1 = time>=0
trigger1 = NumHelper(9001)
value = 7010

Persistent = 0
IgnoreHitPause = 1


;==============================================================================
;■召喚

[Statedef 7005]
type = C
movetype= I
Physics = N

ctrl = 0
anim = 7020

movetype = A
physics = N
velset = 0,0

sprpriority = -3

[State -1, カメラ]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1,0

[State -1, 押し合い]
type = PlayerPush
trigger1 = 1
value = 0

[State -1, 影無し]
type = AssertSpecial
trigger1 = time<=72
Flag = Noshadow
IgnoreHitPause = 1

[State -1, SE]
type = PlaySnd
trigger1 = time=26
value = S45, 5

[State -1, SE]
type = PlaySnd
trigger1 = time=16
value = S70, 11

;▲時間停止
[State -1]
type = SuperPause
trigger1 = roundstate=2&&time=0
trigger1 = root,stateno=7000
Anim = -1
Time = 39
MoveTime = 39
P2DefMul = 1
Darken = 0
IgnoreHitPause = 1

;==============================================================================
;■変数セット

[State -1, HPセット]
type = VarSet
trigger1 = time=0
var(9) = IfElse((Ceil(root,var(52)%10)=1||Ceil(root,var(52)%10)=3)&&RoundState<=1,Ceil((Ceil(root,var(51)/10000%10)*Ceil(root,var(51)/10000%10))/0.03+1),Ceil((root,fvar(20)/4)*(root,fvar(20)/4)/300))

[State -1, 現在HPセット]
type = VarSet
trigger1 = time=0
var(8) = IfElse(Ceil(root,var(52)/100%10)<=1&&var(9)>1634,1634,var(9))

[State -1, 攻撃力補正]
type = VarSet
trigger1 = time=0
var(3) = IfElse((Ceil(root,var(52)%10)=1||Ceil(root,var(52)%10)=3)&&RoundState<=1,Ceil(100+Ceil(root,var(51)/10000%10)/0.1),Ceil(100+root,fvar(20)/40))

[State -1, 補正上限]
type = VarSet
trigger1 = Ceil(root,var(52)/100%10)<=1&&var(3)>170
var(3) = 170

[State -1, 対防御力補正]
type = VarSet
trigger1 = time=0
fvar(3) = IfElse(enemynear(var(16)),Const(data.defence)>100,(enemynear(var(16)),Const(data.defence)/100),1.00)

[State -1, 防御力補正]
type = VarSet
trigger1 = time=0
var(4) = IfElse((Ceil(root,var(52)%10)=1||Ceil(root,var(52)%10)=3)&&RoundState<=1,Ceil(100-Ceil(root,var(51)/10000%10)/0.3),Ceil(100-root,fvar(20)/120))

[State -1, 補正上限]
type = VarSet
trigger1 = Ceil(root,var(52)/100%10)<=1&&var(3)<77
var(3) = 77

;■聖杯ゲージ
[State -1, スイッチ]
type = ParentVarSet
triggerall = roundstate=2
triggerall = time=[0,55]
trigger1 = root,stateno=7000||Ceil(root,var(52)/100%10)<=1

var(25) = root,var(25)+(1*!(root,var(25)&(1)))

[State -1, 消費]
type = ParentVarAdd
triggerall = roundstate=2
triggerall = time=[0,55]
trigger1 = root,stateno=7000||Ceil(root,var(52)/100%10)<=1
fvar(20) = -50

;==============================================================================
;■アーマー呼出

[State -1]
type = Helper
trigger1 = !NumHelper(9001)&&MoveType!=H

name = "Armor2"
stateno = 9001
ID = 9001
size.xscale = 0.5
size.yscale = 0.5
postype = p1
pos = 0,0
ownpal = 1

;------------------------------------------------------------------------------
;■ダメージ計算

[State -1, ダメージ]
type = VarAdd
trigger1 = NumHelper(9001)
trigger1 = Helper(9001),GetHitVar(damage)
trigger1 = roundstate=2
var(8) = -1*(abs(Ceil(var(4)*Helper(9001),GetHitVar(damage)/100)-1))
IgnoreHitPause = 1

;■ヒットフラッシュ

[State -1, 反転]
type = PalFX
triggerall = roundstate=2
trigger1 = NumHelper(9001)
trigger1 = Helper(9001),GetHitVar(damage)
time = 2
invertall = 1
color = 0
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;■分身対策

[State -1, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA, AA,AT,AP
Time = 1
IgnoreHitPause = 1

[State -1, 反射消滅]
type = HitOverride
trigger1 = 1
attr = SCA, AA,AT,AP
stateno = 5
time = 1
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;■ステート移動

[State 7005, セット]
type = null

;死亡
trigger1 = RoundState>=2&&var(8)<=0
trigger1 = var(5):=time&&var(6):=7006

;前進
trigger2 = RoundState>=2&&AnimTime=-1
trigger2 = RootDist x>20
trigger2 = FrontEdgeBodyDist>=125
trigger2 = var(5):=time&&var(6):=7011

;後退
trigger3 = RoundState>=2&&AnimTime=-1
trigger3 = RootDist x<-20
trigger3 = var(5):=time&&var(6):=7012

;待機
trigger4 = AnimTime=-1
trigger4 = var(5):=time&&var(6):=7010

Persistent = 0
IgnoreHitPause = 1

[State 7005, END]
type = ChangeState
trigger1 = var(6)&&time>=var(5)+1
value = var(6)

Persistent = 0
IgnoreHitPause = 1


