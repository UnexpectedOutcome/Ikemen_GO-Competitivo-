trigger4 = RootDist x<-20
trigger4 = var(5):=time&&var(6):=7012

;待機
trigger5 = AnimTime=-1
trigger5 = var(5):=time&&var(6):=7010

Persistent = 0
IgnoreHitPause = 1

[State 7070, END]
