trigger9 = FrontEdgeBodyDist>=125
trigger9 = var(5):=time&&var(6):=7011

;後退
trigger10 = RootDist x<-20
trigger10 = var(5):=time&&var(6):=7012

Persistent = 0
IgnoreHitPause = 1

