; Common state file for M.U.G.E.N beta 2002.04.14

;==============================================================================
;■Stand（立ちポーズ）

[Statedef 0]
type = S
physics = S
sprpriority = 0

;■分身ヘルパー消し
[State -1]
type = DestroySelf
trigger1 = IsHelper
IgnoreHitPause = 1

;■フライング判定
[State -1]
type = NotHitBy
trigger1 = NumEnemy>0
trigger1 = NumHelper(20000)>=1
value = SCA, AA,AT,AP
time = 1

[State -1]
type = NotHitBy
triggerall = ctrl=0||RoundState<=1
triggerall = ((PrevStateNo=[190,194])||PrevStateNo=5900)&&StateNo=0
trigger1 = Ceil(var(53)/1000%10)=0
trigger2 = Ceil(var(53)/1000%10)>=1
trigger2 = NumEnemy>0
trigger2 = !((!(var(58)&(1))||!(enemy,TeamMode=simul))&&(var(58)&(128)))
value = SCA, AA,AT,AP
time = 1

[State -1]
type = HitOverride
triggerall = ctrl=0||RoundState<=1
triggerall = ((PrevStateNo=[190,194])||PrevStateNo=5900)&&StateNo=0
trigger1 = Ceil(var(53)/1000%10)>=1
trigger1 = NumEnemy>0
trigger1 = (!(var(58)&(1))||!(enemy,TeamMode=simul))&&(var(58)&(128))
attr = SCA, AA,AT,AP
stateno = 1
time = 1
IgnoreHitPause = 1

;---------------------------------------------------------------------------
;■CCC勝利フラグ

[State -1, オフ]
type = null
trigger1 = RoundState<=2
trigger1 = var(25):=(var(25)|Ceil(2.0**25))-(Ceil(2.0**25))||1
IgnoreHitPause = 1

[State -1, 透明]
type = AssertSpecial
trigger1 = RoundState=[3,4]
trigger1 = (var(25)&(Ceil(2.0**25)))
flag = invisible
IgnoreHitPause = 1

;---------------------------------------------------------------------------
;■立ちポーズ変更

[State 0]
type = ChangeAnim
triggerall = Ceil(var(52)/100%10)=0
trigger1 = Anim!=3&&Anim!=5
trigger2 = Anim=5&&Animtime=0
value = 3;0	;◆改修中

[State 0]
type = ChangeAnim
triggerall = Ceil(var(52)/100%10)=1
trigger1 = Anim!=1&&Anim!=5
trigger2 = Anim=5&&Animtime=0
value = 1

[State 0]
type = ChangeAnim
triggerall = Ceil(var(52)/100%10)>=2
trigger1 = Anim!=2&&Anim!=5
trigger2 = Anim=5&&Animtime=0
value = 2

;---------------------------------------------------------------------------

[state 0, 背面被攻撃時振り向き]
type = Turn
triggerall = (teammode=single)||(teammode=turns)
triggerall = P2Dist X<0
triggerall = NumEnemy>0
trigger1 = enemynear(var(16)),hitdefattr=SCA,AA,AT,AP
trigger2 = enemynear(var(16)),numproj>0||enemynear(var(16)),numhelper>0
trigger2 = InGuardDist

[State 0, 2]
type = VelSet
trigger1 = time=0
y = 0

[State 0, 3]
type = VelSet
trigger1 = abs(vel x)<2
trigger2 = time=4
x = 0

;---------------------------------------------------------------------------

[State 0, END]
type = ChangeState
trigger1 = (var(49)&(Ceil(2.0**29)))
value = 5035

[State 0, END]
type = ChangeState
trigger1 = alive=0
value = 5050

;==============================================================================
;■フライング対策

[Statedef 1]
type = S
physics = S
sprpriority = 0

[State -1]
type = null
trigger1 = 1
trigger1 = var(54):=var(54)+3
trigger1 = var(54):=Ceil(var(54)%10)
trigger1 = var(54):=var(54)+400

[State 1, END]
type = ChangeState
trigger1 = 1
value = 0

