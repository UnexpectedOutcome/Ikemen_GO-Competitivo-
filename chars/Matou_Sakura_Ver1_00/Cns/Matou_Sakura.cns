;■基本設定

[Data]
;■基本体力
life = 1000

;■基本パワーゲージ
Power = 7000

;■基本攻撃力
attack = 85

;■基本防御力
defence = 100

;■L時防御力補正
fall.defence_up = 80

;■変数引継ぎ
IntPersistIndex = 27
FloatPersistIndex = 20

;■未使用
sparkno = 2
guard.sparkno = 40
liedown.time = 50
airjuggle = 100
KO.echo = 0

;■音量調整
volume = 50

;==============================================================================

[Size]
xscale = 0.50			;水平方向の縮尺（通常1）
yscale = 0.50			;垂直方向の縮尺（通常1）
ground.back = 18		;キャラの幅(後方、地上)
ground.front = 18		;キャラの幅(前方、地上)
air.back = 22			;キャラの幅(後方、空中)
air.front = 14			;キャラの幅(前方、空中)
height = 70			;飛び越されるキャラの高さ
attack.dist = 190		;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 90		;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 1		;上で設定した縮尺を飛び道具にも適用するか（1でON） 
head.pos = -5, -96		;頭の大体の座標
mid.pos = -5, -70		;体の中心の大体の座標
shadowoffset = 2		;影の垂直方向のオフセット
draw.offset = 0, 0		;（未使用）

[Velocity]
walk.fwd = 1.45			;前進の速度
walk.back = -0.90		;後退の速度
jump.neu = 0, -8.85		;垂直ジャンプの速度
jump.back = -1.95		;後ジャンプの速度
jump.fwd = 2.25			;前ジャンプの速度
;run.fwd = 0, 0			;（未使用）前ダッシュの速度（ホップする時はyを-にする）
;run.back = 0, 0		;（未使用）後ダッシュの速度（ホップする時はyを-にする）

;runjump.back = 0, 0		;（未使用）
runjump.fwd = 2.35, -8.95	;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0, -7.85		;二段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -1.95		;二段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 2.25		;二段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 0			;（未使用）空中でジャンプする回数
airjump.height = 30		;空中でジャンプする最低限の高さ
yaccel = 0.42			;重力
stand.friction = 0.85		;立ち状態の摩擦係数
crouch.friction = 0.90		;屈み状態の摩擦係数

;==============================================================================
;■勝利リザルト画面台詞

[Quotes]
victory1 = "er?\nIs that English-speaking world it 's here?\nIt's embarrassing, but I am not good at English."

[ja.Quotes]
victory1 = "もう、買い物の途中なんですから邪魔しないでください。\n今度やったら本気で怒りますよ？"
victory2 = "いつまでもくよくよしてられません。\n日陰にもきれな花は咲くんです。"
victory3 = "むむむ？　なんか先輩に新しい女の人が近づいてる気配がします。\nこんなことしてないで早く帰らなくちゃ。"
victory4 = "ふう、これぐらいの魔術だったらわたしだって使えるんだから。\n今度はわたしが先輩を支えることだってできるんです！"
victory5 = "あれ？　やりすぎ！？\nちょっと悪いことしたんだなあって反省です。"
victory6 = "え？　お詫び？\nふふふ、最近は結構しあわせだなあって思うんです。\nわたし、願いゴトとか、もうないんですよ。"
victory7 = "あれ？　おかしいな・・・\nちょっと魔力をもらっただけなのに・・・\nあれ？　あれ？　なんで気絶しちゃってるのかな？"
victory8 = "そんな力を使って襲うなんて・・・\n神秘は秘匿しないとダメって習わなかったんですか？\nもう、後始末するほうの身にもなってくださいね。"
victory9 = "えっと、用件はなんだったんですか？"
victory10 = "ふふふ、邪魔者もやっつけたし\nセイバーさんは活躍できないし！　姉さんもいないし！！\nわたしの時代がはじまるんですね！！！"
victory11 = "え・・・えっと、あの、そのですね。\nわたしもやりすぎかなって思うんですけど、わたしの体が、まだ、その・・・\nもうすこし手加減できるように練習しておきますね。"
victory12 = "運動は、全般的にわたし苦手ですから、あはは・・・\nあ、でも試合ではけっこういいところまでいけるんですよ。\nわたしがんばってますから。"
victory13 = "悲しいです・・・\nなんでみんなで幸せになれないんでしょうね・・・"
victory14 = "ちょっとはしたなかったかな？\nあ、急がないと今日の夕食当番にまにあわない！？\nお先に失礼しますね。"
victory15 = "元気だからそうやって無駄に襲い掛かって来るんですね。\n歩けなくなるぐらいの怪我をしちゃえば・・・\nもうそういうことしませんよね？　ね？"
victory16 = "あなたって「わたしは悪くない」とか「こうするしかなかった」とか\n人のせいにばかりしてそうな顔してますね。\nだから弱いんですよ。"

