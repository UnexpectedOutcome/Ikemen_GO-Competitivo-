[Statedef -3]

;==============================================================================
;■バージョンチェック

[State -3]
type = null
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = RoundState=0&&NumEnemy>0
trigger1 = (var(25)&(Ceil(2.0**20)))=0
trigger1 = Ceil(var(1)/1000000%1000)=0
trigger1 = var(1):=Ceil(var(1)%1000000)+1000000*(100)
IgnoreHitPause = 1

;==============================================================================
;■リザレクション条件成立時のF1等突然死対応（!alive代用）

[State -3]
type = SelfState
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = (var(49)&(Ceil(2.0**28)))=0
triggerall = (var(49)&(Ceil(2.0**29)))
triggerall = (var(58)&(Ceil(2.0**25)))
triggerall = RoundState=2
trigger1 = GetHitVar(IsBound)=0
trigger1 = movetype!=H
trigger1 = ctrl=1
value = 5035
IgnoreHitPause = 1

;==============================================================================
;■ステート奪取コンボ測定

[State -3, 時間計測]
type = null
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = NumEnemy>0
trigger1 = var(22):=gametime
IgnoreHitPause = 1

[State -3, 蓄積回復]
type = null
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = Ceil(var(53)/1000%10)>=1
triggerall = NumEnemy>0
triggerall = (!(var(58)&(1))||!(enemy(0),TeamMode=simul))&&(var(58)&(2048))
trigger1 = MoveType!=H
trigger1 = var(21)>0&&gametime%12=0
trigger1 = var(21):=var(21)-1
IgnoreHitPause = 1

[State -3, P2攻撃属性測定リセット]
type = null
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = Ceil(var(53)/1000%10)>=1
trigger1 = (var(49)&(256))=256
trigger1 = var(49):=(var(49)|256)-(256)||1
IgnoreHitPause = 1

[State -3, P4攻撃属性測定リセット]
type = null
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = Ceil(var(53)/1000%10)>=1
trigger1 = (var(49)&(512))=512
trigger1 = var(49):=(var(49)|512)-(512)||1
IgnoreHitPause = 1

;==============================================================================
;■特殊ガード測定

[State -3, P2特殊ガード回数カウント]
type = null
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = Ceil(var(53)/1000%10)>=1
triggerall = (var(49)&(16|64))=(16|64)&&NumEnemy>0
triggerall = (!(var(58)&(1))||!(enemy(0),TeamMode=simul))&&(var(58)&(512))
trigger1 = Floor(var(56)/1000000)<999
trigger1 = enemy(0),GetHitVar(ctrltime)!=0
trigger1 = enemy(0),GetHitVar(hittime)>=0
trigger1 = enemy(0),ctrl=1
trigger1 = var(56):=var(56)+1000000
IgnoreHitPause = 1

[State -3, P4特殊ガード回数カウント]
type = null
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = Ceil(var(53)/1000%10)>=1
triggerall = (var(49)&(32|128))=(32|128)&&NumEnemy>1
triggerall = (!(var(58)&(1))||!(enemy(0),TeamMode=simul))&&(var(58)&(512))
trigger1 = Floor(var(56)/1000000)<999
trigger1 = enemy(1),GetHitVar(ctrltime)!=0
trigger1 = enemy(1),GetHitVar(hittime)>=0
trigger1 = enemy(1),ctrl=1
trigger1 = var(56):=var(56)+1000000
IgnoreHitPause = 1

[State -3, P2行動可能測定リセット]
type = null
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = Ceil(var(53)/1000%10)>=1
trigger1 = (var(49)&(16|64))=(16|64)&&NumEnemy>0
trigger1 = enemy(0),ctrl=1
trigger1 = var(49):=(var(49)|(16|64))-(80)||1
IgnoreHitPause = 1

[State -3, P4行動可能測定リセット]
type = null
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = Ceil(var(53)/1000%10)>=1
trigger1 = (var(49)&(32|128))=(32|128)&&NumEnemy>1
trigger1 = enemy(1),ctrl=1
trigger1 = var(49):=(var(49)|(32|128))-(160)||1
IgnoreHitPause = 1

;==============================================================================
;■アーマー呼出

[State -3]
type = Helper
triggerall = !IsHelper(1980)&&!IsHelper(7005)
triggerall = !NumHelper(9000)&&MoveType!=H&&Time=1
trigger1 = StateNo=[1100,1102]
trigger2 = StateNo=[1105,1106]
trigger3 = StateNo=[1190,1191]

name = "Armor"
StateNo = 9000
ID = 9000
size.xscale = 0.5
size.yscale = 0.5
postype = p1
pos = 0,0
ownpal = 1

