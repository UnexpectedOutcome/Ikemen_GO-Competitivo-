;■桜アイアス本体ヘルパー

[Statedef 3205]
type = A
movetype = I
Physics = N
Velset = 0,0
sprpriority = 0
Anim = 10039

;------------------------------------------------------------------------------

[State -1, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA, AA,AT,AP
Time = 1
IgnoreHitPause = 1

[State -1, 影無し]
type = AssertSpecial
trigger1 = 1
Flag = Noshadow
IgnoreHitPause = 1

[State -1, 位置固定]
type = PosFreeze
trigger1 = IsHelper(3205)
value = 1
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;■P1中心軸からP2接触判定までの距離

;□Dist観測セット
[State -1]
Type = null
;〓P2距離判定（P1地上＆同一方向）（P2がめくった時など）
trigger1 = enemynear(var(16)),facing=root,facing&&root,statetype!=A
trigger1 = var(40):=Ceil(((enemynear(var(16)),pos x*enemynear(var(16)),facing*-1)-(root,pos x*root,facing*-1))*-1)
trigger1 = var(40):=var(40)-IfElse(enemynear(var(16)),statetype=A,enemynear(var(16)),const(size.air.back),enemynear(var(16)),const(size.ground.back))
;〓P2距離判定（P1空中＆同一方向）（P1がめくった時など）
trigger2 = enemynear(var(16)),facing=root,facing&&root,statetype=A
trigger2 = var(40):=Ceil((enemynear(var(16)),pos x*enemynear(var(16)),facing)+(root,pos x*root,facing*-1))
trigger2 = var(40):=var(40)-IfElse(enemynear(var(16)),statetype=A,enemynear(var(16)),const(size.air.front),enemynear(var(16)),const(size.ground.front))
;〓P2距離判定（対面方向）（通常時）
trigger3 = enemynear(var(16)),facing*-1=root,facing
trigger3 = var(40):=Ceil((enemynear(var(16)),pos x*enemynear(var(16)),facing*-1)+(root,pos x*root,facing*-1))
trigger3 = var(40):=var(40)-IfElse(enemynear(var(16)),statetype=A,enemynear(var(16)),const(size.air.front),enemynear(var(16)),const(size.ground.front))
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;■花びら表示位置補正

[State -1, 本体追従]
type = BindToParent
trigger1 = IsHelper(3205)
trigger1 = root,var(22)=gametime
time = 1
pos = 58-Ceil(var(31)*2), -84
IgnoreHitPause = 1

[State -1, 本体追従]
type = BindToParent
triggerall = IsHelper(3205)
triggerall = root,var(22)=gametime
trigger1 = var(40)<0
trigger1 = root,movetype!=A
trigger1 = root,movetype=H||root,statetype!=A
time = 1
pos = enemynear(root,var(16)),facing*root,facing*-1*(58-Ceil(var(31)*2)), -84
IgnoreHitPause = 1

[state -1, 振り向き]
type = turn
triggerall = IsHelper(3205)
triggerall = root,var(22)=gametime
;〓P2> S> <P1 攻撃中OK
trigger1 = facing!=root,facing
trigger1 = enemynear(root,var(16)),facing!=root,facing
trigger1 = enemynear(root,var(16)),facing=facing
trigger1 = var(40)>=0
trigger1 = ParentDist X>=0
;〓<P2 S> <P1
trigger2 = facing!=root,facing
trigger2 = enemynear(root,var(16)),facing=root,facing
trigger2 = enemynear(root,var(16)),facing!=facing
trigger2 = var(40)>=0
trigger2 = ParentDist X>=0
trigger2 = root,movetype!=A
trigger2 = root,movetype=H||root,statetype!=A
;〓P2> S> P1>
trigger3 = facing=root,facing
trigger3 = enemynear(root,var(16)),facing=root,facing
trigger3 = enemynear(root,var(16)),facing=facing
trigger3 = var(40)<0
trigger3 = ParentDist X<0
trigger3 = root,movetype!=A
trigger3 = root,movetype=H||root,statetype!=A
;〓<P2 <S <P1
trigger4 = facing=root,facing
trigger4 = enemynear(root,var(16)),facing=root,facing
trigger4 = enemynear(root,var(16)),facing=facing
trigger4 = var(40)>=0
trigger4 = ParentDist X>=0
trigger4 = root,movetype!=A
trigger4 = root,movetype=H||root,statetype!=A
;〓<P2 <P1 S>
trigger5 = facing!=root,facing
trigger5 = enemynear(root,var(16)),facing=root,facing
trigger5 = enemynear(root,var(16)),facing!=facing
trigger5 = var(40)>=0
trigger5 = ParentDist X<0
trigger5 = root,movetype!=A
trigger5 = root,movetype=H||root,statetype!=A
;〓P2> S> <P1（着地時）
trigger6 = facing!=root,facing
trigger6 = enemynear(root,var(16)),facing!=root,facing
trigger6 = enemynear(root,var(16)),facing=facing
trigger6 = var(40)>=0
trigger6 = root,stateno=52
trigger6 = root,movetype!=A
trigger6 = root,movetype=H||root,statetype!=A
IgnoreHitPause = 1

[State -1, 展開収納時位置調整]
type = PosAdd
trigger1 = IsHelper(3205)
trigger1 = root,var(22)!=gametime
trigger1 = root,movetype=H&&root,stateno!=[120,159]
trigger1 = var(31)=[1,25]
