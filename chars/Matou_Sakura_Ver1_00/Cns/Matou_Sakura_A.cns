trigger8 = var(30):=1
trigger9 = root,time>=27
trigger9 = root,stateno=1110||root,stateno=1120||root,stateno=1130||root,stateno=1140||root,stateno=1150||root,stateno=1160
trigger9 = var(31)>=1
trigger9 = var(30):=2
