trigger3 = root,stateno!=810		;□通常投げ除外
trigger3 = root,stateno!=[1100,1199]	;□テレポ系除外
trigger3 = root,stateno!=1530		;□対空投げ除外
trigger3 = root,stateno!=[1700,1799]	;□悪滅除外
trigger3 = root,stateno!=[1800,1899]	;□全地面投げ除外
