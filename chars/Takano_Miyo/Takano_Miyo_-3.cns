;■ここから３■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

[Statedef -3]

;これはジャンプ後とバックステップ後に着地音を鳴らすコントローラです。
[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ後の着地
trigger2 = stateno = 106 ;バックステップ後の着地
value = s6, 1

;■Life回復タイミング
[State -3]
type =lifeadd
trigger1 = var(56)>=1
Trigger1 = GameTime % 9 = 0
trigger1 = lose = 0
value = 1

;■AI関係■■■■■■■■■■■■■■■■■■■■■■■■


;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;切り替えし
;PrevStateNo = [120,159] PrevStateNo = [5000,5270] EnemyNear,HitDefAttr = SCA,NT,ST,HT;投げ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

;■固めに対抗
[State -3]
Type     = ChangeState
Value    = 1800
TriggerAll = RoundState = 2
Triggerall = var(59)!=0
Triggerall = StateType != A
;Triggerall = EnemyNear,HitDefAttr = SCA, NT, ST, HT
;Triggerall = EnemyNear,StateType != L
;Triggerall = EnemyNear,MoveType = A
TriggerAll = InGuardDist
Trigger1 = Ctrl
Trigger1 = P2BodyDist X >=100
;Trigger1 = P2BodyDist Y >= -150
Trigger1 = Random <= var(59)*30






[State -3,かかと落とし攻撃]
Type = ChangeState
Value = 1800
TriggerAll = RoundState = 2
TriggerAll = var(59)!=0
TriggerAll = StateType = A
TriggerAll = EnemyNear,StateType != L
TriggerAll = EnemyNear,MoveType = A
TriggerAll = InGuardDist
TriggerAll = P2BodyDist X-EnemyNear,vel x*3+vel x*3 = [0,80]
TriggerAll = P2BodyDist Y-EnemyNear,vel y*3+vel y*3 = [-30,60]
Trigger1 = Ctrl || ((StateNo=110||StateNo=115)&&Time>=6)
Trigger1 = Random <= var(59)*30


;■避け
[State -3]
Type     = ChangeState
Value    = 1000
Triggerall = var(59)!=0
TriggerAll = StateType != A
TriggerAll = Ctrl
;Triggerall = (backedgebodydist>61&&(EnemyNear,StateNo=[200,699])) || EnemyNear,HitDefAttr = SCA,NT,ST,HT
Triggerall = EnemyNear,P2BodyDist y = [-100,0]
;TriggerAll = EnemyNear,vel x <= 2
Triggerall = EnemyNear,MoveType = A
;triggerall = EnemyNear,Time >= 25-var(59)
;Triggerall = prevstateNo !=1000
TriggerAll = InGuardDist
;trigger1 = EnemyNear,Time >=0
;trigger1 = PrevStateNo = [5000,5270]
;trigger2 = PrevStateNo = [120,159]
;Trigger1 = prevstateNo !=1000
;Trigger1 = stateNo !=1000
trigger1 = Random <= var(59)*1

