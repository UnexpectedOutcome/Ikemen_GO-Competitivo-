;■攻撃力変化■■■■■■■■■■■■■■■■
;■ヒートまたは一度敗北時に攻撃力 10% UP
[State -3]
type = AttackMulSet
trigger1 = var(50) !=0
trigger2 = var(56) !=0
value = 1.1

;■攻撃力UP解除
[State -3]
type = AttackMulSet
trigger1 =var(56) =0
trigger1 = var(50) =0
value = 1

;■根性値（防御力変化）■■■■■■■■■■■■■■■■
[State -1, DefenceMulSet]
Type = DefenceMulSet
Trigger1 = Life <= 800
Trigger1 = Life >= 601
Value = 0.9-((var(50)!=0)*0.1)
IgnoreHitPause = 1

[State -1, DefenceMulSet]
