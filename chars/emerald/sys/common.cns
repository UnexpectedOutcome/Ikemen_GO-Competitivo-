;---------------------------------------------------------------------------
;Stand
[Statedef 0]
type = S
physics = S
sprpriority = 2

[State 0]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && !AnimTime
value = 0

[State 0]
type = PosSet
trigger1 = Pos Y != 0
y = 0

[State 0]
type = VelSet
trigger1 = !Time
y = 0

[State 0]
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0]
type=turn
triggerall=numenemy
trigger1=enemynear(numenemy>1&&enemynear,alive=0),facing=-facing
trigger1=frontedgedist<enemynear(numenemy>1&&enemynear,alive=0),backedgedist
trigger2=enemynear(numenemy>1&&enemynear,alive=0),facing=facing
trigger2=frontedgedist<enemynear(numenemy>1&&enemynear,alive=0),frontedgedist
ignorehitpause = 1

[State 0]
type = AfterImageTime
trigger1 = !time
time = 1

[State 0]
type = SelfState
triggerall = !ishelper
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
;Stand to Crouch
[Statedef 10]
type = C
physics = C
anim = 10

[State 10]
type = PosSet
trigger1 = Pos Y != 0
y = 0

[state 10]
type = VelSet
trigger1 = !time
y = 0

[State 10]
type = VelSet
trigger1 = abs(vel x)<Const(movement.crouch.friction.threshold)
x = 0

[State 10]
type = VelMul
trigger1 = !time
x = 0.75

[State 10]
type=turn
triggerall=numenemy
trigger1=enemynear(numenemy>1&&enemynear,alive=0),facing=-facing
trigger1=frontedgedist<enemynear(numenemy>1&&enemynear,alive=0),backedgedist
trigger2=enemynear(numenemy>1&&enemynear,alive=0),facing=facing
trigger2=frontedgedist<enemynear(numenemy>1&&enemynear,alive=0),frontedgedist
ignorehitpause = 1

[State 10]
type = SelfState
trigger1 = !AnimTime
value = 11

;---------------------------------------------------------------------------
;Crouching
[Statedef 11]
type = C
physics = C

[state 11]
type = ChangeAnim
trigger1 = Anim != 11 && Anim != 6
trigger2 = Anim = 6 && !AnimTime
value = 11

[State 11]
type = PosSet
trigger1 = Pos Y != 0
y = 0

[state 11]
type = VelSet
trigger1 = abs(vel x)<Const(movement.crouch.friction.threshold)
x = 0

[State 11]
type=turn
triggerall=numenemy
trigger1=enemynear(numenemy>1&&enemynear,alive=0),facing=-facing
trigger1=frontedgedist<enemynear(numenemy>1&&enemynear,alive=0),backedgedist
trigger2=enemynear(numenemy>1&&enemynear,alive=0),facing=facing
trigger2=frontedgedist<enemynear(numenemy>1&&enemynear,alive=0),frontedgedist
ignorehitpause = 1

[State 11]
type = SelfState
triggerall = !var(59)
trigger1 = command != "holddown"
value = 12

;---------------------------------------------------------------------------
;Crouch to Stand
[Statedef 12]
type = S
physics = S
anim = 12

[State 12]
type = PosSet
trigger1 = Pos Y != 0
y = 0

[state 12]
type = VelSet
trigger1 = !time
x = 0

[State 12]
type=turn
triggerall=numenemy
trigger1=enemynear(numenemy>1&&enemynear,alive=0),facing=-facing
trigger1=frontedgedist<enemynear(numenemy>1&&enemynear,alive=0),backedgedist
trigger2=enemynear(numenemy>1&&enemynear,alive=0),facing=facing
trigger2=frontedgedist<enemynear(numenemy>1&&enemynear,alive=0),frontedgedist
ignorehitpause = 1

[State 12]
type = SelfState
trigger1 = !AnimTime
value = 0

;---------------------------------------------------------------------------
;Walk
[Statedef 20]
type = S
physics = S

[State 20]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && !AnimTime
value = 20

[State 20]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && !AnimTime
value = 21

[State 20]
type = VelSet
triggerall = !var(59)
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20]
type = VelSet
triggerall = !var(59)
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[state 20]
type = PosSet
trigger1 = !ishelper
y = 0

[state 20]
type = SelfState
triggerall = !var(59)
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
value = 0
ctrl = 1

[State 20]
type = SelfState
triggerall = var(59)
trigger1 = P2BodyDist X <= 45
trigger2 = enemy,movetype = A && P2BodyDist X <= 70
trigger3 = roundstate = 3
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Jump Start
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0

[State 40, snd]
type = PlaySnd
trigger1 = !time
value = S40,0
volumescale = 255

[State 40, dust1]
type = Explod
triggerall = PlayerIDExist(ID)
triggerall = !ishelper
trigger1 = !time
anim = 6042
pos = 0,3
postype = p1
scale = 0.5,0.5
facing = 1
bindtime = 1
removetime = -2
sprpriority = 3
ownpal = 1
trans = add
removeongethit = 1
ignorehitpause = 1

[State 40, dust2]
type = Explod
triggerall = PlayerIDExist(ID)
triggerall = !ishelper
trigger1 = !time
anim = 6042
pos = 0,3
postype = p1
scale = 0.5,0.5
facing = -1
bindtime = 1
removetime = -2
sprpriority = 3
ownpal = 1
trans = add
removeongethit = 1
ignorehitpause = 1

[State 40, AI]
type = VarSet
trigger1 = var(59)
sysvar(1) = ifelse((enemynear,movetype!=A || backedgebodydist<=10),1,ifelse((enemynear,movetype=A),-1,0))

[State 40, var]
type = VarSet
trigger1 = !var(59)
sysvar(1) = ifelse(!time,0,ifelse(command="holdfwd",1,ifelse(command="holdback",-1,sysvar(1))))

[State 40, vel]
type = VelSet
trigger1 = !AnimTime
x = ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, Self]
type = SelfState
trigger1 = !AnimTime
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;Air Jump
[Statedef 45]
type = A
physics = N
ctrl = 0
velset = 0,0

[State 45, snd]
type = PlaySnd
trigger1 = !time
value = S40,0
volumescale = 255

[State 45, anim]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, anim]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, AI]
type = VarSet
trigger1 = var(59)
sysvar(1) = ifelse((enemynear,movetype!=A || backedgebodydist<=10),1,ifelse((enemynear,movetype=A),-1,0))

[State 45, var]
type = VarSet
trigger1 = !var(59)
sysvar(1) = ifelse(!time,0,ifelse(command="holdfwd",1,ifelse(command="holdback",-1,sysvar(1))))

[State 45, vel]
type = VelSet
trigger1 = time = 2
x = ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 45, self]
type = selfstate
trigger1 = time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;Jump Up
[Statedef 50]
type = A
physics = A
anim = ifelse((vel x)=0,41,ifelse((vel x)>0,42,43))

[State 50, var]
type = VarSet
trigger1 = !time
sysvar(1) = 0

[State 50, anim]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim+3)
value = Anim+3
persistent = 0

[State 50, transition]
type = PosAdd
trigger1 = Vel Y > 0
x = Vel X
persistent = 0

;---------------------------------------------------------------------------
;Jump Down (empty state for compatibility)
[Statedef 51]
type = A
physics = A

[State 51, null]
type = Null
trigger1 = 1

