


; Stand
[Statedef 0]
type = S
physics = S
sprpriority = Var(5)
facep2 = 1


[State 0]
type = DestroySelf
trigger1 = IsHelper = 1

[State -2]
type              = Trans
trigger1          = IsHelper = 0
trigger1          = NumHelper(170) != 0
trans             = AddAlpha
alpha             = 0,256
ignorehitpause    = 1
[State -2]
type              = AssertSpecial
trigger1          = IsHelper = 0
trigger1          = NumHelper(170) != 0
flag              = Invisible
ignorehitpause    = 1
[State -2]
type              = ChangeAnim
trigger1          = IsHelper = 0
trigger1          = NumHelper(170) != 0
value             = 99999
ignorehitpause    = 1







[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 300 + (Var(48)/10%10=1)*10000 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 300 + (Var(48)/10%10=1)*10000

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3]
type = VelMul
trigger1 = 1
x = 0.75

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050



