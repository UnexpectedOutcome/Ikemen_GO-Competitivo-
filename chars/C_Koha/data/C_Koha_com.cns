;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 1


[State 0]
type = DestroySelf
trigger1 = IsHelper = 1




[State 100]
type              = PlaySnd
trigger1          = Time = 0
value             =s20,14
channel           = 1
persistent        = 0


[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = Time >= 10
trigger1 = command != "holdfwd"
trigger2 = Time >= 60
value = 0

