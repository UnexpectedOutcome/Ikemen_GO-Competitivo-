;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 5000]
type    = U
movetype= H
physics = U
velset = 0,0
anim = 5000
sprpriority = Var(5)

[State 5000]
type              = PlaySnd
trigger1          = Time = 0
value             =s0,13
channel           = 1
persistent        = 0


[State 0]
type = DestroySelf
trigger1 = IsHelper = 1




[State 5000, 1]
type = ChangeAnim
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5000) + GetHitVar(animtype)          ;5010) + GetHitVar(animtype)

[State 5000, 2]
type = ChangeAnim
trigger1 = GetHitVar(animtype) = [3,5]
value = 5002  ;5030

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 5001 ;HITG_SLIDE

[State 5000, 7]
type = ChangeState
trigger1 = HitShakeOver
value = 5001;5030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITG_SLIDE
[Statedef 5001]
type    = U
movetype= H
physics = U

[State 0]
type = DestroySelf
trigger1 = IsHelper = 1





[State 5001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = GetHitVar(fall) = 0
value = 5005 + GetHitVar(animtype)  ; + (GetHitVar(groundtype)=2)*10


[State 5001, 2]
type = ChangeAnim
trigger1 = GetHitVar(fall) = 1
trigger1 = AnimTime = 0
value = 5007

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
