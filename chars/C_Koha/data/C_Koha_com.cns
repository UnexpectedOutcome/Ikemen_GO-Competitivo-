type    = S
movetype= H
physics = N
velset = 0,0



[State 0]
type = DestroySelf
trigger1 = IsHelper = 1




[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150

[State 150, 2]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = IsHelper = 0
value = 151 + 2*(command = "holddown")

[State 150, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 150, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3





[State 150]
type = PlayerPush
trigger1 = IsHelper(150) = 1
value = 0

[State 150]
type = BindToRoot
trigger1 = IsHelper(150) = 1
pos = 0,-1
[State 150]
type = StateTypeSet
trigger1 = IsHelper(150) = 1
statetype= S
physics = N
movetype = I
[State 150]
type = HitBy
trigger1 = IsHelper(150) = 1
trigger1 = Root,MoveType!= H
trigger1 = Root,StateNo != [5000,5001]
value = S,AA,AP
[State 150]
type = Null;NotHitBy
trigger1 = IsHelper(150) = 1
value = SC,AA,AP,AT

[State 150]
type = ChangeAnim
trigger1 = IsHelper(150) = 1
value = Root,Anim+1000
elem = Root,AnimElemNo(0)









