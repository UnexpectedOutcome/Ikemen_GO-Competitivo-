;---------------------------------------------------------------------------
[Statedef -2]
;---------------------------------------------------------------------------
[state -2,浮いた時の処理]
type = PosSet
trigger1 = pos y != 0
trigger1 = stateno = 0
trigger1 = ctrl = 1
x = (pos x)
y = 0

[State -2, StopSnd]
type = StopSnd
trigger1 = Movetype = H
channel = 10
IgnoreHitPause = 1

[State -2, AIタッグ用生死判別]
Type = VarSet
trigger1 = RoundState = 2
var(30) = 0 + (NumEnemy = 2 && EnemyNear(0),life <= 0||EnemyNear(0),stateno = 5150)
IgnoreHitPause = 1

[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 1
text = "V1=%d,V5=%d,FV33=%f,P2Y=%d,P2X=%d"
params = Var(1),var(5),fvar(33),ceil(P2BodyDist Y),floor(P2BodyDist X)
ignorehitpause = 1
;---------------------------------------------------------------------------
[State -2,7P～10P]
type = PowerAdd
trigger1 = (palno=[7,10]) || palno=12
trigger1 = GameTime%10=0
value = 20 + ((palno=12)*30)
pausemovetime  = 99999
supermovetime  = 99999
ignorehitpause = 1

[State -2,11P]
type = PowerSet
trigger1 = palno = 11
value = powermax
pausemovetime  = 99999
supermovetime  = 99999
ignorehitpause = 1

[state -2,MulSet]
type = DefenceMulSet
trigger1 = palno=12
value = 0.8

[state -2,攻撃力補正]
type = AttackMulSet
trigger1 = palno=12
value = 1.5

[state -2,攻撃力補正]
type = varset
trigger1 = palno=12
fvar(0) = 1.5

[state -2,攻撃力補正];終了
type = varset
trigger1 = palno!=12
fvar(0) = 1.0

[State -2, 点滅]
type = PalFX 
triggerall = GameTime%2 = 0
trigger1 = palno=12
time = 1
add = 60,60,60
IgnoreHitPause = 1
;---------------------------------------------------------------------------
;ジャンプの処理
;---------------------------------------------------------------------------
[State -2]
type = varset
trigger1 = stateno = 52
trigger2 = MoveType = H
v = 2
value = 0

[State -2]
type = varset
trigger1 = stateno = [100,101]
v = 2
value = 1

[State -2]
type = varset
trigger1 = command = "down" || command = "holddown"
v = 2
value = 5

[State -2]
type = varadd
triggerall = var(2)>0
trigger1 = statetype != A && stateno != 40 && (stateno !=[100,101])
v = 2
value = -1
ignorehitpause = 1
;---------------------------------------------------------------------------
;ダメージボイス
;---------------------------------------------------------------------------
[State -2, 4]
type = PlaySnd
triggerall = random < 700
triggerall = Time = 1
triggerall = alive = 1
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5070
trigger4 = stateno = 5100
value = s5000,(0+random%4)
