[Statedef -1];必須項目
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;コンボ用変数
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1, Combo]
type = VarSet
triggerall = !IsHelper
trigger1 = 1
var(1) = 0

[State -1, Combo];通常技キャンセル
type = VarSet
triggerall = !IsHelper
trigger1 = stateno = 200 && AnimElemTime(2) > 0 && AnimElemTime(3) < 2
trigger2 = stateno = 215 && AnimElemTime(3) > 0 && AnimElemTime(4) < 0
trigger3 = stateno = 230 && AnimElemTime(3) > 0 && AnimElemTime(4) < 0
trigger4 = stateno = 245 && AnimElemTime(4) > 0 && AnimElemTime(5) < 2
trigger5 = stateno = 400 && AnimElemTime(2) > 0 && AnimElemTime(3) < 2
trigger6 = stateno = 410 && AnimElemTime(4) > 0 && AnimElemTime(6) < 0
trigger7 = stateno = 430 && AnimElemTime(2) > 0 && AnimElemTime(3) < 2
trigger8 = stateno = 440 && AnimElemTime(4) > 0 && AnimElemTime(5) < 2
var(1) = 1

[State -1, Combo];超必殺キャンセル
type = VarSet
triggerall = !IsHelper
trigger1 = stateno = 210 && AnimElemTime(4) > 0 && AnimElemTime(5) < 2
trigger2 = stateno = 240 && AnimElemTime(5) > 0 && AnimElemTime(6) < 2
trigger3 = stateno = 300 && AnimElemTime(6) > 0 && AnimElemTime(7) < 2
var(1) = 2

[State -1, Combo];スパキャン
type = VarSet
triggerall = !IsHelper
triggerall = var(47)
trigger1 = stateno = 1000 && AnimElemTime(2)>0 && AnimElemTime(5)<0
trigger2 = stateno = 1001 && AnimElemTime(2)>0 && AnimElemTime(5)<0
trigger3 = stateno = 1100 && AnimElemTime(5)>0 && AnimElemTime(6)<4
trigger4 = stateno = 1101 && AnimElemTime(5)>0 && AnimElemTime(6)<4
var(1) = 3
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;超必殺技
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1,2141236P];乱舞
type = ChangeState
value = 3200
triggerall = var(59)!
triggerall = !IsHelper && Alive
triggerall = statetype !=A
triggerall = power>=2000
triggerall = command = "2141236P"
trigger1 = ctrl || (stateno = [100,101])
trigger2 = var(1) = 1
trigger3 = var(1) = 2
trigger4 = var(1) = 3

[State -1,236236K];昇竜列破
type = ChangeState
value = 3000
triggerall = var(59)!
triggerall = !IsHelper && Alive
triggerall = statetype !=A
triggerall = power>=1000
triggerall = (command = "236236K")
trigger1 = ctrl || (stateno = [100,101])
trigger2 = var(1) = 1
trigger3 = var(1) = 2
trigger4 = var(1) = 3

[State -1,214214P];真・昇竜
type = ChangeState
value = 3100
triggerall = var(59)!
triggerall = !IsHelper && Alive
triggerall = statetype !=A
triggerall = power>=1000
triggerall = (command = "214214P")
trigger1 = ctrl || (stateno = [100,101])
trigger2 = var(1) = 1
trigger3 = var(1) = 2
trigger4 = var(1) = 3
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;必殺技
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1,623P];昇竜
type = ChangeState
value = 1000
triggerall = var(59)!
triggerall = !IsHelper
triggerall = Alive
triggerall = statetype !=A
triggerall = (command = "623P")
trigger1 = ctrl || (stateno = [100,105])
trigger2 = var(1) = 1

[State -1,236P];波動
type = ChangeState
value = 1100
triggerall = var(59)!
triggerall = !IsHelper
triggerall = Alive
triggerall = statetype !=A
triggerall = NumHelper(1100)<=0
triggerall = (command = "236P")
trigger1 = ctrl || (stateno = [100,105])
trigger2 = var(1) = 1

[State -1,214K];竜巻
type = ChangeState
value = 1200
triggerall = var(59)!
triggerall = !IsHelper
triggerall = Alive
triggerall = statetype !=A
triggerall = (command = "214K")
trigger1 = ctrl || (stateno = [100,105])
trigger2 = var(1) = 1
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;投げ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1,投げ]
type = ChangeState
value = 800
triggerall = var(59)!
triggerall = !IsHelper
triggerall = Alive
triggerall = StateType=S
trigger1 = command = "y" && command = "b"
trigger1 = ctrl
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;移動&特殊技関連
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1,ダッシュ]
type = ChangeState
value = 100
triggerall = var(59)!
triggerall = !IsHelper
triggerall = Alive
triggerall = StateType !=A
triggerall = (command = "FF") || (helper(10012+id),var(11)>0)
trigger1 = statetype = S
trigger1 = ctrl

[State -1,後ダッシュ]
type = ChangeState
value = 105
triggerall = var(59)!
triggerall = !IsHelper
triggerall = Alive
triggerall = StateType !=A
triggerall = (command = "BB") || (helper(10012+id),var(12)>0)
trigger1 = statetype = S
trigger1 = ctrl

[State -1,中段]
type = ChangeState
value = 300
triggerall = var(59)!
triggerall = !IsHelper
triggerall = Alive
triggerall = statetype !=A
triggerall = statetype=S
triggerall = command = "x"
triggerall = command = "holdfwd"
trigger1 = ctrl || (stateno = [100,101])

[State -1,リープ]
type = ChangeState
value = 310
triggerall = var(59)!
triggerall = !IsHelper
triggerall = Alive
triggerall = statetype !=A
triggerall = statetype=S
triggerall = command = "b"
triggerall = command = "holdfwd"
trigger1 = ctrl || (stateno = [100,101])

[State -1,足払い]
type = ChangeState
value = 320
triggerall = var(59)!
triggerall = !IsHelper
triggerall = Alive
triggerall = statetype !=A
triggerall = command = "b"
triggerall = command = "holdfwd"
triggerall = command = "holddown"
trigger1 = ctrl || (stateno = [100,101])
