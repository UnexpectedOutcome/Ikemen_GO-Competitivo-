;---------------------------------------------------------------------------
; 勝利ポーズ2ヘルパー
[Statedef 183]
type = A
ctrl = 0
sprpriority = -2

[State 183, 1]
type = ChangeAnim
triggerall = IsHelper(183) = 1
triggerall = root,var(3) = [0,14]
triggerall = SelfAnimExist(root,Anim)
trigger1 = Anim != root,var(3) + root,Anim
trigger2 = Anim = root,var(3) + root,Anim
trigger2 = AnimElemNo(0) != root,AnimElemNo(0)
value = root,Anim
elem = root,AnimElemNo(0)

[State 183, 2]
type = ChangeAnim
triggerall = IsHelper(184) = 1
triggerall = root,var(3) = [0,14]
triggerall = SelfAnimExist(root,var(3) + root,Anim + 1000)
trigger1 = Anim != root,var(3) + root,Anim + 1000
trigger2 = Anim = root,var(3) + root,Anim + 1000
trigger2 = AnimElemNo(0) != root,AnimElemNo(0)
value = root,var(3) + root,Anim + 1000
elem = root,AnimElemNo(0)

[State 183, 3]
type = ChangeAnim
triggerall = IsHelper(185) = 1
triggerall = root,var(3) = [0,14]
triggerall = SelfAnimExist(root,var(3) + root,Anim + 2000)
trigger1 = Anim != root,var(3) + root,Anim + 2000
trigger2 = Anim = root,var(3) + root,Anim + 2000
trigger2 = AnimElemNo(0) != root,AnimElemNo(0)
value = root,var(3) + root,Anim + 2000
elem = root,AnimElemNo(0)

[State 183, 4]
type = Sprpriority
triggerall = Time = 0
trigger1 = IsHelper(184) = 1
trigger2 = IsHelper(185) = 1
value = -3

[State 183, 5]
type = VelAdd
trigger1 = Vel X < 6
x = 0.4

[State 183, 6]
type = VelAdd
trigger1 = Vel Y > -9
y = -0.2

