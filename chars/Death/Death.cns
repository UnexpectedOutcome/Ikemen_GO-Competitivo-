triggerall = IsHelper(11000) = 1 || IsHelper(12000) = 1
trigger1 = var(7) = 0
trigger1 = fvar(2) != 0.75
trigger2 = var(7) = 1
trigger2 = fvar(2) != 1
fvar(2) = ifelse(var(7)=0,0.75,1)
IgnoreHitPause = 1

[State -2,防御力設定]
type = VarSet
triggerall = IsHelper(11000) = 1 || IsHelper(12000) = 1
trigger1 = var(7) = 0
trigger1 = fvar(3) != 2.25
trigger2 = var(7) = 1
trigger2 = fvar(3) != 1.8
fvar(3) = ifelse(var(7)=0,2.25,1.8)
IgnoreHitPause = 1

[State -2,被ダメージの補正時間のカウント]
type = VarAdd
trigger1 = IsHelper(11000) = 1 || IsHelper(12000) = 1
trigger1 = var(1) > 0
var(1) = -1
IgnoreHitPause = 1

[State -2,被ダメージの補正時間設定]
type = VarSet
triggerall = IsHelper(11000) = 1 || IsHelper(12000) = 1
triggerall = GetHitVar(damage) != 0
trigger1 = GetHitVar(fall) = 0
trigger1 = var(1) < GetHitVar(hitshaketime) + GetHitVar(hittime) + 1
trigger2 = GetHitVar(fall) = 1
var(1) = ifelse(GetHitVar(fall)=0,GetHitVar(hitshaketime)+GetHitVar(hittime)+1,60)
IgnoreHitPause = 1

[State -2,被ダメージの補正時間最大値設定]
type = VarSet
trigger1 = IsHelper(11000) = 1 || IsHelper(12000) = 1
trigger1 = var(1) != [0,60]
var(1) = 60
IgnoreHitPause = 1

[State -2,ダメージ計算]
type = VarAdd
trigger1 = IsHelper(11000) = 1 || IsHelper(12000) = 1
trigger1 = GetHitVar(damage) != 0
var(2) = ifelse(fvar(1)<1,ceil(fvar(3)*root,fvar(39)*GetHitVar(damage)*(1-fvar(1))),1)
IgnoreHitPause = 1

[State -2,補正値追加]
type = VarAdd
trigger1 = IsHelper(11000) = 1 || IsHelper(12000) = 1
trigger1 = var(1) > 0
trigger1 = GetHitVar(damage) != 0
fvar(1) = 4444/root,LifeMax*fvar(3)*GetHitVar(damage)*(1-fvar(1))*0.00125
IgnoreHitPause = 1

[State -2,補正値最大値設定]
type = VarSet
trigger1 = IsHelper(11000) = 1 || IsHelper(12000) = 1
trigger1 = fvar(1) > 1
fvar(1) = 1
IgnoreHitPause = 1

