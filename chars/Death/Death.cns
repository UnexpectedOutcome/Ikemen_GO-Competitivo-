walk.back    = -4.0
run.fwd      = 0,0
run.back     = 0,0
jump.neu     = 0,0
jump.back    = 0.0
jump.fwd     = 0.0
runjump.back = 0.0
runjump.fwd  = 0.0
airjump.neu  = 0,0
airjump.back = 0.0
airjump.fwd  = 0.0

