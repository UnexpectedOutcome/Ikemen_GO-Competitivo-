fall.defence_up   = 44
liedown.time      = 44
airjuggle         = 44
sparkno           = 0
guard.sparkno     = 0
KO.echo           = 0
volume            = 255
IntPersistIndex   = 59
FloatPersistIndex = 40

;---------------------------------------------------------------------------
; サイズ
