yscale           = 1.5
ground.back      = 10
ground.front     = 10
air.back         = 10
air.front        = 10
height           = 0
attack.dist      = 160
proj.attack.dist = 90
proj.doscale     = 1
head.pos         = 8,-116
mid.pos          = 4,-82
shadowoffset     = 0
draw.offset      = 0,0

;---------------------------------------------------------------------------
; 移動速度
