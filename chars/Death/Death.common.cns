; 通常立ち（振り返る動作の処理）
[Statedef 0]
movetype = I
physics  = N
sprpriority = -2

[State 0, 1]
type = DestroySelf
trigger1 = IsHelper = 1

[State 0, 2]
type = VarSet
trigger1 = var(14) != 2
trigger1 = PalNo != 6
trigger1 = PalNo != 12
var(14) = 2

[State 0, 3]
type = ChangeState
trigger1 = Life = 0
value = 5150

[State 0, 4]
Type = HitOverride
Trigger1 = 1
Attr = SCA, AA, AP
Time = -1
slot = 0
stateno = 1
IgnoreHitPause = 1

[State 0, 5]
type = StateTypeSet
trigger1 = StateType != A
trigger1 = RoundState <= 2
trigger2 = StateType != S
trigger2 = RoundState > 2
type = ifelse(roundstate>2,S,A)

[State 0, 6]
type = CtrlSet
trigger1 = Ctrl = 0
trigger1 = RoundState > 2
value = 1

[State 0, 7]
type = ChangeState
trigger1 = RoundState = 2
trigger1 = Ctrl = 1
value = ifelse(var(14)=2,1000,13000)
ctrl = 0

[State 0, 8]
type = ChangeAnim
trigger1 = Anim != 1000
trigger1 = var(14) = 2
trigger2 = Anim != 10000
trigger2 = var(14) < 2
value = ifelse(var(14)=2,1000,10000)

[State 0, 9]
type = VelSet
trigger1 = abs(vel x) < 0.1
x = 0

[State 0,10]
type = VelSet
trigger1 = abs(vel y) < 0.1
y = 0

[State 0,11]
type = VelMul
trigger1 = 1
x = 0.92
y = 0.92

[State 0,12]
type = PosSet
trigger1 = pos y > 30
trigger2 = pos y < -120
y = ifelse(pos y>30,30,-120)

[State 0,13]
type = Helper
trigger1 = var(14) = 0
trigger1 = NumHelper(11000) = 0
helpertype = player
pos = 0,0
postype = p1
name = "Slogra"
ID = 11000
stateno = 11010
sprpriority = 0
ownpal = 1
pausemovetime = 9999999999
keyctrl = 1

