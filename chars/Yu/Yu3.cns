[Statedef 256]
anim = 9999
ctrl = 0
[State ]
type=assertspecial
trigger1=ishelper(256)
flag=intro

[State ]
type=varset
triggerall=ishelper(256)
trigger1=!time  ;;  Map on Initiation to PalNo
var(21)=root,palno



[State ]
type=varset
triggerall=ishelper(256)
trigger1=var(21)<1||var(21)>18  ;;  Total Number of Palettes should be this number.
var(21)=1+(var(21)<1)*17


[State ]
type=varadd
triggerall=ishelper(256)
trigger1=!var(22)
trigger1=root,command="up"||root,command="down"
var(21)=1-(root,command="down")*2



[State ]
type=varadd
triggerall=ishelper(256)
trigger1=(root,command="up"||root,command="down")&&!var(22)||var(22)
var(22)=1


[State ]
type=varset
triggerall=ishelper(256)
trigger1=!time||var(22)>=11 ;;  A delay for the hold button commands because cycling will be way too fast without it.
var(22)=0

[State ]
type=remappal
trigger1=numhelper(256)
source=1,1
dest=1,helper(256),var(21)
;----
;IZANAGI
[State ]
type=varset
triggerall=ishelper(256)
trigger1=!time  ;;  Map on Initiation to PalNo
var(23)=1


[State ]
type=varset
triggerall=ishelper(256)
trigger1=var(23)<1||var(23)>18 ;;  Total Number of Palettes should be this number.
var(23)=1+(var(23)<1)*17


[State ]
type=varadd
triggerall=ishelper(256)
trigger1=!var(24)
trigger1=root,command="fwd"||root,command="back"
var(23)=1



[State ]
type=varadd
triggerall=ishelper(256)
trigger1=(root,command="fwd"||root,command="back")&&!var(24)||var(24)
var(24)=1


[State ]
type=varset
triggerall=ishelper(256)
trigger1=!time||var(24)>=11 ;;  A delay for the hold button commands because cycling will be way too fast without it.
var(24)=0

[State ]
type=remappal
trigger1=numhelper(256)
source=2,1
dest=2,helper(256),var(23)

[State ]
type=destroyself
triggerall=ishelper(256)
trigger1=root,command="a"||root,command="b"||root,command="c"||root,command="x"||root,command="y"||root,command="z"||root,command="s"||roundstate=2
trigger2=time >= 600
