;flag = unguardable

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 190+random%2
velset = 0,0

[State 0, Helper]
type = Helper
trigger1 = Time = 0
trigger1 = numhelper(256) > 0
helpertype = normal ;player
name = "Izanagi Pal Select"
ID = 255
stateno = 255
pos =-90,0
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 1
ownpal = 1
sprpriority = 1
supermovetime = 9999
pausemovetime = 9999

[State 5900, 3] ;Change palette
type = RemapPal
