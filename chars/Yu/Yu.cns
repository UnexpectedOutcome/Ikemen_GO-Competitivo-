;---------------------------------------------------------------------------
;                        Person 4 Arena Character 
;                          -Created By Magatsu Izanagi-
;                           Yu Narukami : Character
;                            Izanagi - Persona
;--------------------- Variable List ---------------------------------------
; Var(0) - StateDef
; Var(2) - Jump Variable Checker
; Var(3) - Guard/Movehit Variable
; Var(4) - Guard/Movehit Variable
; Var(7) - Velmul - For Air Dashes FWD
; Var(8) - Velmul - For Air Dashes BCK
; Var(9) - Custom Jump Variable for Landing
; Var(10) - Custom Death State Checker
; Var(11) - Axe System 
; Var(13) - Burst System
; Var(14) - Awakening Check Variable
; Var(16) - Chain Knuckle Counter Var
; Var(17) - All Out ATTACK Combo Checker
; Var(21) - Palette Select - Yu Narukami Var 1
; Var(22) - Palette Select - Yu Narukami Var 2
; Var(23) - Palette Select - Izanagi Var 1
; Var(24) - Palette Select - Izanagi Var 2
; Var(26) - Max Burst Checker
; Var(27) - Instant Kill Hit Checker
; Var(28) - Ins
; Var(29) - Instant Kill Win
; Var(30) - Movehit Checker - Movetype = H
; Var(32) - Hit Checker
;--------------------- Float Variable List ---------------------------------
;fvar(1) - Damage Dampener
;fvar(2) - Damage Dampener
;fvar(3) - Damage Dampener 
;fvar(4) - Damage Dampener 
;fvar(5) - Air Vel Data Recorder
;---------------------------------------------------------------------------
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 0
liedown.time = 60
airjuggle = 666
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volumescale = 100
IntPersistIndex = 1
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 60     ;Player width (back, ground)
ground.front = 64    ;Player width (front, ground)
air.back = 48        ;Player width (back, air)
air.front = 48       ;Player width (front, air)
height = 240         ;Height of player (for opponent to jump over)
attack.dist = 640    ;Default attack distance
proj.attack.dist = 360 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -8, -340 ;Approximate position of head
mid.pos = -10, -233  ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y). Recommended 0,0

[Velocity]
walk.fwd  = 6.5      ;Walk forward
walk.back = -6.2     ;Walk backward
run.fwd  = 19, 0   ;Run forward (x, y)
run.back = -14.7,-8.85 ;Hop backward (x, y)
jump.neu = 0,-33.4   ;Neutral jumping velocity (x, y)
jump.back = -7,-33.4 ;Jump back Speed (x, y)
jump.fwd = 7.6,-33.4     ;Jump forward Speed (x, y)
runjump.back = -7,-33.4 ;Running jump speeds (opt)
runjump.fwd = 10.2,-33.4    ;.
airjump.neu = 0,-30.5     ;.
airjump.back = -8      ;Air jump speeds (opt)
airjump.fwd = 8          ;.
air.gethit.groundrecover = -1,-23    ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = .5,.2     ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = 0,-24.5     ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -12       ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 12         ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = -16         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 6        ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 20 ;Minimum distance from ground before you can air jump (opt)
yaccel = 1.47       ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .85 ;Friction coefficient when crouching
stand.friction.threshold = 2          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .2        ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 100          ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -30 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 40   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -4  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = 1.52    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 60      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 80            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = 1.6              ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 48          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .2          ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**

[Quotes]
victory1 = "What? Sister-complex Kingpin?" 
victory2 = "It's only natural."
victory3 = "Looks like I won this time…"
victory4 = "I can't stop now."
victory5 = "I should leave them be..."
victory6 = "Calm down. You won't be able to win when you're that worked up."
victory7 = "Facing myself, hm…? It seems the time has come for me too."
victory8 = "The last time we went at each other was at the river… Haha, that brings back memories."
victory9 = "Her attacks were a lot more vicious than you'd expect… That was a close fight."
victory10 = "I couldn't read his movements at all… I'll get tripped up if I underestimate him."
victory11 = "If she was paying close attention to my moves, I'm not so sure I could win a second time…"
victory12 = "She has the same power of the Wild Card… This feels so strange…"
victory13 = "Make sure you take care of that Persona… It's your other self, after all."
victory14 = "Could the younger sister Margaret mentioned be…?"
;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State -2]
type = PlaySnd
trigger1 = !Time
value = S180,3
volume = 255
channel = -1

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = var(28) = 1
trigger1 = prevstateno = 10000
flag = nobardisplay
flag = globalnoshadow
flag = noFG
flag = nomusic
flag = timerfreeze
flag = noshadow
ignorehitpause = 1
persistent = 1

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181
;---------------------------------------------------------------------------
; Win pose 1
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0
anim = 180+random%4
velset = 0,0

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = var(28) = 1
trigger2 = var(29) = 1
flag = nobardisplay
flag = globalnoshadow
flag = noFG
flag = nomusic
flag = timerfreeze
flag = noshadow
flag = nojugglecheck
ignorehitpause = 1
persistent = 1

[State -2]
type = PlaySnd
triggerall = anim = 180
trigger1 = Time = 0
value = S180,0
volume = 255
channel = -1

[State -2]
type = PlaySnd
triggerall = anim = 181
trigger1 = Time = 0
value = S180,1
volume = 255
channel = -1

[State -2]
type = PlaySnd
triggerall = anim = 182
trigger1 = Time = 0
value = S180,2
volume = 255
channel = -1

[State -2]
