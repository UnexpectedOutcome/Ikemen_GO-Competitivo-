trigger1 = 1
value = 1
movecamera = 0,0
;ignorehitpause = 
;persistent = 

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = time <= 160
trigger1 = anim = 180
;flag = intro
;flag2 = invisible
flag3 = roundnotover
;ignorehitpause = 
;persistent = 
;-----------------------
flag = nobardisplay
;flag = noBG
;flag = noFG
;flag = nostandguard
