volume = 255
channel = -1

[State -2]
type = PlaySnd
triggerall = anim = 191
trigger1 = anim != 190
trigger1 = animelem = 35
value = S190,1
volume = 255
channel = -1

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
