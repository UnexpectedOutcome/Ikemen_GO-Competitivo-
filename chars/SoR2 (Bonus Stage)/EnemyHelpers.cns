;Obtainer's State
;Apple
[Statedef 8020]
type    = C
movetype= H
physics = N
velset = 0,0

[State 8020, NotHitBy]
type = NotHitBy
trigger1 = 1
value = ,AA,AP,AT
time = 2

[State 8020, NotHitBy]
type = NotHitBy
trigger1 = Time = 15
value2 = ,AA,AP,NT,ST
time = 60

;Recover 1/3 of Max Life
[State 8020, LifeAdd]
type = LifeAdd
trigger1 = Time = 1
trigger1 = LifeMax >= 1000
value = Ceil(LifeMax*0.33)
kill = 0
absolute = 1
ignorehitpause = 1

;Recover 334 life if max life is less than 1000
[State 8020, LifeAdd]
type = LifeAdd
trigger1 = Time = 1
trigger1 = LifeMax < 1000
value = 334
kill = 0
absolute = 1
ignorehitpause = 1

