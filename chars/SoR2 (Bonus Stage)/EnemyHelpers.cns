;Also contains some other states such as the Fake KO states.

;---------------------------------------------------------------------------
;PowerUp's State
[Statedef 8015]
type    = A
movetype= I
physics = N
;anim = 9500
velset = 0,0

[State 8015, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = invisible

;Recovery Sound
[State 8015, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
trigger1 = Anim = 2003 || Anim = 2004
value = 201,7

;1-Up Sound
[State 8015, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
trigger1 = Anim = 2000
value = 201,8

;Gain 10000 points if at max lives.
;[State 8015, ParentVarAdd]
;type = ParentVarAdd
;trigger1 = Time = 1
;trigger1 = Anim = 2000
;trigger1 = parent, Var(57) >= 9
;v = 56
;value = 10000

;Add 1 life
[State 8015, ParentVarAdd]
type = ParentVarAdd
trigger1 = Time = 1
trigger1 = Anim = 2000
;trigger1 = parent, Var(57) < 9
v = 57
value = 1

;Points Sound
[State 8015, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
trigger1 = Anim = 2001 || Anim = 2002
value = 201,9

;Give target 1000 Power if bag of cash is picked up in speed run mode
[State 8015, TargetPowerAdd]
type = TargetPowerAdd
trigger1 = Time > 0
trigger1 = NumTarget(8000) > 0
trigger1 = root, Var(41) = 2
trigger1 = Anim = 2001
value = 1000
ID = 8000
ignorehitpause = 1
persistent = 0

;Give 3000 power for the gold bars in speed run mode
[State 8015, TargetPowerAdd]
type = TargetPowerAdd
trigger1 = Time > 0
trigger1 = NumTarget(8000) > 0
trigger1 = root, Var(41) = 2
trigger1 = Anim = 2002
value = 3000
ID = 8000
ignorehitpause = 1
persistent = 0

[State 8015, ParentVarAdd]
type = ParentVarAdd
trigger1 = Time = 1
trigger1 = Anim = 2001
v = 56
value = 1000

[State 8015, ParentVarAdd]
type = ParentVarAdd
trigger1 = Time = 1
trigger1 = Anim = 2002
v = 56
value = 5000

[State 8010, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 2
value = 9500

[State 8015, RemoveExplod]
type = RemoveExplod
trigger1 = NumExplod(2000) > 0
id = 2000

[State 8015, DestroySelf]
type = DestroySelf
triggerall = NumTarget = 0
trigger1 = RoundState = 3
trigger2 = Time >= 30

