type = S

;Reset INT variables
[State 5900, VarRangeSet]
type = VarRangeSet
trigger1 = 1
value = 0
first = 0
last = 12;53

;Reset INT variables
[State 5900, VarRangeSet]
type = VarRangeSet
trigger1 = 1
value = 0
first = 14
last = 39

[State 5900, VarSet]
type = VarSet
trigger1 = Var(13) >= Var(59);Enemy Strength is 0
trigger1 = Var(55) != 3;Don't reset if Abadede isn't defeated.
trigger1 = Var(55) != 7;Don't reset if Shiva isn't defeated.
trigger1 = Var(55) != 8;Don't reset if Shiva is already defeated.
v = 13
value = 0

;Reset FLOAT variables
[State 5900, VarRangeSet]
type = VarRangeSet
trigger1 = 1
fvalue = 0
first = 0
last = 36

;--------------------
;Config Start
;--------------------

;Enemy strength, Single Match.
;The higher the value, the more enemies that need to be defeated before the round ends.
;Default is 10000. Don't set lower than 2000.
[State 191, VarSet]
type = VarSet
trigger1 = MatchNo = 1
trigger1 = RoundNo = 1 || Var(59) <= 0
v = 59
value = 10000;<-- Change this value
ignorehitpause = 1

;Enemy strength, Arcade Mode.
;Same as above, except this is for when you encounter the bonus game in arcade mode.
;This will work as long as you don't encounter the Bonus Game on the very first battle in arcade mode.
;This value should be lower than the above value, so that when fighting this Bonus Game in arcade
;mode, it doesn't take so long.
[State 191, VarSet]
type = VarSet
trigger1 = MatchNo > 1
trigger1 = RoundNo = 1 || Var(59) <= 0
v = 59
value = 5000;<-- Change this value (Default 5000)
ignorehitpause = 1

;Infinite Lives Mode.
;Set this value to 1 to play with infinite lives. Keep at 0 to play as normal.
;Default is 0.
;If you set this to 1, the next two config options don't have any effect on gameplay.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 45
value = 0;<-- Change this value
ignorehitpause = 1
persistent = 0

;Starting Lives. Starting max is 9, but after game starts it can go above 9.
;Default is 2.
[State 191, VarSet]
type = VarSet
trigger1 = RoundNo = 1
v = 57
value = 2;<-- Change this value
ignorehitpause = 1
persistent = 0

;Lives add.
;Increases remaining lives if they are below a certain amount after a round ends. (Default 3, then 2)
[State 5900, VarAdd]
type = VarAdd
trigger1 = RoundNo > 1
trigger1 = Var(57) < 3;<-- Change this value. If lives remaining is less than this amount...
v = 57
value = 2;...add this many (Change this value too).

;Auto-PickUp. If set to 1, power-ups are picked-up when touching them (And while on the ground not being hit.)
;If set to 0, power-ups have to be picked-up by crouching over them.
;Default is 0. Set this to 1 if you want to have the CPU fight the bonus game in watch mode, so they can get the items.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 53
value = 0;<-- Change this value
ignorehitpause = 1
persistent = 0

;Extra Enemy Intelligence. Set this value higher than 0 to increase the rate at which enemies react.
;Set to a negative value to decrease enemy reaction speed.
;Default is 0. Best to keep it between -20 and 20.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 52
value = 0;<-- Change this value
ignorehitpause = 1
persistent = 0

;Difficulty. Affects Max Life, Attack Frequency, and Speed of all enemies, including bosses
; (-1 = Super Easy), (0 = Novice), (1 = Very Easy), (2 = Easy), (3 = Normal)
; (4 = Hard), (5 = Very Hard), (6 = Mania)
;Default is 3.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 51
value = 3;<-- Change this value
ignorehitpause = 1
persistent = 0

;Enemy Hit System. Set to 1 to make enemies use HitOverrides when hit instead of using the default MUGEN hit system.
;If strange things happen when you try throwing enemies or use certain attacks, such as enemies disappearing
;completely, set this to 1. It'll prevent enemies from being affected by some attacks such as throws (because of
;how MUGEN works), but it should also prevent any problems related to such attacks.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 50
value = 0;<-- Change this value (Default is 0)
ignorehitpause = 1
persistent = 0

;Enemy Defense Type. This causes the enemies to take less damage for each hit in a combo against them.
;This exists to prevent enemies from being too easily defeated by simple combos and also
;because most damage-dampeners in MUGEN characters don't kick in against the SoR2 enemies.
;Doesn't affect damage enemies take if they block attacks.
;----------
;0 = Off (Enemies always take full amount of damage from every hit)
;1 = Impact (Normal damage until a certain amount, then halved until combo ends based on enemy type)
;2 = Low-Life Boost (Reduces damage once an enemy's remaining life is 300 or less. Slowly becomes more effective as life drops)
;3 = Tier (Enemies start taking reduced damage every 110 damage they take. Defense maxes out at 660 damage) <--- Most Balanced/Default
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 49
value = 3;<-- Change this value
ignorehitpause = 1
persistent = 0

;Extra damage mulitplier. Set this above 1 to increase the damage enemies take. Useful for reducing the length of the game.
;Total damage enemies take is affected by this value and the above setting.
;----------
;Remember that this value can have decimal values, such as 1.5
;----------
;Default is 1 (No extra damage)
[State 5900, VarSet]
type = VarSet
trigger1 = 1
fv = 38
value = 1
ignorehitpause = 1
persistent = 0

;Item Layer Priority. Set to 1 to make items appear above everything, including stage elements. If foreground elements
;of stages make it hard to see where the items are, turn this on. Note that this only makes the actual items appear
;above things, not the objects that contain the item.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 48
value = 0;<-- Change this value
ignorehitpause = 1
persistent = 0

;Enemy Item Pick-Up. Set to 1 to allow all enemies (Except Vehelits/Particle/Molecule/P1/Seeker) to pick up items.
;Default is 0.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 47
value = 0;<-- Change this value
ignorehitpause = 1
persistent = 0

;Enemy Special Effects.
;Set to 1 to allow enemies to appear with special effects. These effects either give enemies
;new abilites or change their stats in some way.
;Note that Bosses and Mini-Bosses never have these effects. Also, enemies with
;special effects are worth more points.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 44
value = 0;<-- Change this value (Default is 0)
ignorehitpause = 1
persistent = 0

;Enemy Block Type. Set how enemies with the abiliy to block do so.
;----------
;0 = Enemies can only block while not being hit, like normal characters.
;1 = Enemies can block even while being hit, like in the SoR games.
;2 = Same as 1, except when Raven or Shiva block attacks, the damage is completely nullified, as in SoR 2.
;3 = SoR accuracy. (Raven/Shiva take no damage, all other blocking enemies take minimum damage regardless of what attack they blocked.)
;Default is 0.
;----------
;Note: Options 1, 2, and 3 can make guarding enemies much tougher to beat.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 43
value = 0;<-- Change this value
ignorehitpause = 1
persistent = 0

;Enemy Block Charge. When enemies block, they lose 1 'block attempt'. This value affects how fast those
;'attempts' recharge. This is to prevent enemies from blocking too much. Note that the block attempts
;charge even while the enemy is being hit. The max number of block attempts that an enemy can 'store'
;depends on the setting below this one.
;----------
;Here are some sample values:
;0.0333 - +1 attempt every half a second.
;0.0166 - +1 attempt every second.
;0.0111 - +1 attempt every 1.5 seconds.
;0.0083 - +1 attempt every 2 seconds.
;0.0066 - +1 attempt every 2.5 seconds.
;0.0055 - +1 attempt every 3 seconds.
;0.0047 - +1 attempt every 3.5 seconds.
;0.0041 - +1 attempt every 4 seconds.
;0.0037 - +1 attempt every 4.5 seconds.
;0.0033 - +1 attempt every 5 seconds.
;
;Set to 100 to disable this limit. If the Enemy Block type (above setting) is 0, a value of 100 will have blocking enemies
;act as they did before this limiter was added.
;
;If you set the Enemy Block Type to 1, 2, or 3, its best to set this value to 0.0047 or lower, to prevent
;enemies from breaking out of your combos left an right.
;
;Abadede's use of his breaker attack is also limited by this setting. His 'block attempts' also charge 50% slower.
;----------
;Default is 0.0066
[State 5900, VarSet]
type = VarSet
trigger1 = 1
fv = 39
value = 0.0066;<-- Change this value
ignorehitpause = 1
persistent = 0

;Enemy Max block attempts. Set the maximum amount of block attempts that enemies can 'store' here.
;
;You can set it to 0 to disable enemy blocks (and Abadede's breaker attack), although that might
;make certain enemies too easy to defeat. Best to set it to at least 1.
;----------
;Default is 3.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 42
value = 3;<-- Change this value
ignorehitpause = 1
persistent = 0

;Alternate mode setting. Change this setting to play the bonus game in a different way than normal
;Current valid values are '0', '1', and '2'.
;----------
;0 = Normal Mode
;----------
;1 = Boss Rush Mode. Only fight the main bosses in order. Good if you want a shorter fight
;in Arcade or Survival Mode. Items still appear and the Score still is shown in Boss Rush Mode.
;NOTE: Only the first 4 bosses can be fought in a Survival mode battle with this setting on.
;----------
;2 = Speed Run Mode. Try to finish the bonus game as fast as possible. Your score is replaced
;with a blue number that slowly increases as time passes. If this setting is on, some other
;settings will be changed.
;----------
;Default is 0.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 41
value = 0;<-- Change this value
ignorehitpause = 1
persistent = 0

;Quick KO-Recover. If set to 1, your character gets up on the spot after getting 'fake' KO'd instead of hitting
;the ground, staying there for a bit, then jumping back in from the sky. Good for keeping the action going.
;Note that enemies don't get knocked down after a player KO if this setting is on.
[State 5900, VarSet]
type = VarSet
trigger1 = 1
v = 40
value = 0;<-- Change this value (Default is 0)
ignorehitpause = 1
persistent = 0

;--------------------
;Config End
