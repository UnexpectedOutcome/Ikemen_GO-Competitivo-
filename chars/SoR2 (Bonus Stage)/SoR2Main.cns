;Set Helper FVar(10) to Enemy 1 Max Life
[State 3100, VarSet]
type = VarSet
trigger1 = root, FVar(10) > 0
trigger1 = root, FVar(11) >= 0
trigger1 = FVar(10) != (root, FVar(10))
fv = 10
value = (root, FVar(10))

;Damage taken LifeBar "Slide" effect
[State 3100, VarAdd]
type = VarAdd
trigger1 = NumEnemy > 0
;trigger1 = (FVar(11) - (root, FVar(11))) = [1,9]
trigger1 = (FVar(11) - (root, FVar(11))) >= 1
trigger1 = (FVar(11) - (root, FVar(11))) <= 10
fv = 11
value = -(FVar(11) - (root, FVar(11)))

[State 3100, VarAdd]
type = VarAdd
trigger1 = NumEnemy > 0
;trigger1 = (FVar(11) - (root, FVar(11))) >= 10
trigger1 = (FVar(11) - (root, FVar(11))) > 10
trigger1 = (FVar(11) - (root, FVar(11))) <= 320
fv = 11
value = -10

[State 3100, VarAdd]
type = VarAdd
trigger1 = NumEnemy > 0
;trigger1 = (FVar(11) - (root, FVar(11))) >= 10
trigger1 = (FVar(11) - (root, FVar(11))) > 320
fv = 11
value = -20

;Damage recover LifeBar "Slide" effect
[State 3100, VarAdd]
type = VarAdd
trigger1 = NumEnemy > 0
;trigger1 = ((root, FVar(11)) - FVar(11)) = [1,9]
trigger1 = ((root, FVar(11)) - FVar(11)) >= 1
trigger1 = ((root, FVar(11)) - FVar(11)) <= 10
fv = 11
value = ((root, FVar(11)) - FVar(11))

[State 3100, VarAdd]
type = VarAdd
trigger1 = NumEnemy > 0
;trigger1 = ((root, FVar(11)) - FVar(11)) >= 10
trigger1 = ((root, FVar(11)) - FVar(11)) > 10
trigger1 = ((root, FVar(11)) - FVar(11)) <= 320
