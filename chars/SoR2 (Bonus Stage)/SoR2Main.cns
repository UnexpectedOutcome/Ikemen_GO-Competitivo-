;Set Helper FVar(12) to Enemy 2 Max Life
[State 3100, VarSet]
type = VarSet
trigger1 = root, FVar(12) > 0
trigger1 = root, FVar(13) >= 0
trigger1 = FVar(12) != (root, FVar(12))
fv = 12
value = (root, FVar(12))

;Damage taken LifeBar "Slide" effect
[State 3100, VarAdd]
type = VarAdd
trigger1 = NumEnemy > 0
;trigger1 = (FVar(11) - (root, FVar(11))) = [1,9]
trigger1 = (FVar(13) - (root, FVar(13))) >= 1
trigger1 = (FVar(13) - (root, FVar(13))) <= 10
fv = 13
value = -(FVar(13) - (root, FVar(13)))

[State 3100, VarAdd]
type = VarAdd
trigger1 = NumEnemy > 0
;trigger1 = (FVar(11) - (root, FVar(11))) >= 10
trigger1 = (FVar(13) - (root, FVar(13))) > 10
trigger1 = (FVar(13) - (root, FVar(13))) <= 320
fv = 13
value = -10

[State 3100, VarAdd]
