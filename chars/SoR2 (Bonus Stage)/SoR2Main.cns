;trigger1 = ((root, FVar(11)) - FVar(11)) = [1,9]
trigger1 = ((root, FVar(13)) - FVar(13)) >= 1
trigger1 = ((root, FVar(13)) - FVar(13)) <= 10
fv = 13
value = ((root, FVar(13)) - FVar(13))

[State 3100, VarAdd]
type = VarAdd
trigger1 = NumEnemy > 0
;trigger1 = ((root, FVar(11)) - FVar(11)) >= 10
