value = 10

[State 3100, VarAdd]
type = VarAdd
trigger1 = NumEnemy > 0
;trigger1 = ((root, FVar(11)) - FVar(11)) >= 10
trigger1 = ((root, FVar(11)) - FVar(11)) > 320
fv = 11
value = 20

;Set FVar(11) to exact value of root,FVar(11) if difference between them is under 1
[State 3100, VarSet]
type = VarSet
trigger1 = Fvar(11) > (root, FVar(11))
trigger1 = (FVar(11) - (root, FVar(11))) < 1
trigger2 = (root, FVar(11)) > Fvar(11)
trigger2 = ((root, FVar(11)) - Fvar(11)) < 1
fv = 11
value = (root, FVar(11))

