; Definition file for player
; Contains all the filenames needed for the character

; Player information
[Info]
name = "SoR2"        ;Name of character
displayname = "SoR2" ;Name of character to display
versiondate = 4/28/2014   ;Version date of character
mugenversion = 1.0  ;Version of M.U.G.E.N character works on
author = "K-Fox"      ;Character author name
pal.defaults = 1  ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = SoR2.cmd   ;Command set
cns     = SoR2Main.cns   ;Constants
st      = SoR2Main.cns   ;States
st1 = EnemyStates.cns
st2 = EStates2.cns
st3 = EStates3.cns
st4 = EnemyHelpers.cns
st5 = SetConfig.cns
stcommon = common1.cns ;Common states
sprite  = SoR2.sff   ;Sprite
anim    = SoR2.air   ;Animation
sound  = SoR2.snd   ;Sound
pal1   = NewPal.act   ;Palettes (can have up to 12)
;pal2   =
;pal3   =
;pal4   =
;pal5   =
;pal6   =
;pal7   =
;pal8   =
;pal9   =
;pal10  =
;pal11  =
;pal12  =
