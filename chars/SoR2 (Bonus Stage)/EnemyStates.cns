;Cody Appear
[State 9500, VarSet]
type = VarSet
trigger1 = IsHelper(200)
trigger1 = root, Var(55) != 0;Will appear after first boss is defeated
trigger1 = root, Var(55) != 8;Won't appear during Mr.X battle
trigger1 = root, NumExplod(13838) = 0
trigger1 = Time = 4
trigger1 = (Random+1) <= 125;12.5% chance Cody appears
v = 0
value = 38
ignorehitpause = 1
persistent = 0

;Special Effect
[State 9500, VarRandom]
type = VarRandom
trigger1 = Time = 5
trigger1 = root, Var(44) = 1
trigger1 = (random+1) >= 501
v = 3
range = 1,9
ignorehitpause = 1
;persistent = 0

;Current Special Effects
;1 - Regeneration (+10 life every second)
;2 - Armour (-25% damage taken, -50% speed)
;3 - Berserk (+50% damage given AND taken, +10 intelligence)
;4 - Anti-Projectile (Can't be hit by projectiles)
;5 - Evasion (10% chance -33% damage, 10% chance -66% damage, 10% chance -100% damage)
;6 - X Berserk (+250% damage dealt, -80% Life)
;7 - Recon (-50% Max Life, +50% Speed, slowly restores Enemy Strength Meter)
;8 - EX Bomb (3 Grenades are dropped upon defeat)
;9 - Jammer (Enemy HUD area becomes covered with a black 'fuzz')
;10 - Buffer-Armor (Enemy doesn't shake when hit, -25% attack power)

;Safety?
[State 11000, RemoveExplod]
type = RemoveExplod
trigger1 = IsHelper(200) || IsHelper(201) || IsHelper(202)
trigger1 = NumExplod(10021) > 0
id = 10021

[State 11000, RemoveExplod]
type = RemoveExplod
trigger1 = IsHelper(200) || IsHelper(201) || IsHelper(202)
trigger1 = NumExplod(10022) > 0
id = 10022

[State 9500, ChangeState]
type = ChangeState
trigger1 = Time = 5
value = 9502
ctrl = 0
ignorehitpause = 1

