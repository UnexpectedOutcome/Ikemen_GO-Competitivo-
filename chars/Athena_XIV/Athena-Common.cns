[Statedef 8000]
type    = L
movetype = H
physics = N
velset = 0,0
anim = ifelse((var(36)=1),55583,55581)

[State 8000, 1]
type = StateTypeSet
trigger1 = 1
statetype = S
Physics = S

[State 8000, 2]
type = NotHitBy
trigger1 = 1
value = SCA

[State 8000, 3]
type = PlaySnd
trigger1 = Animelem = 1
value = s12,0 + (random%3)

[State 8000, 4]
type = PosAdd
trigger1 = Animelem = 8
x = 5

[State 8000, 5]
type = PosAdd
trigger1 = Animelem = 9
x = 10

[State 8000, 6]
type = PosAdd
trigger1 = Animelem = 10
x = 7

[State 8000, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 5150