;---------------------------------------------------------------------------
;(HELPER)價僢僩丒僋儕僗僞儖僔儏乕僩堏摦
[Statedef 3023]
type = A
ctrl = 0
;anim = 2020
velset = 0,0
movetype = I
physics = N
sprpriority = 1

[state a]
type = AssertSpecial
trigger1 = 1
flag = noshadow



;---------------------[懍搙]
[state a]
type = velset
