;==============================================================================
; ステートエントリーパート（技などを出せるようにするための条件を設定）
;==============================================================================
;------------------------------------------------------------------------------

[Statedef -1] ;←この行は絶対に消さないでね。必須項目です。

;==============================================================================
; 超必殺技
;==============================================================================
;------------------------------------------------------------------------------

;=============================================================================
; 超必殺技
;=============================================================================

;-----------------------------------------------------------------------------
[State -1, 無呼吸乱舞]
type = ChangeState
value = 3000
triggerall = hitpausetime = 0
triggerall = !var(59)
triggerall = power >=3000
triggerall = command = "無呼吸乱舞"
triggerall = command = "y"
triggerall = statetype != A
trigger1 = ctrl
trigger2 = anim = (200)&&(movecontact)
trigger3 = (anim=400||anim=401)&&(movecontact)
trigger4 = (anim=430||anim=431)&&(movecontact)
trigger5 = (anim=230||anim=231)&&(movecontact)
trigger6 = (anim=245||anim=246)&&(movecontact)
trigger7 = (anim=210||anim=211)&&(movecontact)
trigger8 = (anim=251||anim=252)&&(movecontact)
trigger9 = (anim=2321||anim=2322)&&(movecontact)
trigger10 = (anim=253||anim=251)&&(movecontact)
trigger11 = (anim=250||anim=252)&&(movecontact)
trigger12 = (anim=240||anim=241)&&(movecontact)


