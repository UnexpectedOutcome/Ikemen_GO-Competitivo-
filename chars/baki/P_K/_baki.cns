triggerall=(PrevStateNo=52)
trigger1=(animelemtime(1)=0)&&(P2Dist X<0)
Persistent=0

[State 40,ステート変更]
type=ChangeState
trigger1=AnimTime=0
value=50
ctrl=1
[state 準ステ固定]
