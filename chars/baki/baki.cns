;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = var(59)<=0 && statetype = S && command = "holddown"
trigger2 = var(59)>=1 && statetype=S && (enemynear,movetype=A)
trigger2 = enemynear,statetype=C
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = var(59)<=0 && statetype=C && command!="holddown"
trigger2 = var(59)>=1 && statetype=C && (enemynear,movetype=A) && (enemynear,statetype!=C)
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0 || var(59)>=1
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1= (var(59)<=0 && command!="holdback")
trigger2= var(59)<=0 && !inguarddist
;AI
Trigger3 = var(59)>=1
Trigger3 = Enemy,MoveType != A || EnemyNear,MoveType != A
Trigger3 = P2Dist X < 0
Trigger3 = !InguardDist
Trigger4 = var(59)>=1 && P2Dist X >= 0
Trigger4 = !InguardDist
Trigger5 = var(59)>=1 && roundstate != 2
value = 140

;---------------------------------------------------------------------------
; STAND GUARD (guarding)
[Statedef 130]
type    = S
physics = S

[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 130, Hi to Lo]
type = ChangeState
trigger1 = var(59)<=0 && command="holddown"
trigger2 = var(59)>=1
trigger2 = (enemynear,movetype=A) && random < 970
value = 131

[State 120, Stop Guarding]
type = ChangeState
trigger1= (var(59)<=0 && command!="holdback")
trigger2= var(59)<=0 && !inguarddist
;AI
Trigger3 = var(59)>=1
Trigger3 = Enemy,MoveType != A || EnemyNear,MoveType != A
Trigger3 = P2Dist X < 0
Trigger3 = !InguardDist
Trigger4 = var(59)>=1 && P2Dist X >= 0
Trigger4 = !InguardDist
Trigger5 = var(59)>=1 && roundstate != 2
value = 140

;---------------------------------------------------------------------------
; CROUCH GUARD (guarding)
[Statedef 131]
type    = C
physics = C

[State 131, 1]
type = ChangeAnim
trigger1 = Anim != 131
value = 131

[State 131, Lo to Hi]
type = ChangeState
trigger1 = var(59)<=0 && command!="holddown"
trigger2 = var(59)>=1 && random < 15
trigger2 = (enemynear,movetype=A)&&(enemynear,statetype!=C)
Trigger3 = (Enemy,stateType = A)||(Enemy,pos Y<0)
trigger3 = var(59)>=1
value = 130

[State 120, Stop Guarding]
type = ChangeState
trigger1= (var(59)<=0 && command!="holdback")
trigger2= var(59)<=0 && !inguarddist
;AI
Trigger3 = var(59)>=1
Trigger3 = Enemy,MoveType != A || EnemyNear,MoveType != A
Trigger3 = P2Dist X < 0
Trigger3 = !InguardDist
Trigger4 = var(59)>=1 && P2Dist X >= 0
Trigger4 = !InguardDist
Trigger5 = var(59)>=1 && roundstate != 2
value = 140


;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 1]
type = ctrlSet
trigger1 = var(59)=1
value = 0

[State 100, 4]
type = ChangeState
trigger1 = var(59)<=0
trigger1 = command != "holdfwd"
value = 0



