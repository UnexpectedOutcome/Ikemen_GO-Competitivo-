; ジャンプ
[Statedef 50]
type    = A
physics = A

[State 40, ハイジャンプ音]
type = PlaySnd
trigger1 = Time = 0
value = 40,1

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))
