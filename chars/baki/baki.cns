trigger2 = MatchOver
Trigger2 = (var(1)=[2,3])
Trigger2 = (Time <600)
trigger3 = !MatchOver
Trigger3 = (var(1)=[2,3])
Trigger3 = (Time <300)
flag = roundnotover


;---------------------------------------------------------------------------
;カメラ制御ヘルパー
[Statedef 6001]
type = S
physics  = S
anim = 0
ctrl = 0

[state 2906,本体の向きに追従]
type=turn
trigger1=ishelper(6001)
trigger1=facing!=root,facing
ignorehitpause=1

[State 4];速度を与える
type = VelSet
trigger1 = parent,pos X > 0
x = ifelse(facing = 1,4,-4)

[State 4];速度を与える
type = VelSet
trigger1 = parent,pos X < 0
x = ifelse(facing = 1,-4,4)

[State 4];速度を与える
type = VelSet
trigger1 = parent,pos X = [-5,5]
x = 0

[State 3000, 位置]
type = Width
trigger1 = 1
value = 1,1

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA,AA,AT,AP
time = 1

[State 1000,***]
type = AssertSpecial
Trigger1 = 1
flag = invisible
flag2 = noshadow

[State 210, 3]
type = ScreenBound
trigger1 =1
value =1
movecamera = 320,0

[State 210, 3]
type = PlayerPush
trigger1 =1
value = 0
















