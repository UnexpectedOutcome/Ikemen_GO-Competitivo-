Y = 4.5

[State 925]
type     = VelSet
trigger1 = !time
trigger1 = (anim = 914)||(Anim = 916)
X        = ifelse(Anim=914, -4.5, 4.5)

[State 925]
type     = VelSet
trigger1 = !time
trigger1 = (anim = 917)||(Anim = 918)||(Anim = 919)
X = ifelse(Anim=917, -4.5, ifelse(Anim=918, 0, 4.5))
Y = -4.5

[state 42050, 減速]
type     = Velmul
trigger1 = vel x < 0
x        = 0.95

[state 925, 減速]
type     = Velmul
trigger1 = vel y != 0
y        = 0.95

[state 925, Nothit];完全無敵
type     = Nothitby
Trigger1 = (Anim=911)||(Anim=914)||(Anim=917)
Trigger1 = Time = [1,7]
value    = SCA,AA,AT,AP
time     = 1

