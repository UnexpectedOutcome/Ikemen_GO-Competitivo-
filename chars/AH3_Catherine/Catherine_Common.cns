; レバー入れホーミング / 開始
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Statedef 920]
type     = A
movetype = I
physics  = N
ctrl     = 0
velset   = 0, 0

[State 920]
Type = turn
Trigger1 = !Time
Trigger1 = P2Dist X<0

;------------------------------------------[開始処理]

[State 920]
Type     = PlaySnd
Trigger1 = !Time
value    = s10, 0

;-------------------------------------------------[アニメ変更]

[state 920, up];上入力
type     = changeanim
trigger1 = !time
trigger1 = command = "holdup"
trigger1 = (command != "holdfwd") && (command != "holdback")
value    = 918

[state 920, fwdup];前上入力
type     = changeanim
trigger1 = !time
trigger1 = (command = "holdup") && (command = "holdfwd")
trigger1 = (command != "holdback")
value    = 919

[state 920, backup];後上入力
type     = changeanim
trigger1 = !time
trigger1 = (command = "holdup") && (command = "holdback")
trigger1 = (command != "holdfwd")
value    = 917

[state 920, back];後入力
type     = changeanim
trigger1 = !time
trigger1 = command = "holdback"
trigger1 = (command != "holdup") && (command != "holddown")
value    = 914

[state 920, fwd];前入力
type     = changeanim
trigger1 = !time
trigger1 = command = "holdfwd"
trigger1 = (command != "holdup") && (command != "holddown")
value    = 916

[state 920, down];下入力
type     = changeanim
trigger1 = !time
trigger1 = command = "holddown"
trigger1 = (command != "holdfwd") && (command != "holdback")
value    = 912

[state 920, fwddown];前下入力
type     = changeanim
trigger1 = !time
trigger1 = (command = "holddown") && (command = "holdfwd")
trigger1 = (command != "holdback")
value    = 913

[state 920, backdown];後下入力
type     = changeanim
trigger1 = !time
trigger1 = (command = "holddown") && (command = "holdback")
trigger1 = (command != "holdfwd")
value    = 912

;-------------------------------------------------[速度変更]

[state 920]
type     = VelSet
trigger1 = !time
trigger1 = (anim = 911)||(Anim = 912)||(Anim = 913)
X = ifelse(Anim=911, -5.5, ifelse(Anim=912, 0, 5.5))
Y = 5.5

[state 920]
type     = VelSet
trigger1 = !time
trigger1 = (anim = 914)||(Anim = 916)
X        = ifelse(Anim=914, -5.5, 5.5)

[state 920]
type     = VelSet
trigger1 = !time
trigger1 = (anim = 917)||(Anim = 918)||(Anim = 919)
X = ifelse(Anim=917, -5.5, ifelse(Anim=918, 0, 5.5))
Y = -5.5

[state 920, 減速]
type     = Velmul
trigger1 = vel x < 0
x        = 0.95

[state 920, 減速]
type     = Velmul
trigger1 = vel y != 0
y        = 0.95

[State 920, Nothit];完全無敵
type     = Nothitby
