triggerall = Anim != 96
trigger1 = vel x < 0
value = 96

[State 10090, 3];前向き
type = ChangeAnim
triggerall = Anim != 95
trigger1 = vel x >= 0
value = 95

[State 90, 0]
type = ChangeAnim
triggerall = Anim != 95
triggerall = prevstateno != 117
trigger1 = Time = 0
value = 95

[State 90, 0];終わり
type = CtrlSet
trigger1 = Time = 0
value = 1


[Statedef 117];飛翔
type    = A
physics = N
ctrl = 0
anim = 92
sprpriority = 1

[State 117, 1];ダッシュ回数
type = Varadd
trigger1 = Time = 0
var(0) = 1

[State 117, 1];霊力消費
type = Varadd
trigger1 = 1 
var(2) = -1

[State 117, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 0, 1

[State 117, 自分のアニメ表示]
Type = Helper
Trigger1 = Time = 0
StateNo = 10090
ID = 10090
Name = "fly"
Pos = 0,-35
PosType = P1
Ownpal = 0
IgnoreHitPause = 0
Persistent = 1

[State 117, エフェクト輪]
Type = Helper
Trigger1 = Time > 0
StateNo = 10098
ID = 10098
Name = "fly_ring"
Pos = Floor(50*cos(fvar(0)*pi/180)),-35-Floor(50*sin(fvar(0)*pi/180))
PosType = P1
Ownpal = 1
IgnoreHitPause = 1
Persistent = 6

[State 117, 6];左回り
type = Varadd
triggerall = time > 10
trigger1 = command = "holdup" ;8
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = (fvar(0) < 90) && (fvar(0) > -90)
trigger2 = command = "holdup" ;9
trigger2 = command = "holdfwd"
trigger2 = ((fvar(0) < 45) && (fvar(0) > -135)) || ((fvar(0) > 225) && (fvar(0) < 405))
trigger3 = command = "holdfwd" ;6
trigger3 = command != "holddown"
trigger3 = command != "holdup"
trigger3 = ((fvar(0) < 0) && (fvar(0) > -180)) || ((fvar(0) > 180) && (fvar(0) < 360))
trigger4 = command = "holdfwd" ;3
trigger4 = command = "holddown"
trigger4 = ((fvar(0) < -45) && (fvar(0) > -225)) || ((fvar(0) > 135) && (fvar(0) < 315))
trigger5 = command = "holddown" ;2
trigger5 = command != "holdfwd"
trigger5 = command != "holdback"
trigger5 = ((fvar(0) > 90) && (fvar(0) < 270)) || ((fvar(0) < -90) && (fvar(0) > -270))
trigger6 = command = "holdback" ;1
trigger6 = command = "holddown"
trigger6 = ((fvar(0) > 45) && (fvar(0) < 225)) || ((fvar(0) < -135) && (fvar(0) > -315))
trigger7 = command = "holdback" ;4
trigger7 = command != "holddown"
trigger7 = command != "holdup"
trigger7 = ((fvar(0) > 0) && (fvar(0) < 180)) || ((fvar(0) < -180) && (fvar(0) > -360))
trigger8 = command = "holdback" ;7
trigger8 = command = "holdup"
trigger8 = ((fvar(0) > -45) && (fvar(0) < 135)) || ((fvar(0) < -225) && (fvar(0) > -405))
fvar(0) = 1

[State 117, 6];右回り
type = Varadd
triggerall = time > 10
trigger1 = command = "holdup" ;8
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = ((fvar(0) > 90) && (fvar(0) < 270)) || ((fvar(0) < -90) && (fvar(0) > -270))
trigger2 = command = "holdup" ;9
trigger2 = command = "holdfwd"
trigger2 = ((fvar(0) > 45) && (fvar(0) < 225)) || ((fvar(0) < -135) && (fvar(0) > -315))
trigger3 = command = "holdfwd" ;6
trigger3 = command != "holddown"
trigger3 = command != "holdup"
trigger3 = ((fvar(0) > 0) && (fvar(0) < 180)) || ((fvar(0) < -180) && (fvar(0) > -360))
trigger4 = command = "holdfwd" ;3
trigger4 = command = "holddown"
trigger4 = ((fvar(0) > -45) && (fvar(0) < 135)) || ((fvar(0) < -225) && (fvar(0) > -405))
trigger5 = command = "holddown" ;2
trigger5 = command != "holdfwd"
trigger5 = command != "holdback"
trigger5 = ((fvar(0) < 90) && (fvar(0) > -90))
trigger6 = command = "holdback" ;1
trigger6 = command = "holddown"
trigger6 = ((fvar(0) < 45) && (fvar(0) > -135)) || ((fvar(0) > 225) && (fvar(0) < 405))
trigger7 = command = "holdback" ;4
trigger7 = command != "holddown"
trigger7 = command != "holdup"
trigger7 = ((fvar(0) < 0) && (fvar(0) > -180)) || ((fvar(0) > 180) && (fvar(0) < 360))
trigger8 = command = "holdback" ;7
trigger8 = command = "holdup"
trigger8 = ((fvar(0) < -45) && (fvar(0) > -225)) || ((fvar(0) > 135) && (fvar(0) < 315))
fvar(0) = -1

[State 117, 6]
type = Velset
trigger1 = time = 0
trigger2 = time > 10
X = 4.4*cos(fvar(0)*pi/180)*ifElse(NumHelper(11360) > 0, 1.4,1)
Y = 4.4*-sin(fvar(0)*pi/180)*ifElse(NumHelper(11360) > 0, 1.4,1)

[State 117, 6];終わり
type = ChangeState
trigger1 = command != "fly"
trigger1 = Time > 10
trigger2 = Vel Y > 0
trigger2 = Pos Y >= -10
trigger3 = var(2) <= 0;　　霊力０
value = 90


