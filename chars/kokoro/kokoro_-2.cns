;　☆　カード出現率重み付け　＠ちゃんと動くかどきどき
;
;　・変数割り当て（このヘルパーの）
;	var(1-5)　 ：候補カード、ランダムで回す
;	var(6-10)　：状態変数
;	var(11-15) ：準備カード、本体の手札割り当てが -1 になったらこれを本体に送る
;
;　・var(1,6,11)でワンセット、以下、2,7,12…と同様に続く
;　・本体の変数はvar(54-58)だけ関係してる
;　・カード番号 = -1 が交換のフラグなのはいっしょ
;
;　・乱数を使ってカードを内部的にスロットみたいに回しとく
;　・そのカードを(n/4)の確率で準備カードとして採用、外れたらスロット継続
;　・採用したらお呼びがかかるまで待つ
;　・本体の手札が -1 になったらそれを本体へ送ってやる
;　・このルーチンを１～５枚目がそれぞれ独立に繰り返し
;
;　・本家との違い：カードは消費されないので枚数１のカードは本家よりたぶん出にくい


;-------変数をリセットしよう　　状態変数 0

[State 20000,準備カードを空に];
type = VarSet
Trigger1 = var(6) = 0
var(11) = -1

[State 20000,準備カードを空に];
type = VarSet
Trigger1 = var(7) = 0
var(12) = -1

[State 20000,準備カードを空に];
type = VarSet
Trigger1 = var(8) = 0
var(13) = -1

[State 20000,準備カードを空に];
type = VarSet
Trigger1 = var(9) = 0
var(14) = -1

[State 20000,準備カードを空に];
type = VarSet
Trigger1 = var(10) = 0
var(15) = -1


[State 20000,次の処理へ];
type = VarSet
Trigger1 = var(6) = 0
trigger1 = var(11) = -1
var(6) = 1

[State 20000,次の処理へ];
type = VarSet
Trigger1 = var(7) = 0
trigger1 = var(12) = -1
var(7) = 1

[State 20000,次の処理へ];
type = VarSet
Trigger1 = var(8) = 0
trigger1 = var(13) = -1
var(8) = 1

[State 20000,次の処理へ];
type = VarSet
Trigger1 = var(9) = 0
trigger1 = var(14) = -1
var(9) = 1

[State 20000,次の処理へ];
