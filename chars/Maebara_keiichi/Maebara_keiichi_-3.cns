[Statedef -3]

;これはジャンプ後とバックステップ後に着地音を鳴らすコントローラです。
[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ後の着地
trigger2 = stateno = 106 ;バックステップ後の着地
value = s6, 1

;■Life回復タイミング
[State -3]
type =lifeadd
trigger1 = var(56)>=1
Trigger1 = GameTime % 10 = 0
trigger1 = life >=5
trigger1 = lose = 0
value = 1

;■AI関係■■■■■■■■■■■■■■■■■■■■■■■■


;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;切り替えし
;PrevStateNo = [120,159] PrevStateNo = [5000,5270] EnemyNear,HitDefAttr = SCA,NT,ST,HT;投げ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

;■相手が攻撃中にカウンター狙う)
[State -3,K乱舞]
Type = ChangeState
Value = 1900
TriggerAll = var(59)!=0
TriggerAll = RoundState = 2
TriggerAll = StateType != A
TriggerAll = EnemyNear,StateType != L
TriggerAll = EnemyNear,MoveType = A
;TriggerAll = !InGuardDist
TriggerAll = (EnemyNear,StateNo != [120,159])
TriggerAll = P2BodyDist X >= 5
TriggerAll = P2BodyDist X <= 90-EnemyNear,vel x*8
;TriggerAll = P2StateType = A
TriggerAll = P2BodyDist Y >= -60
TriggerAll = Ctrl || (StateNo = [100,101]) || StateNo = 52
Trigger1 = Random <= var(59)*20
Trigger1 = power >= 3000

;■フルスイング
[State -3]
Type = ChangeState
Value = 2500
TriggerAll = var(59)!=0
;TriggerAll = RoundState = 2
TriggerAll = StateType != A
;TriggerAll = EnemyNear,StateType != L
;TriggerAll = EnemyNear,MoveType = A
TriggerAll = InGuardDist
;TriggerAll = (EnemyNear,StateNo != [120,159])
TriggerAll = P2BodyDist X >= 120
;triggerall = !(EnemyNear(0),HitDefAttr = SCA, NT,ST,HT);SCA, NA,SA,HA,NT,ST,HT)
;triggerall = !(EnemyNear(0),HitDefAttr = SCA, NA,SA,HA);SCA, NA,SA,HA,NT,ST,HT)
TriggerAll = Ctrl || (StateNo = [100,101]) || StateNo = 52 || (StateNo = [150,153])
Trigger1 = Random <= var(59)*40
;trigger1 = EnemyNear,HitDefAttr = SCA, NP, SP, HP

