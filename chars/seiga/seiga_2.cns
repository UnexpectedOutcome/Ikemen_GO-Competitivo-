
;---------------------------------------------------------------------------

;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]

[State -2];コンボ補正反映
type = AttackMulSet
trigger1 = 1
value = 1*fvar(1)
ignorehitpause = 1

[State -2];コンボ補正下限
type = Varset
trigger1 = fvar(1) < 0.75
fv = 1
value = 0.75
ignorehitpause = 1

[State -2];コンボ補正終了
type = Varset
trigger1 = enemy,movetype != H
trigger2 = enemy,stateno = [120,155]
fv = 1
value = 1
ignorehitpause = 1

[State 200];コンボ補正乗算
type = Varset
trigger1 = movehit
trigger1 = fvar(1)>0.75
fv = 1
value = fVar(1)*0.975
persistent = 0
ignorehitpause = 1

[State ]
type = Explod
trigger1=var(54)=1
trigger1=loseko
trigger1=matchover
trigger1=numexplod(8807)=0
ID = 8807
postype = left
pos = 0,0
bindtime=-1
scale=0.5,0.5
sprpriority = 9
removetime = -2
anim = 9993
supermovetime = 9999
pausemovetime = 9999
ownpal = 1
ontop=1
removeongethit = 0

[State ]
type = Explod
trigger1=var(54)=1
trigger1=loseko
trigger1=matchover
trigger1=numexplod(8808)=0
ID = 8808
postype = p1
pos = 0,0
scale=0.5,0.5
sprpriority = 2
removetime = -2
bindtime = 9999
anim = ifelse(facing=1,9992,9991)
supermovetime = 9999
pausemovetime = 9999
ownpal = 1
removeongethit = 0

;===========================================================================
; 準常時監視ステート（－３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

;-----------------------------------
;ここは「ジャンプ」か「バックステップ」をした後に
;着地する音を鳴らす設定をしています。
;-----------------------------------

;---------------------------------------------------------------------------
;	スイッチ設定
;---------------------------------------------------------------------------
[State -3, AI強制ON]
type = VarSet
trigger1 = !isHelper
trigger1 = PalNo=[1,6]
trigger1 = var(53) = 0
var(59) = 0	;※ここを1にするとAI強制ON(デフォルト０)

[State -3, 脱衣スイッチ]
type = VarSet
trigger1 = !isHelper
trigger1 = var(53) = 0
var(54) = 1	;※ここを0にすると脱衣OFF(デフォルト１)

[State -3, スイッチ設定終了]
type = VarSet
trigger1 = !isHelper
trigger1 = var(53) = 0	;※ここはいじらないでください
var(53) = 1

