st6      = cns(280gou compatible)/unique.cns
st7      = cns(280gou compatible)/ultimateblast.cns
st8      = cns(280gou compatible)/characteristic.cns
st9      = cns(280gou compatible)/helper.cns
stcommon = common1.cns		;Common states
sprite   = GokuVynStyle.sff	;Sprite
anim     = GokuVynStyle.air	;Animation
