ctrl = 1

;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2+(P2statetype=A&&statetype=S)*3

[state 120]
type = varset
trigger1 = Time=0
var(1) = (P2statetype=A&&!(enemynear,Pos Y>=-10&&enemynear,vel Y<=0)&&statetype=S)*100

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"&&!fvar(38)
trigger2 = statetype = S && P2statetype!=A&&time>1&&!(enemynear,time>=15 && P2statetype=S)&&fvar(38)
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"&&!fvar(38)
trigger2 = statetype = C && (enemynear,vel Y>=0||enemynear,pos Y<-70||enemynear,time>=18)&&P2statetype=A&&random%5<4&&fvar(38)
trigger3 = statetype = C && enemynear,time>=15 && P2statetype=S&&random%5<ifelse(var(54)%5<2,2,4)&&fvar(38)
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"&&!fvar(38)
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
