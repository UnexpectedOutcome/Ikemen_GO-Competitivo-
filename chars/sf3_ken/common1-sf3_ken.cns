;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 1
trigger2 = Time = 4
x = fvar(6)

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim != 11 && Anim != 6
value = 6

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
trigger2 = Anim != 11 && Anim != 6
value = 11

[State 11, 3] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < 1
x = fvar(6)

[State 0, 1]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 0, 1]
type = Turn
trigger1 = P2dist X<0

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd" && Time>=2
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback" && Time>=2
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = command = "holdfwd"
trigger1 = Anim != (20) && Anim != (5)
trigger2 = Anim = (5) && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = command = "holdback"
trigger1 = Anim != (21) && Anim != (5)
trigger2 = Anim = (5) && AnimTime = 0
value = 21

 ;_/_/_/_/CPU_/_/_/_/
;---------------------------------------------------------------------------
;Stand(CPU)
[Statedef 3]
type    = S
physics = S
anim = 0
sprpriority = 0
velset = 0,0
ctrl =0

[State 13, 1]
type =Turn
trigger1 = P2Dist X<0

[State 11, 3] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < 1
x = fvar(6)

[State 13, 1]
type = ChangeState
trigger1 = roundstate!=2
value = 0
ctrl = 1

[State 13, 1]
type = ChangeState
trigger1 = ((AnimElemTime(1) = [10,16]) && random <100) || ((AnimElemTime(1) = [66,70]) && random <50) || AnimElemTime(1) = 108
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Crounch(CPU)
[Statedef 13]
type    = C
physics = C
anim = 11
sprpriority = 0
velset = 0,0
ctrl =0

[State 13, 1]
type = Turn
trigger1 = P2Dist X<0

[State 11, 3] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < 1
x = fvar(6)

[State 13, 1]
type = ChangeState
trigger1 = roundstate!=2
value = 11
ctrl = 1

[State 13, 1]
type = ChangeState
trigger1 = p2statetype=A && enemynear,time>12
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Forward Walk
[Statedef 21]
type    = S
physics = S
sprpriority = 1
anim = 20
ctrl = 0

[State 20, 1]
type = VelSet
trigger1 = Time>=2
x = const(velocity.walk.fwd.x)

[State 20, 4]
type = changestate
trigger1 = P2dist x <= 0
trigger2 = time>=8 && ((P2BodyDist X<80&&random<500 && !fvar(36)) || (random<200 && P2BodyDist X >80) || (enemynear,numproj>0 && ((enemy,hitdefattr=SCA,HP)||fvar(28)))) && PrevStateNo!=52 && !(fvar(10)=1 && !fvar(28))
trigger3 = P2bodydist X>100 && (enemynear,numproj>0||((enemynear,hitdefattr!=SCA,AA,AT,AP)&&inguarddist&&P2movetype!=A))||(P2movetype=A&&enemynear,time>20&&enemynear,animtime>-6)
trigger4 = time>=5 && P2bodydist X>80 && !(P2statetype=L&&enemynear,alive) && P2bodydist X<=fvar(34) && random%5<3
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Back Walk
[Statedef 22]
type    = S
physics = S
sprpriority = 1
anim = 21
ctrl = 0

[State 20, 2]
type = VelSet
trigger1 = Time>=2
x = const(velocity.walk.back.x)

[State 20, 4]
type = changestate
trigger1 = P2dist x <= 0
trigger2 = time>=8 && random<220
trigger3 = P2statetype=L&&enemynear,alive&&P2bodydist X>55
value = 0
ctrl = 1

;---------------------------------------------------------------------

;---------------------------------------------------------------------
;Jump Start
[Statedef 40]
type = S
movetype=H
physics = S
anim = 40
ctrl=0
velset = 0,0

[State 40,1]
type = VarSet
trigger1 = time=0
fvar(6) = 0

[State 40,1]
type = VarSet
trigger1 = time=0
fvar(7) = 0

[State 40,1]
type = VarSet
trigger1 = time=0
fvar(8) = 0

;|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
;CPU

[State 40,1]
type = VarSet
triggerall = fvar(38) && Time = 0
trigger1 = P2Statetype=A && P2BodyDist X <80 && enemynear,Pos Y <-55
trigger2 = (P2BodyDist X =[0,50]) && P2Statetype!=A
trigger2 = (random = [0,250])
trigger3 = (random = [0,400]) && enemy,numproj>0
trigger3 = P2BodyDist X>120 && !(P2Statetype=A && enemynear,Pos Y <-50)
sysvar(1) = 0

[State 40,2]
type = VarSet
triggerall = fvar(38) && Time = 0
trigger1 = ((random = [400-(P2bodydist X>180)*150,1000]) && enemy,numproj>0) &&  P2BodyDist X>100
trigger2 = P2Statetype=A && P2BodyDist X >=80 && enemynear,vel Y>=0 && enemynear,Pos Y <-55
trigger3 = P2bodydist X>=81 && random%5<ifelse(P2statetype=L,5,2)
trigger4 = P2bodydist X>=160
trigger5 = (P2bodydist X=[30,80])||(P2statetype=L&&enemynear,backedgebodydist<=5&&(P2stateno=[807,867]))
trigger6 = (enemynear,hitfall||(P2statetype=L&&enemynear,alive)) && P2bodydist X>180
trigger7 = (P2statetype!=A || (P2statetype=A && enemynear,Vel Y<=0 && enemynear,Pos Y>-40))
trigger7 = (P2bodydist X=[90+(const(size.xscale)*83-const(size.ground.front)),105+(const(size.xscale)*83-const(size.ground.front))]) && var(54)%7<6
sysvar(1) = 1

[State 40,3]
type = VarSet
triggerall = fvar(38) && enemy,numproj=0 && Time = 0
trigger1 = !(P2Statetype=A && enemynear,vel Y>=0 && P2bodydist X>60)
trigger1 = (P2BodyDist X =[80,160]) && random%7<2 && !(P2statetype=L&&enemynear,alive)
sysvar(1) = -1

;||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
;Player
[State 40,SysVarSet]
type = Varset
trigger1 = Time=0 && !fvar(38)
sysvar(1) = command="holdfwd"-command="holdback"

;ハイジャンプ用
[State 40,VarSet]
type = ChangeAnim
trigger1 = Time=0 && ((command="highjump"&&fvar(5)<9)||prevstateno=240)
value = 50

;ハイジャンプ用
[State 40,VarSet]
type = VarSet
trigger1 = Time=0
var(7)=0

;ハイジャンプ用
[State 40,VarAdd]
type = Varset
triggerall = !fvar(38)&&(var(58)=[0,2])
trigger1 = command="highjump"&&fvar(5)<9
var(7)=1

;ハイジャンプ用
[State 40,VarAdd]
type = Varset
triggerall = fvar(38)&&(var(58)=[0,2]) && time=0
trigger1 = P2bodydist X>=ifelse(var(33)!=0,120,160) && sysvar(1)
trigger2 = P2bodydist X<=80 && backedgebodydist <=30 && Power>=40*var(5) && var(33)=0
trigger3 = (P2bodydist X=[90,110]) && enemynear,backedgebodydist>5 && var(33)=0
var(7)=1

[State 40,SysVarSet]
type = HitBy
trigger1 = Time=0
value = SCA,AA,AP
time = ifelse(anim=50,5,3)

[State 40,PlaySnd]
type = PlaySnd
trigger1 = animtime=0
value = 40,0+(var(58)=[3,4])*100

[State 40,VelSet]
type = VelSet
trigger1 = AnimTime=0
x = ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),ifelse(sysvar(1)=-1,const(velocity.jump.back.x),0))
y = const(velocity.jump.y)-(var(58)=[3,4])*.5

[State 40,VelSet]
type = VelSet
trigger1 = AnimTime=0 && var(7)=1
x = ifelse(sysvar(1)=1,const(velocity.runjump.fwd.x),ifelse(sysvar(1)=-1,const(velocity.runjump.back.x),0))
y = const(velocity.jump.y)*1.15

[State 200]
type = Explod
trigger1 = animtime=0&&(var(58)=[3,4])
id = 6900
anim = 6900
pos = 0,-floor(vel Y)
postype = p1
pausemovetime=999
supermovetime=999
ownpal = 1
sprpriority = 4
facing=1-(sysvar(1)=-1)*2
scale = .5,.5
ignorehitpause=0

[State 40,ChangeState]
type = ChangeState
trigger1 = AnimTime=0
value = 50
ctrl = 1

;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;Jump
[Statedef 50]
type    = A
physics = N

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0 && PrevStateNo!=(45)
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0 && PrevStateNo=45
value = 52

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2 && PrevStateNo!=45
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2 && PrevStateNo=45
persistent = 0
value = 45

[State 50, AfterImage]
type = AfterImage
trigger1 = Time = 0
trigger1 = var(7)=1 && !(!var(41)&&var(43))
time=8
PalBright = 0,0,0
PalPostBright = -25,0,0
PalContrast = 256,256,256
PalAdd = 0,0,0
PalMul = 1,1,1
length = 4
trans = None
TimeGap  = 2
FrameGap = 2

[State 50, 1]
type = Gravity
trigger1 = !var(41)

[State 50, 1]
type = VelAdd
trigger1 = (var(41)=[1,5])
y = .52

[state 50]
type = Changestate
trigger1 = Vel Y>0 && Pos Y>=-Vel Y
value = 52


