triggerall = fvar(38)
trigger1 = time%4=0
var(28)=-2-(random%2=0)

[State 5910,Exit]
type = ChangeAnim
triggerall = Anim=5300
trigger1 = (command="fwd" || command="back" || command="up" || command="down")&&!fvar(38)
trigger2 = (command="x" || command="y" || command="z" || command="a" || command="b" || command="c")&&!fvar(38)
trigger3 = time%4=0 && fvar(38)
value = 5300
elem = ifelse(var(1)=7,1,var(1)+1)

[State 5910,Exit]
type = ChangeState
trigger1 = var(28)<=0
value = 0
ctrl = 1

