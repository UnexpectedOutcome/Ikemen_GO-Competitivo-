;=====Stun(me)

;+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-
;気絶
[Statedef 5300]
type = S
movetype = I
physics = S
ctrl = 0
velset = 0,0
anim = 5300

[State 5300,varset]
type = varSet
trigger1 = 1
var(1)=AnimElemNo(0)
ignorehitpause=1

[State 5300,varset]
type = varset
trigger1 = time=0&&var(30)<0
var(30)=-var(30)

[State 5300,varset]
type = varSet
trigger1 = time=0&&!var(30)
var(30)=1

[State 5300,varset]
type = varSet
trigger1 = time=0&&(var(58)=[3,4])
var(30)=-2

[State 5300,varset]
type = varset
trigger1 = 1
var(29)=0

[State 5300,varset]
type = varSet
trigger1 = time=0
var(28)=ifelse(var(30)=6||var(30)=2,150,ifelse((var(30)=[3,5]),120,90))+random%4*ifelse((var(30)=[1,2])||var(30)=4,20,40)

[State 5300,PlaySnd]
type = PlaySnd
trigger1 = time=0&&!numexplod(7500)&&!numexplod(7501)&&!numexplod(7502)&&!numexplod(7503)&&(var(58)=[3,4])
value = 5300,ifelse((var(58)=[3,4]),ifelse(var(0)%4=2,2,ifelse(var(0)%4=1||var(0)%4=3,0,1))+100,1)
channel = 25

[State 1000, Spark]
type = Explod
trigger1 = Time=0&&!numexplod(7500)&&!numexplod(7501)&&!numexplod(7502)&&!numexplod(7503)
Anim = ifelse((var(58)=[3,4]),7500+var(0)%4,7500+ifelse(var(0)%3=0,1,(var(0)%2=0)*3))
id = ifelse((var(58)=[3,4]),7500+var(0)%4,7500+ifelse(var(0)%3=0,1,(var(0)%2=0)*3))
pos = 0, const(size.head.pos.y)-10
postype = p1
sprpriority = 5
ownpal = 1
bindtime = -1
removetime=-1
ignorehitpause = 1
scale = .858,1.03
facing=ifelse(facing=-1,-1,1)
persistent=0

[State 5300,PlaySnd]
type = PlaySnd
trigger1 = ifelse(numexplod(7501)||numexplod(7503),time%50=0,ifelse(numexplod(7500),time%40=0,time%30=0))&&(var(58)=[0,2])
value = 5300,ifelse(numexplod(7501)||numexplod(7503),1,ifelse(numexplod(7500),0,2))
channel = 25

[State 5300,varset]
type = varAdd
trigger1 = (command="x" || command="y" || command="z" || command="a" || command="b" || command="c")&&!fvar(38)
trigger2 = 1
var(28)=-1

[State 5300,varset]
type = varAdd
triggerall = !fvar(38)
trigger1 = command="fwd" || command="back" || command="up" || command="down"
var(28)=-2

[State 5300,varset]
