;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000           ; 体力ゲージ、上限値（デフォルト：1000）
power = 3000	   ; パワーゲージ、デフォルト：1000
attack = 100         ; 攻撃力（％）
defence = 100        ; 防御力（％）
fall.defence_up = 50 ; 空中コンボ修正率（％）
liedown.time = 18    ; ダウン時間
airjuggle = 15       ; 空中コンボ
sparkno = 0          ; 初期ヒットスパーク番号
guard.sparkno = 40   ; 初期ガードスパーク番号
KO.echo = 0          ; ＫＯボイスエコー（0:OFF、1:ON）
volume = 150          ; キャラボイスボリューム値
IntPersistIndex = 57 ;次のラウンドに持ち越すVarを決める
FloatPersistIndex = 38;次のラウンドに持ち越すfVarを決める

[Size]
xscale = .858           ; 水平サイズ倍率
yscale = 1.06        ; 垂直サイズ倍率
ground.back = 22     ; キャラ幅（地上、後ろ側）
ground.front = 22    ; キャラ幅（地上、前側）
air.back = 22        ; キャラ幅（空中、後ろ側）
air.front = 22       ; キャラ幅（空中、前側）
z.width = 10         ; キャラ幅（ｚ軸）
height = 50	     ; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 0;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 4,-92     ; 頭部座標
mid.pos = -4,-60    ; 体中心部座標
shadowoffset = 0     ; キャラの影・オフセット値

[Velocity]
walk.fwd  = 3.75      ; 前進速度
walk.back = -2.5     ; 後退速度
run.fwd  = 8.0, -4.15    ; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -6.75,-3.85   ; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-9.6     ; 垂直ジャンプ速度
jump.fwd = 3.6      ; 前方ジャンプ速度
jump.back = -3.86    ; 後方ジャンプ速度
runjump.fwd = 4.72 ; 前方ハイジャンプ速度
runjump.back = -3.52 ; 後方ハイジャンプ速度
airjump.fwd = 6.5    ; 空中前方ジャンプ速度
airjump.back = -6.5 ; 空中後方ジャンプ速度

[Movement]
airjump.num = 0       ; 空中ジャンプ回数
;airjump.height = 35  ; 空中ジャンプ最低高度
yaccel = .52          ; キャラ重力加速度
stand.friction = .85  ; 摩擦係数（立ち状態）
crouch.friction = .82 ; 摩擦係数（しゃがみ状態）
