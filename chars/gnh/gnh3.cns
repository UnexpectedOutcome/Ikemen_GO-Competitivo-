[State 240, 軸位置移動]
type = PosAdd
trigger1 = (AnimElemTime(1) = 0)
trigger2 = (AnimElemTime(8) = 0)
trigger3 = (AnimElemTime(15) = 0)
trigger4 = (AnimElemTime(22) = 0)
trigger5 = (AnimElemTime(29) = 0)
trigger6 = (AnimElemTime(36) = 0)
trigger7 = (AnimElemTime(43) = 0)
trigger8 = (AnimElemTime(50) = 0)
x = ceil(20*Const(size.xscale)) 


[state velset]
type = velset
trigger1 = animelem = 57
x = 30
persistent= 0

[state velmul]
type = velmul
trigger1 = animelemtime(57) >= 0
trigger1 = animelemtime(61) < 0
x = .6

[state velmul]
type = velmul
trigger1 = animelemtime(61) > 0
x = .85

[state velset]
type = velset
trigger1 = animelem = 61
x = 0

[State 1220, 物理的なキャラの幅]
type = Width
trigger1 = animelemtime(61) <= 0
value = ceil(30*Const(size.xscale)),0

