;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]
;===========================================================================
;設定用変数セット記述
;===========================================================================

;---------------------------------------------------------------------------
;気合と根性ゲージセット /
;-----------------------
[State -2, 気合と根性ゲージ最大値]
type = varset
Trigger1 = 1
fvar(3)  = (50) ;( )内の数値を1以上で設定します

[State -2, 気合と根性ゲージX軸位置調整]
type = varset
Trigger1 = 1
var(3)  = (0) ;( )内の数値を好みで設定します 

[State -2, 気合と根性ゲージY軸位置調整]
type = varset
Trigger1 = 1
var(4)  = (0) ;( )内の数値を好みで設定します

[State -2, 根性カウントX軸位置調整]
type = varset
Trigger1 = 1
var(5)  = (0) ;( )内の数値を好みで設定します 

[State -2, 根性カウントY軸位置調整]
type = varset
Trigger1 = 1
var(6)  = (0) ;( )内の数値を好みで設定します

;---------------------------------------------------------------------------
;すごいガード時のエフェクト /
;---------------------------
[State -2, すごいガード時のエフェクト設定]
type = varset
Trigger1 = 1
var(1)  = (0) ;( )内の数値を1か0で設定する
              ;0だとプライマルアーマー風　1だと原作っぽく七色の爆発が出ます

;===========================================================================
;システム制御用記述
;===========================================================================
[State -2, システム制御用ヘルパー発生]
type = Helper
trigger1 = numhelper(7) = 0
helpertype = normal
name = "Number-seven"
ID = 7
pos = 0,0
postype = p1
facing = 1
stateno = 7
keyctrl = 0
ownpal = 1
supermovetime = 999999999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999999999

[State -2 ,システム制御用のヘルパーくらい出させろ]
type = AssertSpecial
trigger1 = roundstate <= 2
trigger1 = numhelper(7) = 0
flag = noko
flag2 = intro

[State -2 ,システム制御用のヘルパーくらい出させろ]
type = NotHitBy
trigger1 = roundstate < 2
value2 = SCA,AA,AP,AT
time = 5
supermovetime = 999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999  
ignorehitpause = 1
persistent= 1

;---------------------------------------------------------------------------
;気合と根性システム関連 /
;-----------------------
[State -2, 根性ゲージセット]
type = varset
Trigger1 = RoundState != 2
Trigger1 = fvar(0) != fvar(3)
fvar(0) = fvar(3)

[State -2, 気合ゲージセット]
type = varset
Trigger1 = RoundState != 2
Trigger1 = fvar(1) != fvar(3)
fvar(1) = fvar(3)

;---------------------------
[State -2, 気合ゲージ回復]
type = varadd
Trigger1 = RoundState = 2
Trigger1 = movetype != A
Trigger1 = var(2) = 0 ;気合と根性シールド時回復しないように
Trigger1 = stateno != [900,950] ;すごいガード時回復しないように
Trigger1 = fvar(1) < fvar(3)
fvar(1)  = (fvar(3)/900*(1+(ctrl = 1))/(1+(NumExplod(7050)!=0)))*(1+(var(40)*0.3)+(var(40)=10)*3)
ignorehitpause = 1
persistent= 1

[State -2,気合ゲージ枯渇]
type = varset
Trigger1 = RoundState = 2
Trigger1 = fvar(1) <= 0
Trigger1 = helper(7),NumExplod(7000) != 0
fvar(1)  = -fvar(3)
ignorehitpause = 1
persistent= 1

[State -2,気合ゲージ復帰]
type = varset
Trigger1 = RoundState = 2
Trigger1 = movetype != A
Trigger1 = fvar(1) > 0
Trigger1 = helper(7),NumExplod(7050) = 1
fvar(1)  = fvar(3)
ignorehitpause = 1
persistent= 1

[State -2, 気合ゲージ最大値オーバー時]
type = varset
Trigger1 = RoundState = 2
Trigger1 = fvar(1) > fvar(3)
fvar(1)  = fvar(3) 
ignorehitpause = 1
persistent= 1

;---------------------------
[State -2,根性ゲージ回復]
type = varadd
Trigger1 = RoundState = 2
Trigger1 = movetype != H
Trigger1 = var(2) = 0 ;気合と根性シールド時回復しないように
Trigger1 = stateno != [900,950] ;すごいガード時回復しないように
Trigger1 = fvar(1) > 0
Trigger1 = fvar(0) < fvar(3)
fvar(0)  = ((fvar(3)/600)*(fvar(1)/fvar(3))/(1+(ctrl = 0)+(NumExplod(7150)!=0)))*(1+(var(40)*0.3)+(var(40)=10)*3)
ignorehitpause = 1
persistent= 1

[State -2,根性ゲージ枯渇]
type = varset
Trigger1 = RoundState = 2
Trigger1 = fvar(0) <= 0
Trigger1 = helper(7),NumExplod(7100) != 0
fvar(0)  = -fvar(3)
ignorehitpause = 1
persistent= 1

[State -2,根性ゲージ復帰]
type = varset
Trigger1 = RoundState = 2
Trigger1 = movetype != H
Trigger1 = fvar(0) > 0
Trigger1 = helper(7),NumExplod(7150) = 1
fvar(0)  = fvar(3)
ignorehitpause = 1
persistent= 1

[State -2,根性ゲージ最大値オーバー時]
type = varset
Trigger1 = RoundState = 2
Trigger1 = fvar(0) > fvar(3)
fvar(0)  = fvar(3) 
ignorehitpause = 1
persistent= 1

[State -2,根性ゲージ最大値オーバー時]
type = varset
Trigger1 = RoundState = 2
Trigger1 = fvar(0) < -fvar(3)
fvar(0)  = -fvar(3) 
ignorehitpause = 1
persistent= 1


;---------------------------
[State -2, キャンセル回数リセット]
type = varset
Triggerall = RoundState = 2
Trigger1 = numtarget = 0
Trigger1 = ctrl = 1
var(10) = 0

[State -2, 行動ランクリセット]
type = varset
Triggerall = RoundState = 2
Trigger1 = numtarget = 0
Trigger1 = ctrl = 1
var(11) = 0

;空キャン判定用エフェクト消し
[State -2,コンタクト時に消える]
type = RemoveExplod
Trigger1 = movecontact = 1
trigger2 = ProjContact = 1
Trigger3 = MoveReversed  = 1
Trigger4 = movetype != A
Trigger5 = ctrl = 1
Trigger6 = numexplod(1430) != 0
ID = 77
supermovetime = 999999999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999999999
ignorehitpause	= 1

;補正判定用エフェクト消し
[State -2,ターゲットを保持しなくなったら解除]
type = RemoveExplod
Trigger1 = numtarget = 0
Trigger1 = NumExplod(14)!= 0
ID = 14
supermovetime = 999999999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999999999
ignorehitpause	= 1


;---------------------------
[State -2, 攻撃力=気合ゲージ比例]
type = AttackMulSet
trigger1 = fvar(1) > 0 
value = (0.1+(0.9*(fvar(1)/fvar(3))))*(0.8+(numtarget=0)*0.2-(prevstateno=stateno)*0.5)/(1+(NumExplod(14)!=0))

[State -2, 気合枯渇時]
type = AttackMulSet
trigger1 = fvar(1) <= 0 
value = 0.1

[State -2, 防御力=根性ゲージ比例]
type = DefenceMulSet
trigger1 = fvar(0) >= 0
value = 2-1*(fvar(0) / fvar(3))

[State -2, 根性枯渇時]
type = DefenceMulSet
trigger1 = fvar(0) <= 0 
value = 2

[State -2, 根性枯渇時]
type = AssertSpecial
trigger1 = fvar(0) <= 0
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

;---------------------------
[State -2, 念のため解除]
type = varset
trigger1 = (stateno != [900,950])
var(0) = 0
supermovetime = 999999999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999999999
ignorehitpause	= 1

;---------------------------------------------------------------------------
;エフェクト制御　 /
;-----------------
;150-エフェクト消し
[State -2,ガードEF]
type = RemoveExplod
Trigger1 = movetype = A
ID = 150

;-----------------------------------
;650-エフェクト消し
[State -2,斜め下]
type = RemoveExplod
Trigger1 = pos Y = 0
Trigger2 = stateno != 650
ID = 660

;-----------------------------------
;すごパ(物理)用エフェクト消し
[State -2,収束1002]
type = RemoveExplod
Trigger1 = (Anim!=1000)
Trigger2 = (Anim=1000)&&(AnimElemTime(17)>0)
Trigger3 = movetype != A
ID = 1002

;-----------------------------------
;すごパ(特殊)用エフェクト消し
[State -2,収束1002]
type = RemoveExplod
Trigger1 = (Anim!=1100)
Trigger2 = (Anim=1100)&&(AnimElemTime(21)>0)
Trigger3 = movetype != A
ID = 1102

;-----------------------------------
;すごいパンチ用エフェクト消アニメ
[State , 水平]
type = Explod
triggerall = numexplod(1010) != 0
triggerall = numexplod(1015) = 0
trigger1 = (stateno != 1000)&&(stateno != 1310)
trigger2 = (stateno = 1000)||(stateno = 2000)||(stateno = 3000)
trigger2 = ((animelem = 25)||(movecontact))
trigger3 = (anim = 1310)&&((animelem = 12)||(movecontact))
trigger4 = (stateno = 1000)||(stateno = 2000)||(stateno = 3000)
trigger4 = time <= 1
anim = 6605
ID = 1015
postype = P1
pos =  ceil(230*Const(size.xscale)),ceil(-150*Const(size.yscale))
facing = 1
vfacing= 1
scale = 1*Const(size.xscale),1*Const(size.yscale)
bindtime = 1
removetime = -2
sprpriority = 6
ontop = 1
shadow = 0, 0, 0
Trans = add   ;Add ,None, Add1, Sub, AddAlpha
ownpal = 1
ignorehitpause	= 1


;空中すごいパンチ用エフェクト消し
[State -2,水平]
type = RemoveExplod
Trigger1 = numexplod(1015) != 0
ID = 1010
ignorehitpause	= 1 

;-----------------------------------
;空中すごいパンチ用エフェクト消アニメ
[State , 斜め下]
type = Explod
trigger1 = numexplod(1600) != 0
trigger1 = numexplod(1605) = 0
trigger1 = (stateno != 1600) && (stateno != 1620)
anim = 6605
ID = 1605
postype = P1
pos = ceil(170*Const(size.xscale)),ceil(-180*Const(size.yscale))
facing = 1
vfacing= 1
scale = Const(size.xscale),Const(size.yscale)
bindtime = 1
removetime = -2
sprpriority = 6
ontop = 1
shadow = 0, 0, 0
Trans = add   ;Add ,None, Add1, Sub, AddAlpha
ownpal = 1


;空中すごいパンチ用エフェクト消し
[State -2,斜め下]
type = RemoveExplod
Trigger1 = numexplod(1605) != 0
ID = 1600

