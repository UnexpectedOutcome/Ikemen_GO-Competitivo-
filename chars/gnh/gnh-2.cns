;---------------------------------------------------------------------------
;デバッグ用スイッチ /　兼　パレットNoによる追加効果
;-------------------


[State -2, 気合ゲージ]
type = varset
Trigger1 = 0 ;★デバッグ用ゲージ満タン

Trigger2 = PalNo = 7
Trigger3 = PalNo = 9
Trigger4 = PalNo = 11
Trigger5 = PalNo = 12

fvar(1)  = (fvar(3)) 
ignorehitpause = 1
persistent= 1


[State -2, 根性カウント]
type = varset
Trigger1 = 0 ;★デバッグ用カウント入力

Trigger2 = PalNo = 8
Trigger3 = PalNo = 9
Trigger4 = PalNo = 11
Trigger5 = PalNo = 12

var(40) = 10 
ignorehitpause = 1
persistent= 1


[State -2, 通常ゲージ]
type = Poweradd
Trigger1 = 0 ;★デバッグ用ゲージ満タン

Trigger2 = PalNo = 10
Trigger3 = PalNo = 11
Trigger4 = PalNo = 12

value = 3000
ignorehitpause = 1
persistent= 1


[State -2, 根性ゲージ]
type = varset
Trigger1 = 0 ;★デバッグ用ゲージ満タン

Trigger2 = PalNo = 12

fvar(0)  = (fvar(3)) 
ignorehitpause = 1
persistent= 1


[State -2, 気合と根性シールド]
type = varset
Trigger1 = 0 ;★デバッグ用常時展開
var(2)  = 10 
ignorehitpause = 1
persistent= 1


;[シールド処理時保険]-----------------------------------
[State -2,水平]
type = lifeset
Trigger1 = roundstate >= 2
Trigger1 = numhelper(7) != 0
Trigger1 = helper(7),fvar(0) > 0
Trigger1 = var(2) != 0
value = ceil(helper(7),fvar(0))
ignorehitpause	= 1

[State -2,水平]
type = NotHitBy
Triggerall = roundstate >= 2
Triggerall = numhelper(7) != 0
Triggerall = var(2) != 0
trigger1 = (stateno >= 5000) 
trigger2 = (stateno < 5000) && (movetype = H)
value2 = ,AA,AP,AT
time = 90
supermovetime = 999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999  
ignorehitpause = 1
persistent= 1

[State -2,水平]
type = selfstate
Triggerall = roundstate >= 2
Triggerall = numhelper(7) != 0
Triggerall = var(2) != 0
triggerall = roundstate < 3
trigger1 = (stateno >= 5000) 
trigger2 = (stateno < 5000) && (movetype = H)
value = 1256
ignorehitpause	= 1 

;-----------------------------------
[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
;text = "sugoga=%d, sild=%d, kiai=%f, konjou=%f \n"
;params = var(0),var(2),fvar(1),fvar(0)
text = "Projsuu=%d, Projtime=%d, kiai=%f, konjou=%f \n"
params = var(50),var(52),fvar(1),fvar(0)
ignorehitpause	= 1


[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "Ckaisuu=%d, Krank=%d, P2dist X=%f, P2dist Y=%f \n"
params = var(10),var(11),(P2dist X),(P2dist Y)
ignorehitpause	= 1


[State -2, クリップボード（追加専用）]
type = null;AppendToClipboard
trigger1 = 1
text = "Position X=%d,Y=%d, Velocity X=%f,Y=%f, Hit=%d \n"
params = floor(Pos X),floor(Pos Y),(Vel X),(Vel Y),(MoveHit)

;===========================================================================
; 準常時監視ステート（－３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

;-----------------------------------
;すごい足踏み自分喰らい用
[State -3,喰らいステート移行]
type = ChangeState
triggerall = stateno != 1920
triggerall = var(2) = 0
triggerall = movetype != H
triggerall = (statetype = S)||(statetype = C)
triggerall = (stateno != [1500,1599])&&(stateno != [800,899]);投げ技中ではないとき
trigger1 = numexplod(1950) = 0
trigger1 = NumProjID(1950) != 0
trigger2 = ProjContactTime(1950) = 1 
value = 1920

;-----------------------------------
[State -3, 通常行動系音をstop]
type = StopSnd
trigger1 = movetype != I
channel = 3

;-----------------------------------

[State 195, 声]
type = PlaySnd
trigger1 = stateno != [120,159]
trigger1 = gethitvar(damage) != 0
trigger1 = random < gethitvar(damage)*5
value = 5, (5000 + (random%4))
channel = 0
lowpriority = 1


;===========================================================================
; システム制御用ヘルパー
;===========================================================================
[Statedef 7]
type    = A
movetype= I
physics = N
velset = 0,0
ctrl = 0

;[基本的な設定]-----------------------------------------------------------
[State 7];親と同じ方向向く
type = Turn
trigger1 = Root,Facing != Facing
supermovetime = 999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999
ignorehitpause	= 1

[State 7];親と同じ位置へ
Type = posset 
Trigger1 = 1
x = ceil(Root,pos x) 
y = ceil(Root,pos y)  
supermovetime = 999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999
ignorehitpause = 1

[State 7]
type = NotHitBy
trigger1 = 1
value = ,AA,AT
time=999
supermovetime = 999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999  
ignorehitpause = 1
persistent= 1

[State 7]
type = NotHitBy
trigger1 = Root,var(2) = 0
trigger2 = time <= 5
value2 = ,AA,AP,AT
time = 1
supermovetime = 999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999  
ignorehitpause = 1
persistent= 1

[State 7]
type = HitOverride
trigger1 = 1
slot = 0
attr = SCA, AA,AP,AT
stateno = 7
supermovetime = 999999999999999999999999999999999999999
pausemovetime = 999999999999999999999999999999999999999
ignorehitpause = 1 

;[気合と根性ゲージ表示]-----------------------------------------------------
;-------------------------------------------------
;1P側
;-------------------------------------------------
[State -2, 気合ゲージ下地]
type = Explod
