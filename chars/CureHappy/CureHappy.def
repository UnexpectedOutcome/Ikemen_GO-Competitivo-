
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "CureHappy"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "CureHappy"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 04,14,2002    ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002    ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "marisya"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 6,5,4,3,2,7   ;ＣＰＵで出てきた時のカラーパレットの順番


;--| 必要なファイルの設定 |---------------------------------------------------

[Files]
Cmd     = curehappy.cmd       ;コマンドファイルの登録
Cns     = curehappy.cns       ;コンスタンツファイルの登録
St      = curehappy.cns       ;ステートファイルの登録・最大１１個まで増やせます
                        ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                        ;「St」のみ必要な項目なので省略出来ません
StCommon = common1.cns  ;コモンステートファイルの登録
Sprite  = curehappy.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = curehappy.air       ;アニメーションファイルの登録
Sound   = curehappy.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録


;--| カラーパレットファイル |-------------------------------------------------

Pal1 = Happy3.act;Ａボタンで決定した色が使えます
Pal2 = Happy2.act
Pal3 = Happy1.act
Pal4 = Happy4.act
Pal5 = Happy5.act
Pal6 = Happy6.act

Pal7 = Happy7.act  ;Ｓ押しながらＡボタンで決定した色が使えます
Pal8 = Happy1.act  ;Ｓ押しながらＢ
Pal9 = Happy2.act  ;Ｓ押しながらＣ
Pal10= Happy3.act  ;Ｓ押しながらＸ
Pal11= Happy4.act  ;Ｓ押しながらＹ
Pal12= Happy5.act  ;Ｓ押しながらＺ

movelist = movelist.dat