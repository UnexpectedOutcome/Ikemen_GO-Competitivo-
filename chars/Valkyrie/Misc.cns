;===============================================================================
                                 ;Misc
;===============================================================================

[Statedef -2]

;=============================
;AI System
;=============================


;--------------------

; Shield
[State -2, Shield]
type = Helper
triggerall = numhelper(1) <= 0
trigger1 = roundstate = 2
helpertype = normal
name = "Shield"
id = 1
pos = 0, 0
postype = P1
stateno = 1
keyctrl = 0
ownpal = 0

[State -2, Damage Dampener]; If i left her attack with her normal damage,
;the fight wont be fun anymore ^_^
type = attackmulset
trigger1 = 1
value = 1/(hitcount/2 + 1)
ignorehitpause = 1

[State -2, AfterImage]; coolness
type = AfterImageTime
trigger1 = Vel X >= const(velocity.runjump.fwd.x)
ignorehitpause = 1
time = 2

[State -2, DisplayToClipboard]; Var Test
type = DisplayToClipboard
trigger1 = 1
text = "var(3) = %d, var(5) = %d,var(6) = %d,var(8) = %d,var(50) = %d"
params = var(3), var(5),var(6),var(8), var(50)

; Character Systems and other Stuff (Valkyrie Profile Related)

;===============================================================================
                               ;Charge Step System

;What this System does is whenever the player holds down a button(x,y,a,etc),
;the different vars located in here reads the input. When the count reach 20,
;automaticaly, after the normal attack is done, execute by itself, dealing 1.5
;addicional damage of the normal damage.
;===============================================================================
;===================
; Light Sword Attack
;===================
[State -2, VarAdd]
type = VarAdd
trigger1 = command = "hold_x"
var(5) = ifelse(var(5) = 20, 0,1)


[State -2, VarSet]
type = VarSet
trigger1 =  time <= 0
var(5) = 0

[State -2, Reset]
type = VarSet
trigger1 =  command != "hold_x"
var(5) = 0
;====================
; Strong Sword Attack
;====================
[State -2, VarAdd]
type = VarAdd
trigger1 = command = "hold_y"
var(6) = ifelse(var(6) = 20,0,1)

[State -2, VarSet]
type = VarSet
trigger1 =  time <= 0
var(6) = 0

[State -2, Reset]
type = VarSet
trigger1 =  command != "hold_y"
var(6) = 0
;====================
; Dash Attack
;====================
[State -2, VarAdd]
type = VarAdd
trigger1 = command = "hold_a"
var(7) = ifelse(var(7) = 20, 0,1)


[State -2, VarSet]
type = VarSet
trigger1 =  time <= 0
var(7) = 0

[State -2, Reset]
type = VarSet
trigger1 =  command != "hold_a"
var(7) = 0
;====================
; Stand Strng Smash
;====================
[State -2, VarAdd]
type = VarAdd
trigger1 = command = "hold_b"
var(8) = ifelse(var(8) = 20, 0,1)


[State -2, VarSet]
type = VarSet
trigger1 =  time <= 0
var(8) = 0

[State -2, Reset]
type = VarSet
trigger1 =  command != "hold_b"
var(8) = 0

;===============================================================================
;Glance Reviver

;"Divine sword imbued with the power to create worlds.
;Positive power is transformed into negative power to
;purify enemies."
;This Addon was a toughie ^_^. It adds an amount of life to the player when a
;sucessful hit connects. Simple you say? Not at all. The sucessful hit must have
;var(2) activated to do that. This addon has a 10% chance of activating, Plus the
;extra life is taken from p2 as an addicional damage using an invisible helper.
;===============================================================================
[State -2, VarAdd]; the main part of the system.
type = Varadd
triggerall = random <= 10; 10%
trigger1 = (stateno = [200,260]) && (movehit= 1);(Normal moves)
trigger2 = (stateno = [401,431]) && (movehit = 1);(EX moves)
trigger3 = stateno = 3002 && movehit = 1;(Hyper moves(only one for the moment)
trigger3 = !animelem = 22, >= 0
var(2) = 1
ignorehitpause = 0

[State -2, Glance Reviver Var]
type = VarSet
trigger1 = var(2) > 0 ; Initial Var
v = 2
value = 1
ignorehitpause = 0

[State -2, LifeAdd]; Life adder
type = LifeAdd
triggerall = var(2) = 1
trigger1 = (stateno = [200,260]) && (movehit = 1);(Normal moves)
trigger2 = (stateno = [401,431]) && (movehit = 1);(EX moves)
trigger3 = stateno = 3002 && movehit = 1;(Hyper moves(only one for the moment)
trigger3 = !animelem = 22, >= 0
value = 50

[State -2, Helper]; Inivisible Helper
type = Helper
triggerall = var(2) = 1
trigger1 = (stateno = [200,260]) && (movehit = 1);(Normal moves)
trigger2 = (stateno = [401,431]) && (movehit = 1);(EX moves)
trigger3 = stateno = 3002 && movehit = 1;(Hyper moves(only one for the moment)
trigger3 = !animelem = 22, >= 0
helpertype = normal
name = "Invisible"
id =9010
pos = 10, 0
postype = P1
stateno =9010
keyctrl = 0
ownpal = 1


[State -2, Glance Reviver Reset]; Reset after you have done your work
type = VarSet
trigger1 = numhelper(9010) > 0
v = 2
value = 0
ignorehitpause = 0
;===============================================================================
;Demon Sword " Levantine"

;"A magical black sword said to have been discovered
;in the stomach of the dragon Bloodbane."
; Just a  simple stats increase when low on hp
;===============================================================================

;===============================================================================
;CT Gauge(Charge Turn Gauge System)

[State -2, PowerAdd]
type = null;PowerAdd
trigger1 = !movehit = 1
value = -5

;===============================================================================

[Statedef -3]
;===============================================================================
;Guard Crush

;A great feature implemented in Valkyrie Profile is the guard crush. As the name
;says, it breaks Lenneth perfect guard, leaving her in a "Faint State". To break
;her guard, the main var(3) must reach 10 or greater to break it. Part of Code
;thanks to Mugenguild.com Code Archive.
;===============================================================================
[State -3, VarAdd]
type = Varadd
triggerall = (GetHitVar(HitShakeTime) = 5)
trigger1 = (StateNo = 150) || (StateNo = 152)
var(3) = 1
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
triggerall = (GetHitVar(HitShakeTime) = 10)
trigger1 = (StateNo = 150) || (StateNo = 152)
var(3) = 2
ignorehitpause = 1

[State -3, VarAdd]
type = Varadd
triggerall = (GetHitVar(HitShakeTime) = 15)
trigger1 = (StateNo = 150) || (StateNo = 152)
var(3) = 3
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
triggerall = (Var(3) > 0) && (!Time) && (StateNo = 5000) && (Alive)
trigger1 = (Anim = 5000) || (Anim = 5001) || (Anim = 5010) || (Anim = 5011)
var(3) = -3
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
triggerall = (Var(3) > 0) && (!Time) && (StateNo = 5010) && (Alive)
trigger1 = (Anim = 5020) || (Anim = 5021)
var(3) = -3
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
triggerall = (Var(3) > 0) && (!Time) && (StateNo = 5000) && (Alive)
trigger1 = (Anim = 5002) || (Anim = 5012)
var(3) = -6
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
trigger1 = (Var(3) > 0) && (!Time) && (StateNo = 5010) && (Alive) && (Anim = 5022)
var(3) = -6
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
trigger1 = (Var(3) > 0) && (!Time) && (StateNo = 5100) && (Alive)
var(3) = -9
ignorehitpause = 1
;=================
[State -3, VarAdd]
type = VarAdd
trigger1 = (Var(3) > 0) && ((GameTime%5) = 0) && (MoveType != H) && (StateNo != [130,160])
var(3) = -1
ignorehitpause = 1

[State -3, ChangeState]
type = ChangeState
trigger1 = var(3) >= 10
value = 9000
ctrl = 0
ignorehitpause = 1
;===============================================================================

