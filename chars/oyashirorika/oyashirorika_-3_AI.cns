[Statedef -3]
;---------------------------------------------------------------------------
;新MUGEN（MUGEN1.0）モード設定
;新MUGEN（MUGEN1.0）で使用する場合、下記の1項目の"null;"を消して下さい。
;下記のvarを有効にしないとゲージ、カットイン表示がずれたままで、
;ヒット硬直の1F減少の対応記述も有効になりません。
;WINMUGENで使用する場合は逆に必ず"null;"を付けて下さい。
;付けないとヒット硬直が1F増えて、エラーでMUGENが落ちてしまいます。

[State -3];新MUGENモード判定
type =null;Varset
trigger1 = 1
v = 45
value = 1

;■Ver2.00から廃止
;[State -3];GameWidth値セット
;type = null;Varset
;trigger1 = 1
;fv = 34
;value = GameWidth

;■Ver2.00から廃止
;[State -3];GameHeight値セット
;type = null;Varset
;trigger1 = 1
;fv = 35
;value = GameHeight


;---------------------------------------------------------------------------
;各種ゲージ表示位置設定
;各項目 value = ? の?部分 をお好みの数字に変えてください。
;正数だと下に下がって、負数（-）をつけると上に上がります。
;あまり大きい数字を入れると画面外にはみ出てしまいます。
;デフォルト（初期位置）に戻す場合は 0 にしてください。


[State -3];メタゲージ y座標
type = Varset
trigger1 = 1
v = 50
value = 0

[State -3];スペシャルゲージ y座標
type = Varset
trigger1 = 1
v = 53
value = 0

[State -3];パートナーゲージ y座標
type = Varset
trigger1 = 1
v = 54
value = 0; ←16：9比率で使用する時はこの数値（-14）にして下さい。

;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;■各種設定
:■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

[State -3];AI用ダメージタッチ使用頻度
type = Varset
trigger1 = 1
v = 32
value = 2
;0=使用しない、1=使用頻度低、2=使用頻度中（デフォルト値）、3=使用頻度高

[State -3];メタゲージ増加速度
type = Varset
trigger1 = 1
v = 33
value = 1
;1=遅い（デフォルト値）、2=普通、3=速い

[State -3];タッチゲージ増加速度
type = Varset
trigger1 = 1
fv = 20
value = 2
;1=遅い、2=普通（デフォルト値）、3=速い




;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ後の着地
trigger2 = stateno = 106 ;バックステップ後の着地
value = s6, 1


;■AI関係■■■■■■■■■■■■■■■■■■■■■■■■


;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;切り替えし
;PrevStateNo = [120,159] PrevStateNo = [5000,5270] EnemyNear,HitDefAttr = SCA,NT,ST,HT;投げ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -3,全てを呑み込む無慈悲なるリヴァイアサン]
Type = ChangeState
value = 4400
TriggerAll = var(59)!=0
TriggerAll = RoundState = 2
TriggerAll = EnemyNear,MoveType = A || EnemyNear,StateType = A
triggerall = var(28) = 720;タッチゲージが条件満たしている
triggerall = var(58) >= 300;パートナーゲージ3以上
Triggerall = var(57) = 2;パートナーがベルンカステル
Triggerall = NumHelper(365) =0;ベルンがいないこと
TriggerAll = Ctrl ||(StateNo = [100,101]) || StateNo = 52
Trigger1 = Random <= var(59)*60
Trigger1 = Enemynear,Time >=20-(var(59)>=8)*10-(var(59)>=9)*10-random%15 || var(59)>=10
;trigger1 = var(41) < var(40);全てを呑み込む無慈悲なるリヴァイアサン回数　<　全てを穿つ無慈悲なるミステリ回数

[State -3,全てを穿つ無慈悲なるミステリ]
Type = ChangeState
value = 4300
TriggerAll = var(59)!=0
TriggerAll = RoundState = 2
TriggerAll = EnemyNear,MoveType = A
triggerall = var(28) = 720;タッチゲージが条件満たしている
triggerall = var(58) >= 200;パートナーゲージ2以上
Triggerall = var(57) = 2;パートナーがベルン
Triggerall = NumHelper(365) =0;サトコがいないこと
TriggerAll = Ctrl ||(StateNo = [100,101]) || StateNo = 52
Trigger1 = Random <= var(59)*60
Trigger1 = Enemynear,Time >=20-(var(59)>=8)*10-(var(59)>=9)*10-random%15 || var(59)>=10
Trigger1 = P2BodyDist Y = [-70,70]
;trigger1 = var(40) <= var(41);全てを穿つ無慈悲なるミステリ回数　<=　全てを呑み込む無慈悲なるリヴァイアサン回数



;■トラップサトコ＆ベルンカステル、ダメージタッチ
[State -1, ダメージタッチ ]
type = ChangeState
value = 1100
triggerall= var(59)!=0
triggerall = var(58) >= 300;パートナーゲージ3以上
triggerall = var(28) = 720;タッチゲージが条件満たしている
triggerall = movetype = H
triggerall = stateno != [120,155]
triggerall = stateno != [5080,5150]
triggerall = ctrl = 0
triggerall = alive = 1
triggerall = statetype != L
triggerall = RoundState = 2
triggerall = var(31)=0;AI用ダメージタッチ使用可能フラグ1
triggerall = var(32)>=1;AI用ダメージタッチ使用可能フラグ2
Trigger1 = Random <= 400 && statetime =[1,2]

;■対空
;■オヤシロアッパー
