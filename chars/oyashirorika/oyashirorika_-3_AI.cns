TriggerAll = var(59) !=0
TriggerAll = RoundState = 2
triggerAll = var(28) = 720;タッチゲージが条件満たしている
Triggerall = var(57) = 2;パートナーがベルン
TriggerAll = NumHelper(365) =0;ベルンがいないこと
triggerAll = ctrl
;triggerall = var(58) <= 300 && (power<=2000 || var(19)=0)
Trigger1 = Random <= var(59)*3-(var(59)<=8)*20
Trigger2 = EnemyNear,MoveType = A;攻撃中の相手へのカウンター
Trigger2 = Random <= var(59)*5-(var(59)<=8)*20
Trigger2 = var(59)>=7
Trigger3 = var(59)<=7
Trigger3 = Random <= 3
Stateno  = 4200
ID       = 365
Pos      = 120,0
PosType  = P2
OwnPal   = 1
size.xscale =0.5
size.yscale =0.5
SuperMoveTime = 0
PauseMoveTime = 0
IgnoreHitPause = 1
Persistent = 0
facing = -1

;■投げ
[State -3,投げ]
Type = ChangeState
value = 800
TriggerAll = var(59)!=0
TriggerAll = RoundState = 2
TriggerAll = StateType != A
TriggerAll = EnemyNear,StateType != L
TriggerAll = !InGuardDist
TriggerAll = EnemyNear,MoveType != H
TriggerAll = P2BodyDist X = [-2,20+vel x*1]
TriggerAll = P2BodyDist Y = [-60+vel y*5,0]
TriggerAll = EnemyNear,Statetime >= 4
TriggerAll = Ctrl ||(StateNo = [100,101]) || StateNo = 52
Trigger1 = var(59)>=8
Trigger1 = Random <= var(59)*60
trigger2 = var(59)<=7
Trigger2 = Random <= var(59)*10

