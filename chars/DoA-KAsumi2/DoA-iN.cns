; Generate 8 explosions within a circle - fire
[StateDef 8211]
Type = S
movetype = I
physics = N
ctrl = 0
anim = 9999

[state 4002, Scale]
Type = VarSet
trigger1 = time = 0
fvar(1) = 0.2 + 0.8 * random/1000.0

[State 4002, Generate my angle orientation]
Type = VarSet
trigger1 = !var(0)
fvar(0) = 10.0 + 20.0 * random/1000.0

[State 4002, Generate my angle orientation]
Type = VarSet
trigger1 = var(0) > 0
fvar(0) = 45 + fvar(0)

[State 4002, Convert it to radians]
Type = VarSet
trigger1 = time = 0
fvar(2) = fvar(0) * 0.01745329

[State 4002, Explod]
Type = Explod
trigger1 = time = 0
anim = 8211;8208
pos = 0,0
random = 20, 16
ownpal = 1
id = 8211
sprpriority = 3
ignorehitpause = 1
vel = 10.5 * cos(fvar(2)), 10.5 * -(1.0 - abs(cos(fvar(2)))) * ifelse(var(0) >= 4, -1, 1)
accel = -0.4 * cos(fvar(2)), -0.4 * -(1.0 - abs(cos(fvar(2)))) * ifelse(var(0) >= 4, -1, 1)
scale = fvar(1), fvar(1)
facing = 1
supermove = 9999999
pausemovetime = 999999

[State 4002, VarAdd]
Type = VarAdd
trigger1 = time = 0
v = 0
value = 1

[State 4002, Loop]
Type = ChangeState
trigger1 = var(0) < 12
value = 8211

[State 4002, DestroySelf]
Type = DestroySelf
trigger1 = var(0) = 12


