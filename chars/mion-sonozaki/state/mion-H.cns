attr = S, HA
damage = ceil(500+(var(25))),10
hitflag = MAFD 
guardflag = 
Animtype = DiagUp
air.Animtype = DiagUp
priority = 6, Hit
sparkno = s6017
sparkxy = 0,-115
hitsound   = s0,31
pausetime = 0,0
guard.pauseTime = 15,15
ground.slideTime = 19
guard.slideTime = 17
ground.hitTime = 19
guard.hitTime = 17
air.hitTime = 22
getpower = 0,0 
ground.velocity = -8,-13
guard.velocity = -5
air.velocity = -8,-14
airguard.velocity = -4,2
givepower = 50,15
sprpriority = 1
p1facing = 1
p2facing = 1
guard.dist = 0 ;相手のガード態勢に入る距離
fall = 1
air.fall = 1
fall.recoverTime = 180
kill = 1
guard.kill = 1
ID = 2300
IgnoreHitPause = 1
persistent = 0

[State 2000, 0]
type = null;TargetState
trigger1 = MoveHit
trigger1 = NumTarget(2300) >= 1
trigger1 = !Target,IsHelper
value = 2050
ctrl = 0
IgnoreHitPause = 1
persistent = 0

[State 2000, 0]
