Trigger1 = time = 1
var(23) = 240
ignorehitpause = 1

[State 2000, 3]
type = StateTypeSet
trigger1 = AnimElem = 4
statetype = A

[State 2000, 3]
type = StateTypeSet
trigger1 = AnimElem = 12
statetype = S

[State 2000, 3]
type = NotHitBy
trigger1 = Time = [0,9]
value = SCA

