[State 15000, 相手ステートに戻す]
type = SelfState
triggerall = (HitShakeOver)
trigger1 = (!Alive) ;生きていない時（ライフが０の場合）
value = 5150
ctrl     = 0

[State 2051, 相手ステートに戻す]
type = SelfState
trigger1 = (Time > 70-GetHitVar(hitcount)*5 ) && (Alive)
value = 0
ctrl = 1


