type    = A
movetype = H
physics = N
ctrl     = 0

[State HitF, 1]
type = Hitfallset
trigger1 = 1
value = 1

[State VelS, 1]
type = velset
trigger1 = time = 0
y = Gethitvar(yvel)

[State VelA, 1]
type = veladd
trigger1 = 1
y = 0.4

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = SelfAnimExist(5035)
value = 5035

[State ChangeA, 1]
type = ChangeAnim
trigger1 = anim = 5035
trigger1 = animtime = 0
value = 5050

[State ChangeS, 1];でふぉ
type = ChangeState
trigger1 = time > 1
trigger1 = Pos Y > 0
trigger1 = Vel Y >= 0
value = 6570
ctrl = 0

