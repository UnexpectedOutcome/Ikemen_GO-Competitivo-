supermove = 1      ;「SuperPause」による時間停止中にもこのアニメが動くかどうか。
supermovetime = 999 ;「SuperPause」での時間停止を無視して有効にする時間を設定。
pausemovetime = 999  ;「Pause」での時間停止を無視して有効にする時間を設定。
vel = 0,0          ;エフェクトの移動速度（Ｘ軸,Ｙ軸）
accel = 0.5,0.5    ;エフェクトの加速度（Ｘ軸,Ｙ軸）
removeongethit = 1 
ignorehitpause = 1 ;「ヒット硬直」を無視して有効にするかどうか。（デフォルトは１）
shadow = 0,0,0     ;エフェクトの影（赤,緑,青）
;trans = Add1   ;エフェクトの透過処理（Add,Add1,Sub,None,AddAlpha）
alpha = 256,256    ;transが「AddAlpha」の時に適用する透過処理の度合（明るさ,コントラスト


[State 2300, 音を鳴らす]
type = null;PlaySnd
trigger1 = AnimElemTime(1) = 2 ;アニメ５枚目内の６フレーム目になったら有効。
value = 0, 2   ;sndファイルから鳴らしたい音を呼び出す。
channel = 4      ;この音のチャンネル。同じチャンネルの前の音を中断して鳴らし直したり、
volume = 128     ;音量。最小-255・最大255。デフォルトは0。

[State 2300, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
[Statedef 2301, 空気投げ、攻撃判定]
type     = S        ;このステートの「状態」を指定。
movetype = A       ;このステートの「行動内容」を指定。
physics  = S       ;このステートの「実際の物理的な体勢」を指定。「小ネタ.txt」参照。
anim     = 2201     ;アニメを指定（アクションナンバー）。この場合airの[Begin Action 1000]を呼び出し使う。
velset   = 0,0      ;このステートを開始した瞬間の移動速度（Ｘ軸,Ｙ軸）。効果は「VelSet」を参照。
ctrl     = 0        ;このステート中にキーコントロールを可能にさせるかどうか。1でさせる。
poweradd = 0       ;パワーゲージの増減量。1以上で増え、-1以下で減る。
juggle   = 0        ;ジャグルポイントの消費量。ジャグルについては「小ネタ.txt」参照。
facep2   = 1        ;このステートを開始した瞬間に相手の方へ振り向くかどうか。1で向く。
movehitpersist = 0  ;前のステートからの「攻撃をヒットさせた状態」を持続させるかどうか。1でさせる。
hitcountpersist = 0 ;前のステートからの「HitCount」「UniqHitCount」の効果を持続させるかどうか。1でさせる。
sprpriority = 0  

[State 2000, 3]
type = NotHitBy
trigger1 = 1
value = SCA

[State 2000, 音を鳴らす]
type = null;PlaySnd
trigger1 = AnimElemTime(4) = 1 ;アニメ５枚目内の６フレーム目になったら有効。
value = 0, 2   ;sndファイルから鳴らしたい音を呼び出す。
channel = 4      ;この音のチャンネル。同じチャンネルの前の音を中断して鳴らし直したり、
volume = 128     ;音量。最小-255・最大255。デフォルトは0。

