[State 2000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElemTime(4) = 1 ;アニメ５枚目内の６フレーム目になったら有効。
value = 0, 2   ;sndファイルから鳴らしたい音を呼び出す。
channel = 4      ;この音のチャンネル。同じチャンネルの前の音を中断して鳴らし直したり、
volume = 128     ;音量。最小-255・最大255。デフォルトは0。

[State 2000, 基本]
type = HitDef
trigger1 = AnimElem = 4
attr = A, HA
damage = ceil(20*(1-(var(4)*0.05))),10
hitflag = MAFD 
guardflag = M
priority = 1, Miss
sparkno = s6017
sparkxy = 0,-115
hitsound   = s0,31
pausetime = 3,3
guard.pausetime = 3,3
getpower = 0,0 
givepower = 20,5
sprpriority = 1
p1facing = 1
p2facing = 1
guard.dist = 50 ;相手のガード態勢に入る距離
fall = 1
kill = 0
guard.kill = 0

