type     = S
movetype = I
physics  = S

[State 2051, 喰らいアニメ]
type = ChangeAnim
triggerall = Time = 0 
trigger1 = SelfAnimExist(5300) 
;trigger1 = Alive = 0
value = 5300
IgnoreHitPause = 1
Persistent = 0

[State 2051, 喰らいアニメ]
type = ChangeAnim2
triggerall = Time = 0 
trigger1 = !SelfAnimExist(5300)
;trigger1 = Alive = 1
value = 2051
IgnoreHitPause = 1
Persistent = 0

[State 15000, 相手ステートに戻す]
type = SelfState
triggerall = (HitShakeOver)
trigger1 = (!Alive) ;生きていない時（ライフが０の場合）
value = 5150

[State 2051, 相手ステートに戻す]
type = SelfState
trigger1 = (Time > 70) && (Alive)
value = 0
ctrl = 1


