;=========================================================================================
;超必殺技
[Statedef 2000, 園崎スペシャル]
type     = S        ;このステートの「状態」を指定。
movetype = A       ;このステートの「行動内容」を指定。
physics  = S       ;このステートの「実際の物理的な体勢」を指定。「小ネタ.txt」参照。
anim     = 2000     ;アニメを指定（アクションナンバー）。この場合airの[Begin Action 1000]を呼び出し使う。
velset   = 0,0      ;このステートを開始した瞬間の移動速度（Ｘ軸,Ｙ軸）。効果は「VelSet」を参照。
ctrl     = 0        ;このステート中にキーコントロールを可能にさせるかどうか。1でさせる。
poweradd = -1000        ;パワーゲージの増減量。1以上で増え、-1以下で減る。
juggle   = 0        ;ジャグルポイントの消費量。ジャグルについては「小ネタ.txt」参照。
facep2   = 1        ;このステートを開始した瞬間に相手の方へ振り向くかどうか。1で向く。
movehitpersist = 0  ;前のステートからの「攻撃をヒットさせた状態」を持続させるかどうか。1でさせる。
hitcountpersist = 1 ;前のステートからの「HitCount」「UniqHitCount」の効果を持続させるかどうか。1でさせる。
sprpriority = 0  

[State 2000, 3]
type = StateTypeSet
trigger1 = AnimElem = 4
statetype = A

[State 2000, 3]
type = StateTypeSet
trigger1 = AnimElem = 12
statetype = S

[State 2000, 3]
type = NotHitBy
trigger1 = Time = [0,9]
value = SCA

[State 2000, 3];暗転
type = SuperPause
trigger1 = AnimElem = 1
time = 20
anim = s10010
sound = s0,24
pos = 0,-50
postype = p1
sprpriority = 0
movetime = 0
darken = 1
p2defmul = 1
unhittable = 1

;=====================================

;=====================================

[State 2000, エフェクト画像]
type = Explod
trigger1 = AnimElem = 1 
anim = 10000        ;エフェクトのアニメ（アクションナンバー）
pos = -60,0         ;エフェクトの座標（Ｘ軸,Ｙ軸）
postype = back       ;エフェクトの位置属性（p1・p2・front・back・left・right）
facing = 1         ;エフェクトの左右の向き（1=そのまま,-1=左右反転）
vfacing = 1        ;エフェクトの上下の向き（1=そのまま,-1=上下反転）
scale = 0.5,0.5    ;エフェクトの大きさ（Ｘ軸,Ｙ軸）
sprpriority = 1    ;エフェクトの画像表示優先度
ownpal = 1         ;エフェクトの色を独立させるか否か（0=させない,1=させる）
ontop = 0         ;エフェクトを常に画面手前に表示させるか否か（0=させない,1=させる）
bindtime = 27      ;「このエフェクトを発生させた親」に『くっ付ける時間』（フレーム）
removetime = 27    ;このエフェクトが消えるまでの時間（フレーム）
supermove = 1      ;「SuperPause」による時間停止中にもこのアニメが動くかどうか。
supermovetime = 999 ;「SuperPause」での時間停止を無視して有効にする時間を設定。
pausemovetime = 999  ;「Pause」での時間停止を無視して有効にする時間を設定。
vel = 0,0          ;エフェクトの移動速度（Ｘ軸,Ｙ軸）
accel = 0.5,0.5    ;エフェクトの加速度（Ｘ軸,Ｙ軸）
removeongethit = 1 
ignorehitpause = 1 ;「ヒット硬直」を無視して有効にするかどうか。（デフォルトは１）
shadow = 0,0,0     ;エフェクトの影（赤,緑,青）
;trans = AddAlpha   ;エフェクトの透過処理（Add,Add1,Sub,None,AddAlpha）
;alpha = 256,256    ;transが「AddAlpha」の時に適用する透過処理の度合（明るさ,コントラスト

