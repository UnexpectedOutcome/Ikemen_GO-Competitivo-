;---------------------------------------------------------------------------------
[Statedef 3000, カーネージナター呼び出し]    
type     = S       
movetype = I        ;このステートの「行動内容」を指定。
physics  = S        ;このステートの「実際の物理的な体勢」を指定。「小ネタ.txt」参照。
anim     = 3004    ;アニメを指定（アクションナンバー）。この場合airの[Begin Action 1000]を呼び出し使う。
poweradd = 0
velset   = 0,0      ;このステートを開始した瞬間の移動速度（Ｘ軸,Ｙ軸）。効果は「VelSet」を参照
SprPriority = 3
ctrl = 0

[State 1,リバサ変数リセット]
