;------------------------------------------------------------
[Statedef 20];前進＆後退
type=U
movetype=U
physics=U
hitdefpersist=1
movehitpersist=1
[State ]
type=ChangeState
trigger1=ishelper
value=2147483647
persistent=256
ignorehitpause=1
[State ]
type=statetypeset
trigger1=1
statetype=S
movetype=I
physics=N
ignorehitpause=1
[State ]
type=velmul
trigger1=1
x=const(movement.stand.friction)
ignorehitpause=1
[State ]
type=posset
trigger1=1
Y=0
ignorehitpause=1
[State ]
type=VelSet
trigger1=command="holdfwd"
x=const(velocity.walk.fwd.x)
y=0
ignorehitpause=1
[State ]
type=VelSet
trigger1=command="holdback"
x=const(velocity.walk.back.x)
y=0
ignorehitpause=1
[State ]
type=ChangeAnim
trigger1=Vel X&&((Anim!=20+!!(Vel X<0))&&(Anim!=5||Anim=5&&AnimTime=0))
value=20+!!(Vel X<0)
ignorehitpause=1
[State ]
type=ChangeState
trigger1=!Vel X||roundstate>2
value=0
persistent=256
ignorehitpause=1


;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = A
physics = N
anim = 40
ctrl = 0
velset = 0,0
sprpriority = 0

[state -2]
type = nothitby
trigger1 = 1
value = ,AT

[state -2]
type = AfterImage
trigger1 = time = 0
time = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = (command = "holdfwd") - (command = "holdback")

[State 40, vel x]
type = VelSet
trigger1 = AnimTime=0&&var(40)<=0
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
[State 40, vel x]
type = VelSet
trigger1 = AnimTime=0&&var(40)>0
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))

[State 40, vel y]
type = VelSet
trigger1 = AnimTime = 0
y = const(velocity.jump.y)*ifelse(command="holdup",1.0,0.80)

[State 5100, 8]
type = posfreeze
trigger1 = 1

[State -3, Landing Sound]
type = PlaySnd
trigger1 = animtime = 0
value = 0, 0+ifelse(var(40)>0,ifelse(vel X=0,0,1),0)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50-ifelse(var(40)>0,ifelse(vel X=0,0,1),0)
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

