;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5001, 2]
type = ChangeAnim
triggerall = (GetHitVar(hittime)>=32)&&time=0
trigger1 = (anim=[5000,5004])||(anim=[5010,5014])
value = ifelse((anim=[5000,5004]),5004,5014)
[State 5001, 2]
type = ChangeAnim
triggerall = (GetHitVar(hittime)=[26,31])&&time=0
trigger1 = (anim=[5000,5004])||(anim=[5010,5014])
value = ifelse((anim=[5000,5004]),5003,5013)
[State 5001, 2]
type = ChangeAnim
triggerall = (GetHitVar(hittime)=[18,25])&&time=0
trigger1 = (anim=[5000,5004])||(anim=[5010,5014])
value = ifelse((anim=[5000,5004]),5002,5012)
[State 5001, 2]
type = ChangeAnim
triggerall = (GetHitVar(hittime)=[13,17])&&time=0
trigger1 = (anim=[5000,5004])||(anim=[5010,5014])
value = ifelse((anim=[5000,5004]),5001,5011)
[State 5001, 2]
type = ChangeAnim
triggerall = (GetHitVar(hittime)<=12)&&time=0
trigger1 = (anim=[5000,5004])||(anim=[5010,5014])
value = ifelse((anim=[5000,5004]),5000,5010)

[State 5010, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger2 = anim = [5000,5029]
trigger2 = GetHitVar(yvel) != 0 || GetHitVar(fall)
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
