
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 0, 3] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 0, 4]
type = DestroySelf
trigger1 = IsHelper

[State 0, 5]
type = AfterImage
trigger1 = time = 0
time = 1

[State 0, 6]
type = Turn
trigger1 = var(59) = 1 && ctrl = 0
trigger1 = teammode = single || teammode = turns
trigger1 = p2dist x < 0

