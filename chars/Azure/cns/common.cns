trigger1 = time = 0
value = 5100+ifelse(SelfAnimExist(5101)&&((anim=[5061,5062])||anim=5902),1,0)+ifelse(SelfAnimExist(5101)&&(anim=[5070,5071]),1,0)

[State 5100, 5]
type = posfreeze
trigger1 = 1
time = 1

[State 5100, 9]
type = HitFallDamage
trigger1 = Time = 0

[State 5100, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 5101

[State 5100, 13]
