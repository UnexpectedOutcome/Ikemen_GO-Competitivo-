trigger1 = Anim != 5040
trigger2 = Time = 0
trigger2 = Anim != 5035
value = 5040

[State 5040, 3]
type = nothitby
trigger1 = HitOver
trigger2 = Vel Y > 0
trigger2 = Pos Y >= 0
value = SCA,AA,AT,AP
time = 1

[State 5040, 4]
