trigger1 = Time = 0
trigger1 = alive
trigger1 = var(3) > 0
trigger1 = gethitvar(fall.recover) = 1
trigger1 = (gethitvar(fall.recovertime)-gethitvar(fall.time))<=0||var(0)>=1
value = 5200

[State 5100, 4]
