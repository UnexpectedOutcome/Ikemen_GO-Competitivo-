[State 2017, End]
type = SelfState
trigger1 = time = 3
value = 5050

;---------------------------------------------------------------------------
; Mirror Advance

[Statedef 2020]
type    = S
movetype= A
physics = N
juggle  = 1
;Commonly-used controllers:
ctrl = 0    
sprpriority = 4
superpausemovetime = 9999

[State 2020, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 2020, NoFG, NoBG, NoBarDisplay]
type = AssertSpecial
trigger1 = 1
flag = NoFG
flag2 = NoBG
flag3 = NoBarDisplay

[State 2020, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0

[State 2020, End]
type = ChangeState
triggerall = time > 20
trigger1 = p2dist x = [140*const(size.xscale), 170*const(size.xscale)]
trigger2 = p2dist x < 140*const(size.xscale)
trigger2 = backedgebodydist <= 0
trigger3 = p2dist x = [100*const(size.xscale), 200*const(size.xscale)]
trigger3 = time = 0
value = 2021
ctrl = 1

[State 2020, SuperPause]
type = SuperPause
trigger1 = 1
time = 2
anim = -1
sound = -1, -1
movetime = 2
darken = 0
p2defmul = 1
unhittable = 0

[State 2020, VelSet]
type = VelSet
trigger1 = time = 21
trigger1 = p2dist x > 170*const(size.xscale)
x = const(velocity.walk.fwd.x)

[State 2020, VelSet]
type = VelSet
trigger1 = time = 21
trigger1 = p2dist x < 140*const(size.xscale)
x = const(velocity.walk.back.x)

[State 2020, ChangeAnim]
type = ChangeAnim
trigger1 = anim != 10020
trigger1 = vel x > 0
value = 10020

[State 2020, ChangeAnim]
type = ChangeAnim
trigger1 = anim != 10021
trigger1 = vel x < 0
value = 10021

