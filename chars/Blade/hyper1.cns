;---------------------------------------------------------------------------
; Mirror Attack

[Statedef 2000]
type    = S
movetype= A
physics = N
juggle  = 1
;Commonly-used controllers:
ctrl = 0    
sprpriority = 0
hitdefpersist = 1

[State Armour StateNo]
type = VarSet
trigger1 = time = 0
var(0) = StateNo 

[State Armour ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno != 9000
value = 2000

[State Armour Velset]
type = VelSet
trigger1 = time = 0
x = fvar(0)*prevstateno = 9000
y = fvar(1)*prevstateno = 9000

[State 2000, SuperPause]
type = SuperPause
trigger1 = anim = 2000
trigger1 = animelem = 1
time = 80
pos = -20*const(size.xscale), -105*const(size.yscale)
anim = s7300
sound = s2000, 0
poweradd = -1000
movetime = 80
p2defmul = 1
darken = 0

[State 2000, BGPalFX]
type = BGPalFX
trigger1 = anim = 2000
trigger1 = animelem = 1
time = 79
mul = 32,32,32


[State 2000, PlaySnd]
type = PlaySnd
trigger1 = anim = 2000
trigger1 = time = 10
channel = 0
value = 2000, 1

[State 2000, PlaySnd]
type = PlaySnd
trigger1 = anim = 2000
trigger1 = time = 40
value = 2000, 2

[State 2000, PlaySnd]
type = PlaySnd
trigger1 = anim = 2005
trigger1 = animelem = 15
trigger1 = time != 0
value = 2000, 3

[State 2000, Explod]
type = Explod
trigger1 = anim = 2000
trigger1 = animelem = 8
anim = 2001
id = 2001
scale = const(size.xscale), const(size.yscale)
postype = p1
vel = -5, 0
accel = 0.1, 0.1
pos = floor(-176*const(size.xscale)), floor(-131*const(size.yscale))
supermovetime = 70
removetime = 40

[State 2000, 7]
type = ChangeAnim
trigger1 = anim = 2000
trigger1 = animtime = 0
value = 2005

[State 2000, 7]
type = ChangeAnim
trigger1 = anim = 2005
trigger1 = !numhelper(2010)
trigger1 = animelemno(0) > 49
value = 2006

[State 2000, 7]
type = ChangeAnim
trigger1 = anim = 2005
trigger1 = numhelper(2010)
trigger1 = helper(2010), stateno = 2012
trigger1 = animelemno(0) > 49
value = 2020

[State 2000, 2]
type = HitDef
trigger1 = !var(22)
trigger1 = animelem = 1
attr = S, HP
damage = 80, 16
guardflag = HA
priority = 5
pausetime = 9,9
sparkno = 2
sparkxy = -10,floor(const(size.yscale)*-100)
hitsound   = s5,1
guardsound = s6,0
animtype = Medium
ground.type = High
ground.slidetime = 17
ground.hittime  = 17
ground.velocity = -16*const(size.xscale)
air.hittime = 30
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536
air.fall = 1
fall.recover = 1
getpower = 0, 0

[State 2000, 2]
type = HitDef
trigger1 = var(22)
trigger1 = animelem = 1
attr = S, HP
damage = 80, 16
guardflag = HA
priority = 5
pausetime = 9,9
sparkno = s7001
guard.sparkno = s7006
sparkxy = -10,floor(const(size.xscale)*-110)
hitsound   = s5,1
guardsound = s6,0
animtype = Medium
ground.type = High
ground.slidetime = 17
ground.hittime  = 17
ground.velocity = -16*const(size.xscale)
air.hittime = 30
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536
air.fall = 1
fall.recover = 1
getpower = 0, 0

[State 2000, Helper]
type = Helper
trigger1 = anim = 2005
trigger1 = animelem = 32
trigger1 = !numhelper(2010)
name = "Mirror"
id = 2010
stateno = 2010
pos = floor(90.0*const(size.xscale)),floor(-97.0*const(size.yscale))
ownpal = 1
supermovetime = 99999

[State 2000, Helper]
type = Helper
trigger1 = anim = 2006
trigger1 = !numhelper(2007)
name = "Blade's Lance"
id = 2007
stateno = 2007

[State 2000, Helper]
type = Helper
trigger1 = anim = 2006
trigger1 = !numhelper(2008)
name = "Blade's Mantle"
id = 2008
stateno = 2008
ownpal = 1

[State 2000, Helper]
type = Helper
trigger1 = anim = 2006
trigger1 = !numhelper(2009)
name = "Blade's Cape"
id = 2009
stateno = 2009
ownpal = 1

[State 2000, SuperPause]
type = SuperPause
trigger1 = numhelper(2010)
trigger1 = helper(2010), stateno = 2012
trigger1 = helper(2010), time > 38
time = 2
anim = -1
sound = -1, -1
movetime = 2
darken = 0
p2defmul = 1
unhittable = 0

[State 2000, NoFG, NoBG, NoBarDisplay]
type = AssertSpecial
trigger1 = numhelper(2010)
trigger1 = helper(2010), stateno = 2012
trigger1 = helper(2010), time > 37
flag = NoFG
flag2 = NoBG
flag3 = NoBarDisplay

[State 2000, SprPriority]
type = SprPriority
trigger1 = numhelper(2010)
trigger1 = helper(2010), stateno = 2012
trigger1 = helper(2010), time = 38
value = 5

[State Idle Anim]
type = StateTypeSet
trigger1 = anim = 2005
trigger1 = animelem = 33
movetype = I

[State 2000, 7]
type = ChangeState
trigger1 = anim = 2006
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 2000, Success]
type = ChangeAnim
trigger1 = anim = 2020
trigger1 = animtime = 0
value = 10000

[State 2000, NotHitBy]
type = NotHitBy
trigger1 = 1
value = , AT
time = 1

[State 2000, NotHitBy]
type = NotHitBy
trigger1 = numhelper(2010)
trigger1 = helper(2010), stateno = 2012
value2 = SCA
time = 1

[State 2000, Helper]
type = Helper
triggerall = !numhelper(2026)
trigger1 = numhelper(2010)
trigger1 = helper(2010), stateno = 2012
trigger1 = helper(2010), anim > 2029
name = "Shadow"
id = 2026
stateno = 2026
ownpal = 1
supermovetime = 99999

[State 2000, Success Transition]
type = ChangeState
trigger1 = anim = 10000
trigger1 = numhelper(2010)
trigger1 = helper(2010), stateno = 2012
trigger1 = helper(2010), time > 57
value = 2020

