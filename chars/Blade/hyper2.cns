;---------------------------------------------------------------------------
; Armour Split Startup

[Statedef 2100]
type    = S
movetype= A
physics = N
juggle  = 1
;Commonly-used controllers:
ctrl = 0    
sprpriority = 0
hitdefpersist = 1

[State Armour StateNo]
type = VarSet
trigger1 = time = 0
var(0) = StateNo 

[State Armour ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno != 9000
value = 2000

[State Armour Velset]
type = VelSet
trigger1 = time = 0
x = fvar(0)*prevstateno = 9000
y = fvar(1)*prevstateno = 9000

[State 2100, SuperPause]
type = SuperPause
trigger1 = anim = 2000
trigger1 = animelem = 1
time = 80
pos = -20*const(size.xscale), -105*const(size.yscale)
anim = s7300
sound = s2000, 0
poweradd = -1000
movetime = 80
p2defmul = 1
darken = 0

[State 2100, BGPalFX]
type = BGPalFX
trigger1 = anim = 2000
trigger1 = animelem = 1
time = 79
mul = 32,32,32

[State 2100, PlaySnd]
type = PlaySnd
trigger1 = anim = 2000
trigger1 = time = 5
value = 2100, 0

[State 2100, PlaySnd]
type = PlaySnd
trigger1 = anim = 2000
trigger1 = time = 40
value = 2000, 2

[State 2100, Explod]
type = Explod
trigger1 = anim = 2000
trigger1 = animelem = 8
anim = 2001
id = 2001
scale = const(size.xscale), const(size.yscale)
postype = p1
vel = -5, 0
accel = 0.1, 0.1
pos = floor(-176*const(size.xscale)), floor(-131*const(size.yscale))
supermovetime = 70
removetime = 40

[State 2100, 7]
type = ChangeAnim
trigger1 = anim = 2000
trigger1 = animtime = 0
value = 2100

[State 2100, 7]
type = ChangeState
trigger1 = anim = 2100
trigger1 = AnimTime = 0
value = ifelse(var(22), 2106, 2101)

[State 2100, NotHitBy]
type = NotHitBy
trigger1 = 1
value = , AT
time = 1

;---------------------------------------------------------------------------
; Armour Split Main

[Statedef 2101]
type    = S
movetype= A
physics = N
juggle  = 1
;Commonly-used controllers:
ctrl = 0    
sprpriority = 0
anim = 2101

[State 2101, PlaySnd]
type = PlaySnd
trigger1 = time = 0
trigger1 = prevstateno != 9000
value = 2100, 1

[State 2101, NotHitBy]
type = NotHitBy
trigger1 = 1
value = , AT
time = 1

[State 2101, 1]
type = NotHitBy
trigger1 = 1
value2 = SCA
time = 1

[State 2101, Explod]
type = Explod
trigger1 = time = 0
trigger1 = prevstateno != 9000
anim = 2102
id = 2102
scale = const(size.xscale), const(size.yscale)
sprpriority = 1

[State 2101, 2]
type = HitDef
trigger1 = animelem = 1
attr = S, HP
damage = 100, 20
guardflag = MA
priority = 5
pausetime = 11,11
sparkno = 3
sparkxy = -10,floor(const(size.yscale)*-90)
hitsound   = s5,6
guardsound = s6,0
animtype = back
ground.type = High
ground.slidetime = 17
ground.hittime  = 17
ground.velocity = -3, -7.5
guard.velocity = -10
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536
fall = 1
fall.recover = 0
getpower = 0, 0

[State 2101, PlaySnd]
type = PlaySnd
trigger1 = projcontact = 1
trigger1 = numtarget
abspan = floor(target, pos x)
channel = 1
value = 5 + (projguarded = 1), 1*(projhit = 1)

[State 2101, PlaySnd]
type = PlaySnd
trigger1 = projcontact = 1
trigger1 = !numtarget
pan = floor(p2dist x)
channel = 1
value = 5 + (projguarded = 1), 1*(projhit = 1)

[State 2101, Damage Reduction]
type = SuperPause
trigger1 = projhit = 1
time = 0
movetime = 0
darken = 0
p2defmul = 1.1
anim = -1
sound = -1

[State 2017, LifeAdd]
type = LifeAdd
trigger1 = time = 27
value = -130
kill = 0

[State 2101 Angle FVar Set]
type = VarSet
trigger1 = time = 27
trigger2 = time = 28
fvar(2) = pi - 0.2

