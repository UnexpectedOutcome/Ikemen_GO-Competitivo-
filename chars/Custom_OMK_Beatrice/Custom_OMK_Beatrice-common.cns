trigger1 = !SelfAnimExist(6043 + GetHitVar(animtype))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 6020, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (EnemyNear,HitDefAttr = SCA,HA)
value = 5047 + GetHitVar(animtype)

[State 6020, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(6043 + GetHitVar(animtype))) && (EnemyNear,HitDefAttr != SCA,HA)
trigger1 = SelfAnimExist(6043 + GetHitVar(animtype))
value = 6043 + GetHitVar(animtype)

[State 6020, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 6020, 5]
type = ChangeState
trigger1 = HitShakeOver && (!SelfAnimExist(6043 + GetHitVar(animtype)))
value = 5030

[State 6020, 5]
type = ChangeState
trigger1 = HitShakeOver && (SelfAnimExist(6043 + GetHitVar(animtype)))
value = 6030

