; Air get-hit (transition)
[Statedef 5035]
type    = A
movetype= H
physics = N

[State 5035, 1]
type = ChangeAnim
triggerall = !HitFall
trigger1 = Time = 0
trigger1 = SelfAnimExist(6035)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != [5090,5099] ;Not if hit off ground anim
value = 6035

[State 5035, 1]
type = ChangeAnim
triggerall = !HitFall
trigger1 = Time = 0
trigger1 = !SelfAnimExist(6035)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != [5090,5099] ;Not if hit off ground anim
value = 5035

[State 5035, 1]
