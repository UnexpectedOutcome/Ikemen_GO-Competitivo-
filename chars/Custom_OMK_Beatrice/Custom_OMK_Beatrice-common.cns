; Air get-hit (falling)
[Statedef 6050]
type    = A
movetype= H
physics = N

[State 6050]
type = NotHitBy
trigger1 = Var(37) = 1
trigger1 = !HitFall && Vel Y > 0
trigger2 = Var(37) = 1
trigger2 = HitFall && Vel Y < 0
trigger3 = EnemyNear,Var(6) = 1234
value = SCA

[State 6050, 1] ;Change anim when done with transition
type = ChangeAnim
triggerall = !SelfAnimExist(6050)
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 6050, 1] ;Change anim when done with transition
type = ChangeAnim
triggerall = SelfAnimExist(6050)
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 6050

[State 6050, 2] ;Coming down anim
type = Null
triggerall = (EnemyNear,HitDefAttr = SCA,HA) && anim != 6061
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, Const720p(4), Const720p(-8))
trigger1 = SelfAnimExist(anim+10)
trigger2 = anim = [6050,6059]
trigger2 = AnimTime = 0
value = 5061
persistent = 0

[State 6050, 2] ;Coming down anim
type = ChangeAnim
triggerall = anim != 5051
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, Const720p(4), Const720p(-8))
trigger1 = SelfAnimExist(anim+10)
trigger2 = anim = [6050,6059]
trigger2 = AnimTime = 0
value = 6061
persistent = 0

[State 6050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 6050, 4] ;Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= Const(movement.air.gethit.groundrecover.ground.threshold)
triggerall = alive
triggerall = CanRecover
triggerall = Var(35) < 4300 && Var(37) = 0 ;triggerall = Var(35) < 2150 && Var(37) = 0
trigger1 = Command = "Recovery S"
value = 5200 ;Air get-hit (fall recovery on ground)

[State 6050, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > Const(movement.air.gethit.airrecover.threshold)
triggerall = alive
triggerall = CanRecover
triggerall = Var(35) < 4300 && Var(37) = 0 ;triggerall = Var(35) < 2150 && Var(37) = 0
trigger1 = Command = "Recovery S"
value = 5210 ;Air get-hit (fall recovery in air)

[State 6050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, Const(movement.air.gethit.groundlevel))
value = 5100 ;Downed get-hit (hit ground from fall)

