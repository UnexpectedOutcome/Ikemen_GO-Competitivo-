; Downed get-hit (shaking)
[Statedef 5080]
type    = L
movetype= H
physics = N
velset = 0,0

;[State 5080, 4]
;type = ChangeState
;trigger1 = Time = 0
;value = 6080

[State 5080, 1]
type = PosSet 
trigger1 = Time = 0 && GetHitVar(yvel) < 0
y = -30.5
persistent = 0

[State 5080, 1] ;Set default anim
type = VarSet
trigger1 = Anim = [6110,6112]
sysvar(2) = 6081

[State 5080, 1] ;Set default anim
type = VarSet
trigger1 = time = 0
trigger1 = Anim != [6110,6112]
sysvar(2) = ifelse (GetHitVar(yvel) = 0, 5080, 5090)

[State 5080, 2]
type = VarAdd
trigger1 = time = 0
trigger1 = (anim = [5001,6099])
trigger1 = SelfAnimExist(sysvar(2) + (anim % 10))
sysvar(2) = anim % 10

[State 5080, 2]
type = VarAdd
trigger1 = time = 0
trigger1 = anim = 6112
sysvar(2) = 1

[State 5080, 3] ;Freeze
type = ChangeAnim
trigger1 = 1
value = sysvar(2)

[State 5080, 4]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 6081 ;Downed get-hit (knocked back)

[State 5080, 5]
