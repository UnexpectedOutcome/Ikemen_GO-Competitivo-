type = HitFallDamage
trigger1 = Time = 0

[State 6120, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 6120, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 6120, 6]
type = Null;PlaySnd
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = S5100, 0

[State 6120]
type = Null;Explod
trigger1 = Time = 0
trigger1 = !SysVar(0)
anim = 4440
ID = 4440
pos = 0,-floor(vel y)
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
removetime = 22
scale = 1,1
sprpriority = ifelse (sysvar(1) <= Const720p(56), -10, 10)
ownpal = 1

[State 6120, 8]
type = VelSet
trigger1 = Time = 0
y = 0

[State 6120, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [5171,5179]
triggerall = SelfAnimExist(5110 + (anim % 10))
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5110 + (anim % 10)

[State 6120, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = Anim != [5111,5119]
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5110



[State 6120, 11] ;If just died
type = ChangeState
triggerall = !alive
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
trigger3 = Anim = [5110,5119]
value = 5150

[State 6120, 12]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 6120, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 6120, 14] ;Friction
type = VelSet
trigger1 = abs(Vel x) < Const(movement.down.friction.threshold)
persistent = 0
x = 0

[State 6120, 15]
type = ForceFeedback
trigger1 = alive
trigger1 = Time = 0
time = 8
ampl = 240
waveform = sine

[State 6120, 16]
type = ForceFeedback
trigger1 = !alive
trigger1 = Time = 0
ampl = 200, 7, -.467
time = 30
waveform = sine

[State 5050, 4] ;Recover near ground
type = Null
triggerall = Time > 10
triggerall = alive
triggerall = CanRecover
triggerall = Var(35) < 4300 && Var(37) = 0 ;triggerall = Var(35) < 2150 && Var(37) = 0
trigger1 = Command = "Recovery S" && command != "holdfwd" && command != "holdback"
value = 5200 ;Air get-hit (fall recovery on ground)

[State 5050, 4] ;Recover near ground
type = Null
triggerall = Time > 10
triggerall = alive
triggerall = CanRecover
triggerall = Var(35) < 4300 && Var(37) = 0 ;triggerall = Var(35) < 2150 && Var(37) = 0
trigger1 = Command = "Recovery S" && (command = "holdfwd" || command = "holdback" )
value = 5220 ;Air get-hit (fall recovery on ground)

[State 6120, end]
type = ChangeState
trigger1 = Time = Const(data.liedown.time)
value = 5120

