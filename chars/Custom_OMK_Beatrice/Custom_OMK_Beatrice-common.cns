;trigger1 = animtime > 10
triggerall = alive
triggerall = CanRecover
triggerall = Var(35) < 4300 && Var(37) = 0 ;triggerall = Var(35) < 2150 && Var(37) = 0
trigger1 = pos y >=-25
trigger1 = Command = "Recovery S"
triggerall = life != 0
value = 5201 ;HITFALL_RECOVER

[State 5060] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5060, 6]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos y >= 0
value = 5100 ;HIT_BOUNCE

