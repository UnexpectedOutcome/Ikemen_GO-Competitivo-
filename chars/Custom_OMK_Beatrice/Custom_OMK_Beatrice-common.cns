trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) != 0 && (Anim = [5090,5099])
value = 5030 ;Air get-hit (knocked away)

[State 5080, 5]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) != 0 && (Anim != [5090,5099])
value = 5070 ;Air get-hit (knocked away)

