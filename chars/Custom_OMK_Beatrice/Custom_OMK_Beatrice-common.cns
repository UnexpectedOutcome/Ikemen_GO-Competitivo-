type    = A
movetype= H
physics = N

[State 5060] ;Coming down anim
type = ChangeAnim
trigger1 = 1 
value = 5050
persistent = 0

[State 5060] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5060, 6]
type = ChangeState
trigger1 = Time = 13
value = 5061 ;HIT_BOUNCE

;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
