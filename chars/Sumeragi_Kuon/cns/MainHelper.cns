trigger7 = root,time<2
trigger8 = (root,stateno=910)
trigger8 = (var(45) = 210)||(var(45) = 410)||(var(45) = 616)
trigger8 = root,time<2
trigger9 = (root,stateno=920)
trigger9 = (var(45) = [220,230])||(var(45) = 420)
trigger9 = root,time<2
