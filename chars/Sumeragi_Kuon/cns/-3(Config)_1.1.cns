[Statedef -3]

;------------------------[Config]

;AIレベル設定
;var(38)=	(  )←の枠内の数字に0～5のいずれかの数字を入れて下さい
;AIは数字が0に近いほど弱く、5に近いほど強くなります。
;数字が0～5以外の場合は強制的に「5」に設定されます。

[State ];AIレベル
type=varset
trigger1=1
var(38)=	( 3 )

;AIガードレベル設定
;var(39)=	(  )←の枠内の数字に0～5のいずれかの数字を入れて下さい
;AIは数字が5に近いほどガード精度が高くなります。
;数字が0～5以外の場合は強制的に「5」に設定されます。

[State ];AIガードレベル
type=varset
trigger1=1
var(39)=	( 4 )

;クライマックスモード設定
;クライマックスモードを常にonにする場合、下記の"null;"を消して下さい。

[State ];クライマックスモード
type=null;varset
trigger1=roundstate<=1
fvar(37)=0

;ゲージ関連
;以下3項目ごとの「Trigger1 = 0」を「Trigger1 = 1」に書き換えると
;項目ごとに対応したゲージが常に満タンになります。
;クライマックスモードをONにしている場合は設定する意味がありません。

[State ];常にフォースゲージ(パワーゲージ)満タン設定
Type = Varadd
v = 35
value = 1
Triggerall = !(var(35)&1)
Trigger1 = 0

[State ];常にブライドゲージ満タン設定
Type = Varadd
v = 35
value = 2
Triggerall = !(var(35)&2)
Trigger1 = 0

[State ];常にラヴゲージ満タン設定
Type = Varadd
v = 35
value = 4
Triggerall = !(var(35)&4)
Trigger1 = 0

;飛び道具発生保障フラグ
;「Trigger1 = 0」を「Trigger1 = 1」に書き換えると
;すべての飛び道具に発生保障が付きます。
;この場合は本体がダメージを受けても飛び道具が消えなくなります。

[State ];飛び道具発生保障フラグ
Type = Varadd
v = 35
value = 8
Triggerall = !(var(35)&8)
Trigger1 = 0

;ダメージ補正
;「Trigger1 = 0」を「Trigger1 = 1」に書き換えると
;ダメージ補正が常に無効となり、コンボ中の総ダメージが跳ね上がります。

[State ];ダメージ補正無視
Type = Varadd
v = 35
value = 16
Triggerall = !(var(35)&16)
Trigger1 = 0

;シンプルボタンOFF設定
;「Trigger1 = 0」を「Trigger1 = 1」に書き換えると
;BボタンとCボタンをおしても何も動作がおこらなくなります。
;自分でコンボができるようになってむしろ邪魔に感じる方はOFFにした方がいいかもしれません。

[State ];シンプルボタンOFF設定
Type = Varadd
v = 35
value = 32
Triggerall = !(var(35)&32)
Trigger1 = 0

;根性補正
;「Trigger1 = 0」を「Trigger1 = 1」に書き換えると
;根性補正が無効になり、残り体力による防御力の変化が無くなります(弱体化)。

[State ];根性補正無視
Type = Varadd
v = 35
value = 64
Triggerall = !(var(35)&64)
Trigger1 = 0

;削りダメージKO判定
;「Trigger1 = 0」を「Trigger1 = 1」に書き換えると
;相手がガード中に削りダメージが相手の体力を上回っている場合はKOします。

[State ];削りダメージKO判定
Type = Varadd
v = 35
value = 128
Triggerall = !(var(35)&128)
Trigger1 = 0

;各種ゲージ表示位置設定
;各項目 value=? の?部分 をお好みの数字に変えてください。
;正数だと下に下がって、負数（-）をつけると上に上がります。
;あまり大きい数字を入れると画面外にはみ出てしまいます。
;デフォルト（初期位置）に戻す場合は 0（ラヴゲージは9） にしてください。

[State ];ブライド＆フォースゲージ y座標
type=Varset
trigger1=roundstate<=1
var(57)=0

[State ];ラヴゲージ＆エンゲージレベル y座標
type=Varset
trigger1=roundstate<=1
var(58)=9

;------------------------[ここまで]
;ここから下はコンフィグ記述とは関係ありませんので
;基本的に弄る必要はありません








[State ];mugen1.1判定
type=varset
trigger1=1
var(34)=1

;キャラサイズ設定
[State ];Const(size.xscale)値セット
type=Varset
trigger1=roundstate<=1
fvar(32)=Const(size.xscale)*2

[State ];Const(size.yscale)値セット
type=Varset
trigger1=roundstate<=1
fvar(33)=Const(size.yscale)*2

[State ];パートナー判定
type=Varset
triggerall=NumPartner&&roundstate<=1
trigger1=p3name="YAMISAKA KUREHA"&&partner,Authorname="YU-TOHARU"
trigger2=p3name="Kuon"&&partner,Authorname="匿名スマブラー"
var(47)=1

[State ];タッグパートナー判定
type=Varset
trigger1=NumPartner&&roundstate<=1
trigger1=ID>Partner,ID
var(48)=1

[State ];相手1P判定
type=Varset
triggerall=numenemy&&roundstate<=1
trigger1=p3name="YAMISAKA KUREHA"&&partner,Authorname="YU-TOHARU"
trigger2=p3name="Kuon"&&partner,Authorname="匿名スマブラー"
var(49)=1

[State ];相手2P判定
type=Varset
triggerall=numenemy>=2&&roundstate<=1
trigger1=enemy(1),name="YAMISAKA KUREHA"&&enemy(1),authorname="YU-TOHARU"&&enemy(1),RoundsExisted=0
trigger2=enemy(1),name="Kuon"&&enemy(1),authorname="匿名スマブラー"&&enemy(1),RoundsExisted=0
var(51)=1

[State ];同キャラタッグ＆パートナー判定
type=Varset
triggerall=NumPartner&&roundstate<=1
trigger1=p3name="YAMISAKA KUREHA"&&partner,Authorname="YU-TOHARU"&&ID>Partner,ID
trigger2=p3name="Kuon"&&partner,Authorname="匿名スマブラー"&&ID>Partner,ID
var(55)=1

[State ];Teamside判別
type=Varset
trigger1=teamside=2&&roundstate<=1
var(56)=1

[State ];常時起動用ヘルパー
type=Helper
trigger1=!numhelper(3000)
helpertype=normal
name="main helper"
ID=3000
postype=right
stateno=3000
ownpal=1
supermovetime=99999999999
pausemovetime=99999999999

[State ];エンゲージクライマックス用ヘルパー
type=Helper
triggerall=!numhelper(7400)
trigger1=var(46)=1||stateno=3400
helpertype=normal
name="engage clymax palfx helper"
ID=7400
postype=p1
stateno=7400
ownpal=1
supermovetime=99999999999
pausemovetime=99999999999

[State ]
type=Varadd
trigger1=1
fvar(8)=1

[State ]
type=Varadd
trigger1=1
fvar(9)=1

[State ]
type=varadd
trigger1=!alive
fvar(15)=1

[State ]
type=varset
trigger1=!alive&&fvar(15)=1&&var(4)=0&&(enemynear,HitDefAttr=SCA,HA||enemynear,HitDefAttr=SCA,HT||enemynear,HitDefAttr=SCA,HP)
fvar(14)=1

;ハイジャンプ関係

[State ]
type=varset
trigger1=movetype=H||statetype!=A
var(11)=0

[State ]
type=varset
trigger1=movetype=H||statetype!=A
var(10)=0

;ラウンドスタート時音声消す
[State ]
type=VarSet
trigger1=RoundState=[0,1]
var(2)=1

[State  ]
type=StopSnd
trigger1=RoundState=2&&var(2)=1
channel=0

[State ]
type=VarSet
trigger1=RoundState=2&&var(2)=1
var(2)=0

[State ];ブライドゲージ
type=Varset
trigger1=var(5)!=1000&&roundstate>=2&&var(33)=0
var(5)=1000

[State ]
type=Varset
trigger1=var(33)=0&&RoundState>=2
var(33)=1

