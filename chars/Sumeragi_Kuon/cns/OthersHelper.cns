[Statedef 19970]
type	= A
movetype= I
physics	= N
anim	= 9999
ctrl    = 0

[State いつもの]
type     = AssertSpecial
trigger1 = 1
flag     = invisible

[State 音源]
type     = bindtoroot
trigger1 = 1
time     = 9999
pos     = 0,9999

[state フラグ確認]
type     = varset
trigger1 = !matchover
trigger1 = time >= 10
var(0)   = 1

[state ラウンド間 ]
type     = PlaySnd
trigger1 = time >= 10
trigger1 = var(0) = 1
value    = 3,5150+random%2
channel = 5
Persistent = 0
IgnoreHitPause = 1

[state 終了1]
type     = varset
trigger1 = time >= 10
trigger1 = var(0) = 1
var(0)   = 10

[state 敗北確定 ]
type     = PlaySnd
trigger1 = time>=10
trigger1 = matchover
trigger1 = var(0) = 0
value    = 3,5155+(random%(2+(enemynear,stateno=[1500,4999])))
channel = 5
IgnoreHitPause = 1
Persistent = 0

[state 終了2]
type     = varset
trigger1 = time >= 10
trigger1 = var(0) = 0
var(0)   = 10

[state 一応]
type = destroyself
trigger1 = root,alive = 1

