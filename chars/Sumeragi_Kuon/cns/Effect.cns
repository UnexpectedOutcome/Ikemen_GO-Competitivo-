trigger1=ishelper(200)||ishelper(206)||ishelper(210)||ishelper(211)||ishelper(400)||ishelper(410)||ishelper(600)||ishelper(610)||ishelper(616)||ishelper(617)
var(0)=200*ishelper(200) + 206*ishelper(206) + 210*ishelper(210)+ 211*ishelper(211) + 400*ishelper(400) + 410*ishelper(410) + 600*ishelper(600) + 610*ishelper(610) + 616*ishelper(616) + 617*ishelper(617) 

