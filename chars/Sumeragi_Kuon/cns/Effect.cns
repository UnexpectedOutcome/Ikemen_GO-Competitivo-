;--------------[変数管理2]

[state 速度ベクトルX]
type = varset
trigger1 = !time
fvar(1) = -5.0 * fvar(0) * sin((var(1)+2)*1.0/(180*1.0/pi))

[state 速度ベクトルY]
type = varset
trigger1 = !time
fvar(2) = -5.0 * fvar(0) * cos((var(1)+2)*1.0/(180*1.0/pi))

[State 伸びるfvar(3)]
