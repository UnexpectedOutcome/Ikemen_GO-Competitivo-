;イントロ～エフェクト（ヘルパー）
[Statedef 7000]
type=A
physics=S
anim=6002
ctrl=0
sprpriority=3

[State ]
type=AssertSpecial
trigger1=1
flag=noshadow

[State ]
type=Varadd
trigger1=1
fvar(0)=ifelse(time<=2,.24,ifelse((time=[3,21]),.016,-.128))*root,fvar(32)

[State ]
type=Varadd
trigger1=1
fvar(1)=ifelse(time<=2,.24,ifelse((time=[3,21]),.016,-.128))*root,fvar(33)

[State ]
type=AngleDraw
trigger1=1
scale=fvar(0),fvar(1)

[State ]
type=Varrandom
trigger1=time=0
v=0
range=0,360

[State ]
type=AngleAdd
trigger1=time=0
value=var(0)

[State ]
type=Trans
trigger1=1
trans=sub

[State ]
type=DestroySelf
trigger1=time=30

