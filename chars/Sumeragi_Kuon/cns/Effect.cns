var(0)=1000*ishelper(1000) + 1001*ishelper(1001) + 1002*ishelper(1002) + 1010*ishelper(1010) + 1011*ishelper(1011) + 1012*ishelper(1012) + 1040*ishelper(1040) + 1041*ishelper(1041) + 1042*ishelper(1042) + 1043*ishelper(1043)

