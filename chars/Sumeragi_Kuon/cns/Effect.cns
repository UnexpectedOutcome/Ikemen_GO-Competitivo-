[State anim留まるやつ]
type=changeanim
trigger1=time=0&&(var(0)=[20000,29999])
value=6013

[State 移動]
type=velset
trigger1=time<=9
trigger1=var(0)=[10000,19999]
x = fvar(1)
y = fvar(2)

[State 大きさ+回転 1]
type=AngleDraw
trigger1=var(0)<20000
scale=(.9-fvar(3))*fvar(0)*ifelse((var(0)%10000=[1000,1002]),0.5,1),(.1+fvar(4))*fvar(0)
value = var(1)+(var(0)=[10000,19999])*5

[State 大きさ+回転 2]
type=AngleDraw
trigger1=var(0)=[20000,29999]
scale=fvar(3)*fvar(0)*ifelse((var(0)%10000=[1000,1002]),0.75,1),fvar(4)*fvar(0)
value = var(1)

[State 透過1]
type=Trans
trigger1=var(0)<20000
trigger2=time<10
trans=addalpha
alpha=256,256

[State 透過2]
type=Trans
trigger1=var(0)=[20000,29999]
trigger1=time>=10
trans=addalpha
alpha=256-((time-9)*25),256

;--------------[終わり]

[State ]
type=DestroySelf
trigger1=time=24
trigger2=time>=20
trigger2=var(0)=[20000,29999]

