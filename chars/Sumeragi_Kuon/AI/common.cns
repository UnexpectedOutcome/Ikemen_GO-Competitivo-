type=S
physics=S
sprpriority=0

[State 振り向き]
type = turn
triggerall = !time
trigger1 = var(59)
trigger1 = p2dist x < 0
ignorehitpause = 1
persistent = 0

[State ]
type=Varset
trigger1=1
var(59)=1

[State ]
type=ChangeAnim
trigger1=!ctrl
trigger1=var(59)
trigger1=anim=[20,21]
trigger1=p2dist x < 0
value=5

[State ]
type=turn
trigger1=!ctrl
trigger1=var(59)
trigger1=anim=[20,21]
trigger1=p2dist x < 0
trigger1=animelemtime(1)=0

[State ]
type=Varset
trigger1=(prevstateno=5120&&time=0)||time=3
var(20)=ifelse(time=3,0,1)

[State ]
type=Explod
trigger1=time%40=ifelse(prevstateno=0,20,0)
anim=6007
ID=6007
postype=p1
pos=-floor(4*fvar(32)),floor(2*fvar(33))
bindtime=-1
sprpriority=-1
scale=.2*fvar(32),.2*fvar(33)
ownpal=1
facing=ifelse(facing,1,-1)
supermovetime=50
pausemovetime=50

[State ]
type=velset
trigger1 = (helper(60000),var(54)=[5,6])||(helper(60000),var(54)=0)
x=(const(velocity.walk.fwd.x))*ifelse(helper(3000),var(35),.5,1)

[State ]
type=VelSet
trigger1 = !((helper(60000),var(54)=[5,6])||(helper(60000),var(54)=0))
x=(const(velocity.walk.back.x))*ifelse(helper(3000),var(35),.5,1)

[State destroyself];ヘルパーを消す
type=destroyself
trigger1=ishelper

[State ]
type=ChangeAnim
trigger1=vel x>0&&((Anim!=20&&Anim!=5)||(Anim=5&&AnimTime=0))
value=20

[State ]
type=ChangeAnim
trigger1=vel x<0&&((Anim!=21&&Anim!=5)||(Anim=5&&AnimTime=0))
value=21

[State 20, 1]
type = VelSet
Trigger1 = p2bodydist x<10
trigger2 = roundstate!=2
trigger3 = var(38)=1
trigger3 = time%20=9
trigger3 = var(40)%100<=20
x = 0

[State 戻る]
type = Changestate
Trigger1 = p2bodydist x<10
trigger2 = roundstate!=2
trigger3 = var(38)=1
trigger3 = time%20=9
trigger3 = var(40)%100<=20
value = 0

