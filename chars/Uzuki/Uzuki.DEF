Pausemovetime = 9999

[State 8000, ODカットインH用2]
type = Explod
triggerall = Var(59) >= 3
trigger1 = StateNo = 8000 && Anim = 8001 && AnimElem = 3, 1
trigger2 = StateNo = 8005 && Anim = 8001 && AnimElem = 3, 1
trigger3 = StateNo = 3050 && Anim = 3050 + (Var(59) = [3,5])*10 && AnimElem = 3, 1
anim     = 8005
ID       = 8002
pos      = 160, 160
postype  = Back
sprpriority= -2
supermove  = 1
removetime = 25
ownpal = 1  
ctrl   = 0
