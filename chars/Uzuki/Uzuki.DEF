Pausemovetime = 9999


;■パワーボムゲージ
[State 195,パワーボム]
type = Explod
trigger1 = Alive && RoundState = 2
trigger1 = TeamSide = 1
trigger1 = 1
anim = 950 + Ceil(Var(47))            ;ceil 小数点以下切り上げ
ID   = 950
pos  = 31,208
postype  = Left
facing   = 1
bindtime = 2
sprpriority = 3
ownpal = 1
ontop  = 1
ignorehitpause = 1
pausemovetime  = 2

[State 195,パワーボム]
type = Explod
trigger1 = Alive && RoundState = 2
trigger1 = TeamSide = 2
trigger1 = 1
anim = 950+Ceil(Var(47))
ID   = 950
pos  = -31,208
postype  = Right
facing   = -1
bindtime = 2
sprpriority = 3
ownpal = 1
ontop  = 1
ignorehitpause = 1
pausemovetime  = 2


;■クリティカル
[State -2,Critical]
type = Explod
triggerall = !NumExplod(9991)
trigger1 = StateNo = 1000 || StateNo = 1002
trigger1 = Time > 8 && Time < 23 && MoveHit
trigger1 = enemynear,GetHitVar(yvel) < -1 
trigger2 = StateNo = 310 && MoveHit
trigger2 = P2StateType != A
trigger3 = StateNo = 1505 && MoveHit
anim = 9991
ID   = 9991
pos  = IfElse (Facing = 1, -5, 5), -100
postype  = P1
facing   = IfElse (Facing = 1, 1, -1)
bindtime = 20
pausemovetime = 20
removetime    = 20
ignorehitpause = 1
sprpriority = -1
ownpal = 1
persistent  = 0


;■ブロッキング
[State -2,Blocking]
type = Explod
trigger1 = !NumExplod(9992) && Time = 0
trigger1 = StateNo = [880,882]
anim = 9992
ID   = 9992
pos  = IfElse (Facing = 1, -5, 5), -100
postype = P1
facing  = IfElse (Facing = 1, 1, -1)
bindtime= 20
pausemovetime = 20
removetime    = 20
ignorehitpause= 1
sprpriority = -1
ownpal      = 1
persistent  = 0

[State -2,Blocking]
type = PowerAdd
trigger1 = StateNo = [880,882]
trigger1 = Time = 0
value    = 10
pausemovetime = 20

[State -2,Blocking効果]
type = Explod
trigger1 = StateNo = [880,882]
trigger1 = Time = 0
anim     = 885
postype  = P1
pos      = 0, -60
removetime    = 5
pausemovetime = 999
sprpriority   = 2
persistent  = 0


;■カウンター
[State -2,相手攻撃確認Var]
type = VarSet
trigger1 = enemyNear,MoveType = A
trigger1 = Var(14) != 1
ignorehitpause = 1
var(30) = 1

[State -2,相手攻撃確認Var]
type = VarSet
triggerall = Var(30) = 1
trigger1 = Var(31) > 0
trigger2 = Var(31) <= 0 && enemyNear,MoveType = I
trigger3 = MoveType = H
var(30) = 0
ignorehitpause = 1

[State -2,カウンター効果Var]
type = VarSet
trigger1 = Var(30) = 1
v = 32
value = 2
persistent  = 1
ignorehitpause = 1

[State -2,カウンター効果Var]
type = VarSet
trigger1 = Var(30) != 1
v = 32
value = 0
persistent  = 1
ignorehitpause = 1

[State -2,カウンター確認Var]
type = VarSet
trigger1 = hitdefattr = SCA, NA, SA, HA, SP, HP
trigger1 = Var(30) = 1 && MoveHit
var(31) = 3
ignorehitpause = 1

[State -2,Counter]
type = Explod
triggerall = !NumExplod(9990)
trigger1 = Var(31) = 3
trigger2 = StateNo = 1610 && Time = 7
anim = 9990
ID   = 9990
pos  = IfElse (Facing = 1, -5, 5), -100
postype = P1
facing  = IfElse (Facing = 1, 1, -1)
sprpriority = -1
ownpal    = 1
bindtime = 20
pausemovetime = 20
removetime    = 20
ignorehitpause = 1
persistent  = 0

[State -2,カウンターVel]
type = TargetVelAdd
trigger1 = Var(31) > 0
trigger1 = enemyNear,GetHitVar(yvel) < 0
trigger1 = enemyNear,GetHitVar(hitshaketime) = 1
y = -9.99
ignorehitpause = 1

[State -2,カウンターVar]
type = VarAdd
trigger1 = Var(31) > 0 && Var(30) = 0
trigger1 = 1
v = 31
value = -1
;ignorehitpause = 1


;■キャンセル
[State -2,Cancel]
type = Explod
triggerall = !NumExplod(9993)
trigger1 = StateNo = 750 || StateNo = 755
trigger2 = StateNo = 352 || StateNo = 362 || StateNo = 856
anim = 9993
ID   = 9993
pos  = IfElse (Facing = 1, -5, 5), -100
postype = P1
facing  = IfElse (Facing = 1, 1, -1)
sprpriority = -1
ownpal   = 1
bindtime = 20
pausemovetime = 20
removetime    = 20
ignorehitpause= 1
persistent  = 0


;LLLLLLLLLLLLLLLLLLLLL超必処理関係LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL

;■オーバードライヴ&ザ・ワールド
[State 8000, パワー増加禁止]
type = PowerSet
triggerall = StateNo != [8000,8006]
trigger1 = Var(11) > 0 && Var(12) >= 0     ;オーバードライヴ
trigger2 = Var(14) = 1                     ;ザ・ワールド
value    = 0
ignorehitpause = 1
persistent  = 1

;---------------------------------------------------------
;■オーバードライヴ終了用
[State 8000, スーパーキャンセル時解除用]
type = VarSet
triggerall = Var(11) > 0 && Var(12) > 0
trigger1 = StateNo = [3000,3500]
var(12)  = 0

[State 8000, 攻撃変化終了]
type = AttackMulset
triggerall = Var(11) = 1
trigger1 = Var(12)  <= 0
trigger2 = Var(12)  >= 0
trigger2 = !Alive || RoundState = 3
value    = 1
ignorehitpause = 1

[State 8000, 防御変化終了]
type = DefenceMulSet
trigger1 = Var(11) = 2 && Var(12) <= 0
trigger2 = Var(11) = 2 && Var(12) >= 0
trigger2 = !Alive || RoundState = 3
trigger3 = Var(35) = 1
trigger3 = Life <= 0
value    = 1
ignorehitpause = 1

[State 8000, 残像の継続時間変化終了]
type = Afterimagetime
trigger1 = Var(11) > 0 && Var(12) <= 2
trigger2 = Var(11) > 0 && Var(12) >= 0 && StateNo != 8051
trigger2 = !Alive || RoundState = 3
trigger3 = Var(35) = 1                     ;マガカミ
trigger3 = Life <= 0 || RoundState = 3
time     = 0
ignorehitpause = 1
pausemovetime  = 999

[State 8000, 点滅終了]
type = PalFX
triggerall = StateNo != 8000 && StateNo != 8005 && StateNo != 8500
trigger1 = Var(11) > 0 && Var(12) <= 2
trigger2 = Var(11) > 0 && Var(12) >= 0 && StateNo != 8051
trigger2 = !Alive || RoundState = 3
trigger3 = Var(35) = 1
trigger3 = Life <= 0 || RoundState = 3
time     = 3
add      = 200,190,200
ignorehitpause = 1
pausemovetime  = 999
supermove  = 1

[State 8000, 終了Varセット]
type = VarSet
triggerall = Var(11) != 0
trigger1 = Var(12) <= 0
trigger2 = !Alive
var(11)  = 0

[State 8900, 終了Varセット]
type = VarSet
trigger1 = Var(35) != 0
trigger1 = !Alive
v = 35
value = 0


