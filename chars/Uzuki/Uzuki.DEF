;■キャラ情報
[Info]
name ="KungFuGirl UZUKI"
displayname  ="Uzuki"
versiondate  =01,02,2005
mugenversion =04,14,2001
author       ="TKW"
pal.defaults=1,2,3,4,5

; Files for the player
[Files]
cmd     =command.cmd
cns     =DATA/CNS.cns
st      =DATA/CNS.cns
stcommon=common1.cns
sprite  =DATA/sff.sff
anim    =DATA/air.air
sound   =DATA/snd.snd
pal1=ACT/ACT4.act


;■ファイル構成     これ以外の(アイコンなど)は捨ててもいいです
;[0UZUKI]___0UZUKI.DEF
;        |__COMMAND.CMD
;        |
;        |__[ACT ]___ACT1.ACT～ACT12.ACT
;        |__[DATA]___AIR.AIR
;                 |__CNS.CNS
;                 |__SFF.SFF
;                 |__SND.SND

;#############################################################################
[Statedef -2] ;←絶対消さない
;#############################################################################
;      設定変更


;■簡易AI用  もしAIがうっとうしようでしたら、var(49) = を 0 にして下さい
[State -2, AI]
type = VarSet
trigger1 = 1
var(49)  = 2
;↑var(49) = の後に、0～2の数字を入れ、上書き


;■モードセレクト用  Hモード絶対使わねーて人はvar(57)を0にして下さい
[State -2,ModeSelect]
type = VarSet
trigger1 = Var(57) < 2
trigger1 = RoundNo = 1 && StateNo = 5900
trigger1 = Time = 0
var(57)  = 1
;↑var(57) = の後に、0～1の数字を入れ、上書き


;******************************************************************************************
;#############################################################################
;■オマケ　VAR
;1=勝ちポーズ
;10=ジャンプ制御
;11=うづきオーバードライヴ用
;12=OD & TW タイマー
;13=うづき落とし物ランダム
;14=うづきザ・ワールド用
;15=ザ・ワールドヒット確認
;16=ザ・ワールドダメージ
;17=ストライカーボムを増やす
;20=カンフー突き分岐
;25=アーマータイマーVar
;26=アーマーStateVar
;27=アーマーAnimVar
;28=アーマーAnimElemNoVar
;29=アーマーPosVar
;30=相手攻撃確認(カウンター)
;31=カウンター確認
;32=カウンター効果(硬直時間)
;35=オーバードライヴ　マガカミ発動
;40=簡易AI

;以下は[うづき基本データ]と[Statedef 5900]で外してあるので、ラウンド毎にクリアされません。
;41=勝ちポーズED未使用時
;44=勝ちポーズ相手との距離
;45=1R負け時ポーズ&超技負け
;46=特殊勝ちポーズ
;47=ストライカーボム
;49=簡易AI用 難易度設定
;57=モードセレクト用1試合目確認
;58=モードセレクト用
;59=モードセレクト用
;#############################################################################
;LLLLLLLLLLLLLLLLLLLLL特殊処理関係LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL

;■モードセレクト用
[State -2,ModeSelect_画像を表示]
type = Explod
trigger1 = Var(57) < 2
trigger1 = StateNo = [191,195]
trigger1 = RoundNo = 1 && RoundState = 1
anim     = 9980 + (var(58))
ID       = 9980
postype  = P1
pos      = 0, -20
removetime  = 2
facing      = IfElse (TeamSide = 1, 1, -1)           ;TeamSide = 1 プレイヤー左
sprpriority = 3
ontop = 1
ownpal = 1
shadow = 0,0,0
persistent  = 0

[State -2,MS-VarSet];セレクトランダム
type = VarSet
trigger1 = Var(57) = 1
trigger1 = RoundNo = 1 && StateNo = 5900 && Time = 0
var(58)  = 6

[State -2,MS-VarSetNoH];モードセレクト カラーで変化
type = VarSet
triggerall = Var(57) = 0
trigger1 = RoundNo = 1 && (PalNo = [1,3])   && StateNo = 5900
trigger2 = RoundNo = 1 && (PalNo = [10,12]) && StateNo = 5900
var(58)  = 1

[State -2,MS-VarSetNoH2];カラーで変化
type = VarSet
trigger1 = Var(57) = 0
trigger1 = RoundNo = 1 && (PalNo = [4,6]) && StateNo = 5900
var(58)  = 0

[State -2,MS-VarSetNoH3];カラーで変化
type = VarSet
trigger1 = Var(57) = 0
trigger1 = RoundNo = 1 && (PalNo = [7,9]) && StateNo = 5900
var(58)  = 2

[State -2,MS-VarAdd]
type = VarAdd
trigger1 = Var(57) < 2
trigger1 = (StateNo = [191,195])
trigger1 = command  = "Fblock"
V       = 58
value   = 1

[State -2,MS-VarAdd2]
type = VarAdd
trigger1 = Var(57) < 2
trigger1 = (StateNo = [191,195])
trigger1 = command  = "Bblock"
V       = 58
value   = -1

[State -2,MS-VarSet]
type = VarSet
triggerall = command = "Fblock"
trigger1 = Var(57) = 0
trigger1 = (StateNo = [191,195]) && Var(58) >= 3
trigger2 = Var(57) = 1
trigger2 = (StateNo = [191,195]) && Var(58) >= 6
var(58)  = 0

[State -2,MS-VarSetNoH2]
type = VarSet
trigger1 = Var(57) = 0
trigger1 = (StateNo = [191,195]) && Var(58) <= -1
trigger1 = command = "Bblock"
var(58)  = 2

[State -2,MS-VarSet2]
type = VarSet
trigger1 = Var(57) = 1
trigger1 = (StateNo = [191,195]) && Var(58) <= -1
trigger1 = command = "Bblock"
var(58)  = 5

[State -2,MS-VarSet]
type = VarSet
trigger1 = Var(57) < 2
trigger1 = command = "Fblock"  || command = "Bblock"
trigger1 = (StateNo = [191,195]) && Var(58) >= 0 && Var(58) < 6
var(59)  = var(58)

[State 180,MS-VarRandom];ランダムセレクト
type = VarRandom
trigger1 = Var(57) < 2
trigger1 = (StateNo = [191,195]) && (Var(58) != [0,5])
v        = 59
range    = 0,5

[State -2,MS-VarSet3]
type = VarSet
triggerall = var(57) != 2
trigger1 = command = "a" || command = "b" || command = "c"
trigger2 = command = "x" || command = "y" || command = "z" || command = "start"
trigger3 = RoundState = 2
var(57)  = 2

;■モード変化
[State -2, 攻撃変化]
type = AttackMulset
trigger1 = Var(11)  = 0
trigger1 = Var(59) != 0 && Var(59) != 3
trigger1 = 1
value    = 0.9                    ;2なら攻撃力2倍
ignorehitpause = 1

[State -2, 防御変化]
type = DefenceMulSet
trigger1 = Var(11) = 0
trigger1 = var(59) = 2 || var(59) = 5
trigger1 = 1
value    = 1.24                   ;0.5ならダメージ半減
ignorehitpause = 1


;■勝利時位置 勝った後、相手に駆け寄る距離を算出する。一応・・・
[State -2, 勝利時位置リセット]
type = VarSet
trigger1 = RoundState = 1
var(44) = 0

[State -2, 勝利時位置]
type = VarSet
trigger1 = StateNo != 184
trigger1 = RoundState = 3 && Life > P2Life
trigger1 = P2Dist X > 0
var(44)  = Floor((BackEdgeBodyDist)+(P2Dist X)-100)


;■必殺技やられ var(45)で普通と必殺負けを区別。一応・・・

[State -2, 必殺負け]
type = Changestate
triggerall = Var(59) >= 3
triggerall = Var(45) = 0 && !Alive && StateNo = [5000,5081]
triggerall = StateNo != 5150 || StateNo != 5400 && Vel Y < 0
trigger1 = enemyNear,hitdefattr = SCA, HA, HP
trigger2 = ProjHit = 1
value    = 5400

[State 5900,負け認識Var戻す]
type = VarSet
trigger1 = Alive != 0 && Var(45) != 0
trigger1 = RoundState = 2                  ;プレイヤーが闘っている
var(45)  = 0


;LLLLLLLLLLLLLLLLLLLLLサウンド関係LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL

[State -2, 着地音]
type = PlaySnd
trigger1 = StateNo  = 52 || StateNo = 60
trigger1 = AnimElem = 1, 1
trigger2 = StateNo  = 191 && Anim = 60 && AnimElem = 1, 1
trigger3 = StateNo  = 100 || StateNo = 184
trigger3 = AnimElem = 3 || AnimElem = 6
trigger4 = StateNo = 106
trigger4 = Time = 1
value = s40, 0

[State -2, 空中ダッシュ音]
type = PlaySnd
trigger1 = StateNo  = [500,505]
trigger1 = AnimElem = 1, 1
value  = s0, 4

[State -2, やられ声]
type = PlaySnd
trigger1 = Time = 1 && Alive
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020
value = s5, 1

[State -2, やられ声2]
type = PlaySnd
trigger1 = Time = 1 && Alive
trigger1 = StateNo = 5030 || StateNo = 5070
value = s5, 2

[State -2, やられ声3]
type = PlaySnd
triggerall = Time  = 1 && Alive
trigger1 = StateNo = 5050 || StateNo = 5080
trigger2 = StateNo = [5070,5071]
value  = s5, 0


;LLLLLLLLLLLLLLLLLLLLL表示関係LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL

;■カットイン
[State -2, 超必カットインH用]
type = Explod
triggerall = Var(59) >= 3 && !NumExplod(9003)
trigger1 = StateNo = 3000  && AnimElem = 2, 1
trigger2 = StateNo = 3100  && AnimElem = 3, 1
trigger3 = StateNo = 3200  && AnimElem = 3, 0
trigger4 = StateNo = 3500  && AnimElem = 2, 1
trigger5 = StateNo = 10000 && AnimElem = 2, 1
