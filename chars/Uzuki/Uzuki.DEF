[State 8000, ODカットインH用3]
type = Explod
triggerall = Var(59) >= 3
trigger1 = StateNo = 8000 && Anim = 8001 && AnimElem = 3, 1
trigger2 = StateNo = 8005 && Anim = 8001 && AnimElem = 3, 1
trigger3 = StateNo = 3050 && Anim = 3050 + (Var(59) = [3,5])*10 && AnimElem = 3, 1
anim     = 8005
ID       = 8003
pos      = 160, 120
postype  = Back
