; FileName : Athena.cns
;------------------------------------------------------------------------------;
;==============================================================================;
; コモンステート
;==============================================================================;
;------------------------------------------------------------------------------;
; 立ち動作
;------------------------------------------------------------------------------;
[Statedef 0]
  Type        = S
  Physics     = S
  SprPriority = 0

;--------------------------[ アニメ変更 ]----------------------------;

[State 0]
  Type     = ChangeAnim
  Trigger1 = Anim != 0 && Anim != 5
  Trigger2 = Anim = 5 && AnimTime = 0 ;Turn Anim over
  Value    = 0

;---------------------------[ 移動関連 ]-----------------------------;

[State 0]
  Type     = PosSet
  Trigger1 = Time = 0
  Y        = 0

[State 0]
  Type     = VelSet
  Trigger1 = Time = 0
  Y        = 0

[State 0] ;Stop moving if low velocity or 4 ticks pass
  Type     = VelSet
  Trigger1 = abs(vel x) < 2
  Trigger2 = Time = 4
  X        = 0

;-------------------------[ ステート変更 ]---------------------------;

[State 0] ;Are you dead?
  Type     = ChangeState
  Trigger1 = !Alive
  Value    = 5050

[State 0]
  Type           = DestroySelf
  Trigger1       = IsHelper
  IgnoreHitPause = 1
  SuperMoveTime  = 999999
  PauseMoveTime  = 999999

;------------------------------------------------------------------------------;
; 立ち状態から屈み状態へ移行する動作
;------------------------------------------------------------------------------;
[Statedef 10]
  Type    = C
  Physics = C
  Anim    = 10

;---------------------------[ 移動関連 ]-----------------------------;

[State 10]
  Type     = VelMul
  Trigger1 = Time = 0
  X        = 0.75

;-------------------------[ ステート変更 ]---------------------------;

[State 10]
  Type     = ChangeState
  Trigger1 = AnimTime = 0
  Value    = 11

;------------------------------------------------------------------------------;
; 屈み動作
;------------------------------------------------------------------------------;
[Statedef 11]
  Type        = C
  Physics     = C
  Anim        = 11
  SprPriority = 0

;--------------------------[ アニメ変更 ]----------------------------;

[State 11] ;Change from turning Animation
  Type     = ChangeAnim
  Trigger1 = Anim = 6 && AnimTime = 0
  Value    = 11

;------------------------------------------------------------------------------;
; 屈み状態から立ち状態へ移行する動作
;------------------------------------------------------------------------------;
[Statedef 12]
  Type    = S
  Physics = S
  Anim    = 12

;-------------------------[ ステート変更 ]---------------------------;

[State 12]
  Type     = ChangeState
  Trigger1 = AnimTime = 0
  Value    = 0

;------------------------------------------------------------------------------;
; 前に歩く動作
;------------------------------------------------------------------------------;
[Statedef 20]
  Type        = S
  Physics     = S
  SprPriority = 0

;---------------------------[ 移動関連 ]-----------------------------;

[State 20]
  Type     = VelSet
  Trigger1 = Command = "holdfwd"
  X        = const(velocity.walk.fwd.x)

[State 20]
  Type     = VelSet
  Trigger1 = Command = "holdback"
  X        = const(velocity.walk.back.x)

;--------------------------[ アニメ変更 ]----------------------------;

[State 20]
  Type       = ChangeAnim
  Triggerall = Vel X > 0
  Trigger1   = Anim != 20 && Anim != 5
  Trigger2   = Anim = 5 && AnimTime = 0
  Value      = 20

[State 20]
  Type       = ChangeAnim
  Triggerall = Vel X < 0
  Trigger1   = Anim != 21 && Anim != 5
  Trigger2   = Anim = 5 && AnimTime = 0
  Value      = 21

;------------------------------------------------------------------------------;
; ジャンプ開始動作
;------------------------------------------------------------------------------;
[Statedef 40]
  Type        = S
  Physics     = S
  Anim        = 40
  Ctrl        = 0
  SprPriority = 1

;---------------------------[ 変数定義 ]-----------------------------;

[State 40]
  Type     = VarSet
  Trigger1 = Time = 0
  V        = 5
  Value    = 0

[State 40]
  Type     = VarSet
  Trigger1 = Command != "holdup"
  V        = 5
  Value    = 1

[State 40]
  Type      = VarSet
  Trigger1  = Time = 0
  V         = 10
  Value     = 0

[State 40 : 垂直ジャンプ用]
  Type      = VarSet
  Trigger1  = Time = 0
  sysvar(1) = 0

[State 40 : 前方ジャンプ用]
  Type      = VarSet
  Trigger1  = Command = "holdfwd"
  sysvar(1) = 1

[State 40 : 後方ジャンプ用]
  Type      = VarSet
  Trigger1  = Command = "holdback"
  sysvar(1) = -1

;---------------------------[ 移動関連 ]-----------------------------;

[State 40 : 通常ジャンプ]
  Type     = VelSet
  Trigger1 = AnimTime = 0
  X = IfElse(sysvar(1)=0, const(velocity.jump.neu.x), IfElse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
  Y = const(velocity.jump.y)

[State 40 : 小ジャンプ]
  type     = VelSet
  Trigger1 = Var(30) != 0
  trigger1 = AnimTime = 0
  trigger1 = Var(5) = 1
  X = IfElse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
  Y = -6.5

[State 40]
  Type     = Null;VelSet
  Trigger1 = AnimTime = 0
  Trigger1 = prevstateno = 100 ;RUN_FWD
  Trigger1 = sysvar(1) = 1
  X        = const(velocity.runjump.fwd.x)

;-------------------------[ ステート変更 ]---------------------------;

[State 40]
  Type     = ChangeState
  Trigger1 = AnimTime = 0
  Value    = 50
  Ctrl     = 1

;------------------------------------------------------------------------------;
; 空中ジャンプ開始動作
;------------------------------------------------------------------------------;
[Statedef 45]
  Type    = A
  Physics = N
  Ctrl    = 0
  VelSet  = 0, 0

;--------------------------[ アニメ変更 ]----------------------------;

[State 45]
  Type     = ChangeAnim
  Trigger1 = SelfAnimExist(44)
  Value    = 44

[State 45]
  Type     = ChangeAnim
  Trigger1 = !SelfAnimExist(44)
  Value    = 41

;---------------------------[ 変数定義 ]-----------------------------;

[State 45]
  Type      = VarSet
  Trigger1  = Time = 0
  sysvar(1) = 0

[State 45]
  Type      = VarSet
  Trigger1  = Command = "holdfwd"
  sysvar(1) = 1

[State 45]
  Type      = VarSet
  Trigger1  = Command = "holdback"
  sysvar(1) = -1

;---------------------------[ 移動関連 ]-----------------------------;

[State 45]
  Type     = VelSet
  Trigger1 = Time = 2
  X = IfElse(sysvar(1)=0, const(velocity.airjump.neu.x), IfElse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
  Y = const(velocity.airjump.y)

;-------------------------[ ステート変更 ]---------------------------;

[State 45]
  Type     = ChangeState
  Trigger1 = Time = 2
  Value    = 50
  Ctrl     = 1

;------------------------------------------------------------------------------;
; ジャンプ中動作
;------------------------------------------------------------------------------;
[Statedef 50]
  Type    = A
  Physics = A

;---------------------------[ 変数定義 ]-----------------------------;

[State 50]
  Type      = VarSet
  Trigger1  = Time = 0
  sysvar(1) = 0

;---------------------------[ サウンド ]-----------------------------;

[State 50]
  Type       = PlaySnd
  TriggerAll = Var(30) = 0
  Trigger1   = Time = 0
  Value      = s40,0

[State 50]
  Type       = PlaySnd
  TriggerAll = Var(30) = 1
  Trigger1   = Time = 0
  Value      = s40,IfElse(Var(6)>=1,11,10)

[State 50]
  Type       = PlaySnd
  TriggerAll = Var(30) >= 2
  Trigger1   = Time = 0
  Value      = s40, IfElse(Var(5)=1, 20, IfElse(Var(6)>=1,22,21))

;--------------------------[ アニメ変更 ]----------------------------;

[State 50]
  Type = ChangeAnim
  Trigger1 = Time = 0
  Value = IfElse((vel x)=0, 41, IfElse((vel x)>0, 42, 43))

[State 50]
  Type       = ChangeAnim
  Trigger1   = Vel Y > -2
  Trigger1   = SelfAnimExist(Anim + 3)
  Persistent = 0
  Value      = Anim + 3

;------------------------------------------------------------------------------;
; Jump Down (empty state for compatibility)
;------------------------------------------------------------------------------;
[Statedef 51]
  Type    = A
  Physics = A

[State 51]
  Type     = Null
  Trigger1 = 1

;------------------------------------------------------------------------------;
; 着地
;------------------------------------------------------------------------------;
[Statedef 52]
  Type    = S
  Physics = S
  Ctrl    = 0
  Anim    = 47

[State 52]
  Type     = Null;CtrlSet
  Trigger1 = Time = 3
  Value    = 1

;---------------------------[ 移動関連 ]-----------------------------;

[State 52]
  Type     = VelSet
  Trigger1 = Time = 0
  Y        = 0

[State 52]
  Type     = PosSet
  Trigger1 = Time = 0
  Y        = 0

;-------------------------[ ステート変更 ]---------------------------;

[State 52]
  Type     = ChangeState
  Trigger1 = AnimTime = 0
  Value    = 0
  Ctrl     = 1

;------------------------------------------------------------------------------;
; ダッシュ
;------------------------------------------------------------------------------;
[Statedef 100]
  Type        = S
  Physics     = S
  Ctrl        = 0
  Anim        = 100
  SprPriority = 1

[State 100] ;Prevent run from canceling into walk
  Type     = AssertSpecial
  Trigger1 = 1
  flag     = NoWalk

[State 100] ;Prevent from turning
  Type     = AssertSpecial
  Trigger1 = 1
  flag     = NoAutoTurn

;---------------------------[ 変数定義 ]-----------------------------;

[State 100]
  Type     = VarSet
  Trigger1 = Time = 0
  V        = 10
  Value    = 0
  IgnoreHitPause = 1

[State 100]
  Type     = VarSet
  Trigger1 = AnimElem = 2
  V        = 10
  Value    = 1
  IgnoreHitPause = 1

;---------------------------[ サウンド ]-----------------------------;

[State 100]
  Type       = PlaySnd
  TriggerAll = Var(30) = 0 || Var(30) = 5
  Trigger1   = AnimElem = 2
  Trigger2   = AnimElem = 5
  Value      = s100,IfElse(Var(30)=5,21,0)
  Channel    = 1

[State 100]
  Type       = PlaySnd
  TriggerAll = Var(30) = [1,2]
  Trigger1   = Time = 0
  Value      = s100,Var(30)*10
  Channel    = 1
  Loop       = 1

;---------------------------[ 移動関連 ]-----------------------------;

[State 100]
  Type     = VelSet
  Trigger1 = 1
  X        = const(velocity.run.fwd.x)

;-------------------------[ ステート変更 ]---------------------------;

[State 100]
  Type     = ChangeState
  Trigger1 = Command != "holdfwd"
  Value    = 0
  Ctrl     = 1

;------------------------------------------------------------------------------;
; フロントステップ
;------------------------------------------------------------------------------;
[Statedef 101]
  Type        = S
  Physics     = S
  Ctrl        = 0
  Anim        = 4000
  SprPriority = 1

[State 101]
  Type     = AssertSpecial
  Trigger1 = 1
  flag     = NoWalk

[State 101]
  Type     = AssertSpecial
  Trigger1 = 1
  flag     = NoAutoTurn

[State 101]
  Type     = PalFx
  Trigger1 = Time = 0
  Trigger1 = PrevStateNo = [150, 151]
  Time     = 5
  Add      = 230,230,230

;----------------------------[ ゲージ ]------------------------------;

[State 3100]
  Type     = PowerAdd
  Trigger1 = Time = 0
  Trigger1 = PrevStateNo = [150, 151]
  Value    = -500

;---------------------------[ 変数定義 ]-----------------------------;

[State 101]
  Type     = VarSet
  Trigger1 = Time = 0
  V        = 10
  Value    = 0
  IgnoreHitPause = 1

[State 101]
  Type     = VarSet
  Trigger1 = AnimElem = 2
  V        = 10
  Value    = 1
  IgnoreHitPause = 1

;---------------------------[ サウンド ]-----------------------------;

[State 101]
  Type     = PlaySnd
  Trigger1 = Time = 0
  Value    = s105,0

;---------------------------[ 移動関連 ]-----------------------------;

[State 101]
  Type     = VelSet
  Trigger1 = AnimElem = 2, >= 0 && AnimElem = 5, < 0
  X        = 6.5

[State 101]
  Type     = Null;VelSet
  Trigger1 = 1
  X        = const(velocity.run.fwd.x)

;-------------------------[ ステート変更 ]---------------------------;

[State 101]
  Type       = ChangeState
  TriggerAll = AnimElem = 4, >= 3
  Trigger1   = Command = "holdfwd"
  Value      = 100

[State 101]
  Type     = ChangeState
  Trigger1 = AnimTime = 0
  Value    = 0
  Ctrl     = 1

;------------------------------------------------------------------------------;
; バックステップ
;------------------------------------------------------------------------------;
[Statedef 105]
  Type        = S
  Physics     = S
  Ctrl        = 0
  Anim        = 105
  SprPriority = 1

[State 105]
  Type     = Null;CtrlSet
  Trigger1 = Time = 2
  Value    = 1

[State 105]
