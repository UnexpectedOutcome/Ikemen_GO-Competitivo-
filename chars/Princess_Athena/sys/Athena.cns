;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
Type = S
Ctrl = 0
Anim = 170
VelSet = 0,0

[State 170, 1]
Type = NotHitBy
Trigger1 = 1
Value = SCA
Time = 1

;---------------------------------------------------------------------------
; DRAWGAME (Time over)
[Statedef 175]
Type = S
Ctrl = 0
VelSet = 0,0

[State 175, 1] ; If no Anim, use go to lose state.
Type = ChangeState
Trigger1 = Time = 0
Trigger1 = !SelfAnimExist(175)
Value = 170

[State 175, 2]
Type = ChangeAnim
Trigger1 = Time = 0
Value = 175

[State 175, 3]
Type = NotHitBy
Trigger1 = 1
Value = SCA
Time = 1

;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
Type = S
Ctrl = 0
VelSet = 0,0

[State 190, 1]
Type = ChangeAnim
Trigger1 = SelfAnimExist(190)
Value = 190

[State 190, 2] ;Go straight to intro.
