;---------------------------[ 移動関連 ]-----------------------------;

[State 105]
  Type       = VelSet
  TriggerAll = Var(30) = 0
  Trigger1   = Time = 0
  X = const(velocity.run.back.x)
  Y = const(velocity.run.back.y)

[State 105]
  Type       = VelSet
  TriggerAll = Var(30) = [1,5]
  Trigger1   = Time = 0
  X          = -5.8
  Y          = -4.2

;-------------------------[ ステート変更 ]---------------------------;

[State 105]
  Type       = ChangeState
  TriggerAll = Var(30) = 0
  Trigger1   = Time = 14
  Value      = 106

[State 105]
  Type       = ChangeState
  TriggerAll = Var(30) = [1,5]
  Trigger1   = Vel Y > 0 && Pos Y >= 0
  Value      = 106

