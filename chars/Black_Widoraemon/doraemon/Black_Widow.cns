value = 107

[State 105, 3]
type = ChangeState
trigger1 = time = 10
value = 0
ctrl = 1
;------------------
; 壁に当たる
[Statedef 107]
type     = S
movetype = I
physics  = S
Anim = 107
ctrl = 0

[State 3000, NotHitby]
type = NotHitBy
trigger1 = 1
value = SCA

[State 1027, 振り返る]
type = Turn
trigger1 = (Time = 0) && (FrontEdgeBodyDist <= 30)

[State 1027, 軸位置移動]
type = PosAdd
trigger1 = Time = 0
x = 10 - BackEdgeBodyDist

[State 1027, 移動を止める]
type = VelSet
trigger1 = 1
x = 0
y = 0

[State 1027, 移動を止める]
type = VelSet
trigger1 = (Time >= 1) && (Time < 7)
x = -5

[State 1027, 移動を止める]
type = VelSet
trigger1 = (Time >= 7) && (Time < 14)
x = 5

[State -2, 3]
type = ScreenBound
trigger1 = 1
movecamera = 0,0

[State 1027, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 4,5

[State 1027, ステート変更]
type = ChangeState
trigger1 = time = 14
value = 100
ctrl = 0
