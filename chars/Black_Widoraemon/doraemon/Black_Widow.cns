physics = S
ctrl = 0
anim = 101

[State 106, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5120, 4]
type = PlaySnd
trigger1 = time = 0
value = 4, 2

[State 106, 4]
type = ChangeState
trigger1 = Time = 2
value = 0
ctrl = 1

