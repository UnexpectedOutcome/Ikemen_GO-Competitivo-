;NAOKの最後のCNSファイルです。長くなってしまう場合に、CNSを10個まで分割できます。

;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------

;----------------------------------------------------------------------------
;デバッグ支援記述集

; ※ この一連の記述は、キャラが完成したら消すか";"を付けて無効化しましょう。
;　　僅かにでも処理が重くなることが理由です。（ちなみにNullではダメです）


;デバッグモードに白い文字の表示を加える
[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 1
text = "FV38-f=%f,FV11-f=%f,FV20-f=%f,V58-D=%d,V59-D=%d"
params = fvar(38),fvar(11),fvar(20),var(58),var(59)
ignorehitpause = 1

;表示を下に加える
[State -2, デバッグ表示その3]
type = AppendToClipboard
trigger1 = 1
text = "\nDist X=%d,Y=%d, Vel X=%d/10,Y=%d/10 : Power=%d"
params = floor(P2BodyDist X),ceil(P2BodyDist Y),ceil(Vel X*10),floor(Vel Y*10),Power
ignorehitpause = 1

;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------ヘルパーアーマー-------------------------------
;---------------------------------------------------------------------------
;***************************************************************************
[state -2,ダメージ]
type=lifeadd
triggerall=!ishelper
triggerall=numhelper(2906)
trigger1=roundstate=2
trigger1=helper(2906),gethitvar(damage)
value=-helper(2906),GetHitVar(Damage)
absolute=1
ignorehitpause=1

[State -2, 画像の色]
type = PalFX
trigger1=numhelper(2906)
trigger1=helper(2906),gethitvar(damage)
time = 5
add = 200,200,200
pausemovetime = 99999999
IgnoreHitPause = 1


;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------補正云々---------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************

[State -2, 空中ガード不可]
Type = AssertSpecial
Trigger1 = 1
trigger2 = roundstate = 2
flag = NoAirGuard
ignorehitpause = 1

[State -2, スクロール];負けて倒れたらカメラワークを相手に移す処理
type = ScreenBound
triggerall = (Life <= 0) || (!Alive) || (Lose)
trigger1 = (StateNo = 5150) && (RoundState = 4)
value = 0
MoveCamera = 0,0
IgnoreHitPause = 1
;---------------------------------------------------------------------------
;変数管理

[state -2, コマンドリセット]
type = VarSet
trigger1 = StateNo = 0
trigger2 = StateNo = 52
trigger3 = StateNo = [5000,5210]
trigger4 = MoveType = H
var(1) = 0
ignorehitpause = 1
Persistent = 1

;;;;;;;;ヒット;;;;;
[state -2, ヒットリセット]
type = VarSet
trigger1 = var(3)
var(3) = 0
ignorehitpause = 1

[state -2, 投げヒット確認]
type = VarSet
Triggerall = movetype != H
Triggerall = time = 1
triggerall = !var(3)
trigger1 = stateno = [2900,2999]
var(3) = 6
ignorehitpause = 1

[state -2, 相打ち確認]
type = VarSet
Triggerall = NumTarget
Triggerall = Target,movetype = H
Triggerall = movetype = H
triggerall = !var(3)
trigger1 = movehit
var(3) = 30
ignorehitpause = 1

[state -2, 相打ち確認]
type = VarSet
Triggerall = EnemyNear(var(30)),movetype = H
Triggerall = movetype = H
triggerall = !var(3)
trigger1 = movehit
var(3) = 30
ignorehitpause = 1

[state -2, 弱ヒット確認]
type = VarSet
Triggerall = NumTarget
Triggerall = Target,movetype = H
Triggerall = Target,time = 2
triggerall = !var(3)
triggerall = Target,GetHitVar(fall) = 0
trigger1 = Target,GetHitVar(animtype) = 0
trigger1 = movehit = 1||(ProjHitTime(1020) = [1,2])||(ProjHitTime(2000) = [1,2])
var(3) = 1
ignorehitpause = 1

[state -2, 中ヒット確認]
type = VarSet
Triggerall = NumTarget
Triggerall = Target,movetype = H
Triggerall = Target,time = 2
triggerall = !var(3)
triggerall = Target,GetHitVar(fall) = 0
trigger1 = Target,GetHitVar(animtype) = 1
trigger1 = movehit = 1||(ProjHitTime(1020) = [1,2])||(ProjHitTime(2000) = [1,2])
var(3) = 2
ignorehitpause = 1

[state -2, 強ヒット確認]
type = VarSet
Triggerall = NumTarget
Triggerall = Target,movetype = H
Triggerall = Target,time = 2
triggerall = !var(3)
triggerall = Target,GetHitVar(fall) = 0
trigger1 = Target,GetHitVar(animtype) >= 2
trigger1 = movehit = 1||(ProjHitTime(1020) = [1,2])||(ProjHitTime(2000) = [1,2])
var(3) = 3
ignorehitpause = 1

[state -2, ダウンヒット確認]
type = VarSet
Triggerall = NumTarget
Triggerall = Target,movetype = H
Triggerall = Target,time = 1
triggerall = !var(3)
trigger1 = stateno < 2000
trigger1 = Target,GetHitVar(fall) = 1
trigger1 = movehit = 1||(ProjHitTime(1020) = [1,2])||(ProjHitTime(2000) = [1,2])
var(3) = 4
ignorehitpause = 1

[state -2, ダウンヒット確認]
type = VarSet
Triggerall = NumTarget
Triggerall = Target,movetype = H
Triggerall = Target,time = 1
triggerall = !var(3)
trigger1 = stateno >= 2000
trigger1 = Target,GetHitVar(fall) = 1
trigger1 = movehit = 1||(ProjHitTime(1020) = [1,2])||(ProjHitTime(2000) = [1,2])
var(3) = 5
ignorehitpause = 1

[state -2, ガードヒット確認]
type = VarSet
Triggerall = NumTarget
Triggerall = Target,movetype = H
triggerall = !var(3)
trigger1 = (MoveGuarded = 1&&HitPauseTime = 1)||(ProjGuardedTime(1020) = 1)||(ProjGuardedTime(2000) = 1)
var(3) = 10
ignorehitpause = 1

;**********************************
[State -2, 投げぬけリセット]
type = VarSet
trigger1 = stateno != 2980
var(11) = 0

[State -2, アピール]
type = VarSet
trigger1 = stateno = 190
var(12) = 1

[State -2, アピール]
type = VarSet
trigger1 =(stateno = 3000)&&animelem = 6
trigger2 =(stateno = 3010)&&animelem = 6
trigger3 =(stateno = 3020)&&animelem = 7
trigger4 =(stateno = 3030)&&animelem = 7
trigger5 =(stateno = 3041)&&animelem = 2
trigger6 =(stateno = 3050)&&animelem = 6
trigger7 =(anim = 3101)&&animelem = 1
var(12) = 0

[State -2, ダッシュ]
type = VarSet
trigger1 = stateno = 100
trigger2 = stateno = 107
var(13) = 1

[State -2, ダッシュリセット]
type = VarSet
trigger1 = stateno = 0||stateno = 52||stateno = 101
trigger2 = movetype = H
trigger3 = stateno = [700,769]
trigger3 = animtime = 0
var(13) = 0
ignorehitpause = 1
Persistent = 0

[state -2, KOリセット]
type = VarSet
trigger1 = Alive
var(16) = 0
ignorehitpause = 1[

[state -2, KOリセット]
type = VarSet
trigger1 = var(16) = -1
var(16) = 2
ignorehitpause = 1

[state -2, KOリセット]
type = VarSet
trigger1 = var(16) = 1
var(16) = -1
ignorehitpause = 1

[state -2, KO確認]
type = VarSet
triggerall = var(16) = 0
trigger1 = alive = 0
var(16) = 1
ignorehitpause = 1

[State -2,KO]
type = AssertSpecial
triggerall = var(15) = 1
triggerall = var(16) != 1
trigger1 = (StateNo != 5150)
trigger1 = enemynear,movetype != H
trigger1 = life >= 0 
flag = nokosnd
IgnoreHitPause = 1

[State -2, KOボイス]
type = PlaySnd
triggerall = var(15) = 1
trigger1 = var(16) = -1
value = 11,1

;::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;タッグ用生死判別
;::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
[State -2, タッグ用生死判別]
Type = VarSet
trigger1 = RoundState = 2
var(30) = 0 + (NumEnemy = 2 && EnemyNear(0),life <= 0)
IgnoreHitPause = 1

[State -2, アピール]
type = VarSet
trigger1 = RoundState = 2
fvar(0) = ifelse(var(12),1.1,1)

;***************************************************************************
;--------------------------補正---------------------------------------------
;***************************************************************************


;******************補正合計******************************************************
;---------------補正合計----------------------------------------

[State -2, アタック]
type = AttackMulSet
trigger1 = roundstate = 2
value = fVar(10)
ignorehitpause = 1

[State -2, ディフェンス]
type = DefenceMulSet
trigger1 = roundstate = 2
trigger1 = fVar(20)
value = 1/(fVar(20))
ignorehitpause = 1

[State -2, 補正合計]
type = VarSet
trigger1 = roundstate = 2
trigger1 = fVar(21)
fv = 10
value = ((fVar(11)*fVar(21)*fVar(14)*fVar(15)*(fVar(16)*fVar(17)))+fVar(12))
ignorehitpause = 1
;******************補正合計******************************************************

;******************コンボ補正******************************************************
