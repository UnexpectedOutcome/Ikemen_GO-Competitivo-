trigger1 = (100*life/const(data.life))/(100*EnemyNear(Var(30)),life/EnemyNear(Var(30)),const(data.life)) < 2
trigger2 = var(24) != 0
trigger3 = fvar(21) <= 0.9
fv = 21
value = 1

