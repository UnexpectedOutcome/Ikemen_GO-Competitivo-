;---------------------------------------------------------------------------
;Player X Dropped Puyo
[Statedef 1200]
;Var(0) = X Half-Step Counter
;Var(1) = X Fast-Forward Counter
;Var(2) = X Grid Pos
;Var(3) = Y Grid Pos
;Var(4) = Direction Counter
;Var(5) = Rotation-Display Communication
;Var(6) = Double Rotation Counter
;Var(7) = Distance from Nearest Ground
;Var(8) = Landing Timeout
;Var(9) = Controllessness
;Var(10-15) = Column Helper PlayerIDs
;Var(20) = Horizontal Button
;Var(21) = Down Button
;Var(22) = Rotation Button
;Var(30) = Pivot animation
;Var(31) = Annex animation
;Var(40) = Sound Var
;Var(50) = Pivot color
;Var(51) = Annex color
;Var(59) = Temp
;=======
;FVar(0) = Rotation Var
;FVar(1) = Double Rotation Var

[State 0, Bye]
type = RemoveExplod
trigger1 = IsHelper(1250) && Cond(NumHelper(1101), (Helper(1101), StateNo = 1109), 1)
trigger2 = IsHelper(2250) && Cond(NumHelper(2101), (Helper(2101), StateNo = 1109), 1)

[State 0, Bye]
type = ChangeState
trigger1 = IsHelper(1250) && Cond(NumHelper(1101), (Helper(1101), StateNo = 1109), 1)
trigger2 = IsHelper(2250) && Cond(NumHelper(2101), (Helper(2101), StateNo = 1109), 1)
value = 1251

[State 0, Column Helper Initialize]
type = Null
triggerall = time = 0
trigger1 = IsHelper(1250)
trigger1 = Var(10) := Helper(1101), ID || 1
trigger1 = Var(11) := Helper(1102), ID || 1
trigger1 = Var(12) := Helper(1103), ID || 1
trigger1 = Var(13) := Helper(1104), ID || 1
trigger1 = Var(14) := Helper(1105), ID || 1
trigger1 = Var(15) := Helper(1106), ID || 1
trigger2 = IsHelper(2250)
trigger2 = Var(10) := Helper(2101), ID || 1
trigger2 = Var(11) := Helper(2102), ID || 1
trigger2 = Var(12) := Helper(2103), ID || 1
trigger2 = Var(13) := Helper(2104), ID || 1
trigger2 = Var(14) := Helper(2105), ID || 1
trigger2 = Var(15) := Helper(2106), ID || 1

[State 0, Grid Pos Checker]
type = Null
triggerall = Var(3) := Floor((GameHeight-ScreenPos Y-24)/8) || 1
trigger1 = IsHelper(1250)
trigger1 = Var(2) := Floor((ScreenPos X - 16)/8) || 1
trigger2 = IsHelper(2250)
trigger2 = Var(2) := Floor((ScreenPos X - 208)/8) || 1

;=============== Control Manager ====================
;Var(20) = Horizontal Button
;Var(21) = Down Button
;Var(22) = Rotation Button

[State 191, Find Controller]
type = Null
trigger1 = IsHelper(1250)
trigger1 = Var(59) := Helper(1300), ID
trigger2 = IsHelper(2250)
trigger2 = Var(59) := Helper(2300), ID

[State 191, Button Handlers]
type = Null
trigger1 = Var(20) := PlayerID(Var(59)), Var(30) || 1
trigger1 = Var(21) := PlayerID(Var(59)), Var(31) || 1
trigger1 = Var(22) := PlayerID(Var(59)), Var(32) || 1

[State 191, Controllessness Assignment]
type = Null
triggerall = Var(9) = 0
trigger1 = Var(8) = 43
trigger1 = Var(9) := 1
;trigger2 = Var(8) = 1 && (Var(21) > 0)
;trigger2 = Var(9) := 1
;trigger2 = Var(8) := 23

[State 191, Controllessness]
type = Null
trigger1 = Var(9)
trigger1 = Var(20) := 0 || 1
trigger1 = Var(21) := 0 || 1
trigger1 = Var(22) := 0 || 1

;=============== Fast Forward Counter ====================
[State 191, Reset Counter]
type = VarSet
trigger1 = Var(20) = 0
trigger2 = Var(20) > 0
trigger2 = Var(1) < 0
trigger3 = Var(20) < 0
trigger3 = Var(1) > 0
v = 1
value = 0

[State 191, Counter Right]
type = VarAdd
trigger1 = Var(20) > 0
v = 1
value = 1

[State 191, Counter Left]
type = VarAdd
trigger1 = Var(20) < 0
v = 1
value = -1

;================= (Double) Rotation Area ======================
;0 = up, 1=right, 2=down, 3=left

[State 191, Double Rotation Cleanup]
type = VarSet
triggerall = Var(6) != 0
trigger1 = (Var(2)+Var(0))/2 > 0					;No wall on left side
trigger1 = Var(59) := Var(((Var(2)+Var(0))/2)+10-1)			;Set temp var to Left Column ID
trigger1 = Var(3)/2 >= PlayerID(Var(59)), Var(13)				;No Puyo on left side
trigger2 = (Var(2)+Var(0))/2 < 5					;No wall on right side
trigger2 = Var(59) := Var(((Var(2)+Var(0))/2)+10+1)			;Set temp var to Right Column ID
trigger2 = Var(3)/2 >= PlayerID(Var(59)), Var(13)				;No Puyo on right side
trigger3 = Var(4)%2=1
v = 6
value = 0

[State 191, Rotate CCW]
type = VarAdd
triggerall = Var(22) < 0
trigger1 = (Var(2)+Var(0))/2 > 0					;No wall on left side
trigger1 = Var(59) := Var(((Var(2)+Var(0))/2)+10-1)			;Set temp var to Left Column ID
trigger1 = Var(3)/2 >= PlayerID(Var(59)), Var(13)				;No Puyo on left side
trigger1 = Var(5) := -1
trigger2 = (Var(2)+Var(0))/2 < 5					;No wall on right side
trigger2 = Var(59) := Var(((Var(2)+Var(0))/2)+10+1)			;Set temp var to Right Column ID
trigger2 = Var(3)/2 >= PlayerID(Var(59)), Var(13)				;No Puyo on right side
trigger2 = Var(5) := -1
trigger3 = Var(4)%2=1
trigger3 = Var(5) := -1
v = 4
value = -1

[State 191, Double Rotation CCW]
type = VarAdd
triggerall = Var(22) < 0
trigger1 = Var(6) = -1						;Pressed a twice
trigger1 = Var(6) := 0 || 1
trigger1 = Var(5) := -2
trigger2 = Var(5) = 0						;Last controller didn't catch the a press
trigger2 = Var(6) := -1 && 0
v = 4
value = -2

[State 191, Rotate CW]
type = VarAdd
triggerall = Var(22) > 0
trigger1 = (Var(2)+Var(0))/2 > 0					;No wall on left side
trigger1 = Var(59) := Var(((Var(2)+Var(0))/2)+10-1)			;Set temp var to Left Column ID
trigger1 = Var(3)/2 >= PlayerID(Var(59)), Var(13)				;No Puyo on left side
trigger1 = Var(5) := 1
trigger2 = (Var(2)+Var(0))/2 < 5					;No wall on right side
trigger2 = Var(59) := Var(((Var(2)+Var(0))/2)+10+1)			;Set temp var to Right Column ID
trigger2 = Var(3)/2 >= PlayerID(Var(59)), Var(13)				;No Puyo on right side
trigger2 = Var(5) := 1
trigger3 = Var(4)%2=1
trigger3 = Var(5) := -1
v = 4
value = 1

[State 191, Double Rotation CW]
type = VarAdd
triggerall = Var(22) > 0
trigger1 = Var(6) = 1						;Pressed b/c twice
trigger1 = Var(6) := 0 || 1
trigger1 = Var(5) := 2
trigger2 = Var(5) = 0						;Last controller didn't catch the a press
trigger2 = Var(6) := 1 && 0
v = 4
value = 2

[State 191, CCW Roll Over]
type = VarAdd
trigger1 = Var(4) < 0
v = 4
value = 4

[State 191, CW Roll Over]
type = VarAdd
trigger1 = Var(4) > 3
v = 4
value = -4

;====================================================
[State 191, Visual Perpetuate]
type = Null
;Perpetuate
trigger1 = FVar(0) = (-1,0)
trigger1 = FVar(0) := FVar(0) - 0.125
trigger2 = FVar(0) = (0,1)
trigger2 = FVar(0) := FVar(0) + 0.125
;Double Perpetuate
trigger3 = FVar(1) = (-2,0)
trigger3 = FVar(1) := FVar(1) - 0.25
trigger4 = FVar(1) = (0,2)
trigger4 = FVar(1) := FVar(1) + 0.25

[State 191, Visual Rotate]
type = Null
;Rotate
trigger1 = Var(5) = 1 || Var(5) = -1
trigger1 = FVar(0) := Var(5)*0.125
trigger1 = Var(5) := 0 || 1
trigger1 = FVar(1) := 0 || 1
;Double Rotate
trigger2 = Var(5) = 2 || Var(5) = -2
trigger2 = FVar(1) := Var(5)*0.125
trigger2 = Var(5) := 0 || 1
trigger2 = FVar(0) := 0 || 1

[State 191, Visual End Cycle]
type = Null
trigger1 = FVar(0) = 1 || FVar(0) = -1
trigger1 = FVar(0) := 0 || 1

[State 191, Visual End Cycle Double]
type = Null
trigger1 = FVar(1) = 2 || FVar(1) = -2
trigger1 = FVar(1) := 0 || 1

;=============== Horizontal Movement ====================
[State 191, Move Left]
type = PosAdd
triggerall = Var(2)/2 > Cond(Var(4) = 3, 1, 0)				;Make sure puyo isn't at leftmost position
triggerall = Var(59) := Var(((Var(2)+Var(0))/2)+10-Cond(Var(4) = 3, 2, 1))	;Set temp var to Left Column ID
triggerall = Var(3)/2 >= PlayerID(Var(59)), Var(13) + Cond(Var(4) = 2, 1, 0)	;Bottom puyo is higher than left column
triggerall = Var(0) = 0 						;Not in half-step
trigger1 = Var(20) = -1						;Pressing back
trigger1 = Var(0) := -2
trigger1 = Var(40) := 1
trigger2 = Var(20) < 0 && Var(1) < -8					;Holding back for 8 seconds
trigger2 = Var(0) := -2
trigger2 = Var(40) := 1
x = -8

[State 191, Move Left Half-Step]
type = PosAdd
trigger1 = Var(0) = -1 && Var(2)%2 = 1					;Halfway through moving left
trigger1 = Var(0) := 0 || 1
trigger2 = Var(0) = -2
trigger2 = Var(0) := -1 && 0
x = -8

[State 191, Left Side Snap]
type = PosAdd
trigger1 = (Var(2)+Var(0))/2 = 0 && Var(4) = 3				;On left corner, and with appendage on left
trigger2 = (Var(2)+Var(0))/2 > 0 && Var(4) = 3				;Not on left corner, and with appendage on left
trigger2 = Var(59) := Var(((Var(2)+Var(0))/2)+10-1)			;Set temp var to Left Column ID
trigger2 = Var(3)/2 < PlayerID(Var(59)), Var(13)				;Appendage is overlapping with existing puyo
x = 16

[State 191, Move Right]
type = PosAdd
triggerall = Var(2)/2 < Cond(Var(4) = 1, 4, 5)				;Make sure puyo isn't at rightmost position
triggerall = Var(59) := Var(((Var(2)+Var(0))/2)+10+Cond(Var(4) = 1, 2, 1))	;Set temp var to Right Column ID
triggerall = Var(3)/2 >= PlayerID(Var(59)), Var(13) + Cond(Var(4) = 2, 1, 0)	;Bottom puyo is higher than right column
triggerall = Var(0) = 0 						;Not in half-step
trigger1 = Var(20) = 1						;Pressing forward
trigger1 = Var(0) := 2
trigger1 = Var(40) := 1
trigger2 = Var(20) > 0 && Var(1) > 8					;Holding forward for 8 seconds
trigger2 = Var(0) := 2
trigger2 = Var(40) := 1
x = 8

[State 191, Move Right Half-Step]
type = PosAdd
trigger1 = Var(0) = 1 && Var(2)%2 = 1					;Halfway through moving right
trigger1 = Var(0) := 0 || 1
trigger2 = Var(0) = 2
trigger2 = Var(0) := 1 && 0
x = 8

[State 191, Right Side Snap]
type = PosAdd
trigger1 = (Var(2)+Var(0))/2 = 5 && Var(4) = 1				;On right corner, and with appendage on right
trigger2 = (Var(2)+Var(0))/2 < 5 && Var(4) = 1				;Not on right corner, and with appendage on right
trigger2 = Var(59) := Var(((Var(2)+Var(0))/2)+10+1)			;Set temp var to Right Column ID
trigger2 = Var(3)/2 < PlayerID(Var(59)), Var(13)				;Appendage is overlapping with existing puyo
x = -16

[State 0, Grid Pos Checker]
type = Null
triggerall = Var(3) := Floor((GameHeight-ScreenPos Y-24)/8) || 1
trigger1 = IsHelper(1250)
trigger1 = Var(2) := Floor((ScreenPos X - 16)/8) || 1
trigger2 = IsHelper(2250)
trigger2 = Var(2) := Floor((ScreenPos X - 208)/8) || 1

[State 0, Distance From Nearest Ground]
type = Null
triggerall = Var(59) := Var(((Var(2)+Var(0))/2)+10)			;Set temp var to Current Column ID
triggerall = Var(7) := (Var(3) - Cond(Var(4) = 2, 2, 0) - (PlayerID(Var(59)), Var(13) * 2));Compare current column height to bottom puyo y pos??????????????

trigger1 = Var(2) > 1 && Var(4) = 3					;Not on left corner, and annex is on left
trigger1 = Var(59) := Var(((Var(2)+Var(0))/2)+10-1)			;Set temp var to Left Column ID
trigger1 = Var(7) > (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Check if existing value is smaller than following result
trigger1 = Var(7) := (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Compare left column height to left puyo y pos

trigger2 = Var(2) < 9 && Var(4) = 1					;Not on right corner, and annex is on right
trigger2 = Var(59) := Var(((Var(2)+Var(0))/2)+10+1)			;Set temp var to Right Column ID
trigger2 = Var(7) > (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Check if existing value is smaller than following result
trigger2 = Var(7) := (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Compare right column height to right puyo y pos

;=============== Vertical Movement/Collision ====================
[State 0, Grid Pos Checker]
type = Null
triggerall = Var(3) := Floor((GameHeight-ScreenPos Y-24)/8) || 1
trigger1 = IsHelper(1250)
trigger1 = Var(2) := Floor((ScreenPos X - 16)/8) || 1
trigger2 = IsHelper(2250)
trigger2 = Var(2) := Floor((ScreenPos X - 208)/8) || 1

[State 0, Distance From Nearest Ground]
type = Null
triggerall = Var(59) := Var(((Var(2)+Var(0))/2)+10)			;Set temp var to Current Column ID
triggerall = Var(7) := (Var(3) - Cond(Var(4) = 2, 2, 0) - (PlayerID(Var(59)), Var(13) * 2));Compare current column height to bottom puyo y pos??????????????

trigger1 = Var(2) > 1 && Var(4) = 3					;Not on left corner, and annex is on left
trigger1 = Var(59) := Var(((Var(2)+Var(0))/2)+10-1)			;Set temp var to Left Column ID
trigger1 = Var(7) > (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Check if existing value is smaller than following result
trigger1 = Var(7) := (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Compare left column height to left puyo y pos

trigger2 = Var(2) < 9 && Var(4) = 1					;Not on right corner, and annex is on right
trigger2 = Var(59) := Var(((Var(2)+Var(0))/2)+10+1)			;Set temp var to Right Column ID
trigger2 = Var(7) > (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Check if existing value is smaller than following result
trigger2 = Var(7) := (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Compare right column height to right puyo y pos

[State 191, Diving]
type = PosAdd
triggerall = Var(7) > 0
;triggerall = (time > 0 && time%8=0) || Var(21) > 0
triggerall = time%Cond(IsHelper(1250) && NumHelper(1000), Cond((Helper(1000), Var(1) = 5), 4, 8), Cond(NumHelper(2000), Cond((Helper(2000), Var(1) = 5), 4, 8), 8))=0 || Var(21) > 0
trigger1 = Floor(GameHeight-ScreenPos Y-24)%16=0 && !(Floor((GameHeight-ScreenPos Y-24)/16)-Cond(Var(4)=2,1,0) = 0)
trigger2 = Floor(GameHeight-ScreenPos Y-24)%16!=0
y = 8

[State 191, Bottom Snap]
type = PosAdd
trigger1 = Var(4) = 2 ;Annex is down
trigger1 = Var(7) < 0 ;Bottom puyo is below ground
y = Var(7) * 8

[State 191, Bottom Snap 2]
type = PosAdd
trigger1 = Var(4) = 1 || Var(4) = 3 ;Annex is left or right
trigger1 = Var(7) > 1 ;Bottom puyo at least 2 cells high
trigger1 = FVar(0) != 0 ;Is rotating
trigger1 = FVar(0) = [-0.15, 0.15] ;First frame of rotation
y = 8

[State 0, Grid Pos Checker]
type = Null
triggerall = Var(3) := Floor((GameHeight-ScreenPos Y-24)/8) || 1
trigger1 = IsHelper(1250)
trigger1 = Var(2) := Floor((ScreenPos X - 16)/8) || 1
trigger2 = IsHelper(2250)
trigger2 = Var(2) := Floor((ScreenPos X - 208)/8) || 1

[State 0, Distance From Nearest Ground]
type = Null
triggerall = Var(59) := Var(((Var(2)+Var(0))/2)+10)			;Set temp var to Current Column ID
triggerall = Var(7) := (Var(3) - Cond(Var(4) = 2, 2, 0) - (PlayerID(Var(59)), Var(13) * 2));Compare current column height to bottom puyo y pos??????????????

trigger1 = Var(2) > 1 && Var(4) = 3					;Not on left corner, and annex is on left
trigger1 = Var(59) := Var(((Var(2)+Var(0))/2)+10-1)			;Set temp var to Left Column ID
trigger1 = Var(7) > (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Check if existing value is smaller than following result
trigger1 = Var(7) := (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Compare left column height to left puyo y pos

trigger2 = Var(2) < 9 && Var(4) = 1					;Not on right corner, and annex is on right
trigger2 = Var(59) := Var(((Var(2)+Var(0))/2)+10+1)			;Set temp var to Right Column ID
trigger2 = Var(7) > (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Check if existing value is smaller than following result
trigger2 = Var(7) := (Var(3) - (PlayerID(Var(59)), Var(13) * 2))		;Compare right column height to right puyo y pos

;=============== Post-Vertical Controllers ====================
[State 0, Grid Pos Checker]
type = Null
triggerall = Var(3) := Floor((GameHeight-ScreenPos Y-24)/8) || 1
trigger1 = IsHelper(1250)
trigger1 = Var(2) := Floor((ScreenPos X - 16)/8) || 1
trigger2 = IsHelper(2250)
trigger2 = Var(2) := Floor((ScreenPos X - 208)/8) || 1

[State 0, Puyos make you lose control]
type = Null
trigger1 = Var(7) <= 0 && Var(8) = 0
trigger1 = Var(8) := 1
trigger1 = Cond((Var(21) > 0), (Var(9) := 1 && Var(8) := 23), 1) || 1
trigger2 = Var(8) > 0
trigger2 = Var(8) := Var(8) + 1

[State 0, Bouncing Annex]
type = Null
trigger1 = Var(31) = 0
trigger1 = (Var(8) = 1) || (Var(8) = 23 && Var(9) = 1)
trigger1 = Var(31) := 1
trigger2 = Var(31) > 0
trigger2 = Var(31) := Var(31) + 1

[State 0, Bouncing Pivot]
type = Null
trigger1 = Var(30) = 0 && Var(31) > 1
trigger1 = random <= Ceil(Var(31)*(999/8.0))
trigger1 = Var(30) := 1
trigger2 = Var(30) > 0
trigger2 = Var(30) := Var(30) + 1

[State 0, Too high]
type = Null
trigger1 = Var(7) > 1 && Var(8) > 0
trigger1 = Var(8) := 0 || 1
trigger1 = Var(9) := 0 || 1
trigger1 = Var(30) := -2 || 1
trigger1 = Var(31) := -2 || 1

[State 191, Score Sender]
type = Null
triggerall = NumHelper(300)
triggerall = (Var(21) > 0 && Var(7)%2 = 1) || (Var(8) = 24 && Var(9) = 1)
trigger1 = IsHelper(1250)
trigger1 = Helper(300), Cond(1, Var(0) := Var(0) + 1, 0) || 1
trigger2 = IsHelper(2250)
trigger2 = Helper(300), Cond(1, Var(20) := Var(20) + 1, 0) || 1

;================= Graphical Area ======================
[State 191, Startup Pivot]
type = RemoveExplod
triggerall = NumExplod(50504)
triggerall = Var(30) = 1
trigger1 = Var(4)%2 = 1						;Facing Left or Right
trigger1 = Var(59) := Var(((Var(2)+Var(0))/2)+10)				;Set Temp Var to Current Column ID
trigger1 = PlayerID(Var(59)), Var(13) = Var(3)/2
trigger2 = Var(4)%2 = 0						;Facing Up or Down
id = 50504

[State 191, Startup Annex]
type = RemoveExplod
triggerall = NumExplod(50505)
triggerall = Var(31) = 1
trigger1 = Var(4) = 1						;Facing Right
trigger1 = Var(59) := Var(((Var(2)+Var(0))/2)+10+1)			;Set Temp Var to Right Column ID
trigger1 = PlayerID(Var(59)), Var(13) = Var(3)/2
trigger2 = Var(4) = 3						;Facing Left
trigger2 = Var(59) := Var(((Var(2)+Var(0))/2)+10-1)			;Set Temp Var to Left Column ID
trigger2 = PlayerID(Var(59)), Var(13) = Var(3)/2
trigger3 = Var(4)%2 = 0						;Facing Up or Down
id = 50505

[State 191, Lifting Pivot]
type = RemoveExplod
trigger1 = Var(30) = -2 || Var(30) = 15
id = 50504

[State 191, Lifting Annex]
type = RemoveExplod
trigger1 = Var(31) = -2 || Var(31) = 15
id = 50505

[State 191, Bouncing Pivot]
type = Explod
trigger1 = Var(30) = 1 && !NumExplod(50504)
anim = ((Var(50))*10000) + 110;(root, Var((PlayerID(root, Var(10)), Var(0))+2))*10000+2
id = 50504
postype = p1
pos = 0,0
bindtime = -1
removetime = -1
sprpriority = 3
ownpal = 0

[State 191, Bouncing Annex]
type = Explod
trigger1 = Var(31) = 1 && !NumExplod(50505)
trigger1 = Var(40) := 2
anim = ((Var(51))*10000) + 110;(root, Var((PlayerID(root, Var(10)), Var(1))+2))*10000+1
id = 50505
postype = p1
pos = 0,0
bindtime = -1
removetime = -1
sprpriority = 3
ownpal = 0

[State 191, Basic Pivot]
type = Explod
trigger1 = !NumExplod(50504)
anim = ((Var(50))*10000) + 100;(root, Var((PlayerID(root, Var(10)), Var(0))+2))*10000+2
id = 50504
postype = p1
pos = 0,0
bindtime = -1
removetime = -1
sprpriority = 3
ownpal = 0

[State 191, Basic Annex]
type = Explod
trigger1 = !NumExplod(50505)
anim = ((Var(51))*10000);(root, Var((PlayerID(root, Var(10)), Var(1))+2))*10000+1
id = 50505
postype = p1
pos = 0,-16
bindtime = -1
removetime = -1
sprpriority = 3
ownpal = 0

[State 191, Explod 2]
type = ModifyExplod
triggerall = NumExplod(50505)
triggerall = FVar(39) := FVar(0) + Cond(FVar(0) > 0, -1, Cond(FVar(0) < 0, 1, 0)) || 1 ;Rotation Temp Var
trigger1 = FVar(1) != 0
trigger1 = FVar(39) := FVar(1) + Cond(FVar(1) > 0, -2, Cond(FVar(1) < 0, 2, 0)) || 1 ;Double Rotation Temp Var
trigger2 = 1
id = 50505
postype = p1
pos = Sin((Var(4)+FVar(39))*pi/2)*16, Cos((Var(4)+FVar(39))*pi/2)*-16

;======================= Misc. ======================
[State 0, Reset Animations]
type = Null
trigger1 = Var(7) > 0
trigger1 = Var(30) := 0 || 1
trigger1 = Var(31) := 0 || 1

;Debug
[State 0, Grid Pos Checker]
type = Null
triggerall = Var(3) := Floor((GameHeight-ScreenPos Y-24)/8) || 1
trigger1 = IsHelper(1250)
trigger1 = Var(2) := Floor((ScreenPos X - 16)/8) || 1
trigger2 = IsHelper(2250)
trigger2 = Var(2) := Floor((ScreenPos X - 208)/8) || 1

[State 0, HitDef]
type = DisplayToClipboard
trigger1 = 1
text = "%d, %d, %d"
params = Var(2), Var(3), Var(4)

[State 0, Sounds]
type = PlaySnd
trigger1 = Var(40) != 0
trigger1 = Var(59) := Var(40)
trigger1 = Var(40) := 0 || 1
value = 0, -1 + Var(59)
channel = -1
;lowpriority = -1

[State 0, Falling down]
type = ChangeState
trigger1 = Var(8) = 44
value = 1201

;---------------------------------------------------------------------------
;Player X Puyo Freefall
[Statedef 1201]
;Var(40) = Puyo 2 End Y Grid
;Var(41) = Bouncing Countdown
;Var(42) = Which puyo is falling? -1 = Pivot, 1 = Annex
;FVar(10) = Puyo 2 Relative Position

[State 0, Bye]
type = RemoveExplod
trigger1 = IsHelper(1250) && Cond(NumHelper(1101), (Helper(1101), StateNo = 1109), 1)
