trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Target Detection
[Statedef 800]
type = S
movetype = A
physics = N
sprpriority = 0

[State 0, HitDef]
type = HitDef
trigger1 = time = 0
attr = ,HT
hitflag = MAF-
affectteam = B
priority = 7,Hit
sparkno = S0
guard.sparkno = S0
hitsound = S-1,0
guardsound = S-1,0
numhits = 0
hitonce = 1

[State 0, Root is Enemy(n)]
type = Null
triggerall = NumEnemy && !Var(35)
trigger1 = Var(58) := Enemy, Cond(1, (Enemy(0), ID), 0)
trigger1 = root, ID = Var(58)
trigger1 = Var(35) := 1
trigger2 = Var(58) := Enemy, Cond(1, (Enemy(1), ID), 0)
trigger2 = root, ID = Var(58)
trigger2 = Var(35) := 2

[State 0, Custom State P2]
type = TargetState
triggerall = movehit = 1 && NumTarget
triggerall = !(Target, IsHelper)
trigger1 = Target, ID = Enemy(0), ID
trigger1 = Var(59) := 1 || 1
trigger2 = NumEnemy >= 2
trigger2 = Target, ID = Enemy(1), ID
trigger2 = Var(59) := 2 || 1
trigger3 = NumPartner
trigger3 = Target, ID = partner, ID
trigger3 = Var(59) := 3 || 1
value = 827477970 + Var(59)*30 + (Var(35)-1)*Cond(NumPartner, (Target, ID != partner, ID), 1)

[State 0, Send ID to root]
type = Null
triggerall = movehit = 1 && NumTarget
triggerall = !(Target, IsHelper)
trigger1 = IsHelper(800)
trigger1 = root, Cond(1, Var(10+(Helper(800), Var(59))) := (Helper(800), Cond(1, (Target, ID), 0)),0)
trigger2 = IsHelper(801)
trigger2 = root, Cond(1, Var(10+(Helper(801), Var(59))) := (Helper(801), Cond(1, (Target, ID), 0)),0)
trigger3 = IsHelper(802)
trigger3 = root, Cond(1, Var(10+(Helper(802), Var(59))) := (Helper(802), Cond(1, (Target, ID), 0)),0)

[State 0, Self-Destruction]
type = DestroySelf
trigger1 = movehit >= 2 && NumTarget
trigger1 = !(Target, IsHelper)
trigger2 = parent, StateNo != 0

