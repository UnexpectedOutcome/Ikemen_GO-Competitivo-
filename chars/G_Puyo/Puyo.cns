;Var(0) = Puyo Sorting
;Var(1-6) = Animations
;Var(8) = Game Timer
;Var(9) = Margin Time Backup
;Var(10) = RNG Seed

;Var(11) = P2 (Enemy 1) ID
;Var(12) = P4 (Enemy 2) ID
;Var(13) = P3 (Partner) ID

;Var(15) = Player Rounds Won
;Var(16) = Enemy Rounds Won

;Var(50) = Target Points
;Var(51) = Margin Time
;Var(52) = Minimum puyos per chain
;Var(53) = All Clear garbage bonus

[State 3000, Yes]
type = LifeAdd
trigger1 = TeamSide = 1 && Cond(NumHelper(1101), Helper(1101), Var(28) = 1108, 1)
trigger2 = TeamSide = 2 && Cond(NumHelper(2101), Helper(2101), Var(28) = 1108, 1)
value = -Life

[State 0, HitDef]
type = AssertSpecial
trigger1 = 1
flag = nofg
flag2 = globalnoshadow
flag3 = nobardisplay

[State 0, HitDef]
type = AssertSpecial
trigger1 = 1
flag = timerfreeze
flag2 = nokoslow

[State 0, Game Timer]
type = Null
trigger1 = Var(8) > 0
trigger1 = (Var(8) := Var(8) + 1) || 1
trigger2 = Var(8) = 0
trigger2 = Helper(400), Anim = 401 && Helper(400), AnimTime = 0
trigger2 = Var(8) := 1

[State 0, Margin Time Fix]
type = Null
triggerall = Var(50) > 1
trigger1 = Var(8) = Var(51)*60
trigger1 = Var(9) := Var(50) || 1
trigger1 = Var(50) := Floor(Var(50)*.75) || 1
trigger2 = ((Var(8) - Var(51)*60) = [0, 16*60*13]) && Var(8)%(16*60) = 0	;16= time between reductions, 60 = a second you idiot, 13 = amount of iterations, not counting initial
trigger2 = Var(59) := Var(50) || 1
trigger2 = Var(50) := Var(9)/2 || 1
trigger2 = Var(9) := Var(59) || 1

[State 0, Increment]
type = Null
trigger1 = Var(1) != 0
trigger1 = Var(1) := Var(1) + 1 && 0
trigger2 = Var(2) != 0
trigger2 = Var(2) := Var(2) + 1 && 0
trigger3 = Var(3) != 0
trigger3 = Var(3) := Var(3) + 1 && 0
trigger4 = Var(4) != 0
trigger4 = Var(4) := Var(4) + 1 && 0
trigger5 = Var(5) != 0
trigger5 = Var(5) := Var(5) + 1 && 0
trigger6 = Var(6) != 0
trigger6 = Var(6) := Var(6) + 1 && 0

[State 0, Stop]
type = Null
trigger1 = !AnimExist(10000+Var(1))
trigger1 = Var(1) := 0
trigger2 = !AnimExist(20000+Var(2))
trigger2 = Var(2) := 0
trigger3 = !AnimExist(30000+Var(3))
trigger3 = Var(3) := 0
trigger4 = !AnimExist(40000+Var(4))
trigger4 = Var(4) := 0
trigger5 = !AnimExist(50000+Var(5))
trigger5 = Var(5) := 0
trigger6 = !AnimExist(60000+Var(6))
trigger6 = Var(6) := 0

[State 0, Kickstart]
type = Null
triggerall = gametime%32 = 0
trigger1 = Var(1) = 0 && random%10 = 0
trigger1 = Var(1) := ((random%3)+1) * 1000 && 0
trigger2 = Var(2) = 0 && random%10 = 0
trigger2 = Var(2) := ((random%3)+1) * 1000 && 0
trigger3 = Var(3) = 0 && random%10 = 0
trigger3 = Var(3) := ((random%3)+1) * 1000 && 0
trigger4 = Var(4) = 0 && random%10 = 0
trigger4 = Var(4) := ((random%3)+1) * 1000 && 0
trigger5 = Var(5) = 0 && random%10 = 0
trigger5 = Var(5) := ((random%3)+1) * 1000 && 0
trigger6 = Var(6) = 0 && random%10 = 0
trigger6 = Var(6) := 1000 && 0

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "%d\t %d\t %d\t %d\t %d\t %d"
params = Var(1), Var(2), Var(3), Var(4), Var(5), Var(6)

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "%d, %d, %d"
params = Var(8), Var(9), Var(50)

[State 180, 1]
type = ChangeState
trigger1 = NumHelper(1250)
trigger1 = Helper(1250), StateNo = 1710 && Helper(1250), time >= 175
trigger2 = NumHelper(2250)
trigger2 = Helper(2250), StateNo = 1710 && Helper(2250), time >= 175
value = 180

