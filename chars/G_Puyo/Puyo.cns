;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win
[Statedef 180]
type = S
movetype = A
physics = N
sprpriority = 0

[State 180, 1]
type = ChangeState
trigger1 = prevstateno = 827478400 || prevstateno = 181
value = 181

[State 181, KILL Everything]
type = RemoveExplod
triggerall = time = 0
triggerall = prevstateno = 2100
trigger1 = NumHelper(1101)
trigger1 = Helper(1101), StateNo = [1109, 1110]
trigger1 = Helper(1101), Cond(1, Var(59) := 1337, 0) && 0
trigger2 = NumHelper(2101)
trigger2 = Helper(2101), StateNo = [1109, 1110]
trigger2 = Helper(2101), Cond(1, Var(59) := 1337, 0) && 0
trigger3 = 1

[State 191, Left Side Score 1]
type = Explod
trigger1 = !NumExplod(80)
anim = 320 + Var(14+TeamSide)%10
id = 80
postype = p1
pos = -ScreenPos X + 136,-ScreenPos Y + 57
sprpriority = 3
removetime = -1

[State 191, Left Side Score 2]
type = Explod
trigger1 = !NumExplod(81) && Var(14+TeamSide)/10 >= 1
anim = 320 + (Var(14+TeamSide)/10)%10
id = 81
postype = p1
pos = -ScreenPos X + 128,-ScreenPos Y + 57
sprpriority = 3
removetime = -1

[State 191, Right Side Score 1]
type = Explod
trigger1 = !NumExplod(82)
anim = 320 + Var(17-TeamSide)%10
id = 82
postype = p1
pos = -ScreenPos X + 184,-ScreenPos Y + 57
sprpriority = 3
removetime = -1

[State 191, Right Side Score 2]
type = Explod
trigger1 = !NumExplod(83) && Var(17-TeamSide)/10 >= 1
anim = 320 + (Var(17-TeamSide)/10)%10
id = 83
postype = p1
pos = -ScreenPos X + 176,-ScreenPos Y + 57
sprpriority = 3
removetime = -1

[State 191, P1 Win Fade]
type = Explod
trigger1 = !NumExplod(20)
trigger1 = Cond(NumHelper(1250), Helper(1250), StateNo = 1705, 1)
anim = 20
id = 20
postype = left
pos = 0,0
sprpriority = 2
removetime = -1

[State 191, P1 Win Stay]
type = Explod
trigger1 = !NumExplod(21)
trigger1 = Cond(NumHelper(2250), Helper(2250), StateNo = 1710, 1)
anim = 21
id = 21
postype = left
pos = 0,0
sprpriority = 2

[State 191, P1 Win Overlay]
type = Explod
trigger1 = !NumExplod(22)
trigger1 = Cond(NumHelper(2250), Helper(2250), StateNo = 1710, 1)
anim = 22
id = 22
postype = left
pos = 0,0
sprpriority = 4

[State 191, P2 Win Fade]
type = Explod
trigger1 = !NumExplod(23)
trigger1 = Cond(NumHelper(2250), Helper(2250), StateNo = 1705, 1)
anim = 23
id = 23
postype = left
pos = 0,0
sprpriority = 2
removetime = -1

[State 191, P2 Win Stay]
type = Explod
trigger1 = !NumExplod(24)
trigger1 = Cond(NumHelper(1250), Helper(1250), StateNo = 1710, 1)
anim = 24
id = 24
postype = left
pos = 0,0
sprpriority = 2

[State 191, P2 Win Overlay]
type = Explod
trigger1 = !NumExplod(25)
trigger1 = Cond(NumHelper(1250), Helper(1250), StateNo = 1710, 1)
anim = 25
id = 25
postype = left
pos = 0,0
sprpriority = 4

[State 0, HitDef]
type = AssertSpecial
trigger1 = 1
flag = nofg
flag2 = globalnoshadow
flag3 = nobardisplay

[State 0, HitDef]
type = AssertSpecial
trigger1 = 1
flag = timerfreeze
flag2 = nokoslow

;[State 180, 1]
;type = LifeAdd
;triggerall = time >= 1
;trigger1 = TeamSide = 1 && Cond(NumHelper(1250), Helper(1250), StateNo = 1710, 1)
;trigger2 = TeamSide = 2 && Cond(NumHelper(2250), Helper(2250), StateNo = 1710, 1)
;value = -Life

[State 180, 1]
type = ChangeState
trigger1 = Life = 0
trigger1 = time >= 1
value = 5150

[State 180, 1]
type = StateTypeSet
triggerall = time >= 1
trigger1 = TeamSide = 1 && Cond(NumHelper(1250), Helper(1250), StateNo = 1705, 1)
trigger2 = TeamSide = 2 && Cond(NumHelper(2250), Helper(2250), StateNo = 1705, 1)
movetype = I

[State 180, 1]
type = CtrlSet
trigger1 = MoveType = I
value = 1

[State 180, 1]
type = CtrlSet
trigger1 = RoundState = 4
value = 0

[State 0, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "%d, %d"
params = Life, MoveType = I

[State 0, 1]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

