trigger2 = Cond((Var(2) & (2**4)), Var(2) := (Var(59) + 4)*-1 || 1, 0)
trigger3 = Cond((Var(2) & (2**3)), Var(2) := (Var(59) + 3)*-1 || 1, 0)
trigger4 = Cond((Var(2) & (2**2)), Var(2) := (Var(59) + 2)*-1 || 1, 0)
