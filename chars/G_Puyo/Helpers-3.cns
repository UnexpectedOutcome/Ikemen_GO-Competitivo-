trigger1 = Var(59) := Var(59) || 1
trigger2 = Var(22) & ((2**12)-1)
trigger2 = Var(59) := Var(59) + 6 || 1
trigger2 = Var(22) := Var(22) / (2**6) || 1
trigger3 = Var(22) & ((2**18)-1)
trigger3 = Var(59) := Var(59) + 12 || 1
trigger3 = Var(22) := Var(22) / (2**12) || 1
trigger4 = Var(22) & ((2**24)-1)
