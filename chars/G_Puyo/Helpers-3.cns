trigger1 = (Helper(1250), Var(58) & ((2**24)-1)) != 0
trigger1 = (Var(2) := (Helper(1250), Var(58) & ((2**24)-1))) && Var(59) := 48 && 0
trigger2 = (Helper(1250), Var(57) & ((2**24)-1)) != 0
trigger2 = (Var(2) := (Helper(1250), Var(57) & ((2**24)-1))) && Var(59) := 24 && 0
trigger3 = (Helper(1250), Var(56) & ((2**24)-1)) != 0
trigger3 = (Var(2) := (Helper(1250), Var(56) & ((2**24)-1))) && Var(59) := 0 && 0
