;---------------------------------------------------------------------------
;Player X Control Handler
[Statedef 1300]

;Var(0) = Is P1 or P2?
;Var(1) = Player ID

;Var(10) = Left
;Var(11) = Right
;Var(12) = Up
;Var(13) = Down

;Var(14) = a
;Var(15) = b
;Var(16) = c
;Var(17) = a
;Var(18) = b
;Var(19) = c

;Var(20) = start

;Var(30) = Left+Right
;Var(31) = Down
;Var(32) = Rotation
;Var(33) = CCW
;Var(34) = CW

[State 0, Determine Player ID P1]
type = Null
triggerall = time = 0
triggerall = Var(0) := Cond(((IsHelper(1300) && root, TeamSide = 1) || (IsHelper(2300) && root, TeamSide = 2)), 1, 2)
triggerall = Var(0) = 1
trigger1 = PlayerIDExist(root, Var(13))
trigger1 = root, AILevel || (root, AILevel = 0 && PlayerID(root, Var(13)), AILevel = 0)
trigger1 = Var(1) := root, Var(13) || 1
trigger2 = Var(1) := root, ID || 1

[State 0, Determine Player ID P2]
type = Null
triggerall = time = 0
triggerall = Var(0) = 2
trigger1 = !PlayerIDExist(root, Var(12))
trigger1 = Var(1) := root, Var(11) || 1
trigger2 = (PlayerID(root, Var(11)), AILevel = 0 && PlayerID(root, Var(12)), AILevel = 0) || (PlayerID(root, Var(11)), AILevel && PlayerID(root, Var(12)), AILevel)
trigger2 = Var(1) := root, Var(10+RoundNo) || 1
trigger3 = PlayerID(root, Var(11)), AILevel = 0 && PlayerID(root, Var(12)), AILevel
trigger3 = Var(1) := root, Var(11) || 1
trigger4 = PlayerID(root, Var(11)), AILevel && PlayerID(root, Var(12)), AILevel = 0
trigger4 = Var(1) := root, Var(12) || 1

[State 0, Set Controls]
type = Null
triggerall = Var(14) := PlayerID(Var(1)), command = "a" || 1
triggerall = Var(15) := PlayerID(Var(1)), command = "b" || 1
triggerall = Var(16) := PlayerID(Var(1)), command = "c" || 1
triggerall = Var(17) := PlayerID(Var(1)), command = "x" || 1
triggerall = Var(18) := PlayerID(Var(1)), command = "y" || 1
triggerall = Var(19) := PlayerID(Var(1)), command = "z" || 1

triggerall = Var(20) := PlayerID(Var(1)), command = "start" || 1

triggerall = Var(12) := Cond((PlayerID(Var(1)), command = "holdup"), Cond(Var(12) >= 1, 2, 1), 0) || 1
triggerall = Var(13) := Cond((PlayerID(Var(1)), command = "holddown"), Cond(Var(13) >= 1, 2, 1), 0) || 1

trigger1 = PlayerID(Var(1)), Facing = 1
trigger1 = Var(10) := Cond((PlayerID(Var(1)), command = "holdback"), Cond(Var(10) >= 1, 2, 1), 0) || 1
trigger1 = Var(11) := Cond((PlayerID(Var(1)), command = "holdfwd"), Cond(Var(11) >= 1, 2, 1), 0) || 1

trigger2 = PlayerID(Var(1)), Facing = -1
trigger2 = Var(11) := Cond((PlayerID(Var(1)), command = "holdback"), Cond(Var(11) >= 1, 2, 1), 0) || 1
trigger2 = Var(10) := Cond((PlayerID(Var(1)), command = "holdfwd"), Cond(Var(10) >= 1, 2, 1), 0) || 1

[State 0, Set Final Controls]
type = Null
trigger1 = Var(30) := Var(11) || 1 ;Add Fwd
trigger1 = Cond(Var(10) != 0, Var(30) := -Var(10), 0) || 1 ;Add Back
trigger1 = Var(31) := Var(13) || 1 ;Add Down
trigger1 = Cond(Var(30) != 0, Var(31) := 0, 0) || 1 ;Down Nullification
trigger1 = Var(33) := Var(14) || 1
trigger1 = Var(34) := (Var(15) | Var(16)) || 1
trigger1 = Var(32) := -Var(33) + Var(34) || 1

[State 0, Determine Player]
type = DisplayToClipboard
trigger1 = 1
text = "   %d        %d, %d, %d, %d"
params = Var(12), Var(14), Var(15), Var(16), Var(20)

[State 0, Determine Player]
type = AppendToClipboard
trigger1 = 1
text = "\n%d, %d, %d     %d, %d, %d"
params = Var(10), Var(13), Var(11), Var(17), Var(18), Var(19)

;[State 0, Determine Player]
;type = DisplayToClipboard
;trigger1 = 1
;text = "%d, %d, %d"
;params = Var(30), Var(31), Var(32)

;---------------------------------------------------------------------------
;Carbuncle Intro 1
[Statedef 400]
anim = 400
sprpriority = 9

[State 0, Display]
type = ChangeAnim
trigger1 = NumHelper(1000) && NumHelper(2000) && NumHelper(1250) && NumHelper(2250)
trigger1 = Helper(1250), StateNo = 1251 && Helper(2250), StateNo = 1251
trigger1 = Helper(1000), Var(1) && Helper(2000), Var(1)
trigger1 = Anim = 400
value = 401

[State 0, Display]
type = ChangeState
trigger1 = Anim = 401 && AnimTime = 0
value = 401

;---------------------------------------------------------------------------
;Carbuncle Intro 2
[Statedef 401]
anim = 402

[State 0, Explosion]
type = PlaySnd
trigger1 = Var(0) = 0
value = 4,4
channel = -1
;lowpriority = -1

[State 0, Display]
type = Null
trigger1 = Var(0) < 32
trigger1 = Var(1) := random%5 || 1
trigger1 = FVar(0) := ((pi*2.0)/32.0)*Var(0)

[State 0, Explod]
type = Explod
trigger1 = Var(0) < 32
anim = 403
ID = 403
pos = 0,-7
postype = p1
bindtime = 1
vel = Sin(FVar(0))*(3+Var(1)/15.0),Cos(FVar(0))*(3+Var(1)/15.0)
random = 0,0
removetime = 180
shadow = 0,0,0
ownpal = 1
sprpriority = 10

[State 0, Display]
type = ChangeState
trigger1 = Var(0) < 32
trigger1 = Var(0) := Var(0) + 1
value = 401

[State 0, Display]
type = ChangeState
trigger1 = AnimTime = 0
value = 410

;---------------------------------------------------------------------------
;Carbuncle Idle
[Statedef 410]
anim = 410
sprpriority = 10

[State 0, Display]
type = DestroySelf
trigger1 = NumHelper(1101)
trigger1 = Helper(1101), Var(28) = 1108
trigger2 = NumHelper(2101)
trigger2 = Helper(2101), Var(28) = 1108

[State 0, Display]
type = DisplayToClipboard
trigger1 = 1
text = "%d, %f"
params = Var(0), FVar(0)

