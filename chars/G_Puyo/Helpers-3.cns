trigger1 = Helper(400), StateNo != 400
value = 301

;---------------------------------------------------------------------------
;Score Handler
[Statedef 301]
anim = 0
sprpriority = 3

[State 0, Misc Stuff]
type = Null
;Debug
;trigger1 = Var(0) := 18504973
;trigger1 = Var(20) := 37940581

triggerall = Var(1) := Cond(Var(0) = 0, 0, Floor(Log(10,Var(0)))) || 1
triggerall = Var(21) := Cond(Var(20) = 0, 0, Floor(Log(10,Var(20)))) || 1
;Increment Incoming Timer
triggerall = Cond(Var(4) = 1, Var(4) := 2, 1) || 1
triggerall = Cond(Var(24) = 1, Var(24) := 2, 1) || 1
;Start Incoming Timer
triggerall = Cond(Var(2) && !Var(4), Var(4) := 1, 1) || 1
triggerall = Cond(Var(22) && !Var(24), Var(24) := 1, 1) || 1
;Add Incoming Score to Total
triggerall = Cond(Var(4) = 1, Var(0) := Var(0) + (Var(2) * Var(3)), 1) || 1
triggerall = Cond(Var(24) = 1, Var(20) := Var(20) + (Var(22) * Var(23)), 1) || 1
;Kill Incoming Timer
trigger1 = Var(4) = 2 && NumHelper(1101)
trigger1 = (Helper(1101), Var(28) = 1102) || (Helper(1101), Var(30) > 20)
trigger1 = Var(2) := 0 && Var(3) := 0 && Var(4) := 0 && 0
trigger2 = Var(24) = 2 && NumHelper(2101)
trigger2 = (Helper(2101), Var(28) = 1102) || (Helper(2101), Var(30) > 20)
trigger2 = Var(22) := 0 && Var(23) := 0 && Var(24) := 0 && 0

