trigger2 = Var(0) := Cond(Var(0) = 3, Var(21)/1000, Var(0)) || 1		;Roll over last number
trigger2 = Var(21) := (Var(0)*1000) + Cond((Var(21)/1000) = Var(0), (Var(21)%10) + 1, 1)

