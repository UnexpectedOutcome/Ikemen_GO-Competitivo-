trigger1 = (Var(59) := Var(59) - 1) && 0
trigger2 = (Var(59) > 0) && ((random/999.0) < Var(59)/5.0)
trigger2 = Helper(1102), Cond(1, Var(33) := Var(33) + 1, 0) || 1
trigger2 = (Var(59) := Var(59) - 1) && 0
