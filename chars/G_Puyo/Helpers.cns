;---------------------------------------------------------------------------
;Player X Controller Startup
[Statedef 1000]
type = S
movetype = I
physics = N
anim = 0

;Var(0) = Chain Power
;Var(1) = Difficulty Counter
;Var(2) = First Puyo Drop Happened?
;Var(3) = Temporary Garbage Holding
;Var(4) = All Clear Flag

[State 0, Go To Intro]
type = ChangeState
trigger1 = time = 0
value = 1001

;---------------------------------------------------------------------------
;Player X Intro
[Statedef 1001]
type = S
movetype = I
physics = N
anim = 0

[State 191, P1 Intro Handyman]
type = Null
trigger1 = IsHelper(1000) && NumHelper(1250)
trigger1 = time = 32 && Helper(1250), StateNo = 1251

trigger1 = Helper(1250), Cond(1, FVar(30) := (Helper(1000), Pos X)+8, 1) || 1
trigger1 = Helper(1250), Cond(1, FVar(31) := (Helper(1000), Pos Y)-160, 1) || 1
trigger1 = Helper(1250), Cond(1, Var(32) := 1220, 1) || 1

[State 191, P2 Intro Handyman]
type = Null
trigger1 = IsHelper(2000) && NumHelper(2250)
trigger1 = time = 32 && Helper(2250), StateNo = 1251

trigger1 = Helper(2250), Cond(1, FVar(30) := (Helper(2000), Pos X)+8, 1) || 1
trigger1 = Helper(2250), Cond(1, FVar(31) := (Helper(2000), Pos Y)-160, 1) || 1
trigger1 = Helper(2250), Cond(1, Var(32) := 1220, 1) || 1

