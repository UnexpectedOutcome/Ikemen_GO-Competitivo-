;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
movetype = A
physics = N
sprpriority = 0

[State 0, Colours]
type = Turn
trigger1 = ctrl && Facing = -1

[State 0, Colours]
type = Null
triggerall = time = 0
triggerall = Var(10) := (random+1)*(random+1)*((random/5)+1) || 1
triggerall = Var(59) := 12345
triggerall = Var(0) := 0 || 1
trigger1 = Var(58) := random % (Floor(Log(10,Var(59)))+1) || 1
trigger1 = Var(0) := Var(0) + (Var(59)%(10**(Var(58)+1)))/(10**Var(58)) * (10**Cond(Var(0) = 0, 0, Floor(Log(10,Var(0)))+1)) || 1
trigger1 = Var(59) := ((Var(59) / (10**(Var(58)+1))) * (10**Var(58))) + (Var(59) % (10**Var(58))) || 1
trigger1 = 0
trigger2 = Var(58) := random % (Floor(Log(10,Var(59)))+1) || 1
trigger2 = Var(0) := Var(0) + (Var(59)%(10**(Var(58)+1)))/(10**Var(58)) * (10**Cond(Var(0) = 0, 0, Floor(Log(10,Var(0)))+1)) || 1
trigger2 = Var(59) := ((Var(59) / (10**(Var(58)+1))) * (10**Var(58))) + (Var(59) % (10**Var(58))) || 1
trigger2 = 0
trigger3 = Var(58) := random % (Floor(Log(10,Var(59)))+1) || 1
trigger3 = Var(0) := Var(0) + (Var(59)%(10**(Var(58)+1)))/(10**Var(58)) * (10**Cond(Var(0) = 0, 0, Floor(Log(10,Var(0)))+1)) || 1
trigger3 = Var(59) := ((Var(59) / (10**(Var(58)+1))) * (10**Var(58))) + (Var(59) % (10**Var(58))) || 1
trigger3 = 0
trigger4 = Var(58) := random % (Floor(Log(10,Var(59)))+1) || 1
trigger4 = Var(0) := Var(0) + (Var(59)%(10**(Var(58)+1)))/(10**Var(58)) * (10**Cond(Var(0) = 0, 0, Floor(Log(10,Var(0)))+1)) || 1
trigger4 = Var(59) := ((Var(59) / (10**(Var(58)+1))) * (10**Var(58))) + (Var(59) % (10**Var(58))) || 1
trigger4 = 0
trigger5 = Var(58) := random % (Floor(Log(10,Var(59)))+1) || 1
trigger5 = Var(0) := Var(0) + (Var(59)%(10**(Var(58)+1)))/(10**Var(58)) * (10**Cond(Var(0) = 0, 0, Floor(Log(10,Var(0)))+1)) || 1
trigger5 = Var(59) := ((Var(59) / (10**(Var(58)+1))) * (10**Var(58))) + (Var(59) % (10**Var(58))) || 1
trigger5 = 0

[State 0, HitDef]
type = AssertSpecial
trigger1 = 1
flag = nofg
flag2 = globalnoshadow
flag3 = nobardisplay

