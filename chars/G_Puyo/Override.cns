;priority = 7,Hit
;sparkno = S0
;guard.sparkno = S0
;hitsound = S0,0
;guardsound = S0,0
;numhits = 0
;hitonce = 0

[State 191, Bloody Hell]
type = Helper
trigger1 = !NumHelper(800) && ctrl
id = 800
name = "Target Detection 1"
pos = 0,0
postype = p1
stateno = 800
size.ground.back = 1
size.ground.front = 1

[State 191, Bloody Hell]
