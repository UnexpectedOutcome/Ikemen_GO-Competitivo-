params = Var(11), Var(12), Var(13)

[State 0, ChangeState]
type = ChangeState
trigger1 = ((Var(11) != 0) + (Var(12) != 0) + (Var(13) != 0)) >= NumEnemy+NumPartner
;trigger1 = !NumHelper(800) && !NumHelper(801) && !NumHelper(802)
value = 2000

