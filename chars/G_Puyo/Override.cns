;---------------------------------------------------------------------------
; Primary Enemy Handling
[Statedef 827478100]
type = S
movetype = H
physics = N
sprpriority = 0
ctrl = 0

[State 3000, Ready to migrate]
type = ChangeState
triggerall = Enemy(prevstateno%10), Cond(1, (NumHelper(1000) && NumHelper(2000) && NumHelper(1101) && NumHelper(2101)), 0)
trigger1 = (Enemy(prevstateno%10), Cond(1, Helper(Cond(TeamSide = 1, 2000, 1000)), StateNo = 1006, 0)) || (Enemy(prevstateno%10), Cond(1, Helper(Cond(TeamSide = 1, 2101, 1101)), Var(28) = 1108, 0))
trigger1 = (Enemy(prevstateno%10), Cond(1, Helper(Cond(TeamSide = 1, 1000, 2000)), StateNo = 1006, 0)) || (Enemy(prevstateno%10), Cond(1, Helper(Cond(TeamSide = 1, 1101, 2101)), Var(28) = 1108, 0))
value = 827478110 + prevstateno%10

;=============================================================================

[State 0, 1]
type = ChangeAnim
trigger1 = Enemy(prevstateno%10), Cond(1, (NumHelper(Cond(TeamSide = 1, 2300, 1300))), 0)
trigger1 = Anim != [10,11]
trigger1 = SelfAnimExist(10)
trigger1 = Enemy(prevstateno%10), Cond(1, (Helper(Cond(TeamSide = 1, 2300, 1300)), Var(31)), 0) > 0
value = 10

[State 0, 1]
type = ChangeAnim
trigger1 = Enemy(prevstateno%10), Cond(1, (NumHelper(Cond(TeamSide = 1, 2300, 1300))), 0)
trigger1 = Enemy(prevstateno%10), Cond(1, (Helper(Cond(TeamSide = 1, 2300, 1300)), Var(31)), 0) = 0
trigger1 = Anim = [10,11]
value = 12

[State 0, 1]
type = ChangeAnim
trigger1 = Enemy(prevstateno%10), Cond(1, (NumHelper(Cond(TeamSide = 1, 2300, 1300))), 0)
trigger1 = Enemy(prevstateno%10), Cond(1, (Helper(Cond(TeamSide = 1, 2300, 1300)), Var(31)), 0) = 0
trigger1 = Anim = 12 && AnimTime = 0
value = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Enemy(prevstateno%10), Cond(1, (NumHelper(Cond(TeamSide = 1, 2300, 1300))), 0)
trigger1 = Anim = 10 && AnimTime = 0
trigger1 = SelfAnimExist(11)
trigger1 = Enemy(prevstateno%10), Cond(1, (Helper(Cond(TeamSide = 1, 2300, 1300)), Var(31)), 0) > 0
value = 11

[State 0, 1]
type = ChangeAnim
trigger1 = Enemy(prevstateno%10), Cond(1, (NumHelper(Cond(TeamSide = 1, 2300, 1300))), 0)
trigger1 = Anim != 20
trigger1 = SelfAnimExist(20)
trigger1 = Enemy(prevstateno%10), Cond(1, (Helper(Cond(TeamSide = 1, 2300, 1300)), Var(30)), 0)*Facing > 0
value = 20

[State 0, 1]
type = ChangeAnim
trigger1 = Enemy(prevstateno%10), Cond(1, (NumHelper(Cond(TeamSide = 1, 2300, 1300))), 0)
trigger1 = Anim != 21
trigger1 = SelfAnimExist(21)
trigger1 = Enemy(prevstateno%10), Cond(1, (Helper(Cond(TeamSide = 1, 2300, 1300)), Var(30)), 0)*Facing < 0
value = 21

[State 0, 1]
type = ChangeAnim
trigger1 = Enemy(prevstateno%10), Cond(1, (NumHelper(Cond(TeamSide = 1, 2300, 1300))), 0)
trigger1 = Anim = [20,21]
trigger1 = Enemy(prevstateno%10), Cond(1, (Helper(Cond(TeamSide = 1, 2300, 1300)), Var(30)), 0) = 0
value = 0

;=============================================================================

[State 0, 1]
type = ChangeAnim
trigger1 = time = 30
trigger1 = Facing != Cond(TeamSide=1,-1,1)
trigger1 = SelfAnimExist(5)
value = 5

[State 0, 1]
type = VelSet
trigger1 = time = 10
x = ((GameWidth/2.0-ScreenPos X+Cond(TeamSide=1,-31,30))+(-40.0/const(size.head.pos.y)*const(size.ground.front))*Cond(TeamSide=1,1,-1))/20.0*Facing
y = (ScreenPos Y-175)/-20.0

[State 0, 1]
type = VelSet
trigger1 = time = 30
x = 0
y = 0

[State 0, 1]
type = Turn
trigger1 = time = 30
trigger1 = Facing != Cond(TeamSide=1,-1,1)

[State 0, 1]
type = ChangeAnim
trigger1 = Anim = 5 && AnimTime = 0
value = 0

[State 0, 1]
type = AngleDraw
trigger1 = time = [10,30)
scale = 1-(1+40.0/const(size.head.pos.y))/20*(time-10),1-(1+40.0/const(size.head.pos.y))/20*(time-10)

[State 0, 1]
type = AngleDraw
trigger1 = time >= 30
scale = -40.0/const(size.head.pos.y),-40.0/const(size.head.pos.y)

[State 0, 1]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

