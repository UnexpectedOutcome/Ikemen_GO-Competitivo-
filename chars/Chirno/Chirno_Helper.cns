trigger1 = time >= var(10)
trigger1 = time < var(10) + 10
time = 1
add = 0, 0, 0
mul = 128+floor((time-var(10))*12.8), 128+floor((time-var(10))*12.8), 128+floor((time-var(10))*12.8)
invertall = 0
color = 256

