[Statedef 4060]
Type	= A
Movetype= I
Physics = N
Anim = 4060
Ctrl = 0
Sprpriority = 6

[State 4060]
type = DestroySelf
trigger1 = time >= 12

[State 4060]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 4060]
type = AngleDraw
trigger1 = 1
scale = 2.8+0.4*time, 2.8+0.4*time
ignorehitpause = 1

[State 4060]
type = Trans
trigger1 = time < 4
trans = addalpha
alpha = 256, 256
ignorehitpause = 1

[State 4060]
type = Trans
trigger1 = time >= 4
trans = addalpha
alpha = 256-32*(time-4), 256
ignorehitpause = 1

