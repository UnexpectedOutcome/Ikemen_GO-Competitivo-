;--------------------------------------------------------------------------------
;変数の使用状況
;--------------------------------------------------------------------------------
; var(0)  - 汎用変数1
; var(1)  - 汎用変数2
; var(2)  - 軽量化判定
; var(3)  - タッグ生死判定
; var(4)  - カウンターヒット判定
; var(5)  - 空中ダッシュ/飛翔　回数の保存
; var(10) - MoveContact代入(MoveHit、MoveGuarded、MoveReversed)
; var(11) - MoveHitReset
; var(12) - ヒットフラグ
; var(13) - 射撃上位キャンセルフラグ
; var(14) - 射撃ジャンプキャンセルフラグ
; var(15) - 敵判別/p1p3判断
; var(16) - 敵判別/Enemy(0),ID
; var(17) - 敵判別/Enemy(1),ID
; var(21) - 最大霊力
; var(22) - 霊力回復までの時間
; var(25) - ボーダークラッシュ判定
; var(27) - 相手霊力回復までの時間
; var(30) - Chain Arts　フラグ
; var(31) - Chain Spell フラグ
; var(32) - Rift Attack フラグ
; var(33) - Smash Attackフラグ
; var(38) - 22コマンドのスキル

; fvar(0) - 総合ダメージ係数
; fvar(1) - 技補正
; fvar(2) - 攻撃力補正
; fvar(5) - 防御力補正
; fvar(6) - 現在霊力
; fvar(7) - 相手霊力ダメージ
; fvar(8) - 飛翔補助
; fvar(9) - 飛翔用
; fvar(10)- 追加重力

;--------------------------------------------------------------------------------

;--------------------------------------------------------------------------------
;基本設定
;--------------------------------------------------------------------------------
[Data]
life		  = 1000
power		  = 5000
attack		  = 100
defence		  = 100
fall.defence_up   = 50
liedown.time 	  = 60
airjuggle 	  = 15
sparkno 	  = -1
guard.sparkno 	  = -1
KO.echo 	  = 0
volume 		  = 0
IntPersistIndex   = 0
FloatPersistIndex = 0

[Size]
xscale		 = 1
yscale		 = 1
ground.back	 = 10		;キャラクターの幅（後方、地上）
ground.front	 = 10		;キャラクターの幅（前方、地上）
air.back 	 = 10		;キャラクターの幅（後方、空中）
air.front 	 = 10		;キャラクターの幅（前方、空中）
height 		 = 83		;キャラクターの高さ
attack.dist 	 = 160		;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist = 90		;相手がガード体勢に入る発射物との最低距離（最大320）
proj.doscale 	 = 0		;xscale, yscaleの設定が発射物にも適用するかどうか（1で有効）
head.pos 	 = 3,-68
mid.pos 	 = 3,-49
shadowoffset 	 = -1

[Velocity]
walk.fwd	= 3.25		;前に歩く時の速度
walk.back	= -3.25		;後ろに歩く時の速度
run.fwd		= 5.75, 0	;前に走る時の速度 (x, y) ホップさせる時はyを0以下にします
run.back	= -5.75, 0	;後ろに走る時の速度 (x, y) 走らせる時はyを0にします
jump.neu	= 0,-8		;ジャンプ時の垂直移動速度 (x, y)
jump.fwd	= 2.5		;前にジャンプした時の水平移動速度
jump.back	= -2.5		;後ろにジャンプした時の水平移動速度
runjump.fwd	= 0, 0		;前ダッシュジャンプ
runjump.back	= 0, 0		;後ダッシュジャンプ
airjump.neu	= 0, 0		;空中ジャンプ上
airjump.fwd	= 0		;空中で前にジャンプした時の水平移動速度
airjump.back	= 0		;空中で後ろにジャンプした時の水平移動速度

[Movement]
airjump.num	= 0	;空中ジャンプの回数 （オプション）
airjump.height	= 0	;空中ジャンプに必要な最低限の高さ （オプション）
yaccel		= 0.375	;垂直方向にかかる加速度（重力）
stand.friction	= 0.83	;立ち状態での摩擦係数
crouch.friction	= 0.83	;しゃがみ状態での摩擦係数
;--------------------------------------------------------------------------------


