;--------------------------------------------------------------------------------
;ジャンプ
;--------------------------------------------------------------------------------
[Statedef 50]
Type	= A
Physics = A
Ctrl = 0

[State 50]
type = ctrlset
trigger1 = time >= 4*(PrevStateno = [45, 46])
value = 1

[State 50]
type = varset
trigger1 = time = 0
sysvar(1) = 0

[State 50]
type = ChangeAnim
trigger1 = time = 0
value = IfElse(vel X = 0, 41, IfElse(vel X > 0, 42, 43))

[State 50]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = sysvar(2) = 0
trigger1 = command != "holddown"
value = 53

[State 50]
type = ChangeState
trigger1 = AnimTime = 0
value = 51

[State 50]
type = veladd
trigger1 = fvar(10) != 0
Y = fvar(10)

[State 50]
type = ChangeState
trigger1 = vel Y > 0 && pos Y >= 0
value = 52

;--------------------------------------------------------------------------------
;ジャンプ下降
;--------------------------------------------------------------------------------
[Statedef 51]
Type	= A
Physics = A
Anim = 51 - (PrevStateno = 50)

[State 51]
type = Turn
trigger1 = time = 0
trigger1 = PrevStateno = 80
trigger1 = p2BodyDist X < 0
trigger1 = FrontEdgebodyDist > 30

[State 51]
type = veladd
trigger1 = fvar(10) != 0
Y = fvar(10)

