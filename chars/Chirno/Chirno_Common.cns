;--------------------------------------------------------------------------------
;歩き
;--------------------------------------------------------------------------------
[Statedef 20]
Type	= S
Physics = S

[State 20]
type = Turn
trigger1 = p2Dist X < 0

[State 20]
type = ChangeState
triggerall = var(59) > 0
trigger1 = time = 0
value = 0
ctrl = 1

[State 20]
type = velset
triggerall = var(59) = 0
trigger1 = command = "holdfwd"
X = Const(velocity.walk.fwd.x)

[State 20]
type = velset
triggerall = var(59) = 0
trigger1 = command = "holdback"
X = Const(velocity.walk.back.x)

[State 20]
type = ChangeAnim
trigger1 = vel X >= 0 && Anim != 20
value = 20

[State 20]
type = ChangeAnim
trigger1 = vel X < 0 && Anim != 21
value = 21

;--------------------------------------------------------------------------------
;ジャンプ移行
;--------------------------------------------------------------------------------
[Statedef 40]
Type	= S
Physics = S
Anim = 40
Ctrl = 0

[State 40]
type = ChangeState
trigger1 = var(59) > 0
value = 0
ctrl = 1

[State 40]
type = varset
trigger1 = time = 0
fvar(10) = 0

[State 40]
type = varset
trigger1 = time = 0
sysvar(1) = 0

[State 40]
type = varset
trigger1 = var(59) = 0
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40]
type = varset
trigger1 = var(59) = 0
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40]
type = varset
trigger1 = time = 0
sysvar(2) = 0

[State 40]
type = varset
trigger1 = time = 0
sysvar(3) = 0

[State 40]
type = velset
trigger1 = AnimTime = 0
X = IfElse(sysvar(1)=0, 0, IfElse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
Y = const(velocity.jump.y)

[State 40]
type = AfterImage
trigger1 = time = 0
time = 0

[State 40]
type = NotHitBy
trigger1 = time = 0
value = , AT
time = 6
ignroehitpause = 1

[State 40]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

