trigger1 = 1
scale = 0.5+0.1*time, 0.5+0.1*time
value = var(0)
ignorehitpause = 1

[State 85]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256-32*time, 256
ignorehitpause = 1

