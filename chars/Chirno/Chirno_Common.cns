;--------------------------------------------------------------------------------
;ホバリング
;--------------------------------------------------------------------------------
[Statedef 53]
Type	= A
Physics = N
Ctrl = 1

[State 53]
type = ChangeAnim
triggerall = Anim != 53
trigger1 = PrevStateno != 120
trigger1 = time = 0
trigger2 = PrevStateno = 120
trigger2 = AnimTime = 0
value = 53

[State 53]
type = velset
trigger1 = 1
Y = 0.75 + 0.425*(sysvar(3) = 1)

[State 53]
type = velmul
triggerall = var(59) = 0
trigger1 = command != "holdfwd" && command != "holdback"
trigger1 = vel X != 0
X = 0.95

[State 53]
type = velset
triggerall = var(59) = 0
trigger1 = command = "holdfwd"
X = 3.5

[State 53]
type = velset
triggerall = var(59) = 0
trigger1 = command = "holdback"
X = -3.5

[State 53]
type = ChangeState
triggerall = var(59) = 0
trigger1 = command = "holddown"
value = 51

[State 53]
type = ChangeState
trigger1 = vel Y > 0 && pos Y >= 0
value = 52

;--------------------------------------------------------------------------------
;飛翔
;--------------------------------------------------------------------------------
[Statedef 80]
Type	= A
Movetype= I
Physics = N
Anim = 80
Velset = 0, 0
Ctrl = 0

[State 80]
type = varadd
trigger1 = time = 0
var(5) = 1

[State 80]
type = varset
trigger1 = var(22) < 2
var(22) = 2

[State 80]
type = varset
trigger1 = time = 0
sysvar(2) = 1

[State 80]
type = varset
trigger1 = time = 0
fvar(10) = -0.075

[State 80]
type = velset
trigger1 = AnimElemTime(3) >= 0
X = 6*var(0)*cos(fvar(9)*Pi/180)
Y = -6*sin(fvar(9)*Pi/180)

[State 80]
type = AssertSpecial
trigger1 = 1
flag = noautoturn

[State 80]
type = Helper
trigger1 = NumHelper(4800) = 0
name = "Grase"
ID = 4800
postype = p1
pos = 0, 0
Stateno = 4800
size.xscale = 1
size.yscale = 1
ownpal = 1
pausemovetime = 0
supermovetime = 0
ignorehitpause = 1

[State 80]
type = Helper
trigger1 = AnimElemTime(3) >= 0
trigger1 = NumHelper(81) = 0
name = "Cirno_Effect"
ID = 81
postype = p1
pos = 8,-42
Stateno = 81
size.xscale = 1
size.yscale = 1
ownpal = 1
ignorehitpause = 1

[State 80]
type = Helper
trigger1 = var(0) = 1
trigger1 = AnimElemTime(3) >= 0
trigger1 = time%8 = 0
name = "Dash_Ring"
ID = 87
postype = p1
pos = ceil(52*cos(fvar(9)*Pi/180)),-45-ceil(52*sin(fvar(9)*Pi/180))
Stateno = 85
size.xscale = 1
size.yscale = 1
ownpal = 1
ignorehitpause = 1

[State 80]
type = Helper
trigger1 = var(0) = -1
trigger1 = AnimElemTime(3) >= 0
trigger1 = time%8 = 0
name = "Dash_Ring"
ID = 87
postype = p1
pos = ceil(-34*cos(fvar(9)*Pi/180)),-45-ceil(52*sin(fvar(9)*Pi/180))
Stateno = 85
size.xscale = 1
size.yscale = 1
ownpal = 1
ignorehitpause = 1

[State 80]
type = PlaySnd
trigger1 = AnimElem = 3
value = S5, 4
persistent = 0

[State 80]
type = varset
trigger1 = time = 0
var(0) = IfElse(command = "holdback",-1, 1)

[State 80]
type = varset
trigger1 = var(0) = 1
trigger1 = command = "holdfwd"
trigger2 = var(0) = -1
trigger2 = command = "holdback"
fvar(8) = IfElse(command = "holdup", 45, IfElse(command = "holddown",-45, 0))

[State 80]
type = varset
triggerall = fvar(9) >= 0
trigger1 = var(0) = 1
trigger1 = command = "holdback"
trigger2 = var(0) = -1
trigger2 = command = "holdfwd"
fvar(8) = IfElse(command = "holdup", 135, IfElse(command = "holddown",-135, 180))

[State 80]
type = varset
triggerall = fvar(9) < 0
trigger1 = var(0) = 1
trigger1 = command = "holdback"
trigger2 = var(0) = -1
trigger2 = command = "holdfwd"
fvar(8) = IfElse(command = "holdup", 135, IfElse(command = "holddown",-135,-180))

[State 80]
type = varset
trigger1 = command != "holdfwd" && command != "holdback"
trigger1 = command = "holdup" || command = "holddown"
fvar(8) = IfElse(command = "holdup", 90,-90)

[State 80]
type = varset
trigger1 = time = 0
fvar(9) = fvar(8)

[State 80]
type = varadd
trigger1 = fvar(9) < fvar(8)
fvar(9) = 0.5

[State 80]
type = varadd
trigger1 = fvar(9) > fvar(8)
fvar(9) = -0.5

[State 80]
type = varset
triggerall = AnimElemTime(3) >= 0
trigger1 = fvar(9) > 90 || fvar(9) < -90
trigger1 = var(0) := -var(0)
fvar(9) = IfElse(fvar(9) >= 0, 1,-1) * (180-abs(fvar(9)))

[State 80]
type = varadd
trigger1 = AnimElemTime(3) >= 0
fvar(6) = -0.7

[State 80]
type = ChangeState
triggerall = time >= 13;AnimElemTime(3) >= 0
trigger1 = fvar(6) <= 0
trigger2 = var(59) = 0
trigger2 = command != "holdz"
value = 51
ctrl = 1

[State 80]
type = ChangeState
trigger1 = vel Y > 0 && pos Y >= 0
value = 83
ctrl = 1

