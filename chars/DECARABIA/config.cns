;プレスターン暴発防止用
[state -2]
type = varadd
trigger1 = 1
v = 17
value = 1

[State -2]
Type = DisplayToClipboard
Trigger1 = 1
Text = "var(17):%d, var(0):%d, var(0):%d, var(0):%d, var(0):%d"
Params = var(17), var(0), var(0), var(0), var(0)
IgnoreHitPause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999