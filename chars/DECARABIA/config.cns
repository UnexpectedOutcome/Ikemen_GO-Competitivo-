[Statedef -2]
;常時AI起動について（人操作はできなくなります）　
[state -2]
type = varset
Trigger1 = RoundState = 2
trigger1 = 1
v = 59
value = 0
;　　　↑このvalue = 0 人操作
;　　　　 　 value = 1 常時AI起動
;------------------------------------------------------------------------------------
;フォルネウスof/offスイッチ
[state -2]
type = varset
trigger1 = 1
v = 4
value = 0
;       ↑0でoff（いない）1でon（いる） 

;------------------------------------------------------------------------------------
;プレスターン設定
[state -2]
type = varset
trigger1 = 1
v = 6
value = 600
;↑valueフレーム経過でプレスターンが増加します

;初期プレスターン保持数（最大４）
[state -2]
type = varset
trigger1 = roundstate = [0,1]
trigger1 = roundno = 1
v = 57
value = 4

[state -2]
type = varadd
trigger1 = 1
trigger1 = roundstate = 2
v = 8
value = 1

[state -2]
type = varadd
trigger1 = var(8) = var(6)
v = 57
value = 1

[state -2]
type = varset
trigger1 = var(8) >= var(6)
trigger2 = var(57) >= 4
v = 8
value = 0

[state -2]
type = varset
trigger1 = var(57) >= 4
v = 57
value = 4

[state -2]
type = varset
trigger1 = var(57) <= 0
v = 57
value = 0
;------------------------------------------------------------------------------------
;フォルネウス体力設定
[state -2]
type = varset
trigger1 = 1
trigger2 = stateno = 5900
v = 7
value = 10
;↑value回数攻撃に耐えられます

;------------------------------------------------------------------------------------
;フォルネウス復帰設定
[state -2]
type = varset
trigger1 = 1
v = 10
value = 600
;↑ダウン時valueフレーム後に復帰します

;------------------------------------------------------------------------------------
;フォルネウス体力管理
[state -2]
type = varset
trigger1 = time = 1
trigger1 = roundstate = [0,1]
trigger1 = TeamMode = Single
trigger2 = time = 1
trigger2 = roundstate = 0
trigger2 = TeamMode = simul
trigger3 = RoundsExisted = 0
trigger3 = TeamMode = Turns
trigger3 = RoundsExisted >= 0
trigger3 = roundstate = [0,1]
trigger4 = stateno = 5900
trigger5 = roundstate = [0,1]
trigger5 = time = 0
persistent = 0
v = 58
value = var(7)

[state -2]
type = varset
trigger1 = var(58) < 0
trigger1 = roundstate = 2
v = 58
value = 0

[state -2]
type = varset
triggerall = numhelper(3000) >= 1
trigger1 = helper(3000),stateno = 3991
trigger2 = helper(3000),stateno = 3996
v = 58
value = var(7)
;------------------------------------------------------------------------------------
[state -2 暴走対策]
type = varset
Trigger1 = RoundState != 2
trigger1 = 1
v = 59
value = 0
;------------------------------------------------------------------------------------
;ランダムvar
[state -2]
type = Varrandom
trigger1 = 1
v = 0
range = 0,1000

;------------------------------------------------------------------------------------
;食らいボイス
[State -2]
type = PlaySnd
trigger1 = prevstateno = 4100
trigger1 = time = 0
persistent = 0
value = 0,24

[State -2]
type = PlaySnd
trigger1 = movetype = H
trigger1 = stateno != [120,155]
trigger1 = var(0) = [0,150]
trigger1 = time = 0
trigger1 = life >= Const(data.life)/100*70
persistent = 0
value = 0,16

[State -2]
type = PlaySnd
trigger1 = movetype = H
trigger1 = var(0) = [151,300]
trigger1 = stateno != [120,155]
trigger1 = time = 0
trigger1 = life >= Const(data.life)/100*70
persistent = 0
value = 0,17

[State -2]
type = PlaySnd
trigger1 = movetype = H
trigger1 = var(0) = [0,150]
trigger1 = stateno != [120,155]
trigger1 = time = 0
trigger1 = life <= Const(data.life)/100*69
trigger1 = life >= Const(data.life)/100*26
persistent = 0
value = 0,20

[State -2]
type = PlaySnd
trigger1 = movetype = H
trigger1 = var(0) = [151,300]
trigger1 = stateno != [120,155]
trigger1 = time = 0
trigger1 = life <= Const(data.life)/100*69
trigger1 = life >= Const(data.life)/100*26
persistent = 0
value = 0,21

[State -2]
type = PlaySnd
trigger1 = movetype = H
trigger1 = var(0) = [301,450]
trigger1 = stateno != [120,155]
trigger1 = time = 0
trigger1 = life <= Const(data.life)/100*69
trigger1 = life >= Const(data.life)/100*26
persistent = 0
value = 0,22

[State -2]
type = PlaySnd
trigger1 = movetype = H
trigger1 = var(0) = [0,350]
trigger1 = stateno != [120,155]
trigger1 = time = 0
trigger1 = life <= Const(data.life)/100*25
persistent = 0
value = 0,23

;------------------------------------------------------------------------------------
;コンボ補正
[State -2,AttackMulSet] 
Type = AttackMulSet 
Trigger1 = Enemynear,movetype != H
trigger1 = movetype = I 
Trigger2 = Enemynear,movetype = I 
Trigger3 = Enemy,GetHitVar(HitCount) =[0,1]
Value = 1

[State -2,AttackMulSet] 
Type = AttackMulSet 
TriggerAll = NumEnemy 
TriggerAll = Alive 
Trigger1 = Enemy,GetHitVar(HitCount) =[2,5]
Trigger1 = Enemynear,movetype = H
Value = 0.7

[State -2,AttackMulSet] 
Type = AttackMulSet 
TriggerAll = NumEnemy 
TriggerAll = Alive 
Trigger1 = Enemy,GetHitVar(HitCount) =[6,20]
Trigger1 = Enemynear,movetype = H
Value = 0.25

[State -2,AttackMulSet] 
Type = AttackMulSet 
TriggerAll = NumEnemy 
TriggerAll = Alive 
Trigger1 = Enemy,GetHitVar(HitCount) >=21
Trigger1 = Enemynear,movetype = H
Value = 0.1

;-------------------------------------------------------------------

;根性値を設定するコントローラーです。
;Valueがダメージ軽減率です。Value = 0.3なら、ダメージが30%軽減されます。
[State -2,根性値]
Type = VarSet
Trigger1 = 1
FV = 9
Value = (Life<750)*0.15+(Life<500)*0.15+(Life<250)*0.2 ;750未満で85%、500未満で70%、250未満で50%
Ignorehitpause = 1



;以下、いじらないで下さい

[State -2,攻撃食らってないときは、常にライフを上書き(都合上マイナス)]
Type = VarSet
Trigger1 = MoveType != H || (StateNo = [150,159]) || StateNo = [5200,5201]
V = 9
Value = -Life
Ignorehitpause = 1

[State -2,ダウン有効]
Type = VarSet
Trigger1 = StateType = L || StateNo = 5070
V = 9
Value = -1-LifeMax

[State -2,1hit目ダメージ軽減(この理由は"DefenceMulSet"のバグを参照)]
Type = LifeAdd
Trigger1 = MoveType = H && (StateNo != [150,159]) && StateNo != [5200,5201]
Trigger1 = Life && Alive
Trigger1 = Life < Var(9)
Value = Floor((Var(9)-Life)*FVar(9))
Ignorehitpause = 1

[State -2,ダメージ軽減]
Type = DefenceMulSet
Trigger1 = Var(9) >= -LifeMax
Value = 1-FVar(9)
Ignorehitpause = 1

[State -2,ダウン中ダメージ軽減]
Type = DefenceMulSet
Trigger1 = Var(9) < -LifeMax
Value = (1-FVar(9))*Const(Data.Fall.Defence_Mul)
Ignorehitpause = 1

[State -2,反復防止対策]
Type = VarSet
Trigger1 = MoveType = H && (StateNo != [150,159]) && StateNo != [5200,5201]
Trigger1 = Life < Var(9)
Trigger1 = Var(9)
V = 9
Value = 0
Ignorehitpause = 1

[State -2,1hit目のダメージ軽減をON]
Type = VarSet
Trigger1 = MoveType = H && (StateNo != [150,159]) && StateNo != [5200,5201]
Trigger1 = Var(9) < 0 && Var(9) > -1-LifeMax
V = 9
Value = -Var(9)
Ignorehitpause = 1

