trigger1 = Time = 0
value = s13, 0

[State 2000, ヒット定義（投げ用）]
type = HitDef
Trigger1 = 1
attr = S, ST          ;攻撃属性
hitflag = MAF          
priority = 6, Miss    ;投げなので優先度を低く、かつmissかdodgeの属性でなければなりません
sparkno = -1          ;-1にすればヒットスパークが表示しなくなります
sprpriority = 1       ;攻撃が当たった時に画像表示優先度を1に出来ます
;p1stateno = 2010       ;自分のステート変更
p2stateno = 2020       ;相手を制御するステートに行かせる
guard.dist = 0        ;相手がガード状態に移行出来る距離（現在は0なのでガード不可）
fall = 1              ;1にすれば相手がダウン状態になる

