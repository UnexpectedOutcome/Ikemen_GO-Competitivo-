[Statedef -3]

;これはジャンプ後とバックステップ後に着地音を鳴らすコントローラです。
[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ後の着地
trigger2 = stateno = 106 ;バックステップ後の着地
value = s6, 1


;■Life回復タイミング
[State -3]
type =lifeadd
trigger1 = var(56)>=1
Trigger1 = GameTime % 10 = 0
trigger1 = lose = 0
trigger1 = life>=2
value = 1

