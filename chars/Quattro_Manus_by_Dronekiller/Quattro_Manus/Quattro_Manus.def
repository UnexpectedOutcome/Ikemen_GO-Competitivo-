
[Info]
name = "Quattro_Manus"        ;Name of character
displayname = "Quattro Manus" ;Name of character to display
versiondate = 02,25,2016    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Dronekiller"         ;Character author name

; Files for the player
[Files]
cmd     = Quattro_Manus.cmd           ;Command set
cns     = Quattro_Manus.cns           ;Constants
st      = Quattro_Manus.cns           ;States
st2     = Quattro_Manus_Body.cns
st3     = Quattro_Manus_Projectile.cns
st4     = Quattro_Manus_Effect.cns
stcommon = Quattro_Manus_common.cns      ;Common states (from data/ or motif)
sprite  = Quattro_Manus.sff           ;Sprite <----Thanks to Dark Ruler for Ripped and Upload this Sprite
anim    = Quattro_Manus.air           ;Animation
sound   = Quattro_Manus.snd           ;Sound


; Maps character selection buttons to palette numbers.
;[Palette Keymap]
;x = 1 ;Press button X to select palette 1, etc.
;y = 2
;z = 3
;a = 4
;b = 5
;c = 6
;x2 = 7 ;Hold Start and press button X for palette 7, etc.
;y2 = 8
;z2 = 9
;a2 = 10
;b2 = 11
;c2 = 12
