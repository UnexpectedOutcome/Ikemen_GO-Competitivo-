;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown" && var(9) = 0
trigger2 = statetype = S && var(9) > 0
trigger2 = enemynear,hitdefattr = C,AA && Random <= 120*var(9)
trigger3 = statetype = S && var(9) > 0
trigger3 = enemynear,hitdefattr = S,AA && Random <= 500
trigger4 = statetype = S && var(9) > 0
trigger4 = enemynear,hitdefattr = SCA,AP && Random <= 500
trigger5 = statetype = S && p2statetype != A && Random <= 30*var(9)
trigger6 = statetype = S && var(9) = [1,3]
trigger6 = enemynear,hitdefattr = A,AA && Random <= 150
trigger7 = statetype = S && p2statetype != A && p2bodydist X > 100 && var(9) > 4 && Random <= 30*var(9)
trigger8 = statetype = S && var(9) > 0
trigger8 = enemy,stateno = fvar(24) && Random <= 120*var(9)
trigger9 = statetype = S && var(9) > 4
trigger9 = enemy,time < 7 && enemy,stateno != fvar(25)  && p2statetype != A && p2bodydist X < 150 && Random <= 80*var(9)
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown" && var(9) = 0
trigger2 = statetype = C && var(9) > 0
trigger2 = enemynear,hitdefattr = A,AA && Random <= 120*var(9)
trigger3 = statetype = C && var(9) > 0 && p2bodydist X <= 60
trigger3 = enemynear,hitdefattr = S,AA && Random <= 250
trigger4 = statetype = C && var(9) > 0 && p2bodydist X > 60
trigger4 = Random <= 25
trigger5 = statetype = C && p2statetype = A && Random <= 120*var(9)
trigger6 = enemy,stateno = fvar(25) && Random <= 120*var(9)
trigger6 = statetype = C && var(9) > 0
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = inguarddist && var(9) > 0
trigger3 = !inguarddist && var(9) > 0 && p2dist X < 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120]
type = AngleSet
trigger1 = 1
value = 0

[State 120]
type = AngleDraw
trigger1 = 1
scale = fvar(1),fvar(1)

[State 130, Stop Guarding]
type = ChangeState
trigger1 = var(9) = 0
trigger1 = command != "holdback"
trigger2 = var(9) = 0
trigger2 = !inguarddist
trigger3 = var(9)
trigger3 = !inguarddist && p2dist X >= 0
trigger4 = var(9)
trigger4 = enemy,movetype = I && p2dist X < 0
value = 140

;---------------------------------------------------------------------------
; STAND GUARD (guarding)
[Statedef 130]
type    = S
physics = S

[State 120, 1]
type = turn
trigger1 = p2dist X < 0 && var(9)

[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 130, Hi to Lo]
type = ChangeState
trigger1 = command = "holddown" && var(9) = 0
trigger2 = var(9) > 0
trigger2 = enemynear,hitdefattr = C,AA && p2bodydist X < 150 && Random <= 120*var(9)
trigger3 = var(9) > 0
trigger3 = enemynear,hitdefattr = S,AA && p2bodydist X < 150 && Random <= 500
trigger4 = var(9) > 0
trigger4 = enemynear,hitdefattr = SCA,AP && p2bodydist X < 150 && Random <= 120*var(9)
trigger5 = var(9) > 0
trigger5 = p2bodydist X >= 150 && Random <= 750
trigger6 = var(9) > 0
trigger6 = enemy,stateno = fvar(24) && Random <= 120*var(9)
trigger7 = enemy,time < 7 && enemy,stateno != fvar(25)  && p2statetype != A && p2bodydist X < 150 && var(9) > 4 && Random <= 80*var(9)
trigger8 = p2statetype != A && p2bodydist X > 100 && var(9) > 4 && Random <= 30*var(9)
value = 131

[State 120]
type = AngleSet
trigger1 = 1
value = 0

[State 120]
type = AngleDraw
trigger1 = 1
scale = fvar(1),fvar(1)

[State 130, Stop Guarding]
type = ChangeState
trigger1 = var(9) = 0
trigger1 = command != "holdback"
trigger2 = var(9) = 0
trigger2 = !inguarddist
trigger3 = var(9)
trigger3 = !inguarddist && p2dist X >= 0
trigger4 = var(9)
trigger4 = enemy,movetype = I && p2dist X < 0
value = 140

;---------------------------------------------------------------------------
; CROUCH GUARD (guarding)
[Statedef 131]
type    = C
physics = C

[State 131, 1]
type = ChangeAnim
trigger1 = Anim != 131 && var(9) = 0
trigger2 = Anim != 131 && var(9) > 0 && p2bodydist X < 120
value = 131

[State 131, 1]
type = ChangeAnim
trigger1 = Anim != 130 && var(9) > 0 && p2bodydist X >= 120
value = 130

[State 131, Lo to Hi]
type = ChangeState
trigger1 = command != "holddown" && var(9) = 0
trigger2 = var(9) > 0
trigger2 = enemynear,hitdefattr = A,AA && p2bodydist X < 150 && Random <= 120*var(9)
trigger3 = var(9) > 0
trigger3 = enemynear,hitdefattr = S,AA && p2bodydist X < 80 && Random <= 300
trigger4 = var(9) > 0
trigger4 = enemy,stateno = fvar(25) && Random <= 120*var(9)
trigger5 = var(9) > 0 &&  enemy,stateno != fvar(24)
trigger5 = enemynear,time > 7 && enemynear,statetype = S && p2bodydist X < 80 && Random <= 20*var(9)
trigger6 = var(9) > 0
trigger6 = p2bodydist X >= 150 && Random <= 250
trigger7 = var(9) > 0 && !inguarddist && enemy,numproj && Random <= 100*var(9)
value = 130

[State 130, Stop Guarding]
type = ChangeState
trigger1 = var(9) = 0
trigger1 = command != "holdback"
trigger2 = var(9) = 0 && !inguarddist
trigger3 = var(9) > 0 && !inguarddist && enemy,numproj = 0
value = 140

[State 120]
type = AngleSet
trigger1 = 1
value = 0

[State 120]
type = AngleDraw
trigger1 = 1
scale = fvar(1),fvar(1)

;---------------------------------------------------------------------------
; AIR GUARD (guarding)
[Statedef 132]
type    = A
physics = N

[State 132, 1]
type = ChangeAnim
trigger1 = Anim != 132
value = 132

[State 132, 2]
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 132, 3]
type = varset
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, 6]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = inguarddist
trigger1 = command = "holdback"
value = 130

[State 132, 7]
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 130, Stop Guarding]
type = ChangeState
trigger1 = var(9) = 0
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

