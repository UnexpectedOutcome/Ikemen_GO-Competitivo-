; Common state file for M.U.G.E.N beta 2002.04.14
; 
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump. 
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

; The following states have special handling within MUGEN, and should be
; overridden with caution:
; Jump Start (40): airjumping bookkeeping at time = 0
; All guard states (120-155): guard handling throughout state
; Hit_trip, shaking (5070): defence increases at time = 0
; Hit_bounce (5100): defence increases at time = 0, player becomes
;                    invincible if within 10 ticks of getting up
; Hit_liedown (5110): player changes to get-up state (5120) when ready
; Hit_getup (5120): player's defence is restored to normal at time = 0
; Hitfall_recover (5200): player's defence is restored at time = 0
; Hitfall_airrecover (5210): player's defence is restored at time = 0

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 0 , 5]
type = ChangeState
value = 130
triggerall = var(9) > 5
triggerall = !enemynear,hitdefattr = ,NT,ST,HT
trigger1 = p2movetype = A && Random <= 100*var(9) && var(9) > 5
trigger1 = p2dist X <= 0

[State 0 , 5]
type = varset
trigger1 = time = 0
fvar(1) = 1.0

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1] 
type = VelSet
trigger1 = command = "holdfwd" 
x = const(velocity.walk.fwd.x) 

[State 20, 2] 
type = VelSet
trigger1 = command = "holdback" 
x = const(velocity.walk.back.x) 

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Walk
[Statedef 21]
type    = S
physics = S
sprpriority = 0
ctrl = 0

[State 20, 1] 
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x) 

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeState
trigger1 = p2bodydist X <= 80
trigger2 = p2dist X < 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;
[Statedef 22]
type    = S
physics = S
sprpriority = 0
ctrl = 0

[State 20, 4]
type = ChangeState
trigger1 = 1
value = 100

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
ctrl = 0
velset = 0,0
sprpriority = 1

[State 40, varset]
type = varset
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, varset]
type = varset
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, varset]
type = varset
trigger1 = Time = 0
sysvar(2) = 0

[State 40, varset]
type = varset
trigger1 = Time = 0
sysvar(3) = 0

[State 40, varset]
type = varset
trigger1 = command != "holdup"
sysvar(3) = 1

[State 50, 1]
type = varset
trigger1 = Time = 0
sysvar(4) = 0

[State 40, VelSet]
type = VelSet
trigger1 = Anim = 40 && AnimTime = 0
x = ifelse(sysvar(1) = 0,0,ifelse(sysvar(1) = 1,ifelse(prevstateno = 100,4.2,const(velocity.jump.fwd.x)),const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, VelSet]
type = VelSet
trigger1 = Anim = 40 && AnimTime = 0 && !sysvar(2) && sysvar(3)
x = ifelse(sysvar(1) = 0,0,ifelse(sysvar(1) = 1,ifelse(prevstateno = 100,4,3),-2.6))
y = -7.7

[State 40, ChangeState]
type = ChangeAnim
trigger1 = Time = 0 && !var(9)
value = 40

[State 40, ChangeState]
type = ChangeState
trigger1 = Time = 0 && var(9)
value = 0
ctrl = 1

[State 40, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Start
[Statedef 41]
type    = S
physics = S
anim = 40
ctrl = 0
velset = 0,0
sprpriority = 1

[State 40, varset]
type = varset
trigger1 = var(9) > 0 && Random <= 950 && time = 0
trigger1 = p2bodydist x >= 55 || enemy,vel X < -2 && p2bodydist x = [56,65]
sysvar(1) = 1

[State 40, varset]
type = varset
trigger1 = var(9) > 0 && Random <= 50 && time = 0
trigger1 = p2bodydist x >= 55 || enemy,vel X < -2 && p2bodydist x = [56,65]
sysvar(1) = -1

[State 40, VarSet]
type = VarSet
trigger1 = var(9) > 0 && Random <= 950 && time = 1
trigger1 = p2bodydist x < 55 || enemy,vel X > 2 && p2bodydist x = [56,65]
trigger2 = var(9) && FrontEdgeDist < 70
trigger3 = var(9) > 0 && p2bodydist x < 80 && enemy,vel x > 4 && Random <= 900
trigger3 = p2movetype = A && time = 1
sysvar(1) = 0

[State 40, varset]
type = varset
trigger1 = Time = 0
sysvar(2) = 0

[State 40, varset]
type = varset
trigger1 = Time = 0
sysvar(3) = 0

[State 40, varset]
type = varset
trigger1 = var(9) > 0 && p2bodydist x <= 100 && p2statetype != A && Random <= 950 && time = 1
trigger2 = var(9) > 0 && p2bodydist x <= 120 && p2statetype != A && Random <= 950 && time = 1 && prevstateno = 100
sysvar(3) = 1

[State 50, 1]
type = varset
trigger1 = Time = 0
sysvar(4) = 0

[State 40, VelSet]
type = VelSet
trigger1 = AnimTime = 0 && !sysvar(3)
x = ifelse(sysvar(1) = 0,0,ifelse(sysvar(1) = 1,ifelse(prevstateno = 100,4.2,const(velocity.jump.fwd.x)),const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, VelSet]
type = VelSet
trigger1 = AnimTime = 0 && !sysvar(2) && sysvar(3)
x = ifelse(sysvar(1) = 0,0,ifelse(sysvar(1) = 1,ifelse(prevstateno = 100,4,3),-2.6))
y = -7.7

[State 40, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = varset
trigger1 = vel X > 0
trigger1 = sysvar(3)
sysvar(4) = 1

[State 50, 1]
type = AssertSpecial
trigger1 = sysvar(4) = 1
flag = noairguard

[State 50, 1]
type = varset
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(sysvar(3), 50, ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43)))

[State 40, VelSet]
type = VelSet
trigger1 = Time = 0 && !sysvar(3)
y = const(velocity.jump.y)

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 1]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 5110, 6]
type = EnvShake
trigger1 = Time = 0
time = 10
ampl = 2
freq = 60

[State 52, 1]
type = ChangeState
trigger1 = Time = 2
trigger1 = p2dist X < 0
value = 0
ctrl = 1

[State 52, 1]
type = CtrlSet
trigger1 = Time = 2
value = 1

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 1]
type = ChangeState
trigger1 = Time = 0
trigger1 = var(10) = 1
value = 280

[State 52, 1]
type = ChangeState
trigger1 = Time = 0
trigger1 = var(10) = 2
value = 980

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 99
ctrl = 0
sprpriority = 1

[State 2000]
type = PlayerPush
trigger1 = enemy,statetype = L
trigger1 = enemy,stateno != 5120
trigger1 = enemy,stateno != [5100,5101]
value = 0

[State 2000]
type = PlayerPush
trigger1 = enemy,statetype != L
trigger2 = enemy,stateno = 5120
trigger3 = enemy,stateno = [5100,5101]
value = 1

[State 100, 1]
type = varset
trigger1 = Time = 0
var(21) = 0

[State 100, 1]
type = varadd
trigger1 = Time > 0
var(21) = 1

[State 100, 1]
type = ChangeAnim
trigger1 = Anim = 99 && AnimTime = 0
value = 100

[State 100, 1]
type = PlaySnd
trigger1 = Anim = 100 && AnimElem = 1
value = 100, 0
channel = 6

[State 5100, 8]
type = Explod
triggerall = Anim = 100 
trigger1 = AnimElem = 1
anim = 6020
ignorehitpause = 1
postype = p1
vel = -4,0
pos = -40,0
ownpal = 1
sprpriority = 4

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, ChangeState]
type = ChangeState
trigger1 = command = "holdfwd" && command = "holdup" && !var(9)
value = 40

[State 100, ChangeState]
type = ChangeState
trigger1 = command = "holdback" && inguarddist && !var(9) && var(37)
value = 120

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd" && !var(9)
trigger2 = command = "holddown" && !var(9)
trigger3 = var(9) && p2dist X < 0 && time > 30
trigger4 = var(9) && p2bodydist X < 100 && p2statetype = L
trigger5 = var(9) && p2bodydist X < 50 && p2statetype = A
trigger6 = var(9) && p2statetype = L && p2stateno != [5100,5110]
trigger6 = p2bodydist X < 180 && !var(37) || p2bodydist X < 80 && var(37)
trigger7 = var(9) && !var(37) && enemy,vel X != 0 && p2statetype = L && p2stateno != [5100,5110]
trigger8 = var(9) && time > 100
trigger9 = var(9) && p2dist X < 0
value = 101
 
