x = -.7

[State 100, 1]
type = VelSet
trigger1 = time = 10
x = 0

[State 100, ChangeState]
type = ChangeState
trigger1 = command = "holdback" && inguarddist && !var(9) && var(37)
value = 120

[State 101, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = ifelse(command = "holddown",11,0)
ctrl = 1

