[State -2, VarRangeSet]
type = VarRangeSet
trigger1 = numhelper(7300)= 0
value = 0 ;fvalue = 0
first = 15
last = 23 ;39
ignorehitpause = 1
;persistent = 



[State -2, Mirage Tempo HitOverride]
type = HitOverride
trigger1 = numhelper(8500)=1
trigger1 = time%5 !=1
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
slot = 0
stateno = 920
time = 1
forceair = 0
;ignorehitpause = 
;persistent = 

[State -2, Trans]
type = Trans
trigger1 = time%8=0
trigger1 = numhelper(8500)=1
trans = addalpha
alpha = 256,256
;ignorehitpause = 
;persistent = 

[State -2, Debug]
type =DisplayToClipboard
trigger1 = 1
text = "%d %d %d %d %f"
params = var(5),  p2dist x, pos x, pos y, var(48)
ignorehitpause = 1

;=|Statedef -3|=====================================================
;Execute these whenever in State X
[Statedef -3]

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 0, 0



[State -3, Prevent Crossup]
type=width
trigger1=1
edge=8,0
ignorehitpause=1

[State -3, Prevent Underground Juggles] ;Copy from Pots' tutorial
type= targetbind
trigger1= movehit=1
trigger1= numtarget=1 && numenemy
trigger1= (target,time<=1) && (target,ID=enemynear,ID); this is just to prevent Simul issues as usual
trigger1= !(target,hitshakeover) && (target, hitfall) && (target, pos y>0)
pos= ceil(p2dist x), ceil(-pos y); keeps P2 at the same horizontal distance, but resets his Y position
ignorehitpause= 1
