;=|Statedef -2|=====================================================
;Always execute these.
[Statedef -2]

[State -2, PowerAdd]
type = PowerAdd
triggerall = roundstate = 2
;trigger1 = power < 500
trigger1 = time%3 = 0
value = 1

[State -2, Hitspark helper]
type = Helper
triggerall = stateno != 810 && stateno != 310  && stateno != 3000
triggerall = movehit = 1
trigger1 = numhelper(8001) = 0
trigger2 = numhelper(8001) = 1
trigger2 = helper(8001),time > 17
;trigger2 = stateno = 280 || stateno = 290
;trigger2 = movehit = 1 && numhelper(8001) <= 1
helpertype = normal
name = "hitspark"
ID = 8001
stateno = 8001
pos = ceil(-20*const(size.xscale)),ceil(-const(size.height)/2)
postype = p2
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 0
pausemovetime = 0
size.xscale = const(size.xscale);*.6
size.yscale = const(size.xscale);*.6
ignorehitpause = 1


[State -2, Guardspark helper]
type = Helper
trigger1 = numhelper(8010) = 0
trigger1 = moveguarded = 1
;trigger1 = stateno != 3010
helpertype = normal
name = "guardspark"
ID = 8010
stateno = 8010
pos = 0,ceil(-const(size.height)/2)
postype = p2
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 0
pausemovetime = 0
size.xscale = const(size.xscale)
size.yscale = const(size.xscale)
ignorehitpause = 1

[State -2, varset]
type = varset
trigger1 = roundstate = 2
trigger1 = gametime = 250
var(6) = enemy,numhelper

[State -2, no of balls on screen]
type = varset
trigger1 = 1
var(5) = numhelper(7200)+numhelper(7201)+numhelper(7202)+numhelper(7203)+numhelper(7204)+numhelper(7205)+numhelper(7206)+numhelper(7207)+numhelper(7208)

[State -2, no of balls on screen]
type = varset
trigger1 = 1
var(9) = (var(31) > 0 && var(31) < gamewidth)+(var(34) > 0 && var(34) < gamewidth)+(var(37) > 0 && var(37) < gamewidth)+(var(40) > 0 && var(40) < gamewidth)+(var(43) > 0 && var(43) < gamewidth)+(var(46) > 0 && var(46) < gamewidth)+(var(49) > 0 && var(49) < gamewidth)+(var(52) > 0 && var(52) < gamewidth)+(var(55) > 0 && var(55) < gamewidth)

[State -2, varset]
type = varset
trigger1 = numhelper(7200)=0
var(31) = 1000

[State -2, varset]
type = varset
trigger1 = numhelper(7201)=0
var(34) = 1000

[State -2, varset]
type = varset
trigger1 = numhelper(7202)=0
var(37) = 1000

[State -2, varset]
type = varset
trigger1 = numhelper(7203) = 0
var(40) = 1000

[State -2, varset]
type = varset
trigger1 = numhelper(7204) = 0
var(43) = 1000

[State -2, varset]
type = varset
trigger1 = numhelper(7205) = 0
var(46) = 1000

[State -2, varset]
type = varset
trigger1 = numhelper(7206) = 0
var(49) = 1000

[State -2, varset]
type = varset
trigger1 = numhelper(7207) = 0
var(52) = 1000

[State -2, varset]
type = varset
trigger1 = numhelper(7208) = 0
var(55) = 1000


[State -2, varset]
