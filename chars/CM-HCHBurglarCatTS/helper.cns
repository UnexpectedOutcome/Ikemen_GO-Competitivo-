hitsound = S903,16
guardsound = S0,3
ground.type = High   
ground.slidetime = 18
guard.slidetime = 18
ground.hittime = 18
guard.hittime = 18
air.hittime = 28
ground.velocity = -8,0
guard.velocity = -8
air.velocity = -.5,-5
envshake.time = 10
fall = 0
persistent = 35

[State 7000, Hitspark helper]
