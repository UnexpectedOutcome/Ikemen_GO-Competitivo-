;Clima-Tact
[statedef 7000]
type    = A
movetype= A
physics = N
ctrl = 0
anim = 7000
velset = 6,3
sprpriority = 3

[State 7000, 1]
type = PlaySnd
trigger1 = 1
value = S900, 7
channel = -1
persistent = 8
ignorehitpause = 1

[State 7000, AfterImage]
type = AfterImage
trigger1 = !time
time = -1
length = 10
palcolor = 256
palinvertall = 0
palbright = 30,30,30
palcontrast = 100,120,100
palpostbright = 10,50,50
paladd = 0,0,0
palmul = .65,.65,.65
timegap = 1
framegap = 3
trans = add ;"none","add1","sub"
;ignorehitpause = 
;persistent =

[State 7000, VelAdd];come back go down
type = VelAdd
trigger1 = vel x <= 0
y = 0.2;0.15
;gnorehitpause = 
persistent = 1

[State 7000, VelAdd];when go forward,go up
type = VelAdd
trigger1 = vel x > 0;pos x >= 4
y = -0.1
;gnorehitpause = 
persistent = 1

[State 7000, VelAdd]
type = VelAdd
trigger1 = vel x >= 0
x = -0.09
;gnorehitpause = 
persistent = 1

[State 7000, VelAdd]
type = VelAdd
trigger1 = vel x < 0
x = -0.3;-0.15

[State 7000, HitBy]
type = HitBy
trigger1 = 1
value = SCA,SP,HP
time = -1
ignorehitpause = 1
persistent = 1

[State 7000, HitOverride]
type = HitOverride
trigger1 =  1
attr = SCA,SP,HP
slot = 0
stateno = 7005
forceair = 0

[State 7000, HitDef]
type = HitDef
trigger1 = 1
attr = A,SP
hitflag = MAF        ;HLAFD+-
guardflag = MA    
animtype = heavy       
air.animtype = heavy
damage = 20,4
pausetime = 13,13
;guard.pausetime = 0,0
sparkno = -1
guard.sparkno = -1
