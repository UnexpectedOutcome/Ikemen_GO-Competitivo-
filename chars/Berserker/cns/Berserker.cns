;---------------------------------------------------------------------------
;パワー溜め（特殊行動）
[Statedef 700]
type     = S
movetype = I
physics  = S
ctrl     = 0
velset   = 0,0
anim     = 181
sprpriority = 1


[State 730, PowerAdd]
type = PowerAdd
triggerAll = Power < const(data.power) && Power < PowerMax
trigger1 = (command = "hold_a" && command = "hold_b")
value = 6 + ifElse(time < 60, 0, (time - 60) / 12)

[State 700, 押し判定]
type = PlayerPush
trigger1 = 1
value = 0

[State 8330, Charging Sound]
type = PlaySnd
trigger1 = !Time
value = 1,3
channel = 0

[State 700, エフェクト];「テンプレート.txt」参照
type = Explod
trigger1 = NumExplod(130) = 0
anim = f130
facing = -1
postype = p1
pos = -17,7
sprpriority = 3
ownpal = 1
removetime = -1
ID = 130

[State 700, ステート変更]
type = ChangeState
trigger1 = command != "hold_a"
trigger2 = command != "hold_b"
trigger3 = Power >= const(data.power) || Power >= PowerMax || RoundState != 2
value = 701

