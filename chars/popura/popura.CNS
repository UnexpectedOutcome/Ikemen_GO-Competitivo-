;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, 1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1000, 7

[State 190, 1]
type = Explod
trigger1 = AnimElem= 3
anim = 9025
postype = p1
pos = -5, -8
sprpriority = 3
;removetime = 33

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 192
;---------------------

