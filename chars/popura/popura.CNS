trigger1 = AnimElem= 1
anim = 9012
postype = p1
pos = -9, 24
sprpriority = 3
removetime = 40

[State 410, 1]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0

;This is the first hit, triggered on the 3rd element of animation.
