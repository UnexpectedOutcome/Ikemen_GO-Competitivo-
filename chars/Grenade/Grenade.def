; Definition file for Grenade-Kun
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Grenade"        ;Name of character
displayname = "Grenade" ;Name of character to display
versiondate = 09,09,2020    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "borderoflife"         ;Character author name
pal.defaults = 2,1,5,6      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1


; Files for the player
[Files]
cmd     = Grenade.cmd           ;Command set
cns     = Grenade.cns           ;Constants
st      = Grenade.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = Grenade.sff           ;Sprite
anim    = Grenade.air           ;Animation
sound   = Grenade.snd           ;Sound
pal1	= Normal.act
pal2	= Rebel.act
pal3	= Inverted.act
pal4	= Smurf.act
pal5	= Gold.act
pal6	= Silver.act

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 4
z = 5
a = 2
b = 3
c = 6
x2 = 1 ;Hold Start and press button X for palette 7, etc.
y2 = 4
z2 = 5
a2 = 2
b2 = 3
c2 = 6

; Arcade mode
[Arcade]
intro.storyboard = 
ending.storyboard = 
