type    = C
movetype= H
physics = C

[State -2]
Type = VarSet
triggerall = PalNo = 12
Trigger1 = HitOver
V = 10
Value = -Life


[State 5011, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5011, 2]
