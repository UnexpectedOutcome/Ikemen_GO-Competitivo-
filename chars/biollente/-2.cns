;神竜石--------------------------------------

[State -2, tiki]
type = ChangeAnim
triggerall = TeamMode = Single
triggerall = enemy,authorname = "UJI" && enemy,name = "tiki"
triggerall = stateno = 3521
trigger1 = 1
value = 7100
elem = 1

;------------------------------------------------------------
[State -2, アーマーヘルパー呼び出し]
type = Helper
triggerall = !NumHelper(9000) && MoveType != H
trigger1 = PalNo = 12 && StateNo = 3000 && Time = 1 ;放射樹液
trigger2 = StateNo = 1400 && Time = 1 ;噛みつき
name = "Armor"
stateno = 9000
ID = 9000
size.xscale = 1
size.yscale = 1
postype = p1
pos = 0,0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999

[State -2, 噛みつき中の無敵]
type = NotHitBy
trigger1 = NumHelper(9000)
trigger1 = stateno = 1400
value = ,NA,SA,NP,SP
time = 2

[State -2, 樹液中の無敵]
type = NotHitBy
trigger1 = NumHelper(9000)
trigger1 = PalNo = 12 && stateno = 3000
value = SCA
time = 2

[State -2, アーマー中に被弾した時の無敵時間延長（２重被弾抑制処置）]
type = NotHitBy
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = SCA
time = Helper(9000),GetHitVar(hitshaketime)+5

[State -2, アーマー受けした時の点滅]
type = PalFX
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
time = 5
add = 20,150,70
sinadd = 64,32,5,3


[State -2, アーマー受けした時のライフ減少]
type = LifeAdd
triggerall = PalNo != 12
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = ceil(-0.5*Helper(9000),GetHitVar(damage))
absolute = 1
ignorehitpause = 1

[State -2, アーマー受けした時のライフ減少]
type = LifeAdd
triggerall = PalNo = 12
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = ceil(-0.25*Helper(9000),GetHitVar(damage))
absolute = 1
ignorehitpause = 1
