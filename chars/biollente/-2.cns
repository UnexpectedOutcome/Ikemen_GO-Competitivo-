[Statedef -2]



;スイッチ----------------------------------------------------
;昇天スイッチ
[State -2]
type = varset
trigger1 = 1
var(4) = 1;←ここを0にすると決着時に昇天しない 

;ブリス演出スイッチ
[State -2, demitri]
type = varset
trigger1 = 1
var(5) = 1;←ブリスをスペゴジやられにするときはここを0にすること 

;12Pエフェクトスイッチ
[State -2]
type = varset
trigger1 = 1
var(9) = 1;←ここを0にすると12Pのきらきらしたエフェクトがなくなる
;---------------------------------------------------
[State -2,１２Pエフェクト]
type = Explod
triggerall = var(9) = 1
triggerall = PalNo = 12
triggerall = RoundState = 2
trigger1 = (GameTime%5)=0
anim = 4110
id = 4110
postype = P1
pos = 0,0
random = 100,50
scale = 1,1
ownpal = 1
sprpriority = 3

;12P防御力----------------------------------------------------------------
[State -2,ガード]
Type     = VarSet
triggerall = PalNo = 12
Trigger1 = Ctrl && StateNo%2 && StateNo = [151,155]
Trigger2 = PrevStateNo%2 = 0 && PrevStateNo = [150,154]
Trigger2 = StateNo%2 = 0 && StateNo = [150,154]
V        = 10
Value    = 0
Ignorehitpause = 1

[State -2,ライフ反転]
Type     = VarSet
triggerall = PalNo = 12
Trigger1 = MoveType != H
V        = 10
Value    = -Life
Ignorehitpause = 1

[State -2,一打目ダメージ軽減]
Type     = LifeAdd
triggerall = PalNo = 12
Trigger1 = MoveType = H
Trigger1 = Life && Alive
Trigger1 = Life < Var(10)
Value = Floor((Var(10)-Life)*FVar(2))
Ignorehitpause = 1
Absolute = 1

[State -2,ダメージ軽減]
Type     = DefenceMulSet
triggerall = PalNo = 12
Trigger1 = Var(10) >= -LifeMax
Value    = 1-FVar(2)
Ignorehitpause = 1

[State -2,ダウン有効]
Type     = VarSet
triggerall = PalNo = 12
Trigger1 = StateType = L || StateNo = 5070
Trigger1 = Var(10) = 0
V        = 10
Value    = -1-LifeMax
Ignorehitpause = 1

[State -2,ダウン中ダメージ軽減]
Type     = DefenceMulSet
triggerall = PalNo = 12
Trigger1 = Var(10) < -LifeMax
Value    = (1-FVar(2))*Const(Data.Fall.Defence_Mul)
Ignorehitpause = 1

[State -2,一打終了]
Type     = VarSet
triggerall = PalNo = 12
Trigger1 = MoveType = H
Trigger1 = Life <= Var(10) && Var(10)
V        = 10
Value    = 0
Ignorehitpause = 1

[State -2,ライフ]
Type     = VarSet
triggerall = PalNo = 12
Trigger1 = MoveType = H
Trigger1 = Var(10) < 0 && Var(10) > -1-LifeMax
V        = 10
Value    = -Var(10)
Ignorehitpause = 1


;Valueがダメージ軽減率です。Value = 0.3なら、ダメージが30%軽減されます。
[State -2,根性値]
Type     = VarSet
triggerall = PalNo = 12
Trigger1 = 1
FV       = 2
Value    = 0.5
Ignorehitpause = 1
;------------------------------------------------------

[State -2, 食らったら樹液が消える]
type = RemoveExplod
triggerall = NumExplod(4000)
trigger1 = Stateno != 3000
ID = 4000


[State 3001, ブリスヘルパーがどっかいったら消す]
type = DestroySelf
triggerall = numhelper(7000)
trigger1 = ishelper(7000)
trigger1 = helper(7000), StateNo != 7000



[State 3001, ヘルパーアーマーがどっかいったら消す]
type = DestroySelf
triggerall = numhelper(9000)
trigger1 = ishelper(9000)
trigger1 = helper(9000), StateNo != 9000


[State 3001, アドバシングヘルパーがどっかいったら消す]
type = DestroySelf
triggerall = numhelper(6010)
trigger1 = ishelper(6010)
trigger1 = helper(6010), StateNo != 6010



;アーマー可否varのリセット
[state -2, ダッシュアーマー可否のvarリセット]
type = VarSet
trigger1 = stateno != 100
v = 1
value = 0

