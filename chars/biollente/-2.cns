[State -2];HIT数補正
type = varset
triggerall = PalNo != 12
trigger1 = enemy,gethitvar(hitcount) = 9
fvar(0) = 0.38
ignorehitpause = 1
[State -2];HIT数補正
type = varset
triggerall = PalNo != 12
trigger1 = enemy,gethitvar(hitcount) = 10
fvar(0) = 0.31
ignorehitpause = 1
[State -2];HIT数補正
type = varset
triggerall = PalNo != 12
trigger1 = enemy,gethitvar(hitcount) >= 11
fvar(0) = 0.25
ignorehitpause = 1


[State -2];HIT数補正
type = varset
trigger1 = enemy,movetype != H
fvar(0) = 1.0

[State -2];非カウンター時
type = varset
trigger1 = p2movetype != A
fvar(1) = 1.0
ignorehitpause = 1

[State -2];カウンター時
type = varset
trigger1 = p2movetype = A
fvar(1) = 1.2
ignorehitpause = 1

;---------------------------------------------------------------------
[State -2, ボイス]
type = varrandom
trigger1 = Time = 0
v = 2
range = 0,2
Persistent = 0
ignorehitpause=1

[State -2, やられ声]
type = PlaySnd
triggerall = anim != 9020
trigger1 = movetype = H
trigger1 = var(2) = 0
value = 5000,0
volume = 0
channel = 0
lowpriority = 0
freqmul = 1
loop = 0
pan = 0

[State -2, やられ声]
type = PlaySnd
triggerall = anim != 9020
trigger1 = movetype = H
trigger1 = var(2) = 1
value = 5000,1
volume = 0
channel = 1
lowpriority = 0
freqmul = 1
loop = 0
pan = 0

[State -2, やられ声]
type = PlaySnd
triggerall = anim != 9020
trigger1 = movetype = H
trigger1 = var(2) = 2
value = 5000,2
volume = 0
channel = 1
lowpriority = 0
freqmul = 1
loop = 0
pan = 0




;ジャギ投げ-------------------------------------------------------------------
[State -2, JAGI-A]
type = ChangeAnim
trigger1 = enemy,authorname = "ahuron" && enemy,name = "Jagi"
trigger1 = movetype = H && stateno = 805
trigger1 = statetime >= 0
value = 5397


[State -2, JAGI-d]
type = ChangeAnim
trigger1 = enemy,authorname = "Drowin hokuto" && enemy,name = "Jagi"
trigger1 = movetype = H && stateno = 901
trigger1 = statetime >= 0
value = 34720



[State -2, JAGI-Ts]
type = ChangeAnim
trigger1 = enemy,authorname = "Ts" && enemy,name = "Jagi"
trigger1 = movetype = H && stateno = 805
trigger1 = statetime >= 0
value = 5397


;レイ投げ--------------------------------------
[State -2,rei]
type = VarSet
trigger1 = 1
v = 0
value = random%2 ;ランダムな整数を2で割った余り（偶数なら0、奇数は1）



[State -2, REI-A]
type = ChangeAnim
trigger1 = enemy,authorname = "ahuron" && enemy,name = "Rei"
trigger1 = var(0) = 0
trigger1 = movetype = H && (stateno = [806,807])
trigger1 = anim != 5398 && anim!= 5399
value = 5398

[State -2, REI-A2]
type = ChangeAnim
trigger1 = enemy,authorname = "ahuron" && enemy,name = "Rei"
trigger1 = var(0) = 1
trigger1 = movetype = H && (stateno = [806,807])
trigger1 = anim != 5398 && anim!= 5399
value = 5399

