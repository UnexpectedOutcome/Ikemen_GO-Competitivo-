;---------------------------------------------------------------------------
; ガード (開始)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
TriggerAll = StateType != A
trigger1 = abs(var(53)) = [0,2]
trigger1 = statetype = S && command = "holddown"
trigger2 = abs(var(53)) = [3,5]
trigger2 = !(EnemyNear(var(29)),HitDefAttr = A,AA,AP || P2StateType = A)
Trigger3 = P2MoveType = A
trigger3 = abs(var(53)) = [6,9]
trigger3 = !(EnemyNear(var(29)),HitDefAttr = SCA,AT)
trigger3 = (P2StateType != A && var(28) = 0) || var(28) = 2
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
TriggerAll = StateType != A
trigger1 = abs(var(53)) = [0,2]
trigger1 = statetype = C && command != "holddown"
trigger2 = abs(var(53)) = [3,5]
trigger2 = (EnemyNear(var(29)),HitDefAttr = A,AA,AP || P2StateType = A)
Trigger3 = P2MoveType = A
trigger3 = abs(var(53)) = [6,9]
trigger3 = !(EnemyNear(var(29)),HitDefAttr = SCA,AT)
trigger3 = (P2StateType = A && var(28) = 0) || var(28) = 1
statetype = S
physics = S

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = (120+(statetype = C)+(statetype = A)*2)+var(23)

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130+(statetype = C)+(statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
Triggerall = abs(var(53)) = [0,2]
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

[State -1, AI]
Type = ChangeState
Triggerall = abs(var(53)) = [3,9]
Triggerall = P2MoveType != A && NumProj = 0
Trigger1 = !InguardDist
Trigger2 = abs(P2bodydist X) > 50
Trigger3 = !Alive
Value = 140
IgnoreHitPause = 1

