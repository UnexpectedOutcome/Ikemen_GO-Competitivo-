;---------------------------------------------------------------------------
;AI用
;---------------------------------------------------------------------------
[Statedef -3]

[State -3]
Type = VarRandom
triggerall = var(53) != 0
Trigger1 = Time = 1
Trigger2 = MoveType = I
Trigger2 = 1
V = 55
Range = 0,99

;AI行動認識用
[State -3]
