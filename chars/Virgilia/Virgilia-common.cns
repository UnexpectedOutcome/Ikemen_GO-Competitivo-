;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
;Walk Fwd
[Statedef 21]
type    = S
physics = S
sprpriority = 0

[State 21, 1]
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x)

[State 21, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 21, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 0, ChangeState]
type = ChangeState
trigger1 =  p2bodydist X < 150
value = 0
ctrl = 1
;---------------------------------------------------------------------------
;Walk Back
[Statedef 22]
type    = S
physics = S
sprpriority = 0

[State 22, 1]
type = VelSet
trigger1 = 1
x = const(velocity.walk.back.x)

[State 22, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 22, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 0, ChangeState]
type = ChangeState
trigger1 =  p2bodydist X > 30
trigger1 = p2dist X > 100
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
movetype = H
ctrl = 0
sprpriority = 1

[State 0, SelfState]
type = SelfState
trigger1 = AILevel
trigger1 = !var(4)
value = 0
ctrl = 1

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = hitshakeover
movetype = I

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = movetype = I
triggerall = !hitpausetime
trigger1 = 1
value = 40
ignorehitpause = 1
persistent = 0

[State 40, 1]
type = VarSet
trigger1 = anim = 40
trigger1 = AnimElemTime(1) = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
triggerall = anim = 40
triggerall = AnimElemTime(1) = 0
trigger1 = !AILevel
trigger1 = command = "holdfwd" && command != "holdback"
trigger1 = p2dist X > 0
trigger2 = !AILevel
trigger2 = command = "holdback"
trigger2 = p2dist X < 0
trigger3 = AILevel
trigger3 = (var(4)&3) = 2
sysvar(1) = 1

[State 40, 3]
type = VarSet
triggerall = anim = 40
triggerall = AnimElemTime(1) = 0
trigger1 = !AILevel
trigger1 = command = "holdback"
trigger1 = p2dist X > 0
trigger2 = !AILevel
trigger2 = command = "holdfwd" && command != "holdback"
trigger2 = p2dist X < 0
trigger3 = AILevel
trigger3 = (var(4)&3) = 3
sysvar(1) = -1

[State 0, Turn]
type = Turn
triggerall = anim = 40
trigger1 = AnimElemTime(1) = 0
trigger1 = p2dist X < 0

[State 0, VarSet]
type = VarSet
trigger1 = anim = 40
trigger1 = (var(4)&12) = 8
trigger1 = sysvar(1) = 0
fv = 20
value = fvar(20)/2

[State 0, VelAdd]
type = VelAdd
trigger1 = anim = 40
trigger1 = (var(4)&12) = 8
trigger1 = vel X > 0
x = fvar(20)

[State 0, VelSet]
type = VelSet
triggerall = anim = 40
trigger1 = (var(4)&12) = 8 
trigger1 = vel X < 0
trigger2 = prevstateno != [100,101]
x = 0

[State 40, 4]
type = VelSet
triggerall = anim = 40
triggerall = (var(4)&12) = 0
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
triggerall = anim = 40
triggerall = (Var(4)&12) = 4
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = const(velocity.runjump.y)

[State 41, 5]
type = VelSet
triggerall = anim = 40
triggerall = (Var(4)&12) = 8
trigger1 = AnimTime = 0
x = vel X + ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = const(velocity.runjump.y)

