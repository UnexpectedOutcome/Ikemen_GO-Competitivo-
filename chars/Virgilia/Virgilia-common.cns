;---------------------------------------------------------------------------
; Air get-hit (falling)
[Statedef 5050]
type    = A
movetype= H
physics = N

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != [5090,5099] ;Not if hit off ground anim
trigger2 = Anim != 6021
value = 5050

[State 5050, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, Const720p(4), Const720p(-8))
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 2] 
type = ChangeAnim
trigger1 = anim = 6020 || anim = 6021
trigger1 = Vel Y >= ifelse(anim = 5050, Const720p(4), Const720p(-8))
value = 5060
persistent = 0

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 4] ;Recover near ground
type = null;ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= Const(movement.air.gethit.groundrecover.ground.threshold)
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "Recovery S"
value = 5200 ;Air get-hit (fall recovery on ground)

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
triggerall = !ailevel
trigger1 = Command = "Recovery"
value = 5210 ;Air get-hit (fall recovery in air)

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
triggerall = ailevel
trigger1 = playerid(var(55)),hitdefattr = SCA, AA, AT, AP || p2movetype = H || playerid(var(55)),numproj
value = 5210 ;Air get-hit (fall recovery in air)

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]) || (anim=[5090,5099]), 0, Const(movement.air.gethit.groundlevel))
value = 5100 ;Downed get-hit (hit ground from fall)
