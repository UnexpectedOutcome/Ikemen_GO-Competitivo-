trigger2 = Anim = [5110,5119]
value = 5150

[State 5110, 12]
type = VarAdd
trigger1 = Anim = [5110,5119]
;trigger1 = AnimElemTime(0) > 0
trigger1 = SysVar(0) > 0
sysvar(0) = -1

[State 5110, 15]
