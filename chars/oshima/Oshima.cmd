[State -1, Combo Condition Reset] ;初期化
type = VarSet
trigger1 = 1
var(1) = 0

[State -1, Combo Condition Check] ;キャンセル可なステ?トナンバ?を決定
type = VarSet
triggerall = movetype != H        ;ここに使っても無駄！
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,299]) || (stateno = [400,499])
trigger2 = stateno != 461
trigger2 = movecontact >= 2
trigger3 = (stateno = [200,299]) || (stateno = [400,499])
trigger3 = stateno != 461
trigger3 = !movecontact
trigger4 = stateno = 711
trigger5 = stateno = 712
var(1) = 1
ignorehitpause = 1

