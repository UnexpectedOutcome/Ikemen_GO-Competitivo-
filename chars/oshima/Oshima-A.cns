;---------------------------------------------------------------------------
; 給気座

[Statedef 720]
type     = C
movetype = I
physics  = C;※攻撃を受けるとSだけど体勢的に
ctrl     = 0
velset   = 0,0
anim     = 720
sprpriority = 2

[State 720, varset]
type = varset
trigger1 = Time = 0
var(14) = 0

[State 720, 速度加算] ;重力
type = VelAdd
trigger1 = Pos Y <= -1
y = .40

[State 720, 軸位置設定] ;地面の位置に軸をリセット
type = PosSet
trigger1 = Vel Y > 0 && Pos Y >= -5
y = 0

[State 720, VelSet]
type = VelSet
trigger1 = Vel Y > 0 && Pos Y >= 0
y = 0

[State 720, PosAdd]
type = PosAdd
trigger1 = AnimElem = 1
x = 1

[State 720, ボイス]
type = PlaySnd
trigger1 = Time = 1
value = 11,1
channel = 0

[State 720, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 0, 17
channel = 1

[State 720, パワーが溜まる]
type = PowerAdd
trigger1 = Time = 1
value = 78

[State 720, varset]
type = varset
triggerall = var(59) = 0
triggerall = var(14) = 0
trigger1 = time = [7,15]
trigger1 = command = "bb"
trigger1 = command = "holddown"
var(14) = 721

[State 720, varsetステート変更]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = var(59) = 0
trigger1 = var(14) != 0
value = var(14)

[State 720, AIステート変更]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = var(59) != 0
trigger1 = RoundState = 2
Trigger1 = EnemyNear(var(55)),StateType = L
;Trigger1 = P2BodyDist X = [61,170]
value = 721

[State 720, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = RoundState != [1,2]
value = 0
ctrl = 1

