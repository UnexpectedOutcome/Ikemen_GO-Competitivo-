
;---------------------------------------------------------------------------
;基本データ部分
[Data]
life              = 1000  ;体力ゲージの最大値を決めます
power             = 3000  ;パワーゲージ最大値（原作風なら1000にする）
attack            = 100   ;攻撃力パーセンテージ（デフォルトは 100% になります）
defence           = 100   ;防御力パーセンテージ（デフォルトは 100% になります）
fall.defence_up   = 50    ;一時的に上昇するダウン時の防御力パーセンテージ
liedown.time      = 30    ;倒れてから起き上がるまでの時間
airjuggle         = 15    ;ジャグルポイント限界値　★１
sparkno           = 2     ;デフォルトのヒットスパーク番号（fightfx.airか、キャラのairから呼び出す）
guard.sparkno     = 40    ;デフォルトのガードスパーク番号（fightfx.airか、キャラのairから呼び出す）
KO.echo           = 0     ;ＫＯ時の声にエコーを掛けるかどうか（0=しない・1=する）
volume            = 255   ;キャラの音量　255が最高
intpersistindex   = 20    ;Varを次のラウンドへ持ち越しが可能 (最小=0, 最大=59)  ★２
floatpersistindex = 40    ;FVarを次のラウンドへ持ち越しが可能 (最小=0, 最大=39) ★２

;---------------------------------------------------------------------------
;サイズ設定
[Size]
xscale           = 1        ;キャラ画像の横のスケール
yscale           = 1        ;キャラ画像の縦のスケール
ground.back      = 18       ;キャラの幅（地上後方）
ground.front     = 20       ;キャラの幅（地上前方）
air.back         = 12       ;キャラの幅（空中後方）
air.front        = 12       ;キャラの幅（空中前方）
height           = 40       ;跳び越す相手のためのキャラの高さ
attack.dist      = 200      ;攻撃を出した時に相手がガード体勢に入る最低の距離
proj.attack.dist = 90       ;相手がガード体勢に入る発射物との最低の距離
proj.doscale     = 0        ;xscaleとyscaleが発射物のスケールにも影響するかどうか（0=しない・1=する）
head.pos         = 0, -70   ;BindToTargetの時に必要な頭の座標
mid.pos          = 0, -40   ;BindToTargetの時に必要な体中心の座標
shadowoffset     = 0        ;影の垂直方向の位置
draw.offset      = 0,0      ;キャラ描画表示位置（Ｘ軸,Ｙ軸）

;---------------------------------------------------------------------------
;移動速度設定
[Velocity]
walk.fwd     = 4.0         ;前進歩行速度
walk.back    = -3.4        ;後退歩行速度
run.fwd      = 6.5,-3.8    ;前に走る時の速度（Ｘ軸,Ｙ軸）
run.back     = -4.5,0      ;後ろに走る時の速度（Ｘ軸,Ｙ軸）
jump.neu     = 0,-9.4      ;垂直ジャンプ速度（Ｘ軸,Ｙ軸）
jump.back    = -3.0        ;後ジャンプ速度
jump.fwd     = 3.0         ;前ジャンプ速度
runjump.back = -2.55,-8.1  ;後ろに走りながらのジャンプ速度（オプション）
runjump.fwd  = 4,-8.1      ;前に走りながらのジャンプ速度（オプション）
airjump.neu  = 0,-9.4      ;空中垂直ジャンプ速度（オプション）
airjump.back = -3.0        ;空中後ジャンプ速度（オプション）
airjump.fwd  = 3.0         ;空中前ジャンプ速度（オプション）

;---------------------------------------------------------------------------
;動作設定
[Movement]
airjump.num     = 1      ;空中ジャンプが出来る回数（オプション）
airjump.height  = 30     ;空中ジャンプするために必要な最低限の高さ（オプション）
yaccel          = .45    ;重力（垂直下降加速度）
stand.friction  = .85    ;立ち状態の摩擦係数
crouch.friction = .85    ;しゃがみ状態の摩擦係数

;---------------------------------------------------------------------------
; Varの使用状況
; ここに自分が使ったvarをメモしておくといろいろと好都合です。
; var(1)  - コマンドファイルのコンボ用
; var(2)  - 飛び道具PosFreeze用
; var(3)  - ダッシュキャンセルしゃがみ判断
; var(4)  - 相手の位置確認
; var(5)  - 星流弾発射
; var(6)  - 星流弾(強)巨大化ステップ
; var(7)  - 星流弾ボイス
; var(8)  - 龍壁ヘルパー表示

; var(10) - ダッシュ判断
; var(11) - ダッシュ判断2
; var(12) - ダッシュキャンセル着地音＆煙出し
; var(13) - 鳩肥砲
; var(14) - 給気座
; var(15) - ダッシュ中に攻撃を喰らったときの相手攻撃ダメージ
; var(16) - 迎撃防御

; var(21) - 攻撃力変更
; var(22) - 相手空中くらい中の攻撃制御

; var(31) - 怒り爆発
; var(32) - 怒り爆発
; var(33) - イントロ時の爆発回避

; var(53) - ジャンプごヒット
; var(54) - 連続迎撃防御制御セット
; var(55) - タッグ時の生死確認

; var(57) - 空中ジャンプ確認
; var(58) - 迎撃防御率
; var(58) - AI

; fvar(1) - ホーミング
; fvar(2) - ホーミング

;---------------------------------------------------------------------------
; 基本行動のステート
;---------------------------------------------------------------------------
; タイムオーバー時分岐

[Statedef 170]
type = S
ctrl = 0
velset = 0,0

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, タイムオーバー1]
type = ChangeState
trigger1 = Time = 20
trigger1 = !DrawGame
value = 171

[State 170, タイムオーバー2];ドロー時
type = ChangeState
trigger1 = Time = 20
trigger1 = DrawGame
value = 172

;---------------------------------------------------------------------------
; タイムオーバー時1

[Statedef 171]
type = S
ctrl = 0
anim = 171
velset = 0,0

[State 171, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; タイムオーバー時2

[Statedef 172]
type = S
ctrl = 0
anim = 172
velset = 0,0

[State 172, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利ポーズ分岐

[Statedef 180]
type = S
ctrl = 0
velset = 0,0

[State 180, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, 勝利ポーズ1]
type = ChangeState
triggerall = RoundState != 0 ;エンディング対策
trigger1 = Time = 20
trigger1 = MatchOver = 0     ;0なら次の試合がまだ残ってるということ
value = 181

[State 180, 勝利ポーズ2]
type = ChangeState
trigger1 = Time = 20
trigger1 = MatchOver = 1     ;これが1だと試合終了したとき
trigger2 = RoundState = 0    ;エンディング時はこちらを使う
value = 182

;---------------------------------------------------------------------------
; 勝利ポーズ1

[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, ボイス]
type = PlaySnd
triggerall = Time = 7
trigger1 = Alive
value = 11,1
channel = 0

;---------------------------------------------------------------------------
; 勝利ポーズ2

[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 182, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 182, ボイス]
type = PlaySnd
triggerall = Time = 7
trigger1 = Alive
value = 11,2
channel = 0

;---------------------------------------------------------------------------
; イントロ

[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, アニメ変更]
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 190, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, ボイス]
type = PlaySnd
triggerall = Time = 80
trigger1 = Alive
value = 11,1
channel = 0

[State 190, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; おまけ挑発(給気座のキャンセルが効かない版)

[Statedef 195]
type     = C
movetype = I
physics  = C
anim     = 195
velset   = 0,0
ctrl     = 0
sprpriority = 2
facep2 = 1

[State 195, PosAdd]
type = PosAdd
trigger1 = AnimElem = 1
x = 1

[State 195, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 0, 17
channel = 1

[State 195, ボイス]
type = PlaySnd
trigger1 = Time = 1
value = 11,1
channel = 0

[State 195, パワーが溜まる]
type = PowerAdd
trigger1 = Time = 1
value = 156;給気座２回分

[State 195, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;この下、一行以上空ける事！


