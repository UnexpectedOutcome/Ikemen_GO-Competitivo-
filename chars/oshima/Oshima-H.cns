
;---------------------------------------------------------------------------
; ここからは超必殺技のステート
;---------------------------------------------------------------------------
; 破霊彗星神

[Statedef 3000]
type     = S
movetype = A
physics  = N
juggle   = 1
velset   = 0,0
anim     = 3000
ctrl     = 0
sprpriority = 2

[State 3000, 速度加算] ;重力
type = VelAdd
trigger1 = Pos Y <= -1
y = .40

[State 3000, 軸位置設定] ;地面の位置に軸をリセット
type = PosSet
trigger1 = Vel Y > 0 && Pos Y >= -5
y = 0

[State 3000, VelSet]
type = VelSet
trigger1 = Vel Y > 0 && Pos Y >= 0
y = 0

[State 3000, パワーゲージを増減]
type = PowerAdd
trigger1 = time = 1
value = -1000

[State 3000, VelSet]
type = VelSet
trigger1 = Time = 17
x = 8

[State 3002, 通り抜け]
type = PlayerPush
trigger1 = Time >= 17
value = 0

[State 3000, ボイス]
type = PlaySnd
trigger1 = Time = 1
value = 5, 14
channel = 0

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 15
value = 0, 14

[State 3000, Helper];(飛び道具消し用)
type = Helper
trigger1 = Time = 16
ID = 3010
pos = 0,0
postype = p1
stateno = 3010
helpertype = normal
name = "keshi4"
ownpal = 1
keyctrl = 0

[State 3000, スプライト表示]
type = Explod
trigger1 = Time = 1
trigger1 = NumExplod(3005) = 0
anim = 3005
postype = P1
facing = 1
removetime = -1
supermovetime = 0
pausemovetime = 99999
scale = const(size.xscale),const(size.yscale)
pos = ceil(const(size.xscale)*0),ceil(const(size.yscale)*-50)
bindtime = 999999
sprpriority = 3
ownpal = 1
removeongethit = 1
ignorehitpause = 1
;persistent = 0
ID = 3005

[State 3000, ヒット定義]
type = HitDef
triggerall = p2stateno != 5040
triggerall = p2stateno != [5200,5210]
trigger1 = Time = 0
p2facing = 1
attr = S, HA
damage = 366, 109
getpower = 0,0
givepower = 187,0
animtype = Hard
guardflag = HA
hitflag = MA
pausetime = 1, 18
sparkno = s7002
guard.sparkno = s7010
sparkxy = 0,-60
hitsound   = s2,4
guardsound = s3,1
ground.type = High
ground.slidetime = 19
ground.hittime  = 19;32
ground.velocity = -6,-3
guard.velocity = -4
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
air.type = High
air.velocity = -8,-6
airguard.velocity = -4,-3
air.hittime = 13;21
air.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
fall = 1
fall.recover = 0

[State 3000, ステート変更]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = Time >= 81
trigger2 = FrontEdgeDist < 30
value = 3001

[State 3000, ステート変更]
type = ChangeState
trigger1 = MoveContact
trigger2 = MoveReversed
value = 3002
ignorehitpause = 0

