trigger1 = var(31) != 0
trigger1 = StateNo = 190
var(33) = 1

[state -2, varset]
type = varset
trigger1 = var(33) != 0
trigger1 = var(31) = 0
trigger1 = roundstate = 2
var(33) = 0

