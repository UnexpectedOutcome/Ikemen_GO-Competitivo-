
;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステ?ト(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------
; ゲ?ジ

[state -2]
type = varset
trigger1 = power < 1000
var(32) = 0

[state -2]
type = varset
trigger1 = power >= 1000
trigger1 = power < 2000
trigger1 = var(32) = 3 || var(32) = 2
var(32) = 1

[state -2]
type = varset
trigger1 = power >= 2000
trigger1 = power < 3000
trigger1 = var(32) = 3
var(32) = 2

[state -2]
type = varset
trigger1 = power < 1000
var(31) = 0

[state -2]
type = varset
trigger1 = power >= 1000 && var(32) = 0
trigger2 = power >= 2000 && var(32) = 1
trigger3 = power >= 3000 && var(32) = 2
var(31) = 1

[state -2];イントロ時の爆発回避
