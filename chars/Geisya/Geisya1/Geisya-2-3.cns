trigger2 = EnemyNear(var(55)),StateType = A
Trigger2 = EnemyNear(var(55)),MoveType = A
Trigger2 = Random <= var(59)*20
Trigger3 = EnemyNear(var(55)),StateType = L
Trigger3 = P2BodyDist X = [0,40]
Trigger3 = Random <= var(59)*50

