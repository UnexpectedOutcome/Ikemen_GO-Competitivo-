;富士山乱舞（ゲージレベル１）
[State -1, ]
type = ChangeState
value = 3000
triggerall = command = "2363214_xy"
triggerall = power >= 1000
triggerall = var(59) = 0
trigger1 = statetype = S
trigger1 = movetype != H
trigger1 = ctrl
trigger2 = statetype != A
trigger2 = hitdefattr = SC, NA, SA, HA
trigger2 = stateno != [3000,3050]
trigger2 = movecontact

