trigger1 = time = 0
value = S0,16
volume = 999
[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S0,16
volume = 999

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = S4,35
volume = 50

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = animelem = 3
ID = 430
pos = -10,-37
postype = p1

[State 0, Geisers]
type = Helper
trigger1 = timemod = 4,0 && time = [15,25]
trigger2 = time = 10
helpertype = normal
name = "Geisers"
ID = 225
stateno = 225
pos = -35+time*10,3
postype = p1
ownpal = 1
size.xscale = 1
size.yscale = 1

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = numhelper(4450) > 0
trigger1 = time > 15 && numhelper(4450) > 0
value = 220
elem = 3

[State 0, EnvShake]
type = EnvShake
triggerall = numhelper(4450) > 0
trigger1 = time > 15 && numhelper(4450) > 0
trigger2 = time = 15
time = 5

[State 200, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 4000
