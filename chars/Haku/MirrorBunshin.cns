;===============================================================================
;----------------------Mirror BUNSHIN---------------------------------------------
;===============================================================================
;-------------------------------------------------------------------------------
; Mirror Bunshin - Stance
[Statedef 4000]
type    = S
movetype= I
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 0
sprpriority = 0

[State 0, Turn]
type = Turn
trigger1 = p2bodydist x < -20

[State 0, WALK]
type = ChangeState
triggerall = time > 5
trigger1 = p2bodydist x > 30 && random < 500
value = 4020

[State 0, JUMP]
type = ChangeState
triggerall = p2bodydist x < 100
triggerall = time > 5
trigger1 = p2bodydist y < -50 && random < 500
value = 4040

[State 0, Puños]
type = ChangeState
triggerall = time > 5
trigger1 = p2bodydist x < 30 && random < 500
value = 4200

[State 0, Patada]
type = ChangeState
triggerall = time > 5
trigger1 = p2bodydist x < 30 && random < 500
value = 4300

[State 0, Rasengan]
type = ChangeState
triggerall = time > 5
trigger1 = p2bodydist x < 30 && random < 500
value = 4400

[State 200, End]
type = ChangeState
trigger1 = roundstate != 2
value = 4001
