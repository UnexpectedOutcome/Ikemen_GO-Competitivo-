; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Tetris"        ;Name of character
displayname = "Tetris" ;Name of character to display
versiondate = 01,8,2011    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "nns"         ;Character author name
pal.defaults = 2,4,6      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = tetris.cmd   ;Command set
cns     = tetris.cns   ;Constants
st      = tetris.cns
st1     = tetris_-2.cns
stcommon = tetris_common.cns;common1.cns ;Common states
sprite  = tetris.sff   ;Sprite
anim    = tetris.air   ;Animation
sound   = tetris.snd   ;Sound
pal1    = act/tetris01P.act  ;Palettes (can have up to 12)
pal2    = act/tetris02P.act
pal3    = act/tetris03P.act
pal4    = act/tetris04P.act
pal5    = act/tetris05P.act
pal6    = act/tetris06P.act
pal7    = act/tetris07P.act
pal8    = act/tetris08P.act
pal9    = act/tetris09P.act
pal10   = act/tetris10P.act
pal11   = act/tetris11P.act
pal12   = act/tetris12P.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
