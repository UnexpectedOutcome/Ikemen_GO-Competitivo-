[SceneDef]
spr = VG-MANAMI-ENDING.sff
startscene = 0   

[Scene 0]
fadein.time = 80       ;Time to take for fading in
fadein.col = 0,0,0     ;Use 255,255,255 for white-fade
fadeout.time = 50
fadeout.col = 0,0,0
; Screen color
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layerall.pos = 160,0   ;Default position for all layers
layer0.anim =  0       ;Anim action number
layer0.offset = -120,32   ;Position offset
layer0.starttime = 0   ;Time to start display
layer1.anim =  1
layer1.offset = -120,100
layer2.anim =  2
layer2.offset = 120,100
layer3.anim =  3
layer3.offset = -40,90
; Music
bgm = sound/                ;Name of music file to play
bgm.loop = 0
; Total time
end.time = 400

;Background image
[Begin Action 0]
0,0, 0,0, -1
;Background image
[Begin Action 1]
10,0, 0,0, -1
;Background image
[Begin Action 2]
10,1, 0,0, -1,h
;Background image
[Begin Action 3]
10,2, 0,0, -1

