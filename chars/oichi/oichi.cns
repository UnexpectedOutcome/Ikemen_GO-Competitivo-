value = 10000, 1
channel = 0
lowpriority = 0

[State 181, 上杉]
type = PlaySnd
trigger1 = Time = 1
trigger1 = enemynear,Name = "uesugi kensin"
value = 10000, 3
channel = 0
lowpriority = 0

[State 181, 信長]
type = PlaySnd
trigger1 = Time = 1
trigger1 = enemynear,Name = "Oda Nobunaga"
value = 10002, Random%4
channel = 0
lowpriority = 0

[State 181, 毛利]
type = PlaySnd
trigger1 = Time = 1
trigger1 = enemynear,Name = "Mouri Motonari"
value = 10004, Random%3
channel = 0
lowpriority = 0

[State 181, 慶次]
type = PlaySnd
trigger1 = Time = 1
trigger1 = enemynear,Name = "Keiji"
value = 10006, Random%2
channel = 0
lowpriority = 0

[State 181, 時間]
type = AssertSpecial
trigger1 = time <= 500
flag = roundnotover

;---------------------------------------------------------------------------
;イントロ（試合開始前の登場演出アクション）
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, ボイス]
type = PlaySnd
trigger1 = Time = 1
value = 190, Random%5
channel = 0

;特殊イントロ-------------------------
[State 191, 伊達]
type = PlaySnd
trigger1 = Time = 1
trigger1 = p2name = "Date Masamune"
value = 10000, 0
channel = 0

[State 191, 上杉]
type = PlaySnd
trigger1 = Time = 1
trigger1 = p2name = "uesugi kensin"
value = 10000, 2
channel = 0
lowpriority = 0

[State 191, 信長]
type = PlaySnd
trigger1 = Time = 1
trigger1 = p2name = "Oda Nobunaga"
value = 10001, Random%4
channel = 0
lowpriority = 0

[State 191, 毛利]
type = PlaySnd
trigger1 = Time = 1
trigger1 = p2name = "Mouri Motonari"
value = 10003, Random%2
channel = 0
lowpriority = 0

[State 191, 慶次]
type = PlaySnd
trigger1 = Time = 1
trigger1 = p2name = "Keiji"
value = 10005, Random%2
channel = 0
lowpriority = 0

[State 191, アニメ変更];バトル画面に切り替わった瞬間のフェードインの時、アニメを固定している
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 特殊効果];試合が開始するまではこのコントローラを使おう（※２）
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態

[State 191, ステート変更];アニメーションが終われば「通常立ち」のステートに変更する
type = ChangeState
trigger1 = AnimTime = 0
value = 0

