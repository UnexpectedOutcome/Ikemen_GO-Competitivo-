;----------------------------------------------------------------------
;ハイジャンプ-----------------------
[Statedef 41]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 41, 残像]
type = AfterImage
trigger1 = 1
framegap = 0
time = 3

[State 41,変数セット]
type = varset
trigger1 = 1
v = 13
value = 1

[State 191, Snd 1];ジャンプ
type = PlaySnd
trigger1 = time = 0
value = 41,1

;---------------------[ヘルパー]
[state a];ハイジャンプエフェクト
type = Helper
trigger1 = time = 0
trigger1 = var(13) != 0
id = 6000
name = "jump"
pos = 0 , 0
postype = p1
stateno = 6000
helpertype = normal
pausemovetime = 0
persistent = 0
ignorehitpause = 1
keyctrl = 0 
ownpal = 1

[State 41, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 41, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 41, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 41, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y) - 2.4

[State 41, 5];ダッシュ時のジャンプ・ハイジャンプには必要ない？
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 41, コモンステートへ]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
