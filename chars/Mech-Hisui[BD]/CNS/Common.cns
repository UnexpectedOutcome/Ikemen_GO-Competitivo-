TriggerAll = Stateno != 100 && PrevStateno != 100
TriggerAll = P2StateType = L
TriggerAll = P2BodyDist X >= 70
Trigger1 = NumHelper(1575)
Trigger1 = Helper(1575),StateNo = 1575
