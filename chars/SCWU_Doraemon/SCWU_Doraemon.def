; Definition file for player
; Contains all the filenames needed for the character

; Player information
[Info]
name = "SCWU_Doraemon"        		;Name of character
displayname = "Doraemon" 		;Name of character to display
versiondate =   	 		;Version date of character
mugenversion =   			;Version of M.U.G.E.N character works on
author = "Valgallah"      		;Character author name
pal.defaults =  1,2,3,4 		;Default palettes in order of preference

; Files for the player
[Files]
cmd     = SCWU_Doraemon.cmd   ;Command set
cns     = SCWU_Doraemon.cns   ;Constants
st      = SCWU_Doraemon.cns   ;States
st1      = Doraemon_Hitsparks.cns
stcommon = common1.cns ;Common states
sprite  = SCWU_Doraemon.sff   ;Sprite
anim    = SCWU_Doraemon.air   ;Animation
sound  = SCWU_Doraemon.snd   ;Sound
pal1   = Doraemon1.act   ;Palettes (can have up to 12)
pal2   = Doraemon2.act
pal3   = Doraemon3.act
pal4   = Doraemon4.act
pal5   = Doraemon5.act
pal6   = Doraemon6.act
pal7   = Doraemon7.act
pal8   = Doraemon8.act
;pal9   =
;pal10  =
;pal11  =
;pal12  =
movelist = movelist.dat
