;This is .def file that sets Luigi to have BBHood217's balance 
;patch that he originally made for ShinRyoga and NeoAnkh's Super 
;Mario and I setted things up for their Super Luigi. So, if you 
;want more "fairly" fighting Luigi, this patch is for you!

[Info]
name = "SuperLuigi"
displayname = "Super Luigi"
;displayname = "Super Luigi (Improved)"
versiondate = 08,08,2006 
;Date of improvement -> 02,24,2021 - 03,04,2021 <- End of improvement
mugenversion = 
author = "ShinRyoga & Neo Ankh" ;edited by ValleryTheNepGamer96
pal.defaults = 12,9,10,7,1,4,2,5,6,3,11,8

[Files]
sprite = Coding\SuperLuigi.sff
anim = Coding\Balance patch by BBH\SuperLuigi.air
sound = Sounds\SuperLuigi.snd
;cmd = Coding\Balance patch by BBH\SuperLuigi_Weaker.cmd 	;BBH's weaker AI patch
cmd = Coding\Balance patch by BBH\SuperLuigi.cmd
;cmd = Coding\Balance patch by BBH\SuperLuigi_KY.cmd 		;K.Y.Shanxi's AI patch
cns = Coding\Balance patch by BBH\SuperLuigi.cns
stcommon = common1.cns
st = Coding\Balance patch by BBH\SuperLuigi.cns
st1 = Coding\Balance patch by BBH\SuperLuigi1.cns
st2 = Coding\Balance patch by BBH\SuperLuigi1.cns
pal1 = Palettes\LuigiColor1.act
pal2 = Palettes\LuigiColor2.act
pal3 = Palettes\LuigiColor3.act
pal4 = Palettes\LuigiColor4.act
pal5 = Palettes\LuigiColor5.act
pal6 = Palettes\LuigiColor6.act
pal7 = Palettes\LuigiColor7.act
pal8 = Palettes\LuigiColor8.act
pal9 = Palettes\LuigiColor9.act
pal10 = Palettes\LuigiColor10.act
pal11 = Palettes\LuigiColor11.act
pal12 = Palettes\LuigiColor12.act
movelist = movelist.dat

[Arcade]
intro.storyboard = 
ending.storyboard = 
