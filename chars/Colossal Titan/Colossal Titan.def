;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; Definition file for Colossal Titan
; Contains all the filenames needed for the character
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; Player Information
[Info]
Name = "Colossal Attack on Titan"             ;Name of character;人物的測試名字 顯示在測試畫面Debug = 1
DisplayName = "Colossal Titan"                ;Name of character to display;人物的名字 遊戲中所顯示的名字
VersionDate = 04,02,2021                      ;Version date of character (MM-DD-YYYY or X.XX);人物完成的日期
MugenVersion = 1.0                            ;Version of M.U.G.E.N character works on (X.XX);支援MUGEN的版本
Author = "Manny Lingle";曼尼琳各              ;Character author name;此人物的作者
Pal.Defaults = 1,2,3,4                        ;Default palettes in order of preference (up to 4);CPU色盤的優先權可以只寫一個
                                              ;Numbering starts from 1
localcoord = 640,480                          ;Local coordinate space width and height;局部坐標空間的寬度和高度
;localcoord = 800,600

;640,480 Usable With 4:3 Aspect Ratio Stage(可用於4:3長寬比場地)    ;人物會在部份16:9寬高場地戰鬥時 會感覺到人物比例過大
;800,600 Usable With 16:9 Aspect Ratio Stage(可用於16:9長寬比場地)  ;主因是在製作場景時未考慮到跟人物的比例關係(Zoomin和Zoomout其中一個數字為1或者1以上)
;                                                                   ;其中一種解決方法就是改變人物的LocalCoord(將數值變大 例如640,480改為800,600)
;                                                                   ;但是最好的方法仍然是改變場景的Zoom縮放值(Zoomin和Zoomout兩者數值皆小於1)

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 超大型巨人定義ファイル
; キャラに必要なすべてのファイル名が含まれています
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; キャラ情報
[Ja.Info]
Name = "Colossal Attack on Titan"             ;キャラの名前
DisplayName = "超大型巨人"                    ;キャラ選択時に表示されるキャラの名前
VersionDate = 04,02,2020                      ;キャラのバージョン。書式は「月,日,年」
MugenVersion = 1.0                            ;キャラを制作したMUGENのバージョン 
Author = "Manny Lingle";曼尼琳各              ;製作者の名前
Pal.Defaults = 1,2,3,4                        ;コンピューターが優先的に使うパレットの番号
                                              ;番号は1から始まります
localcoord = 640,480                          ;解像度横幅の値と縦幅の値
;localcoord = 800,600

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 超大型巨人的定義文件
; 包含該人物角色所需的所有文件名稱
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 人物訊息
[Zh.Info]
Name = "Colossal Attack on Titan"             ;人物名
DisplayName = "超大型巨人"                    ;人物顯示名
VersionDate = 04,02,2020                      ;人物版本號 (月-日-年 或者 X.XX)
MugenVersion = 1.0                            ;人物對應的MUGEN版本 (X.XX)
Author = "Manny Lingle";曼尼琳各              ;作者名
Pal.Defaults = 1,2,3,4                        ;默認色表順序 (最多4個)
                                              ;序號從1開始
localcoord = 640,480                          ;分辨率寬度和高度
;localcoord = 800,600

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; Files For The Player
; 檔案的連結
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
[Files]
Cmd      = CT-Command.cmd        ;Command Set         ;人物的指令
Cns      = CT-Constants.cns      ;Constants           ;人物的基本設定
St       = CT-Constants.cns      ;Constants States    ;人物的基本設定中的States(站立蹲下前進後退跳躍防禦)
St2      = CT-Body.cns           ;Titan Body          ;巨人的身體
St3      = CT-HandArm.cns        ;Titan Hand-Arm      ;巨人的手臂
St4      = CT-Statedef-3-2.st    ;Statedef -3 -2      ;[Statedef -3][Statedef -2]
St5      = CT-BasicMoves.st      ;Basic Moves         ;基本技
St6      = CT-SuperMoves.st      ;Super Moves         ;必殺技
St7      = CT-Helper.st          ;Helper              ;援助者
St8      = CT-Config.txt         ;Config              ;設定檔
StCommon = CT-Common.cns         ;Common States       ;共用檔的連結 如果是common1.cns的話為讀取data資料夾的common1.cns
Sprite   = CT-Sprite.sff         ;Sprite              ;人物飛行道具的圖
Anim     = CT-Animation.air      ;Animation           ;人物飛行道具的設定動畫及攻擊範圍等
Sound    = CT-Sound.snd          ;Sound               ;人物飛行道具等的聲音

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; Palettes
; 人物的各種顏色色表
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
Pal1     = NewACT/CT-Red.act           ;Red Palette          紅色
Pal2     = NewACT/CT-Blue.act          ;Blue Palette         藍色
Pal3     = NewACT/CT-Green.act         ;Green Palette        綠色
Pal4     = NewACT/CT-Orange.act        ;Orange Palette       橘色
Pal5     = NewACT/CT-Gray.act          ;Gray Palette         灰色
Pal6     = NewACT/CT-Purple.act        ;Purple Palette       紫色
Pal7     = NewACT/CT-Scarlet.act       ;Scarlet Palette      深紅色
Pal8     = NewACT/CT-LightBlue.act     ;LightBlue Palette    淺藍色
Pal9     = NewACT/CT-LightGreen.act    ;LightGreen Palette   淺綠色
Pal10    = NewACT/CT-WhiteGray.act     ;WhiteGray Palette    白灰色
Pal11    = NewACT/CT-Black.act         ;Black Palette        黑色
Pal12    = NewACT/CT-Gold.act          ;Gold Palette         金色

[Palette Keymap]
a = 1
b = 2
c = 3
x = 4
y = 5
z = 6
a2 = 7
b2 = 8
c2 = 9
x2 = 10
y2 = 11
z2 = 12

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; Arcade Mode
; 故事模式
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
;[Arcade]
;intro.storyboard = intro.def    ;開頭的故事
;ending.storyboard = ending.def  ;結束的故事
