;**************************************************************************
; AI用　※カチドキアームズの性能設定もあるよ！
;**************************************************************************
[Statedef -3]


; AI用に使用している変数
;
; Var(50)   飛び道具の判断用
; Var(58)   AIレベル
; Var(59)   AI起動スイッチ   0=OFF , 1=ON
;
; その他性能設定
;
; Var(45)　 カチドキ砲の性能設定


;--------------AIレベル設定
[state -3,]
type = varset
Trigger1 = 1
v = 58

value = 10                 ;1～11で設定してください。11で超反応を自重しなくなります



;--------------AI所持ロックシード設定
[state -3,]
type = varset
Trigger1 = 1
v = 57

value = 4                  ;0 …オレンジって俺な紘太                オレンジアームズのみ
                           ;1 …ここからは俺のステージな紘太        パイン・イチゴ・スイカ追加
                           ;2 …インベスをあっさり紘太              ジンバーレモン追加
                           ;3 …ぜってぇ許さない紘太                カチドキアームズ追加
                           ;4 …ｶｲﾄｫ!!な紘太（未実装）              極アームズ追加




;--------------AI常時起動スイッチ
[state -3,]
type = varset
TriggerAll = Var(59) = 0
Trigger1 = RoundState = 0
v = 59

value = 0                  ;｢0｣を１にするとAIが常時起動なります。
                           ;AIスイッチがONになるまでの微妙な動きを
                           ;なくしたい方は1をおすすめ。





;--------------カチドキアームズ技性能設定
[state -3,]
type = varset
Trigger1 = 1
v = 45

value = 0                  ;0 …待機時間中に喰らったダメージの量だけ攻撃力上昇,限度20発
			　 ;1 …自分の残体力が少ないほど攻撃力上昇,待機時間無し


;----------------------------------------------------------------




[State -3, AI起動用ヘルパー]
type = helper
triggerall = !NumHelper(9741)
triggerall = RoundState = [1,2]
triggerall = var(59) = 0
triggerall = ctrl && stateno = 0
trigger1 = PrevStateNo = [190,194]
trigger1 = ctrl && stateno = 0
trigger2 = PrevStateNo = 5900
helpertype = normal
name = "AI switch"
stateno = 9741
ID = 9741
pos = 9999,9999
keyctrl = 1
pausemovetime = 2147483647
supermovetime = 2147483647
persistent = 0

[State -1, AIhelper]
type=changestate
trigger1 = ishelper(9741)
trigger1 = stateno != 9741
value = 9741

