[State 0, VarSet]
type = VarSet
trigger1 = numhelper(270) > 0 && helper(270),stateno = 270
Fv = 2
value = .5

[State 0, Notas]
type = Helper
trigger1 = numhelper(270) > 0 && helper(270),stateno = 270
trigger1 = timemod = 5,0
helpertype = normal
name = "Notas"
ID = 280
stateno = 280
pos = (-20+random%40)*Helper(999999),Fvar(16),(0-random%60)*Helper(999999),Fvar(16)
postype = p1
ownpal = 1
Size.Xscale = .05*Helper(999999),Fvar(16)
Size.Yscale = .05*Helper(999999),Fvar(16)
Supermovetime = 999
Supermove = 999
Pausemovetime = 999
Pausemove = 999

[State 0, VarSet]
type = VarSet
trigger1 = numhelper(270) = 0 || helper(270),stateno != 270
Fv = 2
value = 0

[State 0, AttackMulSet]
type = AttackMulSet
trigger1 = 1
value = 1+fvar(2)
