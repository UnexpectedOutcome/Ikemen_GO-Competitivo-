;-| 標準化 |-------------------------------------------------------
[Defaults]
; timeを記述しなかった場合、以下の値が参照されます。最小値は1です。
command.time = 15

; buffer.timeの値です。1～30まで設定できます。
; 普通は1です。
command.buffer.time = 1

;------------------------------------------------------------------------------
;-| 超必殺技 |-----------------------------------------------------------------
;コマンドの一部が重なる場合、先に書かれたものが優先されるので
;気を付けてください。


[Command]
name = "Slaughter"
command = ~D, F, D, F, a
time = 25

[Command]
name = "Slaughter"
command = ~D, F, D, F, b
time = 25

[Command]
name = "Fury"
command = ~D, F, D, F, x
time = 25

[Command]
name = "Fury"
command = ~D, F, D, F, y
time = 25


;------------------------------------------------------------------------------
;-| 必殺技 |-------------------------------------------------------------------
;コマンドの一部が重なる場合、先に書かれたものが優先されるので
;623 → 236の順に登録されています。
;（注:236等はテンキーでコマンドを表しています）


[Command]
name = "Charge3"
command = ~D, F, a

[Command]
name = "Charge4"
command = ~D, F, b

[Command]
name = "Charge1"
command = ~D, F, x

[Command]
name = "Charge2"
command = ~D, F, y

[Command]
name = "Charge5"
command = ~D,B, x

[Command]
name = "Charge6"
command = ~D,B, y

[Command]
name = "JCharge"
command = ~D,B, a

[Command]
name = "JCharge"
command = ~D,B, b

[Command]
name = "jump"    
command = ~$D,$U
time = 8

;------------------------------------------------------------------------------
;-| キー２回連続入力 |---------------------------------------------------------
[Command]
name = "FF"     ;要求済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = F, F
time = 10

[Command]
name = "BB"     ;要求済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = B, B
time = 10

;------------------------------------------------------------------------------
;-| 同時押し |-----------------------------------------------------------------
[Command]
name = "recovery"   ;要求済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = c
time = 1

[Command]
name = "recovery"   ;要求済み (キーの変更は可能ですが名前を変えたり無効にしてはいけません)
command = z
time = 1

[Command]
name = "投げ"
command = y+b
time = 1

[Command]
name = "roll"
command = x+a
time = 1

;------------------------------------------------------------------------------
;-| 方向キー＋ボタン |---------------------------------------------------------

[Command]
name = "倒地回避前"
command = /$F+c
time = 1

[Command]
name = "倒地回避後"
command = /$B+c
time = 1

[Command]
name = "奇襲"
command = /$D,c
time = 1

[Command]
name = "後閃奇襲"
command = /$B,c
time = 1

[Command]
name = "追加"
command = /$D,a
time = 1

[Command]
name = "追加"
command = /$D,b
time = 1
