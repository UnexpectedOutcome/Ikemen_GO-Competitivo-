v = 33
value = 0
ignorehitpause = 1

[State -2, 初撃防御力ヒット確認]
type = VarSet
triggerall = (Life > 2)
triggerall = !IsHelper
trigger1 = MoveType = H
trigger1 = StateNo != [120, 159]
trigger1 = StateNo != 771
v = 33
value = GetHitVar(HitCount)
ignorehitpause = 1

[State -2, 初撃防御力]
type           = LifeAdd
triggerall = (Life > 2)
triggerall     = Alive
triggerall     = life - var(35) > 0
triggerall = StateNo != 771
triggerall     = var(33) = 1
triggerall     = var(34) := GetHitVar(Damage)
trigger1       = var(35) := Floor(var(34) * (1.0 - ((Const(data.defence) / fvar(20)) / 100)))
value          = var(35)
absolute       = 1
persistent     = 0
ignorehitpause = 1

[State -2, 初撃防御力KO]
type           = LifeAdd
triggerall = (Life > 2)
triggerall     = var(33) = 1
triggerall     = Alive
trigger1     = life - var(35) <= 0
value          = -1
absolute       = 1
persistent     = 0
ignorehitpause = 1
