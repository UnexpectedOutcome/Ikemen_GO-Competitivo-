[State -2, アタック]
type = AttackMulSet
trigger1 = roundstate = 2
value = fVar(24)
ignorehitpause = 1

[State -3, 四捨五入]]
Type = Null
triggerall = roundstate = 2
Trigger1 = (fVar(10) = [1,1.24])&& (fVar(24) := 1)
Trigger2 = (fVar(10) = [1.25,1.49])&& (fVar(24) := 1.25)
Trigger3 = (fVar(10) = [1.5,1.74])&& (fVar(24) := 1.5)
Trigger4 = (fVar(10) = [1.75,1.99])&& (fVar(24) := 1.75)
Trigger5 = (fVar(10) >= 2)&& (fVar(24) := 2)
Trigger6 = (fVar(10) = [0.51,0.99])&& (fVar(24) := 0.75)
Trigger7 = (fVar(10) <= 0.5)&& (fVar(24) := 0.5)
IgnoreHitPause = 1

[State -2, ディフェンス]
type = DefenceMulSet
trigger1 = roundstate = 2
trigger1 = fVar(20)
value = 1/fVar(20)
ignorehitpause = 1

[State -2, 補正合計]
type = VarSet
trigger1 = roundstate = 2
trigger1 = fVar(21)
fv = 10
value = ((fVar(11)*fVar(21)*fVar(14)*fVar(15)*(fVar(16)*fVar(17)))+fVar(12))
ignorehitpause = 1

[State -2, 初撃防御力ヒット確認リセット]
type = VarSet
triggerall = !IsHelper
trigger1 = MoveType != H
trigger2 = StateNo = [120, 159]
trigger3 = StateNo = 771
