;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------

;デバッグモードに白い文字の表示を加える
[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 1
text = "V8-C=%d,V11-C=%d,V7-J=%d,fVar11-B=%d,fVar14-B=%d"
params = FrontEdgeDist,floor(var(8)%100),var(7),fvar(15),PrevStateNo
ignorehitpause = 1

;表示を横に加える
[State -2, デバッグ表示その2]
type = AppendToClipboard
trigger1 = 1
text = " V13-A=%d,V21-R=%d,Pos X=%d,Y=%d"
params = var(13),var(21),ceil(Pos X),floor(Pos Y)
ignorehitpause = 1

;表示を下に加える
[State -2, デバッグ表示その3]
type = AppendToClipboard
trigger1 = 1
text = "\nDist X=%d,Y=%d, Vel X=%d/10,Y=%d/10 : Power=%d"
params = floor(P2BodyDist X),ceil(P2BodyDist Y),ceil(Vel X*10),floor(Vel Y*10),Power
ignorehitpause = 1

;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------補正云々---------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************

[State -2, 画像の色]
type = PalFX
triggerall = stateno = 1400
trigger1=numhelper(1406)
trigger1=helper(1406),gethitvar(damage)
time = 5
add = 200,200,200
pausemovetime = 99999999
IgnoreHitPause = 1

[state -2,ダメージ]
type=lifeadd
triggerall=!ishelper
triggerall=numhelper(1406)
trigger1=roundstate=2
trigger1=helper(1406),gethitvar(damage)
value=-(helper(1406),GetHitVar(Damage)/3)
absolute=1
ignorehitpause=1

[State -2, 空中ガード不可]
Type = AssertSpecial
Trigger1 = 1
trigger2 = roundstate = 2
flag = NoAirGuard
ignorehitpause = 1

[State -2, スクロール];負けて倒れたらカメラワークを相手に移す処理
type = ScreenBound
triggerall = (Life <= 0) || (!Alive) || (Lose)
trigger1 = (StateNo = 5150) && (RoundState = 4)
value = 0
MoveCamera = 0,0
IgnoreHitPause = 1

[State -2, ホールドNOKO]
type           = Lifeadd
trigger1     = PrevStateNo= 771
trigger1     = StateNo != [5000,5120]
trigger1     = life <= 2
trigger2     = life <= 2
Trigger2 = var(55)
Trigger2 = movetype != H
value          = 2
Ignorehitpause=1

;---------------------------------------------------------------------------
;変数管理

[State -2, 空中ガード不可]
Type = AssertSpecial
Trigger1 = !(EnemyNear(var(30)),HitDefAttr = A,AA,AP||EnemyNear(var(30)),statetype = A)
flag = NoAirGuard
ignorehitpause = 1

[state -2, コマンドリセット]
type = VarSet
triggerall = !var(8)
trigger1 = StateNo = 0
trigger2 = StateNo = 52
trigger3 = StateNo = [5000,5210]
trigger4 = MoveType = H
var(1) = 0
ignorehitpause = 1
Persistent = 1

;;;;;;;;ヒット;;;;;
