
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;  (hyper)
; セーブ・ザ・クイーン

[Statedef 3000]
type    = S
movetype= A
physics = N
juggle  = 1
velset = 0,0
anim = 3000
ctrl = 0
sprpriority = 2

[State 3000, Super A]
type = SuperPause         ;超必殺技の暗転
trigger1 = AnimElem = 1, 1
pos = 25, -57         ;エフェクトの位置
anim = 100
sound = 20, 0
poweradd = -(Var(13)*1000) -1000  ;技ゲージを消費(1ゲージ)

[State 3000, 2]
type = PlaySnd
trigger1 =  AnimElem = 1
value = 1000, 3

[State 3000, 2] ;無敵
type = NotHitBy
trigger1 = AnimElem = 1
value = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP
time = 14

[State 3000, move]
type = velset
trigger1 = AnimElem = 3
x = 8

[State 3000, 2]
type = HitDef
trigger1 = AnimElem = 4
trigger2 = AnimElem = 5
trigger3 = AnimElem = 9
trigger4 = AnimElem = 10
triggerall = var(2) = 0          ;スカらせフラグが否
attr = S, HA
animtype  = Medium
damage    = 75,15
guardflag = M
hitflag = MAFD                    ;ヒットする状態の指定(省略時MAF)
pausetime = 8,8
sparkno = 1
sparkxy = -10,-110
hitsound = 5, 2
guardsound = 6, 0
ground.type = High
ground.slidetime = 24
ground.hittime  = 24
ground.velocity = -8
air.hittime = 50                 ;重要。無いと反撃し放題。
air.velocity = -4,-6             ;
fall = ifelse(p2StateType = A,1,0) ;転倒命令(相手が空中にいる時)
getpower = 0,0                 ;p1ゲージ追加増加量
givepower = 30,15                ;p2ゲージ増加量

[State 3000, 3]
type = HitDef
trigger1 = AnimElem = 13
attr = S, HA
damage    = 75,15
guardflag = M
priority = 4
pausetime = 8,8
sparkno = 1
sparkxy = -10,-100
hitsound   = 5,3
guardsound = 6,0
animtype = Med
ground.type = High
ground.slidetime = 24
ground.hittime  = 24
ground.velocity = -8
air.hittime = 50
air.velocity = -4,-6
fall = ifelse(p2StateType = A,1,0) ;転倒命令(相手が空中にいる時)
getpower = 0,0                 ;p1ゲージ追加増加量
givepower = 30,15                ;p2ゲージ増加量

[State 3000, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 3001

;------------------
;  - jump

[Statedef 3001]
type    = A
movetype= A
physics = A
juggle  = 2
velset = 3,-15
anim = 3001
ctrl = 0
sprpriority = 2

[State 3002,1] ;攻撃
type = HitDef                    ;攻撃の設定
trigger1 = AnimElem = 1          ;トリガー、アニメ何枚目
trigger2 = AnimElem = 2          ;トリガー、アニメ何枚目
triggerall = var(2) = 0          ;スカらせフラグが否
attr = A, HA                     ;技の属性
damage = 75, 15                  ;ダメージ(ヒット,ガード)
animtype = up                    ;くらい属性(ダウンの有無は別項目)
guardflag = M                    ;ガード属性
hitflag = MAF                    ;ヒットする状態の指定(省略時MAF)
priority = 4, Hit                ;相打ちの優先順位
pausetime = 12, 12                 ;硬直時間(相手,自分)ヒットストップ
sparkno = 1                      ;Spark anim no (Def: set above)
sparkxy = -10, -120              ;ヒットスパークの表示位置(-10,-高さ)
hitsound = 5, 2
guardsound = 6, 0
ground.type = High               ;くらい動作のアニメを指定
ground.slidetime = 23
ground.hittime  = 45             ;重要。短いと反撃し放題。
air.hittime = 45
ground.velocity = -4,-18
air.velocity = -4,-18
guard.hittime = 23             ;ガード硬直(のけぞりと別に設定できる)
guard.velocity = -12             ;ガード後退速度(地上転倒なので設定)
fall = 1                         ;ダウン
getpower = 0,0                 ;p1ゲージ追加増加量
givepower = 30,15                ;p2ゲージ増加量

[State 3001, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 3
movetype = I

[State 3001, 4] ;次の着地ステートへ
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= -5
value = 3002

;------------------
;  - land

[Statedef 3002]
type    = C
movetype= I   ;待機状態(技後の隙)
physics = S
anim = 1052
sprpriority = 1
velset = 0,0

[State 3001, 1] ;Reset y-position to ground level
type = PosSet
trigger1 = Time = 0
y = 0

[State 3001, 2] ;Play a sound for landing
type = PlaySnd
trigger1 = Time = 0
value = 40, 0

[State 3001, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;  (hyper)
; 砲台モード

[Statedef 3100]
type    = S
movetype= I
physics = N
juggle  = 1
velset = 0,0
anim = 3100
ctrl = 0
sprpriority = 2

[State 3100, Super A]
type = SuperPause         ;超必殺技の暗転
trigger1 = AnimElem = 1
pos = 25, -57         ;エフェクトの位置
anim = 100
sound = 20, 0
poweradd = -3000  ;技ゲージを消費(3ゲージ)

[State 3000, 2]
type = PlaySnd
trigger1 =  AnimElem = 1
value = 180, 1

[State 3001, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
