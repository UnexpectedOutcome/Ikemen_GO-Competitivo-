;[Statedef -3]を途中からAIに使用

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;---------------------------------------------------------------------------

[State -3, AIのレベルの設定(1～10)0でoff];単純に確率が上がる
type = VarSet
trigger1 = Alive && AILevel > 0
trigger1 = RoundState = 2
var(59) = 2 ;0でoff

[State -3, 試合後のAIの暴れ]
type = VarSet
trigger1 = Alive && AILevel > 0
trigger1 = RoundState != 2
var(59) = 2 ;0でoff

[State -3, AIがあまり考えずに技を出す設定(0～200)];単純に確率が上がる
type = VarSet
trigger1 = Alive && var(59) > 0
var(58) = 1

;---------------------------------------------------------------------------

[State -3, 小パンチで選択した場合(レベルでの行動をoff)]
type = VarSet
trigger1 = PalNo = 1
var(57) = 0
[State -3, キックボタンで選択した場合]
type = VarSet
trigger1 = PalNo = 4
var(57) = 1
[State -3, キックボタンで選択した場合]
type = VarSet
trigger1 = PalNo = [5,6]
var(57) = 2
[State -3, 以外で選択した場合]
type = VarSet
trigger1 = PalNo = [2,3]
trigger2 = PalNo > 6
var(57) = 3

[State -3, ゲージで確率を増やす]
type = VarSet
trigger1 = power < 1000
var(50) = 0
[State -3, ゲージで確率を増やす]
type = VarSet
trigger1 = power = [1000,1999]
var(50) = 1
[State -3, ゲージで確率を増やす]
type = VarSet
trigger1 = power = [2000,2999]
var(50) = 2
[State -3, ゲージで確率を増やす]
type = VarSet
trigger1 = power > 2999
var(50) = 3

;---------------------------------------------------------------------------
[State -3, 死亡後にやられ判定を残す]
type = VarSet
trigger1 = 1
var(6) = 1  ;0でOFF

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;キャラ本体の設定

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, 残像消去]
type = afterimagetime
trigger1 = movetype = H
time = 0

[State -3, ヘルパー消し]
type = DestroySelf
trigger1 = stateno < 800
trigger1 = IsHelper

[State -3, 5900] ;Clear all int variables開幕時にVarをリセットしているのを避けておく。
type = VarRangeSet
trigger1=!roundsexisted
trigger1=!roundstate
trigger1=stateno=5900
value=0
persistent=0

[State -3, 5900] ;Clear all float variables
type = VarRangeSet
trigger1=!roundsexisted
trigger1=!roundstate
trigger1=stateno=5900
fvalue=0
persistent=0

;---------------------------------------------------------------------------
[State -3, 二段ジャンプ]
type = varset
triggerall = var(9) < 1
trigger1 = stateno = [56,58]
var(9) = 1

[State -3, 二段ジャンプ]
type = varset
triggerall = var(9) > 0
trigger1 = stateno = 52
trigger1 = statetype != A
var(9) = 0

;---------------------------------------------------------------------------
;わりとどうでもいい設定
;---------------------------------------------------------------------------

[State -3, damage];頭やられ
type = PlaySnd
triggerall = stateno = 5000 && time = 1
trigger1 = anim = 5000
value = 5000, 0

[State -3, damage]
type = PlaySnd
triggerall = stateno = 5000 && time = 1
trigger1 = anim = 5001
trigger2 = anim = 5002
value = 5000, 10

[State -3, damage];腹やられ
type = PlaySnd
triggerall = stateno = 5000 && time = 1
trigger1 = anim = 5010
value = 5000, 0

[State -3, damage]
type = PlaySnd
triggerall = stateno = 5000 && time = 1
trigger1 = anim = 5011
trigger2 = anim = 5012
value = 5000, 10

[State -3, damage];空中やられ
type = PlaySnd
triggerall = stateno = 5000 && time = 1
trigger1 = anim = 5030
value = 5000, 0

[State -3, damage];しゃがみやられ
type = PlaySnd
triggerall = stateno = 5010 && time = 1
trigger1 = anim = 5020
value = 5000, 0

[State -3, damage]
type = PlaySnd
triggerall = stateno = 5010 && time = 1
trigger1 = anim = 5021
trigger2 = anim = 5022
value = 5000, 10


[State -3, damage];ジャンプ頭やられ
type = PlaySnd
triggerall = stateno = 5020 && time = 1
trigger1 = anim = 5010
value = 5000, 0

[State -3, damage]
type = PlaySnd
triggerall = stateno = 5020 && time = 1
trigger1 = anim = 5011
trigger2 = anim = 5012
value = 5000, 10

[State -3, damage];ジャンプ腹やられ
type = PlaySnd
triggerall = stateno = 5020 && time = 1
trigger1 = anim = 5010
value = 5000, 0

[State -3, damage]
type = PlaySnd
triggerall = stateno = 5020 && time = 1
trigger1 = anim = 5011
trigger2 = anim = 5012
value = 5000, 10

[State -3, damage];ジャンプ空中やられ
type = PlaySnd
triggerall = stateno = 5020 && time = 1
trigger1 = anim = 5030
value = 5000, 0


[State -3, damage];上昇やられ
type = PlaySnd
triggerall = stateno = 5030 && time = 1
trigger1 = anim = 5051
value = 5000, 20

[State -3, damage];転倒
type = PlaySnd
triggerall = stateno = 5071 && time = 1
trigger1 = anim = 5070
value = 5000, 20

[State -3, damage];ダウン追い討ち
type = PlaySnd
triggerall = stateno = 5080 && time = 1
trigger1 = time = 1
value = 5000, 10

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

;[Statedef -3]を途中からAIに使用

;---------------------------------------------------------------------------

[State -3, AI前ジャンプリセット];擬似ジャンプためリセットを兼ねる
type = VarSet
trigger1 = Stateno =40
trigger2 = Stateno = [20,29]
var(55) = 0

[State -3, AI後ジャンプ]
type = VarSet
trigger1 = Stateno =42 && time=1
var(55) = 1
[State -3, AI垂直ジャンプ]
type = VarSet
trigger1 = Stateno =43 && time=1
var(55) = 2
[State -3, AI前ジャンプ小キめくり];設定のみ
type = VarSet
trigger1 = Stateno =41 && time=1 && P2BodyDist X = [110,130]
var(55) = 3
[State -3, AI前ジャンプ小キ]
type = VarSet
trigger1 = Stateno =41 && time=1 && P2BodyDist X = [130,260]
var(55) = 4
[State -3, AI前ジャンプ大パ大キ]
type = VarSet
trigger1 = Stateno =41 && time=1 && P2BodyDist X = [266,270]
var(55) = 5
[State -3, AI前ジャンプ小パ]
type = VarSet
trigger1 = Stateno =41 && time=1 && P2BodyDist X = [269,290]
var(55) = 6
[State -3, AI前ジャンプ間合い外]
type = VarSet
trigger1 = Stateno =41 && time=1 && P2BodyDist X >290
var(55) = 7

;---------------------------------------------------------------------------

[State -3, AIジャンプ打点リセット]
type = VarSet
trigger1 = pos y < -155
var(54) = 0

[State -3, AIジャンプ打点]
type = VarSet
trigger1 = pos y > -154 && (stateno=610 || stateno=640 ) && movecontact = [1,1]
var(54) = 1

;---------------------------------------------------------------------------

[State -3, ステートナンバーを変数に格納];ガード
type = VarSet
trigger1 = stateno = [120,153]
var(56) = 120
[State -3, ステートナンバーを変数に格納];のけぞり
type = VarSet
trigger1 = stateno = [5001,5011]
var(56) = 5000
[State -3, ステートナンバーを変数に格納];空中やられ等
type = VarSet
trigger1 = stateno = [5030,5110]
var(56) = 5030
[State -3, ステートナンバーを変数に格納];起き上がり
type = VarSet
trigger1 = stateno = 5120
var(56) = 5120
[State -3, ステートナンバーを変数に格納];受け身
type = VarSet
trigger1 = stateno = [5200,5210]
var(56) = 5200

[State -3, ステートナンバーを変数に格納];減らす
type = Varadd
trigger1 = movetype = I
trigger2 = movetype = A
var(56) = -1

[State -3, ステートナンバーを変数に格納];リセット
type = VarSet
trigger1 = var(56) = 112
trigger2 = var(56) = 4992
trigger3 = var(56) = 5022
trigger4 = var(56) = 5112
trigger5 = var(56) = 5192
var(56) = 0

;---------------------------------------------------------------------------
[State -2, しゃがみガードの硬直を一時的に記憶]
type = VarSet
trigger1 = (stateno = [150,153]) && statetype = C
var(45) = GetHitVar(hittime)
[State -2, しゃがみガードの硬直を一時的に記憶]
type = VarSet
trigger1 = (stateno = [120,133]) && statetype = C
var(45) = 999
[State -2, しゃがみガードの硬直を一時的に記憶];リセット
type = VarSet
trigger1 = (stateno != [150,153]) && movetype != H
trigger1 = (stateno != [120,133])
trigger2 = stateno = 140
trigger3 = var(45) =1 ;誤作動防止に最後の1フレは切り捨てる。
var(45) = 0

[State -2, ガード失敗値を加える]
type = Varadd
trigger1 = var(45) >1 ;誤作動防止に最後の1フレは切り捨てる。
trigger1 = (stateno != [120,153]) && movetype = H  ;ガードそのものも指定して除外する事
var(46) = 100*var(59)  ;AIレベル変数を元に計算。
[State -2, ガード失敗値の上限]
type = Varadd
trigger1 = var(46) > 999
var(46) = 999

[State -2, 下ガード失敗した技を記憶1]
type = VarSet
trigger1 = var(45) >1
trigger1 = (stateno != [120,153]) && movetype = H
trigger1 = var(47) <1
var(47) = p2stateno
[State -2, 下ガード失敗した技を記憶2]
type = VarSet
trigger1 = var(45) >1
trigger1 = (stateno != [120,153]) && movetype = H
trigger1 = var(47) >0
var(48) = p2stateno
[State -2, 下ガード失敗した技を記憶3]
type = VarSet
trigger1 = var(45) >1
trigger1 = (stateno != [120,153]) && movetype = H
trigger1 = var(47) > 0&& var(48) >0
var(49) = p2stateno

[State -2, AIガード記憶用変数をリセット]
type = VarSet
trigger1 = RoundState < 2 && Enemy,RoundsExisted = 0
var(46) = 0
[State -2, AIガード記憶用変数をリセット]
type = VarSet
trigger1 = RoundState < 2 && Enemy,RoundsExisted = 0
var(47) = -4
[State -2, AIガード記憶用変数をリセット]
type = VarSet
trigger1 = RoundState < 2 && Enemy,RoundsExisted = 0
var(48) = -4
[State -2, AIガード記憶用変数をリセット]
type = VarSet
trigger1 = RoundState < 2 && Enemy,RoundsExisted = 0
var(49) = -4

;---------------------------------------------------------------------------
[State -3, AI擬似しゃがみためタイマー]
type = varset
trigger1 = StateType != C
Trigger1 = Prevstateno != [5000,5199]
Trigger1 = (Prevstateno != [1000,1062]) || (Prevstateno != [3000,3002])
trigger1 = Stateno != 0
trigger1 = Stateno != 52
Trigger2 = (Prevstateno = 131 || Prevstateno = 151)
var(52) = 0

[State -3, AI擬似しゃがみためタイマー]
type = varadd
trigger1 = StateType = C
trigger2 = moveType = H
Trigger3 = (stateno = [1000,1062]) || (stateno = [3000,3002]) ;
var(52) = 1

[State -3, AI擬似しゃがみためタイマー]
type = varadd
trigger1 = Stateno = 52 && var(8) = 0
var(52) = 10
[State -3, AI擬似しゃがみためタイマー]
type = varadd
trigger1 = Stateno = 52 && var(8) = 1
var(52) = 5

[State -3, AI擬似しゃがみためタイマー]
type = varadd
trigger1 = Stateno = 106
var(52) = 4

;---------------------------------------------------------------------------
[State -3, AI擬似横ため解除タイマー]
type = varset
trigger1 = var(52) > 0 || var(55) > 0
Trigger1 = P2BodyDist X > -1
trigger1 = var(51) < 1
var(51) = 0

[State -3, AI擬似横ため解除タイマー]
type = varset
trigger1 = var(52) > 0 || var(55) > 0
Trigger1 = P2BodyDist X < 0
var(51) = 32

[State -3, AI擬似横ため解除タイマー]
type = varadd
trigger1 = var(52) > 0 || var(55) > 0
trigger1 = var(51) > 0
var(51) = -1

;---------------------------------------------------------------------------

;[Statedef -3]をAIに使用

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------超必殺技

; (uses one super bar)
[State -3, セーブザクイーン]
type = ChangeState
value = 3000
triggerall = power >= 1000
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = Random < var(58) * 1   ;全く何も考えずに技を出す
trigger2 = EnemyNear(0), pos y > -140 && P2BodyDist X = [0,190]  ;距離
trigger2 = Random < 5*var(59) && var(57)>0 ;レベルで確率を上げる
trigger3 = P2MoveType = A && EnemyNear(0), pos y > -140 && P2BodyDist X = [0,190]   ;技でぶっぱ
trigger3 = Random < 20*var(57) && var(57) = [1,2]  ;キックボタンのみ

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------必殺技

[State -3, ジョーブローカー大]
type = ChangeState
value = 1060
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = Random < var(58) * 5   ;全く何も考えずに技を出す
trigger2 = P2stateType != L && P2BodyDist X = [-95,75] ;距離
trigger2 = Random < 10
trigger3 = P2StateType = A && P2BodyDist X = [0,75]   ;普通に対空
trigger3 = Random < 50*var(59) && var(57)>0 ;レベルで確率を上げる
trigger4 = P2StateType = A && EnemyNear(0),Vel X >0 && P2BodyDist X = [75,155]   ;対空前
trigger4 = Random < 30*var(59) && var(57)>0 ;レベルで確率を上げる
trigger5 = P2MoveType = A && P2stateType = C && P2BodyDist X = [-95,75]   ;しゃがみ技に反応
trigger5 = Random < 10*var(59) && var(57)>0 ;レベルで確率を上げる

;---------------------------------------------------------------------------
[State -3, ジョーブローカー小]
type = ChangeState
value = 1050
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = Random < var(58) * 5   ;全く何も考えずに技を出す
trigger2 = P2stateType != L && P2BodyDist X = [-95,75] ;距離
trigger2 = Random < 10
trigger3 = P2StateType = A && P2BodyDist X = [0,75]   ;普通に対空
trigger3 = Random < 30
trigger4 = P2StateType = A && EnemyNear(0),Vel X >0 && P2BodyDist X = [75,155]   ;対空前
trigger4 = Random < 30
trigger5 = P2MoveType = A && P2BodyDist X = [-180,160]   ;技のみでぶっぱ
trigger5 = Random < 10*var(59) && var(57)>0 ;レベルで確率を上げる

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

[State -3,ガード];起き上がり
Type = ChangeState
Value = 120
triggerAll = Alive && var(59) > 0
TriggerAll = Ctrl && MoveType!=A
TriggerAll = StateType != A ;邪魔な空中ガード禁止
TriggerAll = NumHelper(10000) ;ヘルパーの有無を確認
TriggerAll = InGuardDist || ((Helper(10000),Var(40)) && (EnemyNear,P2Dist X<0)) || (Helper(10000),Var(41)) ;InGuardDist(+Var補助)
Trigger1 = var(56) = [5115,5120] ;起き上がり
trigger1 = InGuardDist && Random < 150*var(59) && var(57)>0 ;レベルで確率を上げる

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------対空地上通常技

[State -3, しゃがみ大パンチ]
Type = ChangeState
Value = 410
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = P2StateType = A && EnemyNear(0),Vel y >0 && P2BodyDist X = [-135,75]   ;対空
trigger1 = Random < 30*var(59) && var(57)>0 ;レベルで確率を上げる
trigger2 = P2StateType = A && EnemyNear(0),Vel X >0 && EnemyNear(0),Vel y >0 && P2BodyDist X = [125,250]   ;対空前
trigger2 = Random < 50*var(59) && var(57)>0 ;レベルで確率を上げる

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------対空ジャンプ

;AI用垂直ジャンプ
[State -3, ジャンプ]
Type = ChangeState
Value = 43
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = P2Statetype = A && P2BodyDist X = [120,200]
trigger1 = Random < 30

;---------------------------------------------------------------------------
;AI用後ジャンプ
[State -3, ジャンプ]
Type = ChangeState
Value = 42
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = P2Statetype = A && P2BodyDist X = [0,120]
trigger1 = Random < 20

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

[State -3, Kung Fu Throw]   ;投げ
type = ChangeState
value = 800
TriggerAll = Alive && var(59) > 0
TriggerAll = StateType != A
TriggerAll = ctrl
triggerall = stateno != 100   ;ダッシュ時不可
triggerall = P2BodyDist X = [-10,45]
triggerall = (p2statetype = S) || (p2statetype = C)
triggerall = p2movetype != H || (p2stateno != [150,153]) || p2stateno != [5000,5300]
trigger1 = Random < var(58) * 5   ;全く何も考えずに技を出す
trigger2 = Random < 20*var(59) && var(57)>0 && P2BodyDist X < 20 ;レベルで確率を上げる
trigger3 = Random < 10*var(59) && var(57)>0 ;レベルで確率を上げる

;---------------------------------------------------------------------------

;歩き投げ
[State -3,歩き投げ]
Type = ChangeState
Value = 24
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A && P2BodyDist X  = [55,220]
trigger1 = Random < var(58) * 5  ;何も考えずに歩く
trigger2 = Random < 5*var(59) && var(57)>0 && P2BodyDist X  = [55,180] ;レベルで確率を上げる
trigger3 = Random < 20*var(57) && P2StateType = C && var(57) = [1,2] ;キックボタンのみ

[State -3, 歩き投げ];投げれそうだったら投げてみる。
type = ChangeState
triggerall = stateno = 24
Triggerall = p2movetype != H || (p2stateno != [150,153]) || p2stateno != [5000,5300]
triggerall = P2BodyDist X = [-5,20]
triggerall = (p2statetype = S) || (p2statetype = C)
trigger1 = Random < 100*var(59) && var(57)>0 ;レベルで確率を上げる
value = 800

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------移動

;AI用前ジャンプ
[State -3, ジャンプ]
Type = ChangeState
Value = 41
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = Random < var(58) * 1   ;全く何も考えずに跳ぶ
trigger2 = P2BodyDist X < -30 && Random < 10 ;距離
trigger3 = P2BodyDist X = [110,129]
trigger3 = Random < 20
trigger4 = P2BodyDist X = [130,270]
trigger4 = Random < 40
trigger5 = P2BodyDist X = [270,395]
trigger5 = Random < 20
trigger6 = P2BodyDist X > 395
trigger6 = Random < 20
trigger7 = P2Statetype != A && p2movetype= A && P2BodyDist X = [130,270] ;何かしてたらとりあえず前ジャンプ
trigger7 = Random < 50*var(57) && var(57) = [1,2] ;キックボタンのみ

;---------------------------------------------------------------------------

[State -3,歩く6]
Type = ChangeState
Value = 22
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = Random < var(58) * 5   ;全く何も考えずに歩く
Trigger2 = Random < 10 && P2BodyDist X  = [85,175]
Trigger3 = Random < 30 && P2BodyDist X  = [175,270]
Trigger4 = P2BodyDist X > 270 && Random < 60
Trigger5 = P2BodyDist X < 100 && backedgebodydist < 50 && Random < 100

[State -3, 歩く6];ニュートラルにコントロールを戻す。
type = ChangeState
TriggerAll = stateno = 22 && var(59) > 0
trigger1 = AnimTime = 0
trigger2 = Random < 100*var(59) && var(57)>0 && P2BodyDist X = [-10,40]
trigger3 = AnimElem = 2 && Random < 30
trigger4 = AnimElem >= 3 && Random < 50
trigger5 = frontedgebodydist < 18
trigger6 = Random < 50*var(59) && var(57)>0 && P2BodyDist X = [75,95] ;通常技間合い
trigger7 = Random < 50*var(59) && var(57)>0 && P2BodyDist X = [135,175] ;通常技間合い
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
[State -3,ガード]
Type = ChangeState
Value = 120
triggerAll = Alive && var(59) > 0
TriggerAll = Ctrl && MoveType!=A
TriggerAll = StateType != A ;邪魔な空中ガード禁止
TriggerAll = NumHelper(10000) ;ヘルパーの有無を確認
TriggerAll = InGuardDist || ((Helper(10000),Var(40)) && (EnemyNear,P2Dist X<0)) || (Helper(10000),Var(41)) ;InGuardDist(+Var補助)
trigger1 = StateNo = 140 && Random < 100+(80*var(59)) && var(57)>0 ;レベルで確率を上げる
trigger2 = Random < 8*var(59)*var(59) && var(57)>0 ;レベルで確率を上げる

[State -3, Guard];勝手にガードを解くことを制限
Type = ChangeState
Value = 120;強制ガード
TriggerAll = var(59) > 0
TriggerAll = PrevStateNo = [120,140] ;直前がガードステート
TriggerAll = Ctrl && !Time ;InGuardDist+Ctrl+Time=0
TriggerAll = InGuardDist || ((Helper(10000),Var(40)) && (EnemyNear,P2Dist X<0)) || (Helper(10000),Var(41)) ;InGuardDist(+Var補助)
Trigger1 = StateNo = [20,21] ;歩き
Trigger2 = StateNo = 10 ;屈み
Trigger3 = StateNo = 12 ;立ち上がり
Trigger4 = stateno=[40,43] ;ジャンプ

