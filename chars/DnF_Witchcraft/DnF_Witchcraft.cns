;キャラの基本的な情報を設定するファイル

;-------------------------------------------------------------------------------
; 基本データ
;-------------------------------------------------------------------------------
[Data]
life                    = 900	;体力ゲージ最大値（デフォルトは１０００）
power                = 4000	;パワーゲージ最大値（デフォルトは3000=Lv.3）
attack                = 70	;攻撃力（デフォルトは１００％）
defence             = 85	;防御力（デフォルトは１００％）
fall.defence_up     = 50	;横に倒れている時に一時的に加える防御力（％）
liedown.time        = 60	;横に倒れている時間（フレーム）
airjuggle             = 15	;ジャグルポイント限界値（落下状態の相手に攻撃がヒットする上限値）
sparkno             = 2	;デフォルトのヒットスパーク（fightfxから参照される）
guard.sparkno      = 40	;デフォルトのガードスパーク（fightfxから参照される）
KO.echo            = 0	;ＫＯ時の音声（11,0）にエコーを掛けるか否か（0=掛けない,1=掛ける）
volume              = 120	;キャラの音量（最小-255・最大255）
IntPersistIndex    = 50	;次のラウンドへ持ち越せる変数（Var）の範囲
FloatPersistIndex = 30	;次のラウンドへ持ち越せる変数（FVar）の範囲

;-------------------------------------------------------------------------------
; サイズ
;-------------------------------------------------------------------------------
[Size]
xscale           = 1		;キャラの横の大きさ（絶対値・float）
yscale           = 1		;キャラの縦の大きさ（絶対値・float）
ground.back    = 13		;地上にいる時の「後方の物理的な幅」
ground.front    = 9		;地上にいる時の「前方の物理的な幅」
air.back          = 8		;空中にいる時の「後方の物理的な幅」
air.front         = 23		;空中にいる時の「前方の物理的な幅」
height           = 83		;キャラの物理的な（相手が飛び越せない）高さ
attack.dist      = 160	;相手がガード態勢に入る最低の距離
proj.attack.dist = 90		;自分の「Projectile」に対して相手がガード態勢に入る最低距離
proj.doscale    = 0		;xscaleとyscaleを「Projectile」にも影響させるか否か（0=させない・1=させる）
head.pos        = -7,-57	;キャラの標準の頭の座標（Bind系で適用される）
mid.pos          = -11.-38	;キャラの標準の体中心の座標（Bind系で適用される）
shadowoffset  = 0		;影のＹ軸方向の位置座標
draw.offset     = 0,0		;キャラの表示座標（Ｘ軸,Ｙ軸）

;-------------------------------------------------------------------------------
; 移動速度
;-------------------------------------------------------------------------------
[Velocity]
walk.fwd       = 2.4		;前進速度（Ｘ軸・[Statedef 20]に適用される）
walk.back      = -2.4	;後退速度（Ｘ軸・[Statedef 20]に適用される）			
run.fwd        = 4.4,0	;前方に走る速度（Ｘ軸,Ｙ軸・[Statedef 100]に適用される）	
run.back       = -4.4,0	;後方に走る速度（Ｘ軸,Ｙ軸・[Statedef 105]に適用される）	
jump.neu      = 0,-9.8	;垂直ジャンプの速度（Ｘ軸,Ｙ軸・[Statedef 40]に適用される）	
jump.back     = -2.4		;後方ジャンプの速度（Ｘ軸・[Statedef 40]に適用される）		
jump.fwd      = 2.4		;前方ジャンプの速度（Ｘ軸・[Statedef 40]に適用される）		
runjump.fwd  = 4.4,-9.8	;前方に走ってからのジャンプ速度（Ｘ軸,Ｙ軸・[Statedef 40]に適用される）	
runjump.back = -4.4,-9.8	;後方に走ってからのジャンプ速度（Ｘ軸,Ｙ軸・[Statedef 40]に適用される）	
airjump.neu   = 0,-8.1	;空中垂直ジャンプ速度（Ｘ軸,Ｙ軸・[Statedef 45]に適用される）
airjump.back  = -2.55	;空中後方ジャンプ速度（Ｘ軸・[Statedef 45]に適用される）
airjump.fwd   = 2.5		;空中前方ジャンプ速度（Ｘ軸・[Statedef 45]に適用される）

;-------------------------------------------------------------------------------
; 運動関係
;-------------------------------------------------------------------------------
[Movement]
airjump.num    = 0		;空中ジャンプが出来る回数
airjump.height  = 35		;空中ジャンプが出来る最低の高度（Ｙ軸）
yaccel           = .31	;Ｙ軸加速度（重力）					
stand.friction   = .85	;立っている時の摩擦係数（ステートのPhysicsが「S」の時）
crouch.friction = .80	;しゃがんでいる時の摩擦係数（ステートのPhysicsが「C」の時）

