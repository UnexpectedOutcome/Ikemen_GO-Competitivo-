;コモンステート上書き用
;主にこのキャラ独自の記述とＡＩ仕様化

;-------------------------------------------------------------------------------
[Statedef 0]; Stand 立ち（ニュートラル）
;-------------------------------------------------------------------------------
type = S
physics = S
sprpriority = 0

[State 0, 0]; 戦闘中じゃない時は無敵
type = NotHitBy
trigger1 = RoundState != 2
value = SCA
time = 2

[State 0, 0/Snd]; ダッシュ音停止
type = StopSnd
trigger1 = Time = 0
channel = 1

[State 0, 1]; アニメ変更
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over 振り返り動作終了時
value = 0

[State 0, 2]; 速度停止１（Ｙ座標）
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3]; 速度停止２（Ｘ座標）
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4]; 空中立ちなどの不具合自己修正
type = PosSet
trigger1 = Pos Y != 0
Y = 0

[State 0, CH]; 生死判定
type = ChangeState
trigger1 = !alive
value = 5050

[State 0, Ds]; ヘルパー分身バグの自己消去
type = DestroySelf
trigger1 = IsHelper

;-------------------------------------------------------------------------------
[Statedef 10]; Stand to Crouch 立ち→屈みの切り替え
;-------------------------------------------------------------------------------
type = C
physics = C
anim = 10

[State 10, AI]; ＡＩ制御用（＋追加）
type = ChangeState
trigger1 = var(59) > 0 && Time = 0
value = 0
ctrl = 1

[State 10, 1]; 減速
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, CH]; 屈みステートへ
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;-------------------------------------------------------------------------------
[Statedef 11]; Crouching 屈み
;-------------------------------------------------------------------------------
type = C
physics = C
anim = 11
sprpriority = 0

[State 11, AI]; ＡＩ制御用（＋追加）
type = ChangeState
trigger1 = var(59) > 0 && Time = 0
value = 0
ctrl = 1

[State 11, 1]; Change from turning animation アニメ変更
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;-------------------------------------------------------------------------------
[Statedef 12]; Crouch to Stand 屈み→立ちの切り替え
;-------------------------------------------------------------------------------
type = S
physics = S
anim = 12

[State 12, AI]; ＡＩ制御用（＋追加）
type = ChangeState
trigger1 = var(59) > 0 && Time = 0
value = 0
ctrl = 1

[State 12, CH]; 立ちステートへ
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;-------------------------------------------------------------------------------
[Statedef 20]; Walk 前進／後退
;-------------------------------------------------------------------------------
type = S
physics = S
sprpriority = 0

[State 20, AI]; ＡＩ制御用（＋追加）
type = ChangeState
trigger1 = var(59) > 0 && Time = 0
value = 0
ctrl = 1

[State 20, 0]; 振り返り動作抑制
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 20, 0]; 前進速度
type = VelSet
trigger1 = var(59) <= 0 && Command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 0]; 後退速度
type = VelSet
trigger1 = var(59) <= 0 && Command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 0]; アニメ変更／前進
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 0]; アニメ変更／後退
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, SE]; 足音
type = PlaySnd
trigger1 = Time%30 = 1
value = s12,2

;-------------------------------------------------------------------------------
[Statedef 40]; Jump Start ジャンプ開始
;-------------------------------------------------------------------------------
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, AI]; ＡＩ制御用（＋追加）
type = ChangeState
trigger1 = var(59) >= 2 && Time = 0
Value = 0
Ctrl = 1

[State 40, 0]; Ｘ速度設定１
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 0]; Ｘ速度設定２
type = VarSet
trigger1 = Time = 1 && var(59) <= 0 && Command = "holdfwd"
sysvar(1) = 1

[State 40, 0]; Ｘ速度設定３
type = VarSet
trigger1 = Time = 1 && var(59) <= 0 && Command = "holdback"
sysvar(1) = -1

[State 40, 1]; ジャンプ速度
type = VelSet
trigger1 = AnimTime = -1
x = Const(velocity.jump.neu.x)*(sysvar(1)=0)+Const(velocity.jump.fwd.x)*(sysvar(1)=1)+Const(velocity.jump.back.x)*(sysvar(1)=-1)
y = Const(velocity.jump.y)

[State 40, 1]; ダッシュジャンプ速度
type = VelSet
trigger1 = AnimTime = -1 && PrevStateNo = 100
x = Const(velocity.runjump.fwd.x)*(sysvar(1)=1)+Const(velocity.runjump.back.x)*(sysvar(1)=-1)

[State 40, CV]; ボイス
type = PlaySnd
trigger1 = AnimTime = -1
value = s12,0

[State 40, CH]; ジャンプステートへ
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;-------------------------------------------------------------------------------
[Statedef 55]; Stay Air 滞空
;-------------------------------------------------------------------------------
type = A
physics = N
anim = 55
ctrl = 0
sprpriority = 1

[State 55, AI]; ＡＩ制御用（＋追加）
type = ChangeState
trigger1 = var(59) >= 2 && Time = 0
Value = 0
Ctrl = 1

[State 55, -1]; 落下速度
type = VelSet
trigger1 = 1
Y = 0.5

[State 55, F]; 動作終了
type = ChangeState
trigger1 = Pos Y > -30
trigger2 = var(59) <= 0 && command != "holdup"
value = 50
ctrl = 1

;-------------------------------------------------------------------------------
[Statedef 100]; RUN_FWD 前方ダッシュ
;-------------------------------------------------------------------------------
type = S
physics = S
anim = 100
sprpriority = 1

[State 100, 0]; ぶつかり判定消去
type = PlayerPush
trigger1 = 1
value = 0

[State 100, 0]; ダッシュ速度
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 0]; Prevent run from canceling into walk 歩き動作・振り返り動作抑制
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, SE]; ダッシュ足音（変更）
type = PlaySnd
trigger1 = Time%30 = 1
value = s12,3
channel = 1

[State 100, F]; 動作終了
type = ChangeState
trigger1 = var(59) <= 0 && Command != "holdfwd"
value = 0

;-------------------------------------------------------------------------------
[Statedef 105]; RUN_BACK 後方ダッシュ
;-------------------------------------------------------------------------------
type = S
physics = S
anim = 105
sprpriority = 1

[State 105, 0]; ぶつかり判定消去
type = PlayerPush
trigger1 = 1
value = 0

[State 105, 1]; ダッシュ速度
type = VelSet
trigger1 = 1
x = const(velocity.run.back.x)

[State 105, 1]; Prevent run from canceling into walk 歩き動作・振り返り動作抑制
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 105, SE]; ダッシュ音（変更）
type = PlaySnd
trigger1 = Time%30 = 1
value = s12,3
channel = 1

[State 105, F]; 動作終了
type = ChangeState
trigger1 = var(59) <= 0 && Command != "holdback"
value = 0

;-------------------------------------------------------------------------------
[Statedef 106]; BACK_STEP バックステップ
;-------------------------------------------------------------------------------
type = A
physics = A
ctrl = 0
anim = 106
sprpriority = 1

[State 106, 0]; ぶつかり判定消去
type = PlayerPush
trigger1 = 1
value = 0

[State 106, 0]; キャンセル使用時のフラッシュ（＋追加）
type = PalFX
triggerall = Time = 0
trigger1 = PrevStateNo = [200,220]
time = 5
add = 256,256,256

[State 106, 0]; 飛び退く速度
type = VelSet
trigger1 = Time = 0
x = Const(velocity.run.back.x)
y = Const(velocity.jump.y)/3

[State 106, 1]; 暴発防止
type = CtrlSet
trigger1 = Time = 2
value = 1

[State 106, CV]; ボイス
type = PlaySnd
trigger1 = Time = 1
value = s12,1
channel = 0

[State 106, CH]; 着地動作へ
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= -2
value = 107

;-------------------------------------------------------------------------------
[Statedef 110]; 前方空中ダッシュ
;-------------------------------------------------------------------------------
type = A
movetype = I
physics = N
velset = 9,0
anim = 110
ctrl = 1

[State 110, 0]; ぶつかり判定消去
type = PlayerPush
trigger1 = 1
value = 0

[State 110, 1]; 使用回数＋１
type = VarAdd
trigger1 = Time = 1
var(15) = 1

[State 110, CV]; ボイス
type = PlaySnd
trigger1 = Time = 1
value = s20,130

[State 110, EX1]; 煙のエフェクト
type = Explod
trigger1 = Time = 1
anim = 7290
ID = 7290
postype = p1
pos = 0,-44
sprpriority = 3
ownpal = 1
removeongethit = 1
;removetime = 18
bindtime = 99

[State 110, F]; 動作終了
type = ChangeState
trigger1 = var(59) <= 0 && Command != "holdfwd"
trigger2 = Time > 60
value = 50
ctrl = 1

