;-------------------------------------------------------------------------------
[Statedef 120]; GUARD(start) ガード開始
;-------------------------------------------------------------------------------
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 0]; アニメ変更
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A) * 2

[State 120, 0]; 物理状態指定１
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 0]; 物理状態指定２
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 0]; 物理状態指定３
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]; ガード方向の切り替え（上→下）
type = StateTypeSet
triggerall = Statetype = S
trigger1 = var(59) <= 0 && Command = "holddown"
trigger2 = var(59) >= 2
trigger2 = Enemy,StateType = C || fvar(30) != 0
trigger2 = Random <= var(59)*80 || var(59) >= 3
statetype = C
physics = C

[State 120, Lo to Hi]; ガード方向の切り替え（下→上）
type = StateTypeSet
triggerall = Statetype = C
trigger1 = var(59) <= 0 && Command != "holddown"
trigger2 = var(59) >= 2
trigger2 = Enemy,StateType != C && fvar(30) = 0
trigger2 = Random <= var(59)*80 || var(59) >= 3
statetype = S
physics = S

[State 120, CH]; 各種ガードステートへ
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A) * 2

[State 120, Stop Guarding]; ガード終了動作へ
type = ChangeState
trigger1 = var(59) <= 0 && Command != "holdback"
trigger2 = var(59) <= 2
trigger2 = !InGuardDist
trigger3 = var(59) >= 3
trigger3 = !InGuardDist && !Helper(10010),InGuardDist && !Helper(10020),InGuardDist
value = 140

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 130]; STAND GUARD (guarding) 立ちガード（受付）
type = S
physics = S

[State 130, 0]; アニメ変更
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 130, Hi to Lo]; ガード方向の切り替え（上→下）
type = ChangeState
trigger1 = var(59) <= 0 && Command = "holddown"
trigger2 = var(59) >= 2
trigger2 = Enemy,StateType = C || fvar(30) != 0
trigger2 = Random <= var(59)*80 || var(59) >= 3
value = 131

[State 130, Stop Guarding]; ガード終了ステートへ
type = ChangeState
trigger1 = var(59) <= 0 && Command != "holdback"
trigger2 = var(59) <= 2
trigger2 = !InGuardDist
trigger3 = var(59) >= 3
trigger3 = !InGuardDist && !Helper(10010),InGuardDist && !Helper(10020),InGuardDist
value = 140

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 131]; CROUCH GUARD (guarding) 屈みガード（受付）
type = C
physics = C

[State 131, 0]; アニメ変更
type = ChangeAnim
trigger1 = Anim != 131
value = 131

[State 131, Lo to Hi]; ガード方向の切り替え（下→上）
type = ChangeState
trigger1 = var(59) <= 0 && Command != "holddown"
trigger2 = var(59) >= 2
trigger2 = Enemy,StateType != C && fvar(30) = 0
trigger2 = Random <= var(59)*80 || var(59) >= 3
value = 130

[State 131, Stop Guarding]; ガード終了ステートへ
type = ChangeState
trigger1 = var(59) <= 0 && Command != "holdback"
trigger2 = var(59) <= 2
trigger2 = !InGuardDist
trigger3 = var(59) >= 3
trigger3 = !InGuardDist && !Helper(10010),InGuardDist && !Helper(10020),InGuardDist
value = 140

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 132]; AIR GUARD (guarding) 空中ガード（受付）
type = A
physics = N

[State 132, 0]; アニメ変更
type = ChangeAnim
trigger1 = Anim != 132
value = 132

[State 132, 0]; 重力
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 132, 0]; システム変数
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 0]; 落下速度初期化
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 0]; 座標指定初期化
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, CH1]; 立ちガードへ移行
type = ChangeState
triggerall = sysvar(0)
trigger1 = var(59) <= 0 && Command = "holdback"
trigger1 = InGuardDist
trigger2 = var(59) <= 2
trigger2 = InGuardDist
trigger3 = var(59) >= 3
trigger3 = InGuardDist || Helper(10010),InGuardDist || Helper(10020),InGuardDist
value = 130

[State 132, CH2]; 着地ステートへ以降
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 132, Stop Guarding]; ガード終了ステートへ
type = ChangeState
trigger1 = var(59) = 0 && Command != "holdback"
trigger2 = var(59) <= 2
trigger2 = !InGuardDist
trigger3 = var(59) >= 3
trigger3 = !InGuardDist && !Helper(10010),InGuardDist && !Helper(10020),InGuardDist
value = 140

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 140]; GUARD (end) ガード終了ステート
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged
ctrl = 1

[State 140, 0]; アニメ変更
type = ChangeAnim
trigger1 = Time = 0
value = 140 + (statetype = C) + (statetype = A) * 2

[State 140, 0]; 物理状態指定１
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 140, 0]; 物理状態指定２
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 140, 0]; 物理状態指定３
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 140, Hi to Lo]; 物理状態指定４
type = StateTypeSet
trigger1 = statetype = S && var(59) <= 0 && Command = "holddown"
statetype = C
physics = C

[State 140, Lo to Hi]; 物理状態指定５
type = StateTypeSet
trigger1 = statetype = C && var(59) <= 0 && Command != "holddown"
statetype = S
physics = S

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 150]; SGUARDHIT (shaking) 立ちガード接触（ヒットシェイク）
type = S
movetype= H
physics = N
velset = 0,0

[State 150, 0]; アニメ変更
type = ChangeAnim
trigger1 = 1
value = 150

[State 150, 0]; ゲームパッドを振動させる
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

[State 150, CH]; 反動ステートへ
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2 * ifelse(var(59)<=0,(command = "holddown"),0)

[State 150, Hi to Lo]; ガード方向の切り替え（上→下）
type = StateTypeSet
triggerall = Statetype = S
trigger1 = var(59) <= 0 && Command = "holddown"
trigger2 = var(59) >= 2
trigger2 = Enemy,StateType = C || fvar(30) != 0
trigger2 = Random <= var(59)*80 || var(59) >= 3
statetype = C
physics = C

[State 150, Lo to Hi]; ガード方向の切り替え（下→上）
type = StateTypeSet
triggerall = Statetype = C
trigger1 = var(59) <= 0 && Command != "holddown"
trigger2 = var(59) >= 2
trigger2 = Enemy,StateType != C && fvar(30) = 0
trigger2 = Random <= var(59)*80 || var(59) >= 3
statetype = S
physics = S

