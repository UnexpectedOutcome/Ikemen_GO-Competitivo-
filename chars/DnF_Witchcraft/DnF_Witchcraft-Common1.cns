; Common state file for M.U.G.E.N beta 2002.04.14
;
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump.
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

; The following states have special handling within MUGEN, and should be
; overridden with caution:
; Jump Start (40): airjumping bookkeeping at time = 0
; All guard states (120-155): guard handling throughout state
; Hit_trip, shaking (5070): defence increases at time = 0
; Hit_bounce (5100): defence increases at time = 0, player becomes
;                    invincible if within 10 ticks of getting up
; Hit_liedown (5110): player changes to get-up state (5120) when ready
; Hit_getup (5120): player's defence is restored to normal at time = 0
; Hitfall_recover (5200): player's defence is restored at time = 0
; Hitfall_airrecover (5210): player's defence is restored at time = 0

;-------------------------------------------------------------------------------
[Statedef 0]; Stand 立ち（ニュートラル）
;-------------------------------------------------------------------------------
type = S
physics = S
sprpriority = 0

[State 0, 0]; 戦闘中じゃない時は無敵
type = NotHitBy
trigger1 = RoundState != 2
value = SCA
time = 2

[State 0, 1]; アニメ変更
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over 振り返り動作終了時
value = 0

[State 0, 2]; 速度停止１（Ｙ座標）
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3]; 速度停止２（Ｘ座標）
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4]; 空中立ちなどの不具合自己修正
type = PosSet
trigger1 = Pos Y != 0
Y = 0

[State 0, CH]; 生死判定
type = ChangeState
trigger1 = !alive
value = 5050

[State 0, Ds]; ヘルパー分身バグの自己消去
type = DestroySelf
trigger1 = IsHelper

;-------------------------------------------------------------------------------
[Statedef 10]; Stand to Crouch 立ち→屈みの切り替え
;-------------------------------------------------------------------------------
type = C
physics = C
anim = 10

[State 10, 1]; 減速
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, CH]; 屈みステートへ
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;-------------------------------------------------------------------------------
[Statedef 11]; Crouching 屈み
;-------------------------------------------------------------------------------
type = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1]; Change from turning animation アニメ変更
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;-------------------------------------------------------------------------------
[Statedef 12]; Crouch to Stand 屈み→立ちの切り替え
;-------------------------------------------------------------------------------
type = S
physics = S
anim = 12

[State 12, CH]; 立ちステートへ
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;-------------------------------------------------------------------------------
[Statedef 20]; Walk 前進／後退
;-------------------------------------------------------------------------------
type = S
physics = S
sprpriority = 0

[State 20, 0]; 振り返り動作抑制
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 20, 0]; 前進速度
type = VelSet
trigger1 = Command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 0]; 後退速度
type = VelSet
trigger1 = Command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 0]; アニメ変更／前進
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 0]; アニメ変更／後退
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, SE]; 足音
type = PlaySnd
trigger1 = Time%30 = 1
value = s12,2

;-------------------------------------------------------------------------------
[Statedef 40]; Jump Start ジャンプ開始
;-------------------------------------------------------------------------------
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 0]; Ｘ速度設定１
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 0]; Ｘ速度設定２
type = VarSet
trigger1 = Command = "holdfwd"
sysvar(1) = 1

[State 40, 0]; Ｘ速度設定３
type = VarSet
trigger1 = Command = "holdback"
sysvar(1) = -1

[State 40, 1]; ジャンプ速度
type = VelSet
trigger1 = AnimTime = 0
x = Const(velocity.jump.neu.x)*(sysvar(1)=0)+Const(velocity.jump.fwd.x)*(sysvar(1)=1)+Const(velocity.jump.back.x)*(sysvar(1)=-1)
y = Const(velocity.jump.y)

[State 40, 1]; ダッシュジャンプ速度
type = VelSet
trigger1 = AnimTime = 0 && (PrevStateNo = [100,105])
x = Const(velocity.runjump.fwd.x)*(sysvar(1)=1)+Const(velocity.runjump.back.x)*(sysvar(1)=-1)

[State 40, CV]; ボイス
type = PlaySnd
trigger1 = AnimTime = -1
value = s12,0

[State 40, CH]; ジャンプステートへ
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 45]; AirJump Start 空中ジャンプ（このキャラでは使用していない）
type = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 0]; アニメ変更１
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 0]; アニメ変更２
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 0]; Ｘ速度設定１
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 0]; Ｘ速度設定２
type = VarSet
trigger1 = Time = 1 && Command = "holdfwd"
sysvar(1) = 1

[State 45, 0]; Ｘ速度設定３
type = VarSet
trigger1 = Time = 1 && Command = "holdback"
sysvar(1) = -1

[State 45, 1]; ジャンプ速度
type = VelSet
trigger1 = Time = 2
x = Const(velocity.airjump.neu.x)*(sysvar(1)=0)+Const(velocity.airjump.fwd.x)*(sysvar(1)=1)+Const(velocity.airjump.back.x)*(sysvar(1)=-1)
y = Const(velocity.airjump.y)

[State 45, CH]; ジャンプステートへ
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 50]; Jump Up ジャンプステート
type = A
physics = A

[State 50, 0]; システム変数
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 0]; アニメ変更１（上昇）
type = ChangeAnim
trigger1 = Time = 0
value = IfElse((vel x)=0,41,IfElse((vel x)>0, 42, 43))

[State 50, 0]; アニメ変更２（下降）
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = SelfAnimExist(anim+3)
persistent = 0
value = Anim + 3

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 51]; Jump Down (empty state for compatibility) ジャンプ下降（使われてない）
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;使われてないと言いつつ空中ガードからの戻り先がここだったりするので向こう弄って修正。

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 52]; Jump Land 着地
type = S
physics = S
ctrl = 0
anim = 47

[State 52, 0]; 速度初期化
type = VelSet
trigger1 = 1
y = 0

[State 52, 0]; 座標初期化
type = PosSet
trigger1 = 1
y = 0

[State 52, 1]; コントロール
type = CtrlSet
trigger1 = AnimTime = -1
value = 1

[State 52, F]; 動作終了
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;-------------------------------------------------------------------------------
[Statedef 100]; RUN_FWD 前方ダッシュ
;-------------------------------------------------------------------------------
type = S
physics = S
anim = 100
sprpriority = 1

[State 100, 0]; ぶつかり判定消去
type = PlayerPush
trigger1 = 1
value = 0

[State 100, 0]; ダッシュ速度
type = VelSet
trigger1 = 1
x = Const(velocity.run.fwd.x)

[State 100, 0]; Prevent run from canceling into walk 歩き動作・振り返り動作抑制
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, SE]; ダッシュ足音
type = PlaySnd
trigger1 = Time%12 = 1
value = s12,3

[State 100, F]; 動作終了
type = ChangeState
trigger1 = Command != "holdfwd"
value = 0

