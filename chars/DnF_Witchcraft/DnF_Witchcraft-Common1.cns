ctrl = 0
anim = 5300
velset = 0,0

[State 5500, 0]; アニメ変更
type = ChangeAnim
trigger1 = Time = 0
value = IfElse(SelfAnimExist(170),170,5300)

[State 5500, 1] ;Use continue animation if available
type = ChangeAnim
trigger1 = time = 0 && SelfAnimExist(5500)
value = 5500

;-------------------------------------------------------------------------------
[Statedef 5900]; Initialize (at the start of the round) ラウンド切り替わり時の処理
;-------------------------------------------------------------------------------
