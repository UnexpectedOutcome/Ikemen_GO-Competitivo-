value = 170

[State 175, 0]; 無敵
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 175, 1]; アニメ変更
type = ChangeAnim
trigger1 = Time = 1
value = 175

;-------------------------------------------------------------------------------
[Statedef 190]; PREINTRO イントロ動作分岐
;-------------------------------------------------------------------------------
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 190, CH] ;Go straight to intro. 通常イントロへ
type = ChangeState
