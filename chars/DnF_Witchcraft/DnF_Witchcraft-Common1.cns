[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Intro for round 1／チーム戦で出てきた時もイントロへ飛ぶ
type = ChangeState
trigger1 = RoundNo = 1 || RoundsExisted = 0
value = 190

