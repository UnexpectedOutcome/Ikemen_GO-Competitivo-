trigger1 = Anim != 131
value = 131

[State 131, Lo to Hi]; ガード方向の切り替え（下→上）
type = ChangeState
trigger1 = Command != "holddown"
value = 130

[State 131, Stop Guarding]; ガード終了ステートへ
type = ChangeState
trigger1 = Command != "holdback"
trigger2 = !InGuardDist
value = 140

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 132]; AIR GUARD (guarding) 空中ガード（受付）
type = A
physics = N

[State 132, 0]; アニメ変更
type = ChangeAnim
trigger1 = Anim != 132
value = 132

[State 132, 0]; 重力
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 132, 0]; システム変数
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 0]; 落下速度初期化
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 0]; 座標指定初期化
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, CH1]; 立ちガードへ移行
type = ChangeState
triggerall = sysvar(0)
trigger1 = Command = "holdback"
trigger1 = InGuardDist
value = 130

[State 132, CH2]; 着地ステートへ以降
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 132, Stop Guarding]; ガード終了ステートへ
type = ChangeState
trigger1 = Command != "holdback"
trigger2 = !InGuardDist
value = 140

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
