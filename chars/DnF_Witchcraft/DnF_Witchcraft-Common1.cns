physics = S

[State 130, 0]; アニメ変更
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 130, Hi to Lo]; ガード方向の切り替え（上→下）
type = ChangeState
trigger1 = Command = "holddown"
value = 131

[State 130, Stop Guarding]; ガード終了ステートへ
type = ChangeState
trigger1 = Command != "holdback"
trigger2 = !InGuardDist
value = 140

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
