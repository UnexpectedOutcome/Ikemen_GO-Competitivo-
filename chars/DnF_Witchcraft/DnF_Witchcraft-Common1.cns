value = 0

;-------------------------------------------------------------------------------
[Statedef 195]; 挑発
;-------------------------------------------------------------------------------
type = S
movetype = I
physics = S
ctrl = 0
anim = 0
velset = 0,0

[State 195, 0]; アニメ変更
type = ChangeAnim
trigger1 = Time = 0 && SelfAnimExist(195)
value = 195

[State 195, F]; 動作終了
