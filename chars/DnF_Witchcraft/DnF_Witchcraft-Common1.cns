[Statedef 154]; AGUARDHIT (shaking) 空中ガード接触（ヒットシェイク）
type = A
movetype= H
physics = N
velset = 0,0

[State 154, 0]; アニメ変更
type = ChangeAnim
trigger1 = 1
value = 152

[State 154, 0]; ゲームパッドを振動させる
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 4

[State 154, CH]; 反動ステートへ
type = ChangeState
trigger1 = HitShakeOver
value = 155 ;AGUARDHIT2

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
[Statedef 155]; AGUARDHIT2 (knocked away) 空中ガード接触（反動）
type = A
movetype= H
physics = N
anim = 152

[State 155, 0]; ノックバック速度の指定？
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 155, 0]; Ｙ速度の変更
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 155, 1]; コントロール
type = CtrlSet
trigger1 = Time = GetHitVar(ctrltime)
value = 1

[State 155, 2]; システム変数
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 155, 2]; Ｙ速度の指定／着地処理
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 155, 2]; 座標指定／着地処理
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 155, CH]; 立ちガード受付へ
type = ChangeState
triggerall = sysvar(0)
trigger1 = Command = "holdback"
trigger1 = Inguarddist
value = 130

[State 155, F1]; 動作終了
type = ChangeState
trigger1 = !sysvar(0)
trigger1 = Ctrl
value = 50

[State 155, F2]; 着地
type = ChangeState
trigger1 = sysvar(0)
value = 52

;-------------------------------------------------------------------------------
