;-------------------------------------------------------------------------------
[Statedef 120]; GUARD(start) ガード開始
;-------------------------------------------------------------------------------
type = U    ;Leave state type unchanged 直前の物理状態を継続する
physics = U ;Leave physics unchanged 直前の摩擦状態を継続する

[State 120, 0]; アニメ変更
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A) * 2

[State 120, 0]; 物理状態指定１
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 0]; 物理状態指定２
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 0]; 物理状態指定３
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]; ガード方向の切り替え（上→下）
type = StateTypeSet
trigger1 = Statetype = S && Command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]; ガード方向の切り替え（下→上）
type = StateTypeSet
trigger1 = Statetype = C && Command != "holddown"
statetype = S
physics = S

[State 120, CH]; 各種ガードステートへ
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A) * 2

[State 120, Stop Guarding]; ガード終了動作へ
type = ChangeState
trigger1 = Command != "holdback"
trigger2 = !InGuardDist
value = 140

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
