; common helpers

;--------------------------------------------------------------------------------------
;Ice Helper
;Vars 0 and 1 = x/y offset
;Var(2) = destroyself

[Statedef 7060]
type = S
physics = N
sprpriority = 1

[State 7060, VarSet]
type = VarSet
trigger1 = time = 0
var(0) = random%11 - 5

[State 7060, VarSet]
type = VarSet
trigger1 = time = 0
var(1) = random%15 - 7

[State 7060, ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
value = 7060 + random%4

[State 7060, Bind]
type = PosAdd
trigger1 = 1
x = p2dist x + var(0) + enemynear, const(size.mid.pos.x)
y = p2dist y + var(1) + enemynear, const(size.mid.pos.y)

[State 7060, VarSet]
type = VarSet
trigger1 = 1
var(2) = 0

[State 7060, VarSet]
type = VarSet
trigger1 = root, numhelper(7060) > 2
trigger1 = time > 2
var(2) = 1

[State 7060, VarSet]
type = VarSet
trigger1 = p2movetype != H
trigger2 = enemynear, stateno != [5706, 5707]
trigger3 = enemynear, stateno = 5706
trigger3 = p2statetype != S
trigger4 = enemynear, stateno = 5707
trigger4 = p2statetype != A
var(2) = 2

[State 7060, VarAdd]
type = VarSet
trigger1 = !var(2)
var(3) = 0

[State 7060, VarAdd]
type = VarAdd
trigger1 = var(2)
var(3) = 1

[State 7060, PlaySnd]
type = PlaySnd
trigger1 = var(3) = 2
value = 7060, 0

[State 7060, Explod]
type = Explod
trigger1 = var(3) = 2
anim = 7064 + random%3
id = 7064
vel = 3, 4
sprpriority = 2

[State 7060, Explod]
type = Explod
trigger1 = var(3) = 2
anim = 7064 + random%3
id = 7064
bindtime = 1
vel = 4, -3
sprpriority = 2

[State 7060, Explod]
type = Explod
trigger1 = var(3) = 2
anim = 7067 + random%3
id = 7064
vel = -3, 4
sprpriority = 2

[State 7060, Explod]
type = Explod
trigger1 = var(3) = 2
anim = 7067 + random%3
id = 7064
bindtime = 1
vel = -4, -3
sprpriority = 2

[State 7060, DestroySelf]
type = DestroySelf
trigger1 = var(3) > 1


[Statedef 10205]
type    = S				;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I				;Move-type: A-attack, I-idle, H-gethit
physics = N				;Physics: S-stand, C-crouch, A-air
anim = 205
sprpriority = 2

[State 10205, VarSet]
type = Null
trigger1 = !time
trigger1 = var(0) := parent, stateno || 1
trigger1 = var(1) := parent, anim || 1
trigger1 = var(2) := ifelse(parent, statetype = S, 1, ifelse(parent, statetype = C, 2, 3))

[State 10205, VarSet]
type = VarSet
trigger1 = parent, movetype = H
trigger2 = parent, stateno != var(0)
trigger3 = parent, anim != var(1)
trigger4 = var(2) = 1
trigger4 = parent, statetype != S
trigger5 = var(2) = 2
trigger5 = parent, statetype != C
trigger6 = var(2) = 3
trigger6 = parent, statetype != A
trigger7 = parent, var(0) < 0
var(59) = 1

[State 10205, DestroySelf]
type = DestroySelf
trigger1 = var(59)

[State 10205, Bind]
type = BindToParent
trigger1 = !var(59)

[State 10205, ChangeAnim]
type = ChangeAnim
trigger1 = !time
value = anim
elem = parent, var(0)
persistent = 0

[State 10205, ChangeAnim]
type = ChangeAnim
trigger1 = gametime > parent, var(57)
value = anim
elem = ifelse(animelemno(0) = 1, 36, animelemno(0) - 1)

[State 10205, Invisible]
type = AssertSpecial
trigger1 = parent, var(1) < 0
flag = invisible

[Statedef 10206]
type    = S				;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I				;Move-type: A-attack, I-idle, H-gethit
physics = N				;Physics: S-stand, C-crouch, A-air
anim = 206
sprpriority = 3

[State 10206, VarSet]
type = Null
trigger1 = !time
trigger1 = var(0) := parent, stateno || 1
trigger1 = var(1) := parent, anim || 1
trigger1 = var(2) := ifelse(parent, statetype = S, 1, ifelse(parent, statetype = C, 2, 3))

[State 10206, VarSet]
type = VarSet
trigger1 = parent, movetype = H
trigger2 = parent, stateno != var(0)
trigger3 = parent, anim != var(1)
trigger4 = var(2) = 1
trigger4 = parent, statetype != S
trigger5 = var(2) = 2
trigger5 = parent, statetype != C
trigger6 = var(2) = 3
trigger6 = parent, statetype != A
trigger7 = parent, var(0) < 0
var(59) = 1

[State 10206, DestroySelf]
type = DestroySelf
trigger1 = var(59)

[State 10206, Bind]
type = BindToParent
trigger1 = !var(59)

[State 10206, ChangeAnim]
type = ChangeAnim
trigger1 = !time
value = anim
elem = parent, var(0)
persistent = 0

[State 10206, ChangeAnim]
type = ChangeAnim
trigger1 = gametime > parent, var(57)
value = anim
elem = ifelse(animelemno(0) = 1, 36, animelemno(0) - 1)

[State 10206, Invisible]
type = AssertSpecial
trigger1 = parent, var(1) < 0
flag = invisible

[State 21362]
type = varset
trigger1 = time = 9999
trigger1 = parent,p2bodydist y != 0
trigger1 = p2dist x
fvar(1) = ifelse((parent,atan((p2bodydist y - 90) / abs(p2dist x))<0),0,(parent,atan((p2bodydist y - 90) / abs(p2dist x))))