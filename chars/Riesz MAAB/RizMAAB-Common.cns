;---------------------------------------------------------------------------
; Continue Screen Animation
; 接關畫面動畫
;---------------------------------------------------------------------------
[Statedef 5500]
type = S
movetype = I
physics = N
ctrl = 0
anim = 5300
velset = 0,0

[State 5500, 1] ;Use Continue Animation if Available
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5500)
value = 5500

;---------------------------------------------------------------------------
; Initialize (At the Start of the Round)
; 初始狀態 (每回合開始時)
;---------------------------------------------------------------------------
[Statedef 5900]
type = S
movetype = I
physics = N

[State 5900, 1 (Reset Variables)]
type = VarRangeSet
trigger1 = !RoundsExisted && MatchNo = 1
first = 0
last = 59
value = 0

[State 5900, 2 (Reset Float Variables)]
type = VarRangeSet
trigger1 = !RoundsExisted && MatchNo = 1
first = 0
last = 39
fvalue = 0

[State 5900, 3 (To Next State 5901)]
type = ChangeState
trigger1 = 1
value = 5901

;---------------------------------------------------------------------------
; VarRangeSet 將玩家一個連續範圍內的(起作用的,工作中的)變量設置為相同值
; RoundsExisted 返回玩家已經存在過的局數.在第1局,返回0.在Turns模式開場介紹中有用.

; MatchNo 返回當前的match number(比賽號,場次號)
; 在versus模式中當前的比賽號總是1.
; 在arcade模式或Team Arcade模式中,比賽號從1開始,當新場次比賽開始時加1(續關時不會增加).
; 如果你結束了arcade模式重新開始遊戲,比賽號會恢復到1.
;---------------------------------------------------------------------------
