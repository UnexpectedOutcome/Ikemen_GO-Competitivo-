;---------------------------------------------------------------------------
; Super Jump
; 超級跳躍
;---------------------------------------------------------------------------
[Statedef 43]
type = S
movetype = I
physics = S
anim = 40
velset = 0,0
ctrl = 0
facep2 = 1

[State 43, 1]
type = HitBy
trigger1 = 1
value = SCA, NA, SA, HA, AA, NP, SP, HP, AP
time = 1

[State 43, 2 (Jump Sound)]
type = PlaySnd
trigger1 = Time = 0
value = s43,0
channel = 2

[State 43, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 43, 4 (Player Control Forward)]
type = VarSet
triggerall = Time = 0
triggerall = var(59) = 0
trigger1 = P2Dist X >= 0 && Command = "holdfwd"
trigger2 = P2Dist X < 0 && Command = "holdback"
sysvar(1) = 1

[State 43, 5 (Player Control Back)]
type = VarSet
triggerall = Time = 0
triggerall = var(59) = 0
trigger1 = P2Dist X < 0 && Command = "holdfwd"
trigger2 = P2Dist X >= 0 && Command = "holdback"
sysvar(1) = -1

[State 43, 6 (AI Control Forward)]
type = VarSet
triggerall = Time = 0
triggerall = var(59) >= 1
trigger1 = EnemyNear(var(48)),StateType != L || P2BodyDist X >= 180
trigger1 = EnemyNear(var(48)),MoveType = H || Random <= 333 || EnemyNear(var(48)),StateType = L
trigger1 = P2BodyDist X >= 0
sysvar(1) = 1

[State 43, 7 (AI Control Back)]
type = VarSet
triggerall = Time = 0
triggerall = var(59) >= 1
trigger1 = EnemyNear(var(48)),StateType != L
trigger1 = EnemyNear(var(48)),MoveType != H
trigger1 = BackEdgeBodyDist >= 300
trigger1 = Random <= 500 || P2BodyDist X < 0
sysvar(1) = -1

[State 43, 8]
type = Turn
trigger1 = Time = 0
trigger1 = P2Dist X < 0

[State 43, 9]
type = VelSet
trigger1 = AnimTime = 0
x = cond(sysvar(1) = 0,const(velocity.jump.neu.x),cond(sysvar(1) = 1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))
y = const(velocity.jump.y)*1.65

[State 43, 10 (To Next State 50)]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Air Jump Start
; 空中跳躍開始
;---------------------------------------------------------------------------
[Statedef 45]
type = A
movetype = I
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = HitBy
trigger1 = 1
value = SCA, NA, SA, HA, AA, NP, SP, HP, AP
time = 1

[State 45, 2]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 3]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 4]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 5]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 6]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 7]
type = VelSet
trigger1 = Time = 2
x = cond(sysvar(1) = 0,const(velocity.airjump.neu.x),cond(sysvar(1) = 1,const(velocity.airjump.fwd.x),const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 8 (To Next State 50)]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
; 跳起來
;---------------------------------------------------------------------------
[Statedef 50]
type = A
movetype = I
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = cond((vel x) = 0,41,cond((vel x) > 0,42,43))

[State 50, 3]
type = ChangeAnim
triggerall = Time = 0
trigger1 = PrevStateNo = 860 || PrevStateNo = 885
trigger2 = PrevStateNo = 1050
trigger3 = PrevStateNo = 1425
trigger4 = PrevStateNo = 1700
value = 41
elem = 6

[State 50, 4]
type = ChangeAnim
triggerall = Time = 0
trigger1 = PrevStateNo = 2600
trigger2 = PrevStateNo = 2800
trigger3 = PrevStateNo = 3600
value = 41
elem = 7

[State 50, 5]
type = ChangeAnim
triggerall = Time = 0
trigger1 = PrevStateNo = 600
trigger2 = PrevStateNo = 610
trigger3 = PrevStateNo = 640
trigger3 = PrevStateNo = 645
value = 41
elem = 8

[State 50, 6]
type = AfterImage
triggerall = PrevStateNo = 43
trigger1 = Time = 1
time = -1
trans = add
timegap = 1
framegap = 4
length = 10
palcontrast = 128,128,128

[State 50, 7]
type = AfterImageTime
trigger1 = Vel Y >= 0
time = 0
ignorehitpause = 1

[State 50, 8]
type = ChangeAnim
trigger1 = SelfAnimExist(Anim + 3)
trigger1 = Anim >= 41 && Anim <= 43
;trigger1 = Vel Y > Const720p(-8) ;因為沒有Const1080p觸發器，所以改為下方數值(720p轉1080p需要乘以1.5倍)
trigger1 = Vel Y > -12
value = anim+3
persistent = 0

;---------------------------------------------------------------------------
; Jump Down (Empty State for Compatibility)
; 跳完落下 (兼容空狀態)
;---------------------------------------------------------------------------
[Statedef 51]
type = A
movetype = I
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Jump Land
; 跳完落地
;---------------------------------------------------------------------------
[Statedef 52]
type = S
movetype = I
physics = S
velset = 0,0
anim = 47
ctrl = 0

;[State 52, 1]
;type = PlaySnd ;音效改為寫在Statedef -2上
;trigger1 = Time = 0
;value = s47,0

[State 52, 2]
type = VelSet
trigger1 = Abs(Vel X) < Const(Movement.Stand.Friction.Threshold)
x = 0

[State 52, 3]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 5]
type = CtrlSet
trigger1 = Time >= 3
value = 1 

[State 52, 6]
type = HitBy
trigger1 = 1
value = SCA, NA, SA, HA, NP, SP, HP
time = 1

[State 52, 7 (Land Effect)]
type = Explod
trigger1 = Time = 0
anim = 7052
pos = 0,0
facing = facing
bindid = id
bindtime = 1
ownpal = 1
sprpriority = 2
scale = fvar(21)*2.80,fvar(22)*2.80

[State 52, 8 (Moves End)]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Run Forward
; 向前跑
;---------------------------------------------------------------------------
[Statedef 100]
type = S
movetype = I
physics = S
anim = 100
sprpriority = 1
ctrl = 1

[State 100, 1 (AI Ctrl = 0)]
type = CtrlSet
trigger1 = var(59) >= 1
trigger1 = RoundState = 2
value = 0

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = Width
trigger1 = 1
player = 40*(floor(const(size.xscale))),8*(floor(const(size.xscale)))
ignorehitpause = 1

[State 100, 5]
type = VelSet
trigger1 = Time >= 5
x = const(velocity.run.fwd.x)

[State 100, 6]
type = PlaySnd
trigger1 = AnimElem = 2
value = s100,0
loop = 1
channel = 2

[State 100, 7 (Moving Dust 1)]
type = Explod
triggerall = Vel X > 0
trigger1 = GameTime%18 = 1
trigger1 = Anim = 100
anim = 7040
id = 7040
;space = stage
pos = cond(facing = 1,96,-96)*fvar(21),0
facing = facing
bindid = id
bindtime = 1
removetime = 16
scale = fvar(21)*1.00,fvar(22)*1.00
removeongethit = 1
ignorehitpause = 1
sprpriority = 0
shadow = 0,0,0
ownpal = 1

[State 100, 8 (Moving Dust 2)]
type = Explod
triggerall = Vel X > 0
trigger1 = GameTime%16 = 1
trigger1 = Anim = 100
anim = 7040
id = 7040
;space = stage
pos = cond(facing = 1,-214,214)*fvar(21),0
facing = facing
bindid = id
bindtime = 1
removetime = 16
scale = fvar(21)*1.00,fvar(22)*1.00
removeongethit = 1
ignorehitpause = 1
sprpriority = 0
shadow = 0,0,0
ownpal = 1

[State 100, 9]
type = StopSnd
trigger1 = !var(59)
trigger1 = command != "holdfwd"
trigger2 = Anim != 100
channel = 2

[State 100, 10 (Player Run Forward Stop)]
type = ChangeState
trigger1 = var(59) = 0
trigger1 = command != "holdfwd"
value = 103

[State 100, 11 (AI Run Forward Stop)]
type = ChangeState
triggerall = var(59) >= 1
triggerall = Time >= 10
trigger1 = P2bodydist X <= 180
trigger2 = P2bodydist X <= 180-(P2StateNo = [120,159])*20
trigger2 = P2bodydist Y <= -480
trigger3 = InGuardDist
trigger4 = EnemyNear(var(48)),Movetype = A
trigger5 = RoundState != 2
value = 103

;---------------------------------------------------------------------------
; Run Forward 2 + Whirlwind Spear B
; 向前跑2 + 旋風槍B
;---------------------------------------------------------------------------
[Statedef 102]
type = S
movetype = I
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 102, 1]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 102, 2]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 102, 3]
type = Width
trigger1 = 1
player = 40*(floor(const(size.xscale))),8*(floor(const(size.xscale)))
ignorehitpause = 1

[State 102, 4]
type = VelSet
trigger1 = Time >= 5
x = const(velocity.run.fwd.x)

[State 102, 5 (Moving Dust 1)]
type = Explod
triggerall = Vel X > 0
trigger1 = GameTime%18 = 1
trigger1 = Anim = 100
anim = 7040
id = 7040
;space = stage
pos = cond(facing = 1,96,-96)*fvar(21),0
facing = facing
bindid = id
bindtime = 1
removetime = 16
scale = fvar(21)*1.00,fvar(22)*1.00
removeongethit = 1
ignorehitpause = 1
sprpriority = 0
shadow = 0,0,0
ownpal = 1

[State 102, 6 (Moving Dust 2)]
type = Explod
triggerall = Vel X > 0
trigger1 = GameTime%16 = 1
trigger1 = Anim = 100
anim = 7040
id = 7040
;space = stage
pos = cond(facing = 1,-214,214)*fvar(21),0
facing = facing
bindid = id
bindtime = 1
removetime = 16
scale = fvar(21)*1.00,fvar(22)*1.00
removeongethit = 1
ignorehitpause = 1
sprpriority = 0
shadow = 0,0,0
ownpal = 1

[State 102, 7]
type = PlaySnd
trigger1 = AnimElem = 2
value = s100,0
loop = 1
channel = 2

[State 102, 8]
type = StopSnd
trigger1 = Anim != 100
channel = 2

[State 102, 9 (Crouch Cancel)] ;蹲下取消
type = ChangeState
trigger1 = var(59) = 0
trigger1 = Command = "holddown"
value = 10
ctrl = 1

[State 102, 10 (Back Cancel)] ;後退取消
type = ChangeState
trigger1 = var(59) = 0
trigger1 = Command = "holdback"
value = 103
ctrl = 1

[State 102, 11 (Jump Cancel)] ;跳躍取消
type = ChangeState
trigger1 = var(59) = 0
trigger1 = Command = "holdup" || Command = "holdup" && Command = "holdfwd" || Command = "holdup" && Command = "holdback"
value = 40
ctrl = 1

[State 102, 12 (Whirlwind Spear B Player)]
type = ChangeState
triggerall = var(59) = 0
triggerall = P2StateType != L
trigger1 = (P2BodyDist X = [-25,200])
trigger1 = (P2BodyDist Y = [-250,25])
value = 1200

[State 102, 13 (Whirlwind Spear B AI)]
type = ChangeState
triggerall = var(59) >= 1
triggerall = P2StateType != L
trigger1 = (P2BodyDist X = [-25,200])
trigger1 = (P2BodyDist Y = [-250,25])
value = 1200

[State 102, 14 (To Next State 103)]
type = ChangeState
trigger1 = Time >= 3.0*TicksPerSecond || Time >= 180 ;3.0 Second = 180 Ticks
trigger2 = Time >= 0.5*TicksPerSecond || Time >= 30  ;0.5 Second = 30 Ticks
trigger2 = FrontEdgeDist < 300 || FrontEdgeBodyDist < 30
value = 103

; TicksPerSecond說明(跟一般Ticks比較，主要不受遊戲時間和Debug模式的加速功能影響)：
; https://bluesura.github.io/MUGEN/document/Trigger/TicksPerSecond.html
; https://w.atwiki.jp/mugencns/pages/196.html

;---------------------------------------------------------------------------
; Run Forward / Stop
; 向前跑 / 停止
;---------------------------------------------------------------------------
[Statedef 103]
type = S
movetype = I
physics = S
anim = 103
sprpriority = 1
ctrl = 0

[State 103, 1]
type = RemoveExplod
trigger1 = Time = 0
id = 7040

[State 103, 2]
type = VelSet
trigger1 = AnimTime = 0
x = 0

[State 103, 3]
type = PosSet
trigger1 = Time = 0
y = 0

[State 103, 4]
type = HitBy
trigger1 = 1
value = SCA, NA, SA, HA, AA, NP, SP, HP, AP
time = 1

[State 103, 5 (Moving Dust 1)]
type = Explod
trigger1 = Time = 0
anim = 7040
id = 7041
;space = stage
pos = Cond(facing = 1,86,-86)*fvar(21),0
facing = facing
bindid = id
bindtime = -1
removetime = 6
scale = fvar(21)*1.00,fvar(22)*1.00
removeongethit = 1
ignorehitpause = 1
sprpriority = 3
shadow = 0,0,0
ownpal = 1

[State 103, 6]
type = RemoveExplod
trigger1 = AnimTime = 0
id = 7041

[State 103, 7 (Moves End)]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Hop Backwards
; 向後跳
;---------------------------------------------------------------------------
[Statedef 105]
type = S
movetype = I
physics = N
anim = 105
sprpriority = 1
ctrl = 0

[State 105, 1]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn 

[State 105, 2]
type = Gravity
trigger1 = 1
ignorehitpause = 1

[State 105, 3]
type = Width
trigger1 = AnimElemTime(1) >= 0 && AnimElemTime(5) < 0
player = 0,50*(floor(const(size.xscale)))
ignorehitpause = 1

[State 105, 4 (Jump Sound)]
type = PlaySnd
trigger1 = Time = 0
value = s40,0
channel = 2

[State 105, 5]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)*1.5

[State 105, 6]
type = StateTypeSet
trigger1 = Time >= 2
statetype = A
ignorehitpause = 1

[State 105, 7]
type = NotHitBy
trigger1 = Time < 5
value = SCA, AA, AP, AT
time = 1

[State 105, 8]
type = HitBy
trigger1 = Time >= 5
value = SCA, NA, SA, HA, AA, NP, SP, HP, AP
time = 1

[State 105, 9 (To Next State 106)]
type = ChangeState
trigger1 = Time >= 3
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 106
ctrl = 0

;---------------------------------------------------------------------------
; Hop Backwards / Stop
; 向後跳 / 停止
;---------------------------------------------------------------------------
[Statedef 106]
type = S
movetype = I
physics = S
ctrl = 0
anim = 106

[State 106, 1]
type = VelSet
trigger1 = 1
x = 0

[State 106, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 106, 3]
type = PosSet
trigger1 = Time = 0
y = 0

;[State 106, 4]
;type = PlaySnd ;音效改為寫在Statedef -2上
;trigger1 = Time = 0
;value = s47,0

[State 106, 5]
type = Explod
trigger1 = Time = 0
anim = 7052
pos = 0,0
facing = facing
bindid = id
bindtime = 1
ownpal = 1
sprpriority = -3
scale = fvar(21)*2.80,fvar(22)*2.80

[State 106, 6 (Moves End)]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Forward Dash / Air
; 向前衝刺 / 空中
;---------------------------------------------------------------------------
[Statedef 110]
type = A
movetype = I
physics = N
anim = 110
velset = 0,0
sprpriority = 1
ctrl = 0

[State 110, 1]
type = NotHitBy
trigger1 = Time = 0
value = SCA, AA, AP, AT
time = 5

[State 110, 2]
type = Width
trigger1 = AnimElemTime(2) >= 0
player = 92*(floor(const(size.xscale))),41*(floor(const(size.xscale)))
ignorehitpause = 1

[State 110, 3]
type = VelSet
trigger1 = AnimElem = 2
x = 60
y = 0

[State 110, 4]
type = PlaySnd
trigger1 = AnimElem = 2
value = s110,0
channel = 2

[State 110, 5 (Air Forward Dash Effect 1)]
type = Explod
trigger1 = AnimElem = 2
anim = 7100
ID = 7100
pos = pos x+camerapos x*fvar(21),pos y-300*fvar(22)
scale = fvar(21)*1.25,fvar(22)*1.25
vel = cond(facing = 1,-10,10),0
accel = -1,0
facing = facing
ownpal = 1
remappal = 7100,0
sprpriority = 4

[State 110, 6 (Air Forward Dash Effect 2)]
type = Explod
trigger1 = AnimElem = 2
trigger2 = AnimElem = 3
anim = 7101
ID = 7101
pos = pos x+camerapos x*fvar(21),pos y-300*fvar(22)
scale = fvar(21)*1.25,fvar(22)*1.25
vel = cond(facing = 1,-10,10),0
accel = -1,0
facing = facing
ownpal = 1
remappal = 7100,0
sprpriority = 4

[State 110, 7 (Air Forward Dash Effect 3)]
type = Explod
trigger1 = AnimElem = 2
trigger2 = AnimElem = 3
anim = 7102
ID = 7102
pos = pos x+camerapos x*fvar(21),pos y-300*fvar(22)
scale = fvar(21)*1.25,fvar(22)*1.25
vel = cond(facing = 1,-10,10),0
accel = -1,0
facing = facing
ownpal = 1
remappal = 7100,0
sprpriority = -1

[State 110, 8]
type = Explod
trigger1 = AnimElem = 3
anim = 7103
ID = 7103
pos = pos x+camerapos x*fvar(21),pos y-300*fvar(22)
scale = fvar(21)*1.75,fvar(22)*1.75
facing = facing
ownpal = 1
remappal = 7100,0
sprpriority = 4

[State 110, 9]
type = Explod
trigger1 = AnimElem = 3
anim = 7104
ID = 7104
pos = pos x+camerapos x*fvar(21),pos y-300*fvar(22)
scale = fvar(21)*1.75,fvar(22)*1.75
facing = facing
ownpal = 1
remappal = 7100,0
sprpriority = -1

[State 110, 10 (To Next State 52)]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 52
ctrl = 1

[State 110, 11 (To Next State 111)]
type = ChangeState
trigger1 = AnimTime = 0
value = 111

;---------------------------------------------------------------------------
; Forward Dash / Air End
; 向前衝刺 / 空中結束
;---------------------------------------------------------------------------
[Statedef 111]
type = A
movetype = I
physics = A
anim = 111
sprpriority = 1
ctrl = 0

[State 111, 1]
type = VelMul
trigger1 = Time = 0
x = 0.25

[State 111, 2]
type = StopSnd
trigger1 = Pos Y >= 0 && Vel Y > 0
channel = 2

[State 111, 3 (To Next State 52)]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 52
ctrl = 1

;---------------------------------------------------------------------------
; Back Dash / Air
; 向後衝刺 / 空中
;---------------------------------------------------------------------------
[Statedef 115]
type = A
movetype = I
physics = N
sprpriority = 1
anim = 115
ctrl = 0

[State 115, 1]
type = NotHitBy
trigger1 = Time = 0
value = SCA, AA, AP, AT
time = 6

[State 115, 2]
type = VelSet
trigger1 = Time = 0
x = -45
y = 0

[State 115, 3]
type = PlaySnd
trigger1 = !Time
value = s115,0
channel = 2

[State 115, 4]
type = Width
trigger1 = AnimElemTime(1) >= 0 && AnimElemTime(5) < 0
player = 0,51*(floor(const(size.xscale)))
ignorehitpause = 1

[State 115, 4 (Air Back Dash Effect 1)]
type = Explod
trigger1 = AnimElem = 1
anim = 7103
ID = 7103
pos = (pos x+camerapos x)+(cond(facing = 1,20,-20))*fvar(21),pos y-360*fvar(22)
scale = fvar(21)*2.00,fvar(22)*2.00
ownpal = 1
remappal = 7100,0
facing = -facing
sprpriority = 4

[State 115, 5 (Air Back Dash Effect 2)]
type = Explod
trigger1 = AnimElem = 1
anim = 7104
ID = 7104
pos = (pos x+camerapos x)+(cond(facing = 1,20,-20))*fvar(21),pos y-360*fvar(22)
scale = fvar(21)*2.00,fvar(22)*2.00
ownpal = 1
remappal = 7100,0
facing = -facing
sprpriority = -1

[State 115, 6 (To Next State 52)]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 52
ctrl = 1

[State 115, 7 (To Next State 116)]
type = ChangeState
trigger1 = AnimTime = 0
value = 116
ctrl = 0

;---------------------------------------------------------------------------
; Back Dash / Air End
; 向後衝刺 / 空中結束
;---------------------------------------------------------------------------
[Statedef 116]
type = A
movetype = I
physics = A
anim = 116
sprpriority = 1
ctrl = 0

[State 116, 1]
type = VelMul
trigger1 = Time = 0
x = 0.50

[State 116, 2]
type = StopSnd
trigger1 = Pos Y >= 0 && Vel Y > 0
channel = 2

[State 116, 3 (To Next State 52)]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 52
ctrl = 1

;---------------------------------------------------------------------------
; Guard Start
; 防禦開始
;---------------------------------------------------------------------------
[Statedef 120]
type = U
movetype = I
physics = U

[State 120, 1 (AI Ctrl = 0)]
type = CtrlSet
trigger1 = var(59) >= 1
value = 0
ignorehitpause = 1

[State 120, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (StateType = C) + (StateType = A)*2

[State 120, 3]
type = StateTypeSet
trigger1 = (Time = 0) && (StateType = S)
physics = S

[State 120, 4]
type = StateTypeSet
trigger1 = (Time = 0) && (StateType = C)
physics = C

[State 120, 5]
type = StateTypeSet
trigger1 = (Time = 0) && (StateType = A)
physics = A

[State 120, 6 (Hi to Lo AI Off)]
type = StateTypeSet
triggerall = StateType = S ;自身站立中
trigger1 = var(59) = 0 ;AI未啟動
trigger1 = Command = "holddown" ;指令按住下
statetype = C ;切換到蹲下狀態
physics = C

[State 120, 7 (AI Turn)]
type = Turn
trigger1 = var(59) >= 1 && !Ctrl && P2Dist X < 0 && (Anim = 120 || Anim = 121)

[State 120, 8 (Hi to Lo AI On)]
type = StateTypeSet
triggerall = StateType != A
triggerall = var(59) >= 1 ;AI啟動
triggerall = EnemyNear(var(48)),StateNo != var(2)
triggerall = EnemyNear(var(48)),StateNo != var(3)
triggerall = EnemyNear(var(48)),StateNo != var(4)
trigger1 = EnemyNear(var(48)),StateType = C
trigger2 = Cond((var(5)!= 0),(EnemyNear(var(48)),StateNo = var(5)),0)
trigger3 = Cond((var(6)!= 0),(EnemyNear(var(48)),StateNo = var(6)),0)
trigger4 = Cond((var(1)!= 0),(EnemyNear(var(48)),StateNo = var(1)),0)
statetype = C ;切換到蹲下狀態
physics = C

[State 120, 9 (Lo to Hi AI Off)]
type = StateTypeSet
triggerall = StateType = C ;自身蹲下中
trigger1 = var(59) = 0 ;AI未啟動
trigger1 = Command != "holddown" ;指令不能是按住下
statetype = S ;切換到站立狀態
physics = S

[State 120, 10 (Lo to Hi AI On)]
type = StateTypeSet
triggerall = StateType != A
triggerall = var(59) >= 1 ;AI啟動
triggerall = EnemyNear(var(48)),StateNo != var(5)
triggerall = EnemyNear(var(48)),StateNo != var(6)
triggerall = EnemyNear(var(48)),StateNo != var(1)
trigger1 = EnemyNear(var(48)),StateType = S
trigger2 = Cond((var(2)!= 0),(EnemyNear(var(48)),StateNo = var(2)),0)
trigger3 = Cond((var(3)!= 0),(EnemyNear(var(48)),StateNo = var(3)),0)
trigger4 = Cond((var(4)!= 0),(EnemyNear(var(48)),StateNo = var(4)),0)
statetype = S ;切換到站立狀態
physics = S

[State 120, 11]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, 12 (Player Stop Guarding)]
type = ChangeState
triggerall = var(59) = 0
trigger1 = Command != "holdback"
trigger2 = !InGuardDist
value = 140

[State 120, 13 (AI Stop Guarding)]
type = ChangeState
triggerall = var(59) >= 1
trigger1 = !InGuardDist || EnemyNear(var(48)),HitDefAttr = SCA, NT, ST, HT, AT
value = 140

; 防禦時狀態定義進行的流程 可以Ctrl+D鍵開啟Debug模式 觀看StateNo狀態數值的變化

;---------------------------------------------------------------------------
; Stand Guarding
; 站立防禦時
;---------------------------------------------------------------------------
[Statedef 130]
type = S
movetype = I
physics = S

[State 130, 1]
type = ChangeState
trigger1 = var(59) >= 1 && !Ctrl && P2Dist X < 0
value = 120

[State 130, 2]
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 130, 3 (Hi to Lo AI Off)]
type = ChangeState
triggerall = var(59) = 0
trigger1 = Command = "holddown"
value = 131

[State 130, 4 (Hi to Lo AI On)]
type = StateTypeSet
triggerall = StateType != A
triggerall = var(59) >= 1
triggerall = EnemyNear(var(48)),StateNo != var(2)
triggerall = EnemyNear(var(48)),StateNo != var(3)
triggerall = EnemyNear(var(48)),StateNo != var(4)
trigger1 = EnemyNear(var(48)),StateType = C
trigger2 = Cond((var(5)!= 0),(EnemyNear(var(48)),StateNo = var(5)),0)
trigger3 = Cond((var(6)!= 0),(EnemyNear(var(48)),StateNo = var(6)),0)
trigger4 = Cond((var(1)!= 0),(EnemyNear(var(48)),StateNo = var(1)),0)
statetype = C
physics = C

[State 130, 5 (Lo to Hi AI On)]
type = StateTypeSet
triggerall = StateType != A
triggerall = var(59) >= 1
triggerall = EnemyNear(var(48)),StateNo != var(5)
triggerall = EnemyNear(var(48)),StateNo != var(6)
triggerall = EnemyNear(var(48)),StateNo != var(1)
trigger1 = EnemyNear(var(48)),StateType = S
trigger2 = Cond((var(2)!= 0),(EnemyNear(var(48)),StateNo = var(2)),0)
trigger3 = Cond((var(3)!= 0),(EnemyNear(var(48)),StateNo = var(3)),0)
trigger4 = Cond((var(4)!= 0),(EnemyNear(var(48)),StateNo = var(4)),0)
statetype = S
physics = S

[State 130, 6 (Player Stop Guarding)]
type = ChangeState
triggerall = var(59) = 0
trigger1 = Command != "holdback"
trigger2 = !InGuardDist
value = 140

[State 130, 7 (AI Stop Guarding)]
type = ChangeState
triggerall = var(59) >= 1
trigger1 = !InGuardDist || EnemyNear(var(48)),HitDefAttr = SCA, NT, ST, HT, AT
value = 140

;---------------------------------------------------------------------------
; Crouch Guarding
; 蹲下防禦時
;---------------------------------------------------------------------------
[Statedef 131]
type = C
movetype = I
physics = C

[State 131, 1]
type = ChangeState
trigger1 = var(59) >= 1 && !Ctrl && P2Dist X < 0
value = 120

[State 131, 2]
type = ChangeAnim
trigger1 = Anim != 131
value = 131

[State 131, 3 (Lo to Hi AI Off)]
type = ChangeState
triggerall = var(59) = 0
trigger1 = Command != "holddown"
value = 130

[State 131, 4]
type = VarSet
triggerall = var(59) >= 1
trigger1 = EnemyNear(var(48)),StateNo != var(2)
trigger1 = EnemyNear(var(48)),StateNo != var(3)
trigger1 = EnemyNear(var(48)),StateNo != var(4)
trigger1 = EnemyNear(var(48)),StateType = C
trigger2 = Cond((var(5)!= 0),(EnemyNear(var(48)),StateNo = var(5)),0)
trigger3 = Cond((var(6)!= 0),(EnemyNear(var(48)),StateNo = var(6)),0)
trigger4 = Cond((var(1)!= 0),(EnemyNear(var(48)),StateNo = var(1)),0)
var(0) = var(0)+1

[State 131, 5]
type = ChangeState
triggerall = var(0) < 500
triggerall = var(59) >= 1
trigger1 = EnemyNear(var(48)),StateNo != var(2)
trigger1 = EnemyNear(var(48)),StateNo != var(3)
trigger1 = EnemyNear(var(48)),StateNo != var(4)
trigger1 = EnemyNear(var(48)),StateType = C
trigger2 = Cond((var(5)!= 0),(EnemyNear(var(48)),StateNo = var(5)),0)
trigger3 = Cond((var(6)!= 0),(EnemyNear(var(48)),StateNo = var(6)),0)
trigger4 = Cond((var(1)!= 0),(EnemyNear(var(48)),StateNo = var(1)),0)
value = 131

[State 131, 6 (Player Stop Guarding)]
type = ChangeState
triggerall = var(59) = 0
trigger1 = Command != "holdback"
trigger2 = !InGuardDist
value = 140

[State 131, 7 (AI Stop Guarding)]
type = ChangeState
triggerall = var(59) >= 1
trigger1 = !InGuardDist || EnemyNear(var(48)),HitDefAttr = SCA, NT, ST, HT, AT
value = 140

;---------------------------------------------------------------------------
; Air Guarding
; 空中防禦時
;---------------------------------------------------------------------------
[Statedef 132]
type = A
movetype = I
physics = N

[State 132, 1]
type = ChangeAnim
trigger1 = Anim != 132
value = 132

[State 132, 2]
type = VelAdd
trigger1 = 1
y = const(movement.yaccel)

[State 132, 3]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, 6]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = Command = "holdback" && var(59) = 0 || var(59) >= 1
trigger1 = InGuardDist
value = 130

[State 132, 7]
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 132, 8 (Player Stop Guarding)]
type = ChangeState
triggerall = var(59) = 0
trigger1 = Command != "holdback"
trigger2 = !InGuardDist
value = 140

;---------------------------------------------------------------------------
; Guard End
; 防禦結束
;---------------------------------------------------------------------------
[Statedef 140]
type = U
movetype = I
physics = U
ctrl = 1

[State 140, 1 (AI Turn)]
type = ChangeState
trigger1 = var(59) >= 1 && P2Dist X < 0 && StateType != A
value = 21
ctrl = 1

[State 140, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 140 + (StateType = C) + (StateType = A)*2

[State 140, 3]
type = StateTypeSet
trigger1 = (Time = 0) && (StateType = S)
physics = S

[State 140, 4]
type = StateTypeSet
trigger1 = (Time = 0) && (StateType = C)
physics = C

[State 140, 5]
type = StateTypeSet
trigger1 = (Time = 0) && (StateType = A)
physics = A

[State 140, 6 (Hi to Lo AI Off)]
type = StateTypeSet
triggerall = StateType = S 
trigger1 = var(59) = 0
trigger1 = Command = "holddown"
statetype = C 
physics = C

[State 140, 7 (Hi to Lo AI On)]
type = StateTypeSet
triggerall = StateType != A
triggerall = var(59) >= 1
trigger1 = EnemyNear(var(48)),StateNo != var(2)
trigger1 = EnemyNear(var(48)),StateNo != var(3)
trigger1 = EnemyNear(var(48)),StateNo != var(4)
trigger1 = EnemyNear(var(48)),StateType = C
trigger2 = Cond((var(5)!= 0),(EnemyNear(var(48)),StateNo = var(5)),0)
trigger3 = Cond((var(6)!= 0),(EnemyNear(var(48)),StateNo = var(6)),0)
trigger4 = Cond((var(1)!= 0),(EnemyNear(var(48)),StateNo = var(1)),0)
statetype = C
physics = C

[State 140, 8 (Lo to Hi AI Off)]
type = StateTypeSet
triggerall = StateType = C
trigger1 = var(59) = 0
trigger1 = Command != "holddown"
statetype = S
physics = S

[State 140, 9 (Lo to Hi AI On)]
type = StateTypeSet
triggerall = StateType != A
triggerall = var(59) >= 1
trigger1 = EnemyNear(var(48)),StateNo != var(5)
trigger1 = EnemyNear(var(48)),StateNo != var(6)
trigger1 = EnemyNear(var(48)),StateNo != var(1)
trigger1 = EnemyNear(var(48)),StateType = S
trigger2 = Cond((var(2)!= 0),(EnemyNear(var(48)),StateNo = var(2)),0)
trigger3 = Cond((var(3)!= 0),(EnemyNear(var(48)),StateNo = var(3)),0)
trigger4 = Cond((var(4)!= 0),(EnemyNear(var(48)),StateNo = var(4)),0)
statetype = S
physics = S

