; Tripped Get-Hit / Knocked Away
; 絆倒受擊 / 擊倒
;---------------------------------------------------------------------------
[Statedef 5071]
type = A
movetype = H
physics = N

[State 5071, 1]
type = VelSet ;HitVelSet
trigger1 = Time = 0
x = gethitvar(xvel)*facing
y = gethitvar(yvel)

[State 5071, 2] ;Acceleration
type = VelAdd
trigger1 = 1
y = gethitvar(yaccel)

[State 5071, 3] ;Hit Ground
