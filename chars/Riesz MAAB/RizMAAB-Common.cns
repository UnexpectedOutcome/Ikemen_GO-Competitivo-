;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 通常動作ステート ‖ 一般動作定義
; Common State
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝

; 因為人物DEF檔localcoord使用1920x1080參數 不推薦直接使用系統公用狀態的common1.cns檔
; 因為MUGEN 1.1和包含之前的系統沒有Const1080p觸發器 (只有Const240p, Const480p & Const720p)
; 有可能造成數值轉換的錯誤(特別是人物XY方向移動這部份)

; 而是將系統的common1.cns檔複製 貼上到人物的資料夾裡
; 再改變檔案名稱(例如改為RizMAAB-Common.cns) 將其成為人物私人的Common.cns檔案
; 之後開始檢查Const720p觸發器的數值，如果確定這個參數跟人物的XY方向移動有關再修改

; 數值修改參考：例如Const720p(4)改為6數值(因為720*1.5 = 1080, 4*1.5 = 6)

; 會這樣做是因為……不確定Const720p括號中的數值會自動轉換成1080p人物的數值

; 參數跟人物的XY方向移動無關的話則保留原數值刪除Const720p的部份

;---------------------------------------------------------------------------
; Stand
; 站立
;---------------------------------------------------------------------------
[Statedef 0]
type = S
movetype = I
physics = S
sprpriority = 0
;ctrl = ;*

;*此參數將設置P1是否受控制 0表示不受控制 1表示受控制
; 若缺省 P1的控制狀態將保持上一狀態不變

[State 0, 1] ;刪除人物角色多餘分身
type = DestroySelf
trigger1 = IsHelper

[State 0, 2]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 3]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 4] ;Stop moving if low velocity or 1 ticks pass
type = VelSet
trigger1 = Abs(Vel X) < Const(Movement.Stand.Friction.Threshold)
trigger2 = Time = 1 ;4
x = 0

[State 0, 5] ;Are you dead?
type = ChangeState
trigger1 = !Alive
value = 5050
ctrl = 0

;---------------------------------------------------------------------------
; Stand to Crouch
; 站立到蹲下
;---------------------------------------------------------------------------
[Statedef 10]
type = C
movetype = I
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = 0.75

[State 10, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = Abs(Vel X) < Const(Movement.Crouch.Friction.Threshold)
x = 0

[State 10, 3 (To Next State 11)]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
; 蹲下中
;---------------------------------------------------------------------------
[Statedef 11]
type = C
movetype = I
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = Abs(Vel X) < Const(Movement.Crouch.Friction.Threshold)
x = 0

;---------------------------------------------------------------------------
; Crouch to Stand
; 蹲下到站立
;---------------------------------------------------------------------------
[Statedef 12]
type = S
movetype = I
physics = S
anim = 12

[State 12, 1 (Moves End)]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk (Forward) / AI Control Only
; 步行(前) / 電腦操控專用
;---------------------------------------------------------------------------
[Statedef 19]
type = S
movetype = I
physics = S
sprpriority = 0
ctrl = 0

[State 19, 1]
type = Turn
trigger1 = P2Dist X < 0

[State 19, 2]
type = VelSet
trigger1 = 1 ;代表一直觸發
x = const(velocity.walk.fwd.x)

[State 19, 3]
type = VelSet
trigger1 = 0 ;代表一直不觸發
x = const(velocity.walk.back.x)

[State 19, 4]
type = ChangeAnim
triggerall = Vel X > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 19, 5]
type = ChangeAnim
triggerall = Vel X < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 19, 6 (Moves End)]
type = ChangeState
trigger1 = RoundState != [2,3]
trigger2 = P2BodyDist X <= 30
trigger3 = InGuardDist
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Walk / Player Control Only
; 步行 / 玩家操控專用
;---------------------------------------------------------------------------
[Statedef 20]
type = S
movetype = I
physics = S
sprpriority = 0
ctrl = 1

[State 20, 1]
type = VelSet
trigger1 = !var(59)
trigger1 = Command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = !var(59)
trigger1 = Command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = Vel X > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = Vel X < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Walk (Back) / AI Control Only
; 步行(後) / 電腦操控專用
;---------------------------------------------------------------------------
[Statedef 21]
type = S
movetype = I
physics = S
sprpriority = 0
ctrl = 0

[State 21, 1]
type = Turn
trigger1 = P2Dist X < 0

[State 21, 2]
type = VelSet
trigger1 = 0 ;代表一直不觸發
x = const(velocity.walk.fwd.x)

[State 21, 3]
type = VelSet
trigger1 = 1 ;代表一直觸發
x = const(velocity.walk.back.x)

[State 21, 4]
type = ChangeAnim
triggerall = Vel X > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 21, 5]
type = ChangeAnim
triggerall = Vel X < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 21, 6 (Moves End)]
type = ChangeState
trigger1 = RoundState != [2,3]
trigger2 = P2BodyDist X >= 1800
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Jump (Forward) / AI Control Only
; 跳躍(前) / 電腦操控專用
;---------------------------------------------------------------------------
[Statedef 39]
type = S
movetype = I
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 39, 1] ;投擲技無效
type = HitBy
trigger1 = 1
value = SCA, NA, SA, HA, AA, NP, SP, HP, AP
time = 1

[State 39, 2 (Jump Sound)]
type = PlaySnd
trigger1 = Time = 0
value = s40,0
channel = 2

[State 39, 3]
type = VarSet
trigger1 = 1
sysvar(1) = 1

[State 39, 4]
type = VelSet
trigger1 = AnimTime = 0
x = const(velocity.jump.fwd.x)
y = const(velocity.jump.y)

[State 39, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = PrevStateNo = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 39, 6 (To Next State 50)]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Start / Player Control Only
; 跳躍開始 / 玩家操控專用
;---------------------------------------------------------------------------
[Statedef 40]
type = S
movetype = I
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 40, 1]
type = HitBy
trigger1 = 1
value = SCA, NA, SA, HA, AA, NP, SP, HP, AP
time = 1

[State 40, 2 (Jump Sound)]
type = PlaySnd
trigger1 = Time = 0
value = s40,0
channel = 2

[State 40, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 4]
type = VarSet
triggerall = Time = 0
trigger1 = P2Dist X >= 0 && Command = "holdfwd"
trigger2 = P2Dist X < 0 && Command = "holdback"
sysvar(1) = 1

[State 40, 5]
type = VarSet
triggerall = Time = 0
trigger1 = P2Dist X < 0 && Command = "holdfwd"
trigger2 = P2Dist X >= 0 && Command = "holdback"
sysvar(1) = -1

[State 40, 6]
type = Turn
trigger1 = Time = 0
trigger1 = P2Dist X < 0

[State 40, 7]
type = VelSet
trigger1 = AnimTime = 0
x = cond(sysvar(1) = 0,const(velocity.jump.neu.x),cond(sysvar(1) = 1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 8 (To Next State 50)]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

