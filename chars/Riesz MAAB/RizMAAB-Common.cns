;---------------------------------------------------------------------------
; Stand Guarding (Hit Shake)
; 站立防禦時 (打擊晃動)
;---------------------------------------------------------------------------
[Statedef 150]
type = S
movetype = H
physics = N
velset = 0,0

[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150

[State 150, 2]
type = ChangeState
trigger1 = var(59) = 0 && HitShakeOver
value = 151 + 2*(command = "holddown")

[State 150, 3]
type = ChangeState
trigger1 = var(59) >= 1 && HitShakeOver
value = 151

[State 150, 4 (Hi to Lo AI Off)]
type = StateTypeSet
triggerall = StateType = S 
trigger1 = var(59) = 0
trigger1 = Command = "holddown"
statetype = C 
physics = C

[State 150, 5 (Hi to Lo AI On)]
type = StateTypeSet
triggerall = var(59) >= 1
trigger1 = EnemyNear(var(48)),StateNo != var(2)
trigger1 = EnemyNear(var(48)),StateNo != var(3)
trigger1 = EnemyNear(var(48)),StateNo != var(4)
trigger1 = EnemyNear(var(48)),StateType = C
trigger2 = Cond((var(5)!= 0),(EnemyNear(var(48)),StateNo = var(5)),0)
trigger3 = Cond((var(6)!= 0),(EnemyNear(var(48)),StateNo = var(6)),0)
trigger4 = Cond((var(1)!= 0),(EnemyNear(var(48)),StateNo = var(1)),0)
statetype = C
physics = C

[State 150, 6 (Lo to Hi AI Off)]
type = StateTypeSet
triggerall = StateType = C
trigger1 = var(59) = 0
trigger1 = Command != "holddown"
statetype = S
physics = S

[State 150, 7 (Lo to Hi AI On)]
type = StateTypeSet
triggerall = var(59) >= 1
trigger1 = EnemyNear(var(48)),StateNo != var(5)
trigger1 = EnemyNear(var(48)),StateNo != var(6)
trigger1 = EnemyNear(var(48)),StateNo != var(1)
trigger1 = EnemyNear(var(48)),StateType = S || EnemyNear(var(48)),StateType = A
trigger2 = Cond((var(2)!= 0),(EnemyNear(var(48)),StateNo = var(2)),0)
trigger3 = Cond((var(3)!= 0),(EnemyNear(var(48)),StateNo = var(3)),0)
trigger4 = Cond((var(4)!= 0),(EnemyNear(var(48)),StateNo = var(4)),0)
statetype = S
physics = S

[State 150, 8]
type = ForceFeedback
trigger1 = Time = 0
waveform = square
time = 3

;---------------------------------------------------------------------------
; Stand Guarding (Slide Knocked Back)
; 站立防禦時 (滑動擊退)
;---------------------------------------------------------------------------
[Statedef 151]
type = S
movetype = H
physics = S
anim = 150

[State 151, 1]
type = VelSet ;HitVelSet
trigger1 = Time = 0
x = gethitvar(xvel)*facing

[State 151, 2]
type = VelSet
trigger1 = Time = GetHitVar(SlideTime)
trigger2 = HitOver
x = 0

[State 151, 3]
type = CtrlSet
trigger1 = Time = GetHitVar(CtrlTime)
value = 1

[State 151, 4 (Hi to Lo AI Off)]
type = StateTypeSet
triggerall = StateType = S 
trigger1 = var(59) = 0
trigger1 = Command = "holddown"
statetype = C 
