;---------------------------------------------------------------------------
; Downed Get-Hit / Shaking
; 倒下受擊 / 身體晃動
;---------------------------------------------------------------------------
[Statedef 5080]
type = L
movetype = H
physics = N
velset = 0,0

[State 5080, 1] ;Set Default Anim
type = VarSet
trigger1 = Time = 0
sysvar(2) = cond(gethitvar(yvel) = 0,5080,5090)

[State 5080, 2]
type = VarAdd
trigger1 = Time = 0
trigger1 = (Anim = [5081,5089]) || (Anim = [5111,5119])
trigger1 = SelfAnimExist(sysvar(2) + (Anim%10))
sysvar(2) = anim%10

[State 5080, 3] ;If 5090 Doesn't Exist, Default to 5030
type = VarSet
trigger1 = Time = 0
trigger1 = sysvar(2) = 5090
trigger1 = !SelfAnimExist(5090)
sysvar(2) = 5030

[State 5080, 4] ;Freeze
type = ChangeAnim
trigger1 = 1
value = sysvar(2)

[State 5080, 5]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(YVel) = 0
value = 5081 ;Downed Get Hit (Knocked Back)

[State 5080, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(YVel) != 0
value = 5030 ;Air Get Hit (Knocked Away)

;---------------------------------------------------------------------------
; Downed Get-Hit / Knocked Back
; 倒下受擊 / 擊退
;---------------------------------------------------------------------------
[Statedef 5081]
type = L
movetype = H
physics = C

[State 5081, 1]
type = VelSet ;HitVelSet
trigger1 = Time = 0
x = gethitvar(xvel)*facing

[State 5081, 2]
type = VelSet
trigger1 = HitOver
x = 0

[State 5081, 3] ;Don't Show Hit Ground Frame
type = VarSet
trigger1 = Time = 0
sysvar(0) = 1

[State 5081, 4]
type = ChangeState
trigger1 = HitOver
value = 5110 ;Downed Get Hit (Lying Down)

;---------------------------------------------------------------------------
; Downed Get-Hit / Hit Ground from Fall
; 倒下受擊 / 從落下狀態觸地
;---------------------------------------------------------------------------
[Statedef 5100]
type = L
movetype = H
physics = N

[State 5100, 1 (2004.04.14 Behavior)] ;2004.04.14行為 (代表人物在舊版WinMUGEN版本的行為)
type = Null;VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(Fall.YVel) = 0
trigger1 = Vel X < -1
x = -1

[State 5100, 2 (EnvShake)]
type = FallEnvShake
trigger1 = Time = 0

[State 5100, 3] ;Save Fall Velocity
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

[State 5100, 4] ;Hit Ground Anim (Normal)
type = ChangeAnim
triggerall = Time = 0
trigger1 = (Anim != [5051,5059]) && (Anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (Anim % 10))
value = 5100

[State 5100, 5] ;Hit Ground Anim (For Hit Up)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (Anim = [5051,5059]) || (Anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (Anim % 10))
value = 5100 + (anim % 10)

[State 5100, 6]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5100, 7]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5100, 8] ;Reduce Speed
type = VelMul
trigger1 = Time = 0
x = 0.75

[State 5100, 9]
type = ChangeState
trigger1 = Time = 0
trigger1 = GetHitVar(Fall.YVel) = 0
value = 5110 ;Downed Get Hit (Lying Down)

[State 5100, 10]
type = Explod
trigger1 = Time = 1
;anim = f(60+(sysvar(1) > const720p(20))+(sysvar(1) > const720p(56)))
anim = f(60+(sysvar(1) > 20)+(sysvar(1) > 56)) ;因為參數20、56跟人物的XY方向移動無關(保留原數值刪除Const720p的部份)。
;postype = none
pos = pos x +camerapos x,0
facing = facing
;sprpriority = cond(sysvar(1) <= const720p(56),-10,10)
sprpriority = cond(sysvar(1) <= 56,-10,10) ;因為參數56跟人物的XY方向移動無關(保留原數值刪除Const720p的部份)。

[State 5100, 11]
type = HitFallDamage
trigger1 = Time = 3

[State 5100, 12]
type = PlaySnd
trigger1 = Time = 1
value = s5100,0

[State 5100, 13]
type = PosFreeze
trigger1 = 1

[State 5100, 14]
type = ChangeState
trigger1 = AnimTime = 0
value = 5101 ;Downed Get Hit (Bounce Off Ground)

[State 5100, 15]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-0.2,0.005
time = 20

;---------------------------------------------------------------------------
; Downed Get-Hit / Bounce Off Ground
; 擊落受擊 / 地面反彈離地
;---------------------------------------------------------------------------
[Statedef 5101]
type = L
movetype = H
physics = N

[State 5101, 1] ;Coming Hit Ground Anim (Normal)
type = ChangeAnim
triggerall = Time = 0
trigger1 = Anim != [5101,5109]
trigger2 = !SelfAnimExist(5160 + (Anim % 10))
value = 5160

[State 5101, 2] ;Coming Hit Ground Anim (for Hit Up)
type = ChangeAnim
triggerall = Time = 0
trigger1 = Anim = [5101,5109]
trigger1 = SelfAnimExist(5160 + (Anim % 10))
value = 5160 + (anim % 10)

[State 5101, 3]
type = HitFallVel
trigger1 = Time = 0

[State 5101, 4]
type = PosSet
trigger1 = Time = 0
y = const(movement.down.bounce.offset.y)

[State 5101, 5]
type = PosAdd
trigger1 = Time = 0
x = const(movement.down.bounce.offset.x)

[State 5101, 6] ;Acceleration
type = VelAdd
trigger1 = 1
y = const(movement.down.bounce.yaccel)

[State 5101, 7] ;Hit Ground
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= Const(Movement.Down.Bounce.GroundLevel)
value = 5110

;---------------------------------------------------------------------------
; Downed Get-Hit / Lying Down
; 擊落受擊 / 躺著
;---------------------------------------------------------------------------
[Statedef 5110]
type = L
movetype = H
physics = N

[State 5110, 1]
type = FallEnvShake
trigger1 = Time = 0

[State 5110, 2]
type = ChangeAnim
trigger1 = SelfAnimExist(5115)
trigger1 = Anim = 5070 || Anim = 5902
value = 5115
persistent = 0

[State 5110, 3] ;For Hit Up/Up Diag Type (from State 5081)
type = ChangeAnim
trigger1 = SelfAnimExist(5110 + (Anim % 10))
trigger1 = Anim = [5081,5089]
value = 5110 + (anim % 10)
persistent = 0

[State 5110, 4] ;Hit Ground Anim (Normal)
type = ChangeAnim
triggerall = Time = 0
triggerall = Anim != [5110,5119] ;Not Already Changed Anim
trigger1 = Anim != [5161,5169]
trigger2 = !SelfAnimExist(5170 + (Anim % 10))
value = 5170

[State 5110, 5] ;Hit ground Anim (for hit up)
type = ChangeAnim
triggerall = Time = 0
triggerall = Anim != [5110,5119] ;Not Already Changed Anim
trigger1 = Anim = [5161,5169]
trigger1 = SelfAnimExist(5170 + (Anim % 10))
value = 5170 + (anim % 10)

[State 5110, 6]
type = ChangeState
trigger1 = var(53) = 1 ;復活
trigger1 = Alive
trigger1 = Anim != 5115
trigger1 = AnimTime = 0
value = 3990

[State 5110, 7]
type = ChangeState
trigger1 = var(53) = 1 ;復活
trigger1 = Alive
trigger1 = Anim = 5115
trigger1 = AnimTime = 0
value = 3991

[State 5110, 8]
type = HitFallDamage
trigger1 = Time = 0

[State 5110, 9]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5110, 10] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(Fall.YVel) != 0
sysvar(1) = floor(vel y)

[State 5110, 11]
type = PlaySnd
trigger1 = Time = 0
trigger1 = !sysvar(0)
value = s5100,0 ;F7, (sysvar(1) > const720p(20)) + (sysvar(1) > const720p(56))

[State 5110, 12]
type = Explod
trigger1 = Time = 0
trigger1 = !sysvar(0)
;anim = f(60 + (sysvar(1) > const720p(20)) + (sysvar(1) > const720p(56)))
anim = f(60 + (sysvar(1) > 20) + (sysvar(1) > 56))
;postype = none
pos = pos x+camerapos x, 0
facing = facing
sprpriority = cond(sysvar(1) <= 56,-10,10)

[State 5110, 13]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5110, 14] ;For Hit Up Type
type = ChangeAnim
triggerall = Anim = [5171,5179]
triggerall = SelfAnimExist(5110 + (Anim % 10))
trigger1 = AnimTime = 0
trigger2 = sysvar(0) ;SysVar(0) = 1 Avoids Hit Ground Anim
value = 5110 + (anim % 10)
persistent = 0

[State 5110, 15] ;For Normal
type = ChangeAnim
triggerall = Anim != [5111,5119]
trigger1 = AnimTime = 0
trigger2 = sysvar(0) ;SysVar(0) = 1 Avoids Hit Ground Frame
value = 5110
persistent = 0

[State 5110, 16] ;If Just Died
type = ChangeState
triggerall = !Alive
trigger1 = AnimTime = 0
trigger2 = sysvar(0) ;SysVar(0) = 1 Avoids Hit Ground Frame
trigger3 = Anim = [5110,5119]
value = 5150

[State 5110, 17]
type = VarSet
trigger1 = sysvar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 5110, 18] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5110, 19] ;Friction
type = VelSet
trigger1 = Abs(Vel X) < Const(Movement.Down.Friction.Threshold)
x = 0
persistent = 0

[State 5110, 20]
type = ForceFeedback
trigger1 = Alive
trigger1 = Time = 0
time = 8
ampl = 240
waveform = sine

[State 5110, 21]
type = ForceFeedback
trigger1 = !Alive
trigger1 = Time = 0
ampl = 200,7,-0.467
time = 30
waveform = sine

[State 5110, 22 (Roll Recovery / Knock Down (Lie Down) Human Control)]
type = SelfState
triggerall = Alive
triggerall = var(53) = 0 ;復活未開啟時
triggerall = var(59) = 0 ;AI關閉時
trigger1 = CanRecover
trigger1 = Command = "recovery"
value = 706

[State 5110, 23 (Roll Recovery / Knock Down (Lie Down) AI)]
type = SelfState
triggerall = Alive
triggerall = RoundState = 2
triggerall = var(53) = 0 ;復活未開啟時
triggerall = var(59) >= 1 ;AI開啟時
trigger1 = CanRecover
trigger1 = (Random <= var(58)*(1.1)) ;發動機率
value = 706

;---------------------------------------------------------------------------
; Downed Get-Hit / Getting up
; 擊落受擊 / 起身
;---------------------------------------------------------------------------
[Statedef 5120]
type = L
movetype = I
physics = N

; 如果Helper(被對手用當身技當身的Helper)保持在Statedef 0(站立)狀態，
; 那麼需要在Statedef 5120(起身動作)下寫上非必要Helper註銷的代碼。
; 目的是避免自身的Helper被對面當身後一直留在場上(一直保持Statedef 0的動作狀態)。
; https://tieba.baidu.com/p/5488708346#
[State 5120, 1]
type = DestroySelf
triggerall = IsHelper
triggerall = Name = "Riesz MAAB Sprite by Lingle"
triggerall = AuthorName = "Manny Lingle"
triggerall = AnimElemTime(2) >= 0 || Time >= 60
;========= 確保以下帶有攻擊性的Helper不會被註銷 =========;*
trigger1 = !IsHelper(7632) ;旋風波動槍 / 飛行道具
trigger1 = !IsHelper(7648) ;冰層凍結效果
trigger1 = !IsHelper(7740) ;真空波動槍 / 飛行道具1
trigger1 = !IsHelper(7760) ;真空波動槍 / 飛行道具2
trigger1 = !IsHelper(12600) ;弱酸型艾爾
trigger1 = !IsHelper(12860) ;向上疾風
trigger1 = !IsHelper(13650) ;攻擊雷射(激光)
trigger1 = !IsHelper(23201) ;百花光弾槍 / 第一段攻擊判定
trigger1 = !IsHelper(23202) ;百花光弾槍 / 第二段攻擊判定A
trigger1 = !IsHelper(23203) ;百花光弾槍 / 第二段攻擊判定B
trigger1 = !IsHelper(23204) ;百花光弾槍 / 第二段攻擊判定C
ignorehitpause = 1

;*要注意Helper的ID號和Helper裡Hitdef的ID號差異
; 這裡要寫的是Helper的ID編號

; 如果非本人 回歸到自身的State狀態
[State 5120, 2]
type = SelfState
trigger1 = Time = 0
trigger1 = Name != "Riesz MAAB Sprite by Lingle"
trigger1 = AuthorName != "Manny Lingle"
value = 5120
ignorehitpause = 1

[State 5120, 3 (Resurrection)]
type = ChangeState
trigger1 = var(53) = 1 ;復活
trigger1 = Alive
trigger1 = Anim != 5115
trigger1 = Time = 0
value = 3990

[State 5120, 4 (Resurrection)]
type = ChangeState
trigger1 = var(53) = 1 ;復活
trigger1 = Alive
trigger1 = Anim = 5115
trigger1 = Time = 0
value = 3991

[State 5120, 5] ;Get Up Anim (Normal) 起身動作 (一般)
type = ChangeAnim
triggerall = Time = 0
trigger1 = Anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (Anim % 10))
value = 5120

[State 5120, 6] ;Get up Anim (For Hit Up/Diag Up) 起身動作（被上打／斜上打）
type = ChangeAnim
triggerall = Time = 0
trigger1 = Anim = [5111,5119]
trigger1 = SelfAnimExist(5120 + (Anim % 10))
value = 5120 + (anim % 10)

[State 5120, 7]
type = VelSet
trigger1 = Time = 0
x = 0

[State 5120, 8]
type = PalFX
trigger1 = AnimElem = 1
time = -1
add = 0,0,0
mul = 256,256,256

[State 5120, 9]
type = NotHitBy
trigger1 = 1
value = SCA, NA, SA, HA, NP, SP, HP, NT, ST, HT, AA, AP, AT
time = 1

[State 5120, 10]
type = HitFallSet
trigger1 = AnimTime = 0
value = 1

[State 5120, 11 (Character Voice)] ;人物起身時語音
type = PlaySnd
triggerall = var(53) = 0
triggerall = Random < 920 ;92%播放語音
trigger1 = AnimElemTime(3) = 1
value = s5120,0+(random%2)
channel = 0

[State 5120, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
