;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 角色常量 ‖ キャラクター定数
; Character Constant
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; Riesz Basic Data
; 莉絲 基本數據
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Data]
life = 1000               ;基本體力 / Amount of life to start with
power = 5000              ;基本能量值 / Power maximum point
attack = 100;*1           ;基本攻撃力 / Attack power (more is stronger)
defence = 100             ;基本防禦力 / Defensive power (more is stronger)
fall.defence_up = 50      ;每次被擊倒時增加防禦力的百分比 / Percentage to increase defense everytime player is knocked down
liedown.time = 60         ;躺下時間 / Time which player lies down for, before getting up
airjuggle = 15;*2         ;空中連擊點數 / Number of points for juggling
sparkno = 2               ;默認打擊火花值 / Default hit spark number for HitDefs
guard.sparkno = 40        ;默認防禦火花值 / Default guard spark number
KO.echo = 0               ;被KO時有沒有回聲 / 1 to enable echo on KO
volumescale = 100         ;音量比例 (數值100表示音量為100% 有效值從0~100) / Volume Scale (A value of 100 means that the volume is 100% Valid values are from 0~100)
;volume = 255             ;音量大小 (WinMUGEN版音量設定 MUGEN 1.0以後版本該參數不再被使用)

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; 變量號大於以下數值的變量在每回合之間不會被歸零。
; 如果不寫以下兩行，那麼所有的變量都會被清零。
; 另外，你需要改變RizMAAB-Common.cns裡
; Statedef 5900中的VarRangeSet來決定每一場之間清零與否。
IntPersistIndex = 60      ;Variables with this index and above will not have their values
FloatPersistIndex = 35    ;reset to 0 between rounds or matches. There are 60 int variables,
                          ;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
                          ;If omitted, then it defaults to 60 and 40 for integer and float
                          ;variables repectively, meaning that none are persistent, i.e. all
                          ;are reset. If you want your variables to persist between matches,
                          ;you need to override state 5900 from RizMAAB-Common.cns.

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; Size
; 尺寸大小
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Size]
xscale = 1.00             ;橫向縮放值 / Horizontal scaling factor.
yscale = 1.00             ;縱向縮放值 / Vertical scaling factor.
ground.back = 72;*3       ;人物寬度站立後點 / Player width (back, ground)
ground.front = 78;*3      ;人物寬度站立前點 / Player width (front, ground)
air.back = 69;*3          ;人物寬度空中後點 / Player width (back, air)
air.front = 69;*3         ;人物寬度空中前點 / Player width (front, air)
height = 384;*3           ;人物身高(與對方跳躍過頂有關) / Height of player (for opponent to jump over)
attack.dist = 820         ;攻擊效果距離(與對方作出防禦動作有關) / Default attack distance
proj.attack.dist = 530    ;飛行道具攻擊效果距離(與對方作出防禦動作有關) / Default attack distance for projectiles
proj.doscale = 1          ;飛行道具是否也受人物縮放比例影響 / Set to 1 to scale projectiles too   
head.pos = 12,-554;*4     ;近似的頭部位置 / Approximate position of head;
mid.pos = -25,-380;*4     ;近似的中身部位置 / Approximate position of midsection 
shadowoffset = 0          ;影子的垂直偏離像素 / Number of pixels to vertically offset the shadow
draw.offset = 0,0         ;人物的偏離像素(X軸Y軸) / Player drawing offset in pixels (x, y)

;*head.pos和mid.pos可以使用Training角色測量和設定人物實際身高
; https://mugen.fandom.com/wiki/Training

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; Velocity
; 移動速度
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Velocity]
walk.fwd  = 12.0               ;步行前進速度 / Walk forward
walk.back = -11.4              ;步行後退速度 / Walk backward
run.fwd  = 34.0,0;*5           ;跑步前進速度 / Run forward (x, y)
run.back = -32.0,-23.6;*5      ;跑步後退速度 / Hop backward (x, y)
jump.neu = 0,-53.0             ;正上跳起速度 / Neutral jumping velocity (x, y)
jump.back = -15.8;*6           ;向後跳起速度 / Jump back Speed (x, y)
jump.fwd = 14.2;*6             ;向前跳起速度 / Jump forward Speed (x, y)
runjump.back = -14.4,-49.6     ;向後跑跳起速度 / Running jump back speeds (opt)
runjump.fwd = 26.6,-53.2       ;向前跑跳起速度 / Running jump forward speeds (opt)
airjump.neu = 0,-49.6          ;正上空中連跳速度 / Air jump neu speeds (opt)
airjump.back = -13.6           ;向後空中連跳速度 / Air jump back speeds (opt)
airjump.fwd = 13.8             ;向前空中連跳速度 / Air jump forward speeds (opt)
; ↓MUGEN 1.0版後新增 可以不填寫↓
;air.gethit.groundrecover = -0.9,-21    ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
;air.gethit.airrecover.mul = 0.5,0.2;*  ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
;air.gethit.airrecover.add = 0,-27      ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
;air.gethit.airrecover.back = -6        ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
;air.gethit.airrecover.fwd = 0          ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
;air.gethit.airrecover.up = -12         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
;air.gethit.airrecover.down = 9         ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

;*air.gethit.airrecover.mul不受人物localcoord影響
; 可以比較MUGEN內建的kfm和kfm720兩位人物的[Velocity]數值

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; Movement
; 運動関係
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Movement]
airjump.num = 1                 ;空中能連跳數 1表示空中可以跳1次 / Number of air jumps allowed (opt)
airjump.height = 210            ;空中能啟動連跳的最低高度 / Minimum distance from ground before you can air jump (opt)
yaccel = 3.30                   ;落下加速度 / Vertical acceleration
stand.friction = 0.85;*7        ;站立摩擦系數 / Friction coefficient when standing 
crouch.friction = 0.82;*7       ;蹲下摩擦系數 / Friction coefficient when crouching
; ↓MUGEN 1.0版後新增 可以不填寫↓
;stand.friction.threshold = 12                        ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
;crouch.friction.threshold = 0.3                      ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
;air.gethit.groundlevel = 150                         ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
;air.gethit.groundrecover.ground.threshold = -120     ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
;air.gethit.groundrecover.groundlevel = 60            ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
;air.gethit.airrecover.threshold = -6                 ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
;air.gethit.airrecover.yaccel = 2.1                   ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
;air.gethit.trip.groundlevel = 90                     ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
;down.bounce.offset = 0,120                           ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
;down.bounce.yaccel = 2.4                             ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
;down.bounce.groundlevel = 72                         ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
;down.friction.threshold = 0.3                        ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; Victory Quote
; 勝利台詞
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; 人物的勝利台詞 **MUGEN 1.0 1.1以上版本專用**
; 會優先取代畫面包設定的winquote.text勝利台詞，默認語言為英語
; 每種語言最多可以有100個勝利台詞 (victory0 - victory99)

; 要能夠正常顯示日文中文，儲存時請將檔案(DEF、CNS、ST、TXT)轉為UTF-8字元編碼格式。
; Quotes From → https://mana.fandom.com/wiki/Riesz

[Quotes] ;English
victory1 = "Wind...\nThe wind is crying..."
victory2 = "It's okay, the wind will be on your side.\nLet's decide with a single blow!"
victory3 = "Mother......\nI will definitely rescue Elliott."
victory4 = "I'm sorry, are you injured?\nIsekai Hero."
victory5 = "If you use the power of this wind, you can move faster!"

[Ja.Quotes] ;日本語
victory1 = "風が…\n風が泣いている…"
victory2 = "大丈夫、風が味方になってくれるわ。\n一撃で決めてみせる！"
victory3 = "お母様……\n私はエリオットを必ず助け出します。"
victory4 = "ごめんなさい、お怪我はありませんか？\n異世界の勇者様。"
victory5 = "この風の力を利用すれば、もっと速く動けます！"

[Zh.Quotes] ;中文
victory1 = "風…\n風在哭…"
victory2 = "沒問題，風就在你身邊。\n一口氣決定吧！"
victory3 = "母親……\n我一定會營救艾略特的。"
victory4 = "對不起，你受傷了嗎？\n異世界的勇者。"
victory5 = "如果利用這種風的力量，您可以更快地移動！"

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 回合結束動作 ‖ マッチオーバーポーズ
; Match Over Pose
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝

;---------------------------------------------------------------------------
; Lose (Time Over)
; 敗北 (時間到)
;---------------------------------------------------------------------------
[Statedef 170]
type = S ;狀態類型 (默認為S)
movetype = I ;招式類型 (默認為I)
physics = N ;物理屬性 (默認為N)
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA, AA, AP, AT
time = 1

;---------------------------------------------------------------------------
; Draw Game (Time Over)
; 平手 (時間到)
;---------------------------------------------------------------------------
[Statedef 175]
type = S
movetype = I
physics = N
ctrl = 0
anim = 175
velset = 0,0

[State 175, 1]
type = NotHitBy
trigger1 = 1
value = SCA, AA, AP, AT
time = 1

[State 175, 2 (To Next State 170)];*
type = ChangeState
triggerall = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

;*如果自己沒有動作編號175就會改為Lose的動作編號170

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 勝利動作 ‖ 勝利ポーズ
; Win Pose
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝

;---------------------------------------------------------------------------
; Win Pose State Decider
; 勝利動作 狀態決定
;---------------------------------------------------------------------------
[Statedef 180]
type = S
movetype = I
physics = N
anim = 0

[State 180, 1]
type = NotHitBy
trigger1 = 1
value = SCA, AA, AP, AT
time = 1

[State 180, 2]
type = VarRandom
trigger1 = 1
v = 18
range = 1,8

[State 180, 3 (Win Pose 1)] ;勝利動作1
type = ChangeState
trigger1 = var(18) = [1,2]
trigger1 = Time = 1
value = 181

[State 180, 4 (Win Pose 2)] ;勝利動作2
type = ChangeState
trigger1 = var(18) = [3,4]
trigger1 = Time = 1
value = 182

[State 180, 5 (Win Pose 3)] ;勝利動作3
type = ChangeState
trigger1 = var(18) = [5,6]
trigger1 = Time = 1
value = 183

[State 180, 6 (Win Pose 4)] ;勝利動作4
type = ChangeState
trigger1 = var(18) = [7,8]
trigger1 = Time = 1
value = 184

;---------------------------------------------------------------------------
; Win Pose 1
; 勝利動作1
;---------------------------------------------------------------------------
[Statedef 181]
type = S
movetype = I
physics = N
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA, AA, AP, AT
time = 1

[State 181, 2 (Character Voice)]
type = PlaySnd
triggerall = Alive
trigger1 = AnimElemTime(1) = 0
value = s181,0
channel = 6

[State 181, 3]
type = VelSet
trigger1 = AnimElemTime(2) = 0
y = const(velocity.jump.y)

[State 181, 4]
type = VelAdd
trigger1 = AnimElemTime(2) >= 2 && AnimElemTime(9) <= 0
y = const(movement.yaccel)

[State 181, 5]
type = ChangeAnim
triggerall = Pos Y >= 0
trigger1 = AnimElemTime(3) >= 1 && AnimElemTime(14) < 0
value = 181
elem = 14

[State 181, 6]
type = PosSet
trigger1 = AnimElemTime(14) >= 0
y = -25

[State 181, 7 (Land Effect)]
type = Explod
trigger1 = AnimElemTime(14) = 0
anim = 7052
pos = 0,-25*fvar(22)
facing = facing
;space = stage ;*
bindid = id ;*
bindtime = 1;只綁定本體1ticks
ownpal = 1
sprpriority = -3
scale = fvar(21)*2.80,fvar(22)*2.80

;*space = stage 指定如何顯示動畫坐標 (默認值為space = stage)
; 如果是space = stage 需要有bindtime數值。 -1為永久綁定 如果是space = screen 則無法綁定。

;*測試過bindid = -1為綁定p1(說明上為綁定到任何單獨玩家這點是錯的，下面的網址有英文說明)，要實際綁定本體，用id號會比較好。-2為默認值(不綁定)
; https://mugenguild.com/forum/topics/explod-modifyexplod-sctrls-1-0-1-1b-169499.0.html

;*能使用的bindid參數：ID、Partner,ID、Helper,ID、EnemyNear,ID、Enemy(0),ID、Enemy(1),ID、Target,ID、-1、-2

;*應該可以Bind綁定的ID類型 (巴哈姆特MUGEN哈啦板)：
; https://forum.gamer.com.tw/C.php?bsn=24744&snA=395&subbsn=0&page=1&gothis=770#770

;*測試過玩家ID號為56 
; 1VS1時 1P玩家編號為56數值，對手編號為57數值。

; 2VS2時 1P玩家編號為56數值 1P同伴為57數值。
; 2VS2時 對手編號為58數值 對手同伴為59數值。

; 但其實ID號會因mugen.cfg檔HelperMax的設定而改變。
; https://mugenguild.com/forum/topics/playerid-56-152494.0.html

[State 181, 8];著地的音效
type = PlaySnd
trigger1 = AnimElemTime(14) = 0
value = s47,0 ;人物落地產生的音效不應受攻擊而中斷 (channel默認值為-1)

[State 181, 9 (Character Voice)]
type = PlaySnd
trigger1 = AnimElemTime(18) = 0
trigger1 = Alive
value = s181,1
channel = 6

[State 181, 10 (Pose Over 360 ticks Ends)]
type = AssertSpecial
trigger1 = Time = [0,360]
flag = RoundNotOver

;---------------------------------------------------------------------------
; Win Pose 2
; 勝利動作2
;---------------------------------------------------------------------------
[Statedef 182]
type = S
movetype = I
physics = N
ctrl = 0
anim = 182
velset = 0,0

[State 182, 1]
