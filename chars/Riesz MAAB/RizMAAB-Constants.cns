;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 開場動作 ‖ イントロポーズ
; Intro Pose
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝

;---------------------------------------------------------------------------
; Intro Pose State Decider
; 開場動作 狀態決定
;---------------------------------------------------------------------------
[Statedef 190]
type = S
movetype = I
physics = N
anim = 191
velset = 0,0
ctrl = 0

[State 190, 1]
type = NotHitBy
trigger1 = 1
value = SCA, AA, AP, AT
time = 1

[State 190, 2]
type = VarRandom
trigger1 = 1
v = 19
range = 1,8

[State 190, 3 (Intro 1)] ;開場動作1
type = ChangeState
trigger1 = var(19) = [1,2]
trigger1 = Time = 1
value = 191

[State 190, 4 (Intro 2)] ;開場動作2
type = ChangeState
trigger1 = var(19) = [3,4]
trigger1 = Time = 1
value = 192

