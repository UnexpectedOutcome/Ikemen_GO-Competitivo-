; サンプルキャラ・カンフーマンの定義ファイルです。
; 使用可能にするための必要とされるファイル名を全て登録してください。

;※全てのプログラムファイル内で、セミコロン（「;」の事）の後に入力した行の文字は
;　コメント化されます（記述が無視される）。安心して有効利用してください。

;-----基本情報------------------------------------------------------

[Info]
Name         = "TrapSatoko"   ;キャラの名前（後々必要な場合があるので省略不可）
DisplayName  = "TrapSatoko"   ;ゲーム中表示される名前（省略可能）
VersionDate  = 01,13,2013      ;キャラの最終更新日
;MugenVersion = 10,12,2007      ;このキャラを使用出来るM.U.G.E.Nのバージョン
Author       = "baggy"      ;このキャラの作成者の名前
Pal.Defaults = 2,3,4,5         ;CPUで出てくるキャラカラーの順番
mugenversion = 1.0
LocalCoord = 320

;-----必要なファイルの設定------------------------------------------
;このファイル（*.def）とsff・snd・act以外の、メモ帳などで書き換えられるファイル（air・cmd・cns・stなど）は
;拡張子はなんでも良いらしいです。不正終了が怖かったらカンフーマンと同じように従ってください。

;※StCommonはdataフォルダから直接読み込んでいますが、
;　独自にファイルを作って登録する場合は各キャラフォルダで認識されるので注意。

[Files]
Cmd      = TrapSatoko.cmd          ;入力コマンド定義ファイルの登録
Cns      = TrapSatoko.cns          ;基本ステータス情報ファイルの登録
St       = TrapSatoko_0.cns          ;動作プログラムファイルの登録（最大１０個くらい増やせます（St,St0,St1,St2......））
St0       = TrapSatoko_1.cns
St1       = TrapSatoko_-2.cns
St2      = TrapSatoko_-3_AI.cns
StCommon = TrapSatoko_common1.cns      ;コモン動作プログラムファイルの登録
Sprite   = TrapSatoko.sff          ;複数のPCX画像を１パック化したスプライトファイルの登録
Anim     = TrapSatoko.air          ;アニメーションファイルの登録
Sound    = TrapSatoko.snd          ;複数のWAV音声を１パック化したサウンドファイルの登録

;---カラーパレットファイルの設定（最大１２個まで可能）---

Pal1 = TrapSatoko_00.act
Pal2 = TrapSatoko_01.act
Pal3 = TrapSatoko_02.act
Pal4 = TrapSatoko_03.act
Pal5 = TrapSatoko_00.act
Pal6 = TrapSatoko_00.act
Pal7 = TrapSatoko_00.act
Pal8 = TrapSatoko_01.act
Pal9 = TrapSatoko_02.act
Pal10 = TrapSatoko_03.act
Pal11 = TrapSatoko_00.act
Pal12 = TrapSatoko_00.act

;-----ストーリーボード設定------------------------------------------
;別途作成したキャラ固有のオープニングとエンディングのファイルを
;入れる場合は、ここの項目で設定が出来ます。

[Arcade]
;Intro.Storyboard  = intro.def
;Ending.Storyboard = ending.def
