;■debug用■■■■■■■■■■■■
[State -2, デバック]
type = DisplayToClipboard
trigger1 = 1
text =  "___________________________________var(17),%d,var(16),%d,var(18),%d,var(19),%d,var(46),%d\n"
params = var(17),var(16),var(18),var(19),var(46)
IgnoreHitPause = 1

[State -2, 距離確認デバック]
type = AppendToClipboard
trigger1 = 1
text =  "____________________________________P2X:%f,P2Y:%f,Vx%f,Vy%f,Py%f \n"
params = p2bodydist x, p2bodydist y,vel x,vel y,Pos y
IgnoreHitPause = 1



