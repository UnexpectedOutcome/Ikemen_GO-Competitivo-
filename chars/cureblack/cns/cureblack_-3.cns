trigger1=helper(3000),var(39)=1
var(1)=3
ignorehitpause=1

[State ]
type=PlaySnd
trigger1=Time=1&&Alive=1&&stateno=5030&&(var(1)=[0,1])
value=s0,1+ifelse(var(1)=1,1,0)
