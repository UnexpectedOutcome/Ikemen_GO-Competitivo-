v=1
range=0,2

[State ];ライフ劣勢
type=varset
trigger1=time=1&&stateno=5120&&fvar(6)=1
var(1)=3

[State ]
type=PlaySnd
trigger1=Time=1&&Alive=1&&stateno=5120&&((var(1)=[0,1])||var(1)=3)
value=s0,3+ifelse(var(1)=1,2,ifelse(var(1)=3,26,0))
channel=3

[State ];ライフ劣勢判定解除
type=varset
trigger1=Time=1&&Alive=1&&stateno=5120&&var(1)=3&&fvar(6)=1
fvar(6)=2

[State ];やられボイス制御
type=varset
trigger1=(time>=2&&(TeamMode=single ||TeamMode=simul)&&alive!=1)||TeamMode=turns ||MatchOver=1
fvar(39)=1

[State ];無音
type=varset
trigger1=numhelper(3000)&&!alive&&time=1&&var(4)=0&&!numhelper(507021)
trigger1=helper(3000),var(39)=1||(helper(3000),fvar(1)=1&&fvar(36)=2)
fvar(39)=2
ignorehitpause=1

[State ]
type=PlaySnd
trigger1=(fvar(39)=[0,1])&&var(4)=0&&alive!=1
value=s0,6+ifelse(fvar(39)=1,18,0)
channel=3
persistent=0

[State ];やられボイス制御
type=varset
trigger1=alive!=1&&time>=1
var(4)=1

;ハイジャンプ
[State ]
type=varset
trigger1=command="holddown"&&time>=5
var(12)=1

[State ]
type=varset
trigger1=var(12)!=1&&ctrl=1&&statetype!=A&&(command="Hijump"||(prevstateno=100&&command="holdup"))
var(11)=1

[State ]
type=varset
trigger1=(var(12)=1&&command="Hijump")||movetype=H||movetype=A||stateno=52
var(12)=0

[State ]
type=varset
trigger1=stateno=50&&time=2
var(11)=0

[State ]
type=veladd
trigger1=var(11)=1&&stateno=50
y=-3
persistent=0

[State ]
type=veladd
trigger1=var(11)=1&&stateno=50&&command="holdfwd"
x=.7
persistent=0

[State ]
type=veladd
trigger1=var(11)=1&&stateno=50&&command="holdback"
x=-.7
persistent=0

;ラウンドスタート時音声消す
[State ]
type=VarSet
trigger1=RoundState=[0,1]
var(2)=1

[State  ]
type=StopSnd
trigger1=RoundState=2&&var(2)=1
channel=0

[State ]
type=VarSet
trigger1=RoundState=2&&var(2)=1
var(2)=0

[State ];ラウンド開始時ゲージ類表示制御
type=Varset
trigger1=var(5)=0&&RoundState>=2
var(5)=1
