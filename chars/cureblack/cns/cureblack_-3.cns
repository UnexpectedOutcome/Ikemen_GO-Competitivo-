[Statedef -3]

;MUGEN1.0モード設定（未使用）
;MUGEN1.0で使用する場合、下記の項目の"null;"を消して下さい。
;ヒット硬直の1F減少の対応記述と勝利メッセージ分岐が有効になりません。
;WINMUGENで使用する場合は逆に必ず"null;"を付けて下さい。
;付けないとヒット硬直が1F増えて、エラーでMUGENが落ちてしまいます。

[State ];MUGEN1.0モードON判定　※このVarは使用しないでください。
type=null;Varset
trigger1=roundstate<=1
trigger2=numhelper(3000)
trigger2=helper(3000),time=1
var(45)=1

;キャラサイズ設定
[State ];Const(size.xscale)値セット
type=Varset
trigger1=roundstate<=1
trigger2=numhelper(3000)
trigger2=helper(3000),time=1
fvar(32)=Const(size.xscale)*.8

[State ];Const(size.yscale)値セット
type=Varset
trigger1=roundstate<=1
trigger2=numhelper(3000)
trigger2=helper(3000),time=1
fvar(33)=Const(size.yscale)*.8

