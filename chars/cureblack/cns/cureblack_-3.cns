name="SP mode"
ID=7093
postype=p1
stateno=7093
supermovetime=99999999
pausemovetime=99999999

[State ];ボイスランダム～通常ダメージ
type=varrandom
trigger1=time=1&&(stateno=5000||stateno=5010||stateno=5020||stateno=5080)
v=1
range=0,2
ignorehitpause=1

[State ];無音
type=varset
trigger1=numhelper(3000)=1&&time=1&&(stateno=5000||stateno=5010||stateno=5020||stateno=5080)
trigger1=helper(3000),var(39)=1
var(1)=2
ignorehitpause=1

[State ]
type=PlaySnd
trigger1=Time=1&&Alive=1&&(stateno=5000||stateno=5010||stateno=5020||stateno=5080)&&(var(1)=[0,1])
value=s0,0+ifelse(var(1)=1,4,0)
channel=3

[State ];ボイスランダム～トリップ
type=varrandom
trigger1=time=1&&stateno=5070
v=1
range=0,2
ignorehitpause=1

[State ];無音
type=varset
trigger1=numhelper(3000)=1&&time=1&&stateno=5070
trigger1=helper(3000),var(39)=1
var(1)=2
ignorehitpause=1

[State ]
type=PlaySnd
trigger1=Time=1&&Alive=1&&stateno=5070&&(var(1)=[0,1])
value=s0,25+ifelse(var(1)=1,1,0)
channel=3

[State ];ボイスランダム～ダウン
