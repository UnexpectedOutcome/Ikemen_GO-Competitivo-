[Data]
life = 1000
attack = 100
defence = 100
power = 9000
fall.defence_up = 50
liedown.time = 30
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
IntPersistIndex = 50
FloatPersistIndex = 39

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 30     ;Player width (back, ground)
ground.front = 30    ;Player width (front, ground)
air.back = 25        ;Player width (back, air)
air.front = 25       ;Player width (front, air)
height = 80          ;Height of player (for opponent to jump over)
attack.dist = 120    ;Default attack distance
proj.attack.dist = 100 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 0, -85   ;Approximate position of head
mid.pos = 0, -55    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 4.6, 0    ;Run forward (x, y)
run.back = -4.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-8.4    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 1      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

[Quotes]
victory1= "Clow Cards are dangerous. Hand them over."
victory2= "You want to collect Clow Cards with that level of power? Give up before it's too late."
victory3= "I never thought there is a Clow Card this powerful."
victory4= "Accept me as the new master of Clow Cards!"
victory5= "That's Clow's magic! Who are you?"

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; DRAWGAME (Time over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, 1] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

[State 175, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 175

[State 175, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(190)
value = 190

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191

;---------------------------------------------------------------------------
; INTRO (override this state to give character an intro)
[Statedef 191]
type = S
ctrl = 0
anim= 190

[State 191]
Type=PlaySnd
Trigger1=time=0
value=190,0

[State 191, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[Statedef 180]
type = S

[State 180]
Type=VictoryQuote
Trigger1=1
value=2

[State 180]
Type=VictoryQuote
Triggerall=enemy,authorname="Seravy"
Trigger1=enemy,name="Void"
value=3

[State 180]
Type=VictoryQuote
Triggerall=enemy,authorname="Seravy"
Trigger1=enemy,name="Sakura Kinomoto"
value=1

[State 180]
Type=VictoryQuote
Triggerall=enemy,authorname="Seravy"
Trigger1=enemy,name="Yue"
value=4

[State 180]
Type=VictoryQuote
Triggerall=enemy,authorname="Seravy"
Trigger1=enemy,name="Eriol Hiiragizawa"
value=5

[State 180, 2]
type = ChangeState
trigger1 = Time = 0
value = 181
;--------------------------------------------------------------------------
; Win pose 1
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, end]
type = AssertSpecial
trigger1 = time <300
flag = RoundNotOver

[State 181]
Type= PlaySnd
Trigger1=time=0
Value=180,0

