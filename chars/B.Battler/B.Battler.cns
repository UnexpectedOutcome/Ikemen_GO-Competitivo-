;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; ヴァンパイアイントロ（本体側）
[StateDef 19940630];←このステートNo.は絶対に変えないでください。モリガン側が検知できなくなります。
Type = S
Ctrl = 0
Anim = 0
VelSet = 0,0

[State 19940630];ワールドマップを設定できます。
Type = VarSet
Trigger1 = Time < 2
sysvar(4) = 7 ;←0～11までの任意の数値を入れてください。なお指定以外の数値を入れた場合はランダムになります。
;0=ルーマニア（＝デミトリ）
;1=イギリス（＝ガロン）
;2=ドイツ（＝ビクトル）
;3=オーストラリア（＝ザベルザロック）
;4=スコットランド（＝モリガン）
;5=エジプト（＝アナカリス）
;6=アメリカ（＝フェリシア）
;7=日本（＝ビシャモン）
;8=ブラジル（＝オルバス）
;9=カナダ（＝サスカッチ）
;10=メキシコ（＝フォボス）
;11=ヘルストーム（＝パイロン）
;上記以外の場合ランダム表示となります。例：「12」、「45」、「-8」など

;※このステート中のみ限定的にsysvar(4)を使うという解釈で進めています。
;なおsysvar(4)以外ではモリガン側が検知できないので、他の変数での代用はできません。
;一部GameTime（ステート抜け等）用に使っているキャラも一部いますが、
;まあ普通のキャラではそんな用途はまず無いだろうという事で。

;相手の攻撃が当たらないようにする。
[State 19940630]
Type = NotHitBy
Trigger1 = 1
Value = SCA,AA,AP,AT

;時止め無視ヘルパー『止まった時の世界への入門（笑）』
[State 19940630]
Type = Helper
Trigger1 = !NumHelper(19940630);←ヘルパーIDは必ずこの番号にしてください。
Name = "Vampire Intro"
StateNo = 19940705;←ヘルパーステートNoは任意に決めてください。ここでは例として番号を19940705にしております。
ID = 19940630;←ヘルパーIDは必ずこの番号にしてください。
HelperType = Normal
PosType = P1
PauseMoveTime = 2147483647;←この数値は絶対に変えないでください。止まった時の世界への入門ができなくなります。
SuperMoveTime = 2147483647;←この数値は絶対に変えないでください。止まった時の世界への入門ができなくなります。
IgnoreHitPause = 1



;これより先は本体側では「時止め（Pause・SuperPause）」に引っ掛かって動けなくなりますので、
;それを回避するため「時止め（Pause・SuperPause）」を無効化できるヘルパーに代役をさせます。
;すなわち『「止まった時の世界への入門」たる資格が必要だっ』という解釈で、ってどこぞのジョジョだよ！！
;イントロ終了後に本体が動けるようになったら以下の処理で完了となります。



[State 19940630];本体のsysvar(4)設定を初期状態にリセットさせます。
Type = VarSet
Trigger1 = Time >= 3
sysvar(4) = 0

;イントロ終了後、通常イントロに移行（第１ラウンドのみ）
[State 19940630]
Type = SelfState
TriggerAll = Time > 3
Trigger1 = RoundNo = 1
Trigger2 = RoundNo > 1
Trigger2 = RoundsExisted = 0
Trigger2 = TeamMode = Turns
Value = 190;←通常イントロ凡用Noですが、それ以外のイントロNoの場合は各自で設定をしてください。
Ctrl = 0

;イントロ終了後、待機状態に移行（第２ラウンド以降）
[State 19940630]
Type = SelfState
TriggerAll = Time > 3
Trigger1 = RoundNo >= 2
Trigger2 = RoundsExisted > 0
Trigger2 = TeamMode = Turns
Value = 0;←通常立ち状態の凡用Noですが、それ以外の待機ステートNoの場合は各自で設定をしてください。
Ctrl = 0

;---------------------------------------------------------------------------
; ヴァンパイアイントロ（『止まった時の世界への入門（笑）』用ヘルパー側）
[StateDef 19940705];←ヘルパーステートNoは任意に決めてください。ここでは例として番号を19940705にしております。
Type = S
Ctrl = 0
Anim = 0;←透明アニメがある場合そのアニメ番号にしてください。無い場合はAnim=0でも構いません。
VelSet = 0,0

;保険用記述、もし本体がなにかの間違いでこのステートに来た場合はSelfStateで通常状態へ復帰させる。
[State 19940705]
Type = SelfState
Trigger1 = !IsHelper
Value = IfElse(StateType=L,5120,IfElse(StateType=A,5040,IfElse(Pos Y!=0,5040,0)))
Ctrl = 1

;透明アニメがない場合の保険用。上記のAnim=0の場合、透明アニメがあればこの記述は削除しても構いません。
[State 19940705]
Type = AssertSpecial
Trigger1 = 1
Flag = Invisible
Flag2 = NoShadow

;本体の座標に合わせる。
[State 19940705]
Type = BindToRoot
Trigger1 = 1
IgnoreHitPause = 1

;相手の攻撃が当たらないようにする。
[State 19940705]
Type = NotHitBy
Trigger1 = 1
Value = SCA,AA,AP,AT

;もし相手の攻撃が当たった場合の保険用。
[State 19940705]
Type = HitOverRide
Trigger1 = 1
Attr = SCA,AA,AP,AT
Slot = 0
Time = -1
StateNo = 19940705;←現在と同じステートNoにしてください。ステート番号を変えた場合はそれと同じ番号にこちらも直してください。

