[Data]
life = 900
attack = 100
defence = 100
power = 5000
fall.defence_up = 50
liedown.time = 21 ;25
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volumescale= 100
IntPersistIndex = 17
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 34   ;Player width (back, ground)
ground.front = 34    ;Player width (front, ground)
air.back = 34        ;Player width (back, air)
air.front = 34       ;Player width (front, air)
height = 165        ;Height of player (for opponent to jump over)
attack.dist = 320    ;Default attack distance
proj.attack.dist = 180 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 8, -227   ;Approximate position of head
mid.pos = -14, -147   ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y). Recommended 0,0

[Velocity]
walk.fwd  = 3.5      ;Walk forward
walk.back = -3     ;Walk backward
run.fwd  = 9.9, 0    ;Run forward (x, y)
run.back = -8.8,-9.65 ;Hop backward (x, y)
jump.neu = 0,-18.28   ;Neutral jumping velocity (x, y)
jump.back = -5.5,-18.75   ;Jump back Speed (x, y)
jump.fwd = 5.8,-18.75       ;Jump forward Speed (x, y)
runjump.back = -6.4,-19.54 ;Running jump speeds (opt)
runjump.fwd = 7.9,-19.64      
airjump.neu = 0,-16.42  
airjump.back = -4.5     ;Air jump speeds (opt)
airjump.fwd = 5.5         ;.
air.gethit.groundrecover = -0.8,-14.25  ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = 0,-14.25    ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = 0,0   ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -5      ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 5       ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = 0       ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 0     ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

[Movement]
airjump.num = 0     ;Number of air jumps allowed (opt)
airjump.height = 0   ;Minimum distance from ground before you can air jump (opt)
yaccel = .997   ;Vertical acceleration
stand.friction = .81  ;Friction coefficient when standing
crouch.friction = .79 ;Friction coefficient when crouching
stand.friction.threshold = 4          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .1       ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 10           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -10 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -15  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .934    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 15      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 0            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .8               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = -24          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .1        ;If the player's speed drops below this threshold while lying down, stop his movement

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170]
type = AssertSpecial
trigger1 = Time = [0,100]
flag = roundnotover

;---------------------------------------------------------------------------
; Draw game (time over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, 1] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

[State 175, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 175

[State 175, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 175, 4]
type = AssertSpecial
trigger1 = Time = [0,160]
flag = roundnotover


