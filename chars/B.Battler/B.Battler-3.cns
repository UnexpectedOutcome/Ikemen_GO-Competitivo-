
;-------------------------------------------------------------------------
[Statedef -3]

;--------------------------------------------------------------------------
;AI
;--------------------------------------------------------------------------


[State -1, AI ON]
type = VarSet
triggerall = Var(59) <= 0
trigger1 = AILevel > 0 & PalNo != 7 & PalNo != 8 ;-2設定使用
v = 59
value= 3;1、3、-2設定 -2為原作Boss AI(Source Game Boss AI)
ignorehitpause=1

;--------------------------------------------------------------------------
;前鋒位置調整
;--------------------------------------------------------------------------

;Pos X
[State -2, VarSet]
type = VarSet
trigger1 = 1
v = 14
value = 0 ;X位置

;Pos Y
[State -2, VarSet]
type = VarSet
trigger1 = 1
v = 15
value = 0 ;Y位置

;--------------------------------------------------------------------------
;後衛位置調整
;--------------------------------------------------------------------------

;Pos X
[State -2, VarSet]
type = VarSet
trigger1 = 1
v = 16
value = 0 ;X位置

;Pos Y
[State -2, VarSet]
type = VarSet
trigger1 = 1
v = 17
value = 0 ;Y位置

;--------------------------------------------------------------------------
;Partner Choose
;--------------------------------------------------------------------------

;0= Random 1=Battler 2=Ange 3=Shannon 4=Kanon
;5=Lucifer 6=Chiester410 7=Ronove 8=Eva Beatrice 9=Virgilia
;10=Beatrice 11=Jessica 12=George 13=Rosa 14=Erika 15=Dalnor
;16=B.Battler 17=Lambdadetla 18=Bernkatel 19=Willard

[State -2, Partner]
type = VarSet
triggerall = PalNo != 7 & PalNo != 8
trigger1 = NumPartner = 0 & Var(49) = 0
trigger1 = RoundState = 2
v = 49
value = 0


;設定終了










;-------------------------------------------------------------------------
;-------------------------------------------------------------------------
;-------------------------------------------------------------------------
;-------------------------------------------------------------------------
;-------------------------------------------------------------------------
[State -1, AI ON]
type = VarSet
triggerall = Var(59) < 4 & Var(59) != 2 & Var(59) != -2
triggerall = RoundState = 2 & Ctrl
triggerall = NumHelper(9175) > 0
triggerall = PalNo != 8
trigger1 = AILevel > 0
v = 59
value= 4
ignorehitpause=1

[State -1, AI ON]
type = VarSet
triggerall = Var(59) < 5
triggerall = RoundState = 2 & Ctrl
triggerall = NumHelper(9175) > 0
triggerall = PalNo = 8
trigger1 = AILevel > 0
v = 59
value= 5
ignorehitpause=1

[State -1, AI OFF]
Type= VarSet
Trigger1 = var(59) > 0 
Trigger1 = RoundState!=2
Trigger2 = !IsHelper 
Trigger2 = AILevel=0
v= 59
value= Ifelse(Var(59) = 2,-2,0)  

[State -1]
type = Null
trigger1 = EnemyNear,Win = 1
trigger2 = NumHelper(9175) > 0 & RoundState != 2
trigger3 = NumHelper(9175) > 0 & StateNo != [7000,7415]
var(1) = -1
ignorehitpause = 1

[State -1, AI ON]
type = VarSet
triggerall = RoundState = 2 & Ctrl
trigger1 = AILevel > 0 & Var(59) = -2
v = 59
value= 2
ignorehitpause=1

