anim = 4445
ID = 4445
pos = 0,-133
postype = p1  ;p2,front,back,left,right
facing = -1
vfacing = 1
bindtime = 1
removetime = 22
scale = 1,1
sprpriority = ifelse (sysvar(1) <= Const720p(56), -10, 10)
ownpal = 1
persistent = 0

[State 6011]
