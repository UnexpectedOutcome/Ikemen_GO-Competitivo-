;---------------------------------------------------------------------------
; Stand get-hit (shaking)
[Statedef 2020]
type    = S
movetype= H
physics = N
velset = 0,0
facep2 = 1

[State 2011, 2]
type = PosSet
trigger1 = Time = 0
trigger2 = Pos Y > 0
y = 0

[State 2011, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 2020, HitFallSet]
type = HitFallSet
trigger1 = 1
value = 0

[State 2020, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = 1
value = 5012

[State 2020, 6]
type = ChangeState
trigger1 = Time >= 120
value = 2021

;---------------------------------------------------------------------------
; Stand get-hit (knocked back)
[Statedef 2021]
type    = S
movetype= H
physics = N
facep2 = 1

[State 2021, StateTypeSet]
type = HitFallSet
trigger1 = 1
value = 0

[State 2021, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 2021, 2]
type = ChangeAnim
trigger1 = AnimTime = 0 & Authorname = "Boomer"
trigger1 = SelfAnimExist(2020) & SelfAnimExist(2030)
value = 2025 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 2021, 2]
type = ChangeAnim
trigger1 = Time = 0 & Authorname != "Boomer"
trigger2 = AnimTime = 0 & Authorname != "Boomer"
trigger2 = !SelfAnimExist(2020) || !SelfAnimExist(2030)
value = 5005 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 2021, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 2021, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 2021, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 2021, 6]
type = SelfState
trigger1 = HitOver
value = 0
ctrl = 1
;---------------------------------------------------------------------------
[Statedef 5085]
type    = U
movetype= H
physics = N

[State 5085]
type = SelfState
trigger1 = !(PrevStateNo = 5080 || PrevStateNo = 5081 || PrevStateNo = 5100)
trigger1 = !(PrevStateNo = 5101 || PrevStateNo = 5110 || PrevStateNo = 5072) 
trigger1 = !(StateType = L & PrevStateNo != 5120 & Anim != 5300)
trigger1 = !(PrevStateNo = 6081 || PrevStateNo = 6080 || PrevStateNo = 6112 || PrevStateNo = 6113 || PrevStateNo = 6120)
trigger1 = !(PrevStateNo = 6120 & MoveType = H)
value = IfElse(PrevStateNo = 5085,5080,PrevStateNo)

[State 5085, StateTypeSet]
type = StateTypeSet
trigger1 = StateType != S & StateType != C
statetype = L
movetype = H 
physics = N
ignorehitpause = 1

[State 5085]
type = SelfState
Trigger1 = Time = 1 & Authorname = "Boomer"
value = 5080

[State 5085]
type = ChangeState
trigger1 = Time = 0 & Authorname != "Boomer"
value = 5080

