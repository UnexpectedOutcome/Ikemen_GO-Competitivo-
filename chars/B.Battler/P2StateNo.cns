triggerall = Var(59) <= 0 & Authorname = "Boomer"
triggerall = Time > 5
triggerall = Vel Y > Const(movement.air.gethit.airrecover.threshold)
triggerall = alive
triggerall = CanRecover
triggerall = ((EnemyNear,Authorname = "Boomer" & EnemyNear,NumHelper(53010) = 0) || EnemyNear,Authorname != "Boomer") & Var(37) = 0
trigger1 = Command = "Recovery S"
value = 5210 ;Air get-hit (fall recovery in air)

[State 6011, 3] ;Hit ground
triggerall = Authorname = "Boomer"
trigger1 = Vel Y > 0
trigger1 = Pos Y >= Const(movement.air.gethit.trip.groundlevel)
type = SelfState
value = 5100

[State 6011]
type = SelfState
triggerall = Authorname != "Boomer"
triggerall = Vel Y > 0
triggerall = Pos Y >= Const(movement.air.gethit.trip.groundlevel)
trigger1 = EnemyNear,Var(7) != 104 & EnemyNear,Var(7) != 107 & EnemyNear,Var(7) != 111 & EnemyNear,Var(7) != 114 & EnemyNear,Var(7) != 116 & EnemyNear,Var(7) != 117
trigger1 = EnemyNear,Var(35) < 2150
trigger2 = EnemyNear,Var(7) = 104 || EnemyNear,Var(7) = 107 || EnemyNear,Var(7) = 117
trigger2 = EnemyNear,Var(35) < 1950
trigger3 = EnemyNear,Var(7) = 111
trigger3 = EnemyNear,Var(35) < 1650
trigger4 = EnemyNear,Var(7) = 114 || EnemyNear,Var(7) = 116
trigger4 = EnemyNear,Var(35) < 2450
value = 5100

[State 6011]
type = ChangeState
triggerall = Authorname != "Boomer"
triggerall = Vel Y > 0
triggerall = Pos Y >= Const(movement.air.gethit.trip.groundlevel)
trigger1 = EnemyNear,Var(7) != 104 & EnemyNear,Var(7) != 107 & EnemyNear,Var(7) != 111 & EnemyNear,Var(7) != 114 & EnemyNear,Var(7) != 116 & EnemyNear,Var(7) != 117
trigger1 = EnemyNear,Var(35) >= 2150
trigger2 = EnemyNear,Var(7) = 104 || EnemyNear,Var(7) = 107 || EnemyNear,Var(7) = 117
