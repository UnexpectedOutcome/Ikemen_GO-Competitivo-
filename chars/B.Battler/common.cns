physics = A

[State 50, AssertSpecial]
type = AssertSpecial
trigger1 = Var(59)
flag = noautoturn

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0 || (vel x)= 1.5, 41, ifelse((vel x)>0, 42, 43))

