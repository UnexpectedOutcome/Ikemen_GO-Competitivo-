; ; ; ; ; ; ; ; ; ; ; ; ; ; ; ; 
[Statedef -2]

[State -2, DEBUG]
type = DisplayToClipboard
trigger1 = 1
text = "PBDX:%f,PBDY:%f,35:%f,38:%f"
params = P2BodyDist X,Pos Y,Var(35),Const(data.defence)
;ignorehitpause =
;persistent =  

;特殊
[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = NumHelper(9175) > 0 & 0
trigger1 = Helper(9175),Var(40) > 0 & EnemyNear,Life > 0
flag = noko

[State -2, B.Battler]
type = LifeAdd
trigger1 = NumHelper(9175) > 0 & 0
trigger1 = Helper(9175),Var(40) = 2 & Life = 0
value = 250

;消開局音
[State 191, StopSnd]
type = StopSnd
triggerall = RoundState = 2 & PrevStateNo = [191,194]
trigger1 = Anim != [191,194]
channel = 5

[State -2]
type = varadd
trigger1 = var(0) > 0
var(0) = -1
ignorehitpause = 1

[State -2, VarSet]
type = VarSet
trigger1 = NumHelper(9150) = 1 & NumHelper(9101) = 1
trigger1 = Helper(9150),Var(17) = 0 & Helper(9101),Var(17) = 0
trigger2 = NumHelper(9175) = 1
trigger2 = Helper(9175),Var(17) = 0
trigger3 = Fvar(1) = 0
fv = 1  ;fv = 10
value = 0.167

[State -2, Eva]
type = VarSet
trigger1 = NumHelper(9150) = 1
trigger1 = Helper(9150),Var(17) = 1
trigger2 = NumHelper(9101) = 1
trigger2 = Helper(9101),Var(17) = 1
trigger3 = NumHelper(9175) = 1
trigger3 = Helper(9175),Var(17) = 1
fv = 1  ;fv = 10
value = 0.21

[State -2, ChangeState]
type = ChangeState
trigger1 = Alive = 0
trigger1 = MoveType = H & PrevStateNo = [120, 153]
trigger1 = Pos Y >=-5
value = 5999
ctrl = 0
ignorehitpause = 1
persistent = 0

