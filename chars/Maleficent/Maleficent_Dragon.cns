;Stand 1
[StateDef 4900,Stand 1]
type    = S
movetype= I
physics = n
velset = 0,0
ctrl = 0
sprpriority = 2
anim=4900

;No hit by throws
[State -3, NotHitBy]
type = NotHitBy
trigger1 = 1
value = ,AT
time = 1


;turn
[State 0, turn]
type = Turn
trigger1 = P2Dist x < 0

;hit custom 1
[State -3, HitOverride]
type = HitOverride
trigger1 = 1
slot = 0
attr = SCA, AA,AP,AT
stateno = 4902
time = -1
ignorehitpause=1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 1]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20,Walking Forward 1] ;----Walking Forward 1
type = Changestate
triggerall = command = "holdfwd"
trigger1 = vel x > 0
value = 4921
ctrl = 0

[State 20,Walking Back 1] ;----Walking Back 1
type = Changestate
trigger1 = command = "holdback"
trigger1 = vel x < 0
value = 4941
ctrl = 0

;Roar 1
[State 0, Changestate Roar 1]
type = Changestate
triggerall = anim = 4900
trigger1 = command="start"
value = 4955
ctrl = 0

;Head Tackle 1
[State 0, Changestate head tackle 1]
type = Changestate
triggerall = anim = 4900
trigger1 = command="x"
value = 4904
ctrl = 0

;Bite 1
[State 0, Changestate Bite 1]
type = Changestate
triggerall = anim = 4900
trigger1 = command="a"
value = 4908
ctrl = 0

;Fire Ball Down 1
[State 0, Changestate Fire Ball Down 1]
type = Changestate
triggerall = anim = 4900
trigger1 = command="y"
value = 4970
ctrl = 0

;Flamethrower Down 1
[State 0, Changestate Flamethrower Down 1]
type = Changestate
triggerall = anim = 4900
trigger1 = command="b"
value = 4980
ctrl = 0

;Fire Ball UP 1
[State 0, Changestate Fire Ball Up 1]
type = Changestate
triggerall = anim = 4900
trigger1 = command="z"
value = 4960
ctrl = 0

;Flamethrower UP 1
[State 0, Changestate Flamethrower Up 1]
type = Changestate
triggerall = anim = 4900
trigger1 = command="c"
value = 4990
ctrl = 0

;-------------------WIN ID 1
[State 0, Helper] ; Dragon ID
type = Helper
trigger1 = Win
trigger2 = LoseTime
name    = "DragonIDWin1"
helpertype = normal ;player
ID = 4967
stateno = 4967
pos = 0,5
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1

[State 0, ChangeState]  ;WIN
type = ChangeState
trigger1 = Win
value =0
ctrl = 1

[State 0, ChangeState]  ;lose time
type = ChangeState
trigger1 = LoseTime
value =0
ctrl = 1

[State 0, ChangeState] ;Dragon stand to KO 1
type = ChangeState
trigger1 = !alive || life<=0
value =4995
ctrl = 1

