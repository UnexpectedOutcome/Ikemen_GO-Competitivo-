;Diablo the Raven Helper
[Statedef 2620,Diablo]
type    = A
movetype= A
physics = N
juggle  = 4
ctrl = 0
velset = 5,3
anim = 2200
sprpriority = 5

[State 0, VelAdd]
type = VelAdd
trigger1 =  time=25
x = 1
y = -3

[State 2620, 2]
type = HitOverride
trigger1 = time = 0
time = -1
attr = SCA, AA, AP, NA, NP, SA, SP, HA, HP,NT,ST,HT
slot = 0
stateno = 2625

[State 2620, 4]
type = PlaySnd
trigger1 = time = 30
value = 2200,0
channel = 7

[State 2620, 4]
type = hitdef
trigger1 = !movecontact
offset =0,0
attr = SA, SP
damage = 70-(root,var(13)/5),12
animtype = hard
pausetime = 5,10
sparkno=s7300+random%8
guard.SparkNo = s7001				;Hit/Miss/Dodge type (Def: Hit)
sparkxy = 0,-30
hitflag = MAF
guardflag = MA
hitsound = s2200,2
guardsound = s0,ifelse(random<500,6,7)		;Sound to play on guard
ground.type =  Low
ground.slidetime = 30
ground.hittime = 20
ground.velocity = -6,-9
air.animtype = Back
air.velocity = -2.5,-5
air.juggle = 30
fall = 1
fall.recover = 1
p2facing=1
priority = 1, hit

[State 2675, 1]
type = ParentVarSet
trigger1 = 1
var(24) = ceil(backedgedist)

[State 2675, 1]
type = ParentVarSet
trigger1 = 1
var(25) = ceil(pos y)

[State 2675, 1]
type = ParentVarSet
trigger1 = 1
var(26) = 1

[State 2675, 1]
type = ParentVarSet
trigger1 = 1
var(31) = facing

[State 2620, 5]
type = velset
trigger1 = pos y > 0
y = 0

[State 2620, 4]
type = VelSet
triggerall = anim = 2620
trigger1 = time=0
trigger2 = time=12
trigger3 = time=22
trigger4 = time=40
y = (time=12)*2.5+(time=0)*5 - (time=40)*5

[State 2675, 1]
type = ParentVarSet
trigger1 = frontedgedist < -50 && time>300
var(26) = 0

[State 2620, 7]
Type = destroyself
trigger1 = frontedgedist < -50 && time>300

