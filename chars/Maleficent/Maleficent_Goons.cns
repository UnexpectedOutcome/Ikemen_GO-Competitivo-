;Sword Goon
[Statedef 7002,Sword Goon invoked]
type = A
movetype = I
physics = N
velset = 0,0
anim = 7002
sprpriority = 3

;Invoke Effect 2 front
[State 191, 3];
type = Explod
trigger1 = time =0
Anim = 7018
ID = 7018
Pos = 8,-40
vel = 0,0
sprpriority = 20
removetime = 47
shadow = -1,0,0
scale = 1,1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 40
value = S7000,ifelse(random<500,2,3)

[State 1105, 2]
type = ScreenBound
trigger1 = Time >= 0
value = 0


[State 1105, 5]
type = ChangeState
trigger1 = animtime = 0
value = 7000
ctrl = 0

;-------------------------------------------------------------------------------
;Sword Goon Stand ready to fight
;-------------------------------------------------------------------------------
[Statedef 7000,Sword Goon STAND]
type = S
movetype = I
physics = N
velset = 0,0
anim = 7000
sprpriority = 3


[State 1106, Hit]
type = HitOverRide
trigger1 = 1
time = -1
attr = SCA, AA,AP,AT
slot = 0
stateno = 7015

[State 1110, 0]
type = Varrandom
trigger1 = time >= 0
v = 2
persistent = 30

[State 1110, ATTACK]
type = changestate
triggerall = (p2statetype!=L) && random <40
trigger1 = p2bodydist x = [-50,50]
value = 7010
ctrl = 0

[State 1110, Walk]
type = changestate
trigger1 = var(2) >= 200
trigger1 = P2BodyDist X >= -70
value = 7005
ctrl = 0

[State 1110, TURN]
type = changestate
trigger1 = P2BodyDist X < -70
value = 7003
ctrl = 0

