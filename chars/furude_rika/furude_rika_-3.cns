[Statedef -3]

;これはジャンプ後とバックステップ後に着地音を鳴らすコントローラです。
[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ後の着地
trigger2 = stateno = 106 ;バックステップ後の着地
value = s2, 0

[State -3]
type =Poweradd
trigger1 = var(50) >= 1
Trigger1 = GameTime % 2 = 0
value = 3

;以下は廃止
;■■覚醒後のLife自動回復■■■
;[State -3]
;type =lifeadd
;trigger1 = var(50)>=1
;trigger1 = life <=200
;Trigger1 = GameTime % 15 = 0
;trigger1 = lose = 0
;value = 1


;プレイヤーが負けたかどうかの判定
[State -1] 
type=varset
trigger1 = Lose
trigger1 = var(50)=0
var(50) = 1

