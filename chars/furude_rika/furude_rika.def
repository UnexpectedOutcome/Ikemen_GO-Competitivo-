;-----基本情報------------------------------------------------------

[Info]
Name         = "furude_rika"   ;キャラの名前（後々必要な場合があるので省略不可）
DisplayName  = "Furude_Rika"   ;ゲーム中表示される名前（省略可能）
VersionDate  = 03,02,2009      ;キャラの最終更新日
MugenVersion = 04,14,2002      ;このキャラを使用出来るM.U.G.E.Nのバージョン
Author       = "baggy"      ;このキャラの作成者の名前
Pal.Defaults = 2,3,4         ;CPUで出てくるキャラカラーの順番

[Files]
Cmd      = furude_rika.cmd          ;入力コマンド定義ファイルの登録
Cns      = furude_rika.cns          ;基本ステータス情報ファイルの登録
St       = furude_rika_st.cns          ;動作プログラムファイルの登録（最大１０個くらい増やせます（St,St0,St1,St2......））
St1      = furude_rika_st1.cns
St2      = furude_rika_-2.cns
St3      = furude_rika_-3.cns
;St4      = furude_rika_AI.cns
StCommon = common1.cns      ;コモン動作プログラムファイルの登録
Sprite   = furude_rika.sff          ;複数のPCX画像を１パック化したスプライトファイルの登録
Anim     = furude_rika.air          ;アニメーションファイルの登録
Sound    = furude_rika.snd          ;複数のWAV音声を１パック化したサウンドファイルの登録
movelist = movelist.dat

;---カラーパレットファイルの設定（最大１２個まで可能）---

Pal1 = furude_rika1.act              ;Ａボタンで決定した色が使えます
Pal2 = furude_rika2.act             ;Ｂボタンで決定
Pal3 = furude_rika3.act             ;Ｃボタンで決定
Pal4 = furude_rika4.act             ;Ｘボタンで決定
Pal5 = furude_rika1.act             ;Ｙボタンで決定
Pal6 = furude_rika1.act             ;Ｚボタンで決定

Pal7 = furude_rika1.act     ;Ｓ押しながらＡボタンで決定した色が使えます
Pal8 = furude_rika2.act     ;Ｓ押しながらＢボタンで決定した色が使えます
Pal9 = furude_rika3.act     ;Ｓ押しながらＣボタンで決定した色が使えます
Pal10= furude_rika4.act     ;Ｓ押しながらＸボタンで決定した色が使えます
Pal11= furude_rika1.act     ;Ｓ押しながらＹボタンで決定した色が使えます
Pal12= furude_rika1.act     ;Ｓ押しながらＺボタンで決定した色が使えます

;-----ストーリーボード設定------------------------------------------
[Arcade]
;Intro.Storyboard  = intro.def
;Ending.Storyboard = ending.def
