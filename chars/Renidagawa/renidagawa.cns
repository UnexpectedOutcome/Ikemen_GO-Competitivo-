[Velocity]
walk.fwd  = 2.26 ;!
walk.back = -2.26 ;!
run.fwd  = 4.5,-3.8 ;!
run.back = -4.5,-3.8;!
jump.neu = 0,-9 ;-7.5
jump.back = -2.5
jump.fwd = 2.5
runjump.back = -2
