[SceneDef]
spr = ending.sff       ;Filename of sprite file to use


[Scene 0]
fadein.time = 30       ;30 ticks (0.5 seconds) for fade-in
fadeout.time = 30      ;30 ticks for fade-out
; Overlay Anims (from 0 to 9)
layerall.pos = 160,120 
layer0.anim =  0       ;Anim action number for slideshow pictures
layer1.anim =  1       ;Anim action number for title
layer2.anim =  2
layer3.anim =  3
layer4.anim = 4
; Total time
end.time = 2100

;Animation to use for pictures
[Begin Action 0]
3,0, 0,0, 2100

;Animation to use for title
[Begin Action 1]
3,1, 0,0, 2100,,A

;Animation to use for title
[Begin Action 2]
3,2, 0,0, 2100,,A

;Animation to use for title
[Begin Action 3]
1,0, 0,0, 2100,,AS128D128

;Animation to use for pictures
[Begin Action 4]
2,0, 0,0, 300
2,1, 0,0, 300
2,2, 0,0, 300
2,3, 0,0, 300
2,4, 0,0, 300
2,6, 0,0, 300
2,7, 0,0, 300
