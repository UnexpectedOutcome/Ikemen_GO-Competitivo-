; 技を実行するための条件の設定（ステートエントリーパート）
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Statedef -1];(左の記述←は絶対に消さないで下さい)
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;セーラーサターン　AI設定 （㍻㌢さんのAI説明書を参考にさしてもらいました。）
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1, AIフラグセット]
type = Varset
triggerall = !var(59)
triggerall = RoundState = [1,2]
trigger1 = Command = "AI0" ||Command = "AI1" ||Command = "AI2" ||Command = "AI3"
trigger2 = Command = "AI4" ||Command = "AI5" ||Command = "AI6" ||Command = "AI7"
trigger3 = Command = "AI8" ||Command = "AI9" ||Command = "AI10"||Command = "AI11"
trigger4 = Command = "AI12"||Command = "AI13"||Command = "AI14"||Command = "AI15"
trigger5 = Command = "AI16"||Command = "AI17"||Command = "AI18"||Command = "AI19"
trigger6 = Command = "AI20"||Command = "AI21"||Command = "AI22"||Command = "AI23"
trigger7 = Command = "AI24"||Command = "AI25"||Command = "AI26"||Command = "AI27"
trigger8 = Command = "AI28"||Command = "AI29"||Command = "AI30"||Command = "AI31"
trigger9 = Command = "AI32"||Command = "AI33"||Command = "AI34"||Command = "AI35"
trigger10= Command = "AI36"||Command = "AI37"||Command = "AI38"||Command = "AI39"
trigger11= Command = "AI40"||Command = "AI41"||Command = "AI42"||Command = "AI43"
trigger12= Command = "AI44"||Command = "AI45"||Command = "AI46"||Command = "AI47"
trigger13= Command = "AI48"||Command = "AI49"||Command = "AI50"||Command = "AI51"
trigger14= Command = "AI52"||Command = "AI53"||Command = "AI54"||Command = "AI55"
trigger15= Command = "AI56"||Command = "AI57"||Command = "AI58"||Command = "AI59"
trigger16= Command = "AI60"
trigger17 = NumHelper(9000) > 0 && RoundState = 2
trigger17 = Helper(9000),Var(1) = 1
IgnoreHitPause = 1
var(59)  = 10;レベル変更場所。デフォ:10
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;Varset
;━━━━━━━━━━━━━━━━━
[State -1, タッグ用生死判別]
Type           = VarSet
triggerall     = var(59)>0
triggerall     = RoundState = 2
trigger1       = NumEnemy = 1
trigger2       = NumEnemy = 2
trigger2       = EnemyNear(0),life>0
var(58)        = 0
IgnoreHitPause = 1

[State -1, タッグ用生死判別]
Type           = VarSet
triggerall     = var(59)>0
triggerall     = RoundState = 2
trigger1       = NumEnemy = 2
trigger1       = EnemyNear(0),life<=0
var(58)        = 1
IgnoreHitPause = 1

[State -1, AIエリアルコンボ用]
Type       = VarSet
TriggerAll = var(59)>0
Trigger1   = stateno = 45
V          = 57
value      = 1

[State -1, AIエリアルコンボ用解除]
Type       = VarSet
TriggerAll = var(59)>0
Trigger1   = stateno = 52
V          = 57
value      = 0

[State -1, 当身成功フラグ]
Type       = varset
TriggerAll = var(59)>0
Trigger1   = stateno = 107
Trigger2   = stateno = 117
Trigger3   = stateno = 109
Trigger4   = stateno = 119
V          = 50
value      = 1

[State -1, 当身フラグ解除]
Type       = VarSet
TriggerAll = var(59)>0
Trigger1   = movetype = A
Trigger2   = p2movetype = H
V          = 50
value      = 0
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
