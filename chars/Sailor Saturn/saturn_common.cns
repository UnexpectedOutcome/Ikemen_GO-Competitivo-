type     = S
movetype = H
physics  = S

[State 5001, HitDefの速度] ;受けたHitdefが指定した速度を有効にする
type     = HitVelSet
trigger1 = time = 0
x        = 1 ;0で無効、1で有効

[State 5001, アニメ変更]
type     = ChangeAnim
trigger1 = animtime = 0
value    = 5005 + gethitvar(animtype) + (gethitvar(groundtype)=2)*10

[State 5001, 速度乗算] ;ノックバックを終了
