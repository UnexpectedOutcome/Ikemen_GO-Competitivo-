[State 5110, アニメ変更] ;Hit ground anim (for hit up)
type       = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1   = anim = [5161,5169]
trigger1   = SelfAnimExist(5170 + (anim % 10))
value      = 5170 + (anim % 10)

[State 5110, 落下ダメージ]
