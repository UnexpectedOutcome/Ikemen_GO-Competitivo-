movetype = H
physics  = N

[State 5071, 1]
type     = HitVelSet
trigger1 = time = 0
x        = 1
y        = 1

[State 5071, 速度増減] ;Acceleration
type     = VelAdd
trigger1 = 1
y        = gethitvar(yaccel)

[State 5071, ステ変更] ;Hit ground
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 15
type     = ChangeState
value    = 5110
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ダウン中やられ（硬直中）
;━━━━━━━━━━━━━━━━
[Statedef 5080]
type     = L
movetype = H
physics  = N
velset   = 0,0

[State 5080, 1] ;Set default anim
type      = VarSet
trigger1  = time = 0
sysvar(2) = ifelse (gethitvar(yvel) = 0, 5080, 5090)

[State 5080, 2]
type      = VarAdd
trigger1  = time = 0
trigger1  = (anim = [5081,5089]) || (anim = [5111,5119])
trigger1  = SelfAnimExist(sysvar(2) + (anim % 10))
sysvar(2) = anim % 10

[State 5080, 3] ;If 5090 doesn't exist, default to 5030
type      = VarSet
trigger1  = time = 0
trigger1  = sysvar(2) = 5090
trigger1  = !SelfAnimExist(5090)
sysvar(2) = 5030

[State 5080, アニメ変更] ;Freeze
type     = ChangeAnim
trigger1 = 1
value    = sysvar(2)

[State 5080, ステ変更]
type     = ChangeState
trigger1 = HitShakeOver
trigger1 = gethitvar(yvel) = 0
value    = 5081 ;HITL_SLIDE

[State 5080, ステ変更]
type     = ChangeState
trigger1 = HitShakeOver
trigger1 = gethitvar(yvel) != 0
value    = 5030 ;HITA_UP
