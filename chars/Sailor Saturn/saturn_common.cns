;登場時音声
trigger1 = 1 || var(25) := 5900;snd親番号
trigger1 = 1 || var(26) := 0;snd子番号
;カットイン音声
trigger1 = 1 || var(27) := 5120;snd親番号
trigger1 = 1 || var(28) := 0;snd子番号
;ロゴのアニメ(使用するアニメのair軸位置調整はなるべく中央に配置)
