trigger1    = !SysVar(0)
anim        = 6020
scale       = 1,1
postype     = p1
pos         = 0,0
sprpriority = 1
supermove   = 1
ownpal      = 1
ID          = 6020

[State 5110, 8]
type     = VelSet
trigger1 = Time = 0
y        = 0

[State 5110, アニメ変更] ;For hit up type
