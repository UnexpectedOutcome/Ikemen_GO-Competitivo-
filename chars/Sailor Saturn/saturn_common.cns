;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;			基本動作
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ニュートラル
;━━━━━━━━━━━━━━━━
[Statedef 0]
type        = S
physics     = S
sprpriority = 0

[State 0, アニメ変更] ;振り向き動作から移行
type     = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value    = 0

[State 0, 軸位置] ;地上に戻す
type     = PosSet
trigger1 = time = 0
y        = 0

[State 0, 移動速度] ;Y方向の速度を0に
type     = VelSet
trigger1 = time = 0
y        = 0

[State 0, 移動速度] ;低速になるか4フレーム経過で停止
type     = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x        = 0

[State 0, ステ変更] ;生存判定
type     = ChangeState
trigger1 = !alive
value    = 5050

[State 0, ヘルパー分身バグ対策]
Type           = DestroySelf
Trigger1       = IsHelper
IgnoreHitPause = 1
SuperMoveTime  = 9999
PauseMoveTime  = 9999
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;立ち→しゃがみ
;━━━━━━━━━━━━━━━━
[Statedef 10]
type    = C
physics = C
anim    = 10

[State 10, 速度乗算]
type     = VelMul
trigger1 = Time = 0
x        = .75

[State 10, ステ変更]
type     = ChangeState
trigger1 = AnimTime = 0
value    = 11
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;しゃがみ
;━━━━━━━━━━━━━━━━
[Statedef 11]
type        = C
physics     = C
anim        = 11
sprpriority = 0

[State 11, アニメ変更] ;振り向き動作から移行
type     = ChangeAnim
trigger1 = Anim = 6&&AnimTime = 0
value    = 11

[State 11, ヘルパー分身バグ対策]
Type           = DestroySelf
Trigger1       = IsHelper
IgnoreHitPause = 1
SuperMoveTime  = 9999
PauseMoveTime  = 9999
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;しゃがみ→立ち
;━━━━━━━━━━━━━━━━
[Statedef 12]
type    = S
physics = S
anim    = 12

[State 12, ステ変更]
type     = ChangeState
trigger1 = AnimTime = 0
value    = 0
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;前進＆後退
;━━━━━━━━━━━━━━━━
[Statedef 20]
type        = S
physics     = S
ctrl        = 1
sprpriority = 0

[State 20, AI]
Type       = ChangeState
Value      = 105
TriggerAll = Var(59) > 0
TriggerAll = StateType != A
Trigger1   = P2MoveType = A
Trigger1   = EnemyNear(Var(58)),HitDefAttr = SCA, NT, ST, HT
Trigger1   = Time = 0

[State 20, 移動速度] ;前進
type       = VelSet 
triggerall = var(59) = 0 
trigger1   = command = "holdfwd" 
x          = const(velocity.walk.fwd.x)

[State 20, 移動速度] ;後退
type       = VelSet 
triggerall = var(59) = 0 
trigger1   = command = "holdback" 
x          = const(velocity.walk.back.x)

[State 20, AI移動速度] ;前進
type       = VelSet 
triggerall = var(59)>0&&RoundState = 2 
trigger1   = p2statetype != L&&P2BodyDist X>=0 
trigger2   = p2statetype=L&&P2BodyDist X>=70 
x          = const(velocity.walk.fwd.x)

[State 20, AI移動速度] ;後退
type       = VelSet 
triggerall = var(59)>0&&RoundState = 2 
trigger1   = p2statetype=L&&P2BodyDist X<=50 
x          = const(velocity.walk.back.x) 

[State 20, アニメ変更] ;前進
type       = ChangeAnim
triggerall = vel x > 0
trigger1   = Anim != 20 && Anim != 5
trigger2   = Anim = 5 && AnimTime = 0
value      = 20

[State 20, アニメ変更] ;後退
type       = ChangeAnim
triggerall = vel x < 0
trigger1   = Anim != 21 && Anim != 5
trigger2   = Anim = 5 && AnimTime = 0
value      = 21

[State 20, AIステ変更]
Type           = ChangeState
TriggerAll     = Var(59) > 0
Trigger1       = P2StateType != L
Trigger1       = P2BodyDist X < 0
Trigger2       = P2StateType = L
Trigger2       = P2BodyDist X = [50,70]
Value          = 0
Ctrl           = 1
IgnoreHitPause = 1
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;前進
[Statedef 21]
type        = S
physics     = S
ctrl        = 1
anim        = 20
sprpriority = 1

[State 21, 振り向き]
type     = Turn
trigger1 = P2dist X < 0

[State 21, 移動速度]
type     = VelSet
trigger1 = 1
x        = const(velocity.walk.fwd.x)

[State 21,ステ変更]
type           = Changestate
trigger1       = roundstate != 2
value          = 0
ctrl           = 1
IgnoreHitPause = 1
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;後退
[Statedef 22]
type        = S
physics     = S
ctrl        = 1
anim        = 20
sprpriority = 1

[State 22, 振り向き]
type     = Turn
trigger1 = P2dist X < 0

[state 22, 移動速度]
type     = VelSet
trigger1 = 1
x        = const(velocity.walk.back.x)

[State 22,ステ変更]
type           = Changestate
trigger1       = roundstate != 2
value          = 0
ctrl           = 1
IgnoreHitPause = 1
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ジャンプ開始（まだ地上）
;━━━━━━━━━━━━━━━━
[Statedef 40] 
type        = S 
physics     = S 
ctrl        = 0 
sprpriority = 1 

[State 40,ジャンプ方向制御.1]
Type     = VarSet
Trigger1 = Time = 0
V        = 20
value    = 0

[State 40,ジャンプ方向制御.2]
Type     = VarSet
Trigger1 = Time = 0
V        = 22
Value    = 0

[State 40, 無敵]
type	 = NotHitBy
trigger1 = 1
value	 = SC,AT

[State 40, 垂直] 
Type      = VarSet 
Trigger1  = var(59)=0
Trigger1  = Time = 0 
sysvar(1) = 0  

[State 40, 前]
Type      = VarSet
Trigger1  = var(59)=0
Trigger1  = command = "holdfwd"
Trigger2  = var(59)>0&&var(50)!=1
Trigger2  = EnemyNear,StateType != L||P2BodyDist X>=-5
Trigger2  = EnemyNear,MoveType = H||Random<=Var(59)*100||EnemyNear,StateType = L
sysvar(1) = 1

[State 40, 後]
type      = VarSet
Trigger1  = var(59)=0
Trigger1  = command = "holdback"
Trigger2  = var(59)>0&&var(50)!=1
Trigger2  = EnemyNear,StateType != L
Trigger2  = EnemyNear,MoveType != H
Trigger2  = BackEdgeBodyDist>150
Trigger2  = Var(59)*100
sysvar(1) = -1

[State 40, 2]
type       = ChangeAnim
triggerall = Time = 0
trigger1   = sysvar(1) = 0
value      = 40

[State 40, 2]
type       = ChangeAnim
triggerall = Time = 0
trigger1   = sysvar(1) = 1
value      = 40

[State 40, 2]
type       = ChangeAnim
triggerall = Time = 0
trigger1   = sysvar(1) = -1
value      = 40

[State 40, 4] 
type     = VelSet 
trigger1 = AnimTime = 0 
x        = ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))
y        = const(velocity.jump.y) 

[State 40, 5] 
type     = VelSet 
trigger1 = AnimTime = 0 
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1 
x        = const(velocity.runjump.fwd.x) 

[State 40, ステ変更] 
type     = ChangeState 
trigger1 = AnimTime = 0 
value    = 50 
ctrl     = 1
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 
;ジャンプ開始
;━━━━━━━━━━━━━━━━
[Statedef 45]
type        = A
physics     = N
ctrl        = 0
velset      = 0,0

[State 45, 1]
type     = ChangeAnim
trigger1 = SelfAnimExist(44)
value    = 44

[State 45, 2]
type     = ChangeAnim
trigger1 = !SelfAnimExist(44)
value    = 41

[State 45, 3]
type      = VarSet
trigger1  = Time = 0
sysvar(1) = 0

[State 45, 垂直]
Type       = VarSet
TriggerAll = Var(59)>0
TriggerAll = Time=0
Trigger1   = EnemyNear,StateType!=L
Trigger1   = EnemyNear,MoveType=H
Trigger1   = P2BodyDist X=[-120,-10]
Trigger2   = EnemyNear,MoveType!=H || EnemyNear,StateType=L
Trigger2   = P2BodyDist X>120
Trigger2   = Random=[500,799]
Trigger3   = EnemyNear,MoveType!=H
Trigger3   = P2BodyDist X<=80
sysvar(1)  = 0

[State 45, 前]
Type       = VarSet
TriggerAll = Var(59)>0
TriggerAll = Time=0
Trigger1   = P2BodyDist X>-10
Trigger1   = EnemyNear,MoveType=H
Trigger2   = EnemyNear,MoveType!=H || EnemyNear,StateType=L
Trigger2   = P2BodyDist X>120
Trigger2   = Random=[0,499]
Trigger3   = SysVar(3)=1
Trigger4   = Var(10)=1
sysvar(1)  = 1

[State 45, 後]
Type       = VarSet
TriggerAll = Var(59)>0
TriggerAll = Time=0
Trigger1   = EnemyNear,StateType!=L
Trigger1   = EnemyNear,MoveType=H
Trigger1   = P2BodyDist X<-120
Trigger2   = EnemyNear,MoveType!=H
Trigger2   = P2BodyDist X>120
Trigger2   = Random=[800,999]
sysvar(1)  = -1

[State 45,4]
type      = VarSet
trigger1  = command = "holdfwd"
sysvar(1) = 1

[State 45,5]
type      = VarSet
trigger1  = command = "holdback"
sysvar(1) = -1

[State 45,6]
type     = VelSet
trigger1 = Time = 2
x        = ifelse(sysvar(1)=0,const(velocity.airjump.neu.x),ifelse(sysvar(1)=1,const(velocity.airjump.fwd.x),const(velocity.airjump.back.x)))
y        = const(velocity.airjump.y)

[State 45,7]
type     = ChangeState
trigger1 = Time = 2
value    = 50
ctrl     = 1
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ジャンプ中
;━━━━━━━━━━━━━━━━
[Statedef 50]
type    = A
physics = A

[State 50, ジャンプ方向制御]
type      = VarSet
trigger1  = Time = 0
sysvar(1) = 0

[State 50, アニメ変更]
type     = ChangeAnim
trigger1 = Time = 0
value    = ifelse((vel x)=0,41,ifelse((vel x)>0, 42, 43))

[State 50, アニメ変更(着地するか否か)]
type       = ChangeAnim
trigger1   = Vel y > -2
trigger1   = SelfAnimExist(anim + 3)
persistent = 0
value      = Anim + 3
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
