;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2 + var(50)

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = velset
trigger1 = var(51) = 1 && time = 0 && prevstateno = [20320,20321]
x = 0

[State 120, Stop Guarding]
type = ChangeState
trigger1 = var(51) != 1 && command != "holdback"
trigger2 = !inguarddist
trigger3 = var(51) = 1 && time > 1 + random%10
value = 140

[State 120, Stop Guarding]
type = ChangeState
triggerall = var(51) = 1 && time > 1 + random%10
trigger1 = Enemy,HitDefAttr=SCA,AT
trigger2 = Enemy,HitDefAttr=SCA,NT
trigger3 = Enemy,HitDefAttr=SCA,ST
trigger4 = Enemy,HitDefAttr=SCA,HT
value = 105
