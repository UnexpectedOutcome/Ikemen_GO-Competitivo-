;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 + var(50) && Anim != 5 + var(50)
trigger2 = Anim = 5 + var(50) && AnimTime = 0 ;Turn anim over
value = 0 + var(50)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10 + var(50)

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11 + var(50)
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 + var(50) && AnimTime = 0
value = 11 + var(50)

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12 + var(50)

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = ifelse(var(50) > 0,const(velocity.walk.fwd.x),const(velocity.walk.fwd.x) + .5)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = ifelse(var(50) > 0,const(velocity.walk.back.x),const(velocity.walk.back.x) - .25)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 + var(50) && Anim != 5 + var(50)
trigger2 = Anim = 5 + var(50) && AnimTime = 0
value = 20 + var(50)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 + var(50) && Anim != 5 + var(50)
trigger2 = Anim = 5 + var(50) && AnimTime = 0
value = 21 + var(50)

; Walk AI
[Statedef 20320]
type    = S
physics = N
anim = 20
velset = const(velocity.walk.fwd.x) + .5
ctrl = 0
sprpriority = 0

[State -3, Landing Sound]
type = PlaySnd
trigger1 = animelem = 10
trigger2 = animelem = 20
value = 40, ifelse(random%10<3,7,ifelse(random%10>5,8,9))

[State 20, AI]
type = changestate
trigger1 = random <= 333
trigger1 = animtime = 0 && p2bodydist x > 100 && p2movetype != A
value = 100

[State 20, AI]
type = changestate
triggerall = time > 0
trigger1 = p2bodydist X <= 50
trigger2 = animtime = 0
trigger3 = InGuardDist
trigger4 = p2bodydist X < 0
value = 0
ctrl = 1

[State 20, AI]
type = ChangeState
trigger1 = random <= 333
trigger1 = p2movetype = A || InGuardDist
trigger2 = p2movetype = A || InGuardDist || enemynear,NumProj > 0
trigger2 = P2BodyDist X >= 100 || statetype = A
value = 120

; Walk AI
[Statedef 20321]
type    = S
physics = N
anim = 21
velset = const(velocity.walk.back.x) - .25
ctrl = 0
sprpriority = 0

[State -3, Landing Sound]
type = PlaySnd
trigger1 = animelem = 10
trigger2 = animelem = 20
value = 40, ifelse(random%10<3,7,ifelse(random%10>5,8,9))

[State 20, AI]
type = changestate
trigger1 = random <= 333
trigger1 = animtime = 0 && p2bodydist x > 100 && p2movetype != A
value = 100

[State 20, AI]
type = changestate
triggerall = time > 0
trigger1 = p2bodydist X <= 50
trigger2 = animtime = 0
trigger3 = InGuardDist
trigger4 = p2bodydist X < 0
value = 0
ctrl = 1

[State 20, AI]
type = ChangeState
trigger1 = random <= 333
trigger1 = p2movetype = A || InGuardDist
trigger2 = p2movetype = A || InGuardDist || enemynear,NumProj > 0
trigger2 = P2BodyDist X >= 100 || statetype = A
value = 120

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40 + var(50)
velset = 0,0
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = ChangeState
trigger1 = Anim = 40 && AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
value = 60

[State 40, 6]
type = Veladd
trigger1 = Anim = 40 && AnimTime = 0
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, 1.5, -2))
y = -1.5

[State 1027, Spark]
type = Explod
trigger1 = Time = 4 && var(50) = 0 && prevstateno != 100
anim = 10220
ID = 10220
PosType = P1
scale = .25,.25
pos = ifelse(sysvar(1)>=0,-5,5), 0
facing = ifelse(sysvar(1)>=0,1,-1)
vel = ifelse(sysvar(1)>=0,-.25,.25),0
OwnPal = 1
sprpriority = -9
persistent = 0

[State 1027, Spark]
type = Explod
trigger1 = Time = 4 && var(50) = 0 && prevstateno = 100
anim = 10220
ID = 10220
PosType = P1
scale = .35,.35
pos = -15, 0
vel = -.5,0
OwnPal = 1
sprpriority = -9
persistent = 0

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

[State 20, AI]
type = changestate
trigger1 = var(51) = 1 && time = 0
value = 40321

