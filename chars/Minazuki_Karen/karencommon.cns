trigger2 = var(51) = 1 && time > 1 + (random%10)*5
trigger2 = Enemynear, HitDefAttr = C, AA, SA ,HA ,AP, SP, HP
trigger3 = var(51) = 1 && time > 1 + (random%10)*2
trigger3 = p2statetype = C
value = 131

[State 130, Stop Guarding]
type = ChangeState
trigger1 = var(51) != 1 && command != "holdback"
trigger2 = !inguarddist
trigger3 = var(51) = 1 && time > (random%10)*5
trigger3 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; CROUCH GUARD (guarding)
[Statedef 131]
type    = C
physics = C

[State 131, 1]
type = ChangeAnim
trigger1 = Anim != 131 + var(50)
value = 131 + var(50)

[State 131, Lo to Hi]
type = ChangeState
trigger1 = command != "holddown"
trigger2 = var(51) = 1 && time > 1 + (random%10)*5
trigger2 = Enemynear, HitDefAttr = SA, AA, SA ,HA ,AP, SP, HP
value = 130

[State 131, Stop Guarding]
type = ChangeState
trigger1 = var(51) != 1 && command != "holdback"
trigger2 = !inguarddist
trigger3 = var(51) = 1 && time > (random%10)*5
trigger3 = !inguarddist
value = 140

