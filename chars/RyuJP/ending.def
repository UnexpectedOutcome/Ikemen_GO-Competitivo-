[SceneDef]
spr = ending.sff ; The Graphcis File For ElvenKing's Ending
startscene = 0       ; Start on Scene 0, The first Scene

;----------------------------------------------------------
[Scene 0]
;----------------------------------------------------------
;fadein.time = 63             ; Time to take for Fading In
;fadein.col = 0,0,0           ; Black Fade in....
;fadeout.time = 20            ; Time to take for Fading out
;fadeout.col = 0,0,0     ; White Fade out...
clearcolor = 0,0,0     ; Color behind the images (Black)
layerall.pos = 160,0         ; Default position for all layers
layer0.anim =  5             ; Background, The Bio Screen 1
layer0.offset = 20,34        ; Position offset
layer0.starttime = 0         ; Time to start display
layer2.anim =  11            ; The first Line of Text animation
layer2.offset = 20,34       ; The Text Image offset
layer2.starttime = 0         ; Time to start display
layer1.anim =  12            ; The first Line of Text animation
layer1.offset = 20,34       ; The Text Image offset
layer3.anim =  3           ; The first Line of Text animation
layer3.offset = 20,34        ; The Text Image offset
layer4.anim =  16            ; The first Line of Text animation
layer4.offset = 20,34         ; The Text Image offset
layer4.starttime = 0         ; Time to start display
bgm = ryusfaend.mid ; Plays the SFA3 Bio screen music
;bgm.loop = 3                 ; BG Music loops 1 time
volume = 1000                 ; Volume of the BG Music
end.time = 370               ; How long the scene is

