------------------------------------------------------------------------------
[Statedef 999999]; Super Armor

;-----------------------------------------------------------------------------
type = A
movetype = I
physics = N
anim = 9999
sprpriority = 0

[State 9000, 0/CHs];
type = ChangeState
trigger1 = !IsHelper
value = 0
ctrl = 1

[State 9000, 0/Ass]
type = AssertSpecial
trigger1 = Time = 0 || Anim != Parent,Anim
trigger2 = Parent,StateNo = 2432
flag = Invisible

[State 9000, 0/NHB]
type= NotHitBy
trigger1 = 1
value = SCA, NT, ST, HT ,NA, SA, HA ,NP, SP, HP, AA, AP, AT
time = -1

[State 9000, -1/Tra]
type=trans
trigger1=1
trans = addalpha
alpha = 256,130

[State 9000, -1/Ass]
type= AssertSpecial
trigger1 = 1
flag = NoShadow

[State 9000, -1/Pos]
type = BindToParent
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 9000, -1/CHa]
type = ChangeAnim
trigger1 = SelfAnimExist(Parent,Anim)
value = Parent,Anim
elem = Parent,AnimElemNo(0)

[State 9000, -1/Var]
type = VarAdd
trigger1 = fvar(0) < 30
fvar(0) = 3

[State 9000, -1/Agl]
type = AngleDraw
trigger1 = 1
scale = (134-fvar(0))*0.01,(132-fvar(0))*0.01

[State 9000, -1/Var]
type = VarSet
trigger1 = 1
fvar(1) = IfElse(GetHitVar(damage),1,IfElse(Time<20,fvar(1),0))

[State 9000, -1/Pal]

type = PalFX
trigger1 = fvar(1) = 0 && Time%20 = 0
trigger2 = fvar(1) = 1 && Time%4 = 0
time = IfElse(fvar(1)=1,2,10)
add = 256,256,0
mul = 256,256,0

[State 9000, -1/Pal]
type= PalFX
trigger1 = fvar(1) = 0 && Time%20 = 10
trigger2 = fvar(1) = 1 && Time%4 = 2
time = IfElse(fvar(1)=1,2,10)
add = 256,0,0
mul = 256,0,0

[State 9000, ChangeAnim]
type = ChangeAnim
trigger1 = 1
value = parent,Anim
elem = parent, AnimElemNo(0)
ignorehitpause =1
persistent=1

[State 9000, -1/Ds]
type = DestroySelf
trigger1 = Parent,StateNo != 200
trigger1 = Parent,StateNo != 230
trigger1 = Parent,StateNo != 240
trigger1 = Parent,StateNo != 1100
trigger1 = Parent,StateNo != 2500
trigger1 = Parent,StateNo != 2310
trigger1 = Parent,StateNo != 2900
