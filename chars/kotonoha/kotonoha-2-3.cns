;-----------------------------------------------------------------------------
;常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------

[Statedef -2]

[State -2, パワー溜め];音声ストップ
type = stopsnd
trigger1 = stateno != 700
trigger1 = stateno != 750
channel = 3

[State -2, stopsnd]
type = stopSnd
trigger1 = MoveType = H
channel = 2

;-----------------------------------------------------------------------------------------------
;エフェクト消し

[State -2, エフェクトを消す];パワー溜めのエフェクト
type = RemoveExplod
trigger1 = StateNo != 700
trigger1 = stateno != 750
trigger2 = MoveType != I
ID = 701

;---------------------------------------------------------------------------

;Ctrl+Dの白い文字のデバッグモード表示を加える
[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 1
text = "Var(5)-Button=%d,Pos X=%d,Y=%d"
params = var(5),floor(Pos X),floor(Pos Y)

[State -2, 喰らい]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
trigger4 = stateno = 5070
value = 9998, random % 3

[State -2, 喰らい]
type = PlaySnd
trigger1 = time = 1
trigger1 = stateno = 5100
value = 9999, 1

;---------------------------------------------------------------------------
;一度負けたかどうかの判定

[State -1] 
type=varadd
trigger1 = lose
trigger1 = var(50)=0
var(50) = 1

;---------------------------------------------------------------------------
;パワー自動回復

[State -3]
type =Poweradd
trigger1 = var(50) >= 1
value = 1

;---------------------------------------------------------------------------
;常時ヒート

[State -1, AfterImage]
type = AfterImage
trigger1 = AnimElem = 1
Trigger1 = var(50) >=1
trans = Add
TimeGap = 1
FrameGap = 3
time = 99999
PalBright = 0,0,0
PalContrast = 70,70,70
PalAdd = 0,0,160
PalMul = 1,1,1

;---------------------------------------------------------------------------
;ヒート
[State -3, AfterImage]
Type = AfterImage
Trigger1 = Var(56) = 1
Trigger1 = var(50) =0
trans = Add
time = -1
TimeGap = 1
FrameGap = 3
time = 99999
PalBright = 0,0,0
PalContrast = 70,70,70
PalAdd = 10,10,0
PalMul = 1,1,1

[State -1, AfterImage]
Type = varadd
Trigger1 = Var(56) = 1
v =56
value =1

[State -3]
type =varadd
trigger1 = var(56)>=1
v = 55
value = -1

[State -3, AfterImage]
Type = AfterImage;Time
Trigger1 = Var(56) = 2
trigger1 = var(55) <=0
trigger1 = var(50) = 0
Time        = 1

[State -3]
type =varset
trigger1 = var(55)<0
v = 56
value = 0

;---------------------------------------------------------------------------
;攻撃力変化

[State -3]
type = AttackMulSet
Trigger1 = var(50) >=1
value = 1.4

;---------------------------------------------------------------------------
;防御力変化

[State -1, DefenceMulSet]
Type = DefenceMulSet
Trigger1 = var(50) >=1
Value = 0.6

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------


