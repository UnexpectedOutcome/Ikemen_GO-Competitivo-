;---------------------------------------------------------------------------
;Custom Wall bound (Back Hit) 1-1
[Statedef 6500]
type    = A
movetype= H
physics = N
sprpriority = 0

[State 0, ChangeAnim2]
type = ChangeAnim2
trigger1 = time = 0
value = 6500

[State 0, HitVelSet]
type = HitVelSet
trigger1 = time = 0
x = 1
y = 1

[State 0, PosFreeze]
type = PosFreeze
trigger1 = !hitshakeover
value = 1

[State 0, VelAdd]
type = VelAdd
trigger1 = hitshakeover
y = gethitvar(yaccel)

[State 0, ChangeState]
type = ChangeState
trigger1 = hitshakeover
trigger1 = backedgebodydist < const(size.air.back)
value = 6501

[State 5000, 1]
type = ChangeAnim
trigger1 = hitshakeover
trigger1 = pos y > -10
trigger1 = vel y > 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 2]
type = ChangeAnim
trigger1 = hitshakeover
trigger1 = pos y > -10
trigger1 = vel y > 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3]
type = ChangeAnim
trigger1 = hitshakeover
trigger1 = pos y > -10
trigger1 = vel y > 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype)

[State 0, SelfState]
type = SelfState
trigger1 = hitshakeover
trigger1 = pos y > -10
trigger1 = vel y > 0
value = 5035

