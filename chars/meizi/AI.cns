triggerall = (var(59) = 1 && RoundState = 2)
triggerall = Statetype != A
triggerall = power >= 300
Triggerall = Ctrl
triggerall = var(18) = 0
trigger1 = var(57) = 1 
;---------------------------------------------------------------------------
; 特殊技パート
;---------------------------------------------------------------------------
[State -3, クイックスタンディング]
type = ChangeState
triggerall = (var(59) = 1 && RoundState = 2)
triggerall = (var(58) = [1,280])
triggerall = (Alive)
;triggerall = (NumEnemy) && (Enemynear,Alive)
triggerall = (MoveType = H)
triggerall = (Var(55) = 0 && random < 100) || (var(55) = 1 && random < 900)
trigger1 = (StateNo = 5110)
value = 10001
IgnoreHitPause = 1
;--------------------------------------------------------------------------
[State -3, 位相転移]
type = ChangeState
value = 1400
triggerall = (var(59) = 1)
triggerall = Movetype = H
triggerall = Stateno = [5000,5110]
triggerall = alive
triggerall = var(39)>=-1
trigger1 = ctrl = 0

;---------------------------------------------------------------------------

[State -3, 遠い間合いで余裕を持って挑発（爆]
type = null;ChangeState
triggerall = (var(59) = 1)
triggerall = (RoundState = 2)
triggerall = (Alive)
;triggerall = (NumEnemy) && (Enemynear,Alive)
triggerall = (Life >= 800)
triggerall = (StateType != A)
trigger1 = (Ctrl) && (EnemyNear,MoveType != A) && (EnemyNear,P2BodyDist X = [161,999])
value = 100
IgnoreHitPause = 1



;---------------------------------------------------------------------------
[State -3, バグ対策];スパイラルフリーズ
type = null;ChangeState
triggerall = (var(59) = 1)
triggerall = (RoundState = 2)
triggerall = (Alive)
;triggerall = (NumEnemy) && (Enemynear,Alive)
triggerall = Ctrl
triggerall = Statetype != A
triggerall = Enemynear,Movetype = H
triggerall = Enemynear,time >= 200
triggerall = Enemynear,Stateno = 1705
trigger1 = 1
value = ifelse(P2BodyDist Y > 50,215,39)
IgnoreHitPause = 1


;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; ■最後に『コモンステート』について■
; コモンステートとは、全キャラ共通の基本動作のステートです。
; 通常は特に変更しない限り、M.U.G.E.N本体のdataフォルダにある
;「common1.cns（コモンステートファイル）」を使います。
;
; しかし、もしもあなたのキャラのステートファイルでcommon1.cnsと同じ番号の
; 基本動作のステートを作った場合は処理が上書きされ、
; common1.cns側の同じ番号のステートは無効になります。
;
; common1.cnsのプログラム優先度は最低に属しているので、
; ステートの作成には番号に注意しないといけません。
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------


