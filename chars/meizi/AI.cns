Value = 120
triggerall = (Alive)
;triggerall = (NumEnemy) && (Enemynear,Alive)
triggerall = var(59) = 1 && RoundState = 2
TriggerAll = stateno = 700 || ctrl || stateno = 100
triggerall = var(18) = 0
trigger1 = var(55) = 0
Trigger1 =! EnemyNear,HitDefAttr = ,NT,ST,HT ;投げ属性以外の攻撃にのみ
Trigger1 = InGuardDist
Trigger1 = Random = [0,0]
