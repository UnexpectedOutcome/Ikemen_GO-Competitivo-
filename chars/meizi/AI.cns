;===========================================================================
; 準常時監視ステート（－３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

;===========================================================================
; 擬似ＡＩプログラム（通称「ＡＩ」）
;===========================================================================
;---------------------------------------------------------------------------
; 誰が最初に始めたかは知らないけど（多分外人）、本来は
;『弱いＣＰＵをもっと強く、そして機敏に動いてくれるようにしよう』
; という主旨の元、MS-DOSの0627版初期から使われだした古いテクニック。
; だいぶ昔に確立されたのに今でも通用するのは正直凄い。
;
; ①ＣＰＵに「人間には入力出来ないコマンド」を入力させる（ＡＩ発動用コマンド）
; ②そのコマンドをＣＰＵが入力した事を「変数で記憶させる」
;
; という流れだけでＡＩスイッチが作れる。後はその変数をフラグにして、
; cmdのステートエントリーの要領でＣＰＵの行動の条件を指定してやればいい。
; しかし行動そのものはキャラ作りの高度なスキルと、
; 作成者自身のセンスが要求されるかもしれない。
;---------------------------------------------------------------------------
; 個人的な話だけど、昔水影さんとＡＩについて話をした事がある。
;「極悪な性能やＡＩ作ればキャラ作りも上手くなる」
; ってあの人言ってたけど、僕はそうは思わない。
; 昔極悪な性能のキャラ作ってた自分自身が言うのも何だけど（苦笑
;（実際極悪にしてても当時僕は全然進歩してなかったし）
; 凶悪なキャラ達を自分のＡＩで討伐しようとしてたのが理由だったけど、
; 気付いたら「ミイラ捕りがミイラになっちゃった」始末。(つД`)
; やってる内に、勝っても嬉しくないし、後味良くないし、イタチゴッコだし、
; 自分自身キャラ作りに求めるものはこんなのじゃなかったはずだし、
; 次第に虚しくなってきちゃって極悪はやめた。
; そこで初心に帰って悟った。
;
;「極悪な性能やＡＩ作っても意味無い、『出来るだけバランス良く弱くする事』が肝心だ」
;
; ＡＩというテクニックはあくまでもＣＰＵの行動を補助するためのものであり、
; アーケードモードで出てきてプレイヤーをてこずらせる程度の強さで良いと思う。
; 絶対倒せないキャラなんておかしい。狂ってる。プレイヤーやユーザーを不快にしてどうする？
; そんなのゲームじゃないよ！｡ﾟ(ﾟつД`ﾟ)ﾟ｡
;『互角』かそれ以下が一番。その方が楽しい。（互角の基準は人それぞれだけどね）
;
; しかし！まともなＡＩを作るのも超極悪な性能のキャラを作るのも、
; あなたの自由。趣味にまで口を出す気は全然無いです。
; 僕はただ持論を披露しただけ(´-`)
;---------------------------------------------------------------------------
; 実際に設定してるのは僕のやり方。無理に覚えなくていいです。
; -3にまとめてるのは、-2だと発動フラグが誤作動しやすくなるためと、
; 単にユニットとして分けてるだけ。僕のＡＩにとって-3は好都合だった。
;
; 強さはノーマルのカンフーマンとウォッチモードで良い勝負をする程度で、
;「オートガード」と「接近すると非常に高い確率で投げを仕掛ける」は
; 大嫌いなので入れてません。真の漢なら正々堂々と打撃と立ち回りだけで魅せろ！
;
; ※神人ＫＦＭ（７Ｐカラー）だけは2008/07/20に試験的にＡＩレベルを強くしてみました。
;---------------------------------------------------------------------------
;ＡＩ発動用フラグ（ＣＰＵが『人間には入力出来ないコマンド』を入力すると１になる）
[Statedef -3]

[State -3, 変数]
type = VarSet
triggerall = (var(59) != 1) && (RoundState < 3)
Trigger1 = Command = "AI_00" || Command = "AI_01" || Command = "AI_02" || Command = "AI_03" || Command = "AI_04"
Trigger2 = Command = "AI_05" || Command = "AI_06" || Command = "AI_07" || Command = "AI_08" || Command = "AI_09"
Trigger3 = Command = "AI_10" || Command = "AI_11" || Command = "AI_12" || Command = "AI_13" || Command = "AI_14"
Trigger4 = Command = "AI_15" || Command = "AI_16" || Command = "AI_17" || Command = "AI_18" || Command = "AI_19"
Trigger5 = Command = "AI_20" || Command = "AI_21" || Command = "AI_22" || Command = "AI_23" || Command = "AI_24"
Trigger6 = Command = "AI_25" || Command = "AI_26" || Command = "AI_27" || Command = "AI_28" || Command = "AI_29"
Trigger7 = Command = "AI_30" || Command = "AI_31" || Command = "AI_32" || Command = "AI_33" || Command = "AI_34"
Trigger8 = Command = "AI_35" || Command = "AI_36" || Command = "AI_37" || Command = "AI_38" || Command = "AI_39"
Trigger9 = Command = "AI_40" || Command = "AI_41" || Command = "AI_42" || Command = "AI_43" || Command = "AI_44"
Trigger10 = Command = "AI_45" || Command = "AI_46" || Command = "AI_47" || Command = "AI_48" || Command = "AI_49"
Trigger11 = Command = "AI_50" || Command = "AI_51" || Command = "AI_52" || Command = "AI_53" || Command = "AI_54"
Trigger12 = Command = "AI_55" || Command = "AI_56" || Command = "AI_57" || Command = "AI_58" || Command = "AI_59"
Trigger13 = Command = "AI_60" || Command = "AI_61" || Command = "AI_62" || Command = "AI_63" || Command = "AI_64"
Trigger14 = Command = "AI_65" || Command = "AI_66" || Command = "AI_67" || Command = "AI_68" || Command = "AI_69"
v = 59
value = 1
IgnoreHitPause = 1
Persistent = 1

[State -3, AI]
Type = VarSet
TriggerAll = Var(59) = 1
Trigger1 = Win = 1
Trigger2 = Lose = 1
Trigger3 = DrawGame = 1
Trigger4 = RoundState = 4
Trigger5 = RoundState = [0,1]
V = 59
Value = -1
IgnoreHitPause = 1

[State -3, AI]
Type = VarSet
Trigger1 = Var(59) = -1
Trigger1 = RoundState = 2
V = 59
Value = 1
IgnoreHitPause = 1

[state -3, 確認用フラグ]
type = null;varset
trigger1 = P2stateno = 50
trigger2 = stateno = 50
fv = 1
value = 3



[State -3, AI用制限解除]
type = ctrlset
triggerall = var(59) = 1 && RoundState < 2
trigger1 = stateno = 0
trigger1 = ctrl = 0
trigger1 = time = 2
value = 1

;ラウンド始めにヘルパー数を調べる
[State -3]
Type = VarSet
TriggerAll = Var(5) = 0
Trigger1 = EnemyNear,NumHelper > 0
Trigger1 = RoundState = 2
V = 5
Value = EnemyNear,NumHelper

[State -3, 変数]	;AIアップ
type = VarSet
triggerall = (RoundState < 3) || fvar(1) = 1
;trigger1 = Life <= 500
trigger1 = lose
v = 55
value = 1
IgnoreHitPause = 1
Persistent = 1

;===========================================================================
;---------------------------------------------------------------------------

[State -3, 変数ランダム];行動確率
type = VarRandom
;triggerall = var(59) = 1 && RoundState = 2
trigger1 = Time = 1
Trigger2 = MoveType = I
trigger2 = (GameTime %60 = 1)
v = 58
range = 0,99
IgnoreHitPause = 1
Persistent = 1

;---------------------------------------------------------------------------
[State -3, 特殊効果]
type = AssertSpecial
trigger1 = (var(59) = 1)
flag = NoJuggleCheck
IgnoreHitPause = 1
Persistent = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; 各種ガード(stateno = 700 , ctrl)
