;---------------------------------------------
[State -2, ジャンプしないようにする処理]
type = ChangeState
triggerall = var(0) = 1 && RoundState <= 5
trigger1 = stateno = 40
value = 0
ctrl = 1
;---------------------------------------

;---------------------------------------------------
;ダメージ時の喰らい音声
;---------------------------------------------------
[State -2]
type = playsnd
triggerall = alive
triggerall = time = 1
trigger1 = stateno = 5000 || stateno = 5010
trigger1 = anim = 5000 || anim = 5010 || anim = 5020
value = 41, 0
ignorehitpause = 1

[State -2]
type = playsnd
triggerall = alive
triggerall = time = 1
trigger1 = stateno = 5000 || stateno = 5010
trigger1 = anim = 5001 || anim = 5011 || anim = 5021
value = 42, 0
ignorehitpause = 1

[State -2]
type = playsnd
triggerall = alive
triggerall = time = 1
trigger1 = stateno = 5000 || stateno = 5010
trigger1 = anim != [5000,5001]
trigger1 = anim != [5010,5011]
trigger1 = anim != [5020,5021]
value = 56, 0
ignorehitpause = 1

;------------------------------------------------------------------
[State -2, 着地、バクステ時音声]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;着地ステート
trigger2 = stateno = 106 ;バックステップ後の着地ステート
value = 40, 0

[State -2, Recover時]
type = null;PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5210  ;空中受身
trigger2 = stateno = 5201  ;地上受身
value = ifelse(random < 500,87, 88), 0

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = stateno = 100
flag = NoAutoTurn
;------------------------------------------------------------------

