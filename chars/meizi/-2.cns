triggerall = roundstate = 2
triggerall = time = 0
trigger1 = stateno = 150
trigger2 = stateno = 152
trigger3 = stateno = 154
value = 10
ignorehitpause = 1

[State -2, 被ダメージで増加]
type = PowerAdd
trigger1 = roundstate = 2
value = var(2)*4
ignorehitpause = 1

[State -2, 変数リセット]
type = varset
trigger1 = 1
v = 2
value = 0
ignorehitpause = 1

[State -2, 魔法チャージで減少]
type = PowerAdd
triggerall = Stateno != 210
trigger1 = var(18) > 0
trigger1 = var(27) = 0
trigger1 = var(20) = 0
value = -3
ignorehitpause = 1
