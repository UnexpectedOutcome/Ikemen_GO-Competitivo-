[State -2, 史上最強のローキック タイム加算]
type = varadd
trigger1 = roundstate = 2
trigger1 = var(56) = 0
trigger1 = stateno != [4000,4004]
v = 57
value = 1
IgnoreHitPause = 1

[State -2, 最強ローフラグ];攻撃力上昇兼
type = varset
trigger1 = var(57) = fvar(14)
v = 56
value = 1
IgnoreHitPause = 1

[State -2, クールカウンターのリセット];
type = varset
trigger1 = var(56) = 1
v = 57
value = 0

