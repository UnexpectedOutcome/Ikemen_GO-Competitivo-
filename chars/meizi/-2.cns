;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]

[state -2, アラド風空中制御 on/off] ;0でON
type = varset
trigger1 = 1
fv = 11
value = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; ダメージ調整関係
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ここのvalueでクールタイム、ダメージ比率など色々と変化します。

;■時間系統■
;時間系統は整数にしないと色々と不具合が出ます。 "value = 60" で1秒

[State -2, 史上最強のローキック クールタイム定義]   
type = varset
trigger1 = 1
fv = 14
value = 93600
;デフォルト 3600

[State -2, 強拳持続時間定義]
type = varset
trigger1 = 1
fv = 16
value = 600
;デフォルト 600
;-------------------------------------------------------------
;ゲージ開始時のスタート
[State -2, ゲージ初期]
type = PowerSet
trigger1 = RoundNo = 1 
trigger1 = RoundState = 0
value = 1000 

;■ランダムダメージ■
;デフォルトのダメージ揺れ幅は95～105
;実際のダメージには「(95～105)*0.01」が乗算されます。
[State -2, ダメージ変動値　最小値]
type = varset
trigger1 = 1
v = 14
value = 95

[State -2, ダメージ変動値　最大値]
type = varset
trigger1 = 1
v = 15
value = 105

;デフォルトのコンボ後の最小値は25～55
[State -2, ランダムダメージ]
type = VarRandom
trigger1 = Stateno !=[3000,4100]
;trigger1 = enemynear,Statetype != A || var(47) >= 1
v = 29
;与えているダメージが3割を超えると、ダメージ倍率が徐々に下がっていくように設定してあります。
;range = floor(ifelse((fvar(20)>0.3),ifelse(var(14)-(fvar(20)*200-60) <25, 25, var(14)-(fvar(20)*200-60)), var(14))), floor(ifelse((fvar(20)>0.3),ifelse(var(15)-(fvar(20)*200-60) <55, 55, var(15)-(fvar(20)*200-60)), var(15)))
;fvar(20) = コンボ中に相手に与えているダメージの割合 （最大HPからの比較）
;「ifelse(fvar(20)>0.3～～)」＝「相手に3割以上ダメージを与えていたら～」
range = ifelse(var(14)-ceil((hitcount*hitcount*0.4)-1) <25,25,var(14)-ceil((hitcount*hitcount*0.4)-1)),ifelse(var(15)-ceil((hitcount*hitcount*0.4)-1) <55,55,var(15)-ceil((hitcount*hitcount*0.4)-1))

[State -2, ランダムダメージ]
type = null;VarRandom
trigger1 = Stateno !=[3000,4100]
trigger1 = enemynear,Statetype = A && var(47) = 0
v = 29
range = var(14) - hitcount**3,var(15) - hitcount**3;ifelse(var(14)-ceil(((hitcount**2)*(1+(hitcount*0.3)))-1) <25,25,var(14)-ceil(((hitcount**2)*(1+(hitcount*0.3)))-1)),ifelse(var(15)-ceil(((hitcount**2)*(1+(hitcount*0.3)))-1) <55,55,var(15)-ceil(((hitcount**2)*(1+(hitcount*0.3)))-1))

[State -2, ランダムダメージ]
type = VarRandom
trigger1 = Stateno =[3000,4100]
v = 29
range = ifelse(var(14)-ceil((hitcount*hitcount*0.2)-1) <25,25,var(14)-ceil((hitcount*hitcount*0.2)-1)),ifelse(var(15)-ceil((hitcount*hitcount*0.2)-1) <55,55,var(15)-ceil((hitcount*hitcount*0.2)-1))

