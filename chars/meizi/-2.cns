;■クリティカル■
;クリティカル設定は特殊な扱いをしています。
;ダメージを与えた瞬間にクリティカルの合否を判定すると、ダメージ表示の演出と誤差が発生するため、
;クリティカルが発生するタイミングを固定し、ダメージ表示の演出と同期するようにしてあります。
;「var(30)=15」になったときクリティカル発動となっています。
;攻撃を当てるたびに「var(30)」の値が加算され、var(30)の値が15を超えると、その直後にランダムで0～14を引きます。
;強拳中はこのとき引かれる数値が10～14に設定してあり、いくらかクリ率が上昇します。
;var(22) >= 1  (わら人形クリ率増加 5秒間)
[State -2, ランダムクリティカル]
type = Varset
trigger1 = var(22) >= 1
trigger1 = var(30) < 7
v = 30
value = ifelse(random <500,10,14)
ignorehitpause = 1
;デフォルト ifelse(random <500,10,14)

[State -2, わら人形タイム加算]
type = Varadd
trigger1 = var(22) >= 1
v = 22
value = 1
ignorehitpause = 1

[State -2, わら人形タイムリセット]
type = Varset
trigger1 = var(22) >= 300
v = 22
value = 0
ignorehitpause = 1

[State -2, ランダムクリティカル]
type = VarRandom
trigger1 = var(30) >= 15
trigger2 = roundstate != 2
v = 30
range = ifelse(var(47) = 2, 13, 0) , 14
ignorehitpause = 1
;デフォルト ifelse(var(47) = 2, 13, 0) , 14

[State -2, クリティカルダメージ倍率定義]
type = varset
trigger1 = 1
fv = 17
value = 1.2
;デフォルト 1.2

[State -2, ランダムクリティカル]
type = VarAdd
triggerall = stateno != [3600,3606]
triggerall = stateno != 810
triggerall = stateno != 840
triggerall = stateno != 1400
triggerall = stateno != 1407
triggerall = stateno != [1700,1701]
trigger1 = movehit = 1
trigger2 = projhit(1305) = 1
v = 30
value = 1

;■パワーゲージ設定
[State -2, 時間で増加]
type = PowerAdd
triggerall = roundstate = 2
trigger1 = 1
value = 2
ignorehitpause = 1

[State -2, 古代の図書館で増加]
type = PowerAdd
triggerall = var(23) >= 1
trigger1 = 1
value = 6
ignorehitpause = 1

[State -2, ガードで増加]
