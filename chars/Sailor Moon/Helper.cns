;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;AI起動ヘルパー
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[StateDef 10001]
anim=13579
ctrl=0

[State 10001]
type = assertspecial
trigger1 = 1
flag = invisible

[State 10001,間違いで本体が来たら立ちへ移行]
type=selfstate
trigger1=!ishelper
value=0

[State 10001,プレイヤー判定]
type=varset
Trigger1=command="a"&&root,command="a"
Trigger2=command="b"&&root,command="b"
Trigger3=command="c"&&root,command="c"
Trigger4=command="x"&&root,command="x"
Trigger5=command="y"&&root,command="y"
Trigger6=command="z"&&root,command="z"
Trigger7=command="start"&&root,command="start"
var(59)=-1

[State 10001,立ったら消失]
Type = DestroySelf
TriggerAll=isHelper
Trigger1=root,var(59)||var(59)=-1
Trigger2=command="a"&&root,command="a"
Trigger3=command="b"&&root,command="b"
Trigger4=command="c"&&root,command="c"
Trigger5=command="x"&&root,command="x"
Trigger6=command="y"&&root,command="y"
Trigger7=command="z"&&root,command="z"
Trigger8=command="start"&&root,command="start"

[State 10001,AIﾌﾗｸﾞON]
Type=varset
TriggerAll=var(59)!=-1
Trigger1=root,command="a"
Trigger2=root,command="b"
Trigger3=root,command="c"
Trigger4=root,command="x"
Trigger5=root,command="y"
Trigger6=root,command="z"
Trigger7=root,command="start"
var(59)=1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;AI特殊ヘルパー
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;==============================================================================
;ステージ端チェックヘルパー 右
;==============================================================================
[Statedef 30000]; ステージ右端チェックヘルパー
type      = A
movetype  = I
physics   = N
velset    = -7, 0
ctrl      = 0
anim      = 13579

[State 30000, 非表示に設定]
type = AssertSpecial
trigger1 = 1
flag = invisible

[State 30000, 無敵状態付加]
type = NotHitBy
trigger1 = 1
value = SCA

[State 30000, 万一本体がここにきた場合待機モーションへ]
type = SelfState
trigger1 = !IsHelper
value = 0

[State 30000, ステージ端チェック用Projectile]
type = Projectile
trigger1 = Time = 0
projID = 30000
projanim = 13579
projremove = 0
projremovetime = -1
velocity = -7.0, 0.0
projstagebound = -1
projedgebound = 65535
supermovetime = 65535
pausemovetime = 65535

[State 30000, projstageboundの効果でProjectileが消えたら停止]
type = VelSet
trigger1 = Root, NumProjID(30000) = 0
trigger1 = Time > 0
x = 0
y = 0

[State 30000, Root(プレイヤー)前面からステージ端(ヘルパー)までの距離を設定]
type = ParentVarSet
;triggerall = root,var(59)
trigger1 = Root, facing = 1
fvar(32) = Floor(RootDist X) - Const(size.ground.front) + 2

[State 30000, Root(プレイヤー)背面からステージ端(ヘルパー)までの距離を設定]
type = ParentVarSet
;triggerall = root,var(59)
trigger1 = Root, facing = -1
fvar(33) = Floor(RootDist X) - Const(size.ground.back) - 1

;相手の背丈チェック
[State -2, set]
type = VarSet
triggerall = root,var(59)
triggerall = roundstate = 2
trigger1 = enemynear(floor(root,fvar(31))),Const(size.mid.pos.y) >= -45
v = 3
value = 1
ignorehitpause = 1

;固められ時間カウント
[State -2, timeset]
type = varadd
triggerall = root,var(59)
triggerall = roundstate = 2
trigger1 = root,movetype = H && (root,stateno = [120,155])
trigger2 = root,movetype = H && (root,stateno = [4000,4200])
v = 17
value = 1
ignorehitpause = 1

;固められ時間カウントリセット
[State -2, set]
type = VarSet
triggerall = root,var(59)
triggerall = roundstate = 2
triggerall = var(17)
trigger1 = root,statetype = L
trigger2 = root,movetype = A
trigger3 = root,stateno = 810
trigger4 = root,stateno = 1800 && root,var(12)
v = 17
value = 0
ignorehitpause = 1

;相手体力計算
[State -2, p2lifeset]
type = Varset
triggerall = root,var(59)
triggerall = root,life != 0
triggerall = roundstate = 2
trigger1 = 1
v = 21
value = (100 * enemynear(floor(root,fvar(31))),life / enemynear(floor(root,fvar(31))),lifemax)
ignorehitpause = 1
;==============================================================================
;中段記憶ここから var(4)～var(8)を使用
;==============================================================================
[State -2, 寸前にどういう状態であったか]
Type = VarSet
TriggerAll = Root,var(59)
TriggerAll = Enemy,TeamMode = Single || Enemy,TeamMode = Turns
Trigger1 = GameTime%2 = 0
V = 4
Value = IfElse(Root,StateType=S,1,IfElse(Root,StateType=C,2,IfElse(Root,StateType=A,3,4)))
IgnoreHitPause = 1

[State -2, 寸前にガードステートだったかどうか]
Type = VarSet
TriggerAll = Root,var(59)
TriggerAll = Enemy,TeamMode = Single || Enemy,TeamMode = Turns
TriggerAll = GameTime%2 = 0
Trigger1 = Root,StateNo = 120
Trigger2 = Root,StateNo = 140
Trigger3 = Root,StateNo = 130
Trigger4 = Root,StateNo = 131
Trigger5 = Root,StateNo = [150,151]
Trigger6 = Root,StateNo = [152,153]
V = 5
Value = 1
IgnoreHitPause = 1

[State -2, 違う場合は0に戻す]
Type = VarSet
TriggerAll = Root,var(59)
TriggerAll = Enemy,TeamMode = Single || Enemy,TeamMode = Turns
TriggerAll = Var(5) > 0
Trigger1 = Root,StateNo != 120
Trigger1 = Root,StateNo != 130
Trigger1 = Root,StateNo != 131
Trigger1 = Root,StateNo != 140
Trigger1 = Root,StateNo != [150,151]
Trigger1 = Root,StateNo != [152,153]
V = 5
Value = 0
IgnoreHitPause = 1

[State -2]
Type = VarSet
TriggerAll = Root,var(59)
TriggerAll = Enemy,TeamMode = Single || Enemy,TeamMode = Turns
TriggerAll = Root,MoveType = H
TriggerAll = HelPer(30000),Var(6) = 0
Trigger1 = root,var(2) > 0
V = 6
Value = root,var(2)
IgnoreHitPause = 1

[State -2]
Type = VarSet
TriggerAll = Root,var(59)
TriggerAll = Enemy,TeamMode = Single || Enemy,TeamMode = Turns
TriggerAll = Root,MoveType = H
TriggerAll = HelPer(30000),Var(7) = 0
Trigger1 = root,var(2) > 0
V = 7
Value = EnemyNear,Time
IgnoreHitPause = 1

[State -2]
Type = VarAdd
TriggerAll = Root,var(59)
TriggerAll = Enemy,TeamMode = Single || Enemy,TeamMode = Turns
TriggerAll = Root,var(2) > 0
Trigger1 = HelPer(30000),Var(8) = 0
Trigger2 = HelPer(30000),Var(8) > 0
Trigger2 = root,var(2) = HelPer(30000),Var(6)
V = 8
Value = 1
IgnoreHitPause = 1
;=============================================================================
;中段記憶ここまで
;=============================================================================
;=============================================================================
;立ち大パンチカウンター不可攻撃記憶1
[State -2, set]
type = VarSet
triggerall = root,var(59)
triggerall = roundstate = 2
triggerall = !var(11)
triggerall = EnemyNear(root,var(50)),statetype = S
trigger1 = root,prevstateno = 220
trigger1 = EnemyNear(root,var(50)),movehit = 1
v = 11
value = enemynear(floor(root,fvar(31))),stateno
ignorehitpause = 1

;立ち大パンチカウンター不可攻撃記憶2
[State -2, set]
type = VarSet
triggerall = root,var(59)
triggerall = roundstate = 2
triggerall = var(11)
triggerall = !var(12)
triggerall = EnemyNear(root,var(50)),statetype = S
trigger1 = root,prevstateno = 220
trigger1 = EnemyNear(root,var(50)),movehit = 1
v = 12
value = enemynear(floor(root,fvar(31))),stateno
ignorehitpause = 1

;立ち大パンチカウンター不可攻撃記憶2リセット
[State -2, set]
type = VarSet
triggerall = root,var(59)
triggerall = roundstate = 2
triggerall = var(12)
trigger1 = var(12) = var(11)
v = 12
value = 0
ignorehitpause = 1

;立ち大パンチカウンター不可攻撃記憶3
[State -2, set]
type = VarSet
triggerall = root,var(59)
triggerall = roundstate = 2
triggerall = var(11)
triggerall = var(12)
triggerall = !var(13)
triggerall = EnemyNear(root,var(50)),statetype = S
trigger1 = root,prevstateno = 220
trigger1 = EnemyNear(root,var(50)),movehit = 1
v = 13
value = EnemyNear(root,var(50)),stateno
ignorehitpause = 1

;立ち大パンチカウンター不可攻撃記憶3リセット
[State -2, set]
type = VarSet
triggerall = root,var(59)
triggerall = roundstate = 2
triggerall = var(13)
trigger1 = var(13) = var(11)
trigger2 = var(13) = var(12)
v = 13
value = 0
ignorehitpause = 1
