;==============================================================================
;*******************************   AIヘルパー   *******************************
;==============================================================================
;めくり対策とヘルパー監視、超必殺判定を兼ねるAI用ヘルパーを呼び出す
;------------------------------------------------------------------------------
; 0          超必殺判定(Enemy,Power)
; 1          超必殺判定
; 2          AI開始/0
; 3          ヘルパー監視(Enemy,NumHelper)
; 4          ヘルパー監視(トリガ)
; 5          ヘルパー監視(loop用)
; 6          ヘルパー監視(現在最大PlayerID)
; 7          ヘルパー監視(前回より増加したHelperの数)
; 11-20      ヘルパー監視(PlayerID)
; 21-30      ヘルパー監視(マーキング)
; 50         ヘルパー監視(飛び道具監視、飛び道具1こめ)
; 51         ヘルパー監視(飛び道具監視、飛び道具2こめ)
; 52         ヘルパー監視(落下飛び道具警戒)
; 53         ヘルパー監視(設置近距離警戒)
; 54         ヘルパー監視(設置遠距離警戒)
;
;------------------------------------------------------------------------------
[Statedef 887700]
type     = S
movetype = I
physics  = N
ctrl     = 0
velset   = 0,0
anim     = 0
sprpriority = -1

; 処理
[STATE BtR]
type = BindToRoot
trigger1 = 1
time = 100000
pos = 0,0

[STATE Turn]    ;めくり対策にROOTと逆を向かせ、本体の後ろ側のInGuardDistを取得する
type = Turn
trigger1 = facing=root,facing   ;BtRのfacingは内部的な向きは変わらないらし

[STATE 非表示]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2= noshadow

[STATE 無敵化]
type = NOTHITBY
trigger1 = 1
value = SCA
time = 999999

;------------------------------------------------------------------------------
[STATE AI開始]
type = VarSet
trigger1 = 1
var(2) = 0
persistent=0

[STATE AI開始]
type = VarAdd
trigger1 = RoundState=2
var(2) = 1

[STATE AI開始]
type = ChangeState
trigger1 = var(2)>40
value = 887701      ;40フレームあれば相手の常時監視ヘルパーは起動してる
;------------------------------------------------------------------------------
[Statedef 887701]
;------------------------------------------------------------------------------
; 処理
[STATE BtR]
type = BindToRoot
trigger1 = 1
time = 100000
pos = 0,0

[STATE Turn]    ;めくり対策にROOTと逆を向かせ、本体の後ろ側のInGuardDistを取得する
type = Turn
trigger1 = facing=root,facing   ;BtRのfacingは内部的な向きは変わらないらし

[STATE 非表示]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2= noshadow

[STATE 無敵化]
type = NOTHITBY
trigger1 = 1
value = SCA
time = 999999

[STATE 0]
type = VarSet
trigger1 = 1
var(2) = 0
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; AI - 超必殺判定
;------------------------------------------------------------------------------
[STATE 超必殺判定]
type = VarSet
triggerall = Time
trigger1 = var(0)>enemy,power
var(1) = floor((var(0)-enemy,power)*0.001)

[STATE 超必殺判定(リセット)]
type = VarSet
triggerall = Time
trigger1 = enemynear,movetype=H
trigger2 = enemynear,stateno=[0,105]
trigger3 = enemynear,stateno=[120,155]
trigger4 = enemynear,stateno=[5000,5210]
var(1) = 0

[STATE ENEMY,POWER]
type = VarSet
trigger1 = Time
var(0) = enemynear,power
;/超必殺判定

;------------------------------------------------------------------------------
; AI - ヘルパー監視
;------------------------------------------------------------------------------
[STATE DEBUG]
type = DisplayToClipboard
trigger1 = Time
text = "HELPER:%d %d %d %d %d "
params = var(11),var(12),var(13),var(14),var(15)
[STATE DEBUG]
Type = AppendToClipBoard
trigger1 = Time
text = "%d %d %d %d %d"
params = var(16),var(17),var(18),var(19),var(30)
[STATE DEBUG]
Type = AppendToClipBoard
trigger1 = Time
text = "\n50:%d 51:%d 52:%d 53:%d 54:%d"
params = var(50),var(51),var(52),var(53),var(54)

[STATE PlayerID取得フラグ]
type = VarSet
triggerall = Time
trigger1 = Enemy,NumHelper > var(3);相手のヘルパーが増えた
var(4) = 1

[STATE ]
type = VarSet
trigger1 = Time
var(3) = Enemy,NumHelper

[STATE PlayerIDAdd]
type = Helper
triggerall = Time
trigger1 = RoundState=2
trigger1 = var(4)
name = " "
id = 886600
stateno = 886600
supermovetime = 99990000000
pausemovetime = 99990000000

[STATE ヘルパー増加数]          ;前回より増加したヘルパーの数+2
type = VarSet               ;helperから呼び出されたhelperの増加が読めない保険分
triggerall = Time
trigger1 = NumHelper(886600)
trigger1 = var(4)
var(7) = helper(886600),ID-var(6)+2

;------------------------------------------------------------------------------
[STATE 警戒フラグのリセット]
type = VarRangeSet
trigger1 = Time
first = 50
last = 54
value = 0

;------------------------------------------------------------------------------
[STATE PlayerID取得]
type = ChangeState
triggerall = Time
trigger1 = RoundState=2
trigger1 = var(5):=11+0||1
trigger1 = var(4):=0    ||1
value = 887711
;/ヘルパー監視

;------------------------------------------------------------------------------
;/AIヘルパー
;==============================================================================
; ヘルパー監視ループ
[Statedef 887711]
[STATE リセット1]   ;存在しないPlayerIDが格納されているVARはリセットする
type = VarSet
trigger1 = PlayerIDExist(var(var(5)))=0
var(var(5)) = 0

[STATE リセット2]   ;攻撃用ヘルパーではないと思われるヘルパーのPlayerIDはリセットする
type = VarSet
triggerall = PlayerIDExist(var(var(5)))
;相手のMoveContactとほぼ同時に出現したヘルパーはヒットスパーク表示用と思われるのでリセット
trigger1 = EnemyNear,MoveContact=[1,2]
trigger1 = PlayerID(var(var(5))),Time<=2
;timeが120以上でMoveTypeがAでないヘルパー
trigger2 = PlayerID(var(var(5))),MoveType!=A&&PlayerID(var(var(5))),time>120
;timeが600以上のヘルパー
trigger3 = PlayerID(var(var(5))),time>600
;command入力されたHelperはkeyctrl=1のAI用ヘルパー臭いのでリセット
trigger4 = PlayerID(var(var(5))),command="holdfwd"
;Time=0が読みとれるHelperも常時監視でSelfStateしているAI用ヘルパー臭い
trigger5 = PlayerID(var(var(5))),Time=0
var(var(5)) = 0

[STATE マーキングリセット]
type = VarSet
trigger1 = PlayerIDExist(var(var(5)))=0
var(var(5)+10) = 0

;//////////////////////////////////////////////////////////////////////////////
;------------------------------------------------
; 飛び道具監視 いっこめ
[STATE 飛び道具監視(HitDef型)]
type = NULL
triggerall = PlayerIDExist(var(var(5)))
trigger1 = PlayerID(var(var(5))),MoveType=A         ;攻撃判定
trigger1 = PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP       ;攻撃判定のヘルパー
trigger1 = PlayerID(var(var(5))),Vel X>0            ;前進してる
trigger1 = PlayerID(var(var(5))),Pos Y<10           ;地面にめり込んでない

;0-8(511)       P2BodyDist X[0-511]
;こちらとの距離、0-511 (255を加えてるので実際は-256～255まで)
trigger1 = var(50):=(var(50)|255-Ceil(PlayerID(var(var(5))),P2BodyDist X))  ||1
;9-16(97792)        POS Y [0-191]
;飛び道具の高さ、0-191 (1/2してるので最大-382まで、誤差2前後)
trigger1 = var(50):=(var(50)|512*abs(Ceil(PlayerID(var(var(5))),Pos Y/2)))  ||1
;17-21(4063232)     Vel X [0-31]
;飛び道具のVEL X、0-31
trigger1 = var(50):=(var(50)|131072*Ceil(PlayerID(var(var(5))),Vel X))      ||1
;22-26(130023424)   Vel Y [0-31]
;飛び道具のVEL Y、0-31  (15を加えてるので実際-16～15まで)
trigger1 = var(50):=(var(50)|4194304*(15-Ceil(PlayerID(var(var(5))),Vel Y)))

;トリガーとして使う場合はこうする
;こちらとの距離 :   -((helper(887700),var(50)&511)-255)
;飛び道具の高さ :   (helper(887700),var(50)&97792)/256
;飛び道具のVEL X:   (helper(887700),var(50)&4063232)/131072
;飛び道具のVEL Y:   -(((helper(887700),var(50)&130023424)/4194304)-15)

[STATE 飛び道具監視(Proj型)]
type = NULL
triggerall = PlayerIDExist(var(var(5)))
triggerall = var(var(5))=var(var(5)+10)             ;マーキングしたヘルパー
trigger1 = EnemyNear,NumProj                    ;相手がProjectileを出してる
trigger1 = PlayerID(var(var(5))),MoveType=I
trigger1 = !(PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP)
trigger1 = PlayerID(var(var(5))),Vel X>0
trigger1 = PlayerID(var(var(5))),Pos Y<10
trigger1 = var(50):=(var(50)|255-Ceil(PlayerID(var(var(5))),P2BodyDist X))  ||1
trigger1 = var(50):=(var(50)|512*abs(Ceil(PlayerID(var(var(5))),Pos Y/2)))  ||1
trigger1 = var(50):=(var(50)|131072*Ceil(PlayerID(var(var(5))),Vel X))      ||1
trigger1 = var(50):=(var(50)|4194304*(15-Ceil(PlayerID(var(var(5))),Vel Y)))
;------------------------------------------------
; 飛び道具監視 2こめ
[STATE 飛び道具監視(HitDef型)]
type = NULL
triggerall = PlayerIDExist(var(var(5)))
trigger1 = var(50)                      ;いっこめがすでにある時だけ
trigger1 = PlayerID(var(var(5))),MoveType=A         ;攻撃判定
trigger1 = PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP       ;攻撃判定のヘルパー
trigger1 = PlayerID(var(var(5))),Vel X>0            ;前進してる
trigger1 = PlayerID(var(var(5))),Pos Y<10           ;地面にめり込んでない
trigger1 = var(51):=(var(51)|255-Ceil(PlayerID(var(var(5))),P2BodyDist X))  ||1
trigger1 = var(51):=(var(51)|512*abs(Ceil(PlayerID(var(var(5))),Pos Y/2)))  ||1
trigger1 = var(51):=(var(51)|131072*Ceil(PlayerID(var(var(5))),Vel X))      ||1
trigger1 = var(51):=(var(51)|4194304*(15-Ceil(PlayerID(var(var(5))),Vel Y)))

[STATE 飛び道具監視(Proj型)]
type = NULL
triggerall = PlayerIDExist(var(var(5)))
triggerall = var(var(5))=var(var(5)+10)             ;マーキングしたヘルパー
trigger1 = EnemyNear,NumProj                    ;相手がProjectileを出してる
trigger1 = var(50)
trigger1 = PlayerID(var(var(5))),MoveType=I
trigger1 = !(PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP)
trigger1 = PlayerID(var(var(5))),Vel X>0
trigger1 = PlayerID(var(var(5))),Pos Y<10
trigger1 = var(51):=(var(51)|255-Ceil(PlayerID(var(var(5))),P2BodyDist X))  ||1
trigger1 = var(51):=(var(51)|512*abs(Ceil(PlayerID(var(var(5))),Pos Y/2)))  ||1
trigger1 = var(51):=(var(51)|131072*Ceil(PlayerID(var(var(5))),Vel X))      ||1
trigger1 = var(51):=(var(51)|4194304*(15-Ceil(PlayerID(var(var(5))),Vel Y)))


;------------------------------------------------
; 落下監視
[STATE 落下飛道具(HitDef型)]
type = VarSet
triggerall = PlayerIDExist(var(var(5)))
trigger1 = PlayerID(var(var(5))),MoveType=A
trigger1 = PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP
trigger1 = PlayerID(var(var(5))),Vel X = [-1,1]
trigger1 = PlayerID(var(var(5))),Vel Y >= 1
trigger1 = PlayerID(var(var(5))),P2BodyDist X=[-100,100]
trigger1 = PlayerID(var(var(5))),P2Dist Y>0
var(52) = 1+Ceil(PlayerID(var(var(5))),P2BodyDist Y-PlayerID(var(var(5))),Vel Y*10)
;自分の前後100px範囲内に落下飛び道具っぽいのを見つけると、Var(51)に落下飛び道具の高さを代入します

[STATE 落下飛道具(Proj型)]
type = VarSet
triggerall = PlayerIDExist(var(var(5))) ;上から来る飛び道具(P)
triggerall = var(var(5))=var(var(5)+10)
trigger1 = PlayerID(var(var(5))),MoveType=I
trigger1 = !(PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP)
trigger1 = PlayerID(var(var(5))),Vel X = [-1,1]
trigger1 = EnemyNear,NumProj
trigger1 = PlayerID(var(var(5))),Vel Y >= 1
trigger1 = PlayerID(var(var(5))),P2BodyDist X=[-100,100]
trigger1 = PlayerID(var(var(5))),P2Dist Y>0
var(52) = 1+Ceil(PlayerID(var(var(5))),P2BodyDist Y-PlayerID(var(var(5))),Vel Y*10)

;------------------------------------------------
; 設置警戒
[STATE 設置(近距離)]
type = VarSet
triggerall = PlayerIDExist(var(var(5)))
trigger1 = PlayerID(var(var(5))),MoveType=A
trigger1 = PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP
trigger1 = PlayerID(var(var(5))),Vel Y = 0
trigger1 = PlayerID(var(var(5))),Vel X = 0
trigger1 = PlayerID(var(var(5))),P2BodyDist X=[-100,100]
trigger1 = PlayerID(var(var(5))),P2BodyDist Y=[-100,100]
var(53) = IfElse(PlayerID(var(var(5))),P2Dist X>0,1,-1)
;自分の100px範囲内に設置ヘルパーっぽいのを見つけると1を代入、後ろにいると-1を代入

[STATE 設置(隣接距離)]
type = VarSet
triggerall = PlayerIDExist(var(var(5)))
trigger1 = PlayerID(var(var(5))),MoveType=A
trigger1 = PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP
trigger1 = PlayerID(var(var(5))),Vel Y = 0
trigger1 = PlayerID(var(var(5))),Vel X = 0
trigger1 = PlayerID(var(var(5))),P2BodyDist X=[-35,35]
trigger1 = PlayerID(var(var(5))),P2BodyDist Y=[-60,60]
var(53) = IfElse(PlayerID(var(var(5))),P2Dist X>0,10,-10)
;更に近い場合は10を代入、後ろにいると-10

[STATE 設置(遠距離)]
type = VarSet
triggerall = PlayerIDExist(var(var(5)))
trigger1 = PlayerID(var(var(5))),MoveType=A
trigger1 = PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP
trigger1 = PlayerID(var(var(5))),Vel Y = 0
trigger1 = PlayerID(var(var(5))),Vel X = 0
trigger1 = PlayerID(var(var(5))),P2BodyDist X!=[-100,100]
trigger1 = PlayerID(var(var(5))),P2BodyDist X=[-350,350]
trigger1 = PlayerID(var(var(5))),P2BodyDist Y=[-100,100]
var(54) = IfElse(PlayerID(var(var(5))),P2Dist X>0,1,-1)
;遠距離に見つけると1、後ろにいると-1
;//////////////////////////////////////////////////////////////////////////////

[STATE loop]
type = ChangeState
trigger1 = var(5)<=11+10
trigger1 = var(5):=var(5)+1
value = StateNo
[STATE end]
type = ChangeState
trigger1 = var(5)>11+10
trigger1 = var(5):=11||1
value = 887712
;==============================================================================
; VAR整理
[Statedef 887712]

[STATE VARを詰める]
type = NULL
triggerall = !var(var(5))
trigger1 = var(var(5)):=var(ifelse(var(5)+1>20,2,var(5)+1))||1  ;Var(2)は0で固定されてるので、0が代入される
trigger1 = (var(var(5)):=var(ifelse(var(5)+1>20,2,var(5)+1)))||(var(ifelse(var(5)+1>20,2,var(5)+1)):=0)||1

[STATE loop]
type = ChangeState
trigger1 = var(5)<=11+10
trigger1 = var(5):=var(5)+1
value = StateNo

[STATE end]
type = ChangeState
trigger1 = var(5)>11+10
trigger1 = var(5):=0||1
value = IfElse(var(7)>0,887710,887701)
;------------------------------------------------------------------------------
;==============================================================================
; PlayerID取得
[Statedef 887710]

[STATE PlayerID取得数制限]
type = VarSet
trigger1 = var(7)>10
var(7) = 10
[STATE PlayerIDを格納するVAR]
type = VarSet
trigger1 = 1
var(5) = 11+(var(11)>0)+(var(12)>0)+(var(13)>0)+(var(14)>0)+(var(15)>0)+(var(16)>0)+(var(17)>0)+(var(18)>0)+(var(19)>0)+(var(20)>0)
[STATE PlayerID取得]
type = VarSet
trigger1 = PlayerIDExist(var(6)-var(7))         ;PlayerIDが存在する
trigger1 = (var(6)-var(7))!=var(var(5)-1)           ;重複登録の防止
trigger1 = PlayerID(var(6)-var(7)),IsHelper         ;ヘルパーに限る
trigger1 = PlayerID(var(6)-var(7)),IsHomeTeam!=IsHomeTeam   ;相手側に限る
var(var(5)) = PlayerID(var(6)-var(7)),ID
[STATE マーキング]                  ;飛び道具必殺技と思われるステートで呼び出されたヘルパーをマーキング
type = VarSet
trigger1 = PlayerIDExist(var(var(5)))
trigger1 = PlayerID(var(6)-var(7)),IsHelper
trigger1 = PlayerID(var(var(5))),MoveType!=A||!(PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP,AT)  ;攻撃判定無し
trigger1 = EnemyNear,MoveType=A             ;相手が攻撃判定の時に呼び出された
trigger1 = !(EnemyNear,HitDefAttr=SCA,AA,AP,AT)     ;相手がHitDefを出してない(飛び道具?)
trigger1 = EnemyNear,CTRL=0
trigger1 = EnemyNear,Time>10
trigger1 = EnemyNear,StateNo>=1000          ;1000以上なら大抵必殺技
var(var(5)+10) = PlayerID(var(var(5))),ID

[STATE loop]
type = ChangeState
trigger1 = var(7)>0
trigger1 = var(7):=var(7)-1||1
value = 887701
[STATE end]
type = ChangeState
trigger1 = var(7)<=0
value = 887701
;------------------------------------------------------------------------------
;/AIヘルパー
;==============================================================================