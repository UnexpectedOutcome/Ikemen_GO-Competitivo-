;---------------------------------------------------------------------------
; Run forward
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, PlaySnd]
type = PlaySnd
triggerall = anim = 100
trigger1 = Time = 0
value = 2,4

[State 100, PlaySnd]
type = PlaySnd
triggerall = anim = 100
trigger1 = Animelem = 3 || Animelem = 6
value = 2,3

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, Explod]
type = Explod
trigger1 = Animelem = 3 || Animelem = 6
anim = 8003
ID = 8003
pos = -15,-9
postype = p1
facing = 1
vel = -2,0
vfacing = 1
bindtime = 1
removetime = -2
pausemovetime = 0
sprpriority = 3
ownpal = 1
ontop = 1
removeongethit = 0

[State 100, 3]
type = ChangeState
trigger1 = command != "holdfwd" && Var(15) = 0
trigger2 = Var(15) && P2BodyDist X < 16
value = 101
ctrl = 0

