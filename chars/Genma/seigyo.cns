;---------------------------------------------------------------------------
; 破城槌　相手側ふっとび
[Statedef 4000]
type     = A
physics  = N
movetype = H
ctrl = 0

[State 4000, 1]
type = Posadd
triggerall = P2Dist Y = 0
trigger1 = Time = 0
y = -20

[State 4000, Velocity] 
type = VelSet
trigger1 = Time = 0
x = -10
y = -10

[State 4000, Gravity]
type = VelAdd
trigger1 = 1
y = .75

[State 4000, 2]
type = ChangeAnim2
trigger1 = Time = 0
value = 4000

[State 4000, 5]
type = SelfState
triggerall = Time >= 10
trigger1 = Pos Y >= -10
value = 5100
ctrl = 0

[State 4000, Hit wall]
type = ChangeState
triggerall = Pos y < -30
trigger1 = BackEdgeBodyDist <= 10
trigger2 = FrontEdgeBodyDist <= 10
value = 4001

;------------------
; 飛んでいった相手の壁に当たる状態のステート
[Statedef 4001]
type    = A
movetype= H
physics = N

[State 4001, Stop moving]
type = PosFreeze
trigger1 = 1
x = 1
y = 1

[State 4001, No scroll]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,1

[State 4001, Spark]
type = Explod
trigger1 = Time = 0
anim = F72
pos = 0, floor (screenpos y) - 20
postype = back
sprpriority = 3

[State 4001, Sound];衝突音
type = PlaySnd
trigger1 = Time = 0
value = 1000,21;F7,0

[State 4001, 1]
type = LifeAdd
trigger1 = Time = 0
value = -10

[State 4001,2]
type = envshake
trigger1 = Time = 0
time = 20
ampl = 6
freq = 180

[State 4001, State]
type = ChangeState
trigger1 = Time = 6
value = 4002

;------------------
; 壁に当たった相手が落ちるステート
[Statedef 4002]
type    = A
movetype= H
physics = N

[State 4002, 1]
type = NotHitBy
trigger1 = 1
value = , NA, NP

[State 4002, Vel X]
type = VelSet
trigger1 = Time = 0
x = 0.5

[State 4002, Vel Y]
type = Velset
trigger1 = Time = 0
y = -3

[State 4002, Gravity]
type = VelAdd
trigger1 = 1
y = .45

[State 4002, Anim 5050] 
type = ChangeAnim
trigger1 = Time = 0
trigger1 = !SelfAnimExist(5052)
value = 5016

[State 4002, Anim 5052] 
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5052)
value = 5016

[State 4002, Anim 5060] 
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5050
trigger1 = SelfAnimExist(5060)
persistent = 0
value = 5016

[State 4002, Anim 5062] 
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5052
trigger1 = SelfAnimExist(5062)
persistent = 0
value = 5016

[State 4002, Hit ground]
type = SelfState
trigger1 = (Vel y > 0) && (Pos y >= 0)
value = 5100





















