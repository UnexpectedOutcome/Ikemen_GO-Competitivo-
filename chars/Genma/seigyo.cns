type     = S
physics  = S
movetype = H
ctrl = 0

[State 4320, Velocity] 
type = VelAdd
trigger1 = var(10) <= 50 
trigger1 = Time = 0
x = -8

[State 4320, Velocity] 
type = VelAdd
trigger1 = var(10) > 50 
trigger1 = Time = 0
x = -8+(var(10)/20)

