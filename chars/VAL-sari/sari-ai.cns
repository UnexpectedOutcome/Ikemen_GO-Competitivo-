Value = 410
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = Random < var(58) * 5   ;全く何も考えずに技を出す
trigger2 = P2StateType != A && P2BodyDist X < 75   ;地上
trigger2 = Random < 20*var(59) && var(57)>0 ;レベルで確率を上げる
Trigger3 = PrevStateNo = 52 && P2moveType = H && var(54) = 1 && P2BodyDist X = [31,54] ;着地キャンセル
trigger3 = Random < 80*var(59) && var(57)>0 ;レベルで確率を上げる

;---------------------------------------------------------------------------
[State -3, しゃがみ小キック]
Type = ChangeState
Value = 430
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = Random < var(58) * 5   ;全く何も考えずに技を出す
trigger2 = P2StateType != A && P2BodyDist X = [70,120]   ;地上
trigger2 = Random < 20
trigger3 = P2BodyDist X < 120   ;距離
trigger3 = Random < 10
trigger4 = Numhelper(1010) = 1 && P2BodyDist X > 400  ;飛び道具のある時
trigger4 = Random < 50*var(57) && var(57) = [1,2] ;キックボタンのみ
trigger5 = p2moveType != A && P2BodyDist X > 320  ;やや遠い
trigger5 = Random < 10*var(57) && var(57) = [1,2] ;キックボタンのみ

;---------------------------------------------------------------------------
[State -3, しゃがみ大キック]
