;---------------------------------------------------------------------------地上通常技
[State -3, しゃがみ小パンチ]
Type = ChangeState
Value = 400
TriggerAll = Alive && var(59) > 0
TriggerAll = ctrl && StateType != A
trigger1 = Random < var(58) * 5   ;全く何も考えずに技を出す
trigger2 = P2StateType != A && P2BodyDist X < 45   ;地上
trigger2 = Random < 20*var(59) && var(57)>0 ;レベルで確率を上げる
Trigger3 = PrevStateNo = 52 && P2moveType = H && P2BodyDist X < 30 ;着地キャンセル
trigger3 = Random < 100*var(59) && var(57)>0 ;レベルで確率を上げる
trigger4 = P2BodyDist X = [-45,45]   ;距離
trigger4 = Random < 20

