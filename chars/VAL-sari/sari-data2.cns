;---------------------------------------------------------------------------
; ジョーカーディメンション飛び道具攻撃判定1
[Statedef 3020]
type = A
movetype = A
velset = 0,0       ;速度
physics = N       ;摩擦、重力を無視
juggle  = 3       ;本体とは別
anim = 3020

[State 3020, 4]
type = AttackDist
trigger1 =  1
value = 9999

[State 3020,3]
type = HitDef                    ;攻撃の設定
trigger1 = AnimElem = 1          ;トリガー、アニメ何枚目
attr = A, HP                     ;技の属性
damage = 21*(64-((Root,Var(4))))/64, 5 ;ダメージ(ヒット,ガード)(28x9=252 3/4)
animtype = Medium                ;くらい属性(ダウンの有無は別項目)
guardflag = MA                   ;ガード属性
hitflag = MAF                    ;ヒットする状態の指定(省略時MAF)
priority = 4, Hit                ;相打ちの優先順位
pausetime = 0, 0                 ;硬直時間(相手,自分)ヒットストップ
hitsound = 5, 0                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = high               ;くらい動作のアニメを指定
ground.slidetime = 24            ;摩擦を無視する時間
ground.hittime  = 24             ;のけぞり時間(1/30秒？)
ground.velocity = ((Root,fVar(1))/2) ;地上で攻撃を受けた時、相手が飛んでいく速度
air.hittime = 40
air.velocity = -2,-3
getpower =  0, 0                 ;p1ゲージ追加増加量
givepower = 30,15                ;p2ゲージ増加量

[State 3020,5]
type = hitoverride               ;攻撃を食らった時に任意のステートへ
trigger1 = 1
attr = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP
stateno = 1030                   ;消滅用のステート
time = 1
IgnoreHitPause = 1

[State 3020,6]
type = changestate
trigger1 = movecontact = 1         ;飛び道具が相手に触れた時
trigger2 = animtime = 0
value = 3025                     ;消滅用のステート
IgnoreHitPause = 1

[State 3020, 7]               ;飛び道具のみをくらう事を許可
type = HitBy
trigger1 = 1
value = SCA,AP

