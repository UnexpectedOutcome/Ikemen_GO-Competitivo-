		guard.hittime		= 10
		air.hittime			= 10
		ground.velocity		= -4
		airguard.velocity	= -1.9,-.8
		air.type			= High
		air.velocity		= -1.4,-3
		air.hittime			= 12
		fall.recovertime	= Ceil(100-(FVar(22)*10))

	[State 200, ヒットスパーク]
