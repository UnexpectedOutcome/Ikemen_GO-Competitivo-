;バックステップ
[Statedef 105]
	type        = A
	movetype    = I
	physics     = A
	anim        = 105
	ctrl        = 0
	sprpriority = 1

	[State 105, 無敵時間]
		Type     = NotHitBy
		Trigger1 = 1
		value    = SCA
		
	[State 105, 移動速度]
		type     = VelSet
		trigger1 = Time = 0
		x        = Const(velocity.run.back.x)
		y        = Const(velocity.run.back.y)

	[State 105, 音を鳴らす]
		type     = PlaySnd
		trigger1 = Time = 1
		value    = 0,17

	[State 105, 音を鳴らす]
		type     = PlaySnd
		trigger1 = AnimElemTime(7) = 0
		value    = 100,0

[State 105, ステート変更]
	type     = ChangeState
	trigger1 = (Time > 0) && (Pos Y >= 0)
	value    = 106

