;---------------------------------------------------------------------------
;空中受け身
[Statedef 5210]
	type		= A
	movetype	= I
	physics		= N
	anim		= 5210
	ctrl		= 0

	[State 5110, 変数]
		type		= VarSet
		trigger1	= SysVar(0)
		trigger1	= Time = 0
		sysvar(0)	= 0

	[State 5200, 色変更]
		type		= palfx
		trigger1	= Time <= 7
		time		= 1
		add			= 200,200,200

	[State 5210, 速度]
		type		= VelMul
		trigger1	= Time = 0
		x			= .8
		y			= .8

	[State 5210, 変数]
		type		= VarSet
		trigger1	= Time = 0
		sysvar(1)	= 0

	[State 5210, 変数]
		Type		= VarSet
		Triggerall	= Time <= 1||sysvar(1) = 0
		Trigger1	= Command = "holdfwd"
		sysvar(1)	= 1

	[State 5210, 変数
		Type		= VarSet
		Triggerall	= Time <= 1||sysvar(1) = 0
		Trigger1	= Command = "holdback"
		sysvar(1)	= -1

	[State 5210, 速度]
		Type		= Velset
		Triggerall	= Time <= 1
		Trigger1	= sysvar(1) = 1
		x			= 2.5
		y			= -9.5
		persistent	= 0

	[State 5210, 速度]
		Type		= Velset
		Triggerall	= Time <= 1
		Trigger1	= sysvar(1) != 1
		y			= -8.6
		persistent	= 0

	[State 5210, 速度]
		Type		= Veladd
		Triggerall	= Time <= 1
		Trigger1	= sysvar(1) = -1
		x			= -2
		persistent	= 0

	[State 5210, 無敵]
		type		= NotHitBy
		trigger1	= Time = 0
		value		= SCA
		time		= 15

	[State 5210, コントロール]
		type		= CtrlSet
		trigger1	= Time = 8
		value		= 1

	[State 5210, 速度]
		type		= VelAdd
		trigger1	= Time >= 1
		y			= .50

	[State 5210, 振り向き]
		type		= Turn
		trigger1	= Time = 1
		trigger1	= p2dist X < -20

[State 5210, ステート変更]
	type		= ChangeState
	trigger1	= Vel Y > 0
	trigger1	= Pos Y >= 0
	value		= 52
	ctrl		= 1

;---------------------------------------------------------------------------
;崩れKO
[Statedef 5190]
	type		= U
	movetype	= H
	physics		= S
	ctrl		= 0

	[State 5190, アニメ変更]
		type			= ChangeAnim
		trigger1		= !HitShakeOver
		value			= 5000
		IgnoreHitPause	= 1

	[State 5190, アニメ変更]
		type			= ChangeAnim
		trigger1		= HitShakeOver
		value			= 5190
		IgnoreHitPause	= 1
		Persistent		= 0

	[State 5190, 無敵]
		type		= NotHitBy
		trigger1	= 1
		value		= SCA
		time		= 2

	[State 5190, ダウン判定]
		type		= HitFallSet
		trigger1	= 1
		value		= 0

	[State 5190, 押し判定]
		type		= PlayerPush
		trigger1	= 1
		value		= 0

	[State 5190, 軸位置]
		type		= PosSet
		trigger1	= 1
		y			= 0

	[State 5190, 移動速度]
		type		= VelSet
		trigger1	= 1
		y			= 0

	[State 5190, 食らい中の速度]
		type		= HitVelSet
		trigger1	= Time = 0
		x			= GetHitVar(XVel) 

[State 5190, ステート変更]
	type		= ChangeState
	triggerall	= (Anim = 5190)
	trigger1	= (AnimElemTime(10) > 1)
	value		= ifelse((Lose),5150,5110)

;---------------------------------------------------------------------------
; HIT_LIEDEAD
[Statedef 5150]
	type        = L
	movetype    = H
	physics     = N
	sprpriority = -3

	[State 5150, 1] ;Normal anim
		type       = ChangeAnim
		triggerall = Time = 0
		triggerall = SelfAnimExist(5140)
		trigger1   = (anim != [5111,5119]) && (anim != [5171,5179])
		trigger2   = !SelfAnimExist(5140 + (anim % 10))
		value      = 5140

	[State 5150, 3] ;Hit up type anim
		type     = ChangeAnim
		trigger1 = Time = 0
		trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
		trigger1 = SelfAnimExist(5140 + (anim % 10))
		value    = 5140 + (anim % 10)

	[State 5150, 4] ;Match over anim
		type       = ChangeAnim
		persistent = 0
		trigger1   = MatchOver = 1
		trigger1   = Anim = [5140,5149]
		trigger1   = SelfAnimExist(anim+10)
		value      = anim+10

	[State 5150, 5]
		type     = ChangeAnim
		trigger1 = Time = 0
		trigger1 = PrevStateNo = 5190
		value    = 5111

	[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
		type     = ChangeAnim
		trigger1 = Time = 0
		trigger1 = PrevStateNo != 5190
		trigger1 = Anim != [5140,5159]
		trigger1 = Anim != [5110,5119]
		value    = 5110

	[State 5150, 6] ;Friction
		type     = VelMul
		trigger1 = 1
		x        = 0.85

	[State 5150, 7] ;Friction
		type       = VelSet
		trigger1   = Vel x < .05
		persistent = 0
		x          = 0

	[State 5150, 8]
		type     = NotHitBy
		trigger1 = 1
		value    = SCA
		time     = 1

