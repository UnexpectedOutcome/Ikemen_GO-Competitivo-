;---------------------------------------------------------------------------
;通常立ち
[Statedef 0]
	type        = S
	physics     = S
	sprpriority = 0

	[State 0, アニメ変更]
		type     = ChangeAnim
		trigger1 = (Anim != 0) && (Anim != 5)
		trigger2 = (Anim = 5) && (AnimTime = 0)
		value    = 0

	[State 0, 移動速度]
		type     = VelSet
		trigger1 = Time = 0
		y        = 0

	[State 0, 移動速度]
		type     = VelSet
		trigger1 = (abs(Vel X) < 2)
		trigger2 = Time = 4
		trigger3 = (PrevStateNo = 20) && (Time = 0)
		x        = 0

[State 0, ステート変更]
	type     = ChangeState
	trigger1 = (!Alive)
	value    = 5050

[State 0, ヘルパー分身バグ対策]
	type     = DestroySelf
	trigger1 = (IsHelper)

;---------------------------------------------------------------------------
;ジャンプ開始
[Statedef 40]
	type        = S
	physics     = S
	anim        = 40
	ctrl        = 0
	sprpriority = 1

	[State 40, システム変数]
		type      = VarSet
		trigger1  = Time = 0
		sysvar(1) = 0

	[State 40, システム変数]
		type      = VarSet
		trigger1  = (command = "holdfwd")
		sysvar(1) = 1

	[State 40, システム変数]
		type      = VarSet
		trigger1  = (command = "holdback")
		sysvar(1) = -1

	[State 40, 移動速度]
		type     = VelSet
		trigger1 = AnimTime = 0
		x        = ifelse(sysvar(1)=0, Const(velocity.jump.neu.x), ifelse(sysvar(1)=1, Const(velocity.jump.fwd.x), Const(velocity.jump.back.x)))
		y        = Const(velocity.jump.y)

	[State 40, 移動速度]
		type     = VelSet
		trigger1 = (AnimTime = 0)
		trigger1 = (PrevStateNo = 100)
		trigger1 = (sysvar(1) = 1)
		x        = Const(velocity.runjump.fwd.x)

	[State 40, 振り返る]
		type       = Turn
		triggerall = (PrevStateNo = 52)
		trigger1   = (Time = 0) && (P2Dist X < -5)
		Persistent = 0

	[State 40, 音を鳴らす]
		type     = PlaySnd
		trigger1 = Time = 0
		value    = 0,17

	[State 40, エフェクト]
		type           = Explod
		trigger1       = Time = 0
		anim           = 2400
		pos            = -30, 0
		postype        = P1
		scale          = 0.5,0.5
		sprpriority    = 4
		ownpal         = 1
		bindtime       = 1
		supermovetime  = 99999
		pausemovetime  = 99999
		persistent     = 0
		vel            = 0,0
		removeongethit = 1
		ignorehitpause = 1
		trans          = Add
		ID             = 2400

[State 40, ステート変更]
	type     = ChangeState
	trigger1 = AnimTime = 0
	value    = 50
	ctrl     = 1

;-------------------------------------------------------------------
;三角跳び
[Statedef 55]
	type		= A
	movetype	= I
	physics		= N
	anim		= 55
	velset		= 0,0
	ctrl		= 0

	[State 55, 振り返り]
		type		= Turn
		trigger1	= Time = 0
		trigger1	= Command ="holdback"

	[State 55, アニメ変更]
		type		= ChangeAnim
		trigger1	= Time = 6
		value		= 42

	[State 55, コントロール]
		type		= CtrlSet
		trigger1	= Time = 6
		value		= 1

	[State 55, 音を鳴らす]
		type		= PlaySnd
		trigger1	= Anim = 42
		trigger1	= AnimElem = 1, = 1
		value		= 0,17

	[State 55, 速度]
		type		= VelSet
		trigger1	= Anim = 42
		trigger1	= AnimElem = 1
		x			= ifelse(command = "holdy"||command = "holdz",5.5,3.7)
		y			= -8.9

	[State 55, 残像]
		type		= AfterImage
		trigger1	= Anim = 42
		trigger1	= AnimElem = 1
		trigger1	= command = "holdy"||command = "holdz"
		time		= 35
		length		= 3
		frameGap	= 1
		timegap		= 6
		palbright	= 0,0,0
		palcontrast	= 130,130,130
		paladd		= 0,0,0
		palmul		= 1,1,1
		trans		= Add1

	[State 55, 速度]
		type		= VelAdd
		trigger1	= Anim = 42
		y			= .55

[State 55, ステート変更]
	type		= ChangeState
	trigger1	= Vel Y > 0
	trigger1	= Pos Y >= 0
	value		= 52

;---------------------------------------------------------------------------
;空中上昇
[Statedef 50]
	type    = A
	physics = A
	
	[State 50, 移動速度]
		type      = VarSet
		trigger1  = Time = 0
		sysvar(1) = 0

	[State 50, アニメ変更]
		type     = ChangeAnim
		trigger1 = Time = 0
		value    = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, ステート変更]
	type       = ChangeAnim
	trigger1   = Vel y > -2
	trigger1   = SelfAnimExist(anim + 3)
	persistent = 0
	value      = Anim + 3

;---------------------------------------------------------------------------
;空中下降
[Statedef 51]
	type     = A
	movetype = I
	physics  = A
	ctrl     = 1

[State 51, アニメ変更]
	type       = ChangeAnim
	trigger1   = (PrevStateNo = [700,701]) && (Time = 0)
	trigger2   = (PrevStateNo = 800) && (Time = 0)
	value      = 41
	elem       = 5
	Persistent = 0

;---------------------------------------------------------------------------
; 着地ステートでは必ず「Ｙ軸方向の軸位置を０」に、かつ「Ｙ軸の速度も０」に
; リセットする事。そうしないと地面にめり込むか、画面下へ消えてしまう（苦笑
;---------------------------------------------------------------------------
;着地
[Statedef 52]
	type	= S
	physics	= S
	ctrl	= 0
	anim	= 47

	[State 52, 軸位置];地面に軸をリセットする
		type		= PosSet
		trigger1	= 1
		y			= 0

	[State 52, 移動速度];速度をリセットしている
		type		= VelSet
		trigger1	= 1
		x			= 0
		y			= 0

	[State 52, コントロール]
		type		= CtrlSet
		triggerall	= (PrevStateNo = [600,699])
		trigger1	= (Time > 0)
		value		= 1

	[State 52, 振り返る]
		type		= Turn
		trigger1	= (AnimTime = 0) && (P2Dist X < 0)
		trigger2	= (AnimElemTime(1) = 0) && (P2Dist X < 0)

	[State 52, 音を鳴らす]
		type		= PlaySnd
		trigger1	= Time = 1
		value		= s50,0

[State 52, ステート変更]
	type		= ChangeState
	trigger1	= Time = 0
	value		= 53
	ctrl		= 0

[State 52, ステート変更]
	type		= ChangeState
	trigger1	= AnimTime = 0
	value		= 0
	ctrl		= 1

;---------------------------------------------------------------------------
;着地2
[Statedef 53]
	type	= S
	physics	= S
	ctrl	= 0
	anim	= 47

	[State 53, 軸位置];地面に軸をリセットする
		type		= PosSet
		trigger1	= 1
		y			= 0

	[State 53, 移動速度];速度をリセットしている
		type		= VelSet
		trigger1	= 1
		x			= 0
		y			= 0

	[State 53, コントロール]
		type		= CtrlSet
		triggerall	= (PrevStateNo = [600,699])
		trigger1	= (Time > 0)
		value		= 1

	[State 53, 振り返る]
		type		= Turn
		trigger1	= (AnimTime = 0) && (P2Dist X < 0)
		trigger2	= (AnimElemTime(1) = 0) && (P2Dist X < 0)

	[State 53, 音を鳴らす]
		type		= PlaySnd
		trigger1	= Time = 1
		value		= s50,0

[State 53, ステート変更]
	type		= ChangeState
	trigger1	= AnimTime = 0
	value		= 0
	ctrl		= 1

;---------------------------------------------------------------------------
;ダッシュ
[Statedef 100]
	type        = S
	movetype    = I
	physics     = N
	anim        = 100
	ctrl        = 1
	sprpriority = -1

	[State 100, アニメ変更]
		type       = ChangeAnim
		triggerall = (Time > 4)
		trigger1   = (command != "holdfwd")
		value      = 47
		Persistent = 0

	[State 100, 状態変更]
		type     = StateTypeSet
		trigger1 = (Anim = 47)
		Physics  = S

	[State 100, 特殊効果]
		type     = AssertSpecial
		trigger1 = 1
		flag     = NoWalk
		flag2    = NoAutoTurn

	[State 100, エフェクト]
		type           = Explod
		trigger1       = Time = 0
		anim           = 2100
		pos            = -10, -60
		postype        = P1
		scale          = 0.5,0.5
		sprpriority    = -1
		ownpal         = 1
		bindtime       = 1
		supermovetime  = 99999
		pausemovetime  = 99999
		persistent     = 0
		vel            = 0,0
		removeongethit = 1
		ignorehitpause = 1
		trans          = Add
		ID             = 2100

	[State 100, 埃]
		type       = MakeDust
		trigger1   = (Anim = 47)
		pos        = 0,0
		spacing    = 1
		Persistent = 0

	[State 100, 移動音]
		type     = PlaySnd
		trigger1 = time%13 = 0
		value    = s50, 0

	[State 100, 軸位置]
		type     = PosSet
		trigger1 = 1
		y        = 0

	[State 100, 移動速度]
		type     = VelSet
		trigger1 = 1
		y        = 0

	[State 100, 移動速度]
		type     = VelSet
		trigger1 = (Anim != 47)
		x        = Const(velocity.run.fwd.x)
		
[State 100, ステート変更]
	type       = ChangeState
	triggerall = (Anim = 47)
	trigger1   = AnimTime = 0
	value      = 0
	ctrl       = 1

