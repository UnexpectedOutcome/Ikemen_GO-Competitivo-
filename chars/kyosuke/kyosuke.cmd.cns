;-| ボタンリマップ（ボタンコンフィグ）|---------------------------------------- 
[Remap]
x	= x	;Ｘボタンの入力判定を実際に押すボタンに割り当てる。
y	= y	;Ｙボタン
z	= z	;Ｚボタン
a	= a	;Ａボタン
b	= b	;Ｂボタン
c	= c	;Ｃボタン
s	= s	;挑発

;-| デフォルト設定 |-----------------------------------------------------------

[Defaults]
	command.time		= 20	;標準のコマンド入力受付時間
	command.buffer.time	= 1		;標準のコマンド入力記憶時間

;==============================================================================
; コマンド定義パート（入力キーを設定する）
;==============================================================================
;-| 超必殺技 |-----------------------------------------------------------
;***********************************
	[Command]
		name = "黄泉路"
		command = ~D, DF, F, b+c
		time = 10

	[Command]
		name = "黄泉路"
		command = ~D, F, b+c
		time = 10

	[Command]
		name = "黄泉路"
		command = ~D, DF, F, z
		time = 10

	[Command]
		name = "黄泉路"
		command = ~D, F, z
		time = 10

	[Command]
		name = "虎牙"
		command = ~D, DF, F, a+b
		time = 10

	[Command]
		name = "虎牙"
		command = ~D, F, a+b
		time = 10

	[Command]
		name = "虎牙"
		command = ~D, DF, F, y
		time = 10

	[Command]
		name = "虎牙"
		command = ~D, F, y
		time = 10

	[command]
		name = "鷲爪"
		command = ~F, D, B, a+b
		time = 10

	[command]
		name = "鷲爪"
		command = ~F, FD, D,DB,  B, a+b
		time = 10

	[command]
		name = "鷲爪"
		command = ~F, D, B, y
		time = 10

	[command]
		name = "鷲爪"
		command = ~F, FD, D,DB,  B, y
		time = 10

;-| 必殺技 |-------------------------------------------------------------------
;***********************************

	[Command]
		name	= "月断_弱"
		command	= ~F, D, $DF, b

	[Command]
		name	= "月断_強"
		command	= ~F, D, $DF, c

;***********************************

	[Command]
		name	= "朧薙_弱"
		command	= ~D, DF, F, b

	[Command]
		name	= "朧薙_弱"
		command	= ~D, F, b
		time	= 5

	[Command]
		name	= "朧薙_強"
		command	= ~D, DF, F, c

	[Command]
		name	= "朧薙_強"
		command	= ~D, F, c
		time	= 5


;***********************************

	[Command]
		name	= "霞移"
		command	= ~D, DF, F, x

	[Command]
		name	= "霞移"
		command	= ~D, F, x
		time	= 5

;***********************************
	[Command]
		name	= "色欲_弱"
		command	= ~D, DB, B, b

	[Command]
		name	= "色欲_弱"
		command	= ~D, B, b
		time	= 5

	[Command]
		name	= "雲斬"
		command	= ~D, DB, B, b

	[Command]
		name	= "雲斬"
		command	= ~D, B, b
		time	= 5

;------------------------------------------------------------------------------
;-| キー２回連続入力 |---------------------------------------------------------
	[Command]
		name    = "FF"	;必須コマンド名
		command = F,F
		time    = 10

	[Command]
		name    = "BB"	;必須コマンド名
		command = B,B
		time    = 10

;------------------------------------------------------------------------------
;-| 受身 |---------------------------------------------------------------------
	[Command]
		name	= "recovery"	;必須コマンド名
		command	= a
		time	= 1

	[Command]
		name	= "recovery"	;必須コマンド名
		command	= b
		time	= 1

	[Command]
		name	= "recovery"	;必須コマンド名
		command	= c
		time	= 1

	[Command]
		name	= "recovery"	;必須コマンド名
		command	= x
		time	= 1

	[Command]
		name	= "recovery"	;必須コマンド名
		command	= y
		time	= 1

	[Command]
		name	= "recovery"	;必須コマンド名
		command	= z
		time	= 1

;------------------------------------------------------------------------------
;-| ボタン単発 |---------------------------------------------------------------
	[Command]
		name	= "a"
		command	= a
		time	= 1

	[Command]
		name	= "b"
		command	= b
		time	= 1

	[Command]
		name	= "c"
		command	= c
		time	= 1

	[Command]
		name	= "x"
		command	= x
		time	= 1

	[Command]
		name	= "y"
		command	= y
		time	= 1

	[Command]
		name	= "z"
		command	= z
		time	= 1

	[Command]
		name	= "s"
		command	= s
		time	= 1

;------------------------------------------------------------------------------
;-| 方向キー |-----------------------------------------------------------------
	[Command]
		name	= "holdfwd"		;必須コマンド名
		command	= /$F
		time	= 1

	[Command]
		name	= "holdback"	;必須コマンド名
		command	= /$B
		time	= 1

	[Command]
		name	= "holdup"		;必須コマンド名
		command	= /$U
		time	= 1

	[Command]
		name	= "holddown"	;必須コマンド名
		command	= /$D
		time	= 1

	[Command]
		name	= "holdy"
		command	= /$y
		time	= 1

	[Command]
		name	= "holdz"
		command	= /$z
		time	= 1

;==============================================================================
; ステートエントリーパート（技などを出せるようにするための条件を設定）
;==============================================================================
;------------------------------------------------------------------------------

[Statedef -1] ;←この行は絶対に消さないでね。必須項目です。

;先行入力認識用ヘルパー暴走防止
[state -1, ステートリセット]
	type			= ChangeState
	trigger1		= IsHelper(99999)
	value			= 99999
	ignorehitpause	= 1

;==============================================================================
; 超必殺技
;==============================================================================
	[State -1, 黄泉路]
		type		= ChangeState
		triggerall	= (Command = "黄泉路") || helper(99999),var(8) > 0
		triggerall	= StateType != A
		triggerall	= power >= 2000
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 200) && (MoveContact)
		trigger3	= (StateNo = 210) && (MoveContact)
		trigger4	= (StateNo = 220) && (MoveContact)
		trigger5	= (StateNo = 230) && (MoveContact)
		trigger6	= (StateNo = 240) && (MoveContact)
		trigger7	= (StateNo = 240) && Var(19) = 1
		trigger8	= (StateNo = 400) && (MoveContact)
		trigger9	= (StateNo = 410) && (MoveContact)
		trigger10	= (StateNo = 420) && (MoveContact)
		trigger11	= (StateNo = 430) && (MoveContact)
		trigger12	= (StateNo=[52,53]) && (Time>=1)
		value		= 3200

	[State -1, 鷲爪]
		type		= ChangeState
		triggerall	= (Command = "鷲爪") || helper(99999),var(7) > 0
		triggerall	= StateType = A
		triggerall	= pos y <= ifelse(vel y < 0,-30,-10)
		triggerall	= power >= 1000
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 600) && (MoveContact)
		trigger3	= (StateNo = 610) && (MoveContact)
		trigger4	= (StateNo = 620) && (MoveContact)
		trigger5	= (StateNo = 630) && (MoveContact)
		value		= 3100

	[State -1, 虎牙]
		type		= ChangeState
		triggerall	= (Command = "虎牙") || helper(99999),var(6) > 0
		triggerall	= StateType != A
		triggerall	= power >= 1000
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 200) && (MoveContact)
		trigger3	= (StateNo = 210) && (MoveContact)
		trigger4	= (StateNo = 220) && (MoveContact)
		trigger5	= (StateNo = 230) && (MoveContact)
		trigger6	= (StateNo = 240) && (MoveContact)
		trigger7	= (StateNo = 240) && Var(19) = 1
		trigger8	= (StateNo = 400) && (MoveContact)
		trigger9	= (StateNo = 410) && (MoveContact)
		trigger10	= (StateNo = 420) && (MoveContact)
		trigger11	= (StateNo = 430) && (MoveContact)
		trigger12	= (StateNo=[52,53]) && (Time>=1)
		value		= 3000

;==============================================================================
; 必殺技
;==============================================================================

	[State -1, 月断_弱]
		type		= ChangeState
		triggerall	= (Command = "月断_弱") || helper(99999),var(2) > 0
		triggerall	= StateType != A
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 200) && (MoveContact)
		trigger3	= (StateNo = 210) && (MoveContact)
		trigger4	= (StateNo = 220) && (MoveContact)
		trigger5	= (StateNo = 230) && (MoveContact)
		trigger6	= (StateNo = 240) && (MoveContact)
		trigger7	= (StateNo = 240) && Var(19) = 1
		trigger8	= (StateNo = 400) && (MoveContact)
		trigger9	= (StateNo = 410) && (MoveContact)
		trigger10	= (StateNo = 420) && (MoveContact)
		trigger11	= (StateNo = 430) && (MoveContact)
		trigger12	= (StateNo=[52,53]) && (Time>=1)
		value		= 1100

	[State -1, 月断_強]
		type		= ChangeState
		triggerall	= (Command = "月断_強") || helper(99999),var(3) > 0
		triggerall	= StateType != A
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 200) && (MoveContact)
		trigger3	= (StateNo = 210) && (MoveContact)
		trigger4	= (StateNo = 220) && (MoveContact)
		trigger5	= (StateNo = 230) && (MoveContact)
		trigger6	= (StateNo = 240) && (MoveContact)
		trigger7	= (StateNo = 240) && Var(19) = 1
		trigger8	= (StateNo = 400) && (MoveContact)
		trigger9	= (StateNo = 410) && (MoveContact)
		trigger10	= (StateNo = 420) && (MoveContact)
		trigger11	= (StateNo = 430) && (MoveContact)
		trigger12	= (StateNo=[52,53]) && (Time>=1)
		value		= 1150

	[State -1, 朧薙_弱]
		type		= ChangeState
		triggerall	= (Command = "朧薙_弱") || helper(99999),var(0) > 0
		triggerall	= StateType != A
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 200) && (MoveContact)
		trigger3	= (StateNo = 210) && (MoveContact)
		trigger4	= (StateNo = 220) && (MoveContact)
		trigger5	= (StateNo = 230) && (MoveContact)
		trigger6	= (StateNo = 240) && (MoveContact)
		trigger7	= (StateNo = 240) && Var(19) = 1
		trigger8	= (StateNo = 400) && (MoveContact)
		trigger9	= (StateNo = 410) && (MoveContact)
		trigger10	= (StateNo = 420) && (MoveContact)
		trigger11	= (StateNo = 430) && (MoveContact)
		trigger12	= (StateNo=[52,53]) && (Time>=1)
		value		= 1000

	[State -1, 朧薙_強]
		type		= ChangeState
		triggerall	= (Command = "朧薙_強") || helper(99999),var(1) > 0
		triggerall	= StateType != A
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 200) && (MoveContact)
		trigger3	= (StateNo = 210) && (MoveContact)
		trigger4	= (StateNo = 220) && (MoveContact)
		trigger5	= (StateNo = 230) && (MoveContact)
		trigger6	= (StateNo = 240) && (MoveContact)
		trigger7	= (StateNo = 240) && Var(19) = 1
		trigger8	= (StateNo = 400) && (MoveContact)
		trigger9	= (StateNo = 410) && (MoveContact)
		trigger10	= (StateNo = 420) && (MoveContact)
		trigger11	= (StateNo = 430) && (MoveContact)
		trigger12	= (StateNo=[52,53]) && (Time>=1)
		value		= 1050

	[State -1, 霞移]
		type		= ChangeState
		triggerall	= (Command = "霞移") || helper(99999),var(4) > 0
		triggerall	= StateType != A
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 200) && (MoveContact)
		trigger3	= (StateNo = 210) && (MoveContact)
		trigger4	= (StateNo = 220) && (MoveContact)
		trigger5	= (StateNo = 230) && (MoveContact)
		trigger6	= (StateNo = 240) && (MoveContact)
		trigger7	= (StateNo = 240) && Var(19) = 1
		trigger8	= (StateNo = 400) && (MoveContact)
		trigger9	= (StateNo = 410) && (MoveContact)
		trigger10	= (StateNo = 420) && (MoveContact)
		trigger11	= (StateNo = 430) && (MoveContact)
		trigger12	= (StateNo=[52,53]) && (Time>=1)
		value		= 1200

	[State -1, 雲斬]
		type		= ChangeState
		triggerall	= (Command = "雲斬") || helper(99999),var(5) > 0
		triggerall	= StateType = A
		triggerall	= pos y <= ifelse(vel y < 0,-30,-10)
		trigger1	= (Ctrl)
		trigger2	= (StateNo = [600,699]) && (MoveContact)
		value		= 1300

;==============================================================================
; 特殊技
;==============================================================================
	[State -1, 地上投げ]
		type		= ChangeState
		triggerall	= (Command = "c")
		triggerall	= command != "a"
		triggerall	= command != "b"
		triggerall	= command != "x"
		triggerall	= command != "y"
		triggerall	= command != "z"
		triggerall	= (StateNo != 100)
		triggerall	= (Command = "holdfwd") && (Command != "holddown") || (Command = "holdback") && (Command != "holddown")
		triggerall	= (StateType != A)
		triggerall	= P2BodyDist X <= ceil(15 * const(size.xscale))
		triggerall	= (P2StateType != A)
		triggerall	= (P2MoveType != H)
		trigger1	= (Ctrl)
		value		= 800

	[State -1, 裏拳]
		type		= ChangeState
		triggerall	= command = "a"
		triggerall	= (Command = "holdfwd") && (Command != "holddown")
		triggerall	= StateType != A
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 200) && (MoveContact)
		trigger3	= (StateNo = 210) && (MoveContact)
		trigger4	= (StateNo = 220) && (MoveContact)
		trigger5	= (StateNo = 230) && (MoveContact)
		trigger6	= (StateNo = 400) && (MoveContact)
		trigger7	= (StateNo = 410) && (MoveContact)
		trigger8	= (StateNo = 420) && (MoveContact)
		trigger9	= (StateNo = 430) && (MoveContact)
		trigger10	= (StateNo=[52,53]) && (Time>=1)
		value		= 240

	[State -1, スライディング]
		type		= ChangeState
		triggerall	= command = "x"
		triggerall	= (Command = "holdfwd") && (Command = "holddown")
		triggerall	= StateType != A
		trigger1	= (Ctrl)
		trigger2	= (StateNo = 200) && (MoveContact)
		trigger3	= (StateNo = 210) && (MoveContact)
		trigger4	= (StateNo = 220) && (MoveContact)
		trigger5	= (StateNo = 230) && (MoveContact)
		trigger6	= (StateNo = 400) && (MoveContact)
		trigger7	= (StateNo = 410) && (MoveContact)
		trigger8	= (StateNo = 420) && (MoveContact)
		trigger9	= (StateNo = 430) && (MoveContact)
		trigger10	= (StateNo=[52,53]) && (Time>=1)
		value		= 450

;==============================================================================
; 移動関連
;==============================================================================

	[State -1, ダッシュ]
		type		= ChangeState
		triggerall	= (Command = "FF") ||  (Command = "y") && (Command = "holdfwd")
		trigger1	= (StateNo != 100) && (StateType != A) && (Ctrl)
		value		= 100

	[State -1, バックステップ]
		type		= ChangeState
		triggerall	= (Command = "BB") ||  (Command = "y") && (Command = "holdback")
		trigger1	= (StateNo != 100) && (StateType != A) && (Ctrl)
		value		= 105

	[State -1, 三角飛び]
		type = ChangeState
		triggerall	= StateType = A
		triggerall	= Ctrl
		triggerall	= Pos Y <= -70
		trigger1 	= BackEdgeBodyDist = 0
		trigger1	= Command = "holdfwd" && Command != "holddown"
		trigger2	= FrontEdgeBodyDist = 0
		trigger2 	= Command = "holdback" && Command != "holddown"
		value		= 55

;==============================================================================
; 通常攻撃技
;==============================================================================
	[State -1, 立ち強斬り]
		type		= ChangeState
		value		= 220
		triggerall	= command = "c"
		triggerall	= command != "holddown"
		trigger1	= (StateType != A) && (Ctrl)
		trigger2	= stateno = 200 || stateno = 210 || stateno = 230 || stateno = 400 || stateno = 410 || stateno = 430
		trigger2	= movecontact
		trigger3	= (StateNo=[52,53]) && (Time>=1)

	[State -1, 立ち斬り]
		type		= ChangeState
		value		= 210
		triggerall	= command = "b"
		triggerall	= command != "holddown"
		trigger1	= (StateType != A) && (Ctrl)
		trigger2	= stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430
		trigger2	= movecontact
		trigger3	= (StateNo=[52,53]) && (Time>=1)

	[State -1, キック]
		type		= ChangeState
		value		= 230
		triggerall	= command = "x"
		triggerall	= command != "holddown"
		trigger1	= (StateType != A) && (Ctrl)
		trigger2	= stateno = 200 ||stateno = 400 || stateno = 430
		trigger2	= movecontact
		trigger3	= (StateNo=[52,53]) && (Time>=1)

	[State -1, パンチ]
		type		= ChangeState
		value		= 200
		triggerall	= command = "a"
		triggerall	= command != "holddown"
		trigger1	= (StateType != A) && (Ctrl)
		trigger2	= stateno = 200 || stateno = 400 || stateno = 430
		trigger2	= movecontact
		trigger3	= (StateNo=[52,53]) && (Time>=1)

;------------------------------------------------------------------------------
	[State -1, しゃがみ強武器攻撃]
		type = ChangeState
		value	= 420
		triggerall	= command = "c"
		triggerall	= command = "holddown"
		trigger1	= statetype = C
		trigger1	= ctrl
		trigger2	= stateno = 200 || stateno = 210 || stateno = 230 || stateno = 400 || stateno = 410 || stateno = 430
		trigger2	= movecontact
		trigger3	= (StateNo=[52,53]) && (Time>=1)

	[State -1, しゃがみ武器攻撃]
		type		= ChangeState
		value		= 410
		triggerall	= command = "b"
		triggerall	= command = "holddown"
		trigger1	= statetype = C
		trigger1	= ctrl
		trigger2	= stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430
		trigger2	= movecontact
		trigger3	= (StateNo=[52,53]) && (Time>=1)

	[State -1, しゃがみキック]
		type		= ChangeState
		value		= 430
		triggerall	= command = "x"
		triggerall	= command = "holddown"
		trigger1	= statetype = C
		trigger1	= ctrl
		trigger2	= stateno = 200 ||stateno = 400 || stateno = 430
		trigger2	= movecontact
		trigger3	= (StateNo=[52,53]) && (Time>=1)

	[State -1, しゃがみパンチ]
		type		= ChangeState
		value		= 400
		triggerall	= command = "a"
		triggerall	= command = "holddown"
		trigger1	= statetype = C
		trigger1	= ctrl
		trigger2	= stateno = 200 || stateno = 400 || stateno = 430
		trigger2	= movecontact
		trigger3	= (StateNo=[52,53]) && (Time>=1)

;------------------------------------------------------------------------------
	[State -1, ジャンプ強斬り]
		type		= ChangeState
		value		= 620
		triggerall	= command = "c"
		trigger1	= statetype = A
		trigger1	= ctrl

	[State -1, ジャンプ斬り]
		type		= ChangeState
		value		= 610
		triggerall	= command = "b"
		trigger1	= statetype = A
		trigger1	= ctrl

	[State -1, ジャンプキック]
		type		= ChangeState
		value		= 630
		triggerall	= command = "x"
		trigger1	= statetype = A
		trigger1	= ctrl

	[State -1, ジャンプパンチ]
		type		= ChangeState
		value		= 600
		triggerall	= Var(30) < 2
		triggerall	= command = "a"
		trigger1	= statetype = A
		trigger1	= ctrl
		trigger2	= stateno = 600
		trigger2	= movecontact

;------------------------------------------------------------------------------
	[State -1, 挑発]
		type       = ChangeState
		triggerall = (Command = "s")
		trigger1   = (StateType != A) && (Ctrl)
		value      = 195

;------------------------------------------------------------------------------
;============================空中ガード========================================
;空中ガード
	[State -1]
		type		= ChangeState
		value		= 132
		triggerall	= alive
		triggerall	= statetype = A
		trigger1	= command = "holdback"
		trigger1	= inguarddist
		trigger1	= StateNo != [120,154]
		trigger1	= ctrl

