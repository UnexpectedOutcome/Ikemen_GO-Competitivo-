;後方待機　（うろつき前へ）
[statedef 8020]
type    = S
physics = n
sprpriority = ifelse(root,var(0),-1,3) 
anim = 8020

[state 8020,bind]
type = BindToRoot
triggerall = root,var(0)= 9000
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[state 8020,canim]
type = changeanim
triggerall = root,var(0) = 0
trigger1 = anim = 8020
trigger1 = rootdist x > 100
value = 8100

[state 8020,canim2]
type = changeanim
triggerall = root,var(0) = 0
trigger1 = anim = 8100
trigger1 = rootdist x < 50
value = 8020

[State 8020, 1]
type = VelSet
trigger1 = time = 0
x = const(velocity.walk.fwd.x)

[State 8020, 4]
type = changestate
trigger1 = root,var(0) = 0
trigger1 = rootdist x < 40
trigger2 = root,var(0)= 9000
trigger2 = root,stateno != 20
value = 8000


