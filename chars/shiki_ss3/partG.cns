; STAND GUARD (guarding)
[Statedef 8130]
type    = S
physics = S

[State 8130, 1]
type = ChangeAnim
trigger1 = Anim != 8130
value = 8130

;---------------------------------------------------------------------------
; CROUCH GUARD (guarding)
[Statedef 8131]
type    = C
physics = C

[State 8131, 1]
type = ChangeAnim
trigger1 = Anim != 8131
value = 8131

;---------------------------------------------------------------------------
; AIR GUARD (guarding)
[Statedef 8132]
type    = A
physics = N

[State 8132, 1]
type = ChangeAnim
trigger1 = Anim != 8132
value = 8132

[State 8132, 2]
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 8132, 3]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 8132, 4]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 8132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 8132, 6]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command != "holdback"
value = 8052

[State 8132, 7]
type = ChangeState
trigger1 = sysvar(0)
value = 8130

;---------------------------------------------------------------------------
; GUARD (end)
