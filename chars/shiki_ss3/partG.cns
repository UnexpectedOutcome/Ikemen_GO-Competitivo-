;---------------------------------------------------------------------------
; Jump Start
[Statedef 8040]
type    = S
physics = S
anim = 8040
ctrl = 0
sprpriority = -1

[state 8040,bind]
type = BindToRoot
triggerall = ishelper(300)
triggerall = root,var(0)= 9000
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 8040, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 8040, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 8040, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 8040, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 8040, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = root,prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = 5

[State 8040, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 8050
ctrl = 0

;---------------------------------------------------------------------------
; Jump Up
[Statedef 8050]
type    = A
physics = A

[state 8021,bind]
type = BindToRoot
triggerall = root,var(0)= 9000
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 8050, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 8050, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 8041, ifelse((vel x)>0, 8042, 8043))

