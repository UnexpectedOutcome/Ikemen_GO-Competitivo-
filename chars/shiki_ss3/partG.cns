;ridewolf.cns
;シクルウ　長すぎ分ける　var(30)
;
;---------シクルゥ-----------------------------------------------------------
[statedef 8000]
type = s
movetype = I
physics = N
velset = 0,0
anim = 8000

[state 8000,sprp];乗ってる時と乗ってない時
type = sprpriority
trigger1 =1
value = ifelse(root,var(0),-1,3)

[state 8000,freez];シクルウ固定命令　乗る時
type = posfreeze
triggerall = root,stateno = 9000
trigger1 = 1
value = 1

[state 8000,bind]
type = BindToRoot
triggerall = root,var(0)= 9000
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 8000,ride]; 
type =changestate
triggerall = root,stateno =[0,199]
triggerall = root,stateno != 0
trigger1 = root,var(0)= 9000
value = 8000 + root,stateno

[State 8000,fwd]; 前方へ 乗ってない時
type =changestate
triggerall = root,var(0) = 0
trigger1 = rootdist  x > 40
value = 8020 

[State 8000,back];後方へ 乗ってない時
type =changestate
triggerall = root,var(0) = 0
trigger1 = rootdist  x < -10
value = 8021 

[state 8000]
type = displaytoclipboard
triggerall = roundstate = 2 && alive
trigger1 = 1
text = "Rvar(0)= %d Ranim= %d Rdist= %f face %d, %d"
params = root,var(0), root,anim, rootdist x, root,facing ,facing

;-----挑発アニメヘ
[state 8000,canim 150]
type = changeanim
triggerall = ishelper(300)
trigger1 =root,stateno = 195
trigger1 = anim = 8000
value = 8190

;----------挑発から戻す----------
[state 8000,canim 150->0]
type = changeanim
triggerall = ishelper(300)
trigger1 = root,stateno != 195
trigger1 = anim = 8190
value = 8000

;---------姿勢を低く
[state 8000,canim0->11]
type = changeanim
triggerall = root,var(0) = 0
triggerall = ishelper(300)
trigger1 =root,stateno = 11
trigger1 = anim != 8011
trigger2 = root,alive = 0
value = 8011

;--------姿勢を戻す
[state 8000,canim11->0]
type = changeanim
triggerall = root,var(0) = 0
triggerall = ishelper(300)
trigger1 =root,stateno != 11
trigger1 = anim = 8011
value = 8000

;--------負けた時
[state 8000, state change for loseintro]
type = changestate
triggerall = ishelper(300)
trigger1 = root,alive = 0
value = 8170

;－－－－－乗ってない時に－－攻撃された時－－－－－－－
[state 8000, state change damage noride]
type = changestate
triggerall = ishelper(300)
triggerall = root,var(0) = 0
trigger1 = root,movetype = h
value = 8159

;---------攻撃・他命令　変数で分岐　ママハハと仕様違うよ
[state 8000, satete change for atack]
type = changestate
triggerall = 1
triggerall = ishelper(300)
trigger1 = root,var(30)
value = 8000 + root,var(30)

[State 8000,turn r to l];本体とヘルパー向き違いの時　
type =changestate
triggerall = root,var(0) = 0
trigger1 = root,facing != facing
value = 8005

[State 8000,turn r to l];乗ってる時ターン　
type =changestate
triggerall = root,var(0)= 9000 
trigger1 = root,anim = 5 + root,var(0)
value = 8005

[State 8000, pos y];強制軸あわせ
type = posset
trigger1 = pos y != 0
y = 0 

;ーーーーーーーーーーーーーーーしくる　振り向き
[statedef 8005]
type    = S
physics = n
sprpriority = ifelse(root,var(0),-1,3) 
anim = 8005

[state 8005,bind]
type = BindToRoot
triggerall = root,var(0)= 9000
trigger1 = 1
time = 1
facing = 0
pos = 0,0

[State 8005,turn ]
type =turn
trigger1 = time = 0
persistent = 0 

[State 8005,];
type =changestate
trigger1 = animtime  =0
trigger2 = root,anim = 0 + root,var(0)
value = 8000 

