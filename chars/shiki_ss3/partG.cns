;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 8120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 8120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 8120 + (statetype = C) + (statetype = A)*2

[State 8120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 8120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 8120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 8120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 8130 + (statetype = C) + (statetype = A)*2

