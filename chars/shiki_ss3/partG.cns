[state 8021,bind]
type = BindToRoot
triggerall = root,var(0)= 9000
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 8021, 1]
type = VelSet
trigger1 = 1
x = const(velocity.walk.back.x)

[State 8020, 4]
type = changestate
trigger1 = rootdist  x > 50
value = 8000


