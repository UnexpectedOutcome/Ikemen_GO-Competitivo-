trigger1 = Time = 0 && statetype = S
physics = S

[State 8140, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 8140, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

