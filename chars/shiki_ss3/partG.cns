;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 8100]
type    = S
physics = S
anim = 8100
sprpriority = -1

[state 8000x,sikuru bind]
type = BindToRoot
triggerall = root,var(0)= 9000
trigger1 = 1
time = 1
facing =1 
pos = 0,0

[State 8000x, cs sikururoot]
type = ChangeState
triggerall = ishelper(300)
trigger1 = AnimTime = 0
value = 8000

[state 8000x,cs sikuruaction];
type = changestate
triggerall = ishelper(300)
trigger1 = root,stateno = [10,40]
value = 8000 + root,stateno

[State 8100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 8100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 8100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 8100, 4]
type = ChangeState
triggerall = ishelper(300)
trigger1 = AnimTime = 0
value = 8000

