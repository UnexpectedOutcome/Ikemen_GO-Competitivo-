;-------以下---乗ってるときの本体-----------------
;-------乗り込み時
[statedef 9000]
type = a
physics = n
movetype = i
velset = -2,-6
anim = 930
sprpriority = 2

[state 9000, grav]
type = veladd
trigger1 = 1
y = 0.24

[state 9000,voice]
type = playsnd
trigger1 = time = 0
value = s3000,0
channel = 0

[State 9000, Override]
type = HitOverride
trigger1 = 1
attr = sca,na,sa,ha,np,sp,hp,nt,st,ht
slot = 0
stateno = 9002 
time = 1
forceair = 1

[State 9000, NotHitby]
type = NotHitBy
trigger1 =1 
value = ,nt,st,ht
time = 1

[state 9000,var];
type = varset
trigger1 = animelem = 4
var(0) = 9000

[state 9000,cs];
type = changestate
trigger1 = animelem = 4
value = 0 

;-------------------------乗ってる時攻撃される
[statedef 9002]
type = u
physics = u
movetype = h

[state 9002,]
type = varset
trigger1 = time = 0
var(0) = 0

[state 9002,cs]
type = changestate
trigger1 = time = 0
value = ifelse(gethitvar(yvel) != 0,5050,5000) 

[state 9002,]
type = changestate
trigger1 = time = 0
value = 5035

