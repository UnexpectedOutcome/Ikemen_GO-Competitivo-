;怒りやすい順時間は逆順
[state -2, power add];変更：持ち越し制fvar(11)攻撃係数 var(11)タイム
type = varset
trigger1 =fvar(11) = 1
trigger1 =power >= 3000
var(11) = 1600

[state -2, power add];
type = varset
trigger1 =1
fvar(11) = ifelse(power >= 3000,1.3,1)

[state -2, power add];
type = varadd
trigger1 =var(11) >= 0
var(11) = -1

[state -2, power ];
type = powerset
trigger1 =var(11) = 0
value = 0

[state -2, power add];
type = varset
trigger1 =var(11) < 0
trigger2 = power < 3000
var(11) = -1

[state -2, power add];
type = poweradd
trigger1 = fvar(11)  = 1
trigger1 = movetype = h
value = floor(gethitvar(damage) * 3.0)

[state -2, ];攻撃力随時設定fvar(0)*fvar(11)5900のをこっちで？
type = varset
trigger1 =1
fvar(0) = fvar(11) *  7.8125 / 3

[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
text = "posx=%f,posy=%f,Edistx=%f,Edisty=%f,fac=%d\n"
params =pos x,pos y,p2bodydist x,p2bodydist y,facing;numexplod(-1) + helper,numexplod(-1);

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
trigger1 = command != "holds"
text = "velX=%f,velY=%f,v(11)=%d,fv(11)=%f,v(12)=%d"
params =vel x,vel y,var(11),fvar(11),var(12)

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
trigger1 = command = "holds"
text = "CharaCv(5)=%d,down hit v(4)=%d,jump dir sv(1)=%d,AirD v(7)=%d,GroD v(8)=%d"
params =var(5),var(4),sysvar(1),var(7),var(8)

