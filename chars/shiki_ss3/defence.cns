;移動起きあがり　s950,anim950,955
[statedef 950]
type = L
movetype = I
pysicas = N
ctrl = 0
velset = ifelse(command = "holdfwd",3.5,-3.5),0
anim =ifelse(command = "holdfwd",950,955)
