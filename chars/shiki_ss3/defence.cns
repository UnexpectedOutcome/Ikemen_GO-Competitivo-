;--------三角飛び
[statedef 960]
type =A
movetype = I
pysicas = A
ctrl = 0
velset = 0,0
anim =960
sprpriority = 2

[state 960,]
type = turn
trigger1 = frontedgedist < 5
trigger1 = time = 0
persistent = 0

[state 960,plays]
type = playsnd
trigger1 = animelemtime(1) = 0
value = 40,0

[state 960,]
type = posset
trigger1 = animelem = 2;animtime = 0
x = pos x + ifelse(facing = 1,10,-10)
persistent = 0

[State 960, ]
type = VelSet
trigger1 =  animelem = 2;animtime = 0
x = const(velocity.jump.fwd.x)
y = const(velocity.jump.y)

[state 960,]
type = varset
trigger1 = animelem = 2;time = 0
var(6) = 1

[state 960,]
type = changestate
trigger1 = animelem = 2;animtime = 0
value = 50
ctrl = 1

