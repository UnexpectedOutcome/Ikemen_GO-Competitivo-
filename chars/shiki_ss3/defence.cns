;防御行動, Dex, その他　汎用エフェクト（氷） 
;c = Dex  z =Aex(highslash)
; s900 回りこみ s910 見切り (s930,下段回避　s940　伏せ)削除
; s950 移動起きあがり s960三角飛びvar(6)
;s6510 var(50) =氷砕けタイムアウト

;----------------------------
[statedef 900]
type = s
movetype = I
physics = n 
ctrl = 0
anim = 910
velset = 5.3,0.8
sprpriority = 4

[State 900, nohit]
type = NotHitBy
trigger1 = 1
value = SCA,na,nt,np,sa,st,sp,ha,hp,ht
time = 1

[state 180,voice]
type = playsnd
trigger1 = animelem = 2
value = s900,0
channel = -1

[state 900,voice]
type = playsnd
trigger1 = time = 0
value = s200,3
channel = 0

[state 900, veladd]
type = veladd
trigger1 = animelem = 3
y = -0.6  

[state 900, posset]
type = posset
trigger1 = animtime = 0
y = 0

[state 900, end]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

