[Statedef 30000]; ステージ右端チェックヘ?パー
type      = A
movetype  = I
physics   = N
velset    = -7, 0
ctrl      = 0
anim      = 9123000

[State 30000, 非表示に設定]
type = AssertSpecial
trigger1 = 1
flag = invisible

[State 30000, 無敵状態付加]
type = NotHitBy
trigger1 = 1
value = SCA

[State 30000, ?一本体がここにきた場?待機?ーシ??へ]
type = SelfState
trigger1 = !IsHelper
value = 0

[State 30000, ステージ端チェック用Projectile]
type = Projectile
trigger1 = Time = 0
projID = 30000
projanim = 9123000
projremove = 0
projremovetime = -1
velocity = -7.0, 0.0
projstagebound = -1
projedgebound = 65535
supermovetime = 65535
pausemovetime = 65535

[State 30000, projstageboundの効果でProjectileが消えたら停止]
type = VelSet
trigger1 = Root, NumProjID(30000) = 0
trigger1 = Time > 0
x = 0
y = 0

[State 30000, Root(プ?イ?ー)前面からステージ端(ヘ?パー)までの?離を設定]
type = ParentVarSet
;triggerall = root,var(59)
trigger1 = Root, facing = 1
fvar(32) = Floor(RootDist X) - Const(size.ground.front) + 2

[State 30000, Root(プ?イ?ー)背面からステージ端(ヘ?パー)までの?離を設定]
type = ParentVarSet
;triggerall = root,var(59)
trigger1 = Root, facing = -1
fvar(33) = Floor(RootDist X) - Const(size.ground.back) - 1

;?手の背丈チェック
[State -2, set]
type = VarSet
triggerall = root,var(59)
triggerall = roundstate = 2
trigger1 = enemynear(floor(root,fvar(31))),Const(size.mid.pos.y) >= -45
v = 3
value = 1
ignorehitpause = 1

;固められ?間カウ?ト
[State -2, timeset]
type = varadd
triggerall = root,var(59)
triggerall = roundstate = 2
trigger1 = root,movetype = H && (root,stateno = [120,155])
trigger2 = root,movetype = H && (root,stateno = [4000,4200])
v = 17
value = 1
ignorehitpause = 1

;固められ?間カウ?ト?セット
[State -2, set]
type = VarSet
triggerall = root,var(59)
triggerall = roundstate = 2
triggerall = var(17)
trigger1 = root,statetype = L
trigger2 = root,movetype = A
trigger3 = root,stateno = 810
trigger4 = root,stateno = 1400 && root,var(12)
v = 17
value = 0
ignorehitpause = 1

;?手体力計算
[State -2, p2lifeset]
type = Varset
triggerall = root,var(59)
triggerall = root,life != 0
triggerall = roundstate = 2
trigger1 = 1
v = 21
value = (100 * enemynear(floor(root,fvar(31))),life / enemynear(floor(root,fvar(31))),lifemax)
ignorehitpause = 1
;==============================================================================
;?段記憶ここから var(4)～var(8)を使用
;==============================================================================
[State -2, 寸前にどういう状態で?ったか]
