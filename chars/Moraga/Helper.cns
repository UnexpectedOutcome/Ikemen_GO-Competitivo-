; PlayerID取得
[Statedef 887710]

[STATE PlayerID取得?制限]
type = VarSet
trigger1 = var(7)>10
var(7) = 10
[STATE PlayerIDを格納するVAR]
type = VarSet
trigger1 = 1
var(5) = 11+(var(11)>0)+(var(12)>0)+(var(13)>0)+(var(14)>0)+(var(15)>0)+(var(16)>0)+(var(17)>0)+(var(18)>0)+(var(19)>0)+(var(20)>0)
[STATE PlayerID取得]
type = VarSet
trigger1 = PlayerIDExist(var(6)-var(7))         ;PlayerIDが存在する
trigger1 = (var(6)-var(7))!=var(var(5)-1)           ;重複登録の防止
trigger1 = PlayerID(var(6)-var(7)),IsHelper         ;ヘ?パーに限る
trigger1 = PlayerID(var(6)-var(7)),IsHomeTeam!=IsHomeTeam   ;?手側に限る
var(var(5)) = PlayerID(var(6)-var(7)),ID
[STATE マーキ?グ]                  ;飛び道具必殺技と思われるステートで呼び出されたヘ?パーをマーキ?グ
type = VarSet
trigger1 = PlayerIDExist(var(var(5)))
trigger1 = PlayerID(var(6)-var(7)),IsHelper
trigger1 = PlayerID(var(var(5))),MoveType!=A||!(PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP,AT)  ;攻?判定無し
trigger1 = EnemyNear,MoveType=A             ;?手が攻?判定の?に呼び出された
trigger1 = !(EnemyNear,HitDefAttr=SCA,AA,AP,AT)     ;?手がHitDefを出してない(飛び道具?)
trigger1 = EnemyNear,CTRL=0
trigger1 = EnemyNear,Time>10
trigger1 = EnemyNear,StateNo>=1000          ;1000以上なら大抵必殺技
var(var(5)+10) = PlayerID(var(var(5))),ID

[STATE loop]
type = ChangeState
trigger1 = var(7)>0
trigger1 = var(7):=var(7)-1||1
value = 887701
[STATE end]
type = ChangeState
trigger1 = var(7)<=0
value = 887701
