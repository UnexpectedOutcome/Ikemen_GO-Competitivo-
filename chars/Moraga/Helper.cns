;==============================================================================
;*******************************   AIヘ?パー   *******************************
;==============================================================================
;めくり対策とヘ?パー監?、超必殺判定を?ねるAI用ヘ?パーを呼び出す
;------------------------------------------------------------------------------
; 0          超必殺判定(Enemy,Power)
; 1          超必殺判定
; 2          AI開始/0
; 3          ヘ?パー監?(Enemy,NumHelper)
; 4          ヘ?パー監?(ト?ガ)
; 5          ヘ?パー監?(loop用)
; 6          ヘ?パー監?(現在最大PlayerID)
; 7          ヘ?パー監?(前回より?加したHelperの?)
; 11-20      ヘ?パー監?(PlayerID)
; 21-30      ヘ?パー監?(マーキ?グ)
; 50         ヘ?パー監?(飛び道具監?、飛び道具1こめ)
; 51         ヘ?パー監?(飛び道具監?、飛び道具2こめ)
; 52         ヘ?パー監?(?下飛び道具警戒)
; 53         ヘ?パー監?(設置近?離警戒)
; 54         ヘ?パー監?(設置??離警戒)
;
;------------------------------------------------------------------------------
[Statedef 887700]
type     = S
movetype = I
physics  = N
ctrl     = 0
velset   = 0,0
anim     = 0
sprpriority = -1

; ??
[STATE BtR]
type = BindToRoot
trigger1 = 1
time = 100000
pos = 0,0

[STATE Turn]    ;めくり対策にROOTと逆を向かせ、本体の後ろ側のInGuardDistを取得する
type = Turn
trigger1 = facing=root,facing   ;BtRのfacingは内?的な向きは変わらないらし

[STATE 非表示]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2= noshadow

[STATE 無敵化]
type = NOTHITBY
trigger1 = 1
value = SCA
time = 999999

;------------------------------------------------------------------------------
[STATE AI開始]
type = VarSet
trigger1 = 1
var(2) = 0
persistent=0

[STATE AI開始]
type = VarAdd
trigger1 = RoundState=2
var(2) = 1

[STATE AI開始]
type = ChangeState
trigger1 = var(2)>40
value = 887701      ;40フ?ー??れば?手の常?監?ヘ?パーは起動してる
;------------------------------------------------------------------------------
[Statedef 887701]
;------------------------------------------------------------------------------
; ??
[STATE BtR]
type = BindToRoot
trigger1 = 1
time = 100000
pos = 0,0

[STATE Turn]    ;めくり対策にROOTと逆を向かせ、本体の後ろ側のInGuardDistを取得する
type = Turn
trigger1 = facing=root,facing   ;BtRのfacingは内?的な向きは変わらないらし

[STATE 非表示]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2= noshadow

[STATE 無敵化]
type = NOTHITBY
trigger1 = 1
value = SCA
time = 999999

[STATE 0]
type = VarSet
trigger1 = 1
var(2) = 0
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; AI - 超必殺判定
;------------------------------------------------------------------------------
[STATE 超必殺判定]
type = VarSet
triggerall = Time
trigger1 = var(0)>enemy,power
var(1) = floor((var(0)-enemy,power)*0.001)

[STATE 超必殺判定(?セット)]
type = VarSet
triggerall = Time
trigger1 = enemynear,movetype=H
trigger2 = enemynear,stateno=[0,105]
trigger3 = enemynear,stateno=[120,155]
trigger4 = enemynear,stateno=[5000,5210]
var(1) = 0

[STATE ENEMY,POWER]
type = VarSet
trigger1 = Time
var(0) = enemynear,power
;/超必殺判定

;------------------------------------------------------------------------------
; AI - ヘ?パー監?
;------------------------------------------------------------------------------
[STATE DEBUG]
type = DisplayToClipboard
trigger1 = Time
text = "HELPER:%d %d %d %d %d "
params = var(11),var(12),var(13),var(14),var(15)
[STATE DEBUG]
Type = AppendToClipBoard
trigger1 = Time
text = "%d %d %d %d %d"
params = var(16),var(17),var(18),var(19),var(30)
[STATE DEBUG]
Type = AppendToClipBoard
trigger1 = Time
text = "\n50:%d 51:%d 52:%d 53:%d 54:%d"
params = var(50),var(51),var(52),var(53),var(54)

[STATE PlayerID取得フ?グ]
type = VarSet
triggerall = Time
trigger1 = Enemy,NumHelper > var(3);?手のヘ?パーが?えた
var(4) = 1

[STATE ]
type = VarSet
trigger1 = Time
var(3) = Enemy,NumHelper

[STATE PlayerIDAdd]
type = Helper
triggerall = Time
trigger1 = RoundState=2
trigger1 = var(4)
name = " "
id = 886600
stateno = 886600
supermovetime = 99990000000
pausemovetime = 99990000000

[STATE ヘ?パー?加?]          ;前回より?加したヘ?パーの?+2
type = VarSet               ;helperから呼び出されたhelperの?加が読めない保険分
triggerall = Time
trigger1 = NumHelper(886600)
trigger1 = var(4)
var(7) = helper(886600),ID-var(6)+2

;------------------------------------------------------------------------------
[STATE 警戒フ?グの?セット]
type = VarRangeSet
trigger1 = Time
first = 50
last = 54
value = 0

;------------------------------------------------------------------------------
[STATE PlayerID取得]
type = ChangeState
triggerall = Time
trigger1 = RoundState=2
trigger1 = var(5):=11+0||1
trigger1 = var(4):=0    ||1
value = 887711
;/ヘ?パー監?

;------------------------------------------------------------------------------
;/AIヘ?パー
;==============================================================================
; ヘ?パー監??ープ
[Statedef 887711]
[STATE ?セット1]   ;存在しないPlayerIDが格納されているVARは?セットする
type = VarSet
trigger1 = PlayerIDExist(var(var(5)))=0
var(var(5)) = 0

[STATE ?セット2]   ;攻?用ヘ?パーではないと思われるヘ?パーのPlayerIDは?セットする
type = VarSet
triggerall = PlayerIDExist(var(var(5)))
;?手のMoveContactとほぼ同?に出現したヘ?パーはヒットスパーク表示用と思われるので?セット
trigger1 = EnemyNear,MoveContact=[1,2]
trigger1 = PlayerID(var(var(5))),Time<=2
;timeが120以上でMoveTypeがAでないヘ?パー
trigger2 = PlayerID(var(var(5))),MoveType!=A&&PlayerID(var(var(5))),time>120
;timeが600以上のヘ?パー
trigger3 = PlayerID(var(var(5))),time>600
;command入力されたHelperはkeyctrl=1のAI用ヘ?パー臭いので?セット
trigger4 = PlayerID(var(var(5))),command="holdfwd"
;Time=0が読みとれるHelperも常?監?でSelfStateしているAI用ヘ?パー臭い
trigger5 = PlayerID(var(var(5))),Time=0
var(var(5)) = 0

[STATE マーキ?グ?セット]
type = VarSet
trigger1 = PlayerIDExist(var(var(5)))=0
var(var(5)+10) = 0

;//////////////////////////////////////////////////////////////////////////////
;------------------------------------------------
; 飛び道具監? いっこめ
[STATE 飛び道具監?(HitDef型)]
type = NULL
triggerall = PlayerIDExist(var(var(5)))
trigger1 = PlayerID(var(var(5))),MoveType=A         ;攻?判定
trigger1 = PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP       ;攻?判定のヘ?パー
trigger1 = PlayerID(var(var(5))),Vel X>0            ;前進してる
trigger1 = PlayerID(var(var(5))),Pos Y<10           ;地面にめり?んでない

;0-8(511)       P2BodyDist X[0-511]
;こちらとの?離、0-511 (255を加えてるので実際は-256～255まで)
trigger1 = var(50):=(var(50)|255-Ceil(PlayerID(var(var(5))),P2BodyDist X))  ||1
;9-16(97792)        POS Y [0-191]
;飛び道具の?さ、0-191 (1/2してるので最大-382まで、誤差2前後)
trigger1 = var(50):=(var(50)|512*abs(Ceil(PlayerID(var(var(5))),Pos Y/2)))  ||1
;17-21(4063232)     Vel X [0-31]
;飛び道具のVEL X、0-31
trigger1 = var(50):=(var(50)|131072*Ceil(PlayerID(var(var(5))),Vel X))      ||1
;22-26(130023424)   Vel Y [0-31]
;飛び道具のVEL Y、0-31  (15を加えてるので実際-16～15まで)
trigger1 = var(50):=(var(50)|4194304*(15-Ceil(PlayerID(var(var(5))),Vel Y)))

;ト?ガーとして使う場?はこうする
;こちらとの?離 :   -((helper(887700),var(50)&511)-255)
;飛び道具の?さ :   (helper(887700),var(50)&97792)/256
;飛び道具のVEL X:   (helper(887700),var(50)&4063232)/131072
;飛び道具のVEL Y:   -(((helper(887700),var(50)&130023424)/4194304)-15)

[STATE 飛び道具監?(Proj型)]
type = NULL
triggerall = PlayerIDExist(var(var(5)))
triggerall = var(var(5))=var(var(5)+10)             ;マーキ?グしたヘ?パー
trigger1 = EnemyNear,NumProj                    ;?手がProjectileを出してる
trigger1 = PlayerID(var(var(5))),MoveType=I
trigger1 = !(PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP)
trigger1 = PlayerID(var(var(5))),Vel X>0
trigger1 = PlayerID(var(var(5))),Pos Y<10
trigger1 = var(50):=(var(50)|255-Ceil(PlayerID(var(var(5))),P2BodyDist X))  ||1
trigger1 = var(50):=(var(50)|512*abs(Ceil(PlayerID(var(var(5))),Pos Y/2)))  ||1
trigger1 = var(50):=(var(50)|131072*Ceil(PlayerID(var(var(5))),Vel X))      ||1
trigger1 = var(50):=(var(50)|4194304*(15-Ceil(PlayerID(var(var(5))),Vel Y)))
;------------------------------------------------
; 飛び道具監? 2こめ
[STATE 飛び道具監?(HitDef型)]
type = NULL
triggerall = PlayerIDExist(var(var(5)))
trigger1 = var(50)                      ;いっこめがすでに?る?だけ
trigger1 = PlayerID(var(var(5))),MoveType=A         ;攻?判定
trigger1 = PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP       ;攻?判定のヘ?パー
trigger1 = PlayerID(var(var(5))),Vel X>0            ;前進してる
trigger1 = PlayerID(var(var(5))),Pos Y<10           ;地面にめり?んでない
trigger1 = var(51):=(var(51)|255-Ceil(PlayerID(var(var(5))),P2BodyDist X))  ||1
trigger1 = var(51):=(var(51)|512*abs(Ceil(PlayerID(var(var(5))),Pos Y/2)))  ||1
trigger1 = var(51):=(var(51)|131072*Ceil(PlayerID(var(var(5))),Vel X))      ||1
trigger1 = var(51):=(var(51)|4194304*(15-Ceil(PlayerID(var(var(5))),Vel Y)))

[STATE 飛び道具監?(Proj型)]
type = NULL
triggerall = PlayerIDExist(var(var(5)))
triggerall = var(var(5))=var(var(5)+10)             ;マーキ?グしたヘ?パー
trigger1 = EnemyNear,NumProj                    ;?手がProjectileを出してる
trigger1 = var(50)
trigger1 = PlayerID(var(var(5))),MoveType=I
trigger1 = !(PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP)
trigger1 = PlayerID(var(var(5))),Vel X>0
trigger1 = PlayerID(var(var(5))),Pos Y<10
trigger1 = var(51):=(var(51)|255-Ceil(PlayerID(var(var(5))),P2BodyDist X))  ||1
trigger1 = var(51):=(var(51)|512*abs(Ceil(PlayerID(var(var(5))),Pos Y/2)))  ||1
trigger1 = var(51):=(var(51)|131072*Ceil(PlayerID(var(var(5))),Vel X))      ||1
trigger1 = var(51):=(var(51)|4194304*(15-Ceil(PlayerID(var(var(5))),Vel Y)))


;------------------------------------------------
; ?下監?
[STATE ?下飛道具(HitDef型)]
type = VarSet
triggerall = PlayerIDExist(var(var(5)))
trigger1 = PlayerID(var(var(5))),MoveType=A
trigger1 = PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP
trigger1 = PlayerID(var(var(5))),Vel X = [-1,1]
trigger1 = PlayerID(var(var(5))),Vel Y >= 1
trigger1 = PlayerID(var(var(5))),P2BodyDist X=[-100,100]
trigger1 = PlayerID(var(var(5))),P2Dist Y>0
var(52) = 1+Ceil(PlayerID(var(var(5))),P2BodyDist Y-PlayerID(var(var(5))),Vel Y*10)
;自分の前後100px範囲内に?下飛び道具っぽいのを見つけると、Var(51)に?下飛び道具の?さを代入します

[STATE ?下飛道具(Proj型)]
type = VarSet
triggerall = PlayerIDExist(var(var(5))) ;上から?る飛び道具(P)
triggerall = var(var(5))=var(var(5)+10)
trigger1 = PlayerID(var(var(5))),MoveType=I
trigger1 = !(PlayerID(var(var(5))),HitDefAttr=SCA,AA,AP)
trigger1 = PlayerID(var(var(5))),Vel X = [-1,1]
trigger1 = EnemyNear,NumProj
trigger1 = PlayerID(var(var(5))),Vel Y >= 1
trigger1 = PlayerID(var(var(5))),P2BodyDist X=[-100,100]
trigger1 = PlayerID(var(var(5))),P2Dist Y>0
var(52) = 1+Ceil(PlayerID(var(var(5))),P2BodyDist Y-PlayerID(var(var(5))),Vel Y*10)

