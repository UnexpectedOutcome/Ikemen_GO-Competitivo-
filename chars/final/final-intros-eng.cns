;---------------------------------------------------------------------------
; Intro FULL GAME
[Statedef 192]
type = S
ctrl = 0
anim = 192
velset = 0,0

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro
flag2 = nobardisplay

;ojos
[State 0, Explod]
type = Explod
trigger1 = animelem = 1
anim = 195
ID = 191
pos = -1,0
bindtime = -1
sprpriority = 3
persistent = 0
removetime = -1

;energia
[State 0, Explod]
type = Explod
trigger1 = animelem = 1
anim = 199
ID = 199
pos = 0,0
bindtime = -1
sprpriority = 0
removetime = -1
ownpal = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = 6,14
volume = -50
channel = 14
loop = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim = 193 && animtime = 0
value = 6,13
volume = 200
freqmul = 2.0

;dialogos Ingles
[State 3900, 1]
type = Explod
trigger1 = time = 40
anim = ifelse(P2name = "ananzi",320,ifelse(P2name = "animus",321,ifelse(P2name = "shar-makai",322,ifelse(P2name = "hashi",323,ifelse(P2name = "noroko",324,325)))))
postype = left
bindtime = -1
ontop = 1
ownpal = 1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = P2name = "ananzi" && time = 1240
trigger2 = P2name = "animus" && time = 2690
trigger3 = P2name = "shar-makai" && time = 1390
trigger4 = P2name = "hashi" && time = 890
trigger5 = P2name = "noroko" && time = 1240
trigger6 = P2name = "peketo" && time = 1290
value = 193

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = anim = 193
id = 191

;ojos 2
[State 0, Explod]
type = Explod
trigger1 = anim = 193 && animelem = 1
anim = 196
pos = -1,0
bindtime = -1
sprpriority = 3

;explosion loca
[State 0, Explod]
type = Explod
trigger1 = anim = 193 && animtime = 0
anim = 3040
pos = -5,-100
bindtime = -1
sprpriority = 0
scale = 3,3
ownpal = 1

[State 0, EnvShake]
type = EnvShake
trigger1 = anim = 193 && animtime = 0
time = 12
ampl = -12

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = anim = 193 && animtime = 0
value = 0