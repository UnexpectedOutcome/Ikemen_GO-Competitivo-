;-----基本情報------------------------------------------------------
[Info]
Name         = "hanyu"   ;キャラの名前（後々必要な場合があるので省略不可）
DisplayName  = "hanyu"   ;ゲーム中表示される名前（省略可能）
VersionDate  = 01,02,2009      ;キャラの最終更新日
MugenVersion = 11,15,2007      ;このキャラを使用出来るM.U.G.E.Nのバージョン
Author       = "baggy"      ;このキャラの作成者の名前
Pal.Defaults = 6,3,4,2         ;CPUで出てくるキャラカラーの順番

;-----必要なファイルの設定------------------------------------------
[Files]
Cmd      = hanyu.cmd          ;入力コマンド定義ファイルの登録
Cns      = hanyu.cns          ;基本ステータス情報ファイルの登録
St       = hanyu_0.cns       ;動作プログラムファイルの登録（最大１０個くらい増やせます（St,St0,St1,St2......））
St0      = hanyu_1.cns
St1      = hanyu_-2.cns
St2      = hanyu_-3_AI.cns
StCommon = hanyu_common.cns      ;コモン動作プログラムファイルの登録
Sprite   = hanyu.sff          ;複数のPCX画像を１パック化したスプライトファイルの登録
Anim     = hanyu.air          ;アニメーションファイルの登録
Sound    = hanyu.snd          ;複数のWAV音声を１パック化したサウンドファイルの登録

;---カラーパレットファイルの設定（最大１２個まで可能）---
Pal1 = hanyu_Col_0.act   ;Ａボタンで決定した色が使えます
Pal2 = hanyu_Col_0.act             ;Ｂボタンで決定
Pal3 = hanyu_Col_0.act             ;Ｃボタンで決定
Pal4 = hanyu_Col_0.act             ;Ｘボタンで決定
Pal5 = hanyu_Col_0.act             ;Ｙボタンで決定
Pal6 = hanyu_Col_0.act             ;Ｚボタンで決定
Pal7 = hanyu_Col_0.act             ;Ｓ押しながらＡボタンで決定した色が使えます
Pal8 = hanyu_Col_0.act             ;Ｓ押しながらＢボタンで決定
Pal9 = hanyu_Col_0.act             ;Ｓ押しながらＣボタンで決定
Pal10= hanyu_Col_0.act             ;Ｓ押しながらＸボタンで決定
Pal11= hanyu_Col_0.act             ;Ｓ押しながらＹボタンで決定
Pal12= hanyu_Col_0.act             ;Ｓ押しながらＺボタンで決定

;-----ストーリーボード設定------------------------------------------
[Arcade]
;Intro.Storyboard  = intro.def
;Ending.Storyboard = ending.def
