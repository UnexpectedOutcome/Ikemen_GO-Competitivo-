
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ステータスファイル
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Data]
life = 1000                   ;体力
power = 2000                  ;テンションケージ量
attack = 100                  ;攻撃力
defence = 90                ;防御力
fall.defence_up = 85          ;倒れ時に増加する防御力
liedown.time = 55             ;起き上がり時間
airjuggle = 8                ;juggle設定
sparkno = s20000                   ;攻撃ヒットマーク
guard.sparkno = s20010　　　　　　;防御ヒットマーク
KO.echo = 1                  ;KO時の声エコー
volumeScale = 255　　　　　　 ;音ボリューム
IntPersistIndex = 60　　　　　;次ラウンドに持ち越すvar
FloatPersistIndex = 1,2　　　 　;次ラウンドに持ち越すfvar
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Size]
xscale = 1.00                  ;画像の大きさの比率（横）
yscale = 1.00                  ;画像の大きさの比率（縦）
ground.back = 14              ;中心より後ろ方向の幅（押し返し幅）
ground.front = 14             ;中心より前方向の幅（押し返し幅）
air.back = 14                 ;中心より後ろ方向の幅（押し返し幅）
air.front = 14                ;中心より前方向の幅（押し返し幅）
height = 50                   ;自分を飛び越せない高さ
attack.dist = 160             ;相手がガードモーションに入る距離
proj.attack.dist = 90         ;相手がガードモーションに入る距離
proj.doscale = 0              ;projectをキャラのスケールに依存するか否
head.pos = -4, -70            ;頭の位置
mid.pos = -4, -45             ;体の中心位置
shadowoffset = 0              ;影の描き込み位置（y）
draw.offset = 0,0             ;キャラを描き込む位置（x,y）
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Velocity]
walk.fwd = 4.0               ;前進速度
walk.back = -4.0              ;後退速度
run.fwd = 8.1, 0              ;ダッシュ速度（x, y)
run.back = -8.1, -8.0            ;バックステップ速度 (x, y)
jump.neu = 0,-15.2            ;垂直ジャンプ速度(x, y)
jump.back = -4.2,             ;バックジャンプ速度(x, y)
jump.fwd = 4.2                ;ジャンプの速度(x, y)
runjump.back = -2.55,-10      ;ダッシュ後ジャンプの速度
runjump.fwd = 8.6,-10         ;ダッシュ前ジャンプの速度
airjump.neu = 0,-8.8          ;垂直２段ジャンプの速度 
airjump.back = -2.6           ;後２段ジャンプの速度
airjump.fwd = 2.6             ;前２段ジャンプの速度
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Movement]
airjump.num = 0               ;２段ジャンプ可能回数
airjump.height = 35           ;２段ジャンプ可能な地面からの高さ
yaccel = .82                  ;空中状態の重力
stand.friction = .85          ;立状態の摩擦
crouch.friction = .82         ;屈状態の摩擦
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


;---------------------------------------------------------------------------
; 勝利メッセージ
;---------------------------------------------------------------------------
[ja.Quotes]

;---------------------------------------------------------------------------








;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;commonステート記述の一部上書き
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;タイムオーバー（負けた時）
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 無敵]
type = NotHitBy
trigger1 = 1 ;トリガーを何も書かず「1」にする事により、『無条件で常に実行させる命令』になる。
value = SCA
time = 1

;-------------------- paln=1 デンジの時 -------------------------------
[State , 赤く]
Type = palfx
trigger1 = animelem=2,>10 && animelem=3,<8
time=1
mul=255,50,50
color=0
invartall=0

[State , 血しぶき]
Type = explod
trigger1 = animelem=2,>10 && animelem=3,<8 && time%3=0
anim=10030
postype=p1
pos=0,-80
scale=1,1
angle=random
sprpriority=2
ownpal=1

[State , 血の音]
type = PlaySnd
trigger1 = animelem=2,11
value = 5,8


;-------------------- paln=2 ポチタの時 -------------------------------
[State , カラーで立ち絵変える]
type = ChangeAnim
trigger1 = palno=2 && anim!=182
value = 182

[State , 十字架]
Type = explod
trigger1 = palno=2 && anim!=182 &&!time
anim=183
postype=p1
pos=0,0
scale=1,1
sprpriority=0
ownpal=1




;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;KO負け
[Statedef 5150]
type    = L
movetype= H
physics = N
ctrl = 0
sprpriority = -5

[State 5150, Normal anim]
type = ChangeAnim
triggerall = Time = 0
triggerall = SelfAnimExist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !SelfAnimExist(5140 + (anim % 10))
value = 5140

[State 5150, Hit up type anim]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5150, Match over anim]
type = ChangeAnim
persistent = 0
;trigger1 = Time = 0
trigger1 = MatchOver = 1
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value = anim+10

[State 5150, Switch to 5110 if liedead anim does not exist]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
trigger1 = Anim != [5110,5119]
value = 5110

[State 5150, Friction]
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, Friction]
type = VelSet
trigger1 = abs(Vel x) < Const(movement.down.friction.threshold)
persistent = 0
x = 0

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 5150, 画面外に居る時用にカメラを固定]
Type = ScreenBound
Trigger1 = 1
Value = 0
MoveCamera = 0,0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = [5140,5110]
trigger1 = time > 30
value = 170



;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;イントロ分岐
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, イントロ分岐 - ポチタの時]
type = ChangeState
trigger1 = Time = 0 && palno=2
value = 192

[State 190, イントロ分岐 - デンジの時]
type = ChangeState
trigger1 = Time = 0 && palno!=2
value = 191


;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;勝利ポーズ分岐（common1.cnsには無いけど、これもコモンステート）
[Statedef 180]
type = S

[State 180, 分岐 - ポチタ専用]
type = ChangeState
trigger1 = Time = 0 && matchover>0 && palno=2
value = 182

[State 180, 分岐]
type = ChangeState
trigger1 = Time = 0 
value = 181

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;勝利ポーズ1 デンジ/ポチタ共通
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, AssertSpecial-通常1]
Type = AssertSpecial
Trigger1 = Time < 180 && var(0)!=1
Trigger2 = Time < 230 && var(0)=1
Flag = RoundNotOver

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, カメラズーム]
Type = zoom
Trigger1 = FrontEdgebodyDist > 30 || BackEdgebodyDist > 30 
pos = 0,0
postype = p1
scale = 1.2
lag = 0.9
ignorehitpause=1

[State ,効果音]
type = PlaySnd
trigger1 = animelem=3 
value = 4,7

[State ,チェンソー効果音]
type = PlaySnd
trigger1 = animelem=3,-1
value = 1000,1

[State , 剣撃1]
Type = explod
trigger1 = animelem=3,-1
anim=10010
postype=p1
pos=4,0
scale=0.7,1.2
angle = 0
sprpriority = 2
ignorehitpause=0
facing=1
bindtime=99

[State , 剣撃1]
Type = explod
trigger1 = animelem=3,0
anim=10010
postype=p1
pos=-10,0
scale=0.7,1.1
angle = 0
sprpriority = 2
ignorehitpause=0
facing=-1
bindtime=99

[State 181, ボイス- 通常]
type = PlaySnd
trigger1 = animelem=1 && var(0)!=1 && palno!=2
value = 13,random%3
volumescale=211

[State 181, ボイス- ノーベル賞獲得]
type = PlaySnd
trigger1 = animelem=1 && var(0)=1 && palno!=2
value = 13,3
volumescale=211


