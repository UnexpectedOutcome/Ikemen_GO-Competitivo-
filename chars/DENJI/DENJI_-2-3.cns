;ガード関係
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State ,ガード効果音1]
type = PlaySnd
trigger1 = GetHitVar(Guarded)=1 && (stateno=[130,159]) && !time && random%1=0
value = 5001,0

[State , ガードエフェクト SA]
type = explod
triggerall = GetHitVar(Guarded)=1 && (stateno=[130,159]) && numexplod(10001)=0
trigger1 = statetype!=C
anim = 20010
ID=10001
postype=p1
pos=10,-70
scale=0.7,0.7
random=20,20
bindtime=9999
sprpriority=3

[State , ガードエフェクト C]
type = explod
triggerall = GetHitVar(Guarded)=1 && (stateno=[130,159]) && numexplod(10001)=0
trigger1 = statetype=C
anim = 20010
ID=10001
postype=p1
pos=10,-50
scale=0.7,0.7
random=20,20
bindtime=9999
sprpriority=3




