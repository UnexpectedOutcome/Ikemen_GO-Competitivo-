;他効果音関係
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State ,被弾ボイス]
type = PlaySnd
trigger1 = GetHitVar(damage)>0 && (stateno!=[130,159]) && !time && random%2=0 && alive
value = 5000,random%4
channel=0

[State , 効果音ストップ]
type = stopSnd
trigger1 = movetype=H
trigger2 = ctrl
channel=2

[State , 足音ストップ]
type = stopSnd
trigger1 = stateno!=20
channel=1



