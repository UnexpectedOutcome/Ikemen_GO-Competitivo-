[Statedef -2]
;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━




;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ワイド画面調整
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2, 演出横長]
type = varset
trigger1 = 1
fvar(0)=0.0
;0.5で横長
;0.0で通常





;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;攻撃で回復
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;通常攻撃の時
[State -2, テメエが俺に切られて血ィ流して！]
type = lifeadd
triggerall = numtarget>0 && movehit=1
trigger1 = stateno=[200,699] 
trigger1 = stateno!=240&&stateno!=400&&stateno!=610
value=1+random%7

;超必殺の時
[State -2, 俺がテメエの血飲んで回復ｩ！]
type = lifeadd
triggerall = numtarget>0 && movehit=1
trigger1 = stateno=1000
value=3+random%7

;光ん力/通常攻撃の時
[State -2, 永久機関が完成しちまったなぁ～！]
type = lifeadd
triggerall = numtarget>0 && movecontact=1 && var(0)>0
trigger1 = stateno=[200,699] 
trigger1 = stateno!=240&&stateno!=400&&stateno!=610
value=10+random%7

;光ん力/超必殺の時
[State -2, ノーベル賞は俺んもんだぜ～！]
type = lifeadd
triggerall = numtarget>0 && movecontact=1 && var(0)>0
trigger1 = stateno=1000
value=20+random%7




;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;光ん力状態での演出
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;----------------------見た目---------------------------------------
[State -2, 炎]
type = explod
trigger1 = var(0)>0 && numexplod(10050)=0
anim = 10050
ID=10050
postype=p1
pos=0,-15
ownpal=1
facing=ifelse(random%2=0,1,-1)
scale=1.8,1.8
bindtime=9999
supermovetime=999
sprpriority=-1
removetime=3+random%8

[State , デンジ発光]
type = PalFX
trigger1 = var(0)>0 && time%5=0
time = 3
add = 180,120,0
sinadd = 64,42,5,3
mul = 255,180,100

[State , 背景オレンジ]
type = bgpalfx
trigger1 = var(0)>0 
time = 1
mul = 155,80,50
ignorehitpause=1

[State , 必殺風背景]
type = Explod
trigger1 = numexplod(10700)=0 && (var(0)>0||(stateno=[1021,1022]))
anim = 10700
id=10700
pos = 0,0 
postype = B     
scale = 1.0+fvar(0),1.0
sprpriority = -1
ownpal = 1  
bindtime=999
supermovetime = 80
pausemovetime = 80

;---------------------- ステータスとか ---------------------------------------
[State , 残り時間減少]
type = varadd
trigger1 = var(0)>0 && (stateno!=[700,720]) && roundstate=2
V=0
value=-1

[State , なんでもキャンセル]
type = ctrlset
triggerall = movecontact>0 && var(0)>0
trigger1 = stateno!=[1000,1010]
trigger1 = stateno!=[700,720]
value=1

[State -2, 火力アップ]
type = AttackMulSet
trigger1 = var(0)>0
value = 1.35

[State -2, hit時のゲージマシマシ]
type = poweradd
trigger1 = var(0)>0 && movecontact=1
value = random%80

[State -2, 体力減少]
type = lifeadd
trigger1 = roundstate=2 && var(0)>0 && stateno!=1020
value=ifelse(life>lifemax/2,-5,-3)
kill=0;ifelse((stateno=[1021,1022]),0,1)


;---------------------- hiteffect ---------------------------------------
[State , 緑血しぶき]
Type = explod
trigger1 = movecontact=1 && random%3=0 && var(0)>0
anim=10032
postype=p2
pos=0,-50
scale=1.3,1.3
angle=random*random
sprpriority=2
ownpal=1

[State , 画面緑血しぶき]
Type = explod
trigger1 = random%3=0 && numexplod(10031)=1 && numexplod(10033)=0 && var(0)>0
anim=10033
id=10033
postype=R
pos=0,0
scale=1.0+fvar(0),1.0
ownpal=1
ontop=1
facing=-1
sprpriority=4

;---------------------- finishへ飛ぶ ---------------------------------------
[State , 光ん力finishへ飛ぶ]
type = ChangeState
trigger1 = var(0)=1 && roundstate=2 && alive && (stateno!=[700,720]) && movetype!=H
value = 1021

[State , 伸びるチェーン消去]
Type = removeexplod
trigger1 = stateno!=[1021,1022]
id=10000
[State , 伸びるチェーン消去]
Type = removeexplod
trigger1 = stateno!=[1021,1022]
id=10001



