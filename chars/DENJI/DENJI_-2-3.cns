[State -2, ハイジャンプ加速]
type = veladd
triggerAll = prevstateno=420 
trigger1 = stateno = 40
x = 2.0
y = -5.0	

[State -2, ハイジャンプ成功時効果音] 
type = PlaySnd
triggerAll = prevstateno=420 
trigger1 = stateno = 40
value = 3,2
volumescale=140

[State -2, ハイジャンプ色変化]
type = palfx
triggerAll = prevstateno=420 
trigger1 = stateno = 40 
time = 8
add = 100,100,100
mul = 255,120,120	

[State -2, ハイジャンプ残像追加]
type = AfterImage
triggerAll = prevstateno=420 
trigger1 = stateno = 40
time = 30
Length = 10
timeGap = 4
FrameGap = 1
Palcolor = 200
PalContrast = 235,100,100
PalBright = 50,50,50
Trans = Add1



;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;アーマー
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[state -2,アーマー用ヘルパー]
type = Helper
triggerall = numhelper(10015)<=0 && var(0)>0
trigger1 = stateno !=[120,159]
trigger1 = MoveType !=H 
id = 10015
name = "armor"
sprpriority = -1
pos = 0,0
postype = p1
stateno = 10015
helpertype = normal
pausemovetime = 0
bindtime = -1
keyctrl = 0
ownpal = 1

[state -2,アーマー]
type = nothitby
triggerall = numhelper(10015)>=1
trigger1 = stateno !=[120,159]
value = ,AA,AP

[state -2,アーマー]
type = lifeadd
triggerall = numhelper(10015)>=1
triggerall = var(55)
trigger1 = stateno !=[120,159]
trigger1 = stateno !=[5000,5199]
value = -(Ceil(var(55)*0.8))
ignorehitpause = 1

[state -2,アーマー]
type = varset
trigger1 = var(55)
var(55) = 0
ignorehitpause = 1

[State -2, アーマー中ガード使用不可]
type = AssertSpecial
Trigger1 = var(0)>0
flag  = NoStandGuard 
flag2 = NoCrouchGuard
flag3 = NoAirGuard
　






