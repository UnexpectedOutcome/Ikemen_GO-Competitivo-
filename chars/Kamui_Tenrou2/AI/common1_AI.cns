triggerall = var(59)>0 && roundstate = 2
triggerall = statetype != A
triggerall = enemy,movetype = A
triggerall = time = 0
trigger1 = p2statetype = C && random < 250
trigger2 = random < 250 && var(59)
trigger3 = enemy,statetype = S || enemy,statetype = C
statetype = C
physics = C

[State 120, Lo to Hi];AI
type = StateTypeSet
triggerall = statetype = C
triggerall = var(59)>0 && roundstate = 2
triggerall = statetype != A
triggerall = enemy,movetype = A
triggerall = time = 0
trigger1 = p2statetype != C && random < 250
trigger2 = random < 250 && var(59)
trigger3 = enemy,statetype = S || enemy,statetype = A
statetype = S
physics = S

[State 120, 5]
