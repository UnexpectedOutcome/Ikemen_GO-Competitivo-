;------------------------------------------------------------------------------
;-| ボタンリマップ（ボタンコンフィグ）|----------------------------------------

[Remap]
x = x      ;パンチ
y = y      ;弱斬
z = z      ;溜め
a = a      ;キック
b = b      ;強斬
c = c      ;特殊
s = s      ;挑発

;------------------------------------------------------------------------------
;-| デフォルト設定 |-----------------------------------------------------------

[Defaults]
command.time = 15
command.buffer.time = 1

;==============================================================================
; コマンド定義パート（入力キーを設定する）
;==============================================================================

;------------------------------------------------------------------------------
;-| 超必殺技 |-----------------------------------------------------------------

[Command];天狼斬
name = "632146_c"
command = ~F, DF, D, DB, B, F, c
buffer.time = 6
time = 30

[Command];天狼斬(簡易)
name = "632146_c"
command = ~F, D, B, F, c
buffer.time = 6
time = 30

[Command];天裂斬
name = "214_xc"
command = ~D, DB, B, x+c
buffer.time = 5
time = 15

[Command];天空斬
name = "623_yc"
command = ~F, D, DF, y+c
time = 15

[Command];天月斬
name = "236_xc"
command = ~D, DF, F, x+c
time = 15

;------------------------------------------------------------------------------
;-| 必殺技 |-------------------------------------------------------------------

[Command];天舞斬 弱
name = "623_x"
command = ~F, D, DF, x
time = 15

[Command];天舞斬 強
name = "623_y"
command = ~F, D, DF, y
time = 15

[Command];天流斬 弱
name = "214_x"
command = ~D, DB, B, x
time = 15

[Command];天流斬 強
name = "214_y"
command = ~D, DB, B, y
time = 15

[Command];受け流し
name = "214_a"
command = ~D, DB, B, a
time = 15

[Command];天衝斬 弱
name = "236_x"
command = ~D, DF, F, x
time = 15

[Command];天衝斬 強
name = "236_y"
command = ~D, DF, F, y
time = 15

[Command];天覇脚
name = "22_a"
command = ~D, D, a
time = 15

[Command];天動脚
name = "22_b"
command = ~D, D, b
time = 15

[Command];Bカウンター
name = "BC"
command = /F, x+c
time = 15

[Command]
name = "BC"
command = /F, y+c
time = 15

[Command]
name = "BC"
command = /F, a+c
time = 15

[Command];
name = "BC"
command = /F, b+c
time = 15

[Command];Bインパルス
name = "BI"
command = /D, c
time = 15

;------------------------------------------------------------------------------
;-| キー２回連続入力 |---------------------------------------------------------

[Command]
name = "FF"       ;必須コマンド名
command = F, F
;buffer.time = 5
time = 15

[Command]
name = "BB"       ;必須コマンド名
command = B, B
;buffer.time = 5
time = 15

;------------------------------------------------------------------------------
;-| 同時押し |-----------------------------------------------------------------

[Command]
name = "recovery" ;必須コマンド名
command = x
time = 1

[Command]
name = "recovery" ;必須コマンド名
command = a
time = 1

[Command]
name = "recovery" ;必須コマンド名
command = y
time = 1

[Command]
name = "recovery" ;必須コマンド名
command = b
time = 1

[Command];パンチ投げ
name = "x+c"
command = x+c
time = 15

[Command];キック投げ
name = "a+c"
command = a+c
time = 15

;------------------------------------------------------------------------------
;-| 方向キー＋ボタン |---------------------------------------------------------

[Command]
name = "down_a"
command = /$D,a
time = 1

[Command]
name = "down_b"
command = /$D,b
time = 1

