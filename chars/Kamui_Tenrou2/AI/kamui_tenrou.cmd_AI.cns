trigger10 = (stateno = 3222) && (animelemtime(5) >= 1)
trigger11 = (stateno = 3260) && (animelemtime(6) >= 0)
trigger12 = (stateno = [3261,3264]) && movecontact

;エアBダッシュ
[State -1, Bダッシュ];ゲージレベル１
type = ChangeState
value = 960
triggerall = var(59) = 0
triggerall = command = "c"
triggerall = power >= 1000
triggerall = statetype = A
triggerall = Pos Y <= -5
;trigger1 = ctrl
trigger1 = (stateno = [600,620]) && movecontact
trigger2 = ((stateno = 1300) || (stateno = 1305) || (stateno = 1320) || (stateno = 1325)) && movecontact
trigger3 = (stateno = [3200,3210]) && movecontact
trigger4 = (stateno = 1350 || stateno = 1370)


