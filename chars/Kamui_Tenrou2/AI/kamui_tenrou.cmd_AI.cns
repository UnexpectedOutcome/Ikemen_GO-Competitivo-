time = 1

;---------------------------

[Command];チャージ
name = "hold_z"
command = /z

[Command];ハイジャンプ
name = "highjump"
command = ~$D, $U
buffer.time = 6
time = 11

[Command]
name = "nohighjump"
command = ~12$D, $U
buffer.time = 6
time = 11

[Command]
name = "nohighjump"
command = /$D
buffer.time = 6
time = 12

