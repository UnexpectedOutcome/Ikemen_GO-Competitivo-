;Bダッシュ
[State -1, Bダッシュ];ゲージレベル１
type = ChangeState
value = 950
triggerall = var(59) = 0
triggerall = command = "c"
triggerall = command != "x+c"
triggerall = command != "a+c"
triggerall = power >= 1000
triggerall = statetype != A
;trigger1 = ctrl
trigger1 = ((stateno = [200,299]) || (stateno = [400,499])) && movecontact
