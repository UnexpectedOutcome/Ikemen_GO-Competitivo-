;------------------------------------------------------------------------

;==============================================================================
; ステートエントリーパート
;==============================================================================
;------------------------------------------------------------------------------

[Statedef -1] ;必須項目です、絶対に消さないで下さい。

;-----------------------------------

;AI--------------------------------------------------------------------------

;AI Command Check
[State -1, AI Command]
Type = VarSet
TriggerAll = Var(59)=0 && !isHelper
trigger1 = command = "AI_01" || command = "AI_02" || command = "AI_03" || command = "AI_04"
trigger2 = command = "AI_05" || command = "AI_06" || command = "AI_07" || command = "AI_08"
trigger3 = command = "AI_09" || command = "AI_10" || command = "AI_11" || command = "AI_12"
trigger4 = command = "AI_13" || command = "AI_14" || command = "AI_15" || command = "AI_16"
trigger5 = command = "AI_17" || command = "AI_18" || command = "AI_19" || command = "AI_20"
Trigger6 = Command = "AI_21" || Command = "AI_22" || Command = "AI_23" || Command = "AI_24"
Trigger7 = Command = "AI_24" || Command = "AI_26" || Command = "AI_27" || Command = "AI_28"
Trigger8 = Command = "AI_29" || Command = "AI_30" || Command = "AI_31" || Command = "AI_32"
Trigger9 = Command = "AI_33" || Command = "AI_34" || Command = "AI_35" || Command = "AI_36"
Trigger10 = Command = "AI_37" || Command = "AI_38" || Command = "AI_39" || Command = "AI_40"
Trigger11 = Command = "AI_41" || Command = "AI_42" || Command = "AI_43" || Command = "AI_44"
Trigger12 = Command = "AI_45" || Command = "AI_46" || Command = "AI_47" || Command = "AI_48"
Trigger13 = Command = "AI_49" || Command = "AI_00"
Trigger14 = 1;AI即起動スイッチ

V = 59
Value = 1
IgnoreHitPause = 1

;---------------------------------------------------------------------------

;==============================================================================
; 超必殺技(BPA･BBB)
;==============================================================================
;------------------------------------------------------------------------------

;天狼斬
[State -1, 天狼斬];ゲージレベル４
type = ChangeState
value = 4100
triggerall = var(59) = 0
triggerall = command = "632146_c"
triggerall = power >= 4000
triggerall = statetype != A
trigger1 = (stateno = 3250) && movehit
trigger2 = (stateno = [3260,3265]) && movehit

;天裂斬
[State -1, 天裂斬];ゲージレベル１
type = ChangeState
value = 3100
triggerall = var(59) = 0
triggerall = command = "214_xc"
triggerall = power >= 1000
triggerall = statetype != A
trigger1 = ctrl || stateno = 52 || (stateno = [100,101])
trigger2 = ((stateno = [200,299]) || (stateno = [400,499])) && movecontact
trigger3 = (stateno = [700,704]) && movecontact
trigger4 = ((stateno = 1305) && (animelemtime(4) >= 0 && animelemtime(4) <= 2)) && movecontact
trigger5 = ((stateno = 1310) && (anim != 1317))&&(animelemtime(2) >= 2)
trigger6 = (stateno = [1360,1396]) && movecontact
trigger7 = (stateno = 1400) && (animelemtime(6) >= 1 && animelemtime(9) <= 10)
trigger8 = (stateno = 1420) && movecontact
trigger9 = ((stateno = 1500) && animelemtime(6) >= 1) && movehit
trigger10 = (stateno = [950,951]) && time >= 3

; 天爆斬
[State -1, 天爆斬];ゲージレベル２
type = ChangeState
value = 3150
triggerall = var(59) = 0
triggerall = command = "214_xc"
triggerall = power >= 2000
triggerall = statetype != A
trigger1 = (stateno = 3100) && ((animelemtime(10) >= 2 && animelemtime(13) <= 3) && movehit)

;天空斬 月光
[State -1, 天空斬a];ゲージレベル１
type = ChangeState
value = 3220;3200
triggerall = var(59) = 0
triggerall = command = "623_yc"
triggerall = power >= 1000
triggerall = statetype != A
trigger1 = ctrl || stateno = 52 || (stateno = [100,101])
trigger2 = ((stateno = [200,299]) || (stateno = [400,499])) && movecontact
trigger3 = (stateno = [700,704]) && movecontact
trigger4 = ((stateno = 1305) && (animelemtime(4) >= 0 && animelemtime(4) <= 2)) && movecontact
trigger5 = ((stateno = 1310) && (anim != 1317))&&(animelemtime(2) >= 2)
trigger6 = (stateno = [1360,1396]) && movecontact
trigger7 = (stateno = 1400) && (animelemtime(6) >= 1 && animelemtime(9) <= 10)
trigger8 = (stateno = 1420) && movecontact
trigger9 = ((stateno = 1500) && animelemtime(6) >= 1) && movehit
trigger10 = (stateno = [950,951]) && time >= 3

;天空斬 空中
[State -1, 天空斬b];ゲージレベル１
