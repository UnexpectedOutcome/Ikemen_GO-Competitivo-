;---------------------------------------------------------------------------
;通常攻撃ヒットエフェクト

[Statedef 6005]
type = A
movetype = I
physics = N
velset = 0,0
sprpriority = 4
anim = 6005

[state -1, 縮小]
type = angledraw
trigger1 = 1
scale = 0.5,0.5

[state -1,]
type = velset;velmul
trigger1 = 1
x = 0.5
y = 0

[state a];エフェクト1
type = Helper
trigger1 = time <= 1
id = 60051
stateno = 60051
name = "effect1"
sprpriority = 2
pos = 0,0
postype = p1
helpertype = normal
pausemovetime = 0
keyctrl = 0 
ownpal = 1

[state a];エフェクト1
type = Helper
trigger1 = time <= 1
id = 60051
stateno = 60051
name = "effect1"
sprpriority = 2
pos = 0,0
postype = p1
helpertype = normal
pausemovetime = 0
keyctrl = 0 
ownpal = 1

[state 6005, 透過]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,256

[state 6005, 1]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999

[state 6005]
type = destroyself
trigger1 = animtime = 0
ignorehitpause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999

;---------------------------------------------------------------------------
;通常攻撃ヒットエフェクトヘルパー1 光の玉

[Statedef 60051]
type = A
movetype = I
physics = N
velset = 0,0
sprpriority = 3
anim = 60051

[state 60051,1]
type = varRandom
trigger1 = time = 0
v = 1
range = 0,10

[state 60051,2]
type = varadd
trigger1 = 1
v = 1
value = 1

[state 60051,3]
type = velset
trigger1 = time = 0
x = -10+(Random%200)/10
y = -10+(Random%200)/10

[state 60051,4]
type = VelMul
trigger1 = 1
x = 0.95
y = 0.95

[state 60051, 透過]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,256

[state 60051, 縮小]
type = angledraw
trigger1 = 1
scale = 1.0-var(1)*0.03,1.0-var(1)*0.03

[state 60051, 影を消す]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999

[state 60051]
type = destroyself
trigger1 = var(1) >= 20
ignorehitpause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999

