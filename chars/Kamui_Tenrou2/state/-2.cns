;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------

[Statedef -2]

[state -2, 影を消す] 
type = AssertSpecial
trigger1 = palno = [1,11]
trigger1 = 1
flag = NoShadow
ignorehitpause = 1

[state -2, 音を鳴らす];ランダムダメージボイス小
type = PlaySnd
triggerall = stateno = 5000 ||  stateno = 5010 || stateno = 5020
triggerall = time = 0
triggerall = alive = 1
trigger1 = GetHitVar(animtype) = 0
value = 5000,0+(random%3)
channel = 0
persistent = 0

[state -2, 音を鳴らす];ランダムダメージボイス中
type = PlaySnd
triggerall = stateno = 5000 ||  stateno = 5010 || stateno = 5020
triggerall = time = 0
triggerall = alive = 1
trigger1 = GetHitVar(animtype) = 1
value = 5010,0+(random%3)
channel = 0
persistent = 0

[state -2, 音を鳴らす];ランダムダメージボイス大
type = PlaySnd
triggerall = stateno = 5000 ||  stateno = 5010 || stateno = 5020
triggerall = time = 0
triggerall = alive = 1
trigger1 = GetHitVar(animtype) = 2
trigger2 = GetHitVar(animtype) = 3
trigger3 = GetHitVar(animtype) = 4
value = 5020,0+(random%3)
channel = 0
persistent = 0

[state -2, 音を鳴らす];気絶ボイス
type = playsnd
triggerall = alive = 1
triggerall = time = 1
trigger1 = stateno = 5300
trigger2 = anim = 5300
value = 5300,0+(random%5)
persistent = 0
channel = 0
ignorehitpause = 1

[state -2,生存フラグ]
type = varadd
trigger1 = !alive
v = 11
value = 1
ignorehitpause = 1

[state -2,生存フラグ]
type = varset
trigger1 = alive
v = 11
value = 0
ignorehitpause = 1

[State -2, 音を鳴らす];12P敗北ボイス
type = PlaySnd
triggerall = var(11) = 1
triggerall = !alive
trigger1 = palno = 12
value = 11, 22
persistent = 0
channel = 10
loop = 0

[State -2, 音を鳴らす];敗北ボイス 狼牙・扇奈専用
type = PlaySnd
triggerall = var(11) = 1
triggerall = !alive
triggerall = palno = [1,11]
trigger1 = Enemy,Name = "Rouga_Zanma" || Enemy,Name = "Rouga Zanma" || Enemy,Name = "Rouga"
trigger2 = Enemy,Name = "Senna_Kyoudou" || Enemy,Name = "Senna Kyoudou" ||Enemy,Name = "Senna"
value = 11, 15+random%2
persistent = 0
channel = 10
loop = 0

[State -2, 音を鳴らす];敗北ボイス 久那妓専用
type = PlaySnd
triggerall = var(11) = 1
triggerall = !alive
triggerall = palno = [1,11]
trigger1 = Enemy,Name = "Kunagi_Tenrou" || Enemy,Name = "Kunagi Tenrou" || Enemy,Name = "Kunagi" || Enemy,name = "tenrou_kunagi" || Enemy,name = "tenrou kunagi"
value = 11, 17+random%4
persistent = 0
channel = 10
loop = 0

[State -2, 音を鳴らす];敗北ボイス 邪悪なる混沌専用
type = PlaySnd
triggerall = var(11) = 1
triggerall = !alive
triggerall = palno = [1,11]
trigger1 = Enemy,Name = "kamui" && Enemy,AuthorName = "kagetsu yuki"
value = 11, 21
persistent = 0
channel = 10
loop = 0

[State -2, 音を鳴らす];その他敗北ボイス
type = PlaySnd
triggerall = var(11) = 1
triggerall = !alive
triggerall = palno = [1,11]
trigger1 = Enemy,Name != "Rouga_Zanma"
trigger1 = Enemy,Name != "Senna_Kyoudou"
trigger1 = Enemy,Name != "Kunagi_Tenrou"
trigger1 = Enemy,Name != "kamui"
value = 11, 10+random%4
persistent = 0
channel = 10
loop = 0

[state -2, 音を鳴らす];敗北ボイス 崩れ落ち用
type = PlaySnd
triggerall = var(11) = 1
trigger1 = prevstateno = 120 || prevstateno = 130 || prevstateno = 131 || (prevstateno = [150,153])
trigger1 = (stateno = [5000,5059])
trigger1 = var(10) = 0
trigger1 = !alive
value = 5950, 0+random%3
persistent = 0
channel = 10
loop = 0

[state -2, フラグリセット];二段ジャンプフラグのリセット
type = varset
trigger1 = statetype != A
ignorehitpause = 1
var(2) = 0

;崩れ落ちKO用変数
[State -2, 崩れ落ちKO]
type = varset
trigger1 = stateno = 120 || stateno = 130 || stateno = 131 || (stateno = [150,153])
v = 10
value = IfElse(statetype = A,1,0)

[state -2, 崩れ落ちKO] 
type = changestate
trigger1 = !alive
trigger1 = prevstateno = 120 || prevstateno = 130 || prevstateno = 131 || (prevstateno = [150,153])
trigger1 = (stateno = [5000,5059])
trigger1 = var(10) = 0
value = 5950

;-----------------------------------
;画面端ノックバック

[State -2, EnemyNear切り替え]
Type = VarSet
Trigger1 = NumEnemy = 1
Trigger2 = NumEnemy = 2
Trigger2 = EnemyNear,Life > 0
V = 4;1
Value = 0
IgnoreHitPause = 1

[State -2,EnemyNear切り替え]
Type = VarSet
Trigger1 = NumEnemy > 1
Trigger1 = EnemyNear,Life = 0
V = 4;1
Value = 1
IgnoreHitPause = 1

[State -2, ノックバックリセット]
Type = VarSet
Trigger1 = MoveContact = 1
FV = 1
Value = 0
IgnoreHitPause = 1

[State -2, ノックバックリセット]
Type = VarSet
Trigger1 = FVar(1) >= 0
Trigger2 = EnemyNear(Var(4)),StateNo != [154,155]
Trigger2 = EnemyNear(Var(4)),MoveType != H || EnemyNear(Var(4)),GetHitVar(HitTime) = 0
Trigger3 = (P2StateType = S && FVar(1) = [-1,0]) || (P2StateType = C && FVar(1) = [-1,0])
Trigger4 = EnemyNear(Var(4)),StateNo = [154,155]
Trigger4 = EnemyNear(Var(4)),Ctrl
Trigger5 = EnemyNear(Var(4)),StateNo = [5100,5119]
Trigger6 = EnemyNear(Var(4)),StateNo = [5200,5219]
FV = 1
Value = 0

[State -2, ノックバック実行] 
Type = PosAdd
TriggerAll = FVar(1) < 0
TriggerAll = EnemyNear(Var(4)),GetHitVar(HitShakeTime) <= 0
Trigger1= EnemyNear(Var(4)),BackEdgeBodyDist <= 0 || EnemyNear(Var(4)),FrontEdgeBodyDist <= 0
X = (FVar(1))

[State -2, ノックバック摩擦係数] 
Type = VarSet
Trigger1 = FVar(1) < 0
Trigger1 = EnemyNear(Var(4)),GetHitVar(HitShakeTime) <= 0
FV = 1
Value = FVar(1)*IfElse(P2StateType=A||P2StateType=L,0.9,IfElse(P2StateType=S,EnemyNear(Var(4)),Const(Movement.Stand.Friction),IfElse(P2StateType=C,EnemyNear(Var(4)),Const(Movement.Crouch.Friction),0.9)))

[State -2, ノックバックセット] 
Type = VarSet
Trigger1 = MoveContact = 1
FV = 1
Value = -EnemyNear(Var(4)),GetHitVar(XVel)*Facing
IgnoreHitPause = 1

