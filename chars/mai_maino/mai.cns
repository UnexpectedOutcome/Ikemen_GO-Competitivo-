; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State -1]
Type = ChangeState
TriggerAll = var(59)>0
Trigger1 = Time = 0
Value = 0
Ctrl = 1
IgnoreHitPause = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(0) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(0) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(0) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(0)=0, const(velocity.jump.neu.x), ifelse(sysvar(0)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 191, 3]
type = PlaySnd
trigger1 = Animtime = 0
value = 40,1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

