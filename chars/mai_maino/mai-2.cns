[statedef -2]
;---------------------------------------------------------------------------
;先行入力認識用ヘルパー暴走防止
;---------------------------------------------------------------------------
[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(99999)
value = 99999
ignorehitpause = 1
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; デバッグ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[State -2, デバッグ管理]
type = displayToClipboard
text = "mae=%d,combohosei=%f,mer=%d,y=%d,SW=%d\n"
params = var(44), fvar(1), var(44), floor(P2BodyDist Y) , var(9)
trigger1 = 1
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;補正セット・リセット
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

;fvar(0) = 補正総合値
;fVar(1) = 技数補正
;fvar(2) = 逆根性値
;fvar(3) = カウンターヒット補正

;-------------------------------------------------[技数補正]

[state -2, 補正用statenoバッファ]
type     = varset
trigger1 = movetype != A
trigger1 = !movehit
trigger1 = hitcount = 0
v = 15
value = 0
ignorehitpause = 1

[State -2, 技数カウント加算]
type     = varadd
trigger1 = hitcount = 1
trigger1 = movehit = 1
trigger1 = var(15) != 0
trigger1 = var(15) < 10000
trigger1 = var(15) := var(15)+10000
var(14) = 1
ignorehitpause = 1

[State -2, 技数カウント解除]
type     = Varset
trigger1 = !numtarget
trigger1 = P2MoveType != H || p2stateno = [120,155]
var(14) = 0
IgnoreHitPause = 1

[State -2, VarSet];初期値は100％（リセット）
Type     = VarSet
trigger1 = !numtarget
trigger1 = P2MoveType != H || p2stateno = [120,155]
trigger2 = var(14) <= 1
fvar(1)  = 1.0
IgnoreHitPause = 1

[State -2, Varset]
Type     = VarSet
triggerall = movetype != A || time = 1 || movetype = A && !movehit && hitcount = 0
trigger1 = var(14) > 0
fvar(1) = 1.0*(10-var(14))/10.0
ignorehitpause = 1

[State -2, VarSet];奥義中最小値は60％
Type     = VarSet
Triggerall = FVar(1) < 0.6
trigger1 = stateno = [3000,3100]
trigger2 = stateno = [2000,2900]
fvar(1)  = 0.6
IgnoreHitPause = 1

[State -2, VarSet];最小値は30％
Type     = VarSet
Trigger1 = FVar(1) < 0.3
fvar(1)  = 0.3
IgnoreHitPause = 1

;-------------------------------------------------[テンション補正]

[state -2, ノーマル]
type = varset
trigger1 = 1
fvar(2) = 1
ignorehitpause = 1

;-------------------------------------------------[カウンターヒット補正]

[State -2, カウンターヒット補正リセット]
type = varset
trigger1 = 1
fvar(3) = 1.0
ignorehitpause = 1

[State -2, カウンターヒット補正セット]
type = varset
trigger1 = var(7)
fvar(3) = 1.15
ignorehitpause = 1

;-------------------------------------------------[補正総合]

[State -2, 変数]
Type     = VarSet
Trigger1 = 1
fvar(0)  = fvar(1)*fvar(2)*fvar(3)
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; カウンターヒット判定
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[state -2, 変数] ;カウンター判定
type       = VarSet
trigger1   = 1
var(7)     = 0

[state -2, 変数] ;カウンター判定
type       = VarSet
TriggerAll = NumEnemy >= 1
trigger1   = Enemynear,Movetype  = A
var(7)     = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ガーキャン
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[state -2, リセット]
type = varset
trigger1 = stateno!=[150,155]
var(20) = 0
ignorehitpause = 1

[statedef -3]
;---------------------------------------------------------------------------
;先行入力認識用ヘルパー暴走防止
;---------------------------------------------------------------------------
[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(99999)
value = 99999
ignorehitpause = 1
;===========================================================================
;DHQ氏 先行入力
;===========================================================================
[state -3, 先行入力認識用ヘルパー]
type = helper
trigger1 = !numhelper(99999)
trigger1 = !ishelper
helpertype = normal
name = "commandhelper"
stateno = 99999
ID = 99999
postype = p1
pos = 0,9999
keyctrl = 1
pausemovetime = 2147483647
supermovetime = 2147483647
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;AI系処理
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -3, AIフラグセット]
type = VarSet
TriggerAll=!var(59)
triggerall = RoundState = [1,2]
triggerall=Movetype!=H
trigger1 = Command = "AI0"
trigger2 = Command = "AI1"
trigger3 = Command = "AI2"
trigger4 = Command = "AI3"
trigger5 = Command = "AI4"
trigger6 = Command = "AI5"
trigger7 = Command = "AI6"
