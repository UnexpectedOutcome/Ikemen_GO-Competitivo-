trigger47 = Command = "AI46"
trigger48 = Command = "AI47"
trigger49 = Command = "AI48"
trigger50 = Command = "AI49"
trigger51 = Command = "AI50"
Trigger52 = var(19)
var(59) = var(18)
Ignorehitpause=1

;==============================================================================
;設定
;==============================================================================
;画面端検出ヘルパー
[state -3, 画面右端検出用ヘルパー]
type  = helper
trigger1 = !NumHelper(20000)
helpertype = normal
name = "migihasi"
PosType = left 
stateno = 20000
ID = 20000
facing = -1
pos=160,9999
pausemovetime  = 2147483647
supermovetime  = 2147483647
persistent = 0
ignorehitpause = 1
keyctrl = 0
ownpal = 1

[State -3, 念のため↓も付けておく]
type=changestate
trigger1= ishelper
trigger1= ishelper(20000)
trigger1= stateno !=20000
value=21000

[state -3, 画面左端検出用ヘルパー]
type = helper
trigger1 = !NumHelper(25000)
helpertype = normal
name = "hidarihasi"
PosType = left
stateno = 25000
ID = 25000
facing = 1
pos=160,9999
pausemovetime  = 2147483647
supermovetime  = 2147483647
persistent = 0
ignorehitpause = 1
keyctrl = 0
ownpal = 1

[State -3, 念のため↓も付けておく]
type=changestate
trigger1= ishelper
trigger1= ishelper(25000)
trigger1= stateno !=25000
value=25000

[State a,ガードヘルパー]
Type = Helper ;
Trigger1 = var(59);
Trigger1 = !NumHelper(10000) ;射出制限
ID = 10000 ;ヘルパーのID
Pos = 0,-1000;
name="AI_support"
StateNo = 10000 ;
OwnPal = 1
Size.XScale = 0
Size.YScale = 0
SuperMoveTime = 999999999 ;SuperPause中に動ける時間
PauseMoveTime = 999999999 ;Pause中に動ける時間

[State -3]
Type=varset
;trigger1=var(59)
triggerall = !ishelper
Trigger1=numenemy=1
var(50)=enemynear(0),ID

[State -3]
Type=varset
;trigger1=var(59)
triggerall = !ishelper
Trigger1=numenemy=2
var(50)=ifelse(EnemyNear(0),alive,enemynear(0),ID,enemynear(1),ID)

[State -3,前方向画面端までの距離]
type = null;varset
triggerall = !ishelper
;triggerall = var(59)
Trigger1 = facing=1
Trigger1 = var(44):=floor((helper(20000),RootDist X))||1
Trigger2 = facing=-1
Trigger2 = var(44):=floor(helper(25000),RootDist X)||1

[State -3,後ろ方向画面端までの距離]
type = null;varset
triggerall = !ishelper
;triggerall = var(59)
Trigger1 = facing=-1
Trigger1 = var(45):=floor(helper(20000),RootDist X)||1
Trigger2 = facing=1
Trigger2 = var(45):=floor(helper(25000),RootDist X)||1

;AI用重力加速度計測
[state -3, yaccel]
type = varset
triggerall = !ishelper
trigger1 = fvar(20) != playerID(var(50)),const(movement.yaccel)
trigger1 = playerID(var(50)),stateno != [5000,5210]
trigger1 = playerID(var(50)),Vel Y != 0
FV = 20
value = playerID(var(50)),const(movement.yaccel)
ignorehitpause = 1

[state -3, yaccel]
type = varset
triggerall = !ishelper
trigger1 = fvar(20) != playerID(var(50)),GetHitVar(yaccel)
trigger1 = playerID(var(50)),stateno = [5000,5210]
trigger1 = playerID(var(50)),Vel Y != 0
FV = 20
value = playerID(var(50)),GetHitVar(yaccel);(打撃当てた時のyaccel値)
ignorehitpause = 1

[state -3, yaccel]
type = varset
triggerall = !ishelper
trigger1 = fvar(20) != 0
trigger1 = playerID(var(50)),Vel Y = 0
FV = 20
value = 0;(打撃当てた時のyaccel値)
ignorehitpause = 1

;AI用摩擦係数
[state -3, friction]
type = varset
trigger1 = playerID(var(50)),movetype=H
trigger1 = playerID(var(50)),statetype=S
FV = 23
value = playerID(var(50)),const(movement.stand.friction)
ignorehitpause = 1

[state -3, friction]
type = varset
trigger1 = playerID(var(50)),movetype=H
trigger1 = playerID(var(50)),statetype=C
FV = 23
value = playerID(var(50)),const(movement.crouch.friction)
ignorehitpause = 1

[state -3, friction reset]
type = varset
trigger1 = playerID(var(50)),movetype!=H
trigger2 = playerID(var(50)),statetype=A
FV = 23
value = 1
ignorehitpause = 1

;のけぞり
[state -3, move]
type = varset
trigger1 = numenemy
FV = 22
value = -playerID(var(50)),Vel X;-1*playerID(var(50)),facing*playerID(var(50)),GetHitVar(xvel)
ignorehitpause = 1


