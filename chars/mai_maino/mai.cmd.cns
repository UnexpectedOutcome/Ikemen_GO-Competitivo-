; 下の記述↓は絶対に消さないでください。
[Statedef -1]
;---------------------------------------------------------------------------
;先行入力認識用ヘルパー暴走防止
;---------------------------------------------------------------------------
[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(99999)
value = 99999
ignorehitpause = 1
;---------------------------------------------------------------------------
[state -1, Your mind is 舞(mine)]
type  = ChangeState
value = 3500
triggerall = !ishelper
triggerall = power>=3000
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
TriggerAll = command = "632146"|| helper(99999),var(0) > 0
TriggerAll = statetype != A
Trigger1   = Ctrl||stateno=52

;---------------------------------------------------------------------------
[state -1, マイムマイム]
type  = ChangeState
value = 3000
triggerall = !ishelper
triggerall = power>=2000
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
TriggerAll = command = "421" || helper(99999),var(1) > 0
TriggerAll = statetype != A
Trigger1   = Ctrl||stateno=52
trigger2   = (stateno=[200,240])&&movecontact=[1,3]
trigger3   = (stateno=[400,440])&&movecontact=[1,3]
trigger4   = ((stateno=[1000,1050])||(stateno=2000)) && var(8)=1

[state -1, EXトルネードファン]
type  = ChangeState
value = 2000
triggerall = !ishelper
triggerall = power>=1000
triggerall = alive
triggerall = roundstate = 2
