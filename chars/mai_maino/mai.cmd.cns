TriggerAll = command = "236Z"|| helper(99999),var(2) > 0
TriggerAll = statetype != A
Trigger1   = Ctrl||stateno = 52
trigger2   = (stateno=[200,240])&&movecontact=[1,3]
trigger3   = (stateno=[400,440])&&movecontact=[1,3]
trigger4   = (stateno=[1000,1050]) && var(8)=1

