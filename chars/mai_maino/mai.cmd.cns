;コンボ分岐
[State -3,EXトルネードファンから]
type = null;varset
triggerall = !ishelper
Triggerall = (var(59)=[3,6])||var(43)
Triggerall = !var(40)
Triggerall = stateno=2000
Triggerall = Numhelper(2000)
Triggerall = random<var(59)*200||var(43)
triggerall = Helper(2000),var(0)>0
triggerall = playerID(var(50)),movetype = H
triggerAll=(playerID(var(50)),StateNo != [120,159])
trigger1 = var(44)>130;端以外
trigger1 = var(40):=1||1
;端
trigger2 = var(44)<=130
trigger2 = power<1000;Noゲージ
trigger2 = var(40):=2||1
trigger3 = var(44)<=130
