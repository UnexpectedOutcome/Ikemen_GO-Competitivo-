trigger1 = Time = 0 && HitShakeOver = 0
value = 5030

[State anim]
type = ChangeAnim
trigger1 = HitShakeOver && Anim = 5030
trigger1 = SelfAnimExist(5035)
value = 5035

[State anim]
type = ChangeAnim
triggerall = HitShakeOver && Anim != 5050
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State vel]
type = HitVelSet
trigger1 = HitShakeOver
x = 1
y = 1
persistent = 0

[State vel]
type = VelAdd
trigger1 = HitShakeOver
y = GetHitVar(yaccel)

[State end] ;Recover near ground
type = SelfState
triggerall = HitShakeOver
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = Cond(Pos Y >= Const(movement.air.gethit.groundrecover.ground.threshold),5200,5210)

[State ch]
type = ChangeState
trigger1 = HitShakeOver && Vel Y > 0 && Pos Y >= 0 + (anim = 5050)*15
value = 1231

[Statedef 1231]
type = A
movetype = H
physics = N
velset = 0,0
sprpriority = 1

[State anim]
