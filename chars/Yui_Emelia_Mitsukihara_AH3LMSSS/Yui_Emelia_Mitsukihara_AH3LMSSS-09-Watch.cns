;ダメージ値 * アルカナ補正 * ヒットガード補正 * EF補正 * ゲージ差補正
; 　v9            色々          660 or 275　　 1.0or1.1　 1000/17000

[State -2];ヒットorガード時のゲージ増加　選択アルカナ　無し
type = PowerAdd
triggerall = RoundState = 2 && Alive
triggerall = var(11) = 0
triggerall = var(13) <= 0 && var(14) <= 0
triggerall = Power >= var(15)
trigger1 = var(0) = 1 || var(1) = 1
trigger1 = var(8) > 0
value = ceil(var(8) * 1.00 * Cond(var(0) = 1,0.660,0.275) * Cond(var(10) = 2 || var(10) = 4,1.1,1) * 0.0588)
ignorehitpause = 1

[State -2];ヒットorガード時のゲージ増加　選択アルカナ 護
type = PowerAdd
triggerall = RoundState = 2 && Alive
triggerall = var(11) = 2
triggerall = var(13) <= 0 && var(14) <= 0
triggerall = Power >= var(15)
trigger1 = var(0) = 1 || var(1) = 1
trigger1 = var(8) > 0
value = ceil(var(8) * 0.90 * Cond(var(0) = 1,0.660,0.275) * Cond(var(10) = 2 || var(10) = 4,1.1,1) * 0.0588)
ignorehitpause = 1

[State -2];ゲージの自動回復　選択アルカナ　無し
type = PowerAdd
triggerall = RoundState = 2 && Alive
triggerall = movetype != H && Statetype != L
triggerall = var(11) = 0
triggerall = var(13) <= 0 && var(14) <= 0
triggerall = Power < var(15)
trigger1 = 1
value = ceil(6.25 * 1.00 * Cond(Power >= floor(PowerMax * 2 /3),1.2,Cond(Power >= floor(PowerMax * 1 / 3),1.1,1.0)))
ignorehitpause = 1

[State -2];ゲージの自動回復　選択アルカナ　護
type = PowerAdd
triggerall = RoundState = 2 && Alive
triggerall = movetype != H && Statetype != L
triggerall = var(11) = 2
triggerall = var(13) <= 0 && var(14) <= 0
triggerall = Power < var(15)
trigger1 = 1
value = ceil(6.25 * 0.80 * Cond(Power >= floor(PowerMax * 2 /3),1.2,Cond(Power >= floor(PowerMax * 1 / 3),1.1,1.0)))
ignorehitpause = 1

[State -2];被ダメージ時のゲージ増加　選択アルカナ　無し
type = PowerAdd
triggerall = RoundState = 2 && Alive
triggerall = movetype = H
triggerall = var(11) = 0
triggerall = var(13) <= 0 && var(14) <= 0
trigger1 = GethitVar(Damage) > 0
value = ceil(GetHitVar(Damage) * 1.00 * Cond((StateNo = [120,155]),0.110,0.385))
ingorehitpause = 1

[State -2];被ダメージ時のゲージ増加　選択アルカナ　護
type = PowerAdd
triggerall = RoundState = 2 && Alive
triggerall = movetype = H
triggerall = var(11) = 2
triggerall = var(13) <= 0 && var(14) <= 0
trigger1 = GethitVar(Damage) > 0
value = ceil(GetHitVar(Damage) * 0.50 * Cond((StateNo = [120,155]),0.110,0.385))
ingorehitpause = 1

[State -2];防御補正　選択アルカナ　無し
type = DefenceMulSet
trigger1 = Life < LifeMax * 0.35
trigger1 = var(11) = 0
value = 1.0 - ((LifeMax * 0.35 - Life) / LifeMax) * 0.22
ignorehitpause = 1

[State -2];防御補正　選択アルカナ　護
type = DefenceMulSet
trigger1 = Life >= LifeMax * 0.35
trigger1 = var(11) = 2
value = 0.965
ignorehitpause = 1

[State -2];防御補正　選択アルカナ　蠅
type = DefenceMulSet
trigger1 = Life < LifeMax * 0.35
trigger1 = var(11) = 2
value = 1.0 - ((LifeMax * 0.35 - Life) / LifeMax) * 0.22 * 1.35
ignorehitpause = 1

[State -2];相殺エフェクト
type = Helper
triggerall = var(0) = 1
triggerall = NumTarget(99999)
trigger1 = EnemyNear(!(EnemyNear,Alive || NumEnemy = 1)),MoveReversed = 1 || Target(99999),MoveReversed = 1
helpertype = normal
name = "Effect"
pos = 40, -60
postype = p1
facing = 1
Stateno = 6030
pausemovetime = 999
supermovetime = 999
keyctrl = 0
ownpal = 1
ignorehitpause = 1

[State -2];通常ヒットエフェクト
