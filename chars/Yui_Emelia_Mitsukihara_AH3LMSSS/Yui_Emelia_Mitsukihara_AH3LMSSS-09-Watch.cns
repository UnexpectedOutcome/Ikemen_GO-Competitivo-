[State -2,各種フラグ]
Type = DisplayToClipboard
Trigger1 = 1
text = "target99999=%d,v18=%df,v19=%d,vv50=%d,v50=%d"
params = NumTarget(99999),var(18),var(19),Helper(id),var(50),var(50)
IgnoreHitPause = 1

[State -2,各種フラグ]
Type = DisplayToClipboard
Trigger1 = 0
text = "a=%d,yaccel=%f,vel y=%f,Pos Y=%f"
params = Const(movement.air.gethit.groundlevel),gethitvar(yaccel),vel y,Pos Y
IgnoreHitPause = 1

[State -2,各種フラグ]
Type = DisplayToClipboard
Trigger1 = 0
text = "v18=%d,fv1=%f,atk=%f,recovertime=%d,power=%d,fv38=%f"
