facing = 1
Stateno = Cond(var(9) = 2,6020,6000 + Cond(MoveHit || var(0),floor(var(4)/10),15 + var(4)%10))
pausemovetime = 999
supermovetime = 999
keyctrl = 0
ownpal = Cond(StateNo = 2020 || MoveType != H,0,1)
ignorehitpause = 1

