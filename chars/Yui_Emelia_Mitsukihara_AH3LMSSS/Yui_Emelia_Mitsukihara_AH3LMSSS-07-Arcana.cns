[State end]
type = DestroySelf
triggerall = Root,Stateno != [3000,3999]
triggerall = Root,StateNo != [12500,12600]
trigger1 = Root,var(10) != 2 && Root,var(10) != 4

[Statedef 10100]
type = A
movetype = I
physics = N
sprpriority = 0
ctrl = 0
juggle  = 0
poweradd = 0
velset = 0,0

[State ass]
type = AssertSpecial
trigger1 = 1
flag = NoShadow

[State anim]
type = ChangeAnim
triggerall = Time = 0
trigger1 = IsHelper(1)
trigger1 = var(0) := 1 || 1
trigger2 = IsHelper(2)
trigger2 = var(0) := 2 || 1
trigger3 = IsHelper(3)
trigger3 = var(0) := 3 || 1
trigger4 = IsHelper(4)
trigger4 = var(0) := 4 || 1
trigger5 = IsHelper(5)
trigger5 = var(0) := 5 || 1
trigger6 = IsHelper(6)
trigger6 = var(0) := 6 || 1
trigger7 = IsHelper(7)
trigger7 = var(0) := 7 || 1
trigger8 = IsHelper(8)
trigger8 = var(0) := 8 || 1
trigger9 = IsHelper(9)
trigger9 = var(0) := 9 || 1
value = 10100 + var(0) + Root,var(11) * 10

[State var]
type = varset
trigger1 = time = 0
trigger1 = IsHelper(1) || IsHelper(2) || IsHelper(3)
fvar(1) = 1.5

[State var]
type = varadd
trigger1 = time < 5
trigger1 = IsHelper(1) || IsHelper(2) || IsHelper(3)
fvar(1) = -0.05

[State var]
type = varadd
trigger1 = time = [5,34]
trigger1 = IsHelper(1) || IsHelper(2) || IsHelper(3)
fvar(1) = -0.01

[State var]
type = varset
trigger1 = time > 34
trigger1 = IsHelper(1) || IsHelper(2) || IsHelper(3)
fvar(1) = fvar(1)*0.8

[State angle]
type = AngleDraw
trigger1 = IsHelper(1) || IsHelper(2) || IsHelper(3)
scale = fvar(1),fvar(1)

[State angle]
type = AngleDraw
triggerall = Time < 16
trigger1 = IsHelper(4) || IsHelper(5) || IsHelper(6)
scale = 0.02 + Time * 0.074875,0.02 + Time * 0.074875

[State angle]
type = AngleDraw
triggerall = Time >= 16
trigger1 = IsHelper(4) || IsHelper(5) || IsHelper(6)
scale = 1.2,1.2

[State angle]
type = AngleDraw
triggerall = Time < 16
trigger1 = IsHelper(7) || IsHelper(8) || IsHelper(9)
scale = 0.02 + Time * 0.030625,0.02 + Time * 0.030625

[State angle]
type = AngleDraw
triggerall = Time >= 16
trigger1 = IsHelper(7) || IsHelper(8) || IsHelper(9)
scale = 0.5,0.5

[State bind]
type = BindtoRoot
trigger1 = IsHelper(1) || IsHelper(2) || IsHelper(3)
pos = 0,-85

[State bind]
type = BindtoRoot
trigger1 = IsHelper(4) || IsHelper(5) || IsHelper(6)
pos = 0,0

[State bind]
type = BindtoRoot
trigger1 = IsHelper(7) || IsHelper(8) || IsHelper(9)
pos = 55,-100

[State spr];正面魔法陣は優先
type = SprPriority
trigger1 = IsHelper(7) || IsHelper(8) || IsHelper(9)
value = 4

[State trans]
type = Trans
trigger1 = time < 5
trigger1 = IsHelper(1) || IsHelper(2) || IsHelper(3)
trans = addalpha
alpha = 50 * Time,256

[State trans]
type = Trans
trigger1 = time >= 5
trigger1 = IsHelper(1) || IsHelper(2) || IsHelper(3)
trans = addalpha
alpha = 256,256

[State trans]
type = Trans
trigger1 = Time < 16
trigger1 = !(IsHelper(1) || IsHelper(2) || IsHelper(3))
trans = addalpha
alpha = Time * 16,256

[State trans]
type = Trans
trigger1 = Time >= 16
trigger1 = !(IsHelper(1) || IsHelper(2) || IsHelper(3))
trans = addalpha
alpha = 256,256

[State trans]
type = Trans
trigger1 = var(1) > 0
trigger1 = !(IsHelper(1) || IsHelper(2) || IsHelper(3))
trans = addalpha
alpha = 256 - var(1) * 16,256

[State var]
type = VarAdd
trigger1 = Abs(Root,AnimTime) <= 16
trigger1 = !(IsHelper(1) || IsHelper(2) || IsHelper(3))
var(1) = 1

[State var]
type = VarSet
trigger1 = Time = 0
var(2) = Root,StateNo

[State end]
type = DestroySelf
trigger1 = Root,StateNo != var(2)
trigger2 = var(1) > 16
trigger3 = Root,StateNo < 200

