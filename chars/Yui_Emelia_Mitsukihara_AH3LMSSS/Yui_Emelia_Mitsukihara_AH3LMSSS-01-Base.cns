


;基本データ部分
[Data]
life              = 1000    ;体力ゲージの最大値を決めます
power             = 3000    ;パワーゲージ最大値（デフォルトは 3000 = Lv.3 になります・オプション）
attack            = 100     ;攻撃力パーセンテージ（デフォルトは 100% になります）
defence           = 100     ;防御力パーセンテージ（デフォルトは 100% になります）
fall.defence_up   = 0       ;一時的に上昇するダウン時の防御力パーセンテージ
liedown.time      = 30      ;倒れてから起き上がるまでの時間
airjuggle         = 999     ;ジャグルポイント限界値
sparkno           = -1      ;デフォルトのヒットスパーク番号（fightfx.airか、キャラのairから呼び出す）
guard.sparkno     = -1      ;デフォルトのガードスパーク番号（fightfx.airか、キャラのairから呼び出す）
KO.echo           = 0       ;ＫＯ時の声にエコーを掛けるかどうか（0=しない・1=する）
volume            = 255     ;キャラの音量　255が最高
IntPersistIndex   = 0       ;Varを次のラウンドへ持ち越しが可能 (最小=0, 最大=59)
FloatPersistIndex = 0       ;FVarを次のラウンドへ持ち越しが可能 (最小=0, 最大=39)

;---------------------------------------------------------------------------
;サイズ設定
[Size]
xscale           = 0.5     ;キャラの横の大きさ（絶対値・float）
yscale           = 0.5     ;キャラの縦の大きさ（絶対値・float）
ground.back      = 15      ;地上にいる時の「後方の物理的な幅」
ground.front     = 15      ;地上にいる時の「前方の物理的な幅」
air.back         = 12      ;空中にいる時の「後方の物理的な幅」
air.front        = 12      ;空中にいる時の「前方の物理的な幅」
height           = 60      ;キャラの物理的な高さ（高いほど相手は飛び越しにくくなる）
attack.dist      = 100     ;相手がガード態勢に入る最低の距離
proj.attack.dist = 50      ;自分の「Projectile」に対して相手がガード態勢に入る最低の距離
proj.doscale     = 1       ;xscaleとyscaleを「Projectile」にも影響させるか否か（0=させない・1=させる）
head.pos         = 0,-100  ;キャラの標準の頭の座標（Bind系で適用される）
mid.pos          = 0,-68   ;キャラの標準の体中心の座標（Bind系で適用される）
shadowoffset     = 0       ;影のＹ軸方向の位置座標
draw.offset      = 0,0     ;キャラの表示座標（Ｘ軸,Ｙ軸）
;---------------------------------------------------------------------------
[Velocity]
walk.fwd     = 0.9         ;前進速度（Ｘ軸・[Statedef 20]に適用される）
walk.back    = -0.7        ;後退速度（Ｘ軸・[Statedef 20]に適用される）
run.fwd      = 6,2         ;前方に走る速度（Ｘ軸,Ｙ軸・[Statedef 100]に適用される）
run.back     = -6.2,-3.8   ;後方に走る速度（Ｘ軸,Ｙ軸・[Statedef 105]に適用される）
jump.neu     = 0,-11       ;垂直ジャンプの速度（Ｘ軸,Ｙ軸・[Statedef 40]に適用される）
jump.back    = -2.8        ;後方ジャンプの速度（Ｘ軸・[Statedef 40]に適用される）
jump.fwd     = 3.2         ;前方ジャンプの速度（Ｘ軸・[Statedef 40]に適用される）
runjump.back = -3.1,-11    ;後方に走ってからのジャンプ速度（Ｘ軸,Ｙ軸・[Statedef 40]に適用される）
runjump.fwd  = 3.3,-11     ;前方に走ってからのジャンプ速度（Ｘ軸,Ｙ軸・[Statedef 40]に適用される）
airjump.neu  = 0,-11       ;空中垂直ジャンプ速度（Ｘ軸,Ｙ軸・[Statedef 45]に適用される）
airjump.back = -3.5        ;空中後方ジャンプ速度（Ｘ軸・[Statedef 45]に適用される）
airjump.fwd  = 3.5         ;空中前方ジャンプ速度（Ｘ軸・[Statedef 45]に適用される）
;---------------------------------------------------------------------------
[Movement]
airjump.num     = 1        ;空中ジャンプの回数
airjump.height  = 35       ;空中ジャンプに必要な最低限の高さ
yaccel          = .45      ;垂直方向にかかる加速度（重力）
stand.friction  = .85      ;立ち状態の摩擦係数
crouch.friction = .82      ;屈み状態の摩擦係数
down.bounce.offset = 0,0   ;地面でバウンドする瞬間、この位置に補正される
air.gethit.groundlevel = 0 ;この数値以上床下に落ちると、地面にぶつかる
down.bounce.groundlevel = 0;バウンド後、Y座標がこの値でダウンモーションに入る

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
;triggerall = var(10) != 2 && var(10) != 4
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 1]
type = null;ChangeAnim
triggerall = var(10) = 2 || var(10) = 4
trigger1 = Anim != 2 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 2

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

;---------------------------------------------------------------------------
;Walk AI
[Statedef 21]
type    = S
physics = S
sprpriority = 0
ctrl = 0
anim = 20

[State 20, 1]
type = VelSet
trigger1 = Anim = 20
x = const(velocity.walk.fwd.x)

[State 100, 2]
type = ChangeState
trigger1 = p2dist x <= 0 || RoundState != 2 || Inguarddist
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
ctrl = 0
sprpriority = 1

[State turn]
type = Turn
trigger1 = Time = 0 && PrevStateNo != 120 && p2dist x < 0

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 1

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 2

[State Protection]
type = NotHitBy
trigger1 = AnimTime < 0
value = ,NT,ST
time = 1

[State var]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State var]
type = VarSet
triggerall = Time = 0 && PrevStateNo != 120
trigger1 = Command = "holdfwd" || Command = "holdback"
trigger2 = Helper(id),var(10) = 41 || Helper(id),var(10) = 42
trigger3 = Command = "HighJumpF" || Command = "HighJumpB"
sysvar(1) = Cond(Command = "holdfwd" || Helper(id),var(10) = 41 || Command = "HighJumpF",1,-1)

[State Anim]
type = ChangeAnim
trigger1 = Time = 0 && (Anim != [39,40])
value = Cond(Command = "HighJumpF" || Command = "HighJumpB" || Command = "HighJumpN" || (Helper(id),var(10) = [40,42]),39,40)

[State ch]
type = ChangeState
trigger1 = Command = "HighJumpB" || Helper(id),var(10) = 42
value = 120
ctrl = 0
anim = 39

[State helper]
type = Helper
trigger1 = Anim = 39 && AnimTime = 0
helpertype = normal
name = "jumpeffect"
ID = 39
pos = 0, 0
postype = p1
facing = 1
StateNo = 6300
keyctrl = 0
ownpal = 0

[State snd]
type = PlaySnd
trigger1 = animtime = 0
value = s5,40

[State vel]
type = VelSet
trigger1 = AnimTime = 0 && SysVar(1) = 0
x = Const(velocity.jump.neu.x)
y = Const(movement.yaccel) * Cond(Anim = 39,-52,-44) * 0.5

[State vel]
type = VelSet
trigger1 = AnimTime = 0 && SysVar(1) != 0
x = Cond(SysVar(1) = 1,Const(velocity.jump.fwd.x),Const(velocity.jump.back.x))
y = Const(movement.yaccel) * Cond(Anim = 39,-48,-44) * 0.5

[State ch]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = U

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 1

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 2

[State ch]
type = ChangeState
trigger1 = Time = 0 && var(2) != 0
value = 51

[State set]
type = StateTypeSet
trigger1 = Time = 0
physics = N

[State vel]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State null]
type = Null
triggerall = Time = 0
trigger1 = Helper(id),var(10) < 20
trigger1 = Helper(id),Cond(1,var(10) := 0,1) || 1 
trigger1 = Helper(id),Cond(1,var(11) := 0,1) || 1 

[State var]
type = VarSet
trigger1 = Time = 0
var(2) = 1

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = Command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = Command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VarSet
trigger1 = var(59) > 0
sysvar(1) = 1

[State 45, 7]
type = VelSet
trigger1 = Time = 0
x = Cond(SysVar(1) = 0,Const(velocity.airjump.neu.x), Cond(SysVar(1) = 1,Const(velocity.airjump.fwd.x), Const(velocity.airjump.back.x)))
y = Const(movement.yaccel) * Cond(SysVar(1) = 0,-34,-30) * 0.5

[State 45, 8]
type = PlaySnd
trigger1 = Time = 0
value = s5,41

[State 45, 9]
type = ChangeState
trigger1 = Time = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A
ctrl = 1

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 1

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 2

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = Cond(Anim = 39,100,0)

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

[State turn]
type = Turn
trigger1 = PrevStateNo = 40 && p2dist x < 0 && sysvar(1) = 100
persistent = 0

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = C
physics = C
ctrl = 0
anim = 47

[State null]
type = Null
triggerall = Time = 0
trigger1 = Helper(id),Cond(1,var(10) := 0,1) || 1
trigger1 = Helper(id),Cond(1,var(11) := 0,1) || 1

[State snd]
type = PlaySnd
trigger1 = time = 0
value = s5,20

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 1

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 2

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
x = 0

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1

