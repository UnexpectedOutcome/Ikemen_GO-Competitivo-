;---------------------------------------------------------------------------
; イントロ

[Statedef 190]
type = A
ctrl = 0
physics  = N
anim = 190
velset = 0,0

[State 190, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,0

[State 190, ヘルパーを出す]
type = Helper
trigger1 = Time = 0
name = "sorami"
stateno = 10190
ID = 10190
pos = -100, -80

[State 190, ChangeState]
type = ChangeState
trigger1 = Time > 0
trigger1 = var(10) = 1
value = 0

[State 190, ふぁいとー]
type = PlaySnd
trigger1 = Time = 40
value = 7,0

;---------------------------------------------------------------------------
; ヘルパー

[Statedef 10190]
type = A
physics = N
ctrl = 0
anim = 10190
velset = 5,0

[State 10190, 速度加算] ;重力
type = VelAdd
trigger1 = 1
y = .5

[State 10190, ChangeState]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 10191

;---------------------------------------------------------------------------
; ヘルパー

[Statedef 10191]
type = S
physics = S
ctrl = 0
anim = 10191
velset = 0,0

[State 10191, 基準に位置を固定]
type = BindToRoot
trigger1 = 1
time = 1
facing = 1
pos = ceil(const(size.xscale)*0),ceil(const(size.yscale)*0)

[State 10191]
type = PosSet
trigger1 = Time = 0
y = 0

[State 10191, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 40, 0

[State 10191, スプライト表示1];煙
type = Explod
trigger1 = Time = 0
anim = 7020
postype = p1
pos = 20, 0
vel = 0.5, -0.5
scale = 1,1
removetime = -2
sprpriority = 4
removeongethit = 0
ownpal = 1

[State 10191, スプライト表示1];煙
type = Explod
trigger1 = Time = 0
anim = 7020
postype = p1
pos = -10, 0
vel = -0.5, -0.5
scale = 1,1
removetime = -2
sprpriority = 4
removeongethit = 0
ownpal = 1

[State 10190, Parentvarset]
type = Parentvarset
trigger1 = Time = 69
var(10) = 1

[State 10191, 消滅]
type = DestroySelf
trigger1 = AnimTime = 0
trigger2 = Parent,stateno != 190

