; ‰º‚Ì‹Lq«‚Íâ‘Î‚ÉÁ‚³‚È‚¢‚Å‚­‚¾‚³‚¢B
[Statedef -1]
;===========================================================================


[State -1,fuuka]
type = ChangeState
value = 3000
triggerall = Command = "fuuka"
triggerall = power >= 1000
trigger1 = statetype = S
trigger1 = ctrl

[State -1,hana-arasi]
type = ChangeState
value = 3100
triggerall = Command = "hana-arasi"
triggerall = power >= 1000
trigger1 = statetype = S
trigger1 = ctrl



[State -1,rasaijin]
type = ChangeState
value = 1000
triggerall = Command = "rasaijin_x"
trigger1 = statetype = S
trigger1 = Ctrl = 1 
trigger2 = MoveContact && StateNo = [200,599]


[State -1,rasaijin]
type = ChangeState
value = 1010
triggerall = Command = "rasaijin_y"
trigger1 = statetype = S
trigger1 = Ctrl = 1 
trigger2 = MoveContact && StateNo = [200,599]


[State -1,rasaijin]
type = ChangeState
value = 1020
triggerall = Command = "rasaijin_z"
trigger1 = statetype = S
trigger1 = Ctrl = 1 
trigger2 = MoveContact && StateNo = [200,599]


[State -1,rasaijin]
type = ChangeState
value = 1100
triggerall = Command = "senpuu_x"
trigger1 = statetype = S
trigger1 = Ctrl = 1 
trigger2 = MoveContact && StateNo = [200,599]


[State -1,rasaijin]
type = ChangeState
value = 1110
triggerall = Command = "senpuu_y"
trigger1 = statetype = S
trigger1 = Ctrl = 1 
trigger2 = MoveContact && StateNo = [200,599]


[State -1,rasaijin]
type = ChangeState
value = 1120
triggerall = Command = "senpuu_z"
trigger1 = statetype = S
trigger1 = Ctrl = 1 
trigger2 = MoveContact && StateNo = [200,599]


[State -1,rekku]
type = ChangeState
value = 1200
triggerall = Command = "rekku"
trigger1 = statetype = S
trigger1 = Ctrl = 1 
trigger1 = command = "holdfwd"
trigger1 = p2bodydist X < 3
trigger1 = (p2statetype = S) || (p2statetype = C)
trigger1 = p2movetype != H



