; Ragna the Bloodedge (C-Series)'s constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

;---------------------------------------------------------------------------
; CNS difficulty: medium
; Notes: Notice that the HitDefs in supers have "getpower = 0". This makes
;        sure Ragna the Bloodedge (C-Series) doesn't recharge his super guage as he hits.
;        Also, the attributes for the HitDefs is "HA" for "hyper attack",
;        ie. "attr = S, HA".
;        Notice how the first HitDef is reused twice by allowing it to
;        trigger on two animation elements.
;Carnage Scissors Initiate
[Statedef 3000]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
anim = 3000
poweradd = -1000
ctrl = 0
sprpriority = 2
FaceP2 = 1
[State 0,,Zooom-In]
type = Zoom
triggerall = var(3) = 1
trigger1 = time = 0
pos = pos x,0
scale = 1.2
lag = 0.95
time = 40
ignorehitpause = 1
[State 0,,Zooom-Out]
type = Null;Zoom
triggerall = var(3) = 1
trigger1 = AnimElem = 4
pos = pos x,0
scale = 0.8
lag = 0.95
time = 20
ignorehitpause = 1
[State 3000, Super A]
type = SuperPause
trigger1 = AnimElem = 4
pos = 25, -57
anim = 3033
sound = 20, 0
;Bubble Effect
[State 0, Explod]
