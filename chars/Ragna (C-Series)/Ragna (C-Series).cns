;----------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;----------------------------------------------------------------------------
[statedef -2]
;xcostume
[state -2, No Clones (CT)]
type = remappal
triggerall = var(20) = 1
triggerall=numenemy && (fvar(36)=[1,12]);fvar(36)=the number of pals available 
trigger1=fvar(37)&&!numhelper(12345)&&matchno=1&&roundno=1
trigger1=enemy,authorname="Gamerstrike"&&enemy,name="Ragna the Bloodedge (C-Series)"&&enemy,fvar(36)=fvar(36)
source = 1, 1
dest = 1, Ifelse(teamside!=1 && enemynear,Numhelper(12345)=0,enemy,fvar(36)+teamside,fvar(36))
ignorehitpause = 1
[state -2, No Clones (CS)]
type = remappal
triggerall = var(20) = 2
triggerall=numenemy && (fvar(36)=[1,12]);fvar(36)=the number of pals available 
trigger1=fvar(37)&&!numhelper(12345)&&matchno=1&&roundno=1
trigger1=enemy,authorname="Gamerstrike"&&enemy,name="Ragna the Bloodedge (C-Series)"&&enemy,fvar(36)=fvar(36)
source = 1, 1
dest = 2, Ifelse(teamside!=1 && enemynear,Numhelper(12345)=0,enemy,fvar(36)+teamside,fvar(36))
ignorehitpause = 1
[state -2, No Clones (CP)]
type = remappal
triggerall = var(20) = 3
triggerall=numenemy && (fvar(36)=[1,12]);fvar(36)=the number of pals available 
trigger1=fvar(37)&&!numhelper(12345)&&matchno=1&&roundno=1
trigger1=enemy,authorname="Gamerstrike"&&enemy,name="Ragna the Bloodedge (C-Series)"&&enemy,fvar(36)=fvar(36)
source = 1, 1
dest = 3, Ifelse(teamside!=1 && enemynear,Numhelper(12345)=0,enemy,fvar(36)+teamside,fvar(36))
ignorehitpause = 1
[state -2, No Clones (CF)]
type = remappal
triggerall = var(20) = 4
triggerall=numenemy && (fvar(36)=[1,12]);fvar(36)=the number of pals available 
trigger1=fvar(37)&&!numhelper(12345)&&matchno=1&&roundno=1
trigger1=enemy,authorname="Gamerstrike"&&enemy,name="Ragna the Bloodedge (C-Series)"&&enemy,fvar(36)=fvar(36)
source = 1, 1
dest = 4, Ifelse(teamside!=1 && enemynear,Numhelper(12345)=0,enemy,fvar(36)+teamside,fvar(36))
ignorehitpause = 1
[state -2, No Clones (TAG)]
type = remappal
triggerall = var(20) = 5
triggerall=numenemy && (fvar(36)=[1,12]);fvar(36)=the number of pals available 
trigger1=fvar(37)&&!numhelper(12345)&&matchno=1&&roundno=1
trigger1=enemy,authorname="Gamerstrike"&&enemy,name="Ragna the Bloodedge (C-Series)"&&enemy,fvar(36)=fvar(36)
source = 1, 1
dest = 5, Ifelse(teamside!=1 && enemynear,Numhelper(12345)=0,enemy,fvar(36)+teamside,fvar(36))
ignorehitpause = 1

[state -2, Palette]
type = varset
trigger1 = numhelper(12345)
trigger1=helper(12345),fvar(36)=[1,12]
fvar(36)= helper(12345),fvar(36)
ignorehitpause = 1

[state -2, Palette Selection]
type = remappal
trigger1 = numhelper(12345)
trigger1=helper(12345),fvar(36)=[1,12]
source = 1, 1
dest = (ifelse(var(23),var(20),var(22))), fvar(36)
ignorehitpause = 1

[state -2, Continue Palette]
type = remappal
trigger1=fvar(37)&&matchno>1
;trigger2=fvar(37)&&!AILevel&&Roundno>0
source = 1, 1
dest = (ifelse(var(23),var(20),var(22))), fvar(36)
;dest = var(22), fvar(36)
ignorehitpause = 1

[state -2, Palette Selection]
type = remappal
trigger1 = fvar(37)=0
source = 1, 1
dest = (ifelse(var(23),var(20),var(22))), palno
ignorehitpause = 1

;Jump Cancel
[State -2, Jump Limit Reset];
type= varset
trigger1= statetype!=A
var(5)= 0
ignorehitpause= 1

[State 0, Helper]
type = Helper
triggerall = Numhelper(3971) = 0 && Numhelper(3972) = 0
;trigger1 = var(20) < 3
trigger1 = Var(10) = 0 ;Not Transformed
;trigger2 = stateno != 3051
;trigger2 = var(8) != 0 ;Astral Heat Song
name = "BGM (Blood Kain)"
ID = 3971
stateno = 3971
pos = 0,0
postype = P1    ;P2, Front, Back, Left, Right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 99999999999999999
pausemovetime = 99999999999999999

;NO BGM
[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = var(15) = 3 ;Astral Heat
flag = NoKOSnd
flag2 = NoKOSlow
ignorehitpause = 1
;----------------------------------------------------------------------
[State 0, DisplayToClipboard (Blood Kain)]
type = DisplayToClipboard
trigger1 = 1
text = "var(10) = %d  vel x = %f"
params = var(10),vel x

[State -2, DisplayToClipboard (Position)]
type = Null;DisplayToClipboard
trigger1 = 1
text = "p2Dist x=%d | p2Dist Y=%d"
params = p2bodydist x, p2bodyDist Y

[State 0, DisplayToClipboard (Game Mode)]
type = Null;DisplayToClipboard
trigger1 = 1
text = "var(21) = %d  vel x = %f"
params = var(21),vel x

