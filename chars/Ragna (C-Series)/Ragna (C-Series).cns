; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 2] ;Go straight to intro.
type = ChangeState
triggerall = roundno = 1
triggerall = enemy,name != "Unlimited Ragna the Bloodedge (C-Series)"
trigger1 = Time = 0
value = 191+random%2

[State 190, 2] ;Go straight to intro.
type = ChangeState
triggerall = roundno > 1
trigger1 = Time = 0
value = 193

[State 190, 2] ;Go straight to intro.
type = ChangeState
triggerall = enemy,name = "Unlimited Ragna the Bloodedge (C-Series)"
trigger1 = Time = 0
value = 194
;---------------------------------------------------------------------------
; Introduction
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = var(7) = 0 && var(20) = 1 && anim = 191 && time >= 65
trigger2 = var(7) = 0 && var(20) = 2 && anim = 191 && time >= 123
trigger3 = var(7) = 0 && var(20) = 3 && anim = 191 && time >= 30
trigger4 = var(7) = 0 && var(20) = 4 && anim = 191 && time >= 45
trigger5 = var(7) = 0 && var(20) = 5 && anim = 191 && time >= 87
trigger6 = var(7) = 1 && anim = 191 && animtime >= 30
