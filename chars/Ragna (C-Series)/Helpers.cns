;Barrier (Standing)
[Statedef 940]
type = S
movetype = I
physics = S
ctrl = 0
anim = 156
;poweradd = -1000

[State 4000, Barrier]
type = Helper
triggerall = var(6) = 1 || Var(6) = 3
trigger1 = Numhelper(4000) = 0
trigger1 = animelem = 3
name = "Barrier"
ID = 4000
stateno = 4000
pos = 0,50
postype = P1    ;P2, Front, Back, Left, Right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 0
pausemovetime = 0
;size.xscale = 0.15
;size.yscale = 0.15

[State -2, Barrier Block]
type = hitoverride
triggerall = numhelper(4000) = 1
triggerall = var(6) = 1 || Var(6) = 3
trigger1 = 1
attr = SA, NA, SA, NP, SP, HA, HP
stateno = 940
slot = 0
time = 1
ignorehitpause = 1
[state 0]
type = playerpush
triggerall = numhelper(4000) = 1
triggerall = var(6) = 1 || Var(6) = 3
trigger1 = time >= 0
value = 1
[State 151, 1]
type = null;HitVelSet
trigger1 = Time = 0
x = 1

[State 151, 2]
type = VelSet
trigger1 = HitOver
;trigger2 = Time = GetHitVar(slidetime)
x = 0
[State 132, Stop Barrier]
type = ChangeState
;Trigger1 =! Command = "Barrier" && command = "holdback"
trigger1 = command != "hold_x" && command != "hold_y"
trigger2 = power = 0
;trigger2 = !inguarddist
value = 140

