;---------------------------------------------------------------------------
; Kung Fu Palm
; CNS difficulty: medium
; Description: This is like a standard attack, but with some differences.
;   There are two HitDefs in this attack. One is triggered when the
;   opponent is near (using a p2bodydist trigger), and the other
;   when the opponent is farther away. The main differences between
;   the near and far versions of the HitDefs is that the near version
;   has a "fall" parameter set to 1, causing the opponent to be knocked
;   down. Other minor differences are the damage, and the velocity to
;   give the opponent.
;   The line "attr = S, SA" line means this is a Standing, Special Attack.
;   It is important you have the attr parameter set correctly for all
;   you HitDefs.
;Belial Edge
[Statedef 10006]
type    = A
movetype= A
physics = N
juggle  = 1
poweradd= 0
velset = 0,0
anim = 1006
ctrl = 0
sprpriority = 2

[State 0, VelAdd]
type = Veladd
trigger1 = animelem = 3
y = -3
;ignorehitpause = 
;persistent = 

[State 0, VelSet]
type = Veladd
trigger1 = animelem = 5
x = 5
y = 12
;ignorehitpause = 
;persistent = 

[State 1000, 5] ;Opponent near
type = HitDef
trigger1 = AnimElem = 3
attr = S, SA
animtype  = Up
damage    = 90, 4
priority  = 5
guardflag = MA
pausetime = 10,10
sparkxy = -10,-60
hitsound   = 5,4
guardsound = 6,0
ground.type = High
ground.slidetime = 12
ground.hittime  = 17
ground.velocity = 0,-3.5
air.velocity = 0,-3
fall = 0

[State 1000, 5] ;Opponent near
type = HitDef
trigger1 = AnimElem = 6 || AnimElem = 7
attr = S, SA
animtype  = Hard
damage    = 90, 4
priority  = 5
guardflag = MA
pausetime = 4,2
sparkxy = -10,-60
hitsound   = 5,4
guardsound = 6,0
ground.type = Low
ground.slidetime = 12
ground.hittime  = 17
ground.velocity = -4,-3.5
air.velocity = -4,4.5
fall = 1

[State 1000, 7]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 10007
ctrl = 0

