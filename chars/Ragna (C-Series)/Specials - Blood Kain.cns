; KFM's constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

;---------------------------------------------------------------------------
; Kung Fu Palm
; CNS difficulty: medium
; Description: This is like a standard attack, but with some differences.
;   There are two HitDefs in this attack. One is triggered when the
;   opponent is near (using a p2bodydist trigger), and the other
;   when the opponent is farther away. The main differences between
;   the near and far versions of the HitDefs is that the near version
;   has a "fall" parameter set to 1, causing the opponent to be knocked
;   down. Other minor differences are the damage, and the velocity to
;   give the opponent.
;   The line "attr = S, SA" line means this is a Standing, Special Attack.
;   It is important you have the attr parameter set correctly for all
;   you HitDefs.
;Hell's Fang
[Statedef 10000]
type    = S
movetype= A
physics = N
juggle  = 1
poweradd= 0
velset = 0,0
anim = 1000
ctrl = 0
sprpriority = 2

;Dash Effect
[State 0, Explod]
type = Explod
trigger1 = animelem = 5
anim = 2000
pos = -20,-65
postype = P1  ;P2, Front, Back, Left, Right
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = .25,.25
ignorehitpause = 1
sprpriority = 1
;persistent = 

[State 0, Explod]
type = Explod
trigger1 = animelem = 5
anim = 20001
pos = -20,-65
postype = P1  ;P2, Front, Back, Left, Right
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = .25,.25
ignorehitpause = 1
sprpriority = 2
;persistent = 

;Fang Effect
[State 0, Explod]
type = Explod
trigger1 = animelem = 7
anim = 2001
pos = 70,-50
postype = P1  ;P2, Front, Back, Left, Right
facing = 1
vfacing = 1
bindtime = -1
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = .25,.25
ignorehitpause = 1
sprpriority = 1
ownpal = 0
;persistent = 

[State 0, Explod]
type = Explod
trigger1 = animelem = 7
anim = 20011
pos = 70,-50
postype = P1  ;P2, Front, Back, Left, Right
facing = 1
vfacing = 1
bindtime = -1
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = .25,.25
ignorehitpause = 1
sprpriority = 2
ownpal = 0
;persistent = 

[State 1000, 1]
type = PlaySnd
trigger1 = Time = 8
value = 0, 3

[State 0, VelSet]
type = VelSet
trigger1 = animelem = 6
x = 8
y = 0
;ignorehitpause = 
;persistent = 

[State 1000, 5] ;Opponent near
type = HitDef
trigger1 = AnimElem = 6
attr = S, SA
animtype  = Hard
damage    = 90, 4
priority  = 5
guardflag = MA
pausetime = 10,10
sparkxy = -10,-60
hitsound   = 5,4
guardsound = 6,0
ground.type = Low
ground.slidetime = 12
ground.hittime  = 35
ground.velocity = -4,0
air.velocity = -4,-3
;fall = 1

[State 1000, 6]
type = ChangeState
trigger1 = animelem = 10
value = 10001
ctrl = 0

[State 1000, 7]
type = ChangeState
trigger1 = movecontact && command = "QCB_a"
value = 10002
ctrl = 0
;------------------
;Hell's Fang End
[Statedef 10001]
type    = S
physics = S
ctrl = 0
;velset = 0,0
anim = 1001

[State 0, VelSet]
type = VelSet
trigger1 = animelem = 9
x = 0
y = 0
;ignorehitpause = 
;persistent = 

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 1000, 7]
type = ChangeState
trigger1 = animelemtime(10) && command = "QCB_a"
;trigger1 = command = "QCB_a"
value = 10002
ctrl = 0

[State 1025, State]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl=1

;---------------------------------------------------------------------------
; Strong Kung Fu Palm
; CNS difficulty: medium
;Hell's Fang Follow Up
[Statedef 10002]
type    = S
movetype= A
physics = S
juggle  = 1
poweradd= 0
velset = 0,0
anim = 1002
ctrl = 0
sprpriority = 2

;Fang Effect
[State 0, Explod]
type = Explod
trigger1 = animelem = 5
anim = 2003
pos = 0,0
postype = P1  ;P2, Front, Back, Left, Right
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = .25,.25
ignorehitpause = 1
sprpriority = 3

[State 1010, 1]
type = PlaySnd
trigger1 = Time = 9
value = 0, 3

[State 1010, 7] ;Opponent not near
type = HitDef
trigger1 = AnimElem = 10
attr = S, SA
animtype  = Diagup
damage    = 85, 4
priority  = 4
hitflag = MAFD
guardflag = MA
pausetime = 15,7
sparkxy = -10,-60
hitsound   = 5,4
guardsound = 6,0
ground.type = high
ground.slidetime = 12
ground.hittime  = 17
ground.velocity = -6,-8
air.velocity = -6,-7
fall = 1
p2stateno = 6014

;Wall Bounce
[State 1010, 7]
type = Null;targetstate
triggerall = movehit
trigger1 = time > 1
trigger1 = BackEdgeBodyDist <= 6
trigger2 = time > 1
trigger2 = frontEdgeBodyDist <= 6
value = 6015
ignorehitpause = 1

[State 1010, 8]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

