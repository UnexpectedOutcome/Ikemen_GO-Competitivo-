;===========================================================================
; AI
;===========================================================================
[State -3, Air Jump]
type = ChangeState
value = 45
triggerall = !ishelper
triggerall = !AiLevel > 0
;triggerall = command = "holdup"
triggerall = statetype = A
triggerall = var(5) = 0
triggerall = AiLevel > 0 ;Ai On
trigger1 = vel y > 0
trigger2 = (stateno = 600) || (stateno = 610) || (stateno = 620) || (stateno = 630) || (stateno = 235) && movecontact
trigger2 = movecontact
;--------------------------------------------------------------------------
;Air Dash
[State -3, Air Dash]
type = ChangeState
value = 60
;triggerall = command = "FF"
triggerall = stateno != [60,61]
triggerall = stateno != 45
triggerall = !var(5)
triggerall = AiLevel > 0 ;Ai On
trigger1 = statetype !=S && ctrl

;Back Air Dash
[State -3, Back Air Dash]
type = ChangeState
value = 61
;triggerall = command = "BB"
triggerall = stateno != [60,61]
triggerall = stateno != [100,105]
triggerall = !var(5)
triggerall = AiLevel > 0 ;Ai On
trigger1 = statetype !=S && ctrl
;Run Fwd
[State -3, Run Fwd]
type = ChangeState
value = 100
triggerall = AiLevel > 0 ;Ai On
trigger1 = command = "FF"
triggerall = statetype = S
trigger1 = ctrl

;---------------------------------------------------------------------------
;Run Back
[State -3, Run Back]
type = ChangeState
value = 105
triggerall = AiLevel > 0 ;Ai On
trigger1 = command = "BB"
triggerall = statetype = S
trigger1 = ctrl

;---------------------------------------------------------------------------
;Dash Cancel
[State -3, Dash Cancel]
type = ChangeState
value = 102
triggerall = var(10)
triggerall = AiLevel > 0 ;Ai On
;triggerall = command = "FF"
triggerall = statetype = S
trigger1 = ctrl
trigger2 = (stateno = 230) || (stateno = 430) ;standing hits
trigger2 = movecontact
trigger3 = (stateno = 10002) || (stateno = 10017) || (stateno = 10020) || (stateno = 10021);special hits
trigger3 = movecontact
trigger4 = stateno = 10013 ;Dead Spike CT-CS
trigger4 = movecontact || animelemtime (12) > 0
trigger5 = (stateno = 1014) || (stateno = 10014) ;Dead Spike CP-CF
trigger5 = movecontact || animelemtime (12) > 0
trigger5 =! var(10)
trigger6 = stateno = 8310 ;Not Over Yet
trigger6 = movecontact || animelemtime (11) > 0
;----------------------------------------------------------------------------
;Taunt
