;--------------------------------------------------
;BURST (Ground)
[Statedef 943]
type = S
movetype = I
physics = S
ctrl = 0
anim = 4300
poweradd = -powermax

[State -2, Barrier Block]
type = hitoverride
triggerall = numhelper(4000) = 1
triggerall = var(6) = 1 || Var(6) = 3
trigger1 = 1
attr = SA, NA, SA, NP, SP, HA, HP
stateno = 940
slot = 0
time = 1
ignorehitpause = 1
[State 230, 2]
type = HitDef
trigger1 = movehit
attr = S, NA
animtype  = Up
damage    = 0,0
guardflag = MA
pausetime = 12,12
guard.sparkno = S-1
sparkno = S-1 
sparkxy = -10,-37
hitsound   = S2,2
guardsound = S6,0
ground.type = High
ground.slidetime = 10
ground.hittime  = 20
ground.velocity = -1,-5
air.velocity = .5,-3.5
fall = 1
[State 151, 2]
type = VelSet
trigger1 = Time = GetHitVar(slidetime)
trigger2 = HitOver
x = 0
[State 132, Stop Barrier]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;--------------------------------------------------
;Rapid Cancel
[Statedef 950]
type = S
movetype = I
physics = S
ctrl = 1
anim = 0
poweradd = -1000

;Rapid Effect
[state a]
type = explod
trigger1 = animelem = 1
anim = 6001
pos = 0,-40
postype = p1
bindtime = -2
removetime = 10
pausemovetime = 99999
supermovetime = 99999
ignorehitpause = 0
persistent = 0
scale = const(size.xscale),const(size.yscale)
sprpriority = 3
;angleset = 35

;Rapid Voice
[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 1
value = S950,0
channel = 2

;Sound Effect
[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 1
value = S950,1
channel = 1

[State 1100, 1]
type = statetypeset
triggerall = Time >= 0
trigger1 = Pos Y < 0
statetype = A

[State 1100, 5]
type = ChangeState
triggerall = Time >= 1
trigger1 = Pos Y < 0
value = 50
ctrl = 1
