;---------------------------------------------------------------------------
; Fast Kung Fu Palm
; CNS difficulty: advanced
; Description: This is a complicated attack move. If you're a beginner,
;     you should skip looking at this for now and check it later when
;     you are more comfortable with the cns.
;     This move puts the other player in a custom get-hit state.
;     The line ";p2stateno = 1025" in the HitDef does this. KFM has some
;Dust (Fly)
[Statedef 1026]
type    = S
movetype= A
physics = N
juggle  = 0
poweradd= 0
velset = 0,0
anim = 10200
ctrl = 0
sprpriority = 2

[state 0]
type = Helper
triggerall = var(3) = 1 && var(20) = 5
trigger1 = movehit
name = "ZOOOOOOM" 
stateno = 1992
id = 1992
pos = pos x+5,0
;postype = p1
helpertype = normal
ownpal = 1
persistent = 0
ignorehitpause = 1
pausemovetime = 999
supermovetime = 999
;Drive Hit Spark
[State 1, Drive Hit Spark]
type = explod
trigger1 = movecontact = 1 && numtarget
trigger1 = target,time <=0 && p2movetype = H
anim = 8001
id = 8001
pos = 0,-50
facing = 1
postype = p2
sprpriority = 9
bindtime = 1
ownpal = 1
ignorehitpause = 1
persistent = 0
scale = const(size.xscale),const(size.yscale)
[State 1, Hit Spark]
type = explod
trigger1 = movehit = 1 && numtarget
trigger1 = target,time <=0 && p2movetype = H
anim = 8006
id = 8006
pos = 0,-50
facing = 1
postype = p2
sprpriority = 6
bindtime = 1
ownpal = 1
ignorehitpause = 1
persistent = 0
scale = const(size.xscale)*1.5,const(size.yscale)*1.5
[State 1020, 6]
type = HitDef
trigger1 = AnimElem = 4
trigger1 = enemy,statetype = A
attr = S, SA
animtype  = Hard
damage    = 95, 5
getpower  = 0
priority  = 4
guardflag = MA
pausetime = 26,26
sparkxy = -10,-60
hitsound   = 5,4
guardsound = 6,0
ground.type = Low
ground.slidetime = 20
ground.hittime  = 22
ground.velocity = -8,-7
guard.velocity = -7
air.velocity = 0,10
airguard.velocity = -5, -4
fall = 1
p2stateno = 6010    ;Make p2 go to state 1025 on hit
p2facing = 1        ;Force to face p1

[State 1020, 6]
type = HitDef
trigger1 = AnimElem = 4
trigger1 = enemy,statetype != A
attr = S, SA
animtype  = Hard
damage    = 95, 5
getpower  = 0
priority  = 4
guardflag = H
pausetime = 23,23
sparkxy = -10,-60
hitsound   = 5,4
guardsound = 6,0
ground.type = Low
ground.slidetime = 20
ground.hittime  = 22
ground.velocity = -8,-7
guard.velocity = -7
air.velocity = -8,-7
airguard.velocity = -5, -4
;fall = 1
p2stateno = 6022    ;Make p2 go to state 1025 on hit
p2facing = 1        ;Force to face p1

;Dust Jump
[State 1020, 7]
type = ChangeState
triggerall = var(20) = 5
triggerall = movehit
triggerall = p2stateno = 6022
trigger1 = command = "holdup"
value = 1028
ctrl = 0

[State 1020, 7]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

