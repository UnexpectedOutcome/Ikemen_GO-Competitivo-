st6 = cns/gakusha_normal_attack.cns
st7 = option.txt
st8 = 
st9 = cns/gakusha_common.cns
stcommon = common1.cns

;============================================================
; カラーパレットファイル
;============================================================
pal1 = act/gakusha.act
pal2 = act/gakusha.act
pal3 = act/gakusha.act
