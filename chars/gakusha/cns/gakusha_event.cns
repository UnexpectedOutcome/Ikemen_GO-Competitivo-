trigger1 = AnimElemTime(9) = 0
channel = 1
value = 6, 2

[State 181, さらばーっス]
type = PlaySnd
trigger1 = AnimElemTime(13) = 0
channel = 1
value = 3, 17

[State 181, 退場]
type = Projectile
trigger1 = AnimElemTime(18) = 0
projanim = 182
projscale = const(size.xscale), const(size.yscale)
velocity = -1.5, 0
offset = 0, 0
postype = p1
projshadow = -1


