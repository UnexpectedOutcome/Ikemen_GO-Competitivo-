;---------------------------------------------------------------------------
;イントロ用ヘルパー
;---------------------------------------------------------------------------
[Statedef 11000]
type      = S
movetype  = I
physics   = S
ctrl      = 0
velset    = 0, 0

[State 11000, スプライト優先度変更]
type = SprPriority
trigger1 = Time = 0
trigger1 = NumPartner = 1
value = IfElse(Root,Pos X > Partner,Pos X, IfElse(Root,var(4) = 1, 5, -5), IfElse(Root,var(4) = 1, -5, 5))

[State 11000, イントロ選択]
type = VarRandom
trigger1 = Time = 0
v = 0
range = 1, 2

[State 11000, 通常イントロ遷移先ステート決定]
type = Null
triggerall = Time = 0
trigger1 = var(0) := (11000 + var(0))

[State 11000, 通常イントロステート決定]
type = VarSet
triggerall = Time = 0
trigger1 = Random < 10
var(0) = 11003




[State 11000, イントロステートへ]
type = ChangeState
trigger1 = Time = 0
value = var(0)



;---------------------------------------------------------------------------
;イントロ1(走ってきて一声)
;---------------------------------------------------------------------------
[Statedef 11001]
type     = S
movetype = I
physics  = N
ctrl     = 0
velset   = 0, 0

[State 11001, フラグ初期化]
type = VarSet
trigger1 = Time = 0
var(0) = 0

[State 11001, 位置変更]
type = PosSet
trigger1 = Time = 0
trigger1 = var(0) = 0
y = 0
x = IfElse(Root,var(4) = 1, -250, 250)

[State 11001, アニメ変更]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = var(0) = 0
value = 100

[State 11001, 移動]
type = VelSet
trigger1 = Time = 0
trigger1 = var(0) = 0
x = const(velocity.run.fwd.x)

[State 11001, ダッシュ音再生]
type = PlaySnd
triggerall = (Time % 24) = 0
trigger1 = var(0) = 0
trigger1 = Anim = 100
value = 5, 0

[State 11001, 立ち位置についたらフラグ変更]
type = VarSet
triggerall = var(0) = 0
trigger1 = Root,var(4) = 1
trigger1 = Pos X > Root,Pos X
trigger2 = Root,var(4) = 2
trigger2 = Pos X < Root,Pos X
var(0) = 1

[State 11001, 停止]
type = VelSet
trigger1 = var(0) = 1
x = 0

[State 11001, X座標補正]
type = PosSet
trigger1 = var(0) = 1
x = floor(Root,Pos X)

[State 11001, アニメ変更]
type = ChangeAnim
trigger1 = var(0) = 1
trigger1 = Anim != 1710
value = 1710

[State 11001, 声]
type = PlaySnd
trigger1 = var(0) = 1
trigger1 = Anim = 1710
trigger1 = AnimElem = 3
channel = 0
value = 3, 6

[State 11001, フラグ変更]
type = Null
trigger1 = var(0) = 1
trigger1 = AnimTime = 0
trigger1 = var(0) := 99
trigger2 = var(0) = 99
trigger2 = var(0) := 100

[State 11001, ヘルパー削除]
type = DestroySelf
triggerall = IsHelper
trigger1 = var(0) = 100
trigger2 = Root,StateNo != 191

