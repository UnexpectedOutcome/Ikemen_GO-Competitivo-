;===========================================================
; イベント系記述(コモンステートなんだけど)
;===========================================================



;---------------------------------------------------------------------------
;イントロ分岐
;---------------------------------------------------------------------------
[Statedef 190]
type = S
ctrl = 0

[State 190, 1]
type = ChangeState
trigger1 = Time = 0
value = 191


;---------------------------------------------------------------------------
;イントロ
;---------------------------------------------------------------------------
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 特殊効果];試合が開始するまではこのコントローラを使おう（※２）
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態

[State 191, イントロ用ヘルパー射出]
type = Helper
trigger1 = Time = 1
name = "Intro"
ID = 11000
stateno = 11000
pos = 0, 0
postype = p1
ownpal = 1

[State 191, ステート変更];アニメーションが終われば「通常立ち」のステートに変更する
type = ChangeState
trigger1 = Time >= 60
trigger1 = NumHelper(11000) = 0
trigger2 = NumHelper(11000)
trigger2 = Helper(11000),var(0) = 99
value = 0



;---------------------------------------------------------------------------
;挑発
;---------------------------------------------------------------------------
[Statedef 195]
type = S
movetype = I
physics = S
ctrl = 0
anim = 195
velset = 0,0
sprpriority = 2

[State 195, 声]
type = PlaySnd
trigger1 = AnimElemTime(2) = 0
channel = 0
value = 3, IfElse(Random % 4 = 0, 4, IfElse(Random % 3 = 0, 5, IfElse(Random % 2 = 0, 10, 11)))

[State 195, コントロール]
type = CtrlSet
trigger1 = Time = 40 ;このステートが４０フレームになったら
value = 1            ;キーコントロールが可能になる。

[State 195, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1




;---------------------------------------------------------------------------
;勝利ポーズ分岐（common1.cnsには無いけど、これもコモンステート）
;---------------------------------------------------------------------------
[Statedef 180]
type = S

[State 180, パウダー削除]
type = VarSet
trigger1 = Time = 0
fvar(13) = 0

[State 180, パウダー削除]
type = VarSet
trigger1 = Time = 0
fvar(14) = 0

[State 180, オラシ解除]
type = VarSet
trigger1 = Time = 0
var(7) = 0


[State 180, 変身後退場]
type = ChangeState
triggerall = Win
trigger1 = MatchOver
trigger1 = Random < 10
value = 181

[State 180, にゃーん or 変身失敗]
type = ChangeState
trigger1 = Time = 0
value = IfElse(Random % 2 = 0, 183, 184)



;---------------------------------------------------------------------------
;勝利ポーズ（変身後退場）
