;===========================================================
; コモンステート記述
;===========================================================


;===========================================================
; 基本行動
;===========================================================
;-------------------------------------------------
; 立ち状態
;-------------------------------------------------
[Statedef 0]
type        = S
physics     = S
sprpriority = 0

[State 0, アニメ変更]
type = ChangeAnim
trigger1 = (Anim != 0) && (Anim != 5)
trigger2 = (Anim = 5) && (AnimTime = 0) ;振り向きアニメ完了
value = 0

[State 0, 移動速度]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 移動速度]
type = VelSet
trigger1 = (abs(vel x) < 2)
trigger2 = Time = 4
;trigger3 = (PrevStateNo = 20) && (Time = 0)
x = 0

[State 0, 死亡時]
type = ChangeState
trigger1 = (!alive)
value = 5050

[State 0, ヘルパーを消す] ;ヘルパー分身バグ対策
type = DestroySelf
triggerall = IsHelper
trigger1 = !IsHelper(27020)

[State 0, シュルルステート抜け]
type = SelfState
triggerall = IsHelper(27020)
trigger1 = (StateNo != 27020) && (StateNo != 27021) && (StateNo != 27022) && (StateNo != 27023) && (StateNo != 27025)
trigger1 = fvar(0) <= 99
value = 27021
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State 0, シュルルステート抜け]
type = SelfState
triggerall = IsHelper(27020)
trigger1 = (StateNo != 27020) && (StateNo != 27021) && (StateNo != 27022) && (StateNo != 27023) && (StateNo != 27025)
trigger1 = fvar(0) = [100,799]
value = 27022
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State 0, シュルルステート抜け]
type = SelfState
triggerall = IsHelper(27020)
trigger1 = (StateNo != 27020) && (StateNo != 27021) && (StateNo != 27022) && (StateNo != 27023) && (StateNo != 27025)
trigger1 = fvar(0) >= 800
value = 27023
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State 0, ジャンプ攻撃回数リセット]
type = VarSet
trigger1 = Time = 0
var(21) = 0

[State 0, 空中ダッシュ回数リセット]
type = VarSet
trigger1 = Time = 0
var(20) = 0

[State 0, 空中攻撃リセット]
type = VarSet
trigger1 = Time = 0
var(43) = 0

;---------------------------------------------------------------------------
; 歩き(AI時)
;---------------------------------------------------------------------------
;[Statedef 19]
;type    = S
;physics = S
;sprpriority = 0
;ctrl    = 0

;[State 19, 1]
;type = VelSet
;trigger1 = command = "holdfwd"
;x = const(velocity.walk.fwd.x)

;[State 19, 2]
;type = VelSet
;trigger1 = command = "holdback"
;x = const(velocity.walk.back.x)

;[State 19, 3]
;type = ChangeAnim
;triggerall = vel x > 0
;trigger1 = Anim != 20 && Anim != 5
;trigger2 = Anim = 5 && AnimTime = 0
;value = 20

;[State 19, 4]
;type = ChangeAnim
;triggerall = vel x < 0
;trigger1 = Anim != 21 && Anim != 5
;trigger2 = Anim = 5 && AnimTime = 0
;value = 21

;[State 19, 5]
;type = ChangeState
;trigger1 = InGuardDist
;trigger2 = Enemy(var(58)), MoveType != H
;trigger3 = Enemy(var(58)), MoveType = A
;value = 0
;ctrl = 1

;-------------------------------------------------
; 歩き状態
;-------------------------------------------------
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x) * IfElse(var(2) < fvar(25), 1.2, 1) * IfElse(var(2) < var(36), -1, 1)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x) * IfElse(var(2) < fvar(25), 1.2, 1) * IfElse(var(2) < var(36), -1, 1)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21


;---------------------------------------------------------------------------
; ジャンプ(AI操作)
;---------------------------------------------------------------------------
;[Statedef 39]
;type        = S
;physics     = S
;anim        = 40
;ctrl        = 0
;sprpriority = 1

;[State 39, 1]
;type = VarSet
;trigger1 = Time = 0
;sysvar(1) = 0

;[State 39, 2]
;type = VarSet
;trigger1 = Enemy(var(58)),StateType != L || P2BodyDist X >= 30
;trigger1 = Enemy(var(58)),MoveType = H || Random <= 333 || Enemy(var(58)),StateType = L
;sysvar(1) = 1

;[State 39, 3]
;type = VarSet
;trigger1 = Enemy(var(58)),StateType != L
;trigger1 = Enemy(var(58)),MoveType != H
;trigger1 = BackEdgeBodyDist > 60
;trigger1 = Random <= 500
;sysvar(1) = -1

;[State 39, 4]
;type = VelSet
;trigger1 = AnimTime = 0
;x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
;y = const(velocity.jump.y)
;
;[State 39, 5]
;type = VelSet
;trigger1 = AnimTime = 0
;trigger1 = prevstateno = 99 ;RUN_FWD
;trigger1 = sysvar(1) = 1
;x = const(velocity.runjump.fwd.x)
;
;[State 39, 6]
;type = ChangeState
;trigger1 = AnimTime = 0
;value = 50
;ctrl = 1

;-------------------------------------------------
; ジャンプ開始
;-------------------------------------------------
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = var(2) >= var(36)
trigger1 = command = "holdfwd"
trigger2 = var(2) < var(36)
trigger2 = command = "holdback"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = var(2) >= var(36)
trigger1 = command = "holdback"
trigger2 = var(2) < var(36)
trigger2 = command = "holdfwd"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1


;---------------------------------------------------------------------------
; 前ダッシュ(AI操作)
;---------------------------------------------------------------------------
;[Statedef 99]
;type        = S
;physics     = S
;anim        = 100
;ctrl        = 0
;sprpriority = 1

;[State 99, 1]
;type = VelSet
;trigger1 = 1
;x = const(velocity.run.fwd.x)

;[State 99, 2] ;Prevent run from canceling into walk
;type = AssertSpecial
;trigger1 = 1
;flag = NoWalk
;
;[State 99, 3] ;Prevent from turning
;type = AssertSpecial
;trigger1 = 1
;flag = NoAutoTurn
;
;[State 99, 4]
;type = ChangeState
;triggerall = var(59) > 0
;trigger1 = var(56) = 0
;trigger2 = InGuardDist
;trigger2 = (var(56) := 0) = 0
;trigger3 = Enemy(var(58)),MoveType != H
;trigger3 = P2BodyDist X <= 90
;trigger3 = P2BodyDist Y >= -120
;trigger3 = (var(56) := 0) = 0
;trigger4 = P2BodyDist X <= 10
;trigger4 = (var(56) := 0) = 0
;value = 0
;ctrl = 1
;

;-------------------------------------------------
; 前ダッシュ状態
;-------------------------------------------------
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 幅変更]
type = Width
trigger1 = 1
player = ceil(30 * const(size.xscale)), ceil(0 * const(size.yscale))
edge = ceil(50 * const(size.xscale)), ceil(0 * const(size.yscale))

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x) * IfElse(var(2) < fvar(25), 1.2, 1)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0


;-------------------------------------------------
; 空中ダッシュ落下
;-------------------------------------------------
[Statedef 51]
type     = A
physics  = A

[State 51, 速度設定]
type = VelSet
trigger1 = Time = 0
x = IfElse((vel x) > 0, 4, IfElse((vel x) = 0, 0,-4))

[State 51, 状態設定]
type = VarSet
trigger1 = Time = 0
var(56) = 0

[State 51, アニメーション変更]
type = ChangeAnim
trigger1 = Time = 0
value = 44

[State 51, 通常攻撃ふり変更]
type = Null
triggerall = Time = 5
trigger1 = PrevStateNo != [101,102]
trigger1 = PrevStateNo != [107,108]
trigger1 = var(43) := 1


;-------------------------------------------------
; 空中ダッシュ(前)
;-------------------------------------------------
[Statedef 101]
type     = A
movetype = I
physics  = N
anim     = 101
ctrl     = 1
velset   = 4 * IfElse(var(2) < fvar(25), 1.2, 1), -1.5
sprpriority = 1

[State 101, 幅変更]
type = Width
trigger1 = 1
player = ceil(30 * const(size.xscale)), ceil(0 * const(size.yscale))
edge = ceil(50 * const(size.xscale)), ceil(0 * const(size.yscale))

[State 101, 効果線]
type = Explod
trigger1 = Time = 0
anim = 31100
pos = 0, 0
postype = p1
ownpal = 1
facing = 1
bindtime = -1
sprpriority = 3
removeongethit = 1
scale = 1 * const(size.xscale), 1 * const(size.yscale)

[State 101, リング]
type = Explod
trigger1 = Time = 0
anim = 31101
pos = ceil(-10 * const(size.xscale)), ceil(-50 * const(size.yscale))
postype = p1
ownpal = 1
facing = 1
sprpriority = 3
scale = 1 * const(size.xscale), 1 * const(size.yscale)

[State 101, 噴射]
type = Explod
trigger1 = Time = 0
anim = 31102
pos = 0, 0
postype = p1
ownpal = 1
facing = 1
sprpriority = 3
scale = 1 * const(size.xscale), 1 * const(size.yscale)

[State 101, 星表示]
type = Explod
trigger1 = (Time % 4) = 3
anim = 31002
pos = ceil(-15 * const(size.xscale)), ceil(-50 * const(size.yscale))
postype = p1
sprpriority = 3
ownpal = 1
random = ceil(20 * const(size.xscale)), ceil(10 * const(size.yscale))
vel = -1.5, 0

[State 101, 速度設定]
type = VelSet
trigger1 = Time = 0
x = 10
y = 0

[State 101, ボイス再生]
type = PlaySnd
trigger1 = Time = 1
channel = 0
value = 0, 17

[State 101, SE]
type = PlaySnd
trigger1 = Time = 1
channel = 1
value = 5, 1

[State 101, 空中ダッシュカウント]
type = VarAdd
trigger1 = Time = 1
var(20) = 1

[State 101, ステート変更]
type = ChangeState
;trigger1 = (Time > 1) && ( Pos Y >= 0)
trigger1 = Time > 20
value = 51



