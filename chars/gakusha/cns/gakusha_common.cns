;;-------------------------------------------------
; バックステップ
;-------------------------------------------------
[Statedef 105]
type     = A
physics  = A
ctrl     = 0
anim     = 105
sprpriority = 1

[State 105, 速度設定]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x) * IfElse(var(2) < fvar(25), 1.2, 1)
y = const(velocity.run.back.y)

[State 105, コントロール]
type = CtrlSet
trigger1 = Time = 2
value = 1

[State 105, ステート変更]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

