;===========================================================================
; ヘルパー
;===========================================================================


; ヘルパー用変数

; fvar(0)	スキル成功失敗判定用
; fvar(1)	スキル使用時攻撃力倍率記録用
; fvar(2)	ダメージ計算用バッファ
; fvar(7)	魔法ダメージ倍率計算用バッファ
; var(37)	シュルル効果時間
; var(38)	シュルル効果範囲内の敵１
; var(39)	シュルル効果範囲内の敵２


; fvar(0)	スキル成功失敗判定用
; fvar(1)	スキル使用時攻撃力倍率記録用
; fvar(2)	ダメージ計算用バッファ

; var(13)	EMM成否判定用
; var(14)	Hit回数
; var(15)	目標敵ID
; var(16)	前回ターゲットID
; var(17)	対象とのX距離
; var(18)	対象とのY距離
; fvar(9)	対象との角度


; fvar(7)	魔法ダメージ倍率計算用バッファ
; var(10)	アシッドクラウド持続時間判定用

; var(20)	2Pへの攻撃フラグ
; var(21)	4Pへの攻撃フラグ
; fvar(19)	対象との直線距離
; fvar(20)	電撃の角度




;---------------------------------------------------------------------------
; ハイパーアーマー用
;---------------------------------------------------------------------------
[Statedef 9000]
type = A
movetype = I
physics = N
sprpriority = -4

[State 9000, 0/CHs]; 不具合対策
type = ChangeState
trigger1 = !IsHelper
value = 0
ctrl = 1

[State 9000, 0/Ass]; 開始時だけ透明／親とアニメが違っていたら透明
type = AssertSpecial
trigger1 = (Time = 0) || (Anim != Root,Anim)
trigger2 = Root,StateNo = [3202,3204] ; ドリルに乗っているときは透明
flag = Invisible

[State 9000, 0/NHB]; 開始時だけ無敵（重複被弾防止）
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 1

[State 9000, -1/NHB]; 投げ無敵
type = NotHitBy
trigger1 = 1
value2 = ,AT
time = 2

[State 9000, -1/Tra]; 透過処理
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,130

[State 9000, -1/Ass]; 影消し
type = AssertSpecial
trigger1 = 1
flag = NoShadow

[State 9000, -1/Pos]; 本体に追従
type = BindToRoot
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 9000, -1/CHa]; 判定を揃える
type = ChangeAnim
trigger1 = SelfAnimExist(Root,Anim)
value = Root,Anim
elem = Root,AnimElemNo(0)

[State 9000, -1/Var]; アーマーエフェクト用の拡縮変数
type = VarAdd
trigger1 = fvar(3) < 30
fvar(3) = 3

[State 9000, -1/Agl]; アーマーエフェクト用の拡縮
type = AngleDraw
trigger1 = 1
scale = (134-fvar(3))*0.01,(132-fvar(3))*0.01

[State 9000, -1/Var]; アーマーエフェクト発光用の被弾変数
type = VarSet
trigger1 = 1
fvar(4) = IfElse(GetHitVar(damage),1,IfElse(Time<20,fvar(4),0))

[State 9000, -1/Pal]; アーマーエフェクト発光：黄
type = PalFX
trigger1 = fvar(4) = 0 && Time%20 = 0
trigger2 = fvar(4) = 1 && Time%4 = 0
time = IfElse(fvar(4)=1,2,10)
add = 256,256,0
mul = 256,256,0

[State 9000, -1/Pal]; アーマーエフェクト発光：赤
type = PalFX
trigger1 = fvar(4) = 0 && Time%20 = 10
trigger2 = fvar(4) = 1 && Time%4 = 2
time = IfElse(fvar(4)=1,2,10)
add = 256,0,0
mul = 256,0,0

[State 9000, 打撃と飛び道具を受けたらステートを繰り返す]
type = HitOverRide
trigger1 = IsHelper(9000)
attr = SCA, AA, AP
stateno = 9000

[State 9000, 本体がアーマーパートを過ぎたら消滅]
type = DestroySelf
triggerall = IsHelper
trigger1 = Root, StateNo != 1020 ; 落花掌最大タメ突撃
trigger1 = Root, StateNo != 1025 ; 落花掌最大タメその場
trigger1 = Root, StateNo != [2800,2801] ; ブラックマント
trigger1 = Root, StateNo != 2400 ; ホウキスピン
trigger1 = Root, StateNo != 2430 ; ホウキスピン（攻撃判定なし)
trigger1 = Root, StateNo != [2900,2910] ; 燃え盛る炎の加熱炉
trigger1 = Root, StateNo != [3100,3103] ; フローレカライダー
trigger1 = Root, StateNo != [3201,3204] ; メガドリル
trigger1 = Root, StateNo != 3301 ; フュージョンクラフト前半
trigger2 = !Root,Alive


;---------------------------------------------------------------------------
; 永続ターゲット2P用
;---------------------------------------------------------------------------
[Statedef 9100]
movetype = H
anim = 9101

[State 9100, 本体にはりつく]
type = BindtoRoot
trigger1 = NumTarget = 0
pos = 0, -1
ignorehitpause = 1

[State 9100, 対象追尾]
type = PosSet
trigger1 = NumTarget > 0
x = Enemy(0),Pos X
y = Enemy(0),Pos Y - 1


; ▼ターゲット取得系 開始▼
[State 9100, アニメ判断用変数初期化]
type = VarSet
trigger1 = Time = 0
trigger2 = var(1) >= 5
trigger2 = anim = 9101
var(1) = 0

[State 9100, 攻撃判定時間]
type = VarAdd
trigger1 = anim = 9100
var(1) = 1

[State 9100, アニメ変更1] ; 攻撃判定のアニメに
type = ChangeAnim
triggerall = Root,alive
triggerall = NumTarget <= 0
triggerall = abs(Enemy(0),Pos X - Pos X) <= 140 * Root,const(size.xscale)
trigger1 = Root,StateNo = [150,152]
trigger2 = Root,StateNo = 5000
trigger3 = Root,StateNo = 5020
trigger4 = Root,StateNo = 5030
trigger5 = Root,StateNo = 5070
trigger6 = Root,StateNo = 5080
value = 9100

[State 9100, 当身状態]
type = ReversalDef
trigger1 = Root,alive
trigger1 = Enemy(0),alive
reversal.attr = SCA, AA, AT, AP
priority = 7, Hit
pausetime = 0, 0
hitsound = -1
sparkno = -1
guard.sparkno = -1
guardsound = -1
ignorehitpause = 1

[State 9100, ターゲットを１つに絞る]
type = TargetDrop
trigger1 = NumTarget > 1
keepone = 1

[State 9100, 2Pのみターゲットに]
type = TargetDrop
trigger1 = NumTarget > 0
trigger1 = Target,ID != Enemy(0),ID

[State 9100, アニメ変更] ; 攻撃判定がなくなる
type = ChangeAnim
trigger1 = NumTarget
trigger2 = var(1) >= 5
value = 9101
; ▲ターゲット取得系 終了▲


; マグマポーション
[State 9100, マグマダメージ計算 基本とセルフバフ系]
type = VarSet
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 80 = 0
trigger1 = NumHelper(27100) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1 = (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1 = Helper(27100),StateNo = [27102,27103]
fvar(2) = 20 * Helper(27100),fvar(7)

[State 9100, マグマダメージ計算 シュルル]
type = VarSet
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 80 = 0
trigger1 = NumHelper(27100) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1 = (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1 = Helper(27100),StateNo = [27102,27103]
trigger1 = NumHelper(27020) > 0
trigger1 = (Enemy(0),ID = Helper(27020),var(38)) || (Enemy(0),ID = Helper(27020),var(39))
fvar(2) = fvar(2) * 1.1

[State 9100, マグマHit]
type = TargetLifeAdd
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 80 = 0
trigger1 = NumHelper(27100) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1 = (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1 = Helper(27100),StateNo = [27102,27103]
value = -ceil(fvar(2) * Root,const(data.attack) * 0.01)

[State 9100, ヒットエフェクト]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 80 = 0
trigger1 = NumHelper(27100) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1 = (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1 = Helper(27100),StateNo = [27102,27103]
trigger1 = Enemy(0),StateNo != [120,152]
anim = IfElse(Random < 499, 30000, 30010)
pos = 0, ceil(Enemy(0),const(size.mid.pos.y))
postype = p2
scale = Root,const(size.xscale) * 1, Root,const(size.yscale) * 1
ignorehitpause = 1
ownpal = 1
sprpriority = 2

[State 9100, マグマヒット音1]
type = PlaySnd
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 80 = 0
trigger1 = NumHelper(27100) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1 = (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1 = Helper(27100),StateNo = [27102,27103]
trigger1 = Enemy(0),StateNo != [120,152]
value = 8, 21

[State 9100, ガードエフェクト]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 80 = 0
trigger1 = NumHelper(27100) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1 = (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1 = Helper(27100),StateNo = [27102,27103]
trigger1 = Enemy(0),StateNo = [120,152]
anim = IfElse(Facing = 1, 30020, 30021)
pos = 0, ceil(Enemy(0),const(size.mid.pos.y))
postype = p2
scale = Root,const(size.xscale) * 1, Root,const(size.yscale) * 1
ignorehitpause = 1
ownpal = 1
sprpriority = 2

[State 9100, マグマガード音1]
type = PlaySnd
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 80 = 0
trigger1 = NumHelper(27100) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1 = (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1 = Helper(27100),StateNo = [27102,27103]
trigger1 = Enemy(0),StateNo = [120,152]
value = 8, 3

[State 9100, マグマ移動速度減少]
type = TargetVelSet
triggerall = RoundState >= 2
trigger1 = NumHelper(27100) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1 = (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1 = Helper(27100),StateNo = [27102,27103]
x = Enemy(0),Vel X * 0.5
y = IfElse(Enemy(0),Vel Y < 0, Enemy(0),Vel Y * 0.7, Enemy(0),Vel Y)

[State 9100, マグマ前進制限]
type			= Helper
triggerall		= RoundState = 2
trigger1		= NumHelper(27100) > 0
trigger1		= abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1		= (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1		= Helper(27100),StateNo = [27102,27103]
trigger1		= NumHelper(27600) = 0
trigger1		= Enemy(0),Vel X > 0
trigger1		= Enemy(0),StateType != A
trigger1		= Enemy(0),MoveType != H
helpertype		= Normal
name			= "MFront1"
ID				= 27600
stateno			= 27600
pos				= 50, 0
postype			= p2
keyctrl			= 0
ownpal			= 1
supermovetime	= 0
pausemovetime	= 0
sprpriority		= -2

[State 9100, マグマ後退制限]
type			= Helper
triggerall		= RoundState = 2
trigger1		= NumHelper(27100) > 0
trigger1		= abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1		= (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1		= Helper(27100),StateNo = [27102,27103]
trigger1		= NumHelper(27610) = 0
trigger1		= Enemy(0),Vel X < 0
trigger1		= Enemy(0),StateType != A
trigger1		= Enemy(0),MoveType != H
helpertype		= Normal
name			= "MBack1"
ID				= 27610
stateno			= 27610
pos				= -50, 0
postype			= p2
keyctrl			= 0
ownpal			= 1
supermovetime	= 0
pausemovetime	= 0
sprpriority		= -2

[State 9100, マグマ大成功火傷付与]
type = ParentVarSet
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 80 = 0
trigger1 = NumHelper(27100) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27100),Pos X) <= 110 * Root,const(size.xscale)
trigger1 = (Enemy(0),Pos Y - Helper(27100),Pos Y) = [-19,8]
trigger1 = Helper(27100),StateNo = 27103
var(18) = Root,var(2) + 120 ; ２秒




; アシッドクラウド
[State 9100, アシッドクラウドダメージ計算 基本とセルフバフ系]
type = VarSet
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 42 = 0
trigger1 = NumHelper(27200) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27200),Pos X) <= 89 * Root,const(size.xscale)
trigger1 = Enemy(0),Pos Y >= ceil(-190 * Root,const(size.yscale))
trigger1 = Helper(27200),StateNo = [27201,27203]
fvar(2) = 7 * Helper(27200),fvar(7)

[State 9100, アシッドクラウドダメージ計算 シュルル]
type = VarSet
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 42 = 0
trigger1 = NumHelper(27200) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27200),Pos X) <= 89 * Root,const(size.xscale)
trigger1 = Enemy(0),Pos Y >= ceil(-190 * Root,const(size.yscale))
trigger1 = Helper(27200),StateNo = [27201,27203]
trigger1 = NumHelper(27020) > 0
trigger1 = (Enemy(0),ID = Helper(27020),var(38)) || (Enemy(0),ID = Helper(27020),var(39))
fvar(2) = fvar(2) * 1.1

[State 9100, アシッドクラウドHit]
type = TargetLifeAdd
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 42 = 0
trigger1 = NumHelper(27200) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27200),Pos X) <= 89 * Root,const(size.xscale)
trigger1 = Enemy(0),Pos Y >= ceil(-190 * Root,const(size.yscale))
trigger1 = Helper(27200),StateNo = [27201,27203]
value = -ceil(fvar(2) * Root,const(data.attack) * 0.01)

[State 9100, ヒットエフェクト]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 42 = 0
trigger1 = NumHelper(27200) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27200),Pos X) <= 89 * Root,const(size.xscale)
trigger1 = Enemy(0),Pos Y >= ceil(-190 * Root,const(size.yscale))
trigger1 = Helper(27200),StateNo = [27201,27203]
trigger1 = Enemy(0),StateNo != [120,152]
anim = IfElse(Random < 499, 30000, 30010)
pos = 0, ceil(Enemy(0),const(size.mid.pos.y))
postype = p2
scale = Root,const(size.xscale) * 1, Root,const(size.yscale) * 1
ignorehitpause = 1
ownpal = 1
sprpriority = 2

[State 9100, アシッドクラウドヒット音1]
type = PlaySnd
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 42 = 0
trigger1 = NumHelper(27200) > 0
trigger1 = Enemy(0),Pos Y >= ceil(-190 * Root,const(size.yscale))
trigger1 = abs(Enemy(0),Pos X - Helper(27200),Pos X) <= 89 * Root,const(size.xscale)
trigger1 = Helper(27200),StateNo = [27201,27203]
trigger1 = Enemy(0),StateNo != [120,152]
value = 8, 21
;pan = Enemy(0),ScreenPos X - ScreenPos X

[State 9100, ガードエフェクト]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 42 = 0
trigger1 = NumHelper(27200) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27200),Pos X) <= 89 * Root,const(size.xscale)
trigger1 = Enemy(0),Pos Y >= ceil(-190 * Root,const(size.yscale))
trigger1 = Helper(27200),StateNo = [27201,27203]
trigger1 = Enemy(0),StateNo = [120,152]
anim = IfElse(Facing = 1, 30020, 30021)
pos = 0, ceil(Enemy(0),const(size.mid.pos.y))
postype = p2
scale = Root,const(size.xscale) * 1, Root,const(size.yscale) * 1
ignorehitpause = 1
ownpal = 1
sprpriority = 2

[State 9100, アシッドクラウドガード音1]
type = PlaySnd
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 42 = 0
trigger1 = NumHelper(27200) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27200),Pos X) <= 89 * Root,const(size.xscale)
trigger1 = Enemy(0),Pos Y >= ceil(-190 * Root,const(size.yscale))
trigger1 = Helper(27200),StateNo = [27201,27203]
trigger1 = Enemy(0),StateNo = [120,152]
value = 8, 3
;pan = Enemy(0),ScreenPos X - ScreenPos X

[State 9100, アシッドクラウドデバフ付与]
type = ParentVarSet
triggerall = RoundState >= 2
trigger1 = Root,var(2) % 42 = 0
trigger1 = NumHelper(27200) > 0
trigger1 = abs(Enemy(0),Pos X - Helper(27200),Pos X) <= 89 * Root,const(size.xscale)
trigger1 = Enemy(0),Pos Y >= ceil(-190 * Root,const(size.yscale))
trigger1 = Helper(27200),StateNo = [27202,27203]
var(26) = Root,var(2) + 600 ; 10秒





[State 9100, 反重力ヒットエフェクト1]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,ProjHitTime(27101) = 1
trigger1 = NumHelper(27300)
trigger1 = Helper(27300),StateNo = [27302,27303]
trigger1 = abs(Enemy(0),Pos X - Helper(27300),Pos X) <= 140 * Root,const(size.xscale)
anim = 24515
pos = 0, Enemy(0),const(size.mid.pos.y)
postype = p2
sprpriority = 3
ownpal = 1
ignorehitpause = 0

[State 9100, 反重力ヒットエフェクト2]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,ProjHitTime(27101) = 1
trigger1 = NumHelper(27300)
trigger1 = Helper(27300),StateNo = [27302,27303]
trigger1 = abs(Enemy(0),Pos X - Helper(27300),Pos X) <= 140 * Root,const(size.xscale)
anim = 24516
pos = 0, Enemy(0),const(size.mid.pos.y)
postype = p2
sprpriority = 4
ownpal = 1
ignorehitpause = 0

[State 9100, 反重力ふっとび]
type = TargetVelSet
triggerall = RoundState >= 2
trigger1 = Root,ProjHitTime(27101) = 1
trigger1 = NumHelper(27300)
trigger1 = Helper(27300),StateNo = [27302,27303]
trigger1 = abs(Enemy(0),Pos X - Helper(27300),Pos X) <= 140 * Root,const(size.xscale)
x = 0
y = -15 + abs((Enemy(0),const(velocity.jump.y) + (10 * Enemy(0),const(movement.yaccel))) * 2.5)




[State 9100, 毒エフェクト]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,var(2) <= Root,var(13)
trigger1 = Root,var(2) % 8 = 0
anim = IfElse(Random < 499, 30160, 30161)
pos = -20, Enemy(0),const(size.mid.pos.y)
postype = p2
sprpriority = 1
ownpal = 1
scale = 1, 1
ignorehitpause = 0
vel = -0.1, -0.1
random = 10, 50

[State 9100, 毒ダメージ]
type = TargetLifeAdd
triggerall = RoundState >= 2
trigger1 = Root,var(2) <= Root,var(13)
trigger1 = Root,var(2) % 60 = 0
value = -ceil(Root,var(12) * Root,const(data.attack) * 0.01)
absolute = 1



[State 9100, 火傷エフェクト]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,var(2) < Root,var(18)
trigger1 = NumExplod(30130) = 0
anim = 30130
ID = 30130
pos = 0, 0
postype = p2
sprpriority = 2
ownpal = 1
ignorehitpause = 0
