removetime = -1

[State 9100, 火傷ダメージ]
type = TargetLifeAdd
triggerall = RoundState >= 2
trigger1 = Root,var(2) < Root,var(18)
trigger1 = Root,var(2) % 60 = 0
value = -ceil(Root,fvar(26) * Root,const(data.attack) * 0.01)
absolute = 1

[State 9100, 火傷飛び火ダメージ]
type = TargetLifeAdd
triggerall = RoundState >= 2
triggerall = NumEnemy > 1
trigger1 = Root,var(2) < Root,var(19)
trigger1 = Root,var(2) % 60 = 0
trigger1 = abs(Enemy(0),Pos X - Enemy(1),Pos X) < 50
trigger1 = abs(Enemy(0),Pos Y - Enemy(1),Pos Y) < 100
value = -ceil(Root,fvar(27) * Root,const(data.attack) * 0.01)
absolute = 1

[State 9100, 火傷エフェクト削除]
type = RemoveExplod
triggerall = RoundState >= 2
trigger1 = Root,var(2) = Root,var(18)
ID = 30130



[State 9100, 凍結音]
type = PlaySnd
triggerall = RoundState >= 2
trigger1 = Root,var(2) < Root,var(10)
trigger1 = NumExplod(30140) = 0
value = 8, 17

[State 9100, 2P凍結開始]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,var(2) < Root,var(10)
trigger1 = NumExplod(30140) = 0
anim = 30142
ID = 30140
pos = 0, 0
postype = p2
bindtime = -1
scale = (Enemy(0),const(size.ground.front) + Enemy(0),const(size.ground.back)) * Enemy(0),const(size.xscale) / 50, abs(Enemy(0),const(size.head.pos.y) * Enemy(0),const(size.yscale) / 110)
ownpal = 1
sprpriority = 3
removetime = -1

[State 9100, 2P凍結中光]
type = Explod
triggerall = RoundState >= 2
trigger1 = Root,var(2) < Root,var(10)
trigger1 = NumExplod(30140) = 1
anim = 30144
ID = 30140
pos = 0, 0
