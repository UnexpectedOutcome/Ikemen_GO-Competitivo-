; 準常時監視ステート（－３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

;---------------------------------------------------------------------------
; 「前進」か「後退」をした時に歩き音を鳴らす
;---------------------------------------------------------------------------
[State -3, 歩き音を鳴らす]
type = PlaySnd
triggerall = (Time % 23) = 3
trigger1 = StateNo = 20
trigger2 = StateNo = 19
value = 5, 9


;---------------------------------------------------------------------------
; 「ダッシュ」時に音を鳴らす
;---------------------------------------------------------------------------
[State -3, ダッシュ音を鳴らす]
type = PlaySnd
triggerall = (Time % 27) = 3
trigger1 = StateNo = 100
trigger2 = StateNo = 99
value = 5, 0


;---------------------------------------------------------------------------
; 「ジャンプ開始」時に音を鳴らす
;---------------------------------------------------------------------------
[State -3, ジャンプ時の声]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 40	;ジャンプ開始
trigger2 = StateNo = 39
channel = 0
value = 0, IfElse(Random < 500, 0, 1)

[State -3, ジャンプ時のSE]
type = PlaySnd
triggerall = Time = 1
trigger1 = StateNo = 40
trigger2 = StateNo = 39
channel = 1
value = 5, 7


;---------------------------------------------------------------------------
; 「バックステップ」時に音を鳴らす
;---------------------------------------------------------------------------
[State -3, バックステップ時の声]
type = PlaySnd
triggerall = Time = 1
trigger1 = StateNo = 105	;バックステップ
trigger2 = StateNo = 104
channel = 0
value = 0, 16

[State -3, バックステップ時のSE]
type = PlaySnd
triggerall = Time = 1
trigger1 = StateNo = 105
trigger2 = StateNo = 104
channel = 1
value = 5, 7


;---------------------------------------------------------------------------
; 「着地」音を鳴らす
;---------------------------------------------------------------------------
[State -3, 着地音]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;着地ステート
trigger2 = stateno = 106 ;バックステップ後の着地ステート
channel = 1
value = 5, 8


;---------------------------------------------------------------------------
; 「着地」時、回数をリセット
;---------------------------------------------------------------------------
[State -3, ジャンプ攻撃回数リセット]
type = VarSet
triggerall = Time = 1
trigger1 = StateNo = 52  ;着地ステート
trigger2 = StateNo = 106 ;バックステップ後の着地ステート
trigger3 = StateNo = 0
trigger4 = StateNo = 47
var(21) = 0

[State -3, 空中ダッシュ回数リセット]
type = VarSet
triggerall = Time = 1
trigger1 = StateNo = 52  ;着地ステート
trigger2 = StateNo = 106 ;バックステップ後の着地ステート
trigger3 = StateNo = 0
trigger4 = StateNo = 47
var(20) = 0

[State -3, ホバリング回数リセット]
type = VarSet
triggerall = Time = 1
trigger1 = StateNo = 52  ;着地ステート
trigger2 = StateNo = 106 ;バックステップ後の着地ステート
trigger3 = StateNo = 0
trigger4 = StateNo = 47
var(23) = 0

[State -3, 空中攻撃リセット]
type = VarSet
triggerall = Time = 1
trigger1 = StateNo = 52  ;着地ステート
trigger2 = StateNo = 106 ;バックステップ後の着地ステート
trigger3 = StateNo = 0
trigger4 = StateNo = 47
var(43) = 0

;---------------------------------------------------------------------------
; 「メガドリル」時に音を鳴らす
;---------------------------------------------------------------------------
[State -3, ドリル音を鳴らす]
type = PlaySnd
trigger1 = StateNo = [3202,3204]
trigger1 = (fvar(8) - 300) = var(2)
channel = 8
value = 7, 37
loop = 1

;---------------------------------------------------------------------------


;---------------------------------------------------------------------------
; AI起動用ヘルパー管理
;---------------------------------------------------------------------------
[State -3, AI起動用ヘルパー]
type = Helper
trigger1 = NumHelper(9500) = 0
trigger1 = RoundState = 2
trigger1 = alive
trigger1 = var(59) = 0
trigger1 = ctrl
helpertype = normal
name = "AI"
stateno = 9500
ID = 9500
pos = 0, 100
keyctrl = 1
pausemovetime = 65535
supermovetime = 65535
persistent = 0

[State -3, ステート固定]
type = ChangeState
trigger1 = IsHelper(9500)
trigger1 = StateNo != 9500
value = 9500


;---------------------------------------------------------------------------
; AI起動用
;---------------------------------------------------------------------------
[State -3, AI Start]
type = VarSet
triggerall = var(59) < 1
triggerall = RoundState < 2 || RoundState = 2 && ctrl
trigger1  = Command = "AI00"
trigger2  = Command = "AI01"
trigger3  = Command = "AI02"
trigger4  = Command = "AI03"
trigger5  = Command = "AI04"
trigger6  = Command = "AI05"
