triggerall = StateNo = 1200
triggerall = var(56) = 1
trigger1 = abs(P2BodyDist X) > 100

;===========================================================================
; 反応
;===========================================================================
[State -3, 成功改造シュルル爆破]
type = VarSet
var(57) = 1
triggerall = var(59) > 0
