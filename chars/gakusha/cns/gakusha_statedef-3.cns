;---------------------------------------------------------------------------
; 攻撃対象キャラクターのEnemyリダイレクト番号設定
;---------------------------------------------------------------------------
[State -3, 攻撃対象キャラクターのEnemyリダイレクト番号設定]
type = Null
triggerall = var(59) > 0 || fvar(39)
trigger1 = NumEnemy = 1
trigger1 = var(58) := 0
trigger2 = NumEnemy = 2
trigger2 = EnemyNear,Alive
trigger2 = var(58) := IfElse(EnemyNear, ID = Enemy(0), ID, 0, 1)
trigger3 = NumEnemy = 2
trigger3 = !EnemyNear, Alive
trigger3 = var(58) := IfElse(EnemyNear, ID = Enemy(0), ID, 1, 0)

;===========================================================================
; 切り返し
;===========================================================================
[State -3, 改造シュルル爆破]
type = VarSet
var(57) = 1
triggerall = var(59) > 0
triggerall = MoveType = H
triggerall = NumHelper(27020) > 0
triggerall = Random <= var(59) * 100
; 成功
trigger1 = Helper(27020),StateNo = 27022
trigger1 = abs(Enemy(var(58)),Pos X - Helper(27020),Pos X) <= 70
trigger1 = (Enemy(var(58)),Pos Y - Helper(27020),Pos Y) >= -70
; 大成功
trigger2 = Helper(27020),StateNo = 27023
trigger2 = abs(Enemy(var(58)),Pos X - Helper(27020),Pos X) <= 90
trigger2 = (Enemy(var(58)),Pos Y - Helper(27020),Pos Y) >= -90

[State -3, 位相変化 被弾中 後ろへ]
type = ChangeState
value = 1300
triggerall = var(59) > 0
triggerall = RoundState = 2
triggerall = alive
triggerall = Power >= 1000
triggerall = NumExplod(20500) = 0
triggerall = MoveType = H
trigger1 = Random <= var(59) * 10
trigger1 = P2BodyDist X > 0
trigger1 = BackEdgeDist > 120
trigger1 = StateNo = [5000,5170]

[State -3, 位相変化 被弾中 前へ]
type = ChangeState
value = 1310
triggerall = var(59) > 0
triggerall = RoundState = 2
triggerall = alive
triggerall = Power >= 1000
triggerall = NumExplod(20500) = 0
triggerall = MoveType = H
trigger1 = Random <= var(59) * 10
trigger1 = StateNo = [5000,5170]
trigger1 = P2BodyDist X < 50
trigger1 = BackEdgeDist <= 120

