;===========================================================================
; 超必殺技
;===========================================================================

;---------------------------------------------------------------------------
; ホウキスピン
;---------------------------------------------------------------------------
; 通常
[Statedef 2400]
type     = U
movetype = A
physics  = N
ctrl     = 0
anim     = 2400
velset   = 0, 0
facep2   = 0
hitdefpersist = 1
movehitpersist = 1
hitcountpersist = 1

[State 2400, クールタイムアイコン表示(1P側)]
type = Explod
trigger1 = Time = 0
trigger1 = var(4) = 1
trigger1 = var(5) = 0
ID = 21700
anim = 21700
pos = ceil(fvar(6) + 120), ceil(fvar(5) + 15)
postype = left
scale = 0.5, 0.5
bindtime = -1
sprpriority = 5
ownpal = 1

[State 2400, クールタイムアイコン表示(2P側)]
type = Explod
trigger1 = Time = 0
trigger1 = var(4) = 2
trigger1 = var(5) = 0
ID = 21700
anim = 21700
pos = ceil(-fvar(6) - 14), ceil(fvar(5) + 15)
postype = right
scale = 0.5, 0.5
bindtime = -1
sprpriority = 5
ownpal = 1

[State 2400, 開始エフェクト]
type = Explod
trigger1 = Time = 0
anim = 31300
pos = 0, 0
postype = p1
sprpriority = 1
ownpal = 1
supermovetime = 9999
scale = const(size.xscale) * 1, const(size.yscale) * 1

[State 2400, 暗転一時停止]
type = SuperPause
trigger1 = Time = 0
anim = -1
pos = 0, 0
sound = s8,24   ; とりあえず
time = 10
darken = 1
poweradd = -1000
unhittable = 0  ; 無敵なんてない

[State 2400, 場所移動]
type = PosAdd
trigger1 = AnimElemTime(3) = 0
x = 8 * const(size.xscale)
y = -45 * const(size.yscale)

[State 2400, 速度設定(ノーマル)]
type = VelSet
trigger1 = AnimElemTime(3) = 0
trigger1 = PrevStateNo != 101
x = 2
y = 4

[State 2400, 速度設定(ダッシュ)]
type = VelSet
trigger1 = AnimElemTime(3) = 0
trigger1 = PrevStateNo = [101,102]
x = 5
y = 1.2

[State 2400, やっほー]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
channel = 0
value = 2, 9

[State 2400, ホウキ音]
type = PlaySnd
trigger1 = AnimElemTime(3) > 2
trigger1 = (Time % 2) = 0
channel = 1
value = 7, 12

[State 2400, 回転エフェクト用ヘルパー呼び出し]
type = Helper
triggerall = (NumHelper(31301) = 0)
trigger1 = AnimElemTime(3) = 0
name = "BroomSpinEffect"
stateno = 31301
ID = 31301
pos = 0, 0
postype = p1
ownpal = 1
size.xscale = const(size.xscale) * 1
size.yscale = const(size.yscale) * 1
supermovetime = 99999999
pausemovetime = 99999999
ignoreHitPause = 1
Persistent = 0

[State 2400, 魔法ダメージ倍率 初期値設定]
type = VarSet
trigger1 = (Time % 6 = 0)
fvar(7) = 1

[State 2400, 魔法ダメージ倍率計算１ 古代の記憶]
type = VarAdd
trigger1 = (Time % 6 = 0)
trigger1 = var(2) <= fvar(10) ;古代の記憶効果時間中の場合
fvar(7) = 0.5

[State 2400, 魔法ダメージ倍率計算２ 古代の図書館]
type = VarAdd
trigger1 = (Time % 6 = 0)
trigger1 = var(2) <= fvar(11) ;古代の図書館効果時間中の場合
fvar(7) = 0.2

[State 2400, 魔法ダメージ倍率計算３ シュルル]
type = VarAdd
trigger1 = (Time % 6 = 0)
trigger1 = NumEnemy > 0
trigger1 = NumHelper(27020) > 0
trigger1 = (enemynear(0),ID = Helper(27020),var(38)) || (enemynear(0),ID = Helper(27020),var(39))
fvar(7) = 0.1

[State 2400, ダメージ計算 基本ダメージ] 
type = VarSet
trigger1 = (Time % 6 = 0)
fvar(2) = 15 ;基本ダメージ

[State 2400, ダメージ計算 倍率加算]
type = VarSet
trigger1 = (Time % 6 = 0)
fvar(2) = fvar(2) * fvar(7)

[State 2400, ヒット定義]
type = HitDef
trigger1 = (Time % 6 = 0)
attr = A, HA
animtype = Back
hitflag = MAFD
damage = ceil(fvar(2)), 0
guardflag = MA
pausetime = 4,10
guard.pausetime = 3,5
sparkno = s(IfElse(Random < 500, 30000, 30010))
guard.sparkno = s(IfElse(Facing = -1, 30021, 30020))
sparkxy = 0, 0
hitsound = s8, IfElse(Random < 334, 20, IfElse(Random < 500, 21, 22))
guardsound = s8, 3
ground.type = High
ground.slidetime = 20
guard.slidetime = 3
ground.hittime = 20
guard.hittime = 3
air.hittime = 20
guard.dist = 150
ground.velocity = (Vel X * -1), (Vel Y)
air.velocity = (Vel X * -1), (Vel Y)
airguard.velocity = -2, 0
air.fall = 1
fall = 1
fall.recovertime = 10
down.velocity = -1, -3


[State 2400, 2P感電付与]
type = VarSet
triggerall = Time % 6 = 0
triggerall = Target,ID = Enemy(0),ID
trigger1 = Random < fvar(22)
var(16) = var(2) + 180 ; ３秒

[State 2400, 4P感電付与]
type = VarSet
triggerall = Time % 6 = 0
triggerall = NumEnemy > 1
triggerall = Target,ID = Enemy(1),ID
trigger1 = Random < fvar(22)
var(17) = var(2) + 180 ; ３秒


[State 2400, 一定時間経過ステート変更]
type = ChangeState
trigger1 = Time >= 65
value = 2430

[State 2400, 着地時ステート変更]
type = ChangeState
trigger1 = Pos Y >= 0
value = 2450



