;---------------------------------------------------------------------------
; ヒット数補正処理
;---------------------------------------------------------------------------
[State -2, マイナス]
type = HitAdd
triggerall = NumHelper(9100) && var(25)
trigger1 = NumEnemy > 0
trigger1 = Enemy(0),MoveType != H
trigger2 = NumEnemy > 1
trigger2 = Enemy(0),Alive && Enemy(1),Alive
trigger2 = Enemy(0),MoveType != H
trigger2 = Enemy(1),MoveType != H
trigger3 = NumEnemy > 1
trigger3 = Enemy(0),Alive && !Enemy(1),Alive
trigger3 = Enemy(0),MoveType != H
trigger4 = NumEnemy > 1
trigger4 = !Enemy(0),Alive && Enemy(1),Alive
trigger4 = Enemy(1),MoveType != H
value = -var(25)
ignorehitpause = 1

[State -2, 変数初期化]
type = VarSet
triggerall = NumHelper(9100) && var(25)
trigger1 = NumEnemy > 0
trigger1 = Enemy(0),MoveType != H
trigger2 = NumEnemy > 1
trigger2 = Enemy(0),Alive && Enemy(1),Alive
trigger2 = Enemy(0),MoveType != H
trigger2 = Enemy(1),MoveType != H
trigger3 = NumEnemy > 1
trigger3 = Enemy(0),Alive && !Enemy(1),Alive
trigger3 = Enemy(0),MoveType != H
trigger4 = NumEnemy > 1
trigger4 = !Enemy(0),Alive && Enemy(1),Alive
trigger4 = Enemy(1),MoveType != H
var(25) = 0
ignorehitpause = 1

[State -2, プラス]
