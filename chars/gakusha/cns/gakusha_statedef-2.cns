;---------------------------------------------------------------------------
; ダメージ処理
;---------------------------------------------------------------------------
; 元ダメージを x
; オラシ状態を y (オラシありで1)
; 設置状態を   z (設置ありで1)
;  とすると
; 最終ダメージ = x(1 - 0.5z)(1 - 0.25y) - x
; とする
[State -2, ダメージ検出]
type			= VarSet
triggerall		= !IsHelper
triggerall		= !( RoundState = 0 && ((StateNo = [180, 189]) || StateNo = 5500 || StateNo = 5900) )
trigger1		= 1
var(30)			= var(31) - Life + (var(31) > LifeMax) * (LifeMax - var(31))
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State -2, 回復]
type			= LifeAdd
triggerall		= !IsHelper
triggerall		= !( RoundState = 0 && ((StateNo = [180, 189]) || StateNo = 5500 || StateNo = 5900) )
trigger1		= var(30) < 0
value			= -(var(30) * IfElse(var(30) > -1000, 100, 1)) + var(30)
absolute		= 1
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State -2, オラシでのゲージ減少] ; 現在ダメージ1につきパワー1減少
type			= PowerAdd
triggerall		= !IsHelper
triggerall		= !( RoundState = 0 && ((StateNo = [180, 189]) || StateNo = 5500 || StateNo = 5900) )
trigger1		= var(7) = 1
trigger1		= 0 < var(30)
value			= IfElse((0 < var(30)) && (var(30) < 1000), -var(30), floor(-var(30) / 100))
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State -2, ダメージ計算 設置減算]
type			= VarSet
triggerall		= !IsHelper
triggerall		= !( RoundState = 0 && ((StateNo = [180, 189]) || StateNo = 5500 || StateNo = 5900) )
trigger1		= 0 < var(30) && var(30) < 1000
trigger1		= var(9) = 1
var(30)			= ceil(var(30) * 0.5)
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State -2, ダメージ計算 オラシ減算]
type			= VarSet
triggerall		= !IsHelper
triggerall		= !( RoundState = 0 && ((StateNo = [180, 189]) || StateNo = 5500 || StateNo = 5900) )
trigger1		= 0 < var(30) && var(30) < 1000
trigger1		= var(7) = 1
var(30)			= ceil(var(30) * 0.75)
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State -2, ダメージ計算 雨デバフ減算]
type			= VarSet
triggerall		= !IsHelper
triggerall		= !( RoundState = 0 && ((StateNo = [180, 189]) || StateNo = 5500 || StateNo = 5900) )
trigger1		= 0 < var(30) && var(30) < 1000
trigger1		= (var(2) < var(26)) || (var(2) < var(27))
var(30)			= ceil(var(30) * 0.95)
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State -2, ダメージ計算 基本倍率]
