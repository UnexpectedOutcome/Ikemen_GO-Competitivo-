value			= -(var(30) - (var(31) - Life + (var(31) > LifeMax) * (LifeMax - var(31))))
absolute		= 1
ignorehitpause	= 1
pausemovetime	= 99999999999876543210
supermovetime	= 99999999999876543210

[State -2, 現在ライフ 設定]
