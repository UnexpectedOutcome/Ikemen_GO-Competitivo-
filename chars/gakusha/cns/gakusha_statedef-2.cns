;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
text = "Cancel=%d, Throw=%d, Button=%d, Body-Distance X=%d,Y=%d \n"
params = var(1),var(2),var(5),floor(P2BodyDist X),floor(P2BodyDist Y)

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "Position X=%d,Y=%d, Velocity X=%f,Y=%f, Hit=%d \n"
params = floor(Pos X),floor(Pos Y),(Vel X),(Vel Y),(MoveHit)

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "fv10=%f, v5=%d, v1=%d \n"
params = fvar(10), var(5), var(1)


;---------------------------------------------------------------------------
;獣を焦がす(黒秋葉)　相手ステータス変化
[State -2]
Type = LifeAdd
trigger1 = NumEnemy > 0
Trigger1 = Enemy(0),AuthorName = "tukemon&HAL" && Enemy(0),Name = "Akiha"
Trigger1 = Enemy(0),Var(56) = 1
trigger2 = NumEnemy > 1
Trigger2 = Enemy(1),AuthorName = "tukemon&HAL" && Enemy(1),Name = "Akiha"
Trigger2 = Enemy(1),Var(56) = 1
Value = -8
Kill = 0

[State -2]
Type = PowerAdd
trigger1 = NumEnemy > 0
Trigger1 = Enemy(0),AuthorName = "tukemon&HAL" && Enemy(0),Name = "Akiha"
Trigger1 = Enemy(0),Var(51)%10 = 2
Trigger1 = Enemy(0),Var(56) = 1
trigger2 = NumEnemy > 1
Trigger2 = Enemy(1),AuthorName = "tukemon&HAL" && Enemy(1),Name = "Akiha"
Trigger2 = Enemy(1),Var(51)%10 = 2
Trigger2 = Enemy(1),Var(56) = 1
Value = -33

;---------------------------------------------------------------------------
; ラウンド経過時間
;---------------------------------------------------------------------------
[State -2, ラウンド経過時間加算]
type = VarAdd
trigger1 = RoundState = 2
var(2) = 1


;---------------------------------------------------------------------------
; 食らいボイス再生
;---------------------------------------------------------------------------
[State -2, 食らい時声]
type = PlaySnd
triggerall = Time = 0
triggerall = !IsHelper
trigger1 = stateno = [5000,5199]
value = 0, IfElse(Random < 350, 12, IfElse(Random < 350, 13, 14)) ;確率はかなりテキトー

;---------------------------------------------------------------------------
; 「オーラシールド」時に音を鳴らす
;---------------------------------------------------------------------------
[State -2, オーラシールド音を鳴らす]
type = PlaySnd
triggerall = (var(2) % 44) = 3
triggerall = alive
triggerall = RoundState = 2
triggerall = StateNo != 5900
trigger1 = var(7) = 1
channel = 5
value = 6, 5

;---------------------------------------------------------------------------
; 「ショータイム」時に音を鳴らす
;---------------------------------------------------------------------------
[State -2, ショータイム音を鳴らす]
type = PlaySnd
triggerall = (var(2) % 115) = 3
triggerall = alive
triggerall = RoundState = 2
triggerall = StateNo != 5900
trigger1 = var(2) <= fvar(19)
channel = 6
value = 6, 6


;---------------------------------------------------------------------------
; 「成功の予感」エフェクト表示
;---------------------------------------------------------------------------
[State -2, 成功の予感 エフェクト1]
type = Explod
triggerall = PalNo > 6
triggerall = NumExplod(26060) = 0
triggerall = Alive
trigger1 = fvar(9) > var(2)
anim = 26060
ID = 26060
pos = ceil(-30 * const(size.xscale)), ceil(-100 * const(size.yscale))
postype = p1
sprpriority = 1
scale = const(size.xscale), const(size.yscale)
ignorehitpause = 1
bindtime = -1
removetime = -1
ownpal = 1

[State -2, 成功の予感 エフェクト2]
type = Explod
triggerall = PalNo > 6
triggerall = NumExplod(26060) <= 1
triggerall = Alive
trigger1 = fvar(9) > var(2)
anim = 26061
ID = 26060
pos = ceil(-30 * const(size.xscale)), ceil(-100 * const(size.yscale))
postype = p1
sprpriority = 1
scale = const(size.xscale), const(size.yscale)
ignorehitpause = 1
bindtime = -1
removetime = -1
ownpal = 1

[State -2, 成功の予感 エフェクト削除]
type = RemoveExplod
triggerall = PalNo > 6
triggerall = NumExplod(26060) > 0
trigger1 = fvar(9) <= var(2)
trigger2 = !Alive
ID = 26060


;---------------------------------------------------------------------------
; 「スイートキャンディーバー」時に音を鳴らす
;---------------------------------------------------------------------------
[State -2, キャンディ音を鳴らす]
type = PlaySnd
triggerall = (var(2) % 131) = 3
triggerall = alive
trigger1 = var(2) <= fvar(16)
channel = 4
value = 7, 18

;---------------------------------------------------------------------------
; 気絶時星表示
;---------------------------------------------------------------------------
[State -2, 気絶時の星]
type = Explod
trigger1 = Anim = 5300
trigger1 = (Time % 13) = 0
anim = 30120
ID = 30120
pos = ceil(-10 * const(size.xscale)), ceil(-90 * const(size.yscale))
postype = p1
sprpriority = -1
scale = const(size.xscale), const(size.yscale)
ignorehitpause = 1

[State -2, 気絶時の星]
type = Explod
trigger1 = Anim = 5300
trigger1 = (Time % 13) = 0
anim = 30121
ID = 30120
pos = ceil(-10 * const(size.xscale)), ceil(-90 * const(size.yscale))
postype = p1
sprpriority = 1
scale = const(size.xscale), const(size.yscale)
ignorehitpause = 1

[State -2, 気絶時の音]
type = PlaySnd
trigger1 = alive
trigger1 = NumExplod(30120) > 0
trigger1 = (Time % 60) = 0
channel = 1
value = 8, 15

[State -2, 気絶時の星削除]
type = RemoveExplod
trigger1 = Anim != 5300
trigger1 = !alive
ID = 30120

;---------------------------------------------------------------------------
; MAtkUpバフ効果表示
;---------------------------------------------------------------------------
[State -2, MatkUp表示裏]
type = Explod
triggerall = (var(2) < fvar(10)) || (var(2) < fvar(11))
triggerall = alive
triggerall = RoundState = 2
triggerall = StateNo != 5900
trigger1 = (var(2) % 30) = 3
anim = 26020
pos = ceil(0 * const(size.xscale)), ceil(-30 * const(size.yscale))
postype = p1
random = 60, 50
sprpriority = -1
ownpal = 1
vel = 0, -2
scale = const(size.xscale) * 0.7, const(size.yscale) * 0.7

[State -2, MatkUp表示表]
type = Explod
triggerall = (var(2) < fvar(10)) || (var(2) < fvar(11))
triggerall = alive
triggerall = RoundState = 2
triggerall = StateNo != 5900
trigger1 = (var(2) % 33) = 3
anim = 26020
pos = ceil(0 * const(size.xscale)), ceil(-30 * const(size.yscale))
postype = p1
random = 60, 50
sprpriority = 3
ownpal = 1
vel = 0, -2
scale = const(size.xscale) * 0.7, const(size.yscale) * 0.7


;---------------------------------------------------------------------------
; 雨デバフ効果表示
;---------------------------------------------------------------------------
; 2P
[State -2, 雨デバフ]
type = Explod
triggerall = NumEnemy > 0
triggerall = var(2) < var(26)
triggerall = Enemy(0),alive
triggerall = alive
triggerall = RoundState = 2
triggerall = StateNo != 5900
trigger1 = (var(2) % 15) = 3
anim = 26050
pos = Enemy(0),ScreenPos X + ceil(0 * const(size.xscale)), Enemy(0),ScreenPos Y + ceil(-60 * const(size.yscale))
postype = left
random = 60, 30
sprpriority = 3
ownpal = 1
vel = 0, 2
scale = const(size.xscale) * 0.7, const(size.yscale) * 0.7

; 4P
[State -2, 雨デバフ]
type = Explod
triggerall = var(2) < var(27)
triggerall = NumEnemy > 1
triggerall = Enemy(1),alive
triggerall = alive
triggerall = RoundState = 2
triggerall = StateNo != 5900
trigger1 = (var(2) % 15) = 3
anim = 26050
pos = Enemy(1),ScreenPos X + ceil(0 * const(size.xscale)), Enemy(1),ScreenPos Y + ceil(-60 * const(size.yscale))
postype = left
random = 60, 30
sprpriority = 3
ownpal = 1
vel = 0, 2
scale = const(size.xscale) * 0.7, const(size.yscale) * 0.7




;---------------------------------------------------------------------------
; MP回復（ゲージUp）バフ効果表示
;---------------------------------------------------------------------------
[State -2, ゲージUp]
type = PowerAdd
triggerall = var(2) < fvar(11)
triggerall = alive
triggerall = RoundState = 2
triggerall = StateNo != 5900
trigger1 = (var(2) % 2) = 0
value = 3

[State -2, MP回復星裏]
type = Explod
triggerall = var(2) < fvar(11)
triggerall = alive
triggerall = RoundState = 2
triggerall = StateNo != 5900
trigger1 = (var(2) % 30) = 3
anim = 26030
pos = ceil(0 * const(size.xscale)), ceil(-30 * const(size.yscale))
postype = p1
random = 60, 50
sprpriority = -1
ownpal = 1
vel = sin(2 * pi * GameTime / 36), -2
scale = const(size.xscale) * 0.5, const(size.yscale) * 0.5

[State -2, MP回復星表]
type = Explod
triggerall = var(2) < fvar(11)
triggerall = alive
triggerall = RoundState = 2
triggerall = StateNo != 5900
trigger1 = (var(2) % 33) = 3
anim = 26030
pos = ceil(0 * const(size.xscale)), ceil(-30 * const(size.yscale))
