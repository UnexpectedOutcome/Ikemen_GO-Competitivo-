
[Data]
life              = 920   ;体力ゲージの最大値を決めます
power             = 5000  ;パワーゲージ最大値（デフォルトは 3000 = Lv.3 になります・オプション）
attack            = 100   ;攻撃力パーセンテージ（デフォルトは 100% になります）
defence           = 100   ;防御力パーセンテージ（デフォルトは 100% になります）
fall.defence_up   = 75    ;一時的に上昇するダウン時の防御力パーセンテージ
liedown.time      = 30    ;倒れてから起き上がるまでの時間
airjuggle         = 99    ;ジャグルポイント限界値　★１
sparkno           = 2     ;デフォルトのヒットスパーク番号（fightfx.airか、キャラのairから呼び出す）
guard.sparkno     = 40    ;デフォルトのガードスパーク番号（fightfx.airか、キャラのairから呼び出す）
KO.echo           = 0     ;ＫＯ時の声にエコーを掛けるかどうか（0=しない・1=する）
volume            = 100   ;キャラの音量　255が最高
intpersistindex   = 20    ;Varを次のラウンドへ持ち越しが可能 (最小=0, 最大=59)  ★２
floatpersistindex = 25    ;FVarを次のラウンドへ持ち越しが可能 (最小=0, 最大=39) ★２

;---------------------------------------------------------------------------
;サイズ設定
[Size]
xscale           = 0.5        ;キャラ画像の横のスケール
yscale           = 0.5        ;キャラ画像の縦のスケール
ground.back      = 14       ;キャラの幅（地上後方）
ground.front     = 14       ;キャラの幅（地上前方）
air.back         = 14       ;キャラの幅（空中後方）
air.front        = 14       ;キャラの幅（空中前方）
height           = 60       ;跳び越す相手のためのキャラの高さ
attack.dist      = 160      ;攻撃を出した時に相手がガード体勢に入る最低の距離
proj.attack.dist = 90       ;相手がガード体勢に入る発射物との最低の距離
proj.doscale     = 0        ;xscaleとyscaleが発射物のスケールにも影響するかどうか（0=しない・1=する）
head.pos         = -5, -100  ;BindToTargetの時に必要な頭の座標
mid.pos          = -5, -78  ;BindToTargetの時に必要な体中心の座標
shadowoffset     = 0        ;影の垂直方向の位置
draw.offset      = 0,0      ;キャラ描画表示位置（Ｘ軸,Ｙ軸）

;---------------------------------------------------------------------------
;移動速度設定
[Velocity]
walk.fwd     = 3.6       ;前進歩行速度
walk.back    = -2.7        ;後退歩行速度
run.fwd      = 6.9        ;前に走る時の速度（Ｘ軸,Ｙ軸）
run.back     = -6.5        ;後ろに走る時の速度（Ｘ軸,Ｙ軸）
jump.neu     = 0,-7.8      ;垂直ジャンプ速度（Ｘ軸,Ｙ軸）
jump.back    = -2.6       ;後ジャンプ速度
jump.fwd     = 3.0         ;前ジャンプ速度
runjump.back = -6.5   ;後ろに走りながらのジャンプ速度（オプション）
runjump.fwd  = 7.2      ;前に走りながらのジャンプ速度（オプション）
airjump.neu  = 0,-9.1       ;空中垂直ジャンプ速度（オプション）
airjump.back = -2.8          ;空中後ジャンプ速度（オプション）
airjump.fwd  = 2.1        ;空中前ジャンプ速度（オプション）

;---------------------------------------------------------------------------
