; 時間停止ヘルパー1
[Statedef 8000]
type     = A
movetype = I
physics  = N
velset   = 0,0
anim     = 8000
ctrl     = 0

[State 8000, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2 = noshadow

[State 8000, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 8000,bindtoroot]
type = bindtoroot
trigger1 = 1
facing = 1

[State 8000, varset]
type = parentvarset
triggerall = root,var(59) = 0
triggerall = roundstate = 2 && root,alive && ishelper
triggerall = root,var(10) <= 0
triggerall = root,fvar(25) >= 0.5
triggerall = command = "pause"
trigger1 = root,ctrl
trigger2 = root,movetype = H
trigger3 = root,statetype = L
trigger4 = root,movetype != A
trigger4 = root,var(8) < gametime
trigger5 = root,stateno = 102 || root,stateno = 107
trigger5 = root,time >= 5
var(10) = 121

[State 8000, varset_AI1]
type = parentvarset
triggerall = root,var(59) >= 1
triggerall = roundstate = 2 && root,alive && ishelper
triggerall = root,var(10) <= 0
triggerall = root,fvar(25) >= 0.5
triggerall = root,ctrl || (root,stateno = 102 || root,stateno = 107) && root,time >= 5
Triggerall = numhelper(887700)
Triggerall = helper(887700),var(1) = 0
Triggerall = EnemyNear(root,var(1)),statetype != A
Trigger1 = !EnemyNear(root,var(1)),ctrl
Trigger1 = inguarddist
Trigger2 = !EnemyNear(root,var(1)),stateno <= 699
Trigger2 = EnemyNear(root,var(1)),movetype = A
var(10) = 121

[State 8000, varset_AI2]
type = parentvarset
triggerall = root,var(59) >= 1
triggerall = roundstate = 2 && root,alive && ishelper
triggerall = root,var(10) <= 0
triggerall = root,fvar(25) >= 0.5
trigger1 = root,movetype = H
trigger1 = root,life <= root,lifemax/4 || (root,palno = [11,12])
trigger2 = root,movetype != A
trigger2 = root,var(8) < gametime
trigger2 = root,life <= root,lifemax/4 || (root,palno = [11,12])
var(10) = 121


[State 8000, DestroySelf]
type = DestroySelf
trigger1 = !root,alive

