;==============================================================================
;******************************* PlayerIDAdd ******************************
;==============================================================================
;PlayerIDを取得する為のヘルパー
;------------------------------------------------------------------------------
[Statedef 886600]
anim     = 8000
[STATE PlayerIDSet]
type=ParentVarSet
trigger1=Parent,ID=Helper(887700),ID
var(6)=ID
[state ]
type=DestroySelf
trigger1=1
;/Destroy
;==============================================================================
;******************************* AIヘルパー *******************************
;==============================================================================
;めくり対策とヘルパー監視、超必殺判定を兼ねるAI用ヘルパーを呼び出す
;------------------------------------------------------------------------------
; 0 超必殺判定(Enemy,Power)
; 1 超必殺判定
; 2 AI開始/0
; 3 ヘルパー監視(Enemy,NumHelper)
; 4 ヘルパー監視(トリガ)
; 5 ヘルパー監視(loop用)
; 6 ヘルパー監視(現在最大PlayerID)
; 7 ヘルパー監視(前回より増加したHelperの数)
; 11-20 ヘルパー監視(PlayerID)
; 21-30 ヘルパー監視(マーキング)
; 50 ヘルパー監視(飛び道具監視、飛び道具1こめ)
; 51 ヘルパー監視(飛び道具監視、飛び道具2こめ)
; 52 ヘルパー監視(落下飛び道具警戒)
; 53 ヘルパー監視(設置近距離警戒)
; 54 ヘルパー監視(設置遠距離警戒)
;
;------------------------------------------------------------------------------
[Statedef 887700]
type = S
movetype = I
physics = N
ctrl = 0
velset = 0,0
anim     = 8000
sprpriority = -1
;------------------------------------------------------------------------------
[STATE AI開始]
type = VarSet
trigger1 = 1
var(2) = 0
persistent=0
[STATE AI開始]
type = VarAdd
trigger1 = RoundState=2
var(2) = 1
[STATE AI開始]
type = ChangeState
trigger1 = var(2)>40
value = 887701	 ;40フレームあれば相手の常時監視ヘルパーは起動してる
;------------------------------------------------------------------------------
[Statedef 887701]
anim     = 8000
;------------------------------------------------------------------------------
; 処理
[STATE BtR]
type = BindToRoot
trigger1 = 1
time = 100000
pos = 0,0
[STATE Turn]	;めくり対策にROOTと逆を向かせ、本体の後ろ側のInGuardDistを取得する
type = Turn
trigger1 = facing=root,facing	;BtRのfacingは内部的な向きは変わらないらし
[STATE 非表示]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2= noshadow
[STATE 無敵化]
type = NOTHITBY
trigger1 = 1
value = SCA
time = 999999
[STATE 0]
type = VarSet
trigger1 = 1
var(2) = 0
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; AI - 超必殺判定
;------------------------------------------------------------------------------
[STATE 超必殺判定]
type = VarSet
triggerall = Time
trigger1 = var(0)>enemy,power
var(1) = floor((var(0)-enemy,power)*0.001)
[STATE 超必殺判定(リセット)]
type = VarSet
triggerall = Time
trigger1 = enemynear,movetype=H
trigger2 = enemynear,stateno=[0,105]
trigger3 = enemynear,stateno=[120,155]
trigger4 = enemynear,stateno=[5000,5210]
var(1) = 0
[STATE ENEMY,POWER]
type = VarSet
trigger1 = Time
var(0) = enemynear,power
;/超必殺判定
