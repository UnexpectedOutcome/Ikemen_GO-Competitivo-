;----------------------------------------------------------------------------
;ハイジャンプ
;----------------------------------------------------------------------------
;コマンドを入れたらVarをON
[State -2, jump1] 
type = VarSet
triggerall = var(59) = 0
trigger1 = command = "jump"
trigger1 = ctrl
trigger1 = statetype = S
v = 3
value = 1

;sysvarを引継ぐ
[State -2, jump2]
type = VarSet
trigger1 = Var(3) = 1
trigger1 = stateno = 40 ;ジャンプする前のステート
trigger1 = AnimTime = 0 ;ジャンプ方向を決めるsysvarがリセットされる寸前
var(3) = ifelse(sysvar(1)=0, 2, ifelse(sysvar(1)=1, 3, 4))

;varをOFFにする
[State -2, jump3]
type = VarSet
triggerall = Time = 2
trigger1 = stateno = 50
trigger2 = stateno != [40,59]
v = 3
value = 0

;前にボタンを押してたら前にも加速
[State -2, jump4]
type = VelAdd
trigger1 = var(3) = 3
trigger1 = stateno = 50
x = 0.8

;後ろなら後ろに加速
[State -2, jump5]
type = VelAdd
trigger1 = var(3) = 4
trigger1 = stateno = 50
x = -1

;垂直ジャンプにveladdを使って上に加速
[State -2, jump6a]
type = VelAdd
trigger1 = var(3) = 2
trigger1 = stateno = 50
y = -2.9

;斜めジャンプにveladdを使って上に加速
[State -2, jump6b]
type = VelAdd
trigger1 = var(3) = 3 || var(3) = 4
trigger1 = stateno = 50
y = -2.7

;垂直ジャンプ時、水平方向０
[State -3, jump7]
type = VelSet
trigger1 = var(3) = 2
trigger1 = stateno = 50
x = 0

;垂直ジャンプ時、アニメ強制41
