

[Statedef -2]

;――――――――――――――――――――――――――――――――――――――――――――――――――――





;火力調節   attack adjustment
[State -2, varset9]
type = varset
trigger1 = roundstate != 2
var(7) = 6
;        ↑この数値を変更することで火力が調節できます（1=10%,10=100%,100=1000%,Feel free.）







;パワー取得量調節  getpower adjustment
[State -2, varset12]
type = varset
trigger1 = roundstate != 2
var(12) = 4
;        ↑この数値を変更することでパワー取得量が調節できます（1=10%,10=100%,100=1000%,Feel free.）













;――――――――――――――――――――――――――――――――――――――――――――――――――――







;----------------------------------------------------------------------------
;時間停止
;----------------------------------------------------------------------------
[State -2, varset]
type = varset
trigger1 = var(10) < 0
var(10) = 0
ignorehitpause = 1

[State -2, varadd]
type = varadd
triggerall = var(10) > 0
trigger1 = stateno != 18119
trigger1 = stateno != 850
trigger1 = stateno != [3000,3001]
trigger1 = stateno != [3100,3101]
var(10) = -1
ignorehitpause = 1

[State -2, varset]
type = varset
trigger1 = var(10) > 0
fvar(25) = 0

[State -2, Pause]
type = Pause
trigger1 = var(10) > 0
time = 3
movetime = 3
ignorehitpause = 1

[State 18119, 3]
type = NotHitBy
trigger1 = var(10) > 0
value2 = SCA
time = 3
ignorehitpause = 1

[State -2, helper8000]
type = helper
trigger1 = !ishelper
trigger1 = numhelper(8000) = 0
trigger1 = roundstate = 2 && alive
helpertype = normal
name = "8000"
ID = 8000
pos = 0,0
postype = p1
facing = 1
stateno = 8000
keyctrl = 1
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1

[State -2, helper8001]
type = helper
triggerall = !ishelper
triggerall = numhelper(8001) = 0
triggerall = roundstate = 2 && alive
trigger1 = var(10) = 120
trigger2 = stateno = 18119
helpertype = normal
name = "8001"
ID = 8001
pos = 0,0
postype = p1
facing = 1
stateno = 8001
keyctrl = 0
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1

[State -2, change18119]
type = SelfState
triggerall = roundstate = 2 && alive && !ishelper
triggerall = var(10) > 0
triggerall = stateno != [0,160]
triggerall = stateno != 18119
trigger1 = movetype = H
trigger1 = stateno != [150,160]
trigger2 = statetype = L
trigger3 = movetype != A
trigger3 = var(8) < gametime
value = 18119
ignorehitpause = 1

;----------------------------------------------------------------------------
;時間停止用変数 fvar(25)
;----------------------------------------------------------------------------
[state -2, varset]
type = varset
triggerall = roundstate = 2 && alive
triggerall = var(10) <= 0
trigger1 = fvar(25) < 0.05
fvar(25) = 0.05
ignorehitpause = 1

[State -2, varadd]
type = varadd
triggerall = alive
triggerall = var(10) <= 0
triggerall = fvar(25) < 0.5
triggerall = life < var(11)
trigger1 = stateno != [150,160]
trigger2 = var(8) < gametime
fvar(25) = (var(11)-life)*((gethitvar(hitcount))+1)*0.0000894
ignorehitpause = 1

[State -2, varadd]
type = varadd
triggerall = stateno = [150,160]
triggerall = alive
triggerall = var(10) <= 0
trigger1 = fvar(25) < 0.5
fvar(25) = 0.0005
ignorehitpause = 1

[state -2, varadd]
type = varadd
triggerall = roundstate = 2 && alive
triggerall = var(10) <= 0
trigger1 = ceil(100*life/lifemax) <= 30
trigger1 = fvar(25) < 0.5
fvar(25) = 0.00015+((palno = 12)*0.003)
ignorehitpause = 1

[state -2, varadd]
type = varadd
triggerall = roundstate = 2 && alive
triggerall = var(10) <= 0
triggerall = ceil(100*life/lifemax) = [31,60]
trigger1 = fvar(25) < 0.5
fvar(25) = 0.0001+((palno = 12)*0.0015)
ignorehitpause = 1

[state -2, varadd]
type = varadd
triggerall = roundstate = 2 && alive
triggerall = var(10) <= 0
trigger1 = ceil(100*life/lifemax) >= 61
trigger1 = fvar(25) < 0.5
fvar(25) = 0.00005+((palno = 12)*0.00075)
ignorehitpause = 1

;----------------------------------------------------------------------------
;時間停止ゲージ
;----------------------------------------------------------------------------

[State -2, RemoveExplod6502]
type = RemoveExplod
triggerall = NumExplod(6502) > 0
trigger1 = fvar(25) >= 0.5
ID = 6502
ignorehitpause = 1

[State -2, ModifyExplod6502]
type = ModifyExplod
trigger1 = NumExplod(6502) > 0
ID = 6502
scale = fvar(25), 0.5
supermovetime = 100000
pausemovetime = 100000
ignorehitpause = 1

[State -2, RemoveExplod6503]
type = RemoveExplod
triggerall = NumExplod(6503) > 0
trigger1 = fvar(25) < 0.5
ID = 6503
ignorehitpause = 1

