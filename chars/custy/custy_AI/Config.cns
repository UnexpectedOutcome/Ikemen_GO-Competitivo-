;----------------------------------------------------------------------------
;フラッシュ　カウンター移行
;----------------------------------------------------------------------------
[State 1000, ChangeState]
type = SelfState
trigger1 = stateno != [1010,1011]
trigger1 = numhelper(1000) >= 1
trigger1 = helper(1000),stateno = 1008
value = 1010
ctrl = 0

;----------------------------------------------------------------------------
;特殊カラー
;----------------------------------------------------------------------------
[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = palno = [11,12]
trigger1 = Life = LifeMax
trigger1 = movetype != A
trigger1 = NumProjID(1500) = 0
trigger1 = NumProjID(3300) = 0
flag = NOKO
ignorehitpause = 1

[state -2, lifeaddt_pal11]
type = lifeadd
triggerall = palno = 11
triggerall = alive
trigger1 = life < var(11)
value = ceil((var(11) - life) * 0.66)
ignorehitpause = 1

[state -2, lifeaddt_pal12]
type = lifeadd
triggerall = palno = 12
triggerall = alive
trigger1 = life < var(11)
value = ceil((var(11) - life) * 0.8)
ignorehitpause = 1

[State -2, DefenceMulSet_pal11]
type = DefenceMulSet
trigger1 = palno = 11
value = 0.33
ignorehitpause = 1

[State -2, DefenceMulSet_pal12]
type = DefenceMulSet
trigger1 = palno = 12
value = 0.2
ignorehitpause = 1

[State -2, PowerMax]
type = PowerAdd
trigger1 = palno = [11,12]
value = 1000
ignorehitpause = 1

;----------------------------------------------------------------------------
;火力補正
;----------------------------------------------------------------------------
[State -2, varset]
type = varset
trigger1 = 1
fvar(2) = var(7)*0.1*(1+((palno = 12)*7))
ignorehitpause = 1

[State -2, AttackMulSet]
type = AttackMulSet
trigger1 = 1
value = fvar(2)
ignorehitpause = 1

;----------------------------------------------------------------------------
;一番近くの相手
;----------------------------------------------------------------------------
[State -2, enemynear]
type = VarSet
triggerall = roundstate = 2 && !ishelper && alive
trigger1 = numenemy > 1
var(1) = !enemynear,alive
ignorehitpause = 1

;----------------------------------------------------------------------------
;ダメージ計算補助
;----------------------------------------------------------------------------

[State -2, 変数]
type = varset
triggerall = roundstate = 2 && !ishelper && alive
trigger1 = enemynear(var(1)),lifemax * enemynear(var(1)),const(data.defence) > 100000
var(0) = ceil(enemynear(var(1)),lifemax * enemynear(var(1)),const(data.defence) * 0.01)
ignorehitpause = 1

[State -2, 変数]
type = varset
triggerall = roundstate = 2 && !ishelper && alive
trigger1 = enemynear(var(1)),lifemax * enemynear(var(1)),const(data.defence) <= 100000
var(0) = 1000
ignorehitpause = 1

;----------------------------------------------------------------------------
;ダメージ補正
;----------------------------------------------------------------------------

[State -2, Proj1500]
Type = VarSet
Trigger1 = ProjhitTime(1500) = 1
fvar(0) = FVar(0) * 0.8
IgnoreHitPause = 1
persistent = 0

[State -2, Proj3300]
Type = VarSet
Trigger1 = ProjhitTime(3300) = 1
fvar(0) = FVar(0) * 0.9
IgnoreHitPause = 1
persistent = 0

[State -2, VarSet]
Type           = VarSet
TriggerAll     = NumEnemy     > 0
Trigger1       = FVar(0)     != 1.00
Trigger1       = !(P2MoveType = H && (P2StateNo != [150,159]))
FV             = 0
Value          = 1.00
IgnoreHitPause = 1
Persistent     = 1

[State -2, VarSet]
Type           = VarSet
Trigger1       = FVar(0) < 0.01
FV             = 0
Value          = 0.01
IgnoreHitPause = 1
Persistent     = 1

;----------------------------------------------------------------------------
;空中ヒット制限
;----------------------------------------------------------------------------
[State -2, VarSet]
type = VarSet
TriggerAll = NumEnemy > 0
TriggerAll = var(2) > 0
Trigger1 = !(P2MoveType = H && (P2StateNo != [150,155]))
Trigger2 = P2statetype != A
Trigger3 = var(10) > 0
var(2) = 0
IgnoreHitPause = 1

;----------------------------------------------------------------------------
;空中ジャンプ
;----------------------------------------------------------------------------
[State -2, varをOFFにするステート]
type = Varadd
triggerall = var(59) = 0
trigger1 = var(4) > 0
trigger1 = command != "holdup"
var(4) = -1

[State -2, varをOFFにするステート]
type = VarSet
triggerall = var(5) > 0
triggerall = stateno != [40,50]
trigger1 = statetype = S
trigger2 = statetype = C
var(5) = 0

;----------------------------------------------------------------------------
;空中ダッシュ制動
;----------------------------------------------------------------------------
[State -2, VarSet]
type = VarSet
trigger1 = fvar(1) > 30
trigger2 = statetype != A
trigger3 = movetype = H
fvar(1) = 0

[State -2, VarSet]
type = Varadd
trigger1 = fvar(1) >= 1
fvar(1) = 1

[State -2, velmul]
type = velmul
triggerall = statetype = A
triggerall = movetype != H
trigger1 = vel x > 0
trigger1 = fvar(1) = 20
trigger2 = vel x < 0
trigger2 = fvar(1) = 16
x = 0.51

[State -2, velset]
type = velset
triggerall = stateno = [600,640]
trigger1 = vel x > 0
trigger1 = fvar(1) = [1,22]
trigger2 = vel x < 0
trigger2 = fvar(1) = [1,18]
y = 0

;----------------------------------------------------------------------------
;var(6) P2bodydist Y
;----------------------------------------------------------------------------
[State -2, VarSet]
type = VarSet
trigger1 = 1
var(6) = ceil(P2bodydist Y)

;----------------------------------------------------------------------------
;RemoveExplod
;----------------------------------------------------------------------------

[State -2, RemoveExplod1100]
type = RemoveExplod
triggerall = NumExplod(1100) > 0
trigger1 = stateno != 1100
ID = 1100

;----------------------------------------------------------------------------
;RemoveAfterImage
;----------------------------------------------------------------------------
[State -2, AfterImageTime]
type = AfterImageTime
trigger1 = movetype = H
trigger2 = statetype = L
trigger3 = !alive
trigger4 = stateno = 45 || stateno = 52 || stateno = 102 || stateno = 107
trigger5 = stateno = 700 && ceil(pos y) > 0
trigger6 = statetype = A
trigger6 = vel y > 0
trigger6 = ceil(pos y) > -25
time = 0

;----------------------------------------------------------------------------
;Turn Mode二人目以降のイントロ
;----------------------------------------------------------------------------
[State -2, 二人目のイントロ]
type = ChangeState             ;二人目でもイントロを作る
value = 190                    ;イントロへ
triggerall = RoundsExisted = 0 ;自分が初参戦時
triggerall = TeamMode = Turns  ;ターンモード
triggerall = time > 0
trigger1 = stateno = 5900      ;5900番

[State -2, 勝利バグ解消]
type = CtrlSet                 ;歩きバグ対策
trigger1 = RoundState = 4      ;勝利ポーズ時
trigger1 = Win && Ctrl = 1     ;動ける場合
value = 0                      ;制御不能に


;----------------------------------------------------------------------------
;未完成な相手キャラによって、不具合が起きても自己解決するシステム(仮)
;----------------------------------------------------------------------------

[State -2, Y座標自己修復]
type = PosSet
TriggerAll = RoundState = 2
Trigger1 = stateno = [10,12]      ;立ち＆屈み時
Trigger1 = floor(Pos Y) = [-2,3] ;立ち位置が僅かにずれていたらすぐ修正
y = 0

[State -2, Y座標自動修正]
type = PosAdd
TriggerAll = RoundState = 2
TriggerAll = Life < LifeMax  ;トレーニングでCtrl+Iを使うときに配慮
Trigger1 = stateno = [0,30]  ;歩きも含める
Trigger1 = floor(Pos Y) < -2 ;立ち位置が大きくずれていたら移動する
y = 2

[State -2, Y座標自動修正]
type = PosAdd
TriggerAll = RoundState = 2
TriggerAll = Life < LifeMax
Trigger1 = stateno = [0,30]
Trigger1 = floor(Pos Y) > 2 ;同じく
y = -2

