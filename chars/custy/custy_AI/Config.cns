;----------------------------------------------------------------------------
;PlaySnd色々
;----------------------------------------------------------------------------

[State -2, PlaySnd1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
value = 52, 0

[State -2, PlaySnd]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = [40,43]
trigger1 = var(3) = 0
trigger1 = !(prevstateno = 100 && sysvar(1) = 1)
value = 40, 0

[State -2, PlaySnd]
type = PlaySnd
triggerall = Time = 1
triggerall = stateno = [40,43]
trigger1 = var(3) >= 1
trigger2 = prevstateno = 100 ;RUN_FWD
trigger2 = sysvar(1) = 1
value = 40, 1

[State -2, PlaySnd]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 45
value = 40, 0

[State -2, PlaySnd]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 105;バクステ開始
value = 105, 0

;----------------------------------------------------------------------------
[State -2, varset];ダメージボイスvarset
type = varset
trigger1 = var(13) < 0
var(13) = 0
ignorehitpause = 1

[State -2, varadd];ダメージボイスvaradd
type = varadd
trigger1 = var(13) != 5150
trigger1 = var(13) > 0
var(13) = -1
ignorehitpause = 1

;----------------------------------------------------------------------------
[State -2, varset];攻撃ボイスvarset
type = varset
trigger1 = var(14) < 0
var(14) = 0
ignorehitpause = 1

[State -2, varadd];攻撃ボイスvaradd
type = varadd
trigger1 = var(14) > 0
var(14) = -1
ignorehitpause = 1

;----------------------------------------------------------------------------
[State -2, PlaySnd];ダメージ1
type = PlaySnd
triggerall = roundstate = 2 && Alive
triggerall = var(13) <= 0
trigger1 = anim = 5000 || anim = 5010 || anim = 5020
trigger1 = var(13) := 40
value = 5000,random%7
channel = 12
ignorehitpause = 1

[State -2, PlaySnd];ダメージ2
type = PlaySnd
triggerall = roundstate = 2 && Alive
triggerall = var(13) <= 0
trigger1 = anim = 5001 || anim = 5002 || anim = 5011 || anim = 5012 || anim = 5021 || anim = 5022
trigger1 = var(13) := 45
trigger2 = stateno = 5020 || stateno = 5030 || stateno = 5080
trigger2 = var(13) := 45
trigger3 = movetype = H
trigger3 = life < var(11)
trigger3 = var(8) < gametime
trigger3 = stateno != [150,155]
