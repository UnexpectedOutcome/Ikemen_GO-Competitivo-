;===========================================================================
; 準常時監視ステート（－３）
;===========================================================================
[Statedef -3]

;-----------------------------------
;ここは「ジャンプ」か「バックステップ」をした後に
;着地する音を鳴らす設定をしています。

[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;着地ステート
trigger2 = stateno = 106 ;バックステップ後の着地ステート
value = 2, 0

[State -3, 音を鳴らす]
type = PlaySnd
trigger1= (GameTime% 10)=0
trigger1 = stateno = 100  ;ダッシュステート
value = 2, 28
[State -3, VarSet]
type = VarSet
trigger1 = time = 0
var(0) = 3

[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;着地ステート
trigger2 = stateno = 106 ;バックステップ後の着地ステート
value = 2, 0

[State -3, 音を鳴らす]
type = PlaySnd
trigger1= (GameTime% 10)=0
trigger1 = stateno = 100  ;ダッシュステート
value = 2, 28

;=======================================================================================================
;=============================AIパート==================================================================
;=======================================================================================================
;----------------------------------------------------------------
;ブロッキング関係
;----------------------------------------------------------------
[State -3,立ちブロッキング] 
type = HitOverRide 
triggerall = var(59)>=3
triggerall = ctrl || stateno = [100,105]
trigger1 = random <= 70*Var(59) 
trigger2 = Var(59) = 10
trigger3 =EnemyNear,MoveType=A
trigger3 = stateno = [700,701]
trigger3 = random <= 99*Var(59)
slot = 0
stateno = 701 
attr = SCA, AA, AP 
time = 1 

[State -3, バグ防止]
type = ChangeState
Value = 0
trigger1 = Var(59) != 0
trigger1 = stateno = 11
ctrl = 1

