TriggerAll= Ctrl || stateno = [100,105]
Trigger1=EnemyNear,P2StateType!=A
Trigger1=Random<=Var(59)*40
Trigger2=P2BodyDist Y > -55
Trigger2=Random<=Var(59)*30


