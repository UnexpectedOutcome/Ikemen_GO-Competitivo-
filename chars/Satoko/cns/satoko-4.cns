;===========================================================================
; 超必殺技
;===========================================================================
;赤鯱（投げ動作）
[Statedef 3000]
type    = S
movetype= A
physics = S
juggle  = 4
velset = 0,0
ctrl = 0
sprpriority = 2

[State 3000, アニメ(通常時)]
type = ChangeAnim
triggerall = PrevStateNo != 9999
trigger1 = Time = 0
value = 3000
IgnoreHitPause = 1

[State 3000, アニメ（アーマー処理から）]
type = ChangeAnim
triggerall = PrevStateNo = 9999
trigger1 = time = 0
value = 3000
elem = var(33)

[State 3000, 物理的なキャラの幅]
type = Width
trigger1 = AnimElem = 2, >= 0
value =0,0

[State 3000, 超必殺技暗転時間停止]
type = SuperPause
trigger1 = AnimElem = 1
anim = S4600      ;超必エフェクトのアクションナンバー。通常は「fightfx.air」のアニメを使うが、
                 ;左に「s」を付ければ「自分のairファイル」のアクションナンバーが使える。
pos = 20, -40    ;超必エフェクトの座標（Ｘ軸,Ｙ軸）
sound = S2, 11    ;超必発動サウンド。通常は「common.snd」の音を使うが、
                 ;左に「s」を付ければ「自分のsndファイル」の音が使える。
poweradd = -1000 ;パワーゲージ増減量
time = 45       ;ポーズする時間（フレーム）
movetime = 45    ;ポーズ中に動ける時間。timeよりも多いとバグる（デフォルトは０）
darken = 1      ;ポーズ中画面を暗転するか否か（0=しない・1=する）
                 ;暗転する色は「ownpal」の有無により「Explod」や「ヘルパー」にも影響するので注意。
p2defmul = 1.0  ;直前のステートを「SuperPauseを設置したステート」でキャンセルした場合、
                 ;『相手に一時的に与える防御力乗算値(float)』。
                 ;デフォルトは０。（相手の防御力が上がり、ダメージ量に下方修正が掛かる）
                 ;１にすれば『ダメージ補正が掛からなくなる』事になる。
                 ;自分が攻撃以外（MoveTypeが「A」以外）のステートになれば解除される。
;unhittable = 1  ;ポーズ中自分を無敵状態にするか否か（0=しない・1=する）
                 ;デフォルトは１。

[State 3000, 沙都子カットイン]
type = Helper
trigger1 = AnimElem = 1
helpertype = normal
name = "cut in"
ID = 4700
pos = -100, -250
postype = back
facing = 1
stateno = 4700
keyctrl = 0
ownpal = 1
size.xscale = 1
size.yscale = 1
supermovetime = 9999999
pausemovetime = 9999999


[State 3000, 声]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1, 9
channel = 4

[State 3000, 残像]
type = AfterImage
trigger1 = AnimElem = 2, 1
trigger1 = Var(30) = 0
time = 2

[State 3000, 残像表示時間]
type = AfterImageTime
trigger1 = AnimElemTime(2) >= 1 && Time < 60
trigger1 = Var(30) = 0
time = 2

[State 3000, 相手の特定の攻撃属性無効]
type = NotHitBy
trigger1 = AnimElem = 2
value = , NA, SA, AT
time = 11

[State 3000, 相手の特定の攻撃属性無効]
type = NotHitBy
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(14) < 0
value2 = C, NA
time = 1

[State 3000, 移動]
type = velset
trigger1 = AnimElem = 4
x = 4

[State 3000, ヘルパー赤鯱]
type = Helper
trigger1 = AnimElem = 3
helpertype = normal
name = "akashachi"
Id = 3010
pos = 0,-20
postype = p1
facing = 1
Stateno = 3010
keyctrl = 0
ownpal = 1
persistent = 0
ignorehitpause = 1

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 4
value = 2, 4

[State 3000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

