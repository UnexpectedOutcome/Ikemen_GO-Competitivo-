;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         ="Hojo Satoko"
DisplayName  ="Satoko"
VersionDate  =04,14,2002
MugenVersion =04,14,2002
Author       ="hiroyuki(w)"
Pal.Defaults =1,2,5,10

[Files]
Cmd  =satoko.cmd
Cns  =cns/satoko.cns
St   =cns/satoko-1.cns
St0  = cns/satoko-2.cns
st1=cns/satoko-3.cns
st2=cns/satoko-4.cns
st3=cns/satoko-5.cns
st4=cns/satoko-6.cns
StCommon =common1.cns
Sprite  =satoko.sff
Anim    =satoko.air
Sound   =satoko.snd
pal1=act/satoko1.act
pal2=act/satoko2.act
pal3=act/satoko3.act
pal4=act/satoko4.act
pal5=act/satoko5.act
pal6=act/satoko6.act
pal7=act/vanila.act
pal8=act/yamiwapiko.act
pal9=act/yamiwapiko.act
pal10=act/yamiwapiko.act
movelist = movelist.dat

;--| カラーパレットファイル |-------------------------------------------------
;
; キャラクターの色を定義するファイルは最大１２個まで登録が可能です。
;
; なお、Pal7～12（７Ｐ～１２Ｐカラー）を選びたい時は、
; スタートボタン（Ｓボタン）を押しながらキャラクターを決定すれば使えます。
; この要素を利用して『裏キャラ』や『殺意の波動に目覚めたリュウ』などの
; 別性能バージョンも１体のキャラの中で作る事が可能。
;
;-----------------------------------------------------------------------------

;pal8=            ;Ｓ押しながらＢ
;Pal9 =           ;Ｓ押しながらＣ
;Pal11=           ;Ｓ押しながらＹ
;Pal12=           ;Ｓ押しながらＺ

;--| ストーリーボード設定 |---------------------------------------------------
;
; キャラクター固有のオープニングやエンディングのファイル（ストーリーボード）を
; 登録する場合はここで設定をします。
;
; ※ここで設定したストーリーボードが有効になるゲームモードは
; 「アーケードモード（ARCADE）」
; 「チームアーケードモード（TEAM ARCADE）」
; 「１Ｐと２ＰがペアになってＣＰＵと闘うモード（TEAM CO-OP）」の三種類のみ。
;
; 　しかしチームを組んだ場合、有効になるのは『選んだ最初の一人目』のみ。
;
;-----------------------------------------------------------------------------

[Arcade]
intro.storyboard=
ending.storyboard=
;Intro.Storyboard = intro.def   ;オープニングのファイルを登録します
;Ending.Storyboard = ending.def ;エンディングのファイルを登録します
