;This is your characters .def (Definition) file.
;This file contains all the information about your character and lists
;all the files that make up your character.

;Player information

[Info]
name ="Hemeto"

displayname ="HMT"

versiondate =13,10,2018

mugenversion =1.1

author ="Nightterror599"

pal.defaults =1,2,3,4
                            ;The first two numbers will be displayed so p1 has
			    ;palette number 1 and p2 has palette number 2.

localcoord = 320,240        ;Local coordinate space width and height


; Files for the player
[Files]
cmd     =Commands.cmd
cns     =Coding File (CNS).cns
st      =Coding File (CNS).cns
stcommon =common1.cns
sprite  =Sprites.sff
anim    =Animations.air
sound   =Sounds.snd
ai      = character.ai                 ;AI hints data (not used)
;pal1    = 

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 4
b = 5
c = 6
;x2 = 7 ;Hold Start and press button X for palette 7, etc.
;y2 = 8
;z2 = 9
;a2 = 10
;b2 = 11
;c2 = 12

; Arcade mode - Use this only for creating intro and ending scenes for your character.
[Arcade]
intro.storyboard=
ending.storyboard=
