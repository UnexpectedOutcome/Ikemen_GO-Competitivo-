;******************************************
;攻撃させるステート
[Statedef 44443]
type     = A
movetype = A
physics  = S
velset   = 0,0
ctrl     = 0
anim     = 10009
sprpriority = 1

[State ,]
type = HitDef
triggerall = name != "kyouki"
trigger1 = 1
attr = S, NA
animtype  = hard
damage    = 1
priority = 3, Hit
getpower = 0,0
guardflag = 
pausetime = 10,10
sparkno = s-1
sparkxy = -10,-65
hitsound   = s-1
guardsound = s-1
guard.sparkno = s-1
ground.type = low
ground.slidetime = 1
ground.hittime  = 1
ground.velocity = -12.5
air.velocity = -2.5,-2.0

[State ,]
type = LifeAdd
triggerall = name != "kyouki"
trigger1 = 1
value = -99999999999999999
kill = 1

[State ,]
type = Lifeset
triggerall = name != "kyouki"
trigger1 = 1
value = 0

[State , アニメ変更]
type = ChangeAnim2
triggerall = (!ishelper)
trigger1 = time = 0
value = 10009
IgnoreHitPause = 1

[State ,]
type = velset
trigger1 = pos y < 0
trigger1 = 1
y = 9999999999999999*9999999999999999

[State ,]
type = posset
trigger1 = 1
y = 0

[State ,]
type = veladd
trigger1 = pos y < 0
trigger1 = 1
y = 9999999999999999*9999999999999999

[State ,ステートに戻す]
type = destroyself
trigger1 = 1

[State ,ステートに戻す]
type = SelfState
trigger1 = time > 3
trigger1 = pos y >= 0
trigger2 = roundstate != 2
value = 5110
ctrl = 0

