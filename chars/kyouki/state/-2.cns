;----------------------------------------------
;BGM
;----------------------------------------------
[State -2, 音を鳴らす]
type = PlaySnd
trigger1 = (!ishelper)
trigger1 = (roundstate = [0,1])
trigger1 = Time = 0
value = 0,101
volume = -255
loop = 1

[State -2, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = nomusic
;-----------------------------------------------
;-----------------------------------------------


















[state -2];ライフ管理！
type = lifeSet
trigger1 = roundstate = 2
trigger1 = 1
value = (lifemax)-(helper(10001),var(2))
IgnoreHitPause = 1

[State -2, 特殊効果]
type = AssertSpecial
triggerall = ishelper(100000)
trigger1 = (roundstate != 2)
flag = NoKO

[state , a];右向き設定
type = varset
triggerall = (!ishelper)
trigger1 = facing = 1
v = 10
value = 1

[state , a];左向き設定
type = varset
triggerall = (!ishelper)
trigger1 = facing = -1
v = 10
value = 2
;-----------------------------------------------
; 変数の値の特定範囲をランダムで処理
;-----------------------------------------------
[State -2, 汎用ランダム]
type = VarRandom
trigger1 = 1
v = 28
range = 1,120
IgnoreHitPause = 1

[State ,ニュートラル]
type = varset
triggerall = (!ishelper)
trigger1 = roundstate = 2
trigger1 = command != "hold_F"
trigger1 = command != "hold_B"
trigger1 = command != "x"
trigger1 = command != "a"
trigger1 = command != "y"
trigger1 = command != "b"
trigger1 = (var(1) != [3,9])
trigger2 = (helper(100000),anim = [200,250])
trigger2 = helper(100000),animtime = 0
trigger3 = roundstate != 2
trigger3 = (helper(100000),animtime = 0)
trigger3 = (helper(100000),anim = [200,250])
trigger4 = roundstate = [0,1]
v = 1
value = 0
IgnoreHitPause = 1

[State -2,勝ち]
type = varset
triggerall = (!ishelper)
trigger1 = roundstate = 4
trigger1 = win
v = 1
value = 10
IgnoreHitPause = 1

[State -2,];負け
type = changeanim
trigger1 = ishelper(100000)
trigger1 = (helper(100000),anim != 10013)
trigger1 = roundstate = [3,4]
trigger1 = (parent,stateno = [5000,5150])
value = 10013
