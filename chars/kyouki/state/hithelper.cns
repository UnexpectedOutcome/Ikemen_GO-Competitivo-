;+++++++++++++++++++++++++++++++
;喰らいヘルパー
;+++++++++++++++++++++++++++++++
;
;ヘルパー変数！！
;var(1) = ダメージ記憶
;var(2) = ダメージ累積


[Statedef 10001]
type = S
ctrl = 0
anim = 10001
velset = 0,0
sprpriority = 1

[State ]
type = destroyself
trigger1 = (!ishelper(10001))
trigger2 = name != "kyouki"
trigger3 = (stateno != 10001)

[State , 振り返る]
type = Turn
trigger1 = (P2dist X < 0)

[State ,]
type = posset
trigger1 = 1
x = parent,pos x - 1
y = parent,pos y = 0

[State , 押し判定]
type = PlayerPush
trigger1 = helper(100000),anim != 211
value = 1
IgnoreHitPause = 1

[State , 押し判定]
type = PlayerPush
trigger1 = helper(100000),anim = 211
value = 0
IgnoreHitPause = 1

[state ];ダメージ記憶
type = varset
trigger1 = (parent,palno != [11,12])
trigger1 = gethitvar(damage) != 0
trigger1 = (numhelper(10001) < 2)
trigger1 = time = 0
v = 1
value = gethitvar(damage)
IgnoreHitPause = 1

[state ];ダメージ記憶(12p)
type = varset
trigger1 = (parent,palno = 12)
trigger1 = (numhelper(10001) < 2)
trigger1 = gethitvar(damage) <= 300
v = 1
value = gethitvar(damage)
IgnoreHitPause = 1

[state ];ダメージ記憶(12p)
type = varset
trigger1 = (parent,palno = 12)
trigger1 = (numhelper(10001) < 2)
trigger1 = gethitvar(damage) > 300
v = 1
value = 300
IgnoreHitPause = 1

[state -2];ダメージ累積
type = varset
trigger1 = (parent,palno != 12)
trigger1 = gethitvar(damage) != 0
trigger1 = time = 0
v = 2
value = var(2)+var(1)
IgnoreHitPause = 1

[state -2];ダメージ累積(12p)
type = varset
trigger1 = (parent,palno = 12)
trigger1 = (numhelper(10001) < 2)
trigger1 = gethitvar(damage) != 0
trigger1 = time = 0
trigger1 = prevstateno = 10001
v = 2
value = var(2)+(var(1)/10)+1
IgnoreHitPause = 1

[State , 無敵];喰らい時
type = NotHitBy
trigger1 = (parent,palno = [10,12])
trigger1 = gethitvar(damage) != 0
trigger1 = time = 0
value = SCA,AA,AT,AP
time = 10
supermovetime = 99999999
pausemovetime = 99999999
IgnoreHitPause = 1

[State , 無敵];胎動時
type = NotHitBy
triggerall = (parent,palno != [1,9])
triggerall = (helper(100000),anim = 240)
trigger1 = (helper(100000),animelem = 10)
trigger2 = (helper(100000),animelem = 11)
trigger3 = (helper(100000),animelem = 12)
trigger4 = (helper(100000),animelem = 13)
trigger5 = (helper(100000),animelem = 14)
trigger6 = (helper(100000),animelem = 9)
value = SCA,AA,AT,AP
time = 80
supermovetime = 99999999
pausemovetime = 99999999
IgnoreHitPause = 1

[State , 無敵];ジャンプ時
type = NotHitBy
triggerall = (helper(100000),anim = 211)
trigger1 = (helper(100000),animelem = 6)
trigger2 = (helper(100000),animelem = 7)
trigger3 = (helper(100000),animelem = 8)
trigger4 = (helper(100000),animelem = 9)
value = SCA,AA,AT,AP
time = 50
supermovetime = 99999999
pausemovetime = 99999999
IgnoreHitPause = 1

[state ]
type = HitOverride
trigger1 = 1
attr = SCA,AA,AT,AP
stateno = 10001
time = 1
IgnoreHitPause = 1

[State ,];屈
type = changeanim
trigger1 = (parent,var(1) = 6)
trigger1 = helper(100000),anim = 220
trigger2 = (parent,var(1) = 4)
trigger2 = helper(100000),anim = 200
value = 10017

[State ,];胎動
type = changeanim
trigger1 = (parent,var(1) = 7)
trigger1 = helper(100000),anim = 240
value = 10019
;+++++++++++++++++++++++++++++++
;攻撃ヘルパー
;+++++++++++++++++++++++++++++++
;
;ヘルパー変数！！


[Statedef 10002]
type = S
movetype = I
ctrl = 0
anim = 10008
velset = 0,0
sprpriority = 1

[State , 振り返る]
type = Turn
trigger1 = (P2dist X < 0)
trigger1 = (anim != [10006,10007])

[State ,]
type = StateTypeSet
trigger1 = (parent,var(1) = [3,4])
trigger2 = (parent,var(1) = 8)
movetype = A

[State ,]
type = StateTypeSet
trigger1 = (parent,var(1) != [3,4])
trigger1 = (parent,var(1) != 8)
movetype = I

[State ,]
type = posset
trigger1 = 1
x = parent,pos x - 1
y = parent,pos y = 0

[State ,];リセット
type = changeanim
triggerall = (parent,var(1) != 8)
trigger1 = (parent,var(1) != 3)
trigger2 = (parent,var(1) = 3)
trigger3 = helper(100000),animelem = 12
value = 10008

[State ,];リセット
type = changeanim
triggerall = (parent,var(1) != 8)
trigger1 = (parent,var(1) != 4)
trigger2 = (parent,var(1) = 4)
trigger3 = helper(100000),animelem = 13
value = 10008

[State ,];リセット
type = changeanim
trigger1 = (parent,var(1) != 8)
trigger2 = helper(100000),anim = 212
trigger2 = helper(100000),animelem = 1
value = 10008
