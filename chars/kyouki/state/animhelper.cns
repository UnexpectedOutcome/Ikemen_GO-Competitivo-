[Statedef 100000]
type = S
ctrl = 0
anim = 180
velset = 0,0
sprpriority = 1

[State ]
type = destroyself
trigger1 = (!ishelper(100000))
trigger2 = name != "kyouki"
trigger3 = (stateno != 100000)

[State ,]
type = posset
trigger1 = anim != [211,212]
x = parent,pos x - 1
y = parent,pos y = 0

[State , 振り返る]
