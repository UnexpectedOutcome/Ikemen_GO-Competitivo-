;The Commands.
;This is how you tell your character to move, based on what inputs the player applies.
;This is also where you'll be putting your AI.

[Remap] ;These are all mandatory. Do not remove any of them!
x = x
y = y
z = z
a = a
b = b
c = c
s = s

[Defaults]
command.time = 15
command.buffer.time = 1

;-| Super Motions |---------------------------------------------------------

[Command]
name = "Power Geyser"
command = DB, F, x

[Command]
name = "Power Geyser"
command = DB, F, y

[Command]
name = "Somersault Justice"
command = ~D, DF, F, a+b

[Command]
name = "Marine Shoot"
command = ~D, DF, F, x+y

[Command]
name = "Blue Forte Wave"
command = ~D, D, x+y

;-| Special Motions |-------------------------------------------------------

[Command]
name = "Dash Punch"
command = ~F, >F, x

[Command]
name = "Dash Punch"
command = ~F, >F, y

[Command]
name = "Power Wave"
command = ~D, DF, F, x

[Command]
name = "Power Wave"
command = ~D, DF, F, y

[Command]
name = "Burn Knuckle"
command = ~D, DB, B, x

[Command]
name = "Burn Knuckle"
command = ~D, DB, B, y

[Command]
name = "Sonic Boom"
command = ~$B, $F, x

[Command]
name = "Sonic Boom"
command = ~$B, $F, y

[Command]
name = "Somersault Kick Shell"
command = ~F, D, DF, a

[Command]
name = "Somersault Kick Shell"
command = ~F, D, DF, b

[Command]
name = "Marine Dive"
command = ~D, DB, B, a

[Command]
name = "Marine Dive"
command = ~D, DB, B, b

;======================================;
;         DASHING AND RECOVERY         ;
;======================================;

[Command]
name = "FF" ;Required (do not remove)
command = F, F
time = 10

[Command]
name = "BB" ;Required (do not remove)
command = B, B
time = 10

[Command]
name = "recovery" ;Required (do not remove)
command = x+y
time = 1

;======================================;
;          DIRECTIONAL INPUTS          ;
;======================================;

[Command]
name = "holdfwd" ;Required (do not remove)
command = /$F
time = 1

[Command]
name = "holdback" ;Required (do not remove)
command = /$B
time = 1

[Command]
name = "holdup" ;Required (do not remove)
command = /$U
time = 1

[Command]
name = "holddown" ;Required (do not remove)
command = /$D
time = 1

[Command]
name = "holdc"
command = /c
time = 1

;======================================;
;         BUTTON INPUTS                ;
;======================================;

[Command]
name = "x"
command = x
time = 1

[Command]
name = "y"
command = y
time = 1

[Command]
name = "z"
command = z
time = 1

[Command]
name = "a"
command = a
time = 1

[Command]
name = "b"
command = b
time = 1

[Command]
name = "c"
command = c
time = 1

[Command]
name = "s"
command = s
time = 1

;======================================;

;StateDef -1
;Determines what player performed inputs result in.
;Contains the AI.
;Order any State Controllers added into -1 as follows.
;Top to Bottom, Most Important to Least Important.

;===========================================================================;

[StateDef -1]

[State -1, Blue Forte Wave]
type = ChangeState
value = 3030
triggerall = !var(59)
triggerall = command = "Blue Forte Wave"
triggerall = NumHelper(3032) = 0
triggerall = power >= 2000
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || stateno = 250 || (stateno = [400,430])
trigger2 = movecontact
trigger3 = NumHelper(1001) >= 1 && stateno = 1000
trigger4 = NumHelper(1021) >= 1 && stateno = 1020

[State -1, Marine Shoot]
type = ChangeState
value = 3020
triggerall = !var(59)
triggerall = command = "Marine Shoot"
triggerall = NumHelper(3022) = 0
triggerall = power >= 1000
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || stateno = 250 || (stateno = [400,430])
trigger2 = movecontact
trigger3 = NumHelper(1001) >= 1 && stateno = 1000
trigger4 = NumHelper(1021) >= 1 && stateno = 1020

[State -1, Somersault Justice]
type = ChangeState
value = 3010
triggerall = !var(59)
triggerall = command = "Somersault Justice"
triggerall = power >= 1000
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || stateno = 250 || (stateno = [400,430])
trigger2 = movecontact
trigger3 = NumHelper(1001) >= 1 && stateno = 1000
trigger4 = NumHelper(1021) >= 1 && stateno = 1020

[State -1, Power Geyser]
type = ChangeState
value = 3000
triggerall = !var(59)
triggerall = command = "Power Geyser"
triggerall = power >= 1000
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || stateno = 250 || (stateno = [400,430])
trigger2 = movecontact

[State -1, Marine Dive]
type = ChangeState
value = 1040
triggerall = !var(59)
triggerall = command = "Marine Dive"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = (stateno = [600,631]) || (stateno = [670,674])
trigger2 = movecontact

[State -1, Somersault Kick Shell]
type = ChangeState
value = 1030
triggerall = !var(59)
triggerall = command = "Somersault Kick Shell"
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || stateno = 250 || (stateno = [400,430])
trigger2 = movecontact

[State -1, Sonic Boom]
type = ChangeState
value = 1020
triggerall = !var(59)
triggerall = command = "Sonic Boom"
triggerall = NumHelper(1021) = 0
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || (stateno = [400,420])
trigger2 = movecontact

[State -1, Burn Knuckle]
type = ChangeState
value = 1010
triggerall = !var(59)
triggerall = command = "Burn Knuckle"
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || stateno = 250 || (stateno = [400,430])
trigger2 = movecontact

[State -1, Power Wave]
type = ChangeState
value = 1000
triggerall = !var(59)
triggerall = command = "Power Wave"
triggerall = NumHelper(1001) = 0
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || (stateno = [400,420])
trigger2 = movecontact

[State -1, Power Charge]
type = ChangeState
value = 900
triggerall = !var(59)
triggerall = command = "holdc"
triggerall = power < powermax
trigger1 = statetype != A
trigger1 = ctrl

[State -1, Throw]
type = ChangeState
value = 800
triggerall = !var(59)
triggerall = command = "holdfwd" || command = "holdback"
triggerall = command = "y"
triggerall = statetype != A
triggerall = stateno != 100
trigger1 = ctrl
trigger1 = p2bodydist X < 10
trigger1 = p2statetype != A && p2movetype != H

[State -1, Roll]
type = ChangeState
value = 710
triggerall = !var(59)
triggerall = command = "holdfwd" || command = "holdback"
triggerall = command = "z"
trigger1 = statetype != A
trigger1 = ctrl
trigger1 = 1 || var(6) := (command = "holdback")

[State -1, Air Dodge]
type = ChangeState
value = 701
triggerall = !var(59)
triggerall = command = "z"
trigger1 = statetype = A
trigger1 = ctrl

[State -1, Dodge]
type = ChangeState
value = 700
triggerall = !var(59)
triggerall = command = "z"
trigger1 = statetype != A
trigger1 = ctrl

[State -1, Air Dash Kick]
type = ChangeState
value = 674
triggerall = !var(59)
triggerall = command = "a" || command = "b"
trigger1 = statetype = A
trigger1 = stateno = 110 && AnimElemTime(3) >= 1
trigger1 = 1 || var(6) := (command = "b")
trigger2 = stateno = 670 || stateno = 672
trigger2 = movecontact

[State -1, Air Dash Punch Follow-up]
type = ChangeState
value = 672
triggerall = !var(59)
triggerall = command = "x" || command = "y"
trigger1 = stateno = 670 
trigger1 = anim = 670 && movecontact && (AnimElemTime(2) = [0,4])

[State -1, Air Dash Punch]
type = ChangeState
value = 670
triggerall = !var(59)
triggerall = command = "x" || command = "y"
trigger1 = statetype = A
trigger1 = stateno = 110 && AnimElemTime(3) >= 1
trigger1 = 1 || var(6) := (command = "y")

[State -1, Alt Air Heavy Kick]
type = ChangeState
value = 631
triggerall = !var(59)
triggerall = command = "holddown" && command = "b"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = 600 || stateno = 620 || stateno = 621 || (stateno = [670,674])
trigger2 = movecontact

[State -1, Air Heavy Kick]
type = ChangeState
value = 630
triggerall = !var(59)
triggerall = command = "b"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = 600 || stateno = 620 || stateno = 621 || (stateno = [670,674])
trigger2 = movecontact

[State -1, Alt Air Light Kick]
type = ChangeState
value = 621
triggerall = !var(59)
triggerall = command = "holddown" && command = "a"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = 600 || stateno = 620
trigger2 = movecontact

[State -1, Air Light Kick]
type = ChangeState
value = 620
triggerall = !var(59)
triggerall = command = "a"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = 600
trigger2 = movecontact

[State -1, Air Heavy Punch]
type = ChangeState
value = 610
triggerall = !var(59)
triggerall = command = "y"
trigger1 = statetype = A
trigger1 = ctrl
trigger2 = stateno = 600 || stateno = 620 || stateno = 621 || (stateno = [670,674])
trigger2 = movecontact

[State -1, Air Light Punch]
type = ChangeState
value = 600
triggerall = !var(59)
triggerall = command = "x"
trigger1 = statetype = A
trigger1 = ctrl

[State -1, Crouch Heavy Kick]
type = ChangeState
value = 430
triggerall = !var(59)
triggerall = command = "b"
triggerall = statetype != A && command = "holddown"
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || (stateno = [400,420])
trigger2 = movecontact

[State -1, Crouch Light Kick]
type = ChangeState
value = 420
triggerall = !var(59)
triggerall = command = "a"
triggerall = statetype != A && command = "holddown"
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 220 || stateno = 400 || stateno = 420
trigger2 = movecontact

[State -1, Crouch Heavy Punch]
type = ChangeState
value = 410
triggerall = !var(59)
triggerall = command = "y"
triggerall = statetype != A && command = "holddown"
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 220 || stateno = 400 || stateno = 420
trigger2 = movecontact

[State -1, Crouch Light Punch]
type = ChangeState
value = 400
triggerall = !var(59)
triggerall = command = "x"
triggerall = statetype != A && command = "holddown"
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 220 || stateno = 400 || stateno = 420
trigger2 = movecontact

[State -1, Dash Kick]
type = ChangeState
value = 251
triggerall = !var(59)
triggerall = command = "a" || command = "b"
triggerall = statetype != A
trigger1 = ctrl
trigger1 = stateno = 100

[State -1, Dash Punch]
type = ChangeState
value = 250
triggerall = !var(59)
triggerall = command = "Dash Punch" || ((stateno = 100) + (command = "x" || command = "y") >= 2)
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || (stateno = [400,420])
trigger2 = movecontact

[State -1, Marine Butt Punch]
type = ChangeState
value = 240
triggerall = !var(59)
triggerall = command = "y" && command = "b"
triggerall = statetype != A && command != "holddown"
trigger1 = ctrl
trigger2 = (stateno = [200,230]) || (stateno = [400,430])
trigger2 = movecontact

[State -1, Heavy Kick]
type = ChangeState
value = 230
triggerall = !var(59)
triggerall = command = "b"
triggerall = statetype != A && command != "holddown"
trigger1 = ctrl
trigger2 = (stateno = [200,220]) || stateno = 400 || stateno = 420
trigger2 = movecontact

[State -1, Light Kick]
type = ChangeState
value = 220
triggerall = !var(59)
triggerall = command = "a"
triggerall = statetype != A && command != "holddown"
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 220 || stateno = 400 || stateno = 420
trigger2 = movecontact

[State -1, Heavy Punch]
type = ChangeState
value = 210
triggerall = !var(59)
triggerall = command = "y"
triggerall = statetype != A && command != "holddown"
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 220 || stateno = 400 || stateno = 420
trigger2 = movecontact

[State -1, Light Punch]
type = ChangeState
value = 200
triggerall = !var(59)
triggerall = command = "x"
triggerall = statetype != A && command != "holddown"
trigger1 = ctrl
trigger2 = stateno = 200 || stateno = 220 || stateno = 400 || stateno = 420
trigger2 = movecontact

[State -1, Down Taunt]
type = ChangeState
value = 196
triggerall = !var(59)
triggerall = statetype != A
triggerall = ctrl
trigger1 = command = "s"
trigger1 = command != "holdback" && command = "holddown" && command != "holdfwd"

[State -1, Taunt]
type = ChangeState
value = 195
triggerall = !var(59)
triggerall = command = "s"
trigger1 = statetype != A
trigger1 = ctrl

[State -1, Air Dash]
type = ChangeState
value = 110
triggerall = !var(59)
triggerall = var(13) = 1
triggerall = command = "FF"
triggerall = stateno != 105
trigger1 = statetype = A
trigger1 = ctrl

[State -1, Dash Back]
type = ChangeState
value = 105
triggerall = !var(59)
trigger1 = command = "BB"
trigger1 = statetype = S
trigger1 = ctrl

[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = !var(59)
trigger1 = command = "FF"
trigger1 = statetype = S
trigger1 = ctrl

[State -1, Wall Jump]
type = ChangeState
value = 48
triggerall = !var(59)
triggerall = command = "holdup"
triggerall = cond(BackEdgeBodyDist <= 0, command = "holdfwd", command = "holdback")
triggerall = stateno != 50 || prevstateno != 46
trigger1 = statetype = A
trigger1 = ctrl
trigger1 = FrontEdgeBodyDist <= 0 || BackEdgeBodyDist <= 0