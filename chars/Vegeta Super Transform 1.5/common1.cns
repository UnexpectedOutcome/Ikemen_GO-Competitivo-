;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
anim = 0+(var(7)*(10000))
sprpriority = 0
hitcountpersist = 1

[State 0, anim] ;??????????
type = ChangeAnim
trigger1 = Anim != 0+(var(7)*(10000)) && Anim != 5+(var(7)*(10000))
trigger2 = Anim = 5+(var(7)*(10000))&& AnimTime = 0+(var(7)*(10000)) ;Turn anim over
value = 0+(var(7)*(10000))

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0
;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C


[State 10, 1]
type = changeanim
trigger1 = time = 0
value = 10+(var(7)*10000)

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[State 10, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11+(var(7)*(10000))
sprpriority = 0


[State 11, 3]
type = changeanim
trigger1 = anim = 6
value = 11+(var(7)*10000)

[State 0, anim] ;??????????
type = ChangeAnim
trigger1 = Anim != 11+(var(7)*(10000)) && Anim != 6+(var(7)*(10000))
trigger2 = Anim = 6+(var(7)*(10000))&& AnimTime = 11+(var(7)*(10000)) ;Turn anim over
value = 11+(var(7)*(10000))


[State 11, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0
;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S

[State 12, 1]
type = changeanim
trigger1 = time = 0
value = 12+(var(7)*10000)


[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
anim = 20+(var(7)*(10000))+(var(10)+var(11))
sprpriority = 0

[State 40, ???···??]
type = ChangeState
trigger1 = var(59) > 0 ; AI??????
value = 0
ctrl = 1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+(var(7)*10000) && Anim != 5+(var(7)*10000)
trigger2 = Anim = 5+(var(7)*10000) && AnimTime = 0
value = 20+(var(7)*10000)

[State 20, 3]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+(var(7)*10000) && Anim != 5+(var(7)*10000)
trigger2 = Anim = 5+(var(7)*10000) && AnimTime = 0
value = 21+(var(7)*10000)

[State 20, e];???···??
type = ChangeState
trigger1 = var(59) > 0 ; AI??????
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
ctrl = 0
sprpriority = 1
facep2 = 1


[State 40, 1]
type = changeanim
trigger1 = time = 0
value = 40+(var(7)*10000)

[State 40, ???···??]
type = ChangeState
trigger1 = var(59) > 0 ; AI??????
value = 0
ctrl = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(2) = 0

[State 40, var]
type = VarSet
trigger1 = Time = 0
var(5) = 0

[State 40, 1]
type = changeanim
trigger1 = time = 0
value = 40+(var(7)*10000)

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(2) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(2) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(2)=0, const(velocity.jump.neu.x), ifelse(sysvar(2)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(2) = 1
x = const(velocity.runjump.fwd.x)

[State 0]
type = Explod
trigger1 = Animtime = 0
anim = 6000
pos = 0,10
postype = p1  ;p2,front,back,left,right
facing = 1
sprpriority = -1
ownpal = 1
scale = 0.5,0.75

[state 0]
type = playsnd
trigger1 = animtime = 0
value = S1,1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44+(var(7)*10000))
value = 44+(var(7)*10000)

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44+(var(7)*10000))
value = 41+(var(7)*10000)

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(2) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(2) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(2) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(2)=0, const(velocity.airjump.neu.x), ifelse(sysvar(2)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 0]
type = Explod
trigger1 = Time = 1
anim = 6000
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = 1
sprpriority = -1
ownpal = 1
scale = 0.5,0.75

[state 0]
type = playsnd
trigger1 = time = 0
value = S1,1

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(2) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41+(var(7)*10000), ifelse((vel x)>0, 42+(var(7)*10000), 43+(var(7)*10000)))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41+(var(7)*10000) && anim <= 43+(var(7)*10000)
persistent = 0
value = Anim + 3
;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1
