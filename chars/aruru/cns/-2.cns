
; 常時監視ステート（相手に行動を制御されても関係無く常に実行される）
;---------------------------------------------------------------------------

[Statedef -2]

[state -2]
type = DisplayToClipboard
trigger1 = 1
text = "var59 = %d"
params = var(59)

[state -2]
type = StopSnd
trigger1 = stateno != 3500
channel = 30

[state -2]
type = null;poweradd
trigger1 = movehit
trigger1 =  stateno != 3500 || stateno != 3000
value = 10

;---------------------------------

;フィーバーゲージ位置調整x軸(いじるとエラーがでます）
[state -2]
type = varset
trigger1 = 1
SuperMoveTime = 99999
PauseMoveTime = 99999
IgnoreHitPause = 1
persistent = 0
v = 52
value = 0    ;増やすと画面中央方向にずれる

;フィーバーゲージ位置調整y軸(いじるとエラーがでます）
[state -2]
type = varset
trigger1 = 1
SuperMoveTime = 99999
PauseMoveTime = 99999
IgnoreHitPause = 1
persistent = 0
v = 53
value = 0    ;増やすと画面下方向にずれる

;---------------------------------------

;-----------------------------------------------------------------------------------------------------------

;ボイス

[State -2]
type = varrandom
trigger1 = 1
v = 6
range = 0,6

;KO
[State -2]
type = PlaySnd
trigger1 = !alive
trigger1 = time = 1
trigger1 = stateno = 5150
;persistent = 0
ignorehitpause = 1
value = 5000,3
cannel = 10

;ダメージ
[State -2]
type = PlaySnd
triggerall = alive
triggerall = time    = 1
triggerall = random  < 700
triggerall = var(6) != 3
trigger1   = stateno = 5000 
trigger2   = stateno = 5010 
trigger3   = stateno = 5020 
trigger4   = stateno = 5030 
trigger5   = stateno = 5070 
persistent = 0
lowpriority = 1
ignorehitpause = 1
value = 5000,var(6)
cannel = 10

;-----------------------------------------------------------------------------------------------------------

;フィーバーゲージ

[State -2]
type= null;Helper
trigger1 = numhelper(8400) = 0
trigger1 = numhelper(8401) = 0
trigger1 = numhelper(8402) = 0
trigger1 = numhelper(8403) = 0
trigger1 = numhelper(8410) = 0
trigger1 = numhelper(8411) = 0
trigger1 = numhelper(8412) = 0
trigger1 = numhelper(8413) = 0
name           = "fevergauge"
stateno        = 8400
id             = 8400
postype = p1
pos = -300,300
ownpal         = 1
supermovetime  = 99999999
pausemovetime  = 99999999
ignorehitpause = 1

[state -2]
type = varadd
trigger1 = p2movetype = H && P2stateno != [120,159]
trigger1 = var(51) = 1
trigger1 = var(50) < 4
trigger1 = stateno != 3500
v = 50
value = 1
persistent = 0
SuperMoveTime = 99999
PauseMoveTime = 99999
IgnoreHitPause = 1

[state -2]
type = varadd
trigger1 = p2movetype = A
trigger1 = var(51) < 1
SuperMoveTime = 99999
PauseMoveTime = 99999
IgnoreHitPause = 1
persistent = 0
v = 51
value = 1

[State 200, 音を鳴らす]
type = PlaySnd
triggerall = var(51) = 1
triggerall = p2movetype = H
trigger1 = var(50) = 1
trigger2 = var(50) = 2
trigger3 = var(50) = 3
trigger4 = var(50) = 4
value = S1, 0
SuperMoveTime = 99999
PauseMoveTime = 99999
IgnoreHitPause = 1
persistent = 0

[state -2]
type = varset
trigger1 = p2movetype != A
trigger1 = var(51) = 1
SuperMoveTime = 99999
PauseMoveTime = 99999
IgnoreHitPause = 1
persistent = 0
v = 51
value = 0


