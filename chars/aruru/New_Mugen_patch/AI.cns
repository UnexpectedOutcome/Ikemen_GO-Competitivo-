;------------------------------------------------------------------------------------------------------------

;ヘブンレイ（ゲージレベル２／３）

[State -1,]
type = ChangeState
value = 3000
triggerall = var(59) = 1
triggerall = var(58) = [40,50+5*p2statetype=A]
triggerall = enemy,vel x >= 0
triggerall = p2bodydist x  = [50,80]
triggerall = p2bodydist y  = [-120,20]
triggerall = p2statetype != L
triggerall = power >= 2000
triggerall = ctrl
trigger1 = statetype != A
trigger2 = p2movetype = H
trigger2 = p2statetype = A
trigger2 = enemynear,pos y < -40
trigger2 = var(58) = [40,60]


;------------------------------------------------------------------------------

;ばよえーん（ゲージレベル２／３）

[State -1,]
type = ChangeState
value = 2000
triggerall = var(59) = 1
triggerall = var(58) = [30,45]
triggerall = p2bodydist x  = [-80,80]
triggerall = p2bodydist y  = [-120,20]
triggerall = p2statetype != L
triggerall = power >= 2000
trigger1 = p2movetype != A
trigger1 = statetype != A
trigger1 = ctrl

;------------------------------------------------------------------------------

;フィーバーモード（ゲージレベル１／３）

[State -1,]
type = ChangeState
value = 3500
triggerall = var(59) = 1
triggerall = var(50) >= 4
triggerall = var(58) = [50,60]
triggerall = p2statetype != L
triggerall = p2bodydist x  >= 60
triggerall = power >= 1000
trigger1 = statetype != A
trigger1 = ctrl


;-------------------------------------------------------------------------------------------------------------

;dash
[State -3]
type = ChangeState
value = 100
triggerall = (var(58) = [50,60])
triggerall = var(59) = 1
triggerall = statetype != A
triggerall = p2movetype != A && p2statetype != L
triggerall = p2bodydist x  > 80
triggerall = p2stateno != [5200,5210]
trigger1 = ctrl || stateno = 21
trigger1 = random  < 300

;back step
[State -3]
type = ChangeState
value = 105
triggerall = var(58) = [40,80]
triggerall = var(59) = 1
triggerall = statetype != A
triggerall = p2statetype != L
;triggerall = p2movetype  != A && p2movetype != H
triggerall = backedgedist > 60
trigger1 = p2bodydist x  < 50
trigger1 = ctrl || stateno = 21
trigger1 = random < 500

;walk
[State -3]
type = ChangeState
value = 21
triggerall = var(58) = [0,74]
triggerall = var(59) = 1
triggerall = statetype != A
triggerall = movetype != A
triggerall = p2movetype != H
trigger1 = ctrl && stateno != 21
trigger1 = random < 600

