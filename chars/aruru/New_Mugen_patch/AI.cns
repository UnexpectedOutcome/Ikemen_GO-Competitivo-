;------------------------------------------------------------------------------
;空中ぷよ攻撃
[State -1]
type = ChangeState
value = 600
triggerall = enemy,anim != 5300
triggerall = var(59) = 1
triggerall = var(58) = [0,10]
trigger1 = statetype = A
trigger1 = ctrl || (stateno = [100,105])

;-------------------------------------------------------------------------------
;guard start
[State -3]
type = ChangeState
value = 120
triggerall = var(57) > 1
triggerall = enemy,time > 5-var(57)
triggerall = random < ifelse(var(57)=2,50,ifelse(var(57)=3,180,ifelse(var(57)=4,400,1000)))
triggerall = var(59) = 1
triggerall = ctrl || stateno = 21 
triggerall = p2statetype != L
triggerall = enemy,movetype = A || p2movetype = A || inguarddist
triggerall = inguarddist
triggerall = !(enemy,hitdefattr = SCA, NT, ST, HT)
trigger1 = enemy,hitdefattr = SCA, NA, SA, HA, NP, SP, HP
trigger2 = enemy,numhelper > 0 || enemy,numproj > 0

;---------------------------------------------------------------------------------
;これはジャンプ後とバックステップ後に着地音を鳴らすコントローラです。
[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ後の着地
trigger2 = stateno = 106 ;バックステップ後の着地
value = 40, 0
