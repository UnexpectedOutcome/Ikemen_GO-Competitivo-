; Definition file for Madoka Kaname
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Madoka Kaname"       ;Name of character
displayname = "Kaname Madoka"       ;Name of character to display
versiondate = 06,25,2012     ;Version date of character
mugenversion = 04,14,2001    ;Version of M.U.G.E.N character works on
author = "おりりん" ;edited by nipa3008          ;Character author name
pal.defaults = 1,3,4,2       ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = madoka.cmd   ;Command set
cns     = madoka.cns   ;Constants
st      = madoka_intro.txt
st1      = madoka.cns   ;States
st2     = madoka_system.st   ;States
st3     = madoka_Super.st  ;イーグル、スパイラル
st4     = madoka_Super1.st ;ラピッド、パニエ
st5     = madoka_Super2.st ;トリプル
st6     = madoka_hyper.st   ;はいぱー
st7     = madoka_hyper1.st   ;はいぱー2
st8     = madoka_hyper2.st
stcommon = common1.cns ;Common states
sprite  = Madoka.sff   ;Sprite
anim    = madoka.air   ;Animation
sound   = madoka.snd   ;Sound
;pal1    = madoka01.ACT ;原作より色抽出した版
pal1    = pal/madoka.act ;若干血色がいい色版
pal2    = pal/madoka_homura.act;ほむらカラー
pal3    = pal/madoka_mami.ACT;マミカラー
pal4    = pal/madoka_sayaka.act;さやかカラー
pal5    = pal/madoka_anko.act;あんこカラー
pal6    = pal/madoka_midori.act;緑カラー（仁美）
pal7    = pal/madoka_miku.act;緑カラー（初音ミク風）
pal8    = pal/madoka.act;未設定
pal9    = pal/madoka.act;未設定
pal10   = pal/madoka.act;未設定
pal11    = pal/madoka_black.act;黒カラー（白黒赤眼）
pal12    = pal/madoka_gold.act;金カラー

[Arcade]
;intro.storyboard = intro\madoka_intro.def
;ending.storyboard = end\madoka_ending.def
