[Statedef 20]
type = S
physics = S
sprpriority = 0

[State 20, 1]
type = VarRandom
trigger1 = Time = 0
v = 57
range = 0,1
persistent = 0

[State 20, 2]
type = VelSet
trigger1 = !var(59) && (command = "holdfwd")
trigger2 = var(59) && (var(57) = 0)
x = const(velocity.walk.fwd.x)

[State 20, 3]
type = VelSet
trigger1 = !var(59) && (command = "holdback")
trigger2 = var(59) && (var(57) = 1)
x = const(velocity.walk.back.x)

[State 20, 4]
type = ChangeAnim
trigger1 = (Vel x != 0) && (Anim != Ifelse((Vel x > 0),20,21))
value = ifelse((Vel x > 0),20,21)

[State 20, 5]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0
IgnoreHitPause = 1

