;------------------------------------------------------------------------
[State var5]
type = VarAdd
IgnoreHitPause = 1
trigger1 = (Roundstate = 2) && Gethitvar(damage)
trigger1 = !var(1) && !var(2) && !var(3) && !var(4) && var(5)
var(5) = -ceil(gethitvar(damage)*fvar(11)-0.4)

[State var4]
type = VarAdd
IgnoreHitPause = 1
trigger1 = (Roundstate = 2) && Gethitvar(damage)
trigger1 = !var(1) && !var(2) && !var(3) && var(4) && var(5)
var(4) = -ceil(gethitvar(damage)*fvar(11)-0.4)

[State var3]
type = VarAdd
IgnoreHitPause = 1
trigger1 = (Roundstate = 2) && Gethitvar(damage)
trigger1 = !var(1) && !var(2) && var(3) && var(4) && var(5)
var(3) = -ceil(gethitvar(damage)*fvar(11)-0.4)

[State var2]
type = VarAdd
IgnoreHitPause = 1
trigger1 = (Roundstate = 2) && Gethitvar(damage)
trigger1 = !var(1) && var(2) && var(3) && var(4) && var(5)
var(2) = -ceil(gethitvar(damage)*fvar(11)-0.4)

[State var1]
type = VarAdd
IgnoreHitPause = 1
trigger1 = (Roundstate = 2) && Gethitvar(damage)
trigger1 = var(1) && var(2) && var(3) && var(4) && var(5)
var(1) = -ceil(gethitvar(damage)*fvar(11)-0.4)

[State var1]
type = VarSet
IgnoreHitPause = 1
trigger1 = var(1) < 0
var(1) = 0

[State var2]
type = VarSet
IgnoreHitPause = 1
trigger1 = var(2) < 0
var(2) = 0

[State var3]
type = VarSet
IgnoreHitPause = 1
trigger1 = var(3) < 0
var(3) = 0

[State var4]
type = VarSet
IgnoreHitPause = 1
trigger1 = var(4) < 0
var(4) = 0

[State var5]
type = VarSet
IgnoreHitPause = 1
trigger1 = var(5) < 0
var(5) = 0

[State var0]
type = VarAdd
IgnoreHitPause = 1
triggerall = (Roundstate = 2) && Gethitvar(damage) && var(0)
trigger1 = !var(1) && (var(2) = var(58)) && var(3) && var(4) && var(5)
trigger1 = var(57) := -2 || 1
trigger2 = !var(1) && !var(2) && (var(3) = var(58)) && var(4) && var(5)
trigger2 = var(57) := -2 || 1
trigger3 = !var(1) && !var(2) && !var(3) && (var(4) = var(58)) && var(5)
trigger3 = var(57) := -2 || 1
trigger4 = !var(1) && !var(2) && !var(3) && !var(4) && (var(5) = var(58))
trigger4 = var(57) := -2 || 1
trigger5 = !var(1) && !var(2) && !var(3) && !var(4) && !var(5)
trigger5 = var(57) := -2 || 1
var(0) = -1

[State var0]
type = VarAdd
IgnoreHitPause = 1
triggerall = (Roundstate = 2) && var(0)
trigger1 = var(56) > 4
trigger1 = var(56) := var(56)-5 || 1
trigger1 = var(57) := -2 || 1
var(0) = -1

[State var0]
type = VarAdd
IgnoreHitPause = 1
triggerall = (Roundstate = 2) && var(0)
trigger1 = var(56) > 4
trigger1 = var(56) := var(56)-5 || 1
trigger1 = var(57) := -2 || 1
var(0) = -1

[State var0]
type = VarAdd
IgnoreHitPause = 1
triggerall = (Roundstate = 2) && var(0)
trigger1 = var(56) > 4
trigger1 = var(56) := var(56)-5 || 1
trigger1 = var(57) := -2 || 1
var(0) = -1

[State var56]
type = VarSet
IgnoreHitPause = 1
trigger1 = var(56) < 0
var(56) = 0

[State var0]
type = VarSet
IgnoreHitPause = 1
trigger1 = LoseKO || !Alive
trigger1 = var(57) := -1 || 1
var(0) = 0

[State State]
type = SelfState
triggerall = (Roundstate = 2) && var(0) && (Gethitvar(damage) || (var(57) = -1))
trigger1 = !var(1) && (var(2) = var(58)) && var(3) && var(4) && var(5)
trigger2 = !var(1) && !var(2) && (var(3) = var(58)) && var(4) && var(5)
trigger3 = !var(1) && !var(2) && !var(3) && (var(4) = var(58)) && var(5)
trigger4 = !var(1) && !var(2) && !var(3) && !var(4) && (var(5) = var(58))
trigger5 = !var(1) && !var(2) && !var(3) && !var(4) && !var(5)
value = 5040
ctrl = 0
IgnoreHitPause = 1

[State Life]
type = LifeSet
IgnoreHitPause = 1
trigger1 = 1
value = lifemax*var(0)/var(10)

[State Movetype]
type = StateTypeSet
IgnoreHitPause = 1
trigger1 = var(0) && (Gethitvar(damage) > Life)
mvoetype = I

[State NoKO]
type = AssertSpecial
IgnoreHitPause = 1
trigger1 = var(0)
trigger1 = (Enemy(0),life > 0) && Ifelse((Numenemy = 2),(Enemy(1),life > 0) ,1)
flag = NoKO

[State NoGuard]
type = AssertSpecial
IgnoreHitPause = 1
trigger1 = 1
flag = NoStandGuard
flag2 = NoCrouchGuard
flag3 = NoAirGuard

[State var55]
type = Null
trigger1 = var(1) && var(2) && var(3) && var(4) && var(5)
trigger1 = var(55) := var(1) || 1
trigger2 = !var(1) && var(2) && var(3) && var(4) && var(5)
trigger2 = var(55) := var(2) || 1
trigger3 = !var(1) && !var(2) && var(3) && var(4) && var(5)
trigger3 = var(55) := var(3) || 1
trigger4 = !var(1) && !var(2) && !var(3) && var(4) && var(5)
trigger4 = var(55) := var(4) || 1
trigger5 = !var(1) && !var(2) && !var(3) && !var(4) && var(5)
trigger5 = var(55) := var(5) || 1
trigger6 = !var(0)
trigger6 = var(55) := 0 || 1
IgnoreHitPause = 1

[State DB]
type = DisplayToClipboard
trigger1 = 1
text = "Zanki:%d\tLife:%d\tAttack:%f\tDefence:%f\tHelperKilled:%d\n"
params = var(0),var(55),fvar(10),fvar(11),var(56)
IgnoreHitPause = 1

[State DB]
type = null;DisplayToClipboard
trigger1 = 1
text = "1:%d\t2:%d\t3:%d\t4:%d\t5:%d\n"
params = var(1),var(2),var(3),var(4),var(5)
IgnoreHitPause = 1

[State DB]
type = null;AppendToClipboard
trigger1 = 1
text = "0:%d\tf0:%d\t58:%d\tf10:%f\tf11:%f"
params = var(0),var(10),var(58),fvar(10),fvar(11)
IgnoreHitPause = 1

;========================================================================
;========================================================================
[Statedef -3]

[State var11]
type = VarRandom
trigger1 = 1
v = 11
range = 1,3

[State Snd]
type = PlaySnd
trigger1 = (Gametime%270 = 0) && (Roundstate = 2)
value = S190,var(11)
volume = 50
channel = 21
lowpriority = 1

;========================================================================
;========================================================================
;------------------------------------------------------------------------
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3]
type = VelSet
trigger1 = (Abs(vel x) < 2) || (Time = 4)
x = 0

[State 0, 4]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0
IgnoreHitPause = 1

[State 0, 5]
type = SelfState
trigger1 = !Ishelper && (LoseKO || !Alive || (Life <= 0))
value = 5050

[State 0, 6]
type = CtrlSet
trigger1 = Roundstate = 2
value = 1

[State 0, 7]
type = SelfState
trigger1 = Ishelper && (Roundstate >= 2)
value = 201

