;========================================================================
;【基本設定】
;========================================================================
[Data]
life = 1000		  ;ライフ
attack = 100		  ;攻撃力
defence = 100		  ;防御力
power = 10000		  ;パワー
fall.defence_up = 50	  ;ダウン時防御力
liedown.time = 60	  ;ダウンしてから起き上がるまでの時間
airjuggle = 10		  ;ジャグルポイント数
KO.echo = 0		  ;KOエコー
volume = 150		  ;音量
IntPersistIndex = 59	  ;varを持ち越す
FloatPersistIndex = 39	  ;fvarを持ち越す

[Size]
xscale = 1		  ;水平方向縮尺
yscale = 1		  ;垂直方向縮尺
ground.front = 30	  ;キャラクター幅・地上前
ground.back = 40	  ;キャラクター幅・地上後
air.front = 30		  ;キャラクター幅・空中前
air.back = 40		  ;キャラクター幅・空中後
height = 80		  ;キャラクター高さ
attack.dist = 80	  ;相手側のガード認識最低距離
proj.attack.dist = 80	  ;相手側の飛び道具ガード認識最低距離
proj.doscale = 1 	  ;発射物縮尺適応
head.pos = 20,-75	  ;頭の大体の座標
mid.pos = 0,-50		  ;体中心の大体の座標
shadowoffset = 0	  ;影の垂直方向オフセット
draw.offset = 0,0	  ;キャラの表示位置オフセット

[Movement]
airjump.num = 0		  ;空中ジャンプの回数
airjump.height = 0	  ;空中ジャンプに必要な最低限の高さ
yaccel = .48		  ;重力
stand.friction = .85	  ;立ち状態での摩擦係数
crouch.friction = .82	  ;しゃがみ状態での摩擦係数

[Velocity]
walk.fwd = 3		  ;前方歩きの速度
walk.back = -3		  ;後方歩きの速度
run.fwd = 6,0		  ;ダッシュ速度
run.back = -6,-5	  ;バク宙速度
jump.neu = 0,-10	  ;ジャンプ速度
jump.fwd = 3		  ;前方ジャンプ速度
jump.back = -3		  ;後方ジャンプ速度
runjump.fwd = 6,-12	  ;前方走りジャンプ速度
runjump.back = -6,-12	  ;後方走りジャンプ速度
airjump.neu = 0,0	  ;空中ジャンプ速度
airjump.fwd = 0		  ;前方空中ジャンプ速度
airjump.back = 0	  ;後方空中ジャンプ速度

;========================================================================
;========================================================================
[Statedef -2]
;------------------------------------------------------------------------
;------------------------------------------------------------------------
[State 撃破数用var0]
type = VarSet
IgnoreHitPause = 1
trigger1 = Roundstate < 2
var(0) = 20		;正数にしてね

[State AI起動用var59]
type = VarSet
IgnoreHitPause = 1
trigger1 = 1
var(59) = 1		;AIレベルなんてなかった

[State ライフ用var58]
type = VarSet
IgnoreHitPause = 1
trigger1 = 1
var(58) = 50		;正数にしてね

[State 攻撃力用fvar10]
type = VarSet
IgnoreHitPause = 1
trigger1 = 1
fvar(10) = 1.0		;負数にするのはダメ

[State 防御力用fvar11]
type = VarSet
IgnoreHitPause = 1
trigger1 = 1
fvar(11) = 1.0		;負数にするのはダメ

;------------------------------------------------------------------------
;以下は弄る必要ないよ
