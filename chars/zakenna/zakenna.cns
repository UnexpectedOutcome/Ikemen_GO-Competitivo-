physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarRandom
trigger1 = Time = 0
v = 57
range = 0,2
persistent = 0

[State 40, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 3]
type = VarSet
trigger1 = !var(59) && (command = "holdfwd")
trigger2 = var(59) && (var(57) = 0)
sysvar(1) = 1

[State 40, 4]
type = VarSet
trigger1 = !var(59) && (command = "holdback")
trigger2 = var(59) && (var(57) = 1)
sysvar(1) = -1

[State 40, 5]
type = VelSet
trigger1 = (Animtime = 0) && (sysvar(1) = 0)
x = const(velocity.jump.neu.x)
y = const(velocity.jump.y)

[State 40, 6]
type = VelSet
trigger1 = (Animtime = 0) && (sysvar(1) != 0)
x = ifelse((sysvar(1) = 1),const(velocity.jump.fwd.x),const(velocity.jump.back.x))
y = const(velocity.jump.y)

[State 40, 7]
type = VelSet
trigger1 = (Animtime = 0) && (Prevstateno = 100) && (sysvar(1) = 1)
x = const(velocity.runjump.fwd.x)

[State 40, 8]
type = ChangeState
trigger1 = Animtime = 0
value = 50
ctrl = 1

