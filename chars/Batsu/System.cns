type = S
ctrl = 0
anim = 182
velset = 0,0

[State 182, PlaySnd]
type = PlaySnd
trigger1 = animelem = 5
value = 3600,3+random%3
volumescale = 255
channel = 0

[State 182, PlaySnd]
type = PlaySnd
trigger1 = animelem = 5
value = 1,2
volumescale = 255

[State 182, AssertSpecial]
type = AssertSpecial
trigger1 = time = [0, 200]
flag = roundnotover
