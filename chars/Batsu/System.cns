; Dash Forward (land)
[statedef 101]
type    = s
physics = s
velset = 3,0
ctrl = 0
anim = 101

[State 100, 8] ;Slide Dust
type = explod
trigger1 = Time % 4 = 0
anim := 9185
sprpriority = 5
ownpal = 1
pos = 20,0
vel = -.8,0

[state 100, 7]
type = changestate
trigger1 = animtime = 0
value = 0
