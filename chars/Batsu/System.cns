;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = roundnotover


[State 180, 1]
type = ChangeState
trigger1 = !Time 
value = 181 + (random%2)

;---------------------------------------------------------------------------
; Win1 
