ctrl = 0
anim = 181
velset = 0,0

[State 181, PlaySnd]
type = PlaySnd
trigger1 = animelem = 1
value = 180,0+random%2
volumescale = 255
channel = 0

[State 181, PlaySnd]
type = PlaySnd
trigger1 = animelem = 5
value = 1,0
volumescale = 255

[State 181, PlaySnd]
type = PlaySnd
trigger1 = animelem = 8
value = 1,2
volumescale = 255

[State 181, PlaySnd]
type = PosAdd
trigger1 = animelem = 3
x = -16

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = time = [0, 200]
flag = roundnotover
;---------------------------------------------------------------------------
; Win2
