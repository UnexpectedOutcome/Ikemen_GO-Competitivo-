[State 3000, ステートタイプ変更]
Type = StateTypeSet
triggerall = NumEnemy > 0
trigger1 = (P2StateType = L && P2StateNo != 5101)
MoveType = I

[State 3000, ステートタイプ変更]
Type = StateTypeSet
triggerall = NumEnemy > 0
trigger1 = !(P2StateType = L && P2StateNo != 5101)
MoveType = A


[State 3000, varset]
