
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;基本データ部分
[Data]
life              = 1000  ;体力ゲージの最大値を決めます
power             = 3000  ;パワーゲージ最大値（デフォルトは 3000 = Lv.3 になります・オプション）
attack            = 95   ;攻撃力パーセンテージ（デフォルトは 100% になります）
defence           = 100   ;防御力パーセンテージ（デフォルトは 100% になります）
fall.defence_up   = 50    ;一時的に上昇するダウン時の防御力パーセンテージ
liedown.time      = 60    ;倒れてから起き上がるまでの時間
airjuggle         = 15    ;ジャグルポイント限界値　★１
sparkno           = 2     ;デフォルトのヒットスパーク番号（fightfx.airか、キャラのairから呼び出す）
guard.sparkno     = 40    ;デフォルトのガードスパーク番号（fightfx.airか、キャラのairから呼び出す）
KO.echo           = 0     ;ＫＯ時の声にエコーを掛けるかどうか（0=しない・1=する）
volume            = 255   ;キャラの音量　255が最高
intpersistindex   = 20    ;Varを次のラウンドへ持ち越しが可能 (最小=0, 最大=59)  ★２
floatpersistindex = 40    ;FVarを次のラウンドへ持ち越しが可能 (最小=0, 最大=39) ★２

;---------------------------------------------------------------------------
;サイズ設定
[Size]
xscale           = 1.05     ;キャラ画像の横のスケール
yscale           = 1.05     ;キャラ画像の縦のスケール
ground.back      = 16       ;キャラの幅（地上後方）
ground.front     = 15       ;キャラの幅（地上前方）
air.back         = 12       ;キャラの幅（空中後方）
air.front        = 12       ;キャラの幅（空中前方）
height           = 60       ;跳び越す相手のためのキャラの高さ
attack.dist      = 160      ;攻撃を出した時に相手がガード体勢に入る最低の距離
proj.attack.dist = 90       ;相手がガード体勢に入る発射物との最低の距離
proj.doscale     = 0        ;xscaleとyscaleが発射物のスケールにも影響するかどうか（0=しない・1=する）
head.pos         = 5, -100  ;BindToTargetの時に必要な頭の座標
mid.pos          = 5, -70  ;BindToTargetの時に必要な体中心の座標
shadowoffset     = 0        ;影の垂直方向の位置
draw.offset      = 0,0      ;キャラ描画表示位置（Ｘ軸,Ｙ軸）

;---------------------------------------------------------------------------
;移動速度設定
[Velocity]
walk.fwd     = 2.6         ;前進歩行速度
walk.back    = -2.3        ;後退歩行速度
run.fwd      = 5.6, 0      ;前に走る時の速度（Ｘ軸,Ｙ軸）
run.back     = -4.5,-3.8   ;後ろに走る時の速度（Ｘ軸,Ｙ軸）
jump.neu     = 0,-11.8      ;垂直ジャンプ速度（Ｘ軸,Ｙ軸）
jump.back    = -2.1        ;後ジャンプ速度
jump.fwd     = 2.8         ;前ジャンプ速度
runjump.back = -2.55,-8.1  ;後ろに走りながらのジャンプ速度（オプション）
runjump.fwd  = 4,-8.1      ;前に走りながらのジャンプ速度（オプション）
airjump.neu  = 0,-11.3      ;空中垂直ジャンプ速度（オプション）
airjump.back = -2.5        ;空中後ジャンプ速度（オプション）
airjump.fwd  = 2.55        ;空中前ジャンプ速度（オプション）

;---------------------------------------------------------------------------
;動作設定
[Movement]
airjump.num     = 1      ;空中ジャンプが出来る回数（オプション）
airjump.height  = 30     ;空中ジャンプするために必要な最低限の高さ（オプション）
yaccel          = .85    ;重力（垂直下降加速度）
stand.friction  = .90    ;立ち状態の摩擦係数
crouch.friction = .90    ;しゃがみ状態の摩擦係数

;---------------------------------------------------------------------------
; Varの使用状況
; ここに自分が使ったvarをメモしておくといろいろと好都合です。
; var(1)  - コマンドファイルのコンボ用
; var(2)  - 投げ

; var(4)  - アプソリュートビートヒット後攻撃力補正攻撃力補正
; var(5)  - アプソリュートビート

; var(6)  - TNTチャージab
; var(7)  - TNTチャージab
; var(8)  - TNTチャージxy
; var(9)  - TNTチャージxy

; var(10) - 特殊やられ
; var(12) - 攻撃力変更
; var(13) - 空中ガードスイッチ
; var(14) - アプソリュートビートヒット後攻撃力補正スイッチ
; var(15) - 先行入力用
; var(16) - 先行入力用

; var(31) - 怒り爆発
; var(32) - 怒り爆発
; var(33) - イントロ時の爆発回避

;---------------------------------------------------------------------------
; 基本行動のステート
;---------------------------------------------------------------------------
; タイムオーバー時

[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利ポーズ分岐

[Statedef 180]
type = S

[State 180, 勝利ポーズ1]
type = ChangeState
triggerall = RoundState != 0 ;エンディング対策
trigger1 = Time = 0
trigger1 = MatchOver = 0     ;0なら次の試合がまだ残ってるということ
value = 181

[State 180, 勝利ポーズ2]
type = ChangeState
trigger1 = Time = 0
trigger1 = MatchOver = 1     ;これが1だと試合終了したとき
trigger2 = RoundState = 0    ;エンディング時はこちらを使う
value = 182

;------------
; 勝利ポーズ1

[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 無敵]
type = NotHitBy
trigger1 = 4
value = SCA
time = 1

[State 181, ボイス]
type = PlaySnd
triggerall = Time = 8
trigger1 = Alive
value = 8,0
channel = 0

;------------
; 勝利ポーズ2

[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 182, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 182, 音を鳴らす]
type = PlaySnd
triggerall = Time = 10
trigger1 = Alive
value = 1,11

[State 182, ボイス]
type = PlaySnd
triggerall = Time = 30
trigger1 = Alive
value = 8,1
channel = 0

;---------------------------------------------------------------------------
; イントロ

[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 2]
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 190, パワーゲージを1000に] 
type = powerset
trigger1 = Time = 0
trigger1 = power < 1000
value = 1000

[State 190, ブリストル専用イントロ]
type = ChangeState
triggerall = Time = 1
trigger1 = P2name = "Bristol Weller" || P4name = "Bristol Weller"
value = 192

[State 190, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 8
value = 1, 1

[State 190, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 20
value = 1, 2

[State 190, スプライト表示]
type = Explod
trigger1 = AnimElem = 6
anim = 10190
postype = p1
pos = 0, 0
scale = 1.05,1.05
bindtime = -1
removetime = -2
sprpriority = 3
removeongethit = 1

[State 190, スプライト表示]
type = Explod
trigger1 = AnimElem = 21
anim = 10191
postype = p1
pos = 0, 0
scale = 1.05,1.05
bindtime = -1
removetime = -2
sprpriority = 3
removeongethit = 1

[State 190, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; ブリストル専用イントロ

[Statedef 192]
type = S
ctrl = 0
anim = 192
velset = 0,0

[State 192, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = Intro
flag2 = nobardisplay

[State 192, セリフ]
type = Explod
trigger1 = AnimElem = 7
anim = ifelse(TeamSide = 1,193,194)
ID = 192
pos = ifelse(TeamSide = 1,8,170),5
postype = left
sprpriority = 7
ontop = 1
facing = 1
bindtime = -1
ownpal = 1
removetime = -2
supermove = 1

[State 192, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; 挑発

[Statedef 195]
type     = S
movetype = I
physics  = S
anim     = 195
velset   = 0,0
ctrl     = 0
sprpriority = 2
facep2 = 1

[State 195, ボイス]
type = PlaySnd
triggerall = Time = 6
trigger1 = Alive
value = 8,2
channel = 0

[State 195, パワーが溜まる]
type = PowerAdd
trigger1 = Time = 29
value = 200

[State 195, コントロール可否]
type = CtrlSet
Trigger1 = Var(59) = 0
trigger1 = Time >= 1
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = command != "holddown"
Trigger2 = Var(59) != 0
trigger2 = (Time >= 48) || (EnemyNear,MoveType = A)
value = 1

[State 195, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;この下、一行以上空ける事！


