
;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------
;---OPTION--------------------------------------------------------------------

;空中ガード
[State -2, AirGuard]
type = varset
Trigger1 = 1
var(13) = 1	; 1:ON  0:OFF

;アブソリュートビートヒット後攻撃力補正スイッチ
[State -2, AirGuard]
type = varset
Trigger1 = 1
var(14) = 1	; 1:ON  0:OFF

;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;空中ガード不可

[State -2, AssertSpecial]
Type = AssertSpecial
Trigger1 = var(13) = 0
flag = NoAirGuard

;-----------------------------------------------------------------------------

[State -2, リセット]
type = varset
trigger1 = var(4) != 0
trigger1 = P2MoveType != H
var(4) = 0

;-----------------------------------------------------------------------------
;攻撃力変更

[state -2, varset]
type = varset
trigger1 = ((P2Life*100)/LifeMax) < 30
var(12) = 2
ignorehitpause = 1

[state -2, varset]
type = varset
trigger1 = ((P2Life*100)/LifeMax) = [30,75] 
var(12) = 1
ignorehitpause = 1

[state -2, varset]
type = varset
trigger1 = ((P2Life*100)/LifeMax) > 75
var(12) = 0
ignorehitpause = 1

[State -2, 1]
type = AttackMulSet
trigger1 = Var(12) = 0
trigger1 = Var(4) = 0
ignorehitpause = 1
value = 1

[State -2, 2]
type = AttackMulSet
trigger1 = Var(12) = 1
trigger1 = Var(4) = 0
ignorehitpause = 2
value = 1.8

[State -2, 2]
type = AttackMulSet
trigger1 = Var(12) = 2
trigger1 = Var(4) = 0
ignorehitpause = 2
value = 0.7

;アブソリュートビートヒット後(30%減)
[State -2, 1]
type = AttackMulSet
trigger1 = Var(12) = 0
trigger1 = Var(4) = 1
ignorehitpause = 1
value = 0.7

[State -2, 2]
type = AttackMulSet
trigger1 = Var(12) = 1
trigger1 = Var(4) = 1
ignorehitpause = 2
value = 1.26

[State -2, 2]
type = AttackMulSet
trigger1 = Var(12) = 2
trigger1 = Var(4) = 1
ignorehitpause = 2
value = 0.49

[State -2, 攻撃力変更]
type = varset
trigger1 = Var(12) = 0
trigger1 = Var(4) = 0
fvar(0) = 100.0;(%) 
ignorehitpause = 1

[State -2, 攻撃力変更]
type = varset
trigger1 = Var(12) = 1
trigger1 = Var(4) = 0
fvar(0) = 180.0;(%) 
ignorehitpause = 1

[State -2, 攻撃力変更]
type = varset
trigger1 = Var(12) = 2
trigger1 = Var(4) = 0
fvar(0) = 70.0;(%) 
ignorehitpause = 1

;アブソリュートビートヒット後
[State -2, 攻撃力変更]
type = varset
trigger1 = Var(12) = 0
trigger1 = Var(4) = 1
fvar(0) = 70.0;(%) 
ignorehitpause = 1

[State -2, 攻撃力変更]
type = varset
trigger1 = Var(12) = 1
trigger1 = Var(4) = 1
fvar(0) = 126.0;(%) 
ignorehitpause = 1

[State -2, 攻撃力変更]
type = varset
trigger1 = Var(12) = 2
trigger1 = Var(4) = 1
fvar(0) = 49.0;(%) 
ignorehitpause = 1

;-----------------------------------------------------------------------------
; ゲージ

[state -2]
type = varset
trigger1 = floor(0.001 * power) > Var(32)
var(31) = 1

[state -2];イントロ時の爆発回避
type = varset
trigger1 = var(31) != 0
trigger1 = StateNo = 190
var(33) = 1

[state -2]
type = varset
trigger1 = 1
var(32) = floor(0.001 * power)

[state -2, varset]
type = varset
trigger1 = var(33) != 0
trigger1 = var(31) = 0
trigger1 = roundstate = 2
var(33) = 0

;-----------------------------------------------------------------------------
; TNTチャージ

[State -2]
type = VarSet
triggerall = var(6) > 0
trigger1 = command != "hold_a"
trigger2 = command = "hold_x" && command = "hold_y"
var(6) = 0

[State -2]
type = VarSet
triggerall = var(6) > 0
trigger1 = command != "hold_b"
var(6) = 0

[State -2]
type = VarSet
triggerall = var(8) > 0
trigger1 = command != "hold_x"
trigger2 = command = "hold_a" && command = "hold_b"
var(8) = 0

[State -2]
type = VarSet
triggerall = var(8) > 0
trigger1 = command != "hold_y"
var(8) = 0

[State -2]
type = VarAdd
trigger1 = command = "hold_a" && command = "hold_b"
trigger1 = command != "hold_x" && command != "hold_y"
var(6) = 1

[State -2]
type = VarAdd
trigger1 = command = "hold_x" && command = "hold_y"
trigger1 = command != "hold_a" && command != "hold_b"
var(8) = 1


[State -2]
type = VarSet
trigger1 = var(7) != 1 && var(6) = [100,249]
trigger2 = var(7) != 2 && var(6) = [250,399]
trigger3 = var(7) != 3 && var(6) = [400,649]
trigger4 = var(7) != 4 && var(6) >= 650
var(7) = 1 + (var(6) > 249) + (var(6) > 399) + (var(6) > 649)

[State -2]
type = VarSet
trigger1 = var(9) != 1 && var(8) = [100,249]
trigger2 = var(9) != 2 && var(8) = [250,399]
trigger3 = var(9) != 3 && var(8) = [400,649]
trigger4 = var(9) != 4 && var(8) >= 650
var(9) = 1 + (var(8) > 249) + (var(8) > 399) + (var(8) > 649)


;-----------------------------------------------------------------------------
