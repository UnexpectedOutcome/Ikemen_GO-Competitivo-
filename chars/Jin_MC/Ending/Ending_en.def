; Jin Ending

[SceneDef]
spr = Ending.sff
startscene = 0         ;Starting scene number (for debugging)

;------------------------------------
[Scene 0]
; Fade
fadein.time = 30       ;Time to take for fading in
fadein.col = 255,255,255     ;Use 255,255,255 for white-fade
fadeout.time = 15
fadeout.col = 0,0,0
; Screen color
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layerall.pos = 160,0   ;Default position for all layers
layer0.anim =  0       ;Anim action number
layer0.offset = 0,0   ;Position offset
;layer0.starttime = 0   ;Time to start display
layer1.anim =  1
layer1.offset = 0,0
; Music
bgm = Jin_ED.mp3
bgm.loop = 0
; Total time
end.time = 2170

;96 -64
[Begin Action 0]
  0,  0,  0,  0,320
 -1,  0,  0,  0, 1
  0,  1,  0,  0,215
 -1,  0,  0,  0, 1
  0,  2,  0,  0, -1

[Begin Action 1]
