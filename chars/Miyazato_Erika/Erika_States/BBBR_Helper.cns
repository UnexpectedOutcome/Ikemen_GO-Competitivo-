[Statedef 6300]
type    = S
physics = N
anim = 6300
ctrl = 0

[state a]
type = AssertSpecial
trigger1 = 1
flag = invisible

[state a]
type = NotHitBy
trigger1 = 1
value = SCA

[state a]
type = Null
triggerall = time = 0
trigger1 = numenemy
trigger1 = enemy(0),movecontact = 1
trigger1 = var(0) := 1
trigger1 = 0
trigger2 = numenemy = 2
trigger2 = enemy(1),movecontact = 1
trigger2 = var(0) := 2

[state a]
type = Turn
triggerall = time = 0
trigger1 = ishelper(6300) || ishelper(6302)
trigger1 = facing = -1
trigger2 = ishelper(6301) || ishelper(6303)
trigger2 = facing = 1

[state a]
type = PosSet
trigger1 = ishelper(6300)
trigger1 = numenemy
x = enemy(0),pos X-ifelse(enemy(0),facing=1,enemy(0),const(size.ground.back),enemy(0),const(size.ground.front))-4

[state a]
type = PosSet
trigger1 = ishelper(6301)
trigger1 = numenemy
x = enemy(0),pos X+ifelse(enemy(0),facing=-1,enemy(0),const(size.ground.back),enemy(0),const(size.ground.front))+4

[state a]
type = PosSet
trigger1 = ishelper(6302)
trigger1 = numenemy = 2
x = enemy(1),pos X-ifelse(enemy(1),facing=1,enemy(1),const(size.ground.back),enemy(1),const(size.ground.front))-4

[state a]
type = PosSet
trigger1 = ishelper(6303)
trigger1 = numenemy = 2
x = enemy(1),pos X+ifelse(enemy(0),facing=-1,enemy(1),const(size.ground.back),enemy(1),const(size.ground.front))+4

[state a];P1.L-Pressure
type = PosAdd
triggerall = ishelper(6300)
triggerall = numenemy
trigger1 = enemy(0),pos X-root,pos X > 0
trigger1 = root,backedgebodydist <= 0 || root,frontedgebodydist <= 0
x = ifelse(2*abs(root,vel X)<3+ifelse(enemy(0),facing=1,enemy(0),const(size.ground.back),enemy(0),const(size.ground.front)),2*abs(root,vel X),3+ifelse(enemy(0),facing=1,enemy(0),const(size.ground.back),enemy(0),const(size.ground.front)))

[state a];P1.R-Pressure
type = PosAdd
triggerall = ishelper(6301)
triggerall = numenemy
trigger1 = enemy(0),pos X-root,pos X < 0
trigger1 = root,backedgebodydist <= 0 || root,frontedgebodydist <= 0
x = ifelse(2*abs(root,vel X)<3+ifelse(enemy(0),facing=1,enemy(0),const(size.ground.back),enemy(0),const(size.ground.front)),2*abs(root,vel X),3+ifelse(enemy(0),facing=1,enemy(0),const(size.ground.back),enemy(0),const(size.ground.front)))

[state a];P2.L-Pressure
type = PosAdd
triggerall = ishelper(6302)
triggerall = numenemy = 2
trigger1 = enemy(1),pos X-root,pos X > 0
trigger1 = root,backedgebodydist <= 0 || root,frontedgebodydist <= 0
x = ifelse(2*abs(root,vel X)<3+ifelse(enemy(1),facing=1,enemy(1),const(size.ground.back),enemy(1),const(size.ground.front)),2*abs(root,vel X),3+ifelse(enemy(1),facing=1,enemy(1),const(size.ground.back),enemy(1),const(size.ground.front)))

[state a];P2.R-Pressure
type = PosAdd
triggerall = ishelper(6303)
triggerall = numenemy = 2
trigger1 = enemy(1),pos X-root,pos X < 0
trigger1 = root,backedgebodydist <= 0 || root,frontedgebodydist <= 0
x = ifelse(2*abs(root,vel X)<3+ifelse(enemy(1),facing=1,enemy(1),const(size.ground.back),enemy(1),const(size.ground.front)),2*abs(root,vel X),3+ifelse(enemy(1),facing=1,enemy(1),const(size.ground.back),enemy(1),const(size.ground.front)))

[state a]
type = PlayerPush
trigger1 = ishelper(6300) || ishelper(6301)
trigger1 = numenemy
value = ((enemy(0),pos X-root,pos X)*(-1)**ishelper(6301)>0)*(root,GetHitVar(hitshaketime)=0)

[state a]
type = PlayerPush
trigger1 = ishelper(6302) || ishelper(6303)
trigger1 = numenemy = 2
value = ((enemy(1),pos X-root,pos X)*(-1)**ishelper(6303)>0)*(root,GetHitVar(hitshaketime)=0)

[state a]
type = DestroySelf
trigger1 = time > 0
trigger1 = root,ctrl
trigger2 = ishelper(6300) || ishelper(6301)
trigger2 = var(0) != 1
trigger3 = ishelper(6302) || ishelper(6303)
trigger3 = var(0) != 2
trigger4 = ishelper(6300) || ishelper(6301)
trigger4 = numenemy
trigger4 = !enemy(0),alive
trigger5 = ishelper(6302) || ishelper(6303)
trigger5 = numenemy = 2
trigger5 = !enemy(1),alive
trigger6 = var(0) = 0

