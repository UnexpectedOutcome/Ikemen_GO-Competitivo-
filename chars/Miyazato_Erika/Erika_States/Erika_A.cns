; バウンド制限
[State -2, 2PBounceBig]
type = VarSet
triggerall = numenemy
triggerall = var(20)%10 < 9
triggerall = enemy(0),stateno = 5710 || enemy(0),stateno = 5715
triggerall = enemy(0),time = 1
trigger1 = enemy(0),GetHitVar(chainid) = 800
trigger2 = enemy(0),GetHitVar(chainid) = [1013,1014]
trigger3 = enemy(0),GetHitVar(chainid) = [1050,1051]
trigger4 = enemy(0),GetHitVar(chainid) = 2110
var(20) = var(20)+1
ignorehitpause = 1

[State -2, 4PBounceBig]
type = VarSet
triggerall = numenemy = 2
triggerall = var(20)/10%10 < 9
triggerall = enemy(1),stateno = 5710 || enemy(1),stateno = 5715
triggerall = enemy(1),time = 1
trigger1 = enemy(1),GetHitVar(chainid) = 800
trigger2 = enemy(1),GetHitVar(chainid) = [1013,1014]
trigger3 = enemy(1),GetHitVar(chainid) = [1050,1051]
trigger4 = enemy(1),GetHitVar(chainid) = 2110
var(20) = var(20)+10
ignorehitpause = 1

[State -2, 2PWallBounce]
type = VarSet
triggerall = numenemy
triggerall = var(20)%10 < 9
trigger1 = enemy(0),stateno = 5730
trigger1 = enemy(0),time = 1
trigger1 = enemy(0),GetHitVar(chainid) = 530
trigger2 = numtarget
trigger2 = enemy(0),stateno = [5030,5050]
trigger2 = enemy(0),GetHitVar(chainid) = 1211
trigger2 = enemy(0),backedgebodydist <= 10
var(20) = var(20)+1
ignorehitpause = 1

[State -2, 4PWallBounce]
type = VarSet
triggerall = numenemy = 2
triggerall = var(20)/10%10 < 9
trigger1 = enemy(1),stateno = 5730
trigger1 = enemy(1),time = 1
trigger1 = enemy(1),GetHitVar(chainid) = 530
trigger2 = numtarget
trigger2 = enemy(1),stateno = [5030,5050]
trigger2 = enemy(1),GetHitVar(chainid) = 1211
trigger2 = enemy(1),backedgebodydist <= 10
var(20) = var(20)+10
ignorehitpause = 1

[State -2, 2PAllReset]
type = VarSet
triggerall = numenemy
trigger1 = (enemy(0),movetype != H) || (enemy(0),stateno = [120,155]) || (enemy(0),stateno = [5201,5210])
trigger2 = !enemy(0),alive
var(20) = 10*floor(var(20)/10)
ignorehitpause = 1

[State -2, 4PAllReset]
type = VarSet
triggerall = numenemy = 2
trigger1 = (enemy(1),movetype != H) || (enemy(1),stateno = [120,155]) || (enemy(1),stateno = [5201,5210])
trigger2 = !enemy(1),alive
var(20) = var(20)%10
ignorehitpause = 1

