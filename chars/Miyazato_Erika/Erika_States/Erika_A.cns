
;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[StateDef -2]
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;                             　ゲージ類
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;==========================================================================
;--------------------------------------------------------------------------
[State -2, Gauge]
type = Helper
triggerall = RoundState = 2
triggerall = !numhelper(8000)
trigger1 = var(58)%10%5
trigger2 = var(29) > 0
ID = 8000
name = "Gauge"
pos = 0,(var(58)/10%1000)*(-1)**(var(58)%10>4)
postype = back
stateno = 8000
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

[State -2]
type = VarAdd
trigger1 = var(29) > 0
var(29) = -1
ignorehitpause = 1

[State -2]
type = VarSet
trigger1 = var(29) < 0
trigger2 = var(29) > 0
trigger2 = var(59) < -1
trigger2 = command = "s"
trigger2 = ctrl
var(29) = 0
ignorehitpause = 1

[State -2]
type = PowerSet
trigger1 = var(29) > 0
value = 2147483647
ignorehitpause = 1

;---------------------[Bストーン]
[State -2, B Stone]
type = Helper
trigger1 = RoundState = 2
trigger1 = !numhelper(8200)
ID = 8200
name = "B-Stone"
pos = 0,0
postype = left
stateno = 8200
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

[state a, 対応確認]
type = VarSet
triggerall = RoundState < 2
triggerall = numenemy
trigger1 = enemy,authorname = "Songfu"
trigger1 = enemy,var(36)/10%10 != 1
var(36) = 0

[state -2, 処理順の違いを考慮]
type = VarSet
trigger1 = teamside = 1
trigger1 = var(36)/10 = 1
trigger1 = var(34)/10000 > 0
var(36) = 10+(var(36)=10)
ignorehitpause = 1

[State -2, 相手取得によるリセット]
type = VarSet
trigger1 = numenemy
trigger1 = enemy,authorname = "Songfu"
trigger1 = enemy,var(36)/10 = 1
trigger1 = enemy,stateno = 510
trigger1 = enemy,time = 5-4*(enemy,name="Tenrou Kunagi")+(teamside=1)
trigger2 = numenemy = 2
trigger2 = enemy(1),authorname = "Songfu"
trigger2 = enemy(1),var(36)/10 = 1
trigger2 = enemy(1),stateno = 510
trigger2 = enemy(1),time = 5-4*(enemy(1),name="Tenrou Kunagi")+(teamside=1)
trigger3 = var(36) = 10
trigger3 = var(34)/10000 > 0
var(34) = var(34)%10000
ignorehitpause = 1

[State -2, 相手のBストーンへ対応]
type = PowerAdd
triggerall = numenemy
triggerall = enemy,authorname = "Songfu"
triggerall = enemy,var(36)/10 = 1
triggerall = enemy,var(34)/10000 > 0
trigger1 = !numpartner
trigger2 = numpartner
trigger2 = ID < partner,ID
value = 10*(enemy,var(34)/10000)

[State -2]
type = PowerAdd
triggerall = numenemy = 2
triggerall = enemy(1),authorname = "Songfu"
triggerall = enemy(1),var(36)/10 = 1
triggerall = enemy(1),var(34)/10000 > 0
trigger1 = !numpartner
trigger2 = numpartner
trigger2 = ID < partner,ID
value = 10*(enemy(1),var(34)/10000)

[State -2, 非対応の相手用]
type = TargetPowerAdd
trigger1 = var(34)/10000 > 0
value = 10*(var(34)/10000)+0*(var(34):=var(34)%10000)

;---------------------[宮里軍団招聘]
[State -2, Saki & Shoko Icon]
type = Helper
trigger1 = RoundState = 2
trigger1 = !numhelper(1020)
ID = 1020
name = "Icon"
pos = 0,220+(var(58)/10%1000)*(-1)**(var(58)%10>4)
postype = back
stateno = 1020
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

[State -2];サキ
type = VarAdd
trigger1 = var(12)%1000 > 0
trigger1 = !numhelper(1001)
trigger1 = stateno != 2501
trigger1 = !((stateno = 2502) && (AnimElemTime(11) <= 0))
var(12) = -1
ignorehitpause = 1

[State -2];ショーコ
type = VarAdd
trigger1 = var(12)/1000%1000 > 0
trigger1 = !numhelper(1011)
trigger1 = stateno != 2501
trigger1 = !((stateno = 2502) && (AnimElemTime(11) <= 0))
var(12) = -1000
ignorehitpause = 1

[State -2]
type = VarSet
trigger1 = var(59) < -1
var(12) = 0
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;                             バウンド処理系
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
