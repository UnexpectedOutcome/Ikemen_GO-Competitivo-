;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;                             コマンド制御
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;--------------------------------------------------------------------------
; ダッシュ系コマンド制御
[State -2, F]
type = VarSet
triggerall = var(17)%100 = 0
trigger1 = (command = "F") && (facing = 1)
trigger2 = (command = "B") && (facing = -1)
var(17) = 100*floor(var(17)/100)+1
ignorehitpause = 1

[State -2, B]
type = VarSet
triggerall = var(17)/100%100 = 0
trigger1 = (command = "B") && (facing = 1)
trigger2 = (command = "F") && (facing = -1)
var(17) = 10000*floor(var(17)/10000)+100+var(17)%100
ignorehitpause = 1

[State -2, ~F]
type = VarAdd
triggerall = var(17)%100 > 0
trigger1 = (command = "~F") && (facing = 1)
trigger1 = command != "holdfwd"
trigger2 = (command = "~B") && (facing = -1)
trigger2 = command != "holdback"
var(17) = 20
ignorehitpause = 1

[State -2, ~B]
type = VarAdd
triggerall = var(17)/100%100 > 0
trigger1 = (command = "~B") && (facing = 1)
trigger1 = command != "holdback"
trigger2 = (command = "~F") && (facing = -1)
trigger2 = command != "holdfwd"
var(17) = 2000
ignorehitpause = 1

[State -2, F]
type = VarAdd
triggerall = var(17)%100 > 0
trigger1 = !((command = "F") && (facing = 1))
trigger1 = !((command = "B") && (facing = -1))
var(17) = 1
ignorehitpause = 1

[State -2, B]
type = VarAdd
triggerall = var(17)/100%100 > 0
trigger1 = !((command = "B") && (facing = 1))
trigger1 = !((command = "F") && (facing = -1))
var(17) = 100
ignorehitpause = 1

[State -2, FF]
type = VarAdd
triggerall = var(17)/10000%100 > 0
trigger1 = !((command = "F") && (facing = 1))
trigger1 = !((command = "B") && (facing = -1))
var(17) = 10000
ignorehitpause = 1

[State -2, BB]
type = VarAdd
trigger1 = var(17)/1000000%100 > 0
trigger1 = !((command = "B") && (facing = 1))
trigger1 = !((command = "F") && (facing = -1))
var(17) = 1000000
ignorehitpause = 1

[State -2, F-Reset]
type = VarSet
trigger1 = var(17)%100 = (15,20)
trigger2 = var(17)%100 > 35
trigger3 = command = "D"
trigger4 = (command = "B") && (facing = 1)
trigger5 = (command = "F") && (facing = -1)
trigger6 = (command = "a") || (command = "b") || (command = "c")
trigger7 = (command = "x") || (command = "y") || (command = "z")
var(17) = 100*floor(var(17)/100)
ignorehitpause = 1

[State -2, B-Reset]
type = VarSet
trigger1 = var(17)/100%100 = (15,20)
trigger2 = var(17)/100%100 > 35
trigger3 = command = "D"
trigger4 = (command = "F") && (facing = 1)
trigger5 = (command = "B") && (facing = -1)
trigger6 = (command = "a") || (command = "b") || (command = "c")
trigger7 = (command = "x") || (command = "y") || (command = "z")
var(17) = 10000*floor(var(17)/10000)+var(17)%100
ignorehitpause = 1

[State -2, FF-Reset]
type = VarSet
trigger1 = var(17)/10000%100 > 15
trigger2 = (stateno = 100) || (stateno = 110)
trigger2 = time = 1
trigger2 = facing = 1
trigger3 = (stateno = 105) || (stateno = 115)
trigger3 = time = 1
trigger3 = facing = -1
trigger4 = (command = "a") || (command = "b") || (command = "c")
trigger5 = (command = "x") || (command = "y") || (command = "z")
var(17) = 1000000*floor(var(17)/1000000)+var(17)%10000
ignorehitpause = 1

[State -2, BB-Reset]
type = VarSet
trigger1 = var(17)/1000000%100 > 15
trigger2 = (stateno = 105) || (stateno = 115)
trigger2 = time = 1
trigger2 = facing = 1
trigger3 = (stateno = 100) || (stateno = 110)
trigger3 = time = 1
trigger3 = facing = -1
trigger4 = (command = "a") || (command = "b") || (command = "c")
trigger5 = (command = "x") || (command = "y") || (command = "z")
var(17) = var(17)%1000000
ignorehitpause = 1

[State -2, FF]
type = VarSet
triggerall = var(17)%100 > 20
trigger1 = (command = "F") && (facing = 1)
trigger2 = (command = "B") && (facing = -1)
var(17) = 1000000*floor(var(17)/1000000)+10000+var(17)/100%100
ignorehitpause = 1

[State -2, BB]
type = VarSet
triggerall = var(17)/100%100 > 20
trigger1 = (command = "B") && (facing = 1)
trigger2 = (command = "F") && (facing = -1)
var(17) = 1000000+var(17)/10000%100+var(17)%100
ignorehitpause = 1

;--------------------------------------------------------------------------
; ハイジャンプコマンド制御[holddown時間(2),"HJ"有効時間(2),HJ方向,"D"有効時間(2),HJ中]
[State -2, holddown]
type = VarSet
trigger1 = command != "holddown"
var(15) = var(15)%1000000

[State -2, holddown]
type = VarAdd
trigger1 = var(15)/1000000 < 99
trigger1 = command = "holddown"
var(15) = 1000000
ignorehitpause = 1

[State -2, D]
type = VarSet
triggerall = var(15)/1000%1000 = 0
trigger1 = var(15)/1000000 = 1
var(15) = 1000000*floor(var(15)/1000000)+10+var(15)%10
ignorehitpause = 1

[State -2]
type = VarAdd
triggerall = var(15)/10%100 > 0
trigger1 = var(15)/1000000 != 1
var(15) = 10
ignorehitpause = 1

[State -2, D-Reset]
type = VarSet
trigger1 = var(15)/10%100 > 14
var(15) = 1000*floor(var(15)/1000)+var(15)%10
