type = S
ctrl = 0
anim = 0
velset = 0,0





[State 190]
type = VarSet
trigger1 = time = 0
v = 20
value = 0
[State 190]
type = VarSet
trigger1 = (enemynear,name="Tomoe_Mami")||(enemynear,name="Mami Tomoe")
v = 20
value = 1
[State 190]
type = VarSet
trigger1 = (enemynear,name = "Madoka Kaname") || (enemynear,name = "Madoka3")
v = 20
value = 2
[State 190]
type = VarSet
trigger1 = (enemynear,name = "Akemi-Homura")
v = 20
value = 3


[State 190]
type = ChangeState
trigger1 = var(20) = 3
value = 194
[State 190]
type = ChangeState
trigger1 = var(20) = 2
value = 193
[State 190]
type = ChangeState
trigger1 = var(20) = 1
value = 192
[State 190]
type = ChangeState
trigger1 = Time = 1
value = 191

