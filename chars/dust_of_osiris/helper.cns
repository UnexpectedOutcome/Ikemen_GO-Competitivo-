Trigger1 = Var(40) != 1 && Root,StateNo = 2300
V        = 40
Value    = 1
[State -1]
Type     = Null;VarSet
Trigger1 = Var(40) != 0 && Root,StateNo = 2301
V        = 40
Value    = 0
[State -2, VarSet]
Type     = Null;VarSet
trigger1 = var(41) = 0 && Var(40) != 0
V        = 41
Value    = ifelse((Var(1) != 0 && Var(3) != 0 && Var(2) = [6,7]),-1000,1000) ;覚醒制限時間設定


