Trigger1 = RoundState = [0,1]
Trigger2 = RoundState >= 3 && Root,Var(1) = 11
V        = 1
Value    = Root,Var(1)
[State -1]
Type     = Null;VarSet
Trigger1 = Root,Var(1) = 1 && Var(1) != 1
V        = 1
Value    = 1
[State -1]
Type     = Null;VarSet
Trigger1 = Root,Var(2) = [5,10]
Trigger1 = RoundState = [0,1]
V        = 2
Value    = Root,Var(2)
[State -1]
Type     = Null;VarSet
Trigger1 = Root,Var(2) = [5,10]
Trigger1 = RoundState = [0,1]
V        = 3
Value    = Root,Var(3)
[State -3, VarSet]
Type     = Null;VarSet
Trigger1 = RoundState < 3 && Var(40) != 0
Trigger1 = Root,Var(6) != (gametime+1)*3
V        = 7
Value    = Root,Life + (gametime%8 = 0)
ignorehitpause = 1
superMoveTime = 999999999
pauseMoveTime = 999999999
[State -1]
