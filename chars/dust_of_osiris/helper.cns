[Statedef 1000]
Physics = N
Anim    = 1012
SprPriority = -7

[State -1]
Type     = PosSet
Trigger1 = StateTime > 2
x        = Root,Pos X
y        = -47

[State -1]
Type = RemoveExplod
Trigger1 = Root,Facing*Facing < 0
[State -1]
Type = Turn
Trigger1 = Root,Facing*Facing < 0

[State -1]
Type        = VarSet
Trigger1    = 1
FV           = 1
Value       = 2*sin(0.017453292517*statetime*.75)

