
;==============================================================================
; 基本性能（Re.act版）・本体行動
;==============================================================================

; 190 : シールド
; 905 : HEAT 強制開放
; 915 : BLOOD HEAT
; 965 : ゲージ溜め
; 200 : 突き出し（仮称）
; 210 : 振り下ろし（仮称）
; 220 : 肩突き出し（仮称）
; 230 : 引き寄せ（仮称）
; 240 : エーテライト展開（仮称）
; 1500 : エンドロール（ゲオメトリア）
; 1510 : エンドロール（アーミラリ）
; 1600 : ヘキサエチル・エーテライト
; 2000 : トライヘルメス・ブラックランド
; 2100 : アアト・セケトヘテペト
; 2110 : アアト・セケトヘテペト（とどめ）

; 1420 : オシリス・ヘキサエチル
; 1430 : オシリス・エーテライト展開（仮称）
; 2060 : オシリス・トライヘルメス
; 2150 : オシリス・セケトヘテペト

;==============================================================================
; 前ダッシュ
;==============================================================================
; 開始
;------------------------------------------------------------------------------
[Statedef 100]
type    = S
physics = N
anim    = 20012
ctrl    = 0

[State 100, Pos]
type = PosSet
trigger1 = 1
y = 0

[State 100, Speed]
type = Velset
trigger1 = Time >= 10
x = const(Velocity.Run.fwd.x)
y = 0

[State 100, No Walk & No Turn]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2= NoAutoTurn
ignorehitpause = 1


[State 100, DashStop]
type = ChangeState
trigger1 = time > 30
value = 0
ctrl = 1

;==============================================================================
; バックステップ
;==============================================================================
[Statedef 105]
type    = S
physics = N
anim    = 20012
velset  = 0,0
ctrl    = 0

[State 100, Pos]
type = PosSet
trigger1 = 1
y = 0

[State 100, Speed]
type = Velset
trigger1 = Time >= 10
x = const(Velocity.Run.back.x)
y = 0

[State 100, No Walk & No Turn]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2= NoAutoTurn
ignorehitpause = 1


[State 100, DashStop]
type = ChangeState
trigger1 = time > 30
value = 0
ctrl = 1

;==============================================================================
;　壁叩きつけ開始
;==============================================================================
[Statedef 208]
Type     = A
MoveType = H
Physics  = N
Ctrl     = 0
VelSet   = 0,0

[State 1522, Turn]
type = Turn
trigger1 = time = 0
trigger1 = ((Facing)*(EnemyNear,Facing) = 1)

[State -1, VelSet] 
Type = VelSet
Trigger1 = 1
X = ifelse(HitShakeOver=0,0,-12)

[State -1, PosSet] 
Type = PosSet
Trigger1 = Time = 0
Trigger1 = Pos Y >= -15
Y = -21

[State -1, ChangeAnim2]
Type = ChangeAnim2
Trigger1 = Time = 0
Value = 208

[State -1, ScreenBound]
Type = ScreenBound
Trigger1 = 1
Value = 1
MoveCamera = 0,1

[State 753, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 1
IgnoreHitPause = 1


[State -1, ChangeState]
type = ChangeState
TriggerAll = ((FrontEdgeDist <= 3) || (BackEdgeDist <= 3))
Trigger1 = 1
Value = 209

;------------------------------------------------------------------------------
;　終了
;------------------------------------------------------------------------------
[Statedef 209]
Type     = A
MoveType = H
Physics  = N
Ctrl     = 0
VelSet   = 0,0

[State -1, ChangeState]
Type = SelfState
TriggerAll = Vel Y > 0
TriggerAll = Pos Y >= -20
TriggerAll = Alive
TriggerAll = CanRecover
Trigger1 = Command = "recovery"
Value = 5040

[State -1, ChangeState]
Type = SelfState
TriggerAll = Vel Y > -1
TriggerAll = Alive
TriggerAll = CanRecover
Trigger1 = Command = "recovery"
Value = 5040

[State -1, ChangeAnim2]
Type = ChangeAnim
Trigger1 = Time = 0
Value = 5050

[State -1, VelSet]
Type = VelSet
Trigger1 = Time = 0
X = 0
Y = 0

[State -1, EnvShake]
Type = EnvShake
Trigger1 = Time = 0
Time  = 10
Ampl  = 5
Freq  = 90

[State -1, VelSet]
Type = VelSet
Trigger1 = Time = 2
X = .5
Y = -3

[State -1, Gravity];VelAdd]
Type = Gravity;VelAdd
Trigger1 = Time >= 3
;Y = 0.36

[State -1, ScreenBound]
Type = Null;ScreenBound
Trigger1 = 1
Value = 1
MoveCamera = 0,1

[State -1, SelfState]
Type = SelfState
Trigger1 = (Vel Y > 0) && (Pos Y >= 0)
Value = 5100

