;==============================================================================
;[statedef -3]定義
;==============================================================================
[Statedef -3]
;==============================================================================
;　AI発動
;==============================================================================
[State -3,0000]
Type = VarSet
TriggerAll = IsHelper = 0
Trigger1 = 1
V = 58
Value = 3         ;Level

; 0 : Very Easy
; 1 : Easy
; 2 : Normal
; 3 : Hard(Default)
; 4 : Insane
; 5 : Lunatic

[State -3, AI]
Type = VarSet
TriggerAll = IsHelper = 0
TriggerAll = Var(59) != 1 && Var(58) != 0
TriggerAll = RoundState = [1,2]
;Trigger20= 1 ;				AIを常時オンにする場合、左端の;を削除
Trigger1   = Command = "AI_01" || Command = "AI_02" || Command = "AI_03"
Trigger2   = Command = "AI_04" || Command = "AI_05" || Command = "AI_06"
Trigger3   = Command = "AI_07" || Command = "AI_08" || Command = "AI_09"
Trigger4   = Command = "AI_10" || Command = "AI_11" || Command = "AI_12"
Trigger5   = Command = "AI_13" || Command = "AI_14" || Command = "AI_15"
Trigger6   = Command = "AI_16" || Command = "AI_17" || Command = "AI_18"
Trigger7   = Command = "AI_19" || Command = "AI_20" || Command = "AI_21"
Trigger8   = Command = "AI_22" || Command = "AI_23" || Command = "AI_24"
Trigger9   = Command = "AI_25" || Command = "AI_26" || Command = "AI_27"
Trigger10  = Command = "AI_28" || Command = "AI_29" || Command = "AI_30"
Trigger11  = Command = "AI_31" || Command = "AI_32" || Command = "AI_33"
Trigger12  = Command = "AI_34" || Command = "AI_35" || Command = "AI_36"
Trigger13  = Command = "AI_37" || Command = "AI_38" || Command = "AI_39"
Trigger14  = Command = "AI_40" || Command = "AI_41" || Command = "AI_42"
Trigger15  = Command = "AI_43" || Command = "AI_44" || Command = "AI_45"
Trigger16  = Command = "AI_46" || Command = "AI_47" || Command = "AI_48"
Trigger17  = Command = "AI_49" || Command = "AI_50" || Command = "AI_00"
Trigger18 = NumHelper(9000) != 0
Trigger18 = Helper(9000),var(1) = 1 && RoundState = 2
Trigger19 = Var(59) = 11 && RoundState = 2
V = 59
Value = 1
ignorehitpause = 1

[State -3, AI]
Type = VarSet
TriggerAll = IsHelper = 0
TriggerAll = Var(59) = 1
Trigger1 = RoundState = 3
Trigger2 = Alive = 0
V = 59
Value = 11

[State -1] ; アーマー
Type     = Helper
TriggerAll = IsHelper = 0
Trigger1 = NumHelper(1800) = 0
TriggerAll = RoundState = 2 && Alive
HelperType = Player
Stateno  = 1800
ID       = 1800
Pos      = 0,0
PosType  = P1
Ownpal   = 1
Keyctrl  = 0
SuperMoveTime = 9999999
PauseMoveTime = 9999999

[State -1] ; 胴体
Type     = Helper
TriggerAll = IsHelper = 0
Trigger1 = NumHelper(1000) = 0
Trigger1 = RoundState = 2 && Alive
Stateno  = 1000
ID       = 1000
Ownpal   = 1
Postype  = P1
Pos      = 0,-47
Keyctrl  = 0
ignorehitpause = 1
[State -1] ; 本体
Type     = Helper
TriggerAll = IsHelper = 0
Trigger1 = NumHelper(1400) = 0 && Alive
HelperType = Player
Stateno  = 1400
ID       = 1400
Ownpal   = 1
Postype  = P1
Pos      = 0,0
Keyctrl  = 0
ignorehitpause = 1

[State -1]
Type     = Helper
TriggerAll = IsHelper = 0
Trigger1 = NumHelper(9000) = 0 && Var(59) != 1
Trigger1 = RoundState = 2 && alive && StateNo = 0
Trigger1 = PrevStateNo = 5900 || PrevStateNo = [190,199]
Stateno  = 9000
ID       = 9000
Pos      = 20,-60
PosType  = P1
Ownpal   = 1
Keyctrl  = 1
SuperMoveTime = 9999999
PauseMoveTime = 9999999
ignorehitpause = 1

[State -3]
type=changestate
trigger1= ishelper(9000)
trigger1= stateno!=9000
value=9000

;==============================================================================
;　AI行動
;==============================================================================
;------------------------------------------------------------------------------
;　ヒート・ブラヒ発動
;------------------------------------------------------------------------------
[State -3, 4]
type = ChangeState
value = 905
triggerall = Var(59) = 1 && Var(58) >= 2 && PalNo = 7
triggerall = !Ishelper
triggerall = Var(33) = 0
Triggerall = Ctrl = 1
TriggerAll = StateType != A
trigger1 = (P2Life - Life) >= 500
Trigger1 = Power >= 1000 && Var(59) != 4 && Var(59) != 5
Trigger2 = Life <= .15*LifeMax || (Life <= .2*LifeMax && Var(59) >= 4)
trigger2 = random > 300
Trigger2 = Power >= 2000 || (power >= 1000 && Var(59) >= 3)
[State -3, 4]
type = ChangeState
value = 915
triggerall = Var(59) = 1 && PalNo = 7
triggerall = !Ishelper
triggerAll = Var(33) >= 1
TriggerAll = Ctrl = 1
triggerAll = Var(36) = 0
trigger1 = (P2Life - Life) >= 300
Trigger2 = Random <= 300

[State -3, 4]
type = ChangeState
value = 900
triggerall = Ishelper
triggerall = Root,Var(59) = 1 && Root,Var(58) >= 2 && PalNo >= 7
triggerall = Ishelper(1400)
triggerall = Root,Var(33) = 0
Triggerall = StateNo = 1400
trigger1 = (P2Life - Root,Life) >= 500
Trigger1 = Power >= 1000 && Root,Var(59) != 4 && Root,Var(59) != 5
Trigger2 = Root,Life <= .15*LifeMax || (Root,Life <= .2*LifeMax && Root,Var(59) >= 4)
trigger2 = random > 300
Trigger2 = Power >= 2000 || (power >= 1000 && Root,Var(59) >= 3)
[State -3, 4]
type = ChangeState
value = 910
triggerall = Ishelper
triggerall = Root,Var(59) = 1 && Root,PalNo >= 7
triggerall = Ishelper(1400)
triggerAll = Root,Var(33) >= 1
TriggerAll = StateNo = 1400
triggerAll = Root,Var(36) = 0
trigger1 = (P2Life - Root,Life) >= 300
Trigger2 = Random <= 300


;------------------------------------------------------------------------------
;　ガード
;------------------------------------------------------------------------------
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0 && PalNo > 6
TriggerAll = RoundState = 2
TriggerAll = Var(59) = 1 && Var(58) >= 2
TriggerAll = ctrl
TriggerAll = StateNo != 160
Trigger1 = InGuardDist
Trigger2 = NumHelper(1080)
Trigger2 = Helper(1080),InGuardDist
Trigger3 = NumHelper(1800)
Trigger3 = EnemyNear,Ctrl = 0 && EnemyNear,MoveType != H
Value = ifelse(Random%36=10||(Var(33)<0&&Random%36<=2&&Var(58)>=3),160,120)
ignorehitpause = 1
[State -3]
Type = ChangeState
TriggerAll = IsHelper(1800)
TriggerAll = Root,StateNo = [120,159]
Trigger1 = StateNo != [120,159]
Value = 120
ignorehitpause = 1
[State -3]
Type = ChangeState
TriggerAll = IsHelper(1800)
Trigger1 = StateNo != [120,159]
Trigger1 = StateNo != [1800,1802]
Value = 1800
ignorehitpause = 1
;==============================================================================
;　Easy
;==============================================================================
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [1,4]
Trigger1 = (EnemyNear,Ctrl = 0 && Var(58) < 3) || Random%12 <= 1
Trigger1 = ctrl
Value = ifelse(P2BodyDist X >= 150,200+10*(Random%3),220+10*(Random%3))
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [1,4]
Trigger1 = EnemyNear,Ctrl = 1 && Random%24 <= 2
Trigger1 = ctrl
Value = 1500+10*(random%2)
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [1,3]
Trigger1 = Random%24 <= 1
Trigger1 = ctrl
Value = 100+5*(random%2)
;==============================================================================
;　Normal
;==============================================================================
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0 && PalNo <= 7
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [2,3]
Trigger1 = EnemyNear,MoveType = H
Trigger1 = Var(33) != 0
Trigger1 = ctrl
Value = 2000
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [2,3]
Trigger1 = (EnemyNear,Ctrl = 0 && EnemyNear,MoveType != H && Random%12 <= 5) || Random%12 <= 2
Trigger1 = EnemyNear,Pos Y <= 300 && P2BodyDist X = [0,180]
Trigger1 = Var(33) != 0
Trigger1 = ctrl
Value = 1600

;==============================================================================
;　Hard
;==============================================================================
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [3,5]
Trigger1 = EnemyNear,Ctrl = 1 && Random%24 <= 4 || Random%12 = 3
Trigger1 = ctrl
Value = 1500+10*(random%2)
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0 && PalNo <= 6
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [3,5]
Trigger1 = EnemyNear,MoveType = A || (EnemyNear,Ctrl = 0 && EnemyNear,StateNo != [120,159])
Trigger1 = ctrl
Value = ifelse(P2BodyDist X >= 100,200+10*(random%2),ifelse(P2BodyDist X >40,220+10*(random%2),220+20*(random%2)))
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0 && PalNo > 6
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [3,5]
Trigger1 = EnemyNear,MoveType = A || (EnemyNear,Ctrl = 0 && EnemyNear,StateNo != [120,159])
Trigger1 = ctrl
Value = ifelse(P2BodyDist X >= 100,200+10*(random%2),ifelse(P2BodyDist X >40,220+10*(random%2),220))

;==============================================================================
;　Insane
;==============================================================================
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [4,5]
Trigger1 = Var(33) != 0 && Var(32) > 200
Trigger1 = P2BodyDist X > 0
Trigger1 = ctrl
Value = 1600
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0 && PalNo <= 7
TriggerAll = RoundState = 2
Trigger1 = Var(59) = 1 && Var(58) = [4,5]
Trigger1 = Var(33) != 0 && Var(32) <= 200
Trigger1 = ctrl
Value = 2000

[State -3, 4]
type = ChangeState
triggerall = Ishelper
TriggerAll = RoundState = 2
triggerall = Root,Var(59) = 1 && Root,PalNo >= 8 && Root,Var(58) = [3,5]
triggerall = Ishelper(1400)
TriggerAll = StateNo = 1400
trigger1 = Root,P2BodyDist X > 70
Trigger1 = Root,Var(33)=0 || (Root,Var(33)!=0&&Root,Var(32)<=200)
Trigger1 = Random%12 <= 3
value = ifelse(Root,Var(33)!=0&&Root,Var(32)<=200,2060,960)

[State -3, 4]
type = ChangeState
triggerall = Ishelper
TriggerAll = RoundState = 2
triggerall = Ishelper(1400)
TriggerAll = StateNo = 1400
triggerAll = Numhelper(2161) = 0
trigger1 = Root,Var(59) = 1 && Root,PalNo >= 11 && Root,Var(58) = [4,5]
trigger2 = Root,Var(59) = 1 && Root,PalNo >= 12 && Root,Var(58) = [3,5]
value = 2160
[State -3, 4]
type = ChangeState
triggerall = Ishelper
TriggerAll = RoundState = 2
triggerall = Ishelper(1400)
TriggerAll = StateNo = 1400
triggerall = Root,P2BodyDist X <= 70
Triggerall = Root,Var(33)!=0&&Root,Var(32)<=400
Triggerall = Random%12 <= 3
trigger1 = Root,Var(59) = 1 && Root,PalNo >= 8 && Root,Var(58) = [4,5]
trigger2 = Root,Var(59) = 1 && Root,PalNo >= 11 && Root,Var(58) = [3,5]
value = 2060
[State -3, 4]
type = ChangeState
triggerall = Ishelper
TriggerAll = RoundState = 2
triggerall = Root,Var(59) = 1 && Root,PalNo >= 8 && Root,Var(58) = [3,5]
triggerall = Ishelper(1400)
TriggerAll = StateNo = 1400
trigger1 = Root,P2BodyDist X <= 70
Trigger1 = Root,Var(33)!=0&&Root,Var(32)>400||Root,Var(33)=0
Trigger1 = Random%12 <= 3
value = ifelse(Root,Var(33)!=0&&Root,Var(32)<=400&&Root,Var(58)!=3,2060,ifelse(Random%12<=5&&((power>=1500&&Var(33)=0)||(Root,Var(33)!=0&&Root,Var(32)>500)),1420,1430))


;==============================================================================
;　Lunatic
;==============================================================================


;==============================================================================
;　ガード用
;==============================================================================
[State -3]
Type = ChangeState
TriggerAll = IsHelper = 0 && PalNo > 6
TriggerAll = RoundState = 2
TriggerAll = Var(59) = 0 && command = "holdback"
TriggerAll = ctrl
TriggerAll = StateNo != [120,159]
Trigger1 = InGuardDist
Trigger2 = NumHelper(1080)
Trigger2 = Helper(1080),InGuardDist
Value = 120
ignorehitpause = 1

;------------------------------------------------------------------------------
; セケトヘテペト
;------------------------------------------------------------------------------
[State -1]
type = Null;ChangeState
value = 2160
TriggerAll = IsHelper
TriggerAll = Root,NumHelper(1400) && Root,PalNo > 7
TriggerAll = IsHelper(1400)
triggerall = Root,command = "z"
Triggerall = Root,Var(33) < 0
TriggerAll = Root,Var(59) != 1 || Root,Var(58) < 3
trigger1 = StateNo = 1400

;------------------------------------------------------------------------------
; トライヘルメス
;------------------------------------------------------------------------------
[State -1]
type = ChangeState
value = 2060
TriggerAll = IsHelper
TriggerAll = Root,NumHelper(1400) && Root,PalNo > 7
TriggerAll = IsHelper(1400)
triggerall = Root,command = "4+c"
Triggerall = Root,Var(33) != 0
TriggerAll = Root,Var(59) != 1 || Root,Var(58) < 3
trigger1 = StateNo = 1400

;------------------------------------------------------------------------------
; ヘキサエチル・エーテライト
;------------------------------------------------------------------------------
[State -1]
type = ChangeState
value = 1420
TriggerAll = IsHelper
TriggerAll = Root,NumHelper(1400) && Root,PalNo > 7
TriggerAll = IsHelper(1400)
triggerall = Root,command = "4+b"
Triggerall = Root,Var(33) != 0 || Power >= 1500
TriggerAll = Root,Var(59) != 1 || Root,Var(58) < 3
trigger1 = StateNo = 1400

;------------------------------------------------------------------------------
; エーテライト展開（仮称）
;------------------------------------------------------------------------------
[State -1]
type = ChangeState
value = 1430
TriggerAll = IsHelper
TriggerAll = Root,NumHelper(1400) && Root,PalNo > 7
TriggerAll = IsHelper(1400)
triggerall = Root,command = "4+a"
TriggerAll = Root,Var(59) != 1 || Root,Var(58) < 3
trigger1 = StateNo = 1400

;------------------------------------------------------------------------------
; ゲージ溜め
;------------------------------------------------------------------------------
[State -1]
Type = ChangeState
Value = 960
TriggerAll = IsHelper
TriggerAll = Root,NumHelper(1400) && Root,PalNo > 7
TriggerAll = IsHelper(1400)
TriggerAll = Root,Var(33) = 0
TriggerAll = Root,Command = "x" || Root,Command = "y"
TriggerAll = Root,StateType != A
TriggerAll = Root,Var(59) != 1 || Root,Var(58) < 3
trigger1 = StateNo = 1400

;------------------------------------------------------------------------------
; BLOOD HEAT
;------------------------------------------------------------------------------
[State -1]
Type = ChangeState
Value = 910
TriggerAll = IsHelper
TriggerAll = Root,NumHelper(1400) && Root,PalNo > 7
TriggerAll = IsHelper(1400)
TriggerAll = Root,Var(36) = 0 && Root,Var(33) >= 1
TriggerAll = Root,Var(59) != 1 || Root,Var(58) < 3
TriggerAll = Root,Command = "BLOOD HEAT"
trigger1 = StateNo = 1400

;------------------------------------------------------------------------------
; HEAT 強制開放
;------------------------------------------------------------------------------
[State -1]
Type = ChangeState
Value = 900
TriggerAll = IsHelper
TriggerAll = Root,NumHelper(1400) && Root,PalNo > 7
TriggerAll = IsHelper(1400)
TriggerAll = Root,Var(33) = 0
TriggerAll = Root,Command = "BLOOD HEAT"
TriggerAll = Power >= 1000
TriggerAll = Root,Var(59) != 1 || Root,Var(58) < 3
trigger1 = StateNo = 1400 || Root,Var(58) < 3
