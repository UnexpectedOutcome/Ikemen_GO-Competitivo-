;==============================================================================
;[statedef -2]定義
;==============================================================================

[statedef -2]
;==============================================================================
;　ダメージ音声関係
;==============================================================================
;==============================================================================
;　固有仕様
;==============================================================================
[State -2, nothitby]
type = NotHitBy
trigger1 = 1
TriggerAll = IsHelper = 0
value = SCA,AA,AP,AT
time = -1

[State -2]
type = HitOverRide
TriggerAll = IsHelper = 0
triggerAll = Alive
trigger1 = 1
time = 1
attr = SCA, NA, NT, NP, SA, ST, SP, HA, HT, HP
slot = 0
stateno = 5000
ignorehitpause = 1
[State -2, SelfState]
type = SelfState
TriggerAll = IsHelper = 0
triggerAll = Alive
Trigger1 = MoveType = H && StateNo != [120,159]
Trigger2 = StateType = A || StateType = L
value = 131
ctrl = 1
ignorehitpause = 1
[State -2, SelfState]
type = SelfState
TriggerAll = IsHelper(1800)
triggerAll = Alive
Trigger1 = (StateNo = [120,159]) && Root,StateNo != [120,159]
Trigger2 = (StateNo != [1800,1802]) && (StateNo != [120,159])
value = 1800
ignorehitpause = 1
[State -2, SelfState]
type = SelfState
TriggerAll = IsHelper(1800)
triggerAll = Alive
Trigger1 = (Root,StateNo = [120,159]) && StateNo != [120,159]
value = 120
ignorehitpause = 1
[State -2, SelfState]
type = ChangeState
TriggerAll = IsHelper(1400)
triggerAll = Alive
Trigger1 = (StateNo != [1400,1499]) && (StateNo != [900,999]) && (StateNo != [2000,2199])
value = 1400
ignorehitpause = 1
[State -2]
type = ChangeState
TriggerAll = IsHelper = 0
trigger1 = Alive = 0
value = 5150
ignorehitpause = 1

[State -2, assertspecial]
type = AssertSpecial
trigger1 = 1
TriggerAll = IsHelper(1400) = 0
flag = invisible
;flag2 = noautoturn
ignorehitpause = 1

[State -2, assertspecial]
type = AssertSpecial
triggerall = 1
Trigger1 = IsHelper = 0
Trigger1 = PalNo > 6
flag = noairguard
;flag2 = nocrouchguard
;flag3 = nostandguard
[State -2, assertspecial]
type = AssertSpecial
triggerAll = 1
Trigger1 = IsHelper != 0
Trigger2 = IsHelper = 0
Trigger2 = PalNo <= 6
flag = noairguard
flag2 = nocrouchguard
flag3 = nostandguard


[State -2, velset]
type = velset
trigger1 = 1
;x = 0
y = 0
ignorehitpause = 1

[State -2, posset]
type = posset
trigger1 = IsHelper(1400) + IsHelper(1800) = 0
y = 0
ignorehitpause = 1

[State 2110]
type = PosSet
trigger1       = 1
trigger1 = IsHelper(1800)
X              = Root,Pos X
Y              = Root,Pos Y
ignorehitpause = 1

[State -2, PlayerPush]
type = PlayerPush
trigger1 = 1
TriggerAll = IsHelper = 0
value = 0

[State 210, 3]
type = ScreenBound
trigger1 = 1
TriggerAll = IsHelper = 0
value = 1
movecamera = 1,0
[State 210, 3]
type = ScreenBound
trigger1 = 1
TriggerAll = IsHelper != 0
value = 0
movecamera = 0,0

[State -2, StateTypeSet]
type = StateTypeSet
trigger1 = 1
TriggerAll = IsHelper = 0
physics = S

[State -3, LifeAdd]
Type = LifeSet
TriggerAll = IsHelper = 0
Trigger1 = NumHelper(1800)
Trigger1 = RoundState >= 2 && helper(1800),Var(27) != [-999999,999999]
Trigger1 = PalNo = 5||PalNo = 6||PalNo = [9,12]
Value = LifeMax
[State -3, LifeAdd]
Type = LifeSet
TriggerAll = IsHelper = 0
Trigger1 = NumHelper(1800)
Trigger1 = (RoundState = [2,3])
Trigger1 = (PalNo!=[5,6])||(PalNo!=[9,12])||helper(1800),Var(27) >= -999999
Value = floor((1000 - 0.1*helper(1800),Var(27))*LifeMax*0.001)
[State -3, LifeAdd]
Type = LifeSet
