removetime = -2
supermove = 1
scale = 2,2
sprpriority = -2
id = 8521
bindtime = -1
ontop = 0
ownpal = 1
ignorehitpause = 1
pausemovetime = -1
persistent = 0

[State -3, Explod];P2 Side.
type = Explod
trigger1 = var(38)= 1 && numexplod(8521)=0 && teamside = 2
anim = F8522
pos = -30,65
postype = right  ;p2,front,back,left,right
removetime = -2
supermove = 1
scale = 2,2
sprpriority = -2
id = 8521
bindtime = -1
ontop = 0
ownpal = 1
ignorehitpause = 1
pausemovetime = -1
persistent = 0


