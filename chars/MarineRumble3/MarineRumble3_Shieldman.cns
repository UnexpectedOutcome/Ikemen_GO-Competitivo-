;---------------------------------------------------------------------------
; Stand
[Statedef 13000]
type = S
physics = S
sprpriority = 0

[State 1000, hitoverride]
type=hitoverride
trigger1=1
attr=SCA,NA,SA,HA,NP,SP,HP
time=-1
stateno=13600
ignorehitpause=1


[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 13000 && Anim != 13005)
trigger2 = (Anim = 13005) && AnimTime = 0
value = 13000


[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, Turn]
type = Turn
trigger1 = P2BodyDist X < -30



;-----------------------------------------------------------

[State 0, Winpose]
type = ChangeState
triggerall = parent, numhelper(182) = 1
trigger1 = 1
value = 13181
ctrl = 0


[State 0, Lose by Time]
type = ChangeState
triggerall = parent, numhelper(172) = 1
trigger1 = 1
value = 13900
ctrl = 0



;-----------------------------------------------------------

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = parent,var(31) <= 0
value = 13700
;------------------------------------------------------------


[State -3, IA de Defensa]
type = ChangeState
triggerall = p2movetype = A || (enemy, Numhelper > 0)
triggerall = statetype != A
triggerall = ctrl
triggerall = prevstateno = [13200,13211]
trigger1 = random = [200,300]
trigger2 = (enemy, Numhelper > 0)
value = 13200


[State -3, IA de Defensa]
type = ChangeState
triggerall = p2movetype = A || (enemy, Numhelper > 0)
triggerall = statetype != A
triggerall = ctrl
trigger1 = random = [0,400]
trigger2 = (enemy, Numhelper > 0)
value = 13200



[State 0, Walk] ; caminar
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 10
trigger1 = time%50 = 0 &&  random = [0,700]
value = ifelse(random >= 650, 13021,13020)
ctrl = 1


[State 0, Salto]
type = ChangeState
;trigger1 = p2movetype = A
trigger1 = time%50 = 0 && random = [200,300]
value = 13040
ctrl = 0



