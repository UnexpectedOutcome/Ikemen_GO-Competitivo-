[State -3, IA de Defensa]
type = ChangeState
triggerall = p2movetype = A || (enemy, Numhelper > 0)
triggerall = statetype != A
triggerall = ctrl
trigger1 = random = [0,900]
trigger2 = (enemy, Numhelper > 0)
value = 13200


[State 100:		ChangeState]
type			= ChangeState
trigger1		= time > 20+(random%40)
trigger2		= time = 60
value			= 13000




