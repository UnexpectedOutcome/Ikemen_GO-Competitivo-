type    = S
movetype= H
physics = S

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)


[State 11601, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 11601, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
value = 11605 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 11601, 3] ;Stop sliding back
