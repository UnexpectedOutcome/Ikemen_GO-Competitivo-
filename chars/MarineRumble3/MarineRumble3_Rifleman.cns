x = .6

[State 11601, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 11601, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 11601, 6]
type = ChangeState
trigger1 = HitOver
value = 0
ctrl = 1

