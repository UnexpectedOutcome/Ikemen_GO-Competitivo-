trigger1 = time = 0
v = 33
value = 1
[State 0, Varset]
type = Varset
trigger1 = time = 1
v = 33
value = 0

[State 1005, end]
type = changestate
trigger1 = Pos y > -1
value = 11012



;=======================================================================
;------ CAIDAS ---------------------------------------------------------
;=======================================================================

;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 11600]
type    = S
movetype= H
physics = N
velset = 0,0

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)



[State 11600, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),11600,11610) + GetHitVar(animtype)

[State 11600, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger2 = var(30) <= 0
value = 11630

[State 11600, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(11647 + GetHitVar(animtype)))
value = 11647 + GetHitVar(animtype) ;11651 - 4 + type

[State 11600, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 11600, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 11600, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 11601 ;HITG_SLIDE

[State 11600, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger2 = var(30) <= 0
value = 11630

[State 11600, FFB Light]
type = ForceFeedback
trigger1 = anim = 11600
trigger2 = anim = 11610
persistent = 0
time = 6
waveform = square

[State 11600, FFB Medium]
type = ForceFeedback
trigger1 = anim = 11601
trigger2 = anim = 11611
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 11600, FFB Hard]
type = ForceFeedback
trigger1 = anim = 11612
trigger2 = anim = 11602
trigger3 = anim = 11630
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITG_SLIDE
