;---------------------------------------------------------------------------
; Stand
[Statedef 11000]
type = S
physics = S
sprpriority = 0

[State 1000, hitoverride]
type=hitoverride
trigger1=1
attr=SCA,NA,SA,HA,NP,SP,HP
time=-1
stateno=11600
ignorehitpause=1


[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 11000 && Anim != 11005)
trigger2 = (Anim = 11005) && AnimTime = 0
value = 11000


[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, Turn]
type = Turn
trigger1 = P2BodyDist X < -30



;------------------------------

[State 0, Winpose]
type = ChangeState
triggerall = parent, numhelper(182) = 1
trigger1 = time = 0
value = 11181
ctrl = 1


[State 0, Lose by Time]
type = ChangeState
triggerall = parent, numhelper(172) = 1
trigger1 = 1
value = 11900
ctrl = 0



;-----------------------------------------------------------

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = parent,var(31) <= 0
value = 11700
;------------------------------------------------------------

[State 0, Walk] ; caminar
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 10 &&  p2bodydist x < 125
trigger1 = time%50 = 0 &&  random = [0,700]
value = ifelse(random >= 650, 11021,11020)
ctrl = 1

[State 0, Run] ; correr
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 150
trigger1 = time%50 = 0 &&  random = [0,700]
value = 11100
ctrl = 1

[State 0, Salto]
type = ChangeState
;trigger1 = p2movetype = A
trigger1 = time%50 = 0 && random = [200,300]
value = 11040
ctrl = 0


[State 0, Disparos]
type = ChangeState
trigger1 = time%50 = 0 && random = [200,400]
value = ifelse(random >= 300, 11300,11200)
ctrl = 1


