;-| Super Motions |--------------------------------------------------------
;The following two have the same name, but different motion.
;Either one will be detected by a "command = TripleKFPalm" trigger.
;Time is set to 20 (instead of default of 15) to make the move
;easier to do.
;
[Command]
name = "jigoku_x"
command = ~D, F, D, F, x
time = 20

[Command]
name = "jigoku_y"
command = ~D, F, D, F, y
time = 20

[Command]
name = "kodomo"
command = ~F, D, B, F, D, B, x
time = 25

[Command]
name = "kodomo"   ;Same name as above
command = ~F, D, B, F, D, B, y
time = 25

;-| Special Motions |------------------------------------------------------
[Command]
name = "jinniku_x"
command = F, D, B, x
time = 20

[Command]
name = "jinniku_y"
command = F, D, B, y
time = 20

;[Command]
;name = "upper_xy"
;command = ~F, D, DF, x+y

[Command]
name = "QCF_x"
command = ~D, F, x

[Command]
name = "QCF_y"
command = ~D, F, y

[Command]
name = "QCF_xy"
command = ~D, DF, F, x+y

[Command]
name = "QCF_s"
command = ~D, DF, F, s

[Command]
name = "QCB_x"
command = ~D, B, x

[Command]
name = "QCB_y"
command = ~D, B, y

[Command]
name = "QCB_xy"
command = ~D, B, x+y

[Command]
name = "BDF_ab"
command = $B, D, F, a+b

[Command]
name = "BDF_a"
command = $B, D, F, a

[Command]
name = "BDF_b"
command = $B, D, F, b

;-| Double Tap |-----------------------------------------------------------
[Command]
name = "FF"     ;Required (do not remove)
command = F, F
time = 10

[Command]
name = "BB"     ;Required (do not remove)
command = B, B
time = 10

;-| 2/3 Button Combination |-----------------------------------------------
[Command]
name = "recovery";Required (do not remove)
command = x+y
time = 1

;-| Dir + Button |---------------------------------------------------------
[Command]
name = "down_a"
command = /$D,a
time = 1

[Command]
name = "down_b"
command = /$D,b
time = 1

;-| Single Button |---------------------------------------------------------
[Command]
name = "a"
command = a
time = 1

[Command]
name = "b"
command = b
time = 1

[Command]
name = "c"
command = c
time = 1

[Command]
name = "x"
command = x
time = 1

[Command]
name = "y"
command = y
time = 1

[Command]
name = "z"
command = z
time = 1

[Command]
name = "start"
command = s
time = 1

;-| Hold Dir |--------------------------------------------------------------
[Command]
name = "holdfwd";Required (do not remove)
command = /$F
time = 1

[Command]
name = "holdback";Required (do not remove)
command = /$B
time = 1

[Command]
name = "holdup" ;Required (do not remove)
command = /$U
time = 1

[Command]
name = "holddown";Required (do not remove)
command = /$D
time = 1

;---------------------------------------------------------------------------

[Statedef -1]

;===========================================================================
;---------------------------------------------------------------------------
;Smash Kung Fu Upper (uses one super bar)
;こどものはらわたたべちゃった（ゲージレベル2）
[State -1, Smash Kung Fu Upper]
type = ChangeState
value = 3100
triggerall = command = "kodomo"
triggerall = power >= 2000
triggerall = statetype != A
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = ctrl

;---------------------------------------------------------------------------
;地獄門
[State -1, Triple Kung Fu Palm]
type = ChangeState
value = 3200
triggerall = command = "jigoku_y"
triggerall = power >= 3000
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = statetype = S
trigger1 = ctrl
trigger2 = statetype != A
trigger2 = hitdefattr = SC, NA, SA, HA
trigger2 = movecontact

;---------------------------------------------------------------------------
;じごくもん
[State -1, Triple Kung Fu Palm]
type = ChangeState
value = 3000
triggerall = command = "jigoku_x"
triggerall = power >= 1000
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = statetype = S
trigger1 = ctrl
trigger2 = statetype != A
trigger2 = hitdefattr = SC, NA, SA, HA
trigger2 = stateno != [3000,3050]
trigger2 = movecontact

;===========================================================================
;This is not a move, but it sets up var(1) to be 1 if conditions are right
;for a combo into a special move (used below).
;Since a lot of special moves rely on the same conditions, this reduces
;redundant logic.
[State -1, Combo condition Reset]
type = VarSet
trigger1 = 1
var(1) = 0

[State -1, Combo condition Check]
type = VarSet
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,299]) || (stateno = [400,499])
trigger2 = stateno != 440 ;Except for sweep kick
trigger2 = movecontact
var(1) = 1

;---------------------------------------------------------------------------
;Fast Kung Fu Knee (1/3 super bar)
;しょくしゅ（EX）
[State -1, Fast Kung Fu Knee]
type = ChangeState
value = 1320
triggerall = command = "BDF_ab"
triggerall = power >= 330
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = var(1) ;Use combo condition (above)

;---------------------------------------------------------------------------
;Light Kung Fu Knee
;しょくしゅ（弱）
[State -1, Light Kung Fu Knee]
type = ChangeState
value = 1300
triggerall = command = "BDF_a"
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = var(1) ;Use combo condition (above)

;---------------------------------------------------------------------------
;Strong Kung Fu Knee
;しょくしゅ（強）
[State -1, Strong Kung Fu Knee]
type = ChangeState
value = 1310
triggerall = command = "BDF_b"
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = var(1) ;Use combo condition (above)

;---------------------------------------------------------------------------
;Fast Kung Fu Palm (1/3 super bar)
;もうじゃども　(ＥＸ)（ゲージレベル１／３）
[State -1, Fast Kung Fu Palm]
type = ChangeState
value = 1020
triggerall = command = "QCF_xy"
triggerall = power >= 330
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = NumProj = 0
trigger1 = var(1) ;Use combo condition (above)

;---------------------------------------------------------------------------
;Light Kung Fu Palm
;もうじゃども（弱）
[State -1, Light Kung Fu Palm]
type = ChangeState
value = 1000
triggerall = command = "QCF_x"
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = NumProj = 0
trigger1 = var(1) ;Use combo condition (above)

;---------------------------------------------------------------------------
;Strong Kung Fu Palm
;もうじゃども（強）
[State -1, Strong Kung Fu Palm]
type = ChangeState
value = 1010
triggerall = command = "QCF_y"
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = NumProj = 0
trigger1 = var(1) ;Use combo condition (above)

;---------------------------------------------------------------------------
;Strong Kung Fu Palm
;もうじゃだまし
[State -1, Strong Kung Fu Palm]
type = ChangeState
value = 196
triggerall = command = "QCF_s"
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = var(1) ;Use combo condition (above)

;---------------------------------------------------------------------------
;Light Kung Fu Upper
;じんにくがすきなもんすたー（弱）
[State -1, Light Kung Fu Upper]
type = ChangeState
value = 1100
triggerall = ctrl
triggerall = statetype != A
trigger1 = var(20) = 0    ;CPUではないとき
trigger1 = command = "jinniku_x"
trigger2 = var(20) = 0    ;CPU
trigger2 = P2BodyDist X = [3,35]
trigger2 = p2statetype  = S
trigger2 = p2statetype  = C
trigger2 = p2statetype != A

;---------------------------------------------------------------------------
;Strong Kung Fu Upper
;じんにくがすきなもんすたー（強）
[State -1, Strong Kung Fu Upper]
type = ChangeState
value = 1150
triggerall = ctrl
triggerall = statetype != A
trigger1 = var(20) = 0    ;CPUではないとき
trigger1 = command = "jinniku_y"
trigger2 = var(20) = 0    ;CPU
trigger2 = P2BodyDist X = [36,55]
trigger2 = p2statetype  = S
trigger2 = p2statetype  = C
trigger2 = p2statetype != A

;---------------------------------------------------------------------------
;かえりちにかしょＥＸ (1/3 super bar)
[State -1, kaeriti]
type = ChangeState
value = 1220
triggerall = statetype = A
triggerall = !NumHelper(185)
triggerall = stateno != 5040
triggerall = power >= 330
triggerall =  Pos Y < -40
triggerall  = command = "QCB_xy"
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = ctrl
trigger2 = stateno = [600,630]
trigger2 = movecontact
trigger3 = stateno = 1210
trigger3 = Ctrl = 0

;---------------------------------------------------------------------------
;かえりちにかしょ（弱）
[State -1, Light Kung Fu Blow]
type = ChangeState
value = 1200
triggerall = statetype = A
triggerall = !NumHelper(185)
triggerall = stateno != 5040
triggerall =  Pos Y < -35
triggerall  = command = "QCB_x"
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = ctrl
trigger2 =  stateno = 600 || stateno = 610 || stateno = 630
trigger2 = movecontact

;---------------------------------------------------------------------------
;かえりちにかしょ（強）
[State -1, Strong Kung Fu Blow]
type = ChangeState
value = 1210
triggerall = statetype = A
triggerall = !NumHelper(186)
triggerall = stateno != 5040
triggerall =  Pos Y < -35
triggerall  = command = "QCB_y"
triggerall = var(20) = 0    ;CPUではないとき
trigger1 = ctrl
trigger2 =  stateno = 600 || stateno = 610 || stateno = 630
trigger2 = movecontact

