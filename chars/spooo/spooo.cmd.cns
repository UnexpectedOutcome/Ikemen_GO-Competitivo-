;------------------------------------------------------------------------------
;チェーンコンボと空中コンボ編（中級AI）

;空中コンボ
[State -1, 追撃弱パンチ];ジャグルポイントが極端に低く、hitflag = AFを含む技 
type = ChangeState
value = 200
triggerall = roundstate = 2
triggerall = var(20) = 1
triggerall = statetype != A
triggerall = p2bodydist X = [-5,32]       ;至近距離
triggerall = p2bodydist Y = [-70,-15]     ;高い位置の相手
triggerall = Random > (p2bodydist X +5)*3 ;近いほど高確率
triggerall = enemy,hitfall = 1            ;相手が吹き飛びダウン中
trigger1   = ctrl                         ;チェーン始動要因になり得る
trigger2   = stateno = 200                ;連打キャンセル
trigger2   = time = 11                    ;最大ディレイ(チーム用)

;真・空中コンボ
[State -1, 弱カンフー蹴り];カンフーマンの真の空中コンボ判定技は必殺技以上の技です
type = ChangeState
value = 1310
triggerall = roundstate = 2
triggerall = var(20) = 1
triggerall = p2bodydist X = [-10,92]
triggerall = p2bodydist Y = [-90,-50]
triggerall = Random > (p2bodydist X +10)*2
triggerall = enemy,hitfall = 1
trigger1   = statetype != A
trigger1   = ctrl 


;立ち攻撃三連チェーンコンボ
[State -1, 弱パンチから弱キック]
type = ChangeState
value = 230
triggerall = movecontact                  ;最重要
triggerall = var(20) = 1
triggerall = var(21) < 70                 ;高確率(100％は×、不気味だし)
triggerall = p2bodydist Y = [-20,5]       ;低い位置の相手
trigger1   = p2bodydist X = [1,44]        ;近距離限定
trigger1   = (stateno = 200) && time = 8  ;最速タイミング(絶対に間違えないように！)
trigger2   = p2bodydist X = [1,32]        ;超近距離限定
trigger2   = (stateno = 230) && time = 10 ;弱キックからでも始動可にする

[State -1, 弱パンチorキックから強パンチ]
type = ChangeState
value = 210
triggerall = movecontact
triggerall = var(20) = 1
triggerall = var(21) < 70                ;大抵の製作者は確率を使わない所ですね…
trigger1   = p2bodydist X = [31,44]      ;上でキックが当たらない時は ↓
trigger1   = (stateno = 200) && time = 6 ;2連チェーンにするため
trigger2   = p2bodydist X = [31,42]      ;ヒットバックが大きいのでやや短め
trigger2   = (stateno = 230) && time = 7

[State -1, 弱パンチorキックから強キック]
type = ChangeState
value = 240
triggerall = movecontact
triggerall = var(20) = 1
triggerall = var(21) < 70                ;実は…　statedef -3と確率を分けています(重要)
triggerall = p2bodydist Y = [-20,5]
trigger1   = p2bodydist X = [20,32]
trigger1   = (stateno = 200) && time = 6 ;timeを誤ると「卑怯キャラ」の誕生です…
trigger2   = p2bodydist X = [20,30] 
trigger2   = (stateno = 230) && time = 7 ;≧と＞の区別はついていますか？


;しゃがみ攻撃2連チェーンコンボ（おまけ）

[State -1, しゃがみ弱キックから弱キック]
type = ChangeState
value = 430
triggerall = movecontact                  ;最重要
triggerall = var(20) = 1
triggerall = var(21) < 85                 ;高確率(100％は×、不気味だし)
triggerall = p2bodydist Y = [-20,5]       ;低い位置の相手
trigger1   = p2bodydist X = [1,48]        ;超近距離限定
trigger1   = (stateno = 230) && time = 8 ;弱キックからでも始動可にする


[State -1, しゃがみ弱パンチorキックからしゃがみ強パンチ]
type = ChangeState
value = 410
triggerall = var(20) = 1
triggerall = p2bodydist X = [0,18]
triggerall = var(21) != [40,63]    ;こんな指定法もある
trigger1   = (stateno = 400) || (stateno = 430)
trigger1   = movehit && time = 6

[State -1, しゃがみ弱パンチorキックからしゃがみ強キック]
type  = ChangeState
value = 440         ;ダウンさせるとコンボができないので厄介
triggerall = var(20) = 1
triggerall = p2bodydist X = [20,38]
triggerall = var(21) != [40,63]    ;63より大きいか40未満の時
trigger1   = (stateno = 400) || (stateno = 430)
trigger1   = movehit && time = 6


;立ちチェーンから板投げ（応用）
[State -1, トドメの一撃]
type = ChangeState
value = 1300                                  ;ここで必殺技を出すと良い感じになる
triggerall = var(20) = 1                      ;何故メジャーなカンフー突き手ではないのかというと ↓
triggerall = numhelper(1200) = 0              ;飛び道具は自分が前に移動しない分、↓
triggerall = numprojID(1200) = 0              ;失敗した時に安全だからです。 ↓
triggerall = power < 3000                     ;リュウも大抵、コンボには波動拳を使いますよね？
triggerall = (stateno=210) || (stateno=240)   ;強パンチorキックが ↓
triggerall = movehit                          ;ヒットしたら
trigger1 = prevstateno=200 || prevstateno=230 ;単発ではなくチェーンコンボの時 ↓
trigger1   = var(21) < 90                     ;ほぼ確実に出す
trigger2   = var(21) < 30                     ;単発ヒットだったら普通の確率になる

[State -1, トドメの一撃]
type = ChangeState
value = ifelse(var(21) > 500, 1000,196)       ;ここで必殺技を出すと良い感じになる
triggerall = var(20) = 1                      ;何故メジャーなカンフー突き手ではないのかというと ↓
triggerall = Life > 1650
triggerall = (stateno=210) || (stateno=240)   ;強パンチorキックが ↓
triggerall = MoveGuarded
trigger1 = prevstateno=200 || prevstateno=230 ;単発ではなくチェーンコンボの時 ↓
trigger1   = var(21) < 20                     ;ほぼ確実に出す
trigger2   = var(21) < 50                     ;単発ヒットだったら普通の確率になる


;チェーンから三烈カンフー突き手（応用）
[State -1, スーパーコンボ]
type = ChangeState
value = 1320       ;statedef -3に同じ技があるので、本当はそちらに書き加えるのがベター
triggerall = power >= 2000   ;ゲージMAXの時限定
triggerall = var(20) = 1
triggerall = (stateno = 210) || (stateno = 230) || (stateno = 240)
triggerall = movehit
trigger1   = prevstateno = 200 || prevstateno = 230  ;410の時は意味なし
trigger1   = var(21) < 90
trigger2   = var(21) < 30


;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
;-------------------------------------
;毒効果（ドロウィンアルカナ)
[state -2, 0]
type = poweradd
triggerall = enemy,authorname = "Drowin arcana"
triggerall = enemy,fvar(20) > 0
trigger1 = power > 0
value = -1
[state -2, 0]
type = lifeadd
triggerall = enemy,authorname = "Drowin arcana"
triggerall = enemy,fvar(20) > 0
trigger1 = gametime % 7 = 0
value = -1
kill = 0
[State -2,0]
type = Palfx
triggerall = enemy,authorname = "Drowin arcana"
trigger1 = enemy,fvar(20) > 0
add = 100,0,110
mul = 220,220,220
time = 5
ignorehitpause = 1
;--------------------------------------

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

;Random Mode Change------------------------------------------------------
[State -3, Random_AIvar]
type     = VarRandom
trigger1 = stateno != [120,155] ;ガード時の不具合解消
trigger1 = Time = 1
v     = 58
range = 0,99
