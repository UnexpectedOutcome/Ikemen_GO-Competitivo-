;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
;------------------------------------------------------------------------
;CPU用ガード

;CPU用しゃがみガード
[Statedef 131]
type    = C
physics = C

[State 131, コモン]
type = ChangeAnim
trigger1 = Anim != 131
value = 131

[State 131, CPU用含む]
type = ChangeState
trigger1 = Var(20) = 0
trigger1 = command != "holddown"
trigger2 = Var(20) = 1
trigger2 = p2statetype = A ;この辺は何か良い案がほしい…
trigger2 = time = 1        ;これを付けないと強制終了した
value = 130

[State 131, コモン]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;ガードエンド
[Statedef 140]
type = U
physics = U
ctrl = 1

[State 140, コモン1]
type = ChangeAnim
trigger1 = Time = 0
value = 140 + (statetype = C) + (statetype = A)*2

[State 140, コモン2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 140, コモン3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 140, コモン4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 140, CPU用含むHtoL]
type = StateTypeSet
trigger1 = Var(20) = 0
trigger1 = statetype = S && command = "holddown"
trigger2 = Var(20) = 1
trigger2 = statetype = S && p2statetype = C
statetype = C
physics = C

[State 140, CPU用含むLtoH]
type = StateTypeSet
trigger1 = Var(20) = 0
trigger1 = statetype = C && command != "holddown"
trigger2 = Var(20) = 1
trigger2 = statetype = C && p2statetype = A
trigger3 = Var(20) = 1
trigger3 = statetype = C && p2statetype = S
trigger3 = Var(21) = [0,19]
statetype = S
physics = S

