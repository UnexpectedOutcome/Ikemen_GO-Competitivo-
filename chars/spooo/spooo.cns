;type = PlaySnd
;trigger1 = AnimElem = 27
;value = s5,5

[State 191, Snd 1]
type = PlaySnd
trigger1 = AnimElem = 24
value = s11,1

[State 191, ti]
type = Explod
trigger1 = AnimElem = 16 || AnimElem = 21
anim = 6101
postype = p1
pos = -30, -100
removetime = 20

[State 191, ti]
type = Explod
trigger1 = AnimElem = 18 || AnimElem = 21
anim = 6100
postype = p1
pos = 0, -110
removetime = 20

[State 191, ti]
type = Explod
trigger1 = AnimElem = 20
anim = 6101
postype = p1
pos = -30, -115
removetime = 20

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

