;---------------------------------------------------------------------------
; ここからは超必殺技のステート
;---------------------------------------------------------------------------
; CNS レベル: 中級
;
; 超必殺技でのHitDefでは「getpower = 0」があるのに注目してください。
; 攻撃が当たってもパワーゲージを回復させないためです。
;

[Statedef 3000]
type     = S
movetype = A
physics  = S
juggle   = 0
velset   = 0,0
anim     = 3000
ctrl     = 0
sprpriority = 1

[State 3000, 物理的なキャラの幅]
type = Width
trigger1 = AnimElem = 2, >= 0
value = 15,0

[State 3000, 残像]
type = AfterImage
trigger1 = Time = 0
length = 13
PalBright   =    0, 0, 30
PalContrast =  20, 20, 70
PalAdd      = -10,-10,-10
PalMul      = .50,.50,.85
TimeGap  = 1
FrameGap = 2
Trans = Add
time = 2

[State 1020, Afterimage]
type = AfterImageTime
trigger1 = AnimElemTime(8) < 0
time = 2

[State 1320, 色の変更]
type = PalFX
trigger1 = Time = 0
time = 30
add = 0,0,128
sinadd = 64,32,5,3

[State 3000, 超必殺技発動の時間停止]
type = SuperPause
trigger1 = time = 0
time = 30
pos = -5, -182
anim = s6410
sound = 20, 0
movetime = 30
poweradd = -1000

[State 3000, カンフーボイス]
type = PlaySnd
trigger1 = AnimElem = 2
value = 3000,0
channel = 4

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 4
value = 5, 0

[State 3000, 振動]
type = EnvShake
trigger1 = AnimElem = 5
time = 21
ampl = -6

[State 3000, 無敵]
type = NotHitBy
trigger1 = AnimElem = 3
value = , NA, SA, AT, NP, SP 
time = 9

[State 3000, 無敵]
type = NotHitBy
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(5) < 0
value2 = C, NA, AT
time = 1

[State 3000, 飛び道具を出す] 
type = Projectile
trigger1 = AnimElem = 4
attr = S, HP
damage = 72,2
getpower = 0,
animtype = Up
pausetime = 0,12
offset = 15,-37              ;飛び道具の出現位置
velocity = 0,0
accel = 0,0                 ;飛び道具の加速度
projID = 3000               ;飛び道具のＩＤナンバー
projanim = 3001             ;飛び道具のアニメ
;projhitanim = 1203          ;飛び道具がヒットした時のアニメ
;projremanim = 1203          ;飛び道具が消える時のアニメ
;projcancelanim = 1203       ;飛び道具相殺時のアニメ（未記入時はprojremanimと同じ）
projscale = 1.5,1.5             ;飛び道具の大きさ（今は２倍）
projshadow = 0,0,0          ;飛び道具の影（現在は0,0,0なので影無し）
projhits = 3                ;飛び道具のヒット数
projmisstime = 1            ;飛び道具がヒットしない間隔（２ヒット以上のみ作用する）
projpriority = 3            ;飛び道具の攻撃優先度
projsprpriority = 3         ;飛び道具の描画優先度。DEF=2
projremove = 0              ;0にするとヒット後に飛び道具が消えない。
projremovetime = 54         ;飛び道具が消えるまでの時間（-1なので画面外に出るか当たるまで消えない）
projedgebound = 40          ;飛び道具が画面の外に進める距離。DEF=40
projstagebound = 40         ;飛び道具がステージの外に進める距離。DEF=40
projheightbound = -240,1    ;飛び道具が画面の上下に進める距離。DEF=-240,1
hitflag = MAF
guardflag = M
sparkno = 2
sparkxy = 0,0
guard.sparkno = 40
hitsound = 5,3
guardsound = 6,0
ground.type = High
ground.slidetime = 14
ground.hittime = 16
ground.velocity = -6,-10
air.velocity = -5,-8
air.juggle = 8
fall = 1
fall.recover = 0             ;ヒットした時に相手が空中受け身を取れるかどうか（0=取れない・1=取れる）
mindist = 50,-100            ;相手の吹っ飛ぶ最短の距離を決めます
maxdist = 100,-10            ;相手の吹っ飛ぶ最長の距離を決めます
yaccel = .8                  ;相手に与える落下加速度、速く落としたりゆっくり落としたりできる

