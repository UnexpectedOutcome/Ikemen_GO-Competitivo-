;-----基本情報------------------------------------------------------
[Info]
Name         = "rena_lv5"   ;キャラの名前（後々必要な場合があるので省略不可）
DisplayName  = "Ryugu_Rena"   ;ゲーム中表示される名前（省略可能）
VersionDate  = 06,18,2008      ;キャラの最終更新日
MugenVersion = 04,14,2002      ;このキャラを使用出来るM.U.G.E.Nのバージョン
Author       = "baggy"      ;このキャラの作成者の名前
Pal.Defaults = 1,2,3,4         ;CPUで出てくるキャラカラーの順番

;-----必要なファイルの設定------------------------------------------
[Files]
Cmd      = rena_lv5.cmd          ;入力コマンド定義ファイルの登録
Cns      = rena_lv5.cns          ;基本ステータス情報ファイルの登録
St       = rena_lv5.cns          ;動作プログラムファイルの登録（最大１０個くらい増やせます（St,St0,St1,St2......））
St0      = rena_lv5_-2-3.cns

StCommon = common1.cns      ;コモン動作プログラムファイルの登録
Sprite   = rena_lv5.sff          ;複数のPCX画像を１パック化したスプライトファイルの登録
Anim     = rena_lv5.air          ;アニメーションファイルの登録
Sound    = rena_lv5.snd          ;複数のWAV音声を１パック化したサウンドファイルの登録
movelist = movelist.dat

;---カラーパレットファイルの設定（最大１２個まで可能）---
Pal1 = rena_lv5_1.act
Pal6 = rena_lv5_1.act
Pal7 = rena_lv5_1.act
Pal8 = rena_lv5_1.act
Pal9 = rena_lv5_1.act
Pal10 = rena_lv5_1.act
Pal11 = rena_lv5_1.act
Pal12 = rena_lv5_1.act

;-----ストーリーボード設定------------------------------------------
[Arcade]
