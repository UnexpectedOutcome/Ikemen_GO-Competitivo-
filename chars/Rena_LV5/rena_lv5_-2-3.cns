IgnoreHitPause = 1

;■1度敗北後のパワー自動回復■■■■■■■■■■■■■■■■
[State -3]
type =Poweradd
trigger1 = var(50) >= 1
value = 1

;以下は廃止
;■1度敗北後のライフ自動回復■■■■■■■■■■■■■■■■
