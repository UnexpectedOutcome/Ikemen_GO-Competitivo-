;■攻撃力変化■■■■■■■■■■■■■■■■
;■ヒートまたは一度敗北時に攻撃力 10% UP
[State -3]
type = AttackMulSet
trigger1 = var(50) !=0
trigger2 = var(56) !=0
value = 1.1

;■攻撃力UP解除
[State -3]
type = AttackMulSet
trigger1 =var(50) =0
trigger1 =var(56) =0
value = 1

;■根性値（防御力変化）■■■■■■■■■■■■■■■■
[State -1, DefenceMulSet]
Type = DefenceMulSet
Trigger1 = Life <= 800
Trigger1 = Life >= 601
Value = 0.95
IgnoreHitPause = 1

[State -1, DefenceMulSet]
Type = DefenceMulSet
Trigger1 = Life <= 600
Trigger1 = Life >= 401
Value = 0.9
IgnoreHitPause = 1

[State -1, DefenceMulSet]
Type = DefenceMulSet
Trigger1 = Life <= 400
Trigger1 = Life >= 151
Value = 0.8
IgnoreHitPause = 1

[State -1, DefenceMulSet]
Type = DefenceMulSet
Trigger1 = Life <= 150
Value = 0.5
IgnoreHitPause = 1

;■一度負けたかどうかの判定■■■■■■■■■■■■■■■■
[State -1] 
type=varadd
trigger1 = lose
trigger1 = var(50)=0
var(50) = 1


;■常時ヒートのエフェクト■■■■■■■■■■■■■■■
[State -1, AfterImage]
type = AfterImage
trigger1 = AnimElem = 1
Trigger1 = var(50) >=1
trans = Add
TimeGap = 1
FrameGap = 3
time = 99999
PalBright = 0,0,0
PalContrast = 70,70,70
PalAdd = 0,0,160
PalMul = 1,1,1

;■ヒート■■■■■■■■■■■■■■■
[State -3, AfterImage]
Type = AfterImage
Trigger1 = Var(56) = 1
Trigger1 = var(50) =0
trans = Add
time = -1
TimeGap = 1
FrameGap = 3
time = 99999
PalBright = 0,0,0
PalContrast = 70,70,70
PalAdd = 10,10,0
PalMul = 1,1,1

[State -1, AfterImage]
Type = varadd
Trigger1 = Var(56) = 1
v =56
value =1

[State -3]
type =varadd
trigger1 = var(56)>=1
v = 55
value = -1

[State -3, AfterImage]
Type = AfterImage;Time
Trigger1 = Var(56) = 2
trigger1 = var(55) <=0
trigger1 = var(50) = 0
Time        = 1

[State -3]
type =varset
trigger1 = var(55)<0
v = 56
value = 0

;■ Statedef -3 ■■■■■■■■■■■■■■■■■■■■■■■■
[Statedef -3]

;■Life回復タイミング
[State -3]
