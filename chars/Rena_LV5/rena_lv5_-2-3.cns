;空中立ち回り技振り 
;Ctrl Random EnemyNear,Movetype = I inguarddist P2bodyDist Y P2bodyDist X
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

;■空中弱キック
[State -3,空中弱キック]
Type = ChangeState
Value = 630
TriggerAll = var(59)!=0
;TriggerAll = RoundState = 2
TriggerAll = StateType = A
TriggerAll = EnemyNear,StateType != L
TriggerAll = EnemyNear,MoveType = I
TriggerAll = !InGuardDist
TriggerAll = P2BodyDist X-EnemyNear,vel x*3+vel x*3 = [-30,88+30]
TriggerAll = P2BodyDist Y-EnemyNear,vel y*3+vel y*3 = [-20,150]
Trigger1 = Ctrl || ((StateNo=110||StateNo=115)&&Time>=4)
Trigger1 = Random <= var(59)*45

;■空中投げ
[State -3,空投げ]
Type     = ChangeState
Value = 850
TriggerAll = var(59)!=0
TriggerAll = RoundState = 2
TriggerAll = StateType = A
TriggerAll = EnemyNear,StateType = A
TriggerAll = P2bodydist X < 55
TriggerAll = P2bodydist Y > -80
TriggerAll = P2bodydist Y < 20
TriggerAll = EnemyNear,MoveType != H
TriggerAll = EnemyNear,StateType != L
triggerall = Pos Y <= -20
TriggerAll = Ctrl
;Trigger1 = Random <= var(59)*30
Trigger1 = EnemyNear,StateNo = [120,159]
Trigger1 = Random <= var(59)*36


