;■Statedef -2■■■■■■■■■■■■■■■■■■■■■
[Statedef -2]

;■debug用■■■■■■■■■■■■
[State -2, 距離確認デバック]
type = AppendToClipboard
trigger1 = 1
text =  "P2X:%f,P2Y:%f,Vx%f,Vy%f,Py%f \n"
params = p2bodydist x, p2bodydist y,vel x,vel y,Pos y
IgnoreHitPause = 1



;■ダメージ喰らい音声ランダム選択■■■■■■■■■■■■■■■■
[State -2, PlaySnd]
Type = PlaySnd
TriggerAll = Var(11) = 2
TriggerAll = Time = 0
Trigger1 = StateNo = 5000
Trigger2 = StateNo = 5010
Trigger3 = StateNo = 5020
Trigger4 = StateNo = 5070
Value = s0,6
Channel = 4

[State -2, PlaySnd]
Type = PlaySnd
TriggerAll = Var(11) = 3
TriggerAll = Time = 0
Trigger1 = StateNo = 5000
Trigger2 = StateNo = 5010
Trigger3 = StateNo = 5020
Trigger4 = StateNo = 5070
Value = s3,4
Channel = 4

[State -2, PlaySnd]
Type = PlaySnd
TriggerAll = Var(11) = 4
TriggerAll = Time = 0
Trigger1 = StateNo = 5000
Trigger2 = StateNo = 5010
Trigger3 = StateNo = 5020
Trigger4 = StateNo = 5070
Value = s0,8
Channel = 4

