[Statedef -1];必須項目
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;コンボ用変数
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1, Combo]
type = VarSet
triggerall = !IsHelper
trigger1 = 1
var(1) = 0

[State -1, Combo];通常技キャンセル
type = VarSet
triggerall = !IsHelper
trigger1 = stateno = 200 && AnimElemTime(3) > 0 && AnimElemTime(4) < 2
trigger2 = stateno = 205 && AnimElemTime(3) > 0 && AnimElemTime(4) < 2
trigger3 = stateno = 215 && AnimElemTime(4) > 0 && AnimElemTime(9) < 0
trigger4 = stateno = 235 && AnimElemTime(5) > 0 && AnimElemTime(6) < 2
trigger5 = stateno = 245 && AnimElemTime(5) > 0 && AnimElemTime(6) < 2
trigger6 = stateno = 250 && AnimElemTime(6) > 0 && AnimElemTime(7) < 0
trigger7 = stateno = 400 && AnimElemTime(3) > 0 && AnimElemTime(4) < 2
trigger8 = stateno = 410 && AnimElemTime(4) > 0 && AnimElemTime(5) < 0
trigger9 = stateno = 430 && AnimElemTime(3) > 0 && AnimElemTime(4) < 2
trigger10= stateno = 600 && AnimElemTime(3) > 0 && AnimElemTime(4) < 2
trigger11= stateno = 610 && Anim=610 && AnimElemTime(4) > 0 && AnimElemTime(5) < 2
trigger12= stateno = 610 && Anim=615 && AnimElemTime(5) > 0 && AnimElemTime(6) < 0
trigger13= stateno = 630 && AnimElemTime(3) > 0 && AnimElemTime(4) < 2
trigger14= stateno = 640 && Anim=640 && AnimElemTime(3) > 0 && AnimElemTime(4) < 2
trigger15= stateno = 640 && Anim=645 && AnimElemTime(5) > 0 && AnimElemTime(9) < 0
trigger16= stateno = 650 && AnimElemTime(6) > 0 && AnimElemTime(7) < 0
var(1) = 1

[State -1, Combo];特殊技キャンセル
type = VarSet
triggerall = !IsHelper
trigger1 = stateno = 300 && AnimElemTime(6) > 0 && AnimElemTime(7) < 0
trigger2 = stateno = 301 && AnimElemTime(6) > 0 && AnimElemTime(7) < 0
trigger3 = stateno = 320 && AnimElemTime(7) > 0 && AnimElemTime(9) < 0
var(1) = 2

[State -1, Combo];スパキャン
type = VarSet
triggerall = !IsHelper
triggerall = var(47)
trigger1 = stateno = 1100 && AnimElemTime(6)>0 && AnimElemTime(8)<0
trigger2 = stateno = 1101 && AnimElemTime(6)>0 && AnimElemTime(8)<0
trigger3 = stateno = 1210 && AnimElemTime(4)>0
var(1) = 3

[State -1, Combo];ドリキャン
type = VarSet
triggerall = !IsHelper
triggerall = var(48)
trigger1 = stateno=3101 && AnimElemTime(5)>0
var(1) = 4

[State -1, Combo];MAXキャン
type = VarSet
triggerall = !IsHelper
triggerall = var(49)
trigger1 = stateno=3101 && AnimElemTime(5)>0
var(1) = 5
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;MAX2 && NEOMAX超必殺技
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -1,236236YB];NEOMAX
type = ChangeState
value = 3700
triggerall = var(59)!
