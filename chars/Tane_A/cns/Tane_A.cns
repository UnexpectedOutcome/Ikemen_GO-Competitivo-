;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 100, 音を鳴らす]
type = PlaySnd
triggerall = time = 4
trigger1 = Alive
loop = 1
value = s5,0
channel = 6

[State 100, 1]
type = VelSet
trigger1 = AnimElemtime(2) >= 0
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 音を止める]
type = StopSnd
triggerall = !IsHelper
triggerall = time >= 4
trigger1 = !Alive
trigger2 = command != "holdfwd"
channel = 6

[State 100, 4]
type = ChangeState
triggerall = !IsHelper
trigger1 = !var(59)
trigger1 = command = "holdup"
value = 40

[State 100, 4]
type = ChangeState
triggerall = !IsHelper
triggerall = time >= 8
trigger1 = !var(59)
trigger1 = command != "holdfwd"
trigger2 = var(59)
trigger2 = P2BodyDist X<=20
value = 101
