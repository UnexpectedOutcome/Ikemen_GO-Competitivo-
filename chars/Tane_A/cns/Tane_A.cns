[Data]
life = 1000
attack = 95
defence = 100
power = 5000
fall.defence_up = 50
liedown.time = 16
airjuggle = 99
sparkno = 0
guard.sparkno = 40
KO.echo = 0
volume = 50
IntPersistIndex = 40
FloatPersistIndex = 20
;---------------------------------------------------------------------------
[Size]
xscale = 1           ; 水平サイズ倍率
yscale = 1           ; 垂直サイズ倍率
ground.back = 17     ; キャラ幅（地上、後ろ側）
ground.front = 17    ; キャラ幅（地上、前側）
air.back = 15        ; キャラ幅（空中、後ろ側）
air.front = 15       ; キャラ幅（空中、前側）
z.width = 10         ; キャラ幅（ｚ軸）
height = 30	     ; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 5,-60    ; 頭部座標
mid.pos = -10,-40     ; 体中心部座標
shadowoffset = 0     ; キャラの影・オフセット値
;---------------------------------------------------------------------------
[Velocity]
walk.fwd  = 4.5		; 前進速度
walk.back = -3.4		; 後退速度
run.fwd  = 6.3, 0		; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -12,-4		; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-9.5		; 垂直ジャンプ速度
jump.back = -2.5		; 後方ジャンプ速度
jump.fwd = 3.5		; 前方ジャンプ速度
runjump.back = -5,-9.5	; 後方ジャンプ速度（ダッシュ中）
runjump.fwd = 4,-9.5		; 前方ジャンプ速度（ダッシュ中）
airjump.neu = 0,0		; 空中垂直ジャンプ速度
airjump.back = 0,0		; 空中後方ジャンプ速度
airjump.fwd = 0,0		; 空中前方ジャンプ速度
;---------------------------------------------------------------------------
[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .6
stand.friction = .85
crouch.friction = .82
;---------------------------------------------------------------------------
;var(0) コマンド判別
;var(1) コンボ用
;var(2) ジャンプ確認用
;var(3) ウメ使用フラグ
;var(4) ウメ使用可能時間管理
;var(5) ウメコマンド判別
;var(6) スパキャンフラグ
;var(10) MAX状態処理(残り時間)
;var(11) アーマーモード確認用
;var(12) アーマーモードダメージ記憶
;var(16) ガーキャン確認
;var(31)~var(32) 横ため認識
;var(33)~var(34) 下ため認識
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
