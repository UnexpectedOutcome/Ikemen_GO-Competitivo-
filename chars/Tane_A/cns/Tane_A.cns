; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 0]
type = ChangeState 
triggerall = var(59) = 1
trigger1 = time = 0 
value = 0
ctrl = 1

[state 40, 1]
type = turn
trigger1 = time = 0
trigger1 = p2dist x < 0

[State 40, 2]
type = NotHitBy
trigger1 = 1
value = , AT

[State 40, 3]
type = AfterImage
trigger1 = time = 0
time = 1

[State 40, 4]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 5]
type = VarSet
triggerall = !IsHelper
trigger1 = Time = 0
trigger1 = command = "holdfwd"
sysvar(1) = 1 + (1 * var(2)>0)

[State 40, 6]
type = VarSet
triggerall = !IsHelper
trigger1 = Time = 0
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 7]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1) = 0, const(velocity.jump.neu.x), ifelse(sysvar(1) >= 1, const(velocity.jump.fwd.x), const(velocity.jump.back.x))) * ifelse((sysvar(1) = 2 || sysvar(1) = -2),1.5,1)
y = const(velocity.jump.y)

[State 40, 8]
type = ChangeState
triggerall = !IsHelper
trigger1 = AnimTime = 0
trigger1 = command != "holdup"
value = 55
ctrl = 0

[State 40, 9]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
