[State 0, Elephant Gun & Pull]
type = ChangeState
triggerall = power >= 1000
triggerall = stateno = [0,180]
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = p2bodydist x = [0,100]
trigger1 = random < (ailevel * 100)/4
value = ifelse(power >= 2000,1200,1000)

[State 0, Elephant Axe]
type = ChangeState
triggerall = power >= 1000
triggerall = stateno = [0,180]
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = p2bodydist x < 80
trigger1 = random < (ailevel * 100)/4
value = ifelse(power >= 1500,1250,1020)


[State 0, finger shoot]
type = ChangeState
triggerall = power >= 1000
triggerall = stateno = [0,180]
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = p2bodydist x > 80
trigger1 = random < (ailevel * 100)/10
value = ifelse(power >= 1000,1200,1050)

[State 0, Tri mode on]
type = ChangeState
triggerall = var(12) != 10000
triggerall = stateno = [0,180]
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = p2bodydist x > 40
trigger1 = life <= lifemax/2
trigger1 = ailevel > 0
value = 1300

[State 0, Tri mode off]
