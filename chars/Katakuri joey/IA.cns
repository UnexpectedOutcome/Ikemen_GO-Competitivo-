[Statedef -2]

[State 0, Run]
type = ChangeState
triggerall = var(5) = 0
triggerall = stateno != 60
triggerall = stateno != 65
triggerall = stateno != 70
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/2
value = ifelse(pos y >= 0,60,65)

[State 0, Run Atras]
type = ChangeState
triggerall = var(5) = 0
triggerall = stateno != 60
triggerall = stateno != 65
triggerall = stateno != 70
triggerall = backedgebodydist > 50
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 100 && p2movetype = A
trigger1 = random < (ailevel * 100)/4
value = 70

[State 0, Guard]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = (p2bodydist x < 50 && p2movetype = A) || (enemy,numproj > 0)
trigger1 = random < (ailevel * 100)/2
value = ifelse(statetype = A,132,130)

[State 0, Power Charge]
type = ChangeState
triggerall = statetype != A
Triggerall = power < 6000
triggerall = stateno = [0,180]
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 60
trigger1 = random < (ailevel * 100)/4
trigger2 = random < (ailevel * 100)/4
Trigger2 = power < 2000
trigger2 = p2bodydist x > 100
trigger3 = p2life < enemy,lifemax/4
trigger3 = power < 3000
value = 500


[State 0, Power Charge End]
type = ChangeState
triggerall = time >= 12
triggerall = p2life > enemy,lifemax/4
Triggerall = power > 1000
triggerall = stateno = 500
triggerall = ailevel > 0
trigger1 = random < (ailevel * 100)/10
trigger2 = p2bodydist x = [0,40]
value = 501



[State 0, A]
type = ChangeState
triggerall = statetype != A
triggerall = power <= 1200
triggerall = stateno = [0,180]
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 30
triggerall = p2bodydist x = [10,40]
trigger1 = random < (ailevel * 100)/2
value = 200

[State 0, B]
type = ChangeState
triggerall = statetype != A
triggerall = power <= 2200
triggerall = stateno = [0,180]
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 30
trigger1 = random < (ailevel * 100)
value = 300

[State 0, C]
type = ChangeState
triggerall = power <= 1200
triggerall = stateno = [0,180]
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x = [20,80]
trigger1 = random < (ailevel * 100)
value = 400

[State 0, A Aire]
type = ChangeState
triggerall = statetype = A
triggerall = stateno = [0,180]
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x = [0,30]
trigger1 = random < (ailevel * 100)
value = 600

[State 0, A Aire -Tri]
