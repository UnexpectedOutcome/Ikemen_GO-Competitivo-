;-------------------------------------------------------------------------------
;タメ処理
;-------------------------------------------------------------------------------
[state 99999, 後ろ離し後猶予減少]
type = varadd
trigger1 = var(10) >= 10000
v = 10
value = -10000

[state 99999, 後ろ溜め完了認識]
type = varset
trigger1 = command != "holdback"
trigger1 = var(10)%100 >= 20
trigger1 = var(10) < 10000
v = 10
value = 100000

[state 99999, 後ろ溜め時間加算]
type = varadd
trigger1 = command = "holdback"
trigger1 = var(10)%100 < 20
v = 10
value = 1
 
[state 99999, 前溜め時間加算]
type = varadd
trigger1 = command = "holdfwd"
trigger1 = (var(10)%10000)/100 < 99
v = 10
value = 100

[state 99999, 後ろ離し認識]
type = varset
trigger1 = command != "holdback"
trigger2 = (var(10)%10000)/100 >= 3
v = 10
value = var(10)-var(10)%100

[state 99999, 前離し認識]
type = varset
trigger1 = command != "holdfwd"
v = 10
value = var(10)-((var(10)%10000)/100)*100

[state 99999, 後ろ溜め認識リセット]
type = varset
trigger1 = var(10) < 0
v = 10
value = 0

[state 99999, 下離し後猶予減少]
type = varadd
trigger1 = var(20) >= 10000
v = 20
value = -10000

[state 99999, 下溜め完了認識]
type = varset
trigger1 = command != "holddown";
trigger1 = var(20)%100 >= 20;この数字が溜めに必要な時間（単位はフレーム）になります
trigger1 = var(20) < 10000
v = 20
value = 100000;溜め方向用のキーを離してから、コマンドを完成させるまでの猶予フレーム×10000を代入

[state 99999, 下溜め時間加算]
type = varadd
trigger1 = command = "holddown"
trigger1 = var(20)%100 < 20
v = 20
value = 1

[state 99999, 上溜め時間加算]
type = varadd
trigger1 = command = "holdup"
trigger1 = (var(20)%10000)/100 < 99
v = 20
value = 100

[state 99999, 下離し認識]
type = varset
trigger1 = command != "holddown"
trigger2 = (var(20)%10000)/100 >= 3
v = 20
value = var(20)-var(20)%100

[state 99999, 上離し認識]
type = varset
trigger1 = command != "holdup"
v = 20
value = var(20)-((var(20)%10000)/100)*100

[state 99999, 下溜め認識リセット]
type = varset
trigger1 = var(20) < 0
v = 20
value = 0

