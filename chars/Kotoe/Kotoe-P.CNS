:------------------------------------------------------------------------------
[Statedef 100]
type    = S
physics = S
anim = 100
ctrl = 0
sprpriority = 1

[State 100, VelSet]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, PlaySnd]
type = null;PlaySnd
trigger1 = StateNo = 100 && (AnimElem = 2 || AnimElem = 5)
value = 1,0
channel = 4

[State 100, ChangeState]
type = ChangeState
trigger1 = command = "holdfwd" && command = "holdup"
value = 40

[State 100, ChangeState]
type = ChangeState
trigger1 = var(59)<=0
trigger1 = command != "holdfwd" 
value = 0
ctrl = 1

[State 100,ﾀﾞｯｼｭｽﾃｯﾌﾟ DashStop]
type = ChangeState
TriggerAll = var(59) >0
triggerall = !var(40)
Trigger1 = inguarddist
trigger2 = P2BodyDist X <= 0
trigger3 = roundstate != 2
Trigger4 = EnemyNear,MoveType=H
Trigger4 = P2BodyDist X<=30
Trigger4 = P2BodyDist Y=0
Trigger5 = EnemyNear,MoveType!=H
Trigger5 = P2BodyDist X=[30,50]
Trigger5 = random<=20
Trigger6 = EnemyNear,MoveType!=H
Trigger6 = P2BodyDist X=[50,100]
Trigger6 = random<=5
value = 0
ctrl = 1

[State 100, ChangeState]
type = ChangeState
triggerall = var(59)>0
triggerall = var(40)=[1,2]
trigger1 = P2bodydist X <=0
trigger2 = var(44)<120 
value = 0
ctrl = 1

