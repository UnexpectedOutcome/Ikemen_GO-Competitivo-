;---------------------------------------------------------------------------
; 地上投げ
[State -1]
type = ChangeState
value = 800
triggerall = var(59) <= 0
triggerall = stateno!=100
trigger1 = command = "y" && command = "holdfwd" && command != "holddown"
trigger1 = p2MoveType != H && p2StateNo != [120,155]
trigger1 = P2BodyDist X < 15
trigger1 = StateType = S && ctrl

;---------------------------------------------------------------------------
; 地上投げ2
[State -1]
type = ChangeState
value = 805
triggerall = var(59) <= 0
triggerall = stateno!=100
trigger1 = command = "y" && command = "holdback" && command != "holddown"
trigger1 = p2MoveType != H && p2StateNo != [120,155]
trigger1 = P2BodyDist X < 15
trigger1 = StateType = S && ctrl

;---------------------------------------------------------------------------
; 空中投げ
[State -1]
type = ChangeState
value = 850
triggerall = var(59) <= 0
trigger1 = command = "y" && command = "holdfwd"
trigger1 = P2StateType = A && P2BodyDist X < 15 && P2BodyDist Y = [-30,30]
trigger1 = StateType = A && ctrl

;------------------------------------------------------------------------------
;-| 特殊技 |-------------------------------------------------------------------
;------------------------------------------------------------------------------
;ローリングシックル
[State -1, ローリングシックル]
type = ChangeState
value = 250
triggerall = var(59) <= 0
triggerall = command = "a"
triggerall = command = "holdfwd"
trigger1 = statetype != A && (ctrl || stateno = 100)
trigger2 = (movecontact = [1,5]) && ((stateno = [200,250]) || (stateno = [400,450]))
trigger2 = stateno != 250

