;地上チェーン
[State -3,対空中用立ち大パンチ];7F X65
Type     = ChangeState
TriggerAll=var(59)||var(43)
TriggerAll=Random<=var(59)*200||(var(59)=[3,5])||var(43)
TriggerAll=StateType != A
Triggerall=playerID(var(50)),statetype=A
TriggerAll=RoundState=2
TriggerAll=playerID(var(50)),Alive
TriggerAll=playerID(var(50)),MoveType=H
TriggerAll=!InGuardDist
TriggerAll=P2Bodydist Y=[-50,0]
trigger1 = var(44)>80;中央コン
trigger1 = (P2BodyDist X - (fvar(22)*8))<= 60
trigger1 = ((stateno = 230)||(stateno = 200)) && (movehit=1)
trigger2 = var(44)<=80;端コン
trigger2 = ((stateno = 230)||(stateno = 200)) && (movehit=1)
trigger2 = (P2BodyDist X)<= 60
Value    = ifelse(P2Bodydist X <20,215,210)

