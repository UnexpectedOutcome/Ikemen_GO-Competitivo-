;-| 立ち通常攻撃 |-------------------------------------------------------------
;------------------------------------------------------------------------------
;弱パンチ
[State -1, 立ち弱パンチ]
type = ChangeState
value = 200
triggerall = var(59) <= 0
triggerall = command = "x"
triggerall = command != "holddown"
trigger1 = statetype != A && (ctrl || stateno = 100)
trigger2 = ((stateno=[200,205]) && time>5)

