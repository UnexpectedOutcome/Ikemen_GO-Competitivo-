[Command]
name = "pri"
command = ~F, B, DB, D, DF, F,a+b
time = 30

[Command]
name = "Smi"
command = ~B, F, B, x+y

[Command]
name = "Ssc"
command = ~$B, F, a+b

[Command]
name = "Sfung"
command = ~$D, U, x+y

[Command]
name = "Snail"
command = ~D, DF, F, x+y

;-| 必殺技 |------------------------------------------------------
[Command]
name = "miA"
command = ~B, F, B, x

[Command]
name = "miB"
command = ~B, F, B, y

[Command]
name = "miC"
command = ~B, F, B, a

[Command]
name = "scB"
command = ~$B, F, a

[Command]
name = "scD"
command = ~20$B, F, b

[Command]
name = "fungA"
command = ~$D, U, x

[Command]
name = "fungC"
command = ~$D, U, y

[Command]
name = "nailA"
command = ~D, DF, F, x

[Command]
name = "nailC"
command = ~D, DF, F, y


