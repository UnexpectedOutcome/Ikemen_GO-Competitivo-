value = 230
triggerall = var(59) <= 0
triggerall = command = "a"
triggerall = command != "holddown"
trigger1 = statetype != A && (ctrl || stateno = 100)
trigger2 = (movecontact = [1,5]) && (stateno=200)

;立ち強キック
[State -1, 近立ち強キック]
type = ChangeState
value = 245
triggerall = var(59) <= 0
