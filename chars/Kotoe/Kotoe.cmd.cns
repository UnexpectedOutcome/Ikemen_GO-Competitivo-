value = 2200
triggerall = var(59) <= 0
triggerall = ((helper(99999),var(20)%100 >= 20 || (helper(99999),var(20) >= 10000)) && (helper(99999),command = "Sfung")) || helper(99999),var(2) > 0
triggerall = statetype != A
triggerall = power>=1000
trigger1 = ctrl || stateno = 100 || stateno = 40
trigger2 =  MoveContact && ((stateno = [200,250]) || (stateno = [400,450]) || (stateno=[1100,1150]))
trigger3 = (stateno = [1000,1050])||(stateno=[1200,1250])
trigger3 = var(6)

