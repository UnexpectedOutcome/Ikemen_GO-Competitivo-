command = /$F
time = 1

[Command]
name = "holdback"
command = /$B
time = 1

[Command]
name = "holdup" 
command = /$U
time = 1

[Command]
name = "holddown"
command = /$D
time = 1

;-|for AI helper|-------------------------------------------------------------------------
[command]
name="fwd"
command=F
time=1
[command]
name="back"
command=B
time=1
[command]
name="up"
command=U
time=1
[command]
name="down"
command=D
time=1


; 下の記述↓は絶対に消さないでください。
[Statedef -1]
;---------------------------------------------------------------------------
;先行入力認識用ヘルパー暴走防止
;---------------------------------------------------------------------------
[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(99999)
value = 99999
ignorehitpause = 1
;------------------------------------------------------------------------------
;-| 超必殺技 |-----------------------------------------------------------------
;------------------------------------------------------------------------------
;シャドウプリズン
[State -1, シャドウプリズン]
type = ChangeState
value = 3000
triggerall = var(59) <= 0
triggerall = command = "pri" || helper(99999),var(0) > 0
triggerall = statetype != A
triggerall = power>=2000
trigger1 = (ctrl || stateno = 100)
trigger2 =  MoveContact && ((stateno = [200,250]) || (stateno = [400,450]) || (stateno=[1100,1150])||stateno=2100)
trigger3 = (stateno = [1000,1050])||(stateno=[1200,1250])
trigger3 = var(6)
trigger4 = (stateno = 2000)||(stateno=2200)
trigger4 = var(7)

;------------------------------------------------------------------------------
;-| 特強技 |-------------------------------------------------------------------
;------------------------------------------------------------------------------
;特強シャドウネイル
[State -1, 特強シャドウネイル]
type = ChangeState
value = 2000
triggerall = var(59) <= 0
triggerall = command = "Snail" || helper(99999),var(4) > 0
triggerall = statetype != A
;triggerall = (!numhelper(1000))&&(!numhelper(1050))
triggerall = power>=1000
trigger1 = (ctrl || stateno = 100)
trigger2 =  MoveContact && ((stateno = [200,250]) || (stateno = [400,450]) || (stateno=[1100,1150]))
trigger3 = (stateno = [1000,1050])||(stateno=[1200,1250])
trigger3 = var(6)

;特強シャドウスクレイパー
[State -1, 特強シャドウスクレイパー]
type = ChangeState
value = 2100
triggerall = var(59) <= 0
triggerall = ((helper(99999),var(10)%100 >= 20 || (helper(99999),var(10) >= 10000)) && (helper(99999),command = "Ssc")) || helper(99999),var(3) > 0
triggerall = statetype != A
triggerall = power>=1000
trigger1 = (ctrl || stateno = 100)
trigger2 =  MoveContact && ((stateno = [200,250]) || (stateno = [400,450]) || (stateno=[1100,1150]))
trigger3 = (stateno = [1000,1050])||(stateno=[1200,1250])
trigger3 = var(6)

