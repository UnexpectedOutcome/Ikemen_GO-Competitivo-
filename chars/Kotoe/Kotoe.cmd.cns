value = 215
triggerall = var(59) <= 0
triggerall = p2bodydist X < 20
triggerall = command = "y"
triggerall = command != "holddown"
trigger1 = statetype != A && (ctrl || stateno = 100)
trigger2 = (movecontact = [1,5]) && ((stateno=200)||(stateno=230))

