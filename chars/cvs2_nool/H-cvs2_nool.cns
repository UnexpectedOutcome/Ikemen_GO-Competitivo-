;****************************************
;ライトニングマスト
;****************************************
;ライトニングマストLV.1
[Statedef 3000]
type = S
movetype = A
physics = S
ctrl = 0
velset = 0,0
poweradd = -1000+(!var(22)&&var(59)=3 && (100*Life/const(data.life))<=30)*1000-(var(59)=1&&!var(21))*500
juggle = 15
anim=3000

[State -3,Super]
type = varset
trigger1 = time=0
var(1)=0

[State 3000]
type = varset
trigger1 = (prevstateno=[1000,2099]) && time=0 && !var(21)
trigger2 = (prevstateno=[3000,3999]) && time=0 && !var(21)
var(19)=1

[State 3500, AfterImage]
type = AfterImage
trigger1 = time=4 && (prevstateno!=[3000,3999]) && !var(56)
time = 999
length = 10
TimeGap  = 3
FrameGap = 4
palbright = 1,1,1
palContrast = 128, 128, 128
PalMul = .5,.5,.5
trans = add1

[State -2, super]
type = Helper
trigger1 = !NumHelper(7500) && Time=2;5
helpertype = normal
name = "super_effect"
id = 7500
facing = 1
pos = -ceil(5*const(size.xscale)),-ceil(79*const(size.yscale))
postype = P1
stateno = 7500+(var(59)=[3,5])*10
keyctrl = 0
pausemovetime = 9999
supermovetime = 9999
ownpal = 1
ignorehitpause = 1

[State 1600,NotHitBy]
type = NotHitBy
trigger1 = time=0
value = SCA
time = 56

[State 3500,NotHitby]
type = Varset
trigger1 = Time=0
fvar(11)=random%2

[State 3040,Pause]
type = Pause
trigger1 = time=3 && !fvar(11)
time = 52
movetime = 52

;強制停止時間のズレ
[State 3040,Pause]
type = Pause
trigger1 = time=3 && fvar(11)
time = 52-1
movetime = 52-1

[State 420,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = 190, 0
channel = 1

[State 1010, Voice]
type = PlaySnd
trigger1 = AnimElem = 3
value = 3000, 0

[State 1000, Spark]
type = Explod
trigger1 = AnimElem = 3
Anim = 6500
id = 6500
pos = 0, 0
postype = p1
ownpal = 1
bindtime = -1
sprpriority = 3
ignorehitpause=0
scale = const(size.xscale),const(size.yscale)
pausemovetime=2+var(1)*2

[State 1000, Spark]
type = Explod
trigger1 = AnimElem = 3
Anim = 6510
id = 6500
pos = 0, 0
postype = p1
ownpal = 1
bindtime = -1
sprpriority = 0
ignorehitpause=0
scale = const(size.xscale),const(size.yscale)
pausemovetime=2+var(1)*2

[State 220,Hitdef]
type = HitDef
triggerall = var(18)<4 || var(56)
trigger1 = AnimElem=5
trigger2 = AnimElem=6
trigger3 = AnimElem=7
trigger4 = AnimElem=8
trigger5 = AnimElem=9
trigger6 = AnimElem=10
trigger7 = AnimElem=11
trigger8 = AnimElem=12
trigger9 = AnimElem=13
trigger10 = AnimElem=14
trigger11 = AnimElem=15
trigger12 = AnimElem=16
trigger13 = AnimElem=17
attr = S, HA
damage    = ifelse(ceil(42*fvar(7))<7,7,ceil(42*fvar(7))), ifelse(ceil(ceil(42*fvar(7))/8)<7,7,ceil(ceil(42*fvar(7))/8))
animtype = Hard
guardflag = M
hitflag = MAF
pausetime = floor(4/ifelse(var(56),2,1)),floor(3/ifelse(var(56),2,1))
sparkno = s7300+(random%8)
guard.sparkno = s7010
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),-65+ceil(P2bodydist Y)
hitsound = S1, 16
guardsound = S0, 0
ground.type = High
ground.slidetime = 15
ground.hittime = 15
guard.slidetime  = 15
guard.hittime  = 15
ground.velocity = -1.0,-8.0
guard.velocity = -8.5
air.velocity = -1,-8
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = ifelse(fvar(23)<0,0,-22.0)
air.cornerpush.veloff = 0
fall=1
air.fall=1
fall.recover= 0
air.recover=0
getpower = 0*var(5),0*var(5)
givepower = 2*var(6),2*var(6)
forcestand=1
priority = 7,Hit
palfx.color = 0
palfx.time = 64
palfx.add = 104,104,172;64,64,144
palfx.mul = 128,128,192

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(40) = ifelse((Abs(P2bodydist X)-10)<20,-20,-10)

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(41) = -65+ceil(P2bodydist Y)

[State 1000, 0]
type = EnvShake
trigger1 = numtarget
trigger1 = movecontact=1 && target,time=0
time = 12
ampl = 4*ifelse(time%2=1,-1,1)
ignorehitpause=1

[State 200,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 19
movetype=I

[State 200,Exit]
type = ChangeState
trigger1 = AnimTime=0
value = 0
ctrl=1

