anim = 7300+(random%8)
id = 7300
sprpriority = 5
postype = P1
pos = 225,-60
ignorehitpause = 1
bindtime = -1
ownpal = 1

[State 1000,PlaySnd]
type = targetstate
trigger1 = Anim=3152 && AnimElem=1
value = 3157

[State 1000,PlaySnd]
type = targetstate
trigger1 = Anim=3152 && AnimElem=2
value = 3158

[state 1000,exit]
type = ChangeAnim
trigger1 = Anim=3152 && (var(2)<=0||target,life<=1)
value = 3153

[State 801, Effect]
type = StopSnd
trigger1 = Anim=3153 && AnimElem=2
channel = 2

[State 801, Width 1]
type = Width
trigger1 = Anim=3153 && AnimElem=4
edge = 0,100

[State 801, Width 1]
type = Width
trigger1 = Anim=3153 && AnimElem=5
edge = 0,120

[State 1000,PlaySnd]
type = targetbind
trigger1 = Anim=3153 && AnimElem=1
pos = 210,-70

[State 1000,PlaySnd]
type = targetbind
trigger1 = Anim=3153 && AnimElem=2
pos = 140,-40

[State 1000,PlaySnd]
type = targetbind
trigger1 = Anim=3153 && AnimElem=3
pos = -50,-70

[State 1000,PlaySnd]
type = targetbind
trigger1 = Anim=3153 && AnimElem=4
pos = -100,-120

[State 1000,PlaySnd]
type = targetbind
trigger1 = Anim=3153 && AnimElem=5
pos = -100,-60

[State 1000, Spark]
type = RemoveExplod
trigger1 = Anim=3153 && AnimElem=1
id = 6600

[State 801, Hurt 11]
type = VarAdd
trigger1 = Anim=3153 && AnimElem=5
var(16) = 1

[State 801, Hurt 11]
type = HitAdd
trigger1 = Anim=3153 && AnimElem=5
value = 1

[State 1000,PlaySnd]
type = targetLifeAdd
trigger1 = Anim=3153 && AnimElem=5
value = -ifelse(ceil(70*fvar(7))<7,7,ceil(70*fvar(7)))

[State 1000,PlaySnd]
type = targetPowerAdd
trigger1 = Anim=3153 && AnimElem=5
value = ceil(2*var(6))

[State 1000,PlaySnd]
type = targetstate
trigger1 = Anim=3153 && AnimElem=1
value = 3159

[state 1000,exit]
type = Turn
trigger1 = Anim=3153 && AnimTime=0

[state 1000,exit]
type = ChangeState
trigger1 = Anim=3153 && AnimTime=0
value = 0
ctrl = 1

