trigger1 = AnimElemTime(3) = 0
value = 0,0
channel = 0

[State 2000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
value = 5,11
channel = 1

[State 2000, 加速]
type = VelSet
