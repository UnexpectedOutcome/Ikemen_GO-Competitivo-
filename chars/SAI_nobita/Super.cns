[State 2000, 変数]
type = VarSet
trigger1 = AnimElemTime(1) = 0
var(1)= 0

[State 2000, 変数]
type = VarSet
trigger1 = movecontact
trigger1 = AnimElemTime(3) >= 0
trigger2 = movereversed
var(1)= 1

[State 2000, 物理的なキャラの幅]
type = Width
trigger1 = FrontEdgeDist <= 5
value = 15,0

[State 2000, 音を鳴らす]
