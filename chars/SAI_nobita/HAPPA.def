;--| 基本情報 |---------------------------------------------------------------
[Info]
Name         = "Nobita"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Nobita"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 02,14,2012     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Mikita"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3,4,5,6        ;ＣＰＵで出てきた時のカラーパレットの順番

[Files]
Cmd     = HAPPA/Sai.cmd
Cns     = HAPPA/Sai.cns
St      = HAPPA/Sai.cns
St1     = HAPPA/Reflector.cns
St2     = Super.cns
St3     = HAPPA/-2_-3.txt
st4     = HAPPA/Sai_assist.cns
St5     = HAPPA/Config.txt
StCommon = HAPPA/common1.cns
Sprite  = Sai.sff
Anim    = Sai.air
Sound   = Sai.snd

;--| カラーパレットファイル |-------------------------------------------------

Pal1 = color/nobita_01.act
Pal2 = color/nobita_02.act
Pal3 = color/nobita_03.act
Pal4 = color/nobita_04.act
Pal5 = color/nobita_05.act
Pal6 = color/nobita_06.act
Pal7 = color/nobita_07.act
Pal8 = color/nobita_08.act
Pal9 = color/nobita_09.act
Pal10= color/nobita_10.act
Pal11= color/nobita_11.act
Pal12= color/nobita_12.act

;PalXXの番号を変更し差し替えることで未使用のカラーも選択することが出来ます．
