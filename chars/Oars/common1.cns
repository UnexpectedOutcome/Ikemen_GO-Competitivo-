trigger1 = helper(4000), stateno = 4300
trigger2 = numhelper(4000) = 1
trigger2 = helper(4000), stateno = 4350
trigger3 = numhelper(1) = 1
trigger3 = helper(1), stateno = 3001
trigger4 = numhelper(1) = 1
trigger4 = helper(1), stateno = 3501
value = 3000
ctrl = 0

[State 100, 0]
