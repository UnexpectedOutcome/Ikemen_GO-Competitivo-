waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITA_UP (initial going up)
[Statedef 5030]
type    = A
movetype= H
physics = N
ctrl = 0

[State 0, PosSet] ; para evitar que sea levantado
type = PosSet     ; disable going up fall
trigger1 =  1
y = 0



[State 0, SprPriority]
type = SprPriority
trigger1 =  1
value = -5
ignorehitpause = 1

[State 5030, 1]
type = VelAdd;Gravity
trigger1 = 1
y = GetHitVar(yaccel)

[State 5030, 2]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 5030, 3]
type = ChangeState
triggerall = !HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5040 ;HITA_RECOV

[State 5030, 4]
type = ChangeState
triggerall = HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5050 ;HITA_FALL

[State 5030, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 5035 ;HITA_UP (transition)

;---------------------------------------------------------------------------
; HITA_UP_T (transition)
[Statedef 5035]
type    = A
movetype= H
physics = N

[State 0, PosSet] ; para evitar que sea levantado
type = PosSet     ; disable going up fall
trigger1 =  1
y = 0

[State 5035, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5035)
trigger1 = (Anim != [5051,5059])+ifelse(Var(2) = 1, 1000,0) ;Not if in hit up anim
trigger1 = Anim != 5090+ifelse(Var(2) = 1, 1000,0)          ;Not if hit off ground anim
value = 5035+ifelse(Var(2) = 1, 1000,0)

[State 5035, 2]
type = VelAdd
trigger1 = 1
y = 1

[State 5035, 3]
type = ChangeState
triggerall = !HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Animation over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035+ifelse(Var(2) = 1, 1000,0) ;.
value = 5040 ;HITA_RECOV

[State 5035, 4]
type = ChangeState
triggerall = HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035+ifelse(Var(2) = 1, 1000,0) ;.
value = 5050 ;HITA_FALL

;---------------------------------------------------------------------------
; HITA_RECOV (recovering in air, not falling)
[Statedef 5040]
type    = A
movetype= H
physics = N

[State 0, PosSet] ; para evitar que sea levantado
type = PosSet     ; disable going up fall
trigger1 =  1
y = 0

[State 5040, 1]
type = ChangeState
trigger1 = !Alive
value = 5050

[State 5040, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim != 5040+ifelse(Var(2) = 1, 1000,0)
trigger2 = Time = 0
trigger2 = Anim != 5035+ifelse(Var(2) = 1, 1000,0)
value = 5040+ifelse(Var(2) = 1, 1000,0)

[State 5040, 3]
type = CtrlSet
trigger1 = HitOver
value = 1

[State 5040, 4]
type = StateTypeSet
trigger1 = HitOver
movetype = I

[State 5040, 5]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5040, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;JUMPLAND

;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 5050]
type    = A
movetype= H
physics = N


[State 0, PosSet] ; para evitar que sea levantado
type = PosSet     ; disable going up fall
trigger1 =  1
y = 0

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035+ifelse(Var(2) = 1, 1000,0)
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035+ifelse(Var(2) = 1, 1000,0)
trigger2 = (Anim != [5051, 5059])+ifelse(Var(2) = 1, 1000,0) && (Anim != [5061, 5069])+ifelse(Var(2) = 1, 1000,0)
trigger2 = Anim != 5090+ifelse(Var(2) = 1, 1000,0) ;Not if hit off ground anim
value = 5050+ifelse(Var(2) = 1, 1000,0)

[State 5050, 2] ;Coming down anim
type = ChangeAnim
trigger1 = (anim = [5050,5059])+ifelse(Var(2) = 1, 1000,0)
trigger1 = Vel Y >= ifelse(anim = 5050+ifelse(Var(2) = 1, 1000,0), 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 4] ;Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059])+ifelse(Var(2) = 1, 1000,0) || (anim = [5061,5069])+ifelse(Var(2) = 1, 1000,0), 0, 0)
value = 5100 ;HIT_BOUNCE

