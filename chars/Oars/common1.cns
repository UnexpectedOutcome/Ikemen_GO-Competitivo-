reversal.attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
pausetime = 6,8
sparkno = S7000
sparkxy = 10
hitsound = S0,8
sprpriority = -5
numhits = 0

[State 155, 7]
type = ChangeState
trigger1 = command != "holdback"
value = 0


[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130

