;---------------------------------------------------------------------------
; HITL_SHAKE
[Statedef 5080]
type    = L
movetype= H
physics = N
velset = 0,0

[State 0, PosSet] ; para evitar que sea levantado
type = PosSet     ; disable going up fall
trigger1 =  1
y = 0

[State 5080, 1] ;Set default anim
type = VarSet
trigger1 = time = 0
sysvar(2) = ifelse(GetHitVar(yvel) = 0, 5080+ifelse(Var(2) = 1, 1000,0), 5090+ifelse(Var(2) = 1, 1000,0))

[State 5080, 2]
type = VarAdd
trigger1 = time = 0
trigger1 = (anim = [5081,5089])+ifelse(Var(2) = 1, 1000,0) || (anim = [5111,5119])+ifelse(Var(2) = 1, 1000,0)
trigger1 = SelfAnimExist(sysvar(2) + (anim % 10))
sysvar(2) = anim % 10

[State 5080, 3] ;If 5090 doesn't exist, default to 5030
type = VarSet
trigger1 = time = 0
trigger1 = sysvar(2) = 5090+ifelse(Var(2) = 1, 1000,0)
trigger1 = !SelfAnimExist(5090)
sysvar(2) = 5030+ifelse(Var(2) = 1, 1000,0)

[State 5080, 3] ;Freeze
type = ChangeAnim
trigger1 = 1
value = sysvar(2)

[State 5080, 4]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5081 ;HITL_SLIDE

[State 5080, 5]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) != 0
value = 5030 ;HITA_UP

