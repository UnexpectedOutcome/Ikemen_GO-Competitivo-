trigger1 = (anim = [5081,5089])+ifelse(Var(2) = 1, 1000,0)
value = (5110+ifelse(Var(2) = 1, 1000,0)) + (anim % 10)

[State 5110, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
triggerall = (anim != [5110,5119])+ifelse(Var(2) = 1, 1000,0) ;Not already changed anim
trigger1 = (anim != [5161,5169])+ifelse(Var(2) = 1, 1000,0)
trigger2 = !SelfAnimExist(5170 + (anim % 10))
value = 5170+ifelse(Var(2) = 1, 1000,0)

[State 5110, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
triggerall = (anim != [5110,5119])+ifelse(Var(2) = 1, 1000,0) ;Not already changed anim
trigger1 = (anim = [5161,5169])+ifelse(Var(2) = 1, 1000,0)
trigger1 = SelfAnimExist(5170 + (anim % 10))
value = (5170+ifelse(Var(2) = 1, 1000,0)) + (anim % 10)

[State 5110, 4]
type = HitFallDamage
trigger1 = Time = 0

[State 5110, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5110, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 5110, 6]
type = PlaySnd
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 5110, 7]
type = GameMakeAnim
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = 60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 14

[State 5110, 8]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5110, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = (anim = [5171,5179])+ifelse(Var(2) = 1, 1000,0)
triggerall = SelfAnimExist(5110 + (anim % 10))
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = (5110+ifelse(Var(2) = 1, 1000,0)) + (anim % 10)

[State 5110, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = (Anim != [5111,5119])+ifelse(Var(2) = 1, 1000,0)
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5110+ifelse(Var(2) = 1, 1000,0)

[State 5110, 11] ;If just died
type = ChangeState
triggerall = !alive
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
trigger3 = (Anim = [5110,5119])+ifelse(Var(2) = 1, 1000,0)
value = 5150


