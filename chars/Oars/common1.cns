; Oars States
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
movetype = I
physics = S
anim = 0
velset = 0,0
ctrl = 1


[State 0, CtrlSet]
type = CtrlSet
triggerall = roundstate = 1
trigger1 = 1
value = 0


[State 0, SprPriority]
type = SprPriority
trigger1 = 1
value = -5


[State 200, Ono]
type = ChangeState
triggerall = numhelper
trigger1 = helper(4000), stateno = 4300
trigger2 = helper(4000), stateno = 4350
trigger3 = helper(1), stateno = 3001
trigger4 = helper(1), stateno = 3501
value = 3000
ctrl = 0

[State 0, 0]
type = PosSet
trigger1 = Pos Y != 0
y = 0

;---------------------------------------------------------------------------
; Crouch
[Statedef 10]
type    = C
physics = C
anim = 0


[State 10, 0]
type = ChangeState
trigger1 = 1
value = 0
ctrl = 1


;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
anim = 0

[State 200, Ono]
type = ChangeState
trigger1 = helper(4000), stateno = 4300
trigger2 = helper(4000), stateno = 4350
trigger3 = helper(1), stateno = 3001
trigger4 = helper(1), stateno = 3501
value = 3000
ctrl = 0

[State 20, 1]
type = VelSet
triggerall = Time < 15
triggerall = helper(2001), stateno != 2011
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
triggerall = Time < 15
triggerall = helper(2002), stateno != 2012
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = PosAdd
triggerall = Time > 0
triggerall = Time <= 15
trigger1 = TimeMod = 3,0
y = -1

[State 20, 4]
type = PosAdd
trigger1 = Time > 15
trigger1 = Time <= 20
y = 1

[State 20, 5]
type = PosSet
trigger1 = Time <= 0
trigger2 = Time >= 20
y = 0

[State 20, 6]
type = ChangeState
trigger1 = Time >= 20
value = 21

;---------------------------------------------------------------------------
; Walk Stop
[Statedef 21]
type    = S
physics = S
velset = 0,0
ctrl = 0
anim = 0


[State 21, 0]
type = PosSet
trigger1 = Pos Y != 0
y = 0

[State 21, 1]
type = PlaySnd
trigger1 = Time = 0
value = 1, 1

[State 21, 2]
type = EnvShake
trigger1 = Time = 0
time = 30
freq = 100
ampl = -4

[State 21, 3]
type = ChangeState
triggerall = Time > 20
trigger1 = command = "holdfwd"
trigger2 = command = "holdback"
value = 20
ctrl = 1

[State 21, 4]
type = ChangeState
triggerall = Time > 20
trigger1 = command != "holdfwd"
trigger2 = command != "holdback"
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Jump
[Statedef 40]

[State 40, Dash]
type = ChangeState
value = 105
;trigger1 = P2Dist X >= -300
trigger1 = P2Dist X <= -200
trigger2 = P2BodyDist X > 0
trigger2 = P2BodyDist X < 10

[State 40, Dash]
type = ChangeState
value = 100
trigger1 = P2BodyDist X >= 400
;trigger1 = P2BodyDist X <= 500

[State 40, 0]
type = ChangeState
trigger1 = 1
value = 0
ctrl = 1


;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 190: 	ChangeState]
type 		= ChangeState
trigger1	= time = 0
value 		= 620


[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S1,1
volume = 50

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 0, Explod]
type = Explod
trigger1 = (!Time)
anim = 6003
ID = 6003
pos = 1,10
postype = p1
facing = 1
vfacing = 1
bindtime = 1
vel = 0,0
accel = 0,0
random = 0,0
removetime = -2
scale = 1.2,1.2
sprpriority = 0
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 0

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


