;===============================================================================
; Scoring Objetives (ES INTERNO - CUENTA DE MANERA OCULTA - NO SE VE)
;===============================================================================
; Reset Objetives at Beginning of Match
[State -3, Reset Objetives Score]
type = varset
triggerall = floor(fvar(30) > 0)
triggerall = RoundState = [0,1]
trigger1 = time && !roundsexisted
fvar(30) = 0

; Keep Score bewteen 0 and 9999
[State -3, Limit Objetives Score]
type = varset
trigger1 = floor(fvar(30) != [0, 9999])
fvar(30) = cond(fvar(30) > 9999, 9999, 0)

[State -3, Score For Ones Place]
type = varset
trigger1 = 1
fvar(31) = floor(fvar(30)/ 1) % 10 ; * 1 ; uncomment to get exact amount of ones
[State -3, Score For Tens Place]
type = varset
trigger1 = 1
fvar(32) = floor(fvar(30)/ 10) % 10 ; * 10 ; uncomment to get exact amount of tens
[State -3, Score For Hundreds Place]
type = varset
trigger1 = 1
fvar(33) = floor(fvar(30)/ 100) % 10 ; * 100 ; uncomment to get exact amount of hundreds
[State -3, Score For Thousands Place]
type = varset
trigger1 = 1
fvar(34) = floor(fvar(30)/ 1000) % 10 ; * 1000 ; uncomment to get exact amount of thousands

;===============================================================================
; ------ Final Rank Calculate --------------------------------------------------
;===============================================================================

[State 0, Varset] ; Sumatoria de los scores: Life + Time + Hits + Objetives
type = Varset
trigger1 = 1
var(59) = var(40)+var(45)+var(50)+floor(fvar(30))



