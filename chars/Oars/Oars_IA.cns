;===============================================================================
; Scoring Time Bonus (ES INTERNO - CUENTA DE MANERA OCULTA - NO SE VE)
;===============================================================================
; Reset Time Bonus at Beginning of Match

[State -3: Time Bonus]
type		= Helper
triggerall	= numhelper(8601) = 0
trigger1	= time = 0
helpertype	= Normal
name		= "Time Bonus"
id		= 8601
pos             = 0,0
postype         = back
facing		= 1
stateno		= 8601
keyctrl		= 0
ownpal		= 1
supermovetime 	= 999
ignorehitpause  = 1
size.xscale     = 1
size.yscale     = 1


[State -3, Time Bonus]
type = varset
triggerall = numhelper(8601) = 1
triggerall = helper(8601),time = 1
trigger1 = Roundno = 1
trigger2 = Roundno = 2
trigger3 = Roundno = 3
trigger4 = Roundno = 4
trigger5 = Roundno = 5
trigger6 = Roundno = 6
trigger7 = Roundno = 7
var(40) = 3364


[State -3, Decrease Time Bonus]
type = varadd
triggerall = RoundState = [2,3]
trigger1 = time%3 = 0
var(40) = -1
ignorehitpause = 1

; Keep Score bewteen 0 and 9999
[State -3, Limit Time Bonus]
type = varset
trigger1 = var(40) != [0, 9999]
var(40) = cond(var(40) > 9999, 9999, 0)


[State -3, Score For Ones Place]
type = varset
trigger1 = 1
var(41) = floor(var(40) / 1) % 10 ; * 1 ; uncomment to get exact amount of ones
[State -3, Score For Tens Place]
type = varset
trigger1 = 1
var(42) = floor(var(40) / 10) % 10 ; * 10 ; uncomment to get exact amount of tens
[State -3, Score For Hundreds Place]
type = varset
trigger1 = 1
var(43) = floor(var(40) / 100) % 10 ; * 100 ; uncomment to get exact amount of hundreds
[State -3, Score For Thousands Place]
type = varset
trigger1 = 1
var(44) = floor(var(40) / 1000) % 10 ; * 1000 ; uncomment to get exact amount of thousands

