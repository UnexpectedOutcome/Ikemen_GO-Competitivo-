;---------------------------------------------------------------------------
;---------------------------------------------------------------------------EX必殺技
; EXお怒りボンバー

[Statedef 2000]
type    = S
movetype= A
physics = S
juggle  = 4
velset = 0,0
poweradd= -990
anim = 2000
ctrl = 0
sprpriority = 2

[State 2000, 2] ;無敵
type = NotHitBy
trigger1 = AnimElem = 1
value = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP
time = 8

[State 2000, 1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1000, 0

[State 2000, 2]
type = Helper       ;Helperを飛び道具として使う
trigger1 = AnimElem = 2       ;飛び道具発射
helpertype = normal
name = "tama1"       ;任意の名前
ID = 2010
stateno = 2010       ;飛び道具のステートナンバー
pos = 55,-85       ;出現座標
postype = p1       ;出現座標の基準(プレイヤー1)
supermovetime = 0       ;暗転した際に動けなくなる時間
pausemovetime = 0       ;停止した際に動けなくなる時間
OwnPal = 1 ;独自パレット

[State 1000, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 3
movetype = I

[State 2000, 残像発生]
type = AfterImage
trigger1 = time = 0
time = 16

[State 2000, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; EXお怒りボンバー飛び道具
[Statedef 2010]
type = A
movetype = A
velset = 0,0       ;速度(根元で少しとどまる)
physics = N       ;摩擦、重力を無視
juggle  = 4       ;本体とは別
anim = 1010
ctrl = 0
sprpriority = 3

[State 2010,1]
type = velset       ;速度の変更
trigger1 = time = 2
x = 6

[State 2010,3]
type = HitDef                    ;攻撃の設定
trigger1 = AnimElem = 1          ;トリガー、アニメ何枚目
attr = A, HP                     ;技の属性(ヘルパーは画面端の押し戻しが適用されるので空中属性に)
damage = 68*(64-((Root,Var(4))))/64, 17 ;ダメージ(ヒット,ガード)
animtype = Medium                ;くらい属性(ダウンの有無は別項目)
guardflag = MA                   ;ガード属性
hitflag = MAFDP                    ;ヒットする状態の指定(省略時MAF)
priority = 4, Hit                ;相打ちの優先順位
pausetime = 0, 0                 ;硬直時間(相手,自分)(ヒットストップ中に飛び道具が消えたままなので短く)
sparkno = S9999                  ;Spark anim no (空の値を指定)
ground.type = high               ;くらい動作のアニメを指定
ground.slidetime = 24            ;摩擦を無視する時間
ground.hittime  = 24             ;のけぞり時間
ground.velocity = -4,-8          ;地上で攻撃を受けた時、相手が飛んでいく速度
air.hittime = 30
air.velocity = -4,-8             ;
guard.hittime = 24             ;ガード硬直(のけぞりと別に設定できる)
guard.velocity = (Root,fVar(1))  ;ガード後退速度
fall = 1                         ;ダウン
getpower = 50,50                 ;p1ゲージ追加増加量
givepower = 30,30                ;p2ゲージ増加量

[State 2010,5]
type = hitoverride               ;攻撃を食らった時に任意のステートへ
trigger1 = 1
attr = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP
stateno = 2030                   ;消滅用のステート
time = 1
IgnoreHitPause = 1

[State 2010,6]
type = changestate
trigger1 = moveguarded = 1         ;飛び道具が相手に触れた時
trigger2 = frontedgebodydist < -50 ;正面の画面端を25ドット通り過ぎた時
value = 2030                     ;消滅用のステート
IgnoreHitPause = 1

[State 2010,6]
type = changestate
trigger1 = movehit = 1         ;飛び道具が相手に触れた時
value = 2031                     ;消滅用のステート
IgnoreHitPause = 1

[State 2010, 7]               ;飛び道具のみをくらう事を許可
type = HitBy
trigger1 = 1
value = SCA,AP

[State 2010,影を消す]
Type = AssertSpecial
Trigger1 = 1
Flag = NoShadow
IgnoreHitPause = 1

;---------------------------------------------------------------------------
; EXお怒りボンバー飛び道具消滅
[Statedef 2030]
type = A
movetype = I
velset = 0,0
pos = 49 -84       ;出現座標
physics = N
anim = 1030
ctrl = 0
sprpriority = 3

[State 2030, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
trigger1 = p2movetype = H && p2stateno != [120,153]
trigger1 = frontedgebodydist > -50
value = f5, 2

[State 2030, varset]
type = varset
trigger1 = AnimElem = 1
trigger1 = p2movetype = H && p2stateno != [120,153]
trigger1 = frontedgebodydist > -50
var(14) = 1

[State 2030, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
trigger1 = p2movetype = H && p2stateno = [120,153]
trigger1 = frontedgebodydist > -50
value = f6, 0

[State 2030]
type = destroyself
trigger1 = animtime = 0

[State 2030,影を消す]
Type = AssertSpecial
Trigger1 = 1
Flag = NoShadow
IgnoreHitPause = 1

[State 2030, NotHitBy] ;無敵
type = NotHitBy
trigger1 = 1
value = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP

