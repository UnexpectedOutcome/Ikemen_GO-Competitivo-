; 昇龍パンチEX - move forwards

[Statedef 2050]
type    = A
movetype= A
physics = N
juggle  = 0
poweradd= -970
velset = 0,0
anim = 2050
ctrl = 0
sprpriority = 2

[State 2050, 2] ;無敵
type = NotHitBy
trigger1 = AnimElem = 1
value = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP
time = 6

[State 2050, posadd]
type = posadd
trigger1 = AnimElem = 3
x = 52

[State 2050, 残像発生]
type = AfterImage
trigger1 = time = 0
time = 24

[State 2050,1] ;攻撃
type = HitDef                    ;攻撃の設定
trigger1 = AnimElem = 2          ;トリガー、アニメ何枚目
attr = S, HA                     ;技の属性
damage = 105-(var(10)*3), 26     ;ダメージ(ヒット,ガード)
animtype = up                    ;くらい属性(ダウンの有無は別項目)
guardflag = M                    ;ガード属性
hitflag = MAF                    ;ヒットする状態の指定(省略時MAF)
priority = 4, Hit                ;相打ちの優先順位
pausetime = 8, 8                 ;硬直時間(相手,自分)ヒットストップ
sparkno = 1                      ;Spark anim no (Def: set above)
sparkxy = -10, -100              ;ヒットスパークの表示位置(-10,-高さ)
hitsound = 5, 2
guardsound = 6, 0
ground.type = High               ;くらい動作のアニメを指定
ground.slidetime = 23
ground.hittime  = 45             ;重要。短いと反撃し放題。
air.hittime = 45
ground.velocity = -4,-18
air.velocity = -4,-18
guard.hittime = 23             ;ガード硬直(のけぞりと別に設定できる)
guard.velocity = -12             ;ガード後退速度(地上転倒なので設定)
fall = 1                         ;ダウン
getpower = 30,30                 ;p1ゲージ追加増加量
givepower = 30,15                ;p2ゲージ増加量

[State 2050, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 2051

