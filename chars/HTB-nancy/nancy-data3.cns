;===================================================================
;---------------------------------------------------------------------------交代タッグ記述その1ここまで



;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;[Statedef -1]
;KeyCtrl=1状態で自身のステート内常時。

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)常時監視ステート。
; コンボ補正等を入れる場合はここに記入すると思われる。
;---------------------------------------------------------------------------
[Statedef -2]
;---------------------------------------------------------------------------


[State -2, 空中ガードスイッチ]
Type = AssertSpecial ;宣言した物を無限に持続させる
Trigger1 = 1
Flag = NoAirGuard ;空中ガードをプレイヤーの操作から除外する(AIはAI用のトリガーで指定)

;---------------------------------------------------------------------------


[State -2, コンボ補正];ヒットの重みを取得
type = VarSet
trigger1 = p2movetype != H   ;変数をリセット
var(3) = 0

[State -2, コンボ補正]
type = Varadd
trigger1 = movehit
trigger1 = enemynear(0),stateno = [5000,5099]
var(3) = 1

    [State -2,コンボ補正];計算式
    Type = AttackMulSet     ;攻撃力設定
    Trigger1 = var(3) < 49
    Value = 1.00*(64-(var(3)))/64

    [State -2,コンボ補正]
    Type = AttackMulSet     ;攻撃力設定
    Trigger1 = var(3) > 48
    Value = 0.25

[State -2, コンボ補正];飛び道具に渡す用
type = VarSet
trigger1 = p2movetype != H   ;変数をリセット
var(4) = 0

[State -2, コンボ補正];飛び道具に渡す用
type = VarSet
Trigger1 = var(3) < 49
var(4) := (var(3))

[State -2, コンボ補正]
type = VarSet
Trigger1 = var(3) > 48
var(4) = 48

[State -2, コンボ補正EX怒ったぞhit]
type = Varadd
trigger1 = Numhelper(2031) != 0
var(3) = 2

;---------------------------------------------------------------------------

[State -2, 技が触れた(スカらせ、削り補正用)]
type = VarSet
trigger1 = movetype != A   ;変数をリセット
trigger2 = stateno = 0
trigger3 = stateno =440 && AnimElemTime(3) >= 1 && AnimElemTime(4) < 1
trigger4 = stateno =440 && AnimElemTime(6) >= 1 && AnimElemTime(7) < 1
trigger5 = stateno =440 && AnimElemTime(8) >= 1 && AnimElemTime(9) < 1
trigger6 = stateno =1100 && AnimElemTime(1) >= 1 && AnimElemTime(2) < 1
trigger7 = stateno =1105 && AnimElemTime(1) >= 1 && AnimElemTime(2) < 1
var(2) = 0

[State -2, 技が触れた(スカらせ、削り補正用)]
type = VarSet
triggerall = movecontact
trigger1 = stateno =440 && AnimElemTime(3) >= 1 && AnimElemTime(11) < 1
var(2) = 1

;---------------------------------------------------------------------------

[State -2, 技が触れた(スカらせ、削り補正用)];ロボコンパンチ用
type = Varadd
triggerall = movecontact
trigger1 = stateno =1100 && AnimElemTime(2) >= 1 && AnimElemTime(7) < 1
trigger2 = stateno =1105 && AnimElemTime(2) >= 1 && AnimElemTime(7) < 1
trigger3 = stateno =2100 && AnimElemTime(4) >= 1 && AnimElemTime(7) < 1
var(2) = 1

[State -2, ロボコンパンチ転倒]
type = VarSet
trigger1 = movetype != A   ;変数をリセット
trigger2 = stateno =1100 && AnimElemTime(1) >= 1 && AnimElemTime(2) < 1
trigger3 = stateno =1105 && AnimElemTime(1) >= 1 && AnimElemTime(2) < 1
trigger4 = stateno =2100 && AnimElemTime(1) >= 1 && AnimElemTime(4) < 1
var(11) = 0

[State -2, ロボコンパンチ転倒]
type = VarSet
triggerall = movecontact
trigger1 = var(2) > 6
var(11) = 1

;---------------------------------------------------------------------------

[State -2, 飛び道具のけぞり速度]
type = VarSet
trigger1 = movetype != A   ;変数をリセット
trigger2 = stateno = 0
fvar(1) = 0

[State -2, 飛び道具のけぞり速度]
type = VarSet
trigger1 = movetype = A && P2BodyDist X < 560
fvar(1) = -14* (800-(P2BodyDist X)) /800

[State -2, 飛び道具のけぞり速度]
type = VarSet
trigger1 = movetype = A && P2BodyDist X > 559
fvar(1) = -4.2

;---------------------------------------------------------------------------

[State -2, フレーム毎加算(時間で威力を変更)]
type = VarSet
trigger1 = movetype != A   ;変数をリセット
trigger2 = stateno = 0
var(10) = 0

[State -2, フレーム毎加算(時間で威力を変更)]
type = Varadd
triggerall = var(10) < 11
trigger1 = stateno =1051 && AnimElemTime(1) >= 0 && AnimElemTime(3) < 0
trigger2 = stateno =1061 && AnimElemTime(1) >= 0 && AnimElemTime(3) < 0
var(10) = 1

;---------------------------------------------------------------------------
[State -2, 自分くらい時(ヘルパー消滅用)]
type = VarSet
trigger1 = movetype != H   ;変数をリセット
trigger2 = stateno = 0
var(12) = 0

[State -2, 自分くらい時(ヘルパー消滅用)]
type = VarSet
trigger1 = movetype = H
var(12) = 1

;---------------------------------------------------------------------------

[State -2, ガーキャン必殺技用] ;変数をリセット
type = VarSet
trigger1 = stateno = [140,155]
trigger1 = time > 10
trigger2 = stateno != [1000,2999]
trigger3 = movetype = I
var(13) = 0

[State -2, ガーキャン必殺技用]
type = VarSet
trigger1 = stateno = [140,155]
trigger1 = time < 11
var(13) = 1

;---------------------------------------------------------------------------

[State -2,リジェネーションモード];セットされた受付時間を減算する
type = VarAdd
trigger1 = var(15) > 0
var(15) = -1

[State -2,リジェネーションモード];負数にならないようにリセット
type = Varset
trigger1 = var(15) < 0
var(15) = 0

[State -2,リジェネーションモード]
type = LifeAdd       ;ここで体力を増やす。
trigger1 = var(15) > 0
trigger1= (GameTime%6)=0 ;何フレームごとに回復するか
value = 1

;---------------------------------------------------------------------------

[State -2, 補助ヘルパー発射]
type = Helper       ;Helperをめくりガード判定用として使う
TriggerAll = !NumHelper(10000) ;ヘルパーの有無を確認
trigger1 = !Ishelper;自分がヘルパーではない時
trigger1 = Alive;自分が生きている時
trigger1 = RoundState < 3;イントロ～戦闘中
helpertype = normal
name = "mekuri"       ;任意の名前
ID = 10000
stateno = 10000       ;飛び道具のステートナンバー
pos = 0,0       ;出現座標
postype = p1       ;出現座標の基準(プレイヤー1)
facing = 1        ;相手の方を向く
keyctrl=0
pausemovetime=2147483647
supermovetime=2147483647
ignorehitpause = 1

;念のため関係無いステートに行かないように↓も付けておく
[State -2, helper]
type = changestate
trigger1 = Ishelper(10000)
trigger1 = !(stateno = 10000)
value = 10000
ignorehitpause = 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------交代タッグ記述その2
;===================================================================
[State -2, 1 デバッグ];☆
type = null;DisplayToClipboard
trigger1 = 1
text = "1P_s2:%d 1P_s3:%d 1P_s4:%d 1P_Sno:%d \n"
params = floor(sysfvar(2)),floor(sysfvar(3)),floor(sysfvar(4)),stateno
ignorehitpause = 1

[State -2, 1 デバッグ];☆
type = null;AppendToClipboard
trigger1 = numpartner
text = "3P_s2:%d 3P_s3:%d 3P_s4:%d 3P_Sno:%d \n"
params = floor(partner,sysfvar(2)),floor(partner,sysfvar(3)),floor(partner,sysfvar(4)),partner,stateno
ignorehitpause = 1


[state -3];開幕判定
type = varset
triggerall = numpartner
triggerall = ID>partner,ID
triggerall = roundstate < 2
trigger1 = PalNo = 3 ;zボタン
trigger2 = PalNo = 6 ;cボタン
sysfvar(3) = -1

[state -3];W前衛強制対処★
type = varset
triggerall = numpartner
triggerall = ID>partner,ID
triggerall = roundstate = 2 && alive && partner,alive
triggerall = sysfvar(3) = 0 && stateno != [35800,358004]
triggerall = partner,sysfvar(3) = 0 && partner,stateno != [358000,358004]
trigger1 = PalNo = 3 ;zボタン
trigger2 = PalNo = 6 ;cボタン
sysfvar(3) = 1

[State -2];3Pイントロ★
type = ChangeState
triggerall = !IsHelper
triggerall = ctrl
triggerall = numpartner
triggerall = ID>partner,ID
triggerall = sysfvar(3) = -1
triggerall = roundstate = 2 && alive && partner,alive
trigger1 = PalNo = 3 ;zボタン
trigger2 = PalNo = 6 ;cボタン
value = 358001
ctrl = 0

[state -2];3Pイントロ_無敵化
type = NotHitBy
triggerall = sysfvar(3) = -1
trigger1 = PalNo = 3 ;zボタン
trigger2 = PalNo = 6 ;cボタン
value = SCA

[State -2,交代ステートへ_妨害されてた場合★]
type = ChangeState
triggerall = !IsHelper
triggerall = roundstate = 2
triggerall = numpartner
triggerall = partner,alive
triggerall = statetype != A && ctrl
trigger1 = sysfvar(3) > 0
trigger2 = partner,sysfvar(3) < -1;	特殊交代
value = 358001
ctrl = 0

[state -3]
type = varset
;死んだら解除☆
trigger1 = alive = 0
trigger1 = sysfvar(3) != 0
;パートナーが倒されていたら解除
trigger2 = partner,alive = 0
trigger2 = sysfvar(3) != 0
;パートナーが待機状態になったら解除
trigger3 = partner,stateno = 358002
trigger3 = sysfvar(3) != 0
sysfvar(3) = 0

[state -3,AssistAttack消去]
type = removeExplod
triggerall = numexplod(358002)
trigger1 = movetype != A && stateno != 358004
id = 358002

[state -3,状況判定];☆
type = varset
trigger1 = 1
sysfvar(2) = (sysfvar(3) > 0 || sysfvar(3) = -1 || partner,sysfvar(3) <= -2 || stateno = 358002)

;---------------------------------------------------------------------------交代タッグ記述その2ここまで
;[Statedef -3]は別ファイルでAIなどに使用。

