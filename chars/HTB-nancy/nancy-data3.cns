;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;補助ヘルパー(先行入力等)

[Statedef 10000]
type = A
movetype = I
velset = 0,0       ;速度
physics = N       ;摩擦、重力を無視
anim = 10000

[State 10000 透明化]
type = assertspecial
trigger1 = 1
flag = invisible
flag2 = noshadow

[State 10000 無敵化]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;先行入力用ステート
;コマンドが入力されたら、ヘルパー内の変数に一時保存。
;もう一つの変数で、一時保存した条件が保持される時間を設定。先行入力解除時間でリセット。
;本体cmdの各々の技の発動条件に、「二つの変数でコマンドが一時保存されてる間」を加えておく。

;---------------------------------------------------------------------------
;Var(0)にコマンドを一時保存。

[State 10000,Cmd];スーパー飛躍キック
type = VarSet
trigger1 = !Var(0)
trigger1 = Root,Command = "s_100kick"
var(0) = 3000

[State 10000,Cmd];昇龍パンチ
type = VarSet
trigger1 = !Var(0)
trigger1 = Root,Command = "taiku_s"
var(0) = 2050

[State 10000,Cmd];ターボ・ロボコンパンチ
type = VarSet
trigger1 = !Var(0)
trigger1 = Root,Command = "tosshin_s"
var(0) = 2100

[State 10000,Cmd];昇龍パンチ
type = VarSet
trigger1 = !Var(0)
trigger1 = Root,Command = "taiku_y"
var(0) = 1060

[State 10000,Cmd];昇龍パンチ
type = VarSet
trigger1 = !Var(0)
trigger1 = Root,Command = "taiku_x"
var(0) = 1050

;---------------------------------------------------------------------------
;var(1)先行入力解除時間。

[State 10000,必殺技入力受付]
type = VarSet
triggerall = !Var(1)
trigger1 = Root,Command = "s_100kick"
trigger2 = Root,Command = "taiku_s"
trigger3 = Root,Command = "tosshin_s"
trigger4 = Root,Command = "taiku_y"
trigger5 = Root,Command = "taiku_x"
var(1) = 10 ;先行入力解除時間

;---------------------------------------------------------------------------
;変数の処理。キャラごとの設定は不要。

[State 10000,入力受付時間減算];セットされた受付時間を減算する
type = VarAdd
trigger1 = var(1) > 0
var(1) = -1

[State 10000,入力受付時間リセット];負数にならないようにリセット
type = Varset
trigger1 = var(1) < 0
var(1) = 0

[State 10000,入力受付リセット];受付時間リセットと同時に入力受付リセット
type = Varset
trigger1 = var(1) = 0
var(0) = 0


;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;AIめくりガード用ステート
;ヘルパーのステート内で、本体から前後にずらした座標でInGuardDistに反応した場合にvarに代入。
;後ろのは単純に、マイナス距離から判定。
;前のは、相手から見て自分が後ろにいる時。振り向いた自分は、前側のヘルパーからガード反応を取得できる。

[State 10000, Turn];振り向き
Type = turn
Trigger1 = Facing != root,Facing ;本体と異なる向きなら
[State 10000, Posset in Root];座標Xを本体にあわせる
Type = Posset
Trigger1 = 1
X = Root,Pos X

[State 10000, Posadd 100];座標+100（本体から+100へずらす）
Type = Posadd
Trigger1 = 1
X = 100
[State 10000, Front GuardDist varset];前側のInGuardDistを代入
Type = Varset
var(40) = InGuardDist
Trigger1 = 1

[State 10000, Posadd -200];座標-200（本体から-100へずらす）
Type = Posadd
Trigger1 = 1
X = -200
[State 10000, Back GuardDist varset];後ろ側のInGuardDistを代入
Type = Varset
var(41) = InGuardDist
Trigger1 = 1

[State 10000, Posadd 100];座標+100（本体と同座標にもどす）
Type = Posadd
Trigger1 = 1
X = 100
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------交代タッグ記述その1
;===================================================================
;交代モーション
;===================================================================
[Statedef 358000]
type = S
ctrl = 0
velset = 0,0

;ココ
;交代モーションと台詞
;10F以上は確保して下さい。長すぎると待機までが長引くのでほどほどに
[state 358000,Anim変更]
type = changeanim
trigger1 = time = 0
value = 1950;			モーション

[State 358000, 交代ボイス]
type = PlaySnd
trigger1 = time = 1
value = 12,7;			台詞


[State 358000,カメラに追われないように]
type = ScreenBound
trigger1 = partner,stateno = 358003
value = 0
movecamera = 0,0

[state 8000];待機時間
type = varset
trigger1 = partner,stateno = 358003
sysfvar(4) = 60
ignorehitpause = 1

[state 8000,2];交代成立
type = varset
trigger1 = partner,stateno = 358003
sysfvar(3) = 1
ignorehitpause = 1

[state 8000,2];交代成立後無敵◇
type = nothitby
trigger1 = partner,stateno = 358003 || time > 10
value = SCA
time = 999

[state 358000,押し出し判定削除]
type = playerpush
trigger1 = partner,stateno = 358003
value = 0

[State 358000,ジャンプステートへ]
type = Changestate
trigger1 = animtime = 0 || time > 30
value = 358001

;===================================================================
;後退ジャンプ中
;===================================================================
[Statedef 358001]
type = S
ctrl = 0
anim = 40

;ココ
;ジャンプ音の指定
[State 358000, ジャンプ音]
type = PlaySnd
trigger1 = anim = 40 && animtime = 0
value = 0,1
persistent = 0

[State 358001,カメラに追われないように]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 358001,後方ジャンプ]
type = ChangeAnim
trigger1 = anim = 40 && animtime = 0
value = 43

[State 358001,ジャンプ速度]
type = VelSet
trigger1 = anim = 43
x = -15
Y = -5

[state 8001,5];特殊交代の待機時間
type = varset
trigger1 = time = 0
trigger1 = partner,sysfvar(3) = -2
sysfvar(4) = 60*5

[state 8001,5];ディレイドの待機時間
type = varset
trigger1 = time = 0
trigger1 = partner,sysfvar(3) < -2
sysfvar(4) = 60*2;◆

[State 358001,待機ステートに移行]
type = ChangeState
trigger1 = backEdgeDist <= -40
value = 358002

;===================================================================
;待機中
;===================================================================
[Statedef 358002]
type = A
ctrl = 0
anim = 0
movetype= I
physics = S

[state 8000];Attack消去
type = removeexplod
trigger1 = 1
ID = 358002

[state 8001];アシスト選択リセット
type = varset
trigger1 = sysfvar(3) != 0
sysfvar(3) = 0

[state 8002];待機時間0
type = varset
trigger1 = sysfvar(4) < 0
sysfvar(4) = 0

[state 8002];待機時間カウントダウン
type = varadd
trigger1 = sysfvar(4) > 0
sysfvar(4) = -1

[State 358002,カメラに追われないように]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0

[State 358002,透明化]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible

[state 358002,無敵化]
type = NotHitBy
trigger1 = 1
value = SCA

[state 358002,押し出し判定削除]
type = playerpush
trigger1 = 1
value = 0

[State 358002, 黒ずみ]
type = PalFX
trigger1 = 1
time = 1
add = 0,0,0
mul = 100, 100, 100

[State -358002,待機中ライフ回復]
type = LifeAdd
trigger1 = sysfvar(4) = 0
value = 1
;↓の一行はコメントアウト部分も含めて一切変更しないでください。
persistent = 3;回復;◇


[State 358002,向き合わせ]
type = Turn
trigger1 = numpartner
trigger1 = facing != partner,facing

[State 358002,すごく後ろに移動]
type = PosSet
trigger1 = 1
x = -10000*(facing)
y = 0
ignorehitpause = 1
persistent = 1


[State 358002,通常乱入]
type = ChangeState
triggerall = numpartner
trigger1 = partner,stateno = 358000 && partner,time >= 10;	相方が後退モーション
trigger2 = partner,alive = 0;								相方死亡
trigger3 = win || losetime || DrawGame;						ラウンド終了
trigger4 = ID < partner,ID && partner,stateno = 358002;		相方も待機ステート☆
value = 358003


[state 905900,AssistOK表示]
type = Explod
trigger1 = !numexplod(358001) && !numexplod(358002)
trigger1 = sysfvar(4) = 0
anim = F3580
pos =  ifelse(teamside=1,80*2,173*2), 38*2
postype = left
facing = ifelse(teamside=1,1,1)
bindtime = -1
supermovetime = 9999999999999
pausemovetime = 9999999999999
scale = .5, .5
ontop = 1
removetime = 1
ID = 358000

[state 905900,残り時間黄帯]
type = Explod
trigger1 = !numexplod(358001) && !numexplod(358002)
trigger1 = sysfvar(4) > 0
anim = F3583
pos =  ifelse(teamside=1,(139-ceil(sysfvar(4)*0.25))*2,180*2), 45*2
postype = left
facing = ifelse(teamside=1,1,1)
bindtime = -1
supermovetime = 9999999999999
pausemovetime = 9999999999999
scale = sysfvar(4)*0.25, .25
ontop = 1
removetime = 1
ID = 358003

[state 905900,残り時間黄帯_1P側の見栄え調整]
type = Explod
trigger1 = !numexplod(358001) && !numexplod(358002)
trigger1 = sysfvar(4) > 0 && teamside=1
anim = F3583
pos =  138*2, 45*2
postype = left
facing = ifelse(teamside=1,1,1)
bindtime = -1
supermovetime = 9999999999999
pausemovetime = 9999999999999
scale = 2, .25
ontop = 1
removetime = 1
ID = 358003

;===特殊交代===============
[state 8002,3];★
type = varset
sysfvar(3) = -2
triggerall = numpartner
triggerall = partner,alive && partner,stateno < 358000
triggerall = partner,ctrl && power >= 500 || power >= 1000
triggerall = sysfvar(4) <= 0
;乱入条件。常時ステートへのAI記述と同等でOKです;ココ
trigger1 = partner,command = "z" && partner,command = "holdback"
Trigger1 = partner,Alive && partner,var(59) <1 ;P前衛
trigger2 = command = "z" && command = "holdback"
Trigger2 = Alive && var(59) <1 ;P後衛
Trigger3 = Alive && var(59) > 0 && partner,Alive && partner,var(59) >0 ;AI
trigger3 = Random < var(58) * 1   ;何も考えずに技を出す
Trigger4 = Alive && var(59) > 0 && partner,Alive && partner,var(59) >0 ;AI
Trigger4 = Life > 450 && partner,Life < 350
trigger4 = Random < 10*var(59) && var(57)>0 ;レベルで確率を上げる
Trigger5 = Alive && var(59) > 0 && partner,Alive && partner,var(59) >0 ;AI
Trigger5 = Life > 300 && partner,Life < 200
trigger5 = Random < 20*var(59) && var(57)>0 ;レベルで確率を上げる

[state 8003];再突入F
type = varset
trigger1 = sysfvar(3) = -2
sysfvar(4) = 60*5

[State 358002,]
type = ChangeState
triggerall = numpartner
trigger1 = partner,alive
trigger1 = sysfvar(3) = -2
value = 358003

;===アシスト指定===============;ココ

;---ディレイド指定-------
[state 8002,1]
type = varset
triggerall = numpartner
triggerall = partner,alive && partner,movetype != H;★
triggerall = sysfvar(4) <= 0
;乱入後に移行するステート番号(-を付けて下さい)
sysfvar(3) = -3000
;乱入条件。常時ステートへのAI記述と同等でOKです
triggerAll = partner,HitDefAttr = SCA, HA, HT, HP
triggerAll = power >= 1500
trigger1 = partner,command = "c" && partner,command = "holdback"
Trigger1 = partner,Alive && partner,var(59) <1 ;P前衛
trigger2 = command = "c" && command = "holdback"
Trigger2 = Alive && var(59) <1 ;P後衛
Trigger3 = Alive && var(59) > 0 && partner,Alive && partner,var(59) >0 ;AI
trigger3 = Random < var(58) * 1   ;何も考えずに技を出す
Trigger4 = Alive && var(59) > 0 && partner,Alive && partner,var(59) >0 ;AI
trigger4 = partner,P2StateType != A && partner,P2BodyDist X < 220   ;地上
trigger4 = Random < 10*var(59) && var(57)>0 ;レベルで確率を上げる

;---アシスト攻撃A-------☆
[state 8002,1]
type = varset
triggerall = numpartner
triggerall = partner,alive
triggerall = sysfvar(4) <= 0
triggerall = partner,movetype != H;◇
;乱入後に移行するステート番号
sysfvar(3) = 1000
;乱入条件。常時ステートへのAI記述と同等でOKです
trigger1 = partner,command = "c" && partner,command = "holdback"
Trigger1 = partner,Alive && partner,var(59) <1 ;P前衛
trigger2 = command = "c" && command = "holdback"
Trigger2 = Alive && var(59) <1 ;P後衛
Trigger3 = Alive && var(59) > 0 && partner,Alive && partner,var(59) >0 ;AI
trigger3 = Random < var(58) * 1   ;何も考えずに技を出す

[state 8003];再突入F
type = varset
triggerall = partner,movetype != H;◇
trigger1 = sysfvar(3) = 1050
sysfvar(4) = 60*2.5;乱入終了後(失敗含む)に再度乱入可能になるまでのF数

;---アシスト攻撃B-------☆
[state 8002,1]
type = varset
triggerall = numpartner
triggerall = partner,alive
triggerall = sysfvar(4) <= 0
triggerall = partner,movetype != H;◇
;乱入後に移行するステート番号
sysfvar(3) = 1005 ;再突入Fの方にも書き換え必要箇所あり
;乱入条件。常時ステートへのAI記述と同等でOKです
trigger1 = partner,command = "c"
Trigger1 = partner,Alive && partner,var(59) <1 ;P前衛
trigger2 = command = "c"
Trigger2 = Alive && var(59) <1 ;P後衛
Trigger3 = Alive && var(59) > 0 && partner,Alive && partner,var(59) >0 ;AI
trigger3 = Random < var(58) * 1   ;何も考えずに技を出す
Trigger4 = Alive && var(59) > 0 && partner,Alive && partner,var(59) >0 ;AI
trigger4 = partner,p2StateType != L && partner,P2BodyDist X <380  ;距離
trigger4 = Random < 5*var(59) && var(57)>0 ;レベルで確率を上げる

[state 8003];再突入F
type = varset
triggerall = partner,movetype != H;◇
trigger1 = sysfvar(3) = 1060;上のステート番号とあわせる
sysfvar(4) = 60*2.5;乱入終了後(失敗含む)に再度乱入可能になるまでのF数
;-----------------------

