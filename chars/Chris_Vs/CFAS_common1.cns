;---------------------------------------------------------------------------
; HITA_RECOV (recovering in air, not falling)
[Statedef 5040]
type    = A
movetype= I
physics = N
ctrl = 1

[State 5040, 1]
type = ChangeState
trigger1 = !Alive
value = 5050

[State 5040, 2]
type = ChangeAnim
trigger1 = Anim != 5040
value = 5040

[State 5040, 4]
type = HitFallSet
trigger1 = 1
value = 0

[State 5040, 5]
type = Turn
trigger1 = P2Dist X < 0

[State 5040, 5]
type = VelAdd
trigger1 = 1
y = .5

[State 5040, 6]
type = veladd
trigger1 = command="holdfwd"
x = .25
[State 5040, 7]
type = veladd
trigger1 = command="holdback"
x = -.05

[State 5040, 8]
type = velset
trigger1 = vel y > 10 && screenpos y >= 0
y = 10
[State 5040, 9]
type = velset
trigger1 = vel x > 4
x = 4
[State 5040, 10]
type = velset
trigger1 = vel x < -4
x = -4

[State 5040, 12]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52

;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 5050]
type    = A
movetype= H
physics = N

[State 5050, 1]
type = ChangeAnim
trigger1= !Animtime
trigger1= (Anim=[5000,5004]) || (Anim=[5010,5014])
value= Anim+5

[State 1115050, 2]
type = ChangeAnim
trigger1= Time=1
trigger1= (Anim=[5000,5019]) && GetHitVar(yvel)<=-12
trigger2= Time=10
trigger2= (Anim=[5000,5019])
trigger3= (Anim=[5005,5009]) || (anim=[5015,5019])
trigger3= Animelemtime(Animelemno(0))>=1 && !Animelemtime(Animelemno(0)+1)
value= ifelse(SelfAnimExist(5051) && !gethitvar(xvel), 5051, 5030)

[State 1115050, 3]
type = ChangeAnim
trigger1= Anim=5030 && Vel Y>0
trigger1= SelfAnimExist(5035)
value= 5035

[State 1115050, 4]
type = ChangeAnim
trigger1= AnimTime = 0
trigger1= Anim = 5035
trigger2= !SelfAnimExist(5035)
trigger2= Anim=5030 && vel y>0
trigger3= (Anim=[5030,5035]) && Vel Y>=10
value= 5050

[State 5050, 5] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 6]
type = null;HitFallSet
trigger1 = Time = 0
trigger1 = PrevStateno != 5055
trigger1 = NumEnemy
trigger1 = !(Enemy,HitdefAttr = SCA,HA,HP,HT)
trigger2 = GetHitVar(yvel) <= 0
trigger2 = Vel Y > (-.5 * GetHitVar(yvel))
trigger2 = Pos Y <= -120
value = 0

;[State 5030, 7]
;type = VelMul
;trigger1 = Time = 0
;trigger1 = Vel X=[-6,6]
;trigger1 = PrevStateno = 5000 || PrevStateno = 5010 || PrevStateno = 5030
;trigger1 = !HitFall
;x = 1.5

;[State 5030, 8]
;type = VelMul
;trigger1 = Time = 0
;trigger1 = Vel Y=[-10,0]
;trigger1 = PrevStateno = 5000 || PrevStateno = 5010 || PrevStateno = 5030
;trigger1 = !HitFall
;y = 1.5

;[State 5050, 9] ;Gravity
;type = VelAdd
;trigger1 = 1
;y = .415625

[State 5050, 9] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 10]; Recover in mid air
type = ChangeState
trigger1 = Command = "recovery"
trigger1 = Pos Y >= -40
trigger1 = alive && HitOver
trigger1 = !HitFall || CanRecover
value = 5200

[State 5050, 10]; Recover in mid air
type = ChangeState
trigger1 = Pos Y < -40
trigger1 = alive && HitOver
trigger1 = !HitFall || CanRecover
value = 5040

[State 5050, 11]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = ifelse(!HitFall && alive, 5105, 5100) ;HIT_BOUNCE

[State 5050, 12]
type = ChangeState
triggerall = PrevStateno != 5055
trigger1 = Vel X > 0 && FrontEdgeBodyDist <= 3
trigger2 = Vel X < 0 && BackEdgeBodyDist <= 3
value = 5055

