
;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
;--------------------------------------------------------------

[statedef -2]
;------------------------------------

[state a]
type = nothitby
trigger1 = 1
value = sca

[state a]
type = lifeadd
trigger1 = var(25)
value = -var(25)
ignorehitpause = 1

[state a]
type = varset
trigger1 = var(25)
var(25) = 0
ignorehitpause = 1

[state a];アーマー用ヘルパー
type = Helper
trigger1 = numhelper(26) = 0
id = 26
name = "アーマー"
sprpriority = -3
pos = 0,0
postype = p1
stateno = 9995
helpertype = normal
pausemovetime = 0
bindtime = -1
keyctrl = 0 
ownpal = 1
;-------------------------------------


;--------------------------------------------------------------
[statedef -3]

[State 191, 1]
type = stopsnd
trigger1 = stateno = 0
trigger1 = prevstateno = 191
channel = 1

[State 191, 1]
type = stopsnd
trigger1 = stateno = 0
trigger1 = prevstateno = 191
channel = 2

[State -3]
type = AssertSpecial
trigger1 = alive = 1
flag = nostandguard
flag2 = nocrouchguard

;[State -3,現在のステート番号を常時var(1)に入れとく]
;type = VarSet
;trigger1 = MoveType != H
;trigger1 = StateNo != 9999
;var(0) = StateNo

;[State -3,現在のステート番号を常時var(1)に入れとく]
;type = VarSet
;trigger1 = MoveType != H
;trigger1 = StateNo != 9999
;var(1) = ctrl

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

;[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, 着地音]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0



;---------------------------------------------------------------------------
;AI(on)
[State -3, on]
type     = VarSet
triggerall = var(20) >= -1  ;要するにOFFの時が含まれていれば良い
triggerall = RoundState = [1,2]
trigger1 = Command = "AI00"||Command = "AI01"||Command = "AI02"||Command = "AI03"||Command = "AI04"
trigger2 = Command = "AI05"||Command = "AI06"||Command = "AI07"||Command = "AI08"||Command = "AI09"
trigger3 = Command = "AI10"||Command = "AI11"||Command = "AI12"||Command = "AI13"||Command = "AI14"
trigger4 = Command = "AI15"||Command = "AI16"||Command = "AI17"||Command = "AI18"||Command = "AI19"
trigger5 = Command = "AI20"||Command = "AI21"||Command = "AI22"||Command = "AI23"||Command = "AI24"
trigger6 = Command = "AI25"||Command = "AI26"||Command = "AI27"||Command = "AI28"||Command = "AI29"
trigger7 = Command = "AI30"||Command = "AI31"||Command = "AI32"||Command = "AI33"||Command = "AI34"
trigger8 = Command = "AI35"||Command = "AI36"||Command = "AI37"||Command = "AI38"||Command = "AI39"
trigger9 = Command = "AI40"||Command = "AI41"||Command = "AI42"||Command = "AI43"||Command = "AI44"
trigger10 = Command = "AI45"||Command = "AI46"||Command = "AI47"||Command = "AI48"||Command = "AI49"
trigger11 = Command = "AI50"
var(20)  = 1



[State -3]
Type = VarRandom
TriggerAll = Var(20) = 1
Trigger1 = Time = 1
Trigger2 = Time%60 = 1
Trigger2 = MoveType != I
Trigger3 = Time%1 = 1
Trigger3 = MoveType = I
V = 19
Range = 0,99
IgnoreHitPause = 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

;死蝿の葬列（ゲージレベル3）
[State -1, Triple Kung Fu Palm]
type = ChangeState
value = 3500
triggerall = RoundState = 2
triggerall = power >= 3000
triggerall = Var(20) = 1
triggerall = NumProjID(3501) = 0

;trigger1   = Var(19) = [20,25]
trigger1   = P2BodyDist X = [-100,100]
trigger1   = statetype = S
trigger1   = ctrl
trigger1   = Random = [0,700]

;trigger2  = Var(19) = [20,25]
;trigger2 = statetype != A
;trigger2 = hitdefattr = SC, NA, SA
;trigger2 = movecontact


;---------------------------------------------------------------------------
;メギドラオン（ゲージレベル２）
[State -1, Triple Kung Fu Palm]
type = ChangeState
value = 3100
triggerall = RoundState = 2
triggerall = power >= 2000
triggerall = Var(20) = 1
triggerall = NumProjID(3101) = 0 
;trigger1   = Var(19) = [20,25]
trigger1   = P2BodyDist X = [70,180]
trigger1   = statetype = S
trigger1   = ctrl
trigger1   = Random = [1,499]

;trigger2  = Var(19) = [20,25]
;trigger2 = statetype != A
;trigger2 = hitdefattr = SC, NA, SA
;trigger2 = movecontact


;---------------------------------------------------------------------------
;猛突進（ゲージレベル１）
[State -1, Triple Kung Fu Palm]
type = ChangeState
value = 3000
triggerall = RoundState = 2
triggerall = power >= 1000
triggerall = Var(20) = 1

;trigger1   = Var(19) = [20,25]
trigger1   = P2BodyDist X = [31,100]
trigger1   = statetype = S
trigger1   = ctrl
trigger1   = Random = [900,999]

trigger2  = Var(19) = [20,25]
trigger2 = statetype != A
;trigger2 = hitdefattr = SC, NA, SA
trigger2 = movehit
trigger2   = Random = [600,999]
trigger2   = (stateno = 210) && time > 5

trigger3= power >= 2000
trigger3   = P2BodyDist X = [31,100]
trigger3   = Random = [700,999]
trigger3  = p2movetype = A
trigger3   = ctrl
trigger3   = statetype = S

trigger4   = Random = [500,999]
trigger4　= life >= 400
trigger4   = P2BodyDist X = [31,100]
trigger4  = p2movetype = A
trigger4   = ctrl
trigger4   = statetype = S

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;空中突進
[State -1, Light Kung Fu Palm]
type = ChangeState
value = 1110
triggerall = RoundState = 2
triggerall = Var(20) = 1
triggerall = P2BodyDist X > 50
;triggerall = P2BodyDist Y = [-10,80]
triggerall = Pos Y < -30
triggerall = statetype = A

trigger1   = Random = [701,800]
trigger1   = statetype = A
trigger1   = ctrl
;trigger1 = stateno != [1110,1119]

;trigger2   = Random = [0,800]
trigger2   = (stateno = 610) && time > 5
trigger2   = movecontact

trigger3   = P2BodyDist X = [31,100]
trigger3   = Random = [700,999]
trigger3  = p2movetype = A
trigger3   = ctrl



;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
[State -3, 空中パンチ]
type = ChangeState
value = 610
triggerall = RoundState = 2
triggerall = var(20) = 1
triggerall = P2BodyDist X = [0,100]
triggerall = P2BodyDist Y = [-10,80]
triggerall = statetype = A

trigger1   = Random = [201,600]
trigger1   = ctrl

;trigger2   = Random = [0,800]
;trigger2   = (stateno = 600) && time > 4
;;trigger2   = movecontact

;---------------------------------------------------------------------------
[State -3, ブフーラ]
type = ChangeState
value = 600
triggerall = RoundState = 2
triggerall = var(20) = 1
triggerall = P2BodyDist X > 80
triggerall = P2BodyDist Y = [-30,50] 
triggerall = statetype = A
triggerall = NumProjID(601) = 0
trigger1   = Random = [0,200]
trigger1   = ctrl


;---------------------------------------------------------------------------
[State -3, 挑発]
type = ChangeState
value = 195
triggerall = var(20) = 1
triggerall = RoundState = 2
triggerall = power < 2600
triggerall = P2BodyDist X > 200 ;遠距離
triggerall = Life > LifeMax / 2 ;HPに余裕があるとき
triggerall = statetype != A
triggerall = ctrl

trigger1   = Random = 777       ;かなり低確率

;trigger2   = p2statetype = L    ;相手がダウン中
;trigger2   = Random = [0,100]

;trigger3   = Random = [0,750]
;trigger3   = P2BodyDist X = [-50,50]


;---------------------------------------------------------------------------
[State -3, メギド]
type = ChangeState
value = 1000
triggerall = RoundState = 2
triggerall = var(20) = 1
triggerall = P2BodyDist X = [50,150]
triggerall = statetype != A
triggerall = NumProjID(1001) = 0
trigger1   = Random = [599,999]
trigger1   = ctrl
;trigger1   = p2statetype != A 

;---------------------------------------------------------------------------
;突進
[State -3, Strong Kung Fu Palm]
type = ChangeState
value = 1100
triggerall = RoundState = 2
triggerall = Var(20) = 1
triggerall = statetype = S

trigger1   = Random = [300,699]
trigger1   = P2BodyDist X > 50
;trigger1   = p2statetype != A                   
trigger1   = ctrl

trigger2   = Random = [300,399]
trigger2   = p2movetype = I                   
trigger2   = ctrl

trigger3   = Random = [0,499]
;trigger2   = P2BodyDist X > 10
trigger3   = Movehit
trigger3  = (stateno = 210) && time > 5


trigger4   = P2BodyDist X = [31,100]
trigger4   = Random = [500,699]
trigger4  = p2movetype = A
trigger4   = ctrl


;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;浮遊突進
[State -3, Strong Kung Fu Palm]
type = ChangeState
value = 1150
triggerall = RoundState = 2
triggerall = Var(20) = 1
triggerall = statetype = S
trigger1   = Random = [450,599]
trigger1   = P2BodyDist X = [-60,240]
trigger1   = p2statetype = C                   
trigger1   = ctrl

trigger2   = Random = [450,799]
trigger2   = P2BodyDist Y = [40,-120]
trigger2   = p2statetype != S             
trigger2   = ctrl

trigger3   = Random = [700,999]
;trigger3   = P2BodyDist X = [54,70]
trigger3   = MoveContact
trigger3   = (stateno = 210) && time > 5
;trigger3   = p2statetype = C 

trigger4   = P2BodyDist X = [31,100]
trigger4   = Random = [300,499]
trigger4  = p2movetype = A
trigger4   = ctrl

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
[State -3, ジャンプ開始]
type = ChangeState
value = 40
triggerall = RoundState = 2
triggerall = var(20) = 1
triggerall = statetype = S
;triggerall = Random < P2BodyDist X ;離れるほど確率が高い
triggerall = Life < LifeMax

trigger1   = Random = [850,874]
trigger1   = P2BodyDist X > 10
trigger1   = ctrl

trigger2   = p2statetype = L
trigger2   = ctrl

trigger3   = enemy, numproj >= 1

;---------------------------------------------------------------------------
[State -3, 前にジャンプ]
type = VarSet
triggerall = RoundState = 2
triggerall = var(20) = 1
triggerall = Random < (P2BodyDist X) * 2 ;前にジャンプする確率は距離の2倍
trigger1   = stateno = 40
sysvar(1)  = 1

;---------------------------------------------------------------------------
[State -3, 立ちパンチ]
type = ChangeState
value = 210
triggerall = RoundState = 2
triggerall = var(20) = 1
triggerall = statetype = S
trigger1   = Random = [1,199]
trigger1   = P2BodyDist X = [30,80]
trigger1   = p2statetype != A                 
trigger1   = ctrl

;trigger2   = Random = [101,200]
;trigger2   = p2statetype = A                   
;trigger2   = ctrl

;trigger3   = Random = [701,999]
;trigger3   = P2BodyDist X = [31,53]
;trigger3   = MoveContact
;trigger3   = (stateno = 200) && time > 8


;---------------------------------------------------------------------------
[State -3, じおんが]
type = ChangeState
value = 200
triggerall = RoundState = 2
triggerall = var(20) = 1
triggerall = statetype = S
triggerall = NumProjID(201) = 0
trigger1   = Random = [0,599]
trigger1   = P2BodyDist X > 80
trigger1   = p2statetype != A              ;相手が立ち状態
trigger1   = ctrl

;trigger2   = Random = [0,100]
;trigger2   = p2statetype = A                   ;相手が空中状態
;trigger2   = ctrl

;trigger3   = Random = [0,700]
