trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, vs Kung Fu Girl]
type = Changestate
triggerall = numenemy
triggerall = matchover || (enemy,teammode=turns)
trigger1 = Enemy, Name = "Kung Fu Girl" && enemy,authorname = "DivineWolf" || Enemy, Name = "Another Kung Fu Girl"
trigger2 = Enemy, Name = "CvS_ZeroSuitSamus" && enemy,authorname = "chuchoryu"
trigger3 = Enemy, Name = "Elsa" && enemy,authorname = "chuchoryu"
value = 183

[State 180, 1]
type = ChangeState
trigger1 = !Time 
value = 181 + (random%2)

