;===================<CONSTANTS>================
[Data]
life=1000
power=2000
attack=100
defence=100
fall.defence_up=50
liedown.time=60
airjuggle=15
sparkno=s7010
guard.sparkno=s7000
KO.echo=0
volume=128
IntPersistIndex=0
FloatPersistIndex=0

[Size]
xscale=1
yscale=1
ground.back=18
ground.front=18
air.back=18 
air.front=18 
height=60 
attack.dist=160 
proj.attack.dist=90
proj.doscale=0
head.pos=6,-92
mid.pos=-6,-60
shadowoffset=0
draw.offset=0,0 

[Velocity]
walk.fwd  = 2.1      ;Walk forward
walk.back = -1.4     ;Walk backward
run.fwd  = 20, -4    ;Run forward (x, y)
run.back = -18,-4 ;Hop backward (x, y)
jump.neu = 0,-11    ;Neutral jumping velocity (x, y)
jump.back = -3.5    ;Jump back Speed (x, y)
jump.fwd = 3.5       ;Jump forward Speed (x, y)
runjump.back = -4.5,-11.85 ;Running jump speeds (opt)
runjump.fwd = 4.5,-11.85      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .58         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;Default language victory quotes **MUGEN 1.0**
;The default language victory quotes must be implemented in English.
[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "You have great power, but it's meaningless if you can't land a hit."; (vs. Casshan)
victory2 = "Even the three of you cannot defeat me. I will see that evil is beaten no matter the odds."; (vs. Doronjo)
victory3 = "The Science Ninja has been trained to fight giant robots like you. I knew how to beat you before the fight even began"; (vs. Gold Lightan)
victory4 = "Joe! When I give an order, you listen! You are not to fire the Bird Missile without my express permission!"; (vs. Joe)
victory5 = "I think that's enough training for one day. You're making improvements every time, Jun!"; (vs. Jun)
victory6 = "No group affiliation, and no distinguishing team marks. You look like a technologically advanced warrior, just like my team and I..."; (vs. Karas)
victory7 = "You need to be stronger if you want the right to bear the name of Eagle."; (vs. Ken the Eagle)
victory8 = "Hang up your lance. You talk a good game, but your training doesn't even begin to rival ours."; (vs. Polimar)
victory9 = "I've never seen armor like yours before. I'll just take a piece for Dr. Nambu to examine."; (vs. Tekkaman)
victory10 = "You appear to carry a great weight on your shoulders. Have you tried talking to your friends about it?"; (vs. Tekkaman Blade)
victory11 = "The Science Ninja doesn't fight just for the sake of fighting. Now, if you'll excuse me..."; (vs. Volter)
victory12 = "You use some strange weapons... You'd probably get along well with my teammate, Jimmy."; (vs. Yatterman-1)
victory13 = "I know that in your heart you yearn for world peace, but you'll need more training to help bring that about."; (vs. Yatterman-2)
victory14 = "I can tell you don't take fighting seriously. All your enemies up until now must have been really lame."; (vs. Ippatsuman)
victory15 = "You should quit before you get hurt. No matter how many times you fight me, I'll always win."; (vs. Galactor)
victory16 = "We fought your army and defeated them, now it will end here, Lord King"; (vs. Buraikin)
victory17 = "All Science Ninja members plan for every fight, and that's why we always win!"; (vs. Dobrai)
victory18 = "I always lead by example, and that's why I must win every fight."; (vs. Karochi)
victory19 = "Wherever evil lurks, we will root it out! That is the Science Ninja motto!"; (vs. Rosraisen)
victory20 = "That was a good match. I can trust you to fight to bring peace to the world, just like I'm trying to do!"; (vs. Ace)
victory21 = "There's something about you that's a bit... off."; (vs. Luna)
victory22 = "I'll always be two steps ahead of you. Lay down your weapon and surrender!"; (vs. Go Mifune)
victory23 = "Your flirtations will not work on highly trained warriors like us, temptress! You will not hinder us on our mission!"; (vs. Majo)
victory24 = "You have unparalleled aim! Who knew the Japan Security Special Forces had such a high-caliber sniper in their employ!"; (vs. Andro)
victory25 = "I can not believe that that girl is your friend, she's more beautiful than Ai-chan !!"; (vs. Shurato)
victory26 = "your appearance says nothing, but you have a science that I can not understand"; (vs. Hakushon)
victory27 = "Your passion is great, with the right training you will be a great hero like us"; (vs. chuchoryu)
victory28 = "the battle is difficult, your friend and you must work together for this new enemy"; (vs. Teru)
victory29 = "even if you are an enemy of the earth my team is dedicated to stop all the villains"; (vs. Astral Chameleon)
victory30 = "Science gatchaman ninja team is always at the service of everyone regardless of time or world"; (vs. Neon)

