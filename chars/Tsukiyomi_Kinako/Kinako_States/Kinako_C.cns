; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[state a]
type = ChangeAnim
triggerall = prevstateno != 45
trigger1 = time = 0
value = 41
elem = 3-(var(15)%10>0)

[state a]
type = VelAdd
trigger1 = time > 0
y = 0.1

[state a]
type = AfterImage
trigger1 = var(15)%10 > 0
trigger1 = time = 0
time = 44-(vel X>0)
length = 9
palbright = 25,25,90
palcontrast = 105,105,145
palpostbright = 0,0,0
paladd = 0,0,0
palmul = .45,.45,.75
timegap = 1
framegap = 4
trans = addalpha
alpha = 256,96

