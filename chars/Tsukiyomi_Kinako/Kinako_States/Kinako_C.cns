type    = C
physics = C
anim = 11
velset = 0,0
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12
velset = 0,0

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = N
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; High Jump Start
[Statedef 35]
type    = S
physics = N
ctrl = 0
facep2 = 1
sprpriority = 1

[state a, HJ]
type = VarSet
trigger1 = time = 0
trigger1 = var(15)/1000%10 = 1
var(15) = 1000000*floor(var(15)/1000000)+1

[state a, HJB]
type = VarSet
triggerall = time = 0
trigger1 = (var(15)/1000%10 = 2) && (facing = 1)
trigger2 = (var(15)/1000%10 = 3) && (facing = -1)
var(15) = 1000000*floor(var(15)/1000000)+2

[state a, HJF]
type = VarSet
triggerall = time = 0
trigger1 = (var(15)/1000%10 = 3) && (facing = 1)
trigger2 = (var(15)/1000%10 = 2) && (facing = -1)
var(15) = 1000000*floor(var(15)/1000000)+3

[State 40, 6]
type = ChangeState
trigger1 = time = 0
value = 40

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = N
ctrl = 0
facep2 = 1
sprpriority = 1

[state a]
type = VelSet
triggerall = time = 0
trigger1 = Anim != [100,101]
trigger1 = Anim != [500,501]
x = 0

[state a]
type = ChangeAnim
trigger1 = time = 0
value = 40-5*(var(15)%10>0)

[state a]
type = VelMul
trigger1 = time > 0
x = 0.6

[State 40, 1]
type = VarSet
trigger1 = time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
triggerall = time <= 1
trigger1 = p2dist X >= 0
trigger1 = command = "holdfwd"
trigger2 = p2dist X < 0
trigger2 = command = "holdback"
trigger3 = var(15)%10 = 3
sysvar(1) = 1

[State 40, 3]
type = VarSet
triggerall = time <= 1
trigger1 = p2dist X >= 0
trigger1 = command = "holdback"
trigger2 = p2dist X < 0
trigger2 = command = "holdfwd"
trigger3 = var(15)%10 = 2
sysvar(1) = -1

[State 40, 4]
type = VelSet
triggerall = var(15)%10 = 0
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[state a]
type = VelSet
triggerall = var(15)%10 > 0
trigger1 = AnimTime = 0
x = 4.5*(sysvar(1)=1)-2.0*(sysvar(1)=-1)
y = -13.5+2.1*(sysvar(1)=1)

[state a]
type = PlaySnd
trigger1 = AnimTime = 0
value = 0,0
persistent = 0

[state a]
type = PlaySnd
triggerall = var(15)%10 > 0
trigger1 = AnimTime = 0
value = 0,2
persistent = 0

[state a]
type = NotHitBy
trigger1 = 1
value = ,NT,ST,HT

[state a]
type = Explod
trigger1 = AnimTime = 0
anim = 6000
id = 6000
pos = 0,4
postype = p1
bindtime = 1
supermovetime = 2147483647
pausemovetime = 2147483647
sprpriority = 5
ownpal = 1
ignorehitpause = 1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
anim = 41
ctrl = 0

[state a]
type = AfterImageTime
trigger1 = time = 0
trigger1 = var(24) := 1
trigger1 = 1||var(15) := 0
time = 0

[state a]
type = Turn
trigger1 = time = 0
trigger1 = p2dist X < 0
trigger1 = var(24) := 2

[state a]
type = PosFreeze
trigger1 = time = 0
value = 1

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
triggerall = time = 0
trigger1 = command = "holdfwd"
sysvar(1) = (-1)**(var(24)=2)

[State 45, 5]
type = VarSet
triggerall = time = 0
trigger1 = command = "holdback"
sysvar(1) = -1*(-1)**(var(24)=2)

[State 45, 6]
type = VelSet
trigger1 = time = 1
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[state a]
type = Explod
trigger1 = time = 0
anim = 6000
id = 6000
pos = -3,0
postype = p1
supermovetime = 2147483647
pausemovetime = 2147483647
sprpriority = 5
ownpal = 1
ignorehitpause = 1

[State 45, 7]
type = ChangeState
trigger1 = time = 1
value = 50
ctrl = 1

