;BPA BackGround
[Statedef 6500]
anim = 9999
ctrl = 0

[state a]
type = PalFX
trigger1 = root,var(8) = 3
trigger1 = root,var(25) <= 1
time = 8
add = 100,0,0
mul = 200,100,100
ignorehitpause = 1

[state a]
type = PosSet
trigger1 = time = 0
x = screenpos X-pos X

[state a]
type = Null
trigger1 = name = "Miyazato Erika"
trigger1 = root,stateno = 2010
trigger1 = var(0) := 75
trigger2 = name = "Tsukiyomi Kinako"
trigger2 = root,stateno = 2110
trigger2 = var(0) := 106
trigger3 = name = "Tenrou Kunagi"
trigger3 = root,stateno = 2100
trigger3 = var(0) := 60

[state a]
type = Null
triggerall = time = 0
trigger1 = 1||fvar(0) := screenpos X
trigger1 = fvar(1) := 3*ceil(root,fvar(21)/3)/240.0

[state a]
type = Turn
trigger1 = time = 0
trigger1 = root,facing = -1

[state a];Generate Back Ground Flow
type = Explod
trigger1 = time%5 = 0
anim = 6500
ID = 6500
pos = 0,0
postype = back
bindtime = -1
removetime = ceil(fvar(0)/64*fvar(1))+5 ;15
supermovetime = 2147483647
pausemovetime = 2147483647
scale = .5*fvar(1),.5*fvar(1)
sprpriority = -6
ignorehitpause = 1

[state a];Back Ground Flow
type = Explod
trigger1 = time = 0
anim = 6501
ID = 6501
pos = 0,0
postype = back
bindtime = -1
removetime = ceil(fvar(0)/64*fvar(1)) ;10
supermovetime = 2147483647
pausemovetime = 2147483647
scale = .5*fvar(1),.5*fvar(1)
sprpriority = -6
ignorehitpause = 1

[state a];Back Ground Flow
