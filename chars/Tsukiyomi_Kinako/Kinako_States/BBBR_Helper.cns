trigger1 = var(2) != var(3)
var(4) = time
ignorehitpause = 1

[state a]
type = ModifyExplod
trigger1 = time-var(4) = [110,130]
trans = addalpha
alpha = 256-12*(time-var(4)-110),12*(time-var(4)-110)
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

[state a]
type = VarSet
trigger1 = root,var(25) = 0
var(5) = 1

[state a]
type = RemoveExplod
trigger1 = time-var(4) >= 130
trigger2 = var(5) = 1
trigger2 = root,var(25) > 0

[state a]
type = DestroySelf
triggerall = RoundState != 3
trigger1 = time-var(4) >= 130
trigger2 = var(5) = 1
trigger2 = root,var(25) > 0

