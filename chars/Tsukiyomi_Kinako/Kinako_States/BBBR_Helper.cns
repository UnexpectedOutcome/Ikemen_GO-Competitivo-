trigger1 = time = 0
trigger1 = fvar(0) > 320*fvar(1)
anim = 6502
ID = 6502
pos = 0,0
postype = back
bindtime = -1
removetime = ceil((fvar(0)-320*fvar(1))/64*fvar(1)) ;5
supermovetime = 2147483647
pausemovetime = 2147483647
scale = .5*fvar(1),.5*fvar(1)
sprpriority = -6
ignorehitpause = 1

[state a]
type = ModifyExplod
trigger1 = time >= 60+var(0)
ID = 6500
trans = addalpha
alpha = 256-256*(time-60-var(0))/25,256*(time-60-var(0))/25
