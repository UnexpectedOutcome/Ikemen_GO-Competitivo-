[Statedef -3]

;各種ゲージ表示位置設定
;各項目 var(○)=? の?部分 をお好みの数字に変えてください。
;正数だと下に下がって、負数（-）をつけると上に上がります。
;あまり大きい数字を入れると画面外にはみ出てしまいます。
;デフォルト（初期位置）に戻す場合は 0 にしてください。

[State ];ニトロゲージ y座標
type=Varset
trigger1=roundstate<=1
trigger2=numhelper(4800)
trigger2=helper(4800),time=1
var(48)=0

[State ];メッセージウィンドウ y座標
type=Varset
trigger1=roundstate<=1
trigger2=numhelper(4800)
trigger2=helper(4800),time=1
var(39)=0

;システムタイプセレクトの初期位置
;value=? の?部分 をお好みの数字に変えてください。;数値によりシステムタイプセレクトの初期位置が変わります。
;1=ニトロ+ロワイヤル（ORIGINAL）、2=アレンジ仕様（ARRANGE）
;1～2以外の数値にしないで下さい。不具合が発生してしまいます。

[State ];システムタイプ初期位置選択
type=varset
triggerall=RoundsExisted=0&&var(47)=0
trigger1=roundstate<=1
trigger2=numhelper(4800)
trigger2=helper(4800),time=1
var(47)=2

;ウィンドウタイプセレクトの初期位置
;value=? の?部分 をお好みの数字に変えてください。;数値によりアレンジモード時に表示されるウィンドウタイプの初期設定が変わります。
;1=サイズ大～ウィンドウ＆セリフ表示、2=サイズ小～ウィンドウ＆セリフ表示、3=サイズ大～ウィンドウ表示無し＆セリフ表示、4=サイズ小～ウィンドウ表示無し＆セリフ表示
;5=サイズ大～ウィンドウ＆セリフ表示無し、6=サイズ小～ウィンドウ＆セリフ表示無し
;0にするとランダムで決定し、1～6以外の数値にすると初期設定が 1 と同じタイプに決定されます。

[State ];ウィンドウタイプ初期位置選択
type=varset
triggerall=RoundsExisted=0&&var(38)=0
trigger1=roundstate<=1
trigger2=numhelper(4800)
trigger2=helper(4800),time=1
var(38)=1

[State ];アルor奈都美同キャラタッグ＆パートナー判定
type=Varset
triggerall=NumPartner
triggerall=(p3name="AL AZIF"||p3name="AIHARA NATSUMI")&&partner,Authorname="YU-TOHARU"&&ID>Partner,ID
trigger1=roundstate<=1
trigger2=numhelper(4800)
trigger2=helper(4800),time=1
var(46)=1

[State ]
type=VarSet
triggerall=NumPartner
triggerall=ID<Partner,ID&&partner,Authorname="YU-TOHARU"&&(P3name="AIHARA NATSUMI"||P3name="AL AZIF")&&var(22)=0
trigger1=roundstate<=1
trigger2=numhelper(4800)
trigger2=helper(4800),time=1
var(22)=1

[State ];氷設定1
type=Helper
trigger1=!numhelper(4000)&&time>=1&&numenemy
helpertype=normal
name="settei1"
ID=4000
pos=(enemynear,Const(size.mid.pos.x)),(enemynear,Const(size.mid.pos.y))
postype=p2
stateno=4000

[State ];氷設定2
type=Helper
trigger1=numenemy>=2&&!numhelper(4001)&&time>=1
helpertype=normal
name="settei2"
ID=4001
pos=(enemynear(1),Const(size.mid.pos.x)),(enemynear(1),Const(size.mid.pos.y))
postype=p2
stateno=4001

[State ];常駐ヘルパー
type=Helper
trigger1=!numhelper(4800)&&time>=1&&numenemy
helpertype=normal
name="main helper"
ID=4800
postype=right
stateno=4800
supermovetime=99999999999
pausemovetime=99999999999
ownpal=1

[State ];システムタイプセレクトヘルパー
type=Helper
trigger1=RoundsExisted=0&&roundstate<=1&&!numhelper(4801)&&time=2&&numenemy
helpertype=normal
name="systemtype select"
ID=4801
pos=ifelse(facing=1,0,-2),-180
postype=p1
stateno=4801
supermovetime=999999999
pausemovetime=999999999
facing=ifelse(facing=1,1,-1)

[State ];遭遇システムヘルパー
type=Helper
trigger1=!numhelper(7099)&&time>=1&&roundstate=1&&numenemy
helpertype=normal
name="encounter system"
ID=7099
postype=p1
stateno=7098
supermovetime=99999999999
pausemovetime=99999999999

[State ];特殊モード起動
type=Helper
trigger1=RoundsExisted=0&&roundstate<=1&&!numhelper(7093)&&time=2&&numenemy
helpertype=normal
name="SP mode"
ID=7093
postype=p1
stateno=7093
supermovetime=99999999
pausemovetime=99999999

[State ]
type=varrandom
trigger1=time=0
v=0
range=1,4

[State ];ダメージ弱
type=PlaySnd
trigger1=Time=1&&Alive&&(stateno=5000||stateno=5010||stateno=5020||stateno=5070||stateno=5080)
value=s1,var(0)
channel=3

[State ];ダメージ大
type=PlaySnd
trigger1=Time=1&&Alive&&stateno=5030
value=s3,ifelse((var(0)=[1,2]),1,2)
channel=3

[State ];やられボイス
type=varrandom
trigger1=time=10&&var(28)=0&&!alive
v=4
range=1,3

[State ]
type=varset
trigger1=var(28)=0
trigger1=P2name="another blood"||P2name="another_blood"||P2name="anotherblood"||P2name="Another Blood_AS"||P4name="another blood"||P4name="another_blood"||P4name="anotherblood"||P4name="Another Blood_AS"
var(28)=1

[State ]
type=varset
triggerall=var(28)=0
trigger1=P2name="Nyarlathotep"||P4name="Nyarlathotep"||P2name="nyar"||P4name="nyar"||(P2name="null"&&enemynear,authorname="null")||P2name="Sister_NYA"||P4name="Sister_NYA"
trigger2=numenemy>=2
trigger2=P4name="null"&&enemynear(1),authorname="null"
var(28)=2

[State ];やられボイス
type=varrandom
trigger1=(var(28)=[1,2])&&!alive&&time=10&&MatchOver=0&&(TeamMode=single ||TeamMode=simul)
v=4
range=6,8

[State ]
type=varset
trigger1=(var(28)=[1,2])&&(MatchOver=1||TeamMode=turns)
var(4)=ifelse(var(28)=2,4,5)

[State ]
type=PlaySnd
trigger1=numhelper(4800)=1&&!numhelper(507021)
trigger1=helper(4800),var(32)=0&&!alive&&var(2)=0&&((var(28)=0&&time>=1)||((var(28)=[1,2])&&(var(4)=[4,8])))
value=s4,var(4)-ifelse((var(4)=[6,8]),5,0)
persistent=0

[State ];やられボイス制御
type=varset
trigger1=!alive&&time>=1&&((var(28)=0&&(var(4)=[1,3]))||((var(28)=[1,2])&&(var(4)=[4,8])))
var(2)=1

[State ]
type=AfterImage
trigger1=movetype=H
time=0
ignorehitpause=1

[State ];チャンスメイク色解除
type=PalFX
trigger1=prevstateno=[390,392]
time=0
add=0,0,128
mul=0,0,128
sinadd=0,0,128,0
invertall=0

;ハイジャンプ
[State ];ハイジャンプ制御
type=varadd
trigger1=command="holddown"
var(19)=1

[State ];ハイジャンプ制御解除
type=varset
trigger1=(command!="holddown"&&time>=5)||stateno=52
var(19)=0

[State ]
type=varset
trigger1=command="holddown"&&statetime>=6
var(14)=1

[State ]
type=varset
trigger1=var(14)!=1&&command="ハイジャンプ"&&ctrl=1&&statetype!=A
var(9)=1

[State ]
type=varset
trigger1=(var(14)=1&&command="ハイジャンプ")||movetype=H||movetype=A||var(19)=0||stateno=52
var(14)=0

[State ]
type=varset
trigger1=(stateno=50&&time=2)||(prevstateno=100&&command!="holdfwd")||(prevstateno=105&&command!="holdback")||((prevstateno=[100,105])&&command="holddown")||(command="holddown"&&statetime>=10)
var(9)=0

[State ]
type=veladd
trigger1=var(9)=1&&stateno=50
y=-6
persistent=0

[State ]
type=veladd
trigger1=var(9)=1&&stateno=50&&(command="holdfwd"||command="holdback")
x=ifelse(command="holdfwd",3,-3)
persistent=0

[State ]
type=VarSet
trigger1=statetype=S||statetype=C||stateno=0
var(3)=0

[State ]
type=RemoveExplod
trigger1=statetype!=A||movetype=H
ID=601

[State ]
type=VarSet
trigger1=RoundState=[0,1]
var(16)=1

[State ];挑発キャンセル音消し
type=StopSnd
trigger1=RoundState=2&&var(16)=1
channel=0

[State ]
type=VarSet
trigger1=RoundState=2&&var(16)=1
var(16)=0
