trigger1=command="holdfwd"
x=(const(velocity.walk.fwd.x))*(ifelse(helper(4800),var(7),.5,1))

[State ]
type=VelSet
trigger1=command="holdback"
x=(const(velocity.walk.back.x))*(ifelse(helper(4800),var(7),.5,1))

[State ]
type=ChangeAnim
trigger1=vel x>0&&((Anim!=20&&Anim!=5)||(Anim=5&&AnimTime=0))
value=20

[State ]
type=ChangeAnim
trigger1=vel x<0&&((Anim!=21&&Anim!=5)||(Anim=5&&AnimTime=0))
value=21

