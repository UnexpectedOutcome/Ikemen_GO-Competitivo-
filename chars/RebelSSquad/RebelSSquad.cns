trigger1 = !numexplod(1)&&var(0)>9
anim = 20010 + var(3)
ID = 1
postype = left
pos = cond(teamside = 1, 64, 304),67; ceil((1.33 * gameheight / gamewidth) * 0) ; top left of screen for player 1, top right for player 2
