; KFM's constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

; これはKFMの定数と状態のファイルです。
; このファイルの中には注釈が散らされているので、CNSを習いたいお方は
; 読んでみたらいいです。

[Data]
life = 8000           ;最大ヒットポイント値
attack = 100           ;攻撃力倍率
defence = 100           ;防御力倍率
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 0.3           ;ゲルトルートの大きさの倍率(横幅)、1で原作と同等のサイズ
yscale = 0.3           ;ゲルトルートの大きさの倍率(高さ)、1で原作と同等のサイズ
ground.back = 0
ground.front = 0
air.back = 0
air.front = 0
height = 0
attack.dist = 0
proj.attack.dist = 0
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 0
walk.back = 0
run.fwd  = 0, 0
run.back = 0,0
jump.neu = 0,0
jump.back = 0
jump.fwd = 0
runjump.back = 0,0
runjump.fwd = 0,0
airjump.neu = 0,0
airjump.back = 0
airjump.fwd = 0

[Movement]
airjump.num = 1      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .05  ;Friction coefficient when standing
crouch.friction = .02 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Variable usage:
; This is a record of the variables that KFM uses. Keeping a record of your
; variable usage helps you avoid careless mistakes later.
; var(1)  - Used in kfm.cmd for combo condition (updated every tick)
; var(2)  - Used in Kung Fu Throw (state 800) to remember if fwd was being
;           held (remembered from state 800 through state 810).


;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = DestroySelf
trigger1 = 1

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; Win pose 1 - Bow
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0
sprpriority = 20

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 2]
type = PalFX
trigger1 = time<154
time = 1
add = 0,0,0
mul = 0,0,0
sinadd = 256,256,256,10
invertall = 0
color = 256
[State 191, 2]
type = BGPalFX
trigger1 = time<154
time = 1
add = 0,0,0
mul = 0,0,0
sinadd = 256,256,256,10
invertall = 0
color = 256

[State -2];イントロ
type = Explod
trigger1 = time = 0
anim = 190
ID = 0
pos = 0, 0
postype = left
facing = 1
vfacing = 1
bindtime = -1
vel = 0, 0
accel = 0, 0
random = 0, 0
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = 1/1.5, 1/1.5
sprpriority = 20
ontop = 1
shadow = 0, 0, 0
ownpal = 1
removeongethit = 1

[State ]
type = PlaySnd
trigger1 = AnimElem = 18
value = 0,0
volume = 5000
[State ]
type = PlaySnd
trigger1 = AnimElem = 40
value = 0,1
volume = 5000
[State ]
type = PlaySnd
trigger1 = AnimElem = 56
value = 0,2
volume = 5000
[State ]
type = PlaySnd
trigger1 = AnimElem = 71
value = 0,3
volume = 5000

[State -2,へるぱかんり]
type = DestroySelf
trigger1 = animtime=0
trigger2 = roundstate>1

;---------------------------------------------------------------------------
; Taunt
; CNS difficulty: easy
[Statedef 195]
type = S
ctrl = 0
anim = 195
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 195, 1]
type = CtrlSet
trigger1 = Time = 40
value = 1

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;グリーフシード
[Statedef 5152]
type = S
ctrl = 0
anim = 5152
movetype = I
physics = S
sprpriority = 10

[State ]
type = AngleDraw
trigger1 = 1
value = fvar(2)

[State ]
type = varadd
trigger1 = var(1)=0
fvar(2)=1

[State ]
type = varset
trigger1 = var(1)=1
fvar(2)=fvar(2)*0.9
[State ]
type = varset
trigger1 = var(1)=2
fvar(2)=0

[State ]
type = PlaySnd
trigger1 = Pos Y >-5
value = 5150, 1
volume = 100
channel = 51
ignorehitpause = 1

[State ]
type = veladd
trigger1 = var(1)=0
trigger2 = var(1)=1
y = 0.1
[State ]
type = velset
trigger1 = var(1)=0
trigger1 = Pos Y >-5
y = -2

[State ]
type = velset
trigger1 = var(1)=1
trigger1 = Pos Y >-5
y = 0

[State ]
type = varadd
trigger1 = Pos Y >-5
var(1)=1

[State ]
type = AssertSpecial
trigger1 = time<240
flag = roundnotover

[State ]
type = posSet
trigger1 = Pos Y >-5
y = -8

;---------------------------------------------------------------------------ハサミＡ
[Statedef 300]
type = S
ctrl = 0
;velset = 0,0
sprpriority = -11

[State ]
type = PlaySnd
trigger1 = time<=160
trigger1 = time%36=21
value = 210, 0
volume = -80+time
channel = 7
ignorehitpause = 1

[State ]
type = PlaySnd
trigger1 = time>160
trigger1 = time%36=21
value = 210, 0
volume = 80
channel = 7
ignorehitpause = 1

[State ]
type = varset
trigger1 = time%36<9
var(2)=0
ignorehitpause = 1
[State ]
type = varset
trigger1 = time%36>=9
trigger1 = time%36<16
trigger2 = time%36>=29
trigger2 = time%36<36
var(2)=1
ignorehitpause = 1
[State ]
type = varset
trigger1 = time%36>=16
trigger1 = time%36<21
trigger2 = time%36>=24
trigger2 = time%36<29
var(2)=2
ignorehitpause = 1
[State ]
type = varset
trigger1 = time%36>=21
trigger1 = time%36<24
var(2)=3
ignorehitpause = 1

[state ];部位の回転
type = BindToParent
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State ];アニメ番号
type = ChangeAnim
trigger1 = 1
value = 104+var(2)

[State ]
type = AngleDraw
trigger1 = 1
scale =fvar(0)*0.1,fvar(1)*0.1
value = fvar(2)+60

[State ]
type = varadd
trigger1 = root,var(0)<80
fvar(2)=1.5
ignorehitpause = 1

[State ]
type = varset
trigger1 = 1
fvar(0)=10
ignorehitpause = 1
[State ]
type = varadd
trigger1 = time<80
trigger1 = time%2=0
fvar(1)=0.1
ignorehitpause = 1
[State ]
type = varadd
trigger1 = time>80
trigger1 = time<83
fvar(1)=360/fvar(2)
ignorehitpause = 1
[State ]
type = varset
trigger1 = time>190
fvar(1)=fvar(1)*0.8
ignorehitpause = 1

[State ]
type = projectile
triggerall = root,var(1)=300
triggerall = fvar(2)=[110,130]
trigger1 = root,var(0)=81
trigger1 = 1>Const (size.xscale)
attr = S, NA
hitflag =MADF
guardflag =MA
animtype  = light
damage    = 250*Const (size.xscale), 0
pausetime = 0,8
sparkno = -1
guard.sparkno = -1
sparkxy = 0, 0
hitsound   = S200,0
guardsound = 6,0
ground.type = high
ground.slidetime = 6
ground.hittime  = 7
ground.velocity = 6,-5
guard.hittime = 7
air.velocity = 5,-6
getpower = 10,5
givepower = 0, 0
guard.kill = 1
projID = 300
projanim = 300
projedgebound =99999
projremovetime = 2
projscale=Const (size.xscale),Const (size.yscale)
velocity = 0, 0
offset =0,0
accel = 0, 0
supermovetime = 0
pausemovetime = 0
ignorehitpause=1
fall=1
fall.recover =0
guard.dist =ifelse(Const (size.xscale)-1,10000,-1000)
