; Common state file for M.U.G.E.N beta 2002.04.14
;
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump.
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

;音声ファイル
;0-0ドア1
;0-1ドア2
;0-2ドア3
;0-3ドア4
;0-4遠くの警戒音
;190-0気づいて顔を下ろす
;191-0椅子を投げ飛ばす
;191-0椅子の着弾
;201-0飛行音
;210-0ハサミ音
;5150-0死亡爆発
;5150-1グリーフシードぽろり

;10000-0アントニー笑い声
;15150-1アントニー死亡

;20000-0アーデルベルト登場
;20001-0アーデルベルト飛行
;20001-1アーデルベルト警戒音
;20200-0アーデルベルト頭突き
;21000-0アーデルベルト合体
;22000-0小アーデルベルト変形
;25150-1小アーデルベルト死亡

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = N
sprpriority = 0
[State 120, 2]
type = StateTypeSet
trigger1 = var(1)=[300,400]
trigger1 = var(0)>75
trigger2 = var(1)=200
trigger2 = var(0)>245
movetype=A
[State ];超コントロールセット
type = ctrlset
trigger1 = var(1)!=0
value=0
[State ]
type = ctrlset
trigger1 = roundstate>1
trigger1 = var(1)=0||var(1)=20||var(1)=21
value=1
[State ]
type = turn
trigger1 = Facing = 1
trigger1 = TeamSide = 1
trigger1 = var(1)=190
trigger2 = Facing = -1
trigger2 = TeamSide = 2
trigger2 = var(1)=190
trigger3 = var(1)=191
trigger3 = var(0)=120
trigger3 = P2Dist X<0
trigger4 = var(1)=5
trigger4 = var(0)=30
trigger5 = var(1)=105
trigger5 = var(0)=30
trigger6 = var(1)=200
trigger6 = var(0)=140
trigger6 = P2Dist X<0

