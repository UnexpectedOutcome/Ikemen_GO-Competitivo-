; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Gertrud"        ;Name of character
displayname = "Gertrud" ;Name of character to display
versiondate = 06,26,2011    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "ninnniku"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = Gertrud.cmd   ;Command set
cns     = Gertrud.cns   ;Constants
st      = Gertrud.cns   ;States
stcommon = commonG.cns ;Common states
sprite  = Gertrud.sff   ;Sprite
anim    = Gertrud.air   ;Animation
sound   = Gertrud.snd   ;Sound
pal1    = Gertrud.act

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
