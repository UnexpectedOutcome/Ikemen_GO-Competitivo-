;Advancing Guard Fwd
[Statedef 580]
type    = A
movetype= I
physics = N
velset = 0,0
anim = 580

[State 580, Not Get Hit]
type = NotHitBy
Trigger1 = Time >= 0
value = , AA ,AP ,AT
Time = 1

[State 580, Push]
type = PlayerPush
trigger1 = Time >= 0
value = 1

[State 580, Shove]
type = VelSet
trigger1 = Time >= 0
x = 10

[State 580, Done]
type = DestroySelf
trigger1 = Time = 30

;Advancing Guard Back
