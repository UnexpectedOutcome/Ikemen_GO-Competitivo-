[Data]
life = 875
attack = 108
defence = 100
power = 9000
fall.defence_up = 50
liedown.time = 40
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
IntPersistIndex = 50
FloatPersistIndex = 39

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 20     ;Player width (back, ground)
ground.front = 20    ;Player width (front, ground)
air.back = 15        ;Player width (back, air)
air.front = 15       ;Player width (front, air)
height = 95          ;Height of player (for opponent to jump over)
attack.dist = 200     ;Default attack distance
proj.attack.dist = 100 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 0, -86   ;Approximate position of head
mid.pos = 0, -59    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 1.4      ;Walk forward
walk.back = -1.2     ;Walk backward
run.fwd  = 3.6, 0    ;Run forward (x, y)
run.back = -3.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-7.4    ;Neutral jumping velocity (x, y)
jump.back = -1.55    ;Jump back Speed (x, y)
jump.fwd = 1.5       ;Jump forward Speed (x, y)
runjump.back = -1.55,-7.1 ;Running jump speeds (opt)
runjump.fwd = 2,-7.1      ;.
airjump.neu = 0,-7.1      ;.
airjump.back = -2.1      ;Air jump speeds (opt)
airjump.fwd = 2.1         ;.

[Movement]
airjump.num = 1      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .34         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

[Quotes]
victory1= "Everything will be all right, you can do it!"
victory2= "You need to improve the power of your magic!"

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; DRAWGAME (Time over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, 1] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

[State 175, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 175

[State 175, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[Statedef 180]
type = S

[State 180]
Type=VictoryQuote
Trigger1=1
value=2

[State 180]
Type=VictoryQuote
Triggerall=enemy,authorname="Seravy"
Trigger1=enemy,name="Sakura Kinomoto"
value=1

[State 180, 2]
type = ChangeState
trigger1 = Time = 0
value = 181
