; Win pose 1
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, end]
type = AssertSpecial
trigger1 = time <300
flag = RoundNotOver

[State 181]
Type= PlaySnd
Trigger1=time=0
Value=180,0

