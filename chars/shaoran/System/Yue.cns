[Data]
life = 900
attack = 100
defence = 100
power = 9000
fall.defence_up = 50
liedown.time = 35
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
IntPersistIndex = 50
FloatPersistIndex = 39

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 30     ;Player width (back, ground)
ground.front = 30    ;Player width (front, ground)
air.back = 30        ;Player width (back, air)
air.front = 30       ;Player width (front, air)
height = 125          ;Height of player (for opponent to jump over)
attack.dist = 130     ;Default attack distance
proj.attack.dist = 120 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 0, -115   ;Approximate position of head
mid.pos = 0, -80    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.4      ;Walk forward
walk.back = -3.2     ;Walk backward
run.fwd  = 4.6, 0    ;Run forward (x, y)
run.back = -5.5,-5.8 ;Hop backward (x, y)
jump.neu = 0,-9.4    ;Neutral jumping velocity (x, y)
jump.back = -3.55    ;Jump back Speed (x, y)
jump.fwd = 3.5       ;Jump forward Speed (x, y)
runjump.back = -3.55,-9.1 ;Running jump speeds (opt)
runjump.fwd = 4,-9.1      ;.
airjump.neu = 0,-9.1      ;.
airjump.back = -4.1      ;Air jump speeds (opt)
airjump.fwd = 4.1         ;.

[Movement]
airjump.num = 3      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

[Quotes]
victory1= "The Judgement is over. Hand over your Clow Cards. Now it's time for the real candidate."
victory2= "I'll continue to guard the Clow Cards from the likes of you."
victory3= "What are you doing in that weak body, Master?"
victory4= "Clow Reed was a better Master than you..."
victory5= "The Judgement is over. There are no more candidates, so The Catastrophe shall fall upon the world."

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170]
Type=ChangeState
Trigger1=Matchover
Trigger1=enemy,authorname="Seravy"
Trigger1=enemy,name="Sakura Kinomoto"
value=171

[State 170]
Type= PlaySnd
Triggerall=time=0
Trigger1=!(enemy,authorname="Seravy")
Trigger2=!(enemy,name="Sakura Kinomoto")
value=171,0

[Statedef 171]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170]
Type= PlaySnd
Trigger1=time=0
value=170,0

[State 170]
Type=AssertSpecial
Trigger1=time<360
flag=roundnotover

;---------------------------------------------------------------------------
; DRAWGAME (Time over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, 1] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

[State 175, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 175

[State 175, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(190)
value = 190

[State 191]
Type=AssertSpecial
Trigger1=1
flag=intro

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191

;---------------------------------------------------------------------------
; INTRO (override this state to give character an intro)
[Statedef 191]
type = S
ctrl = 0
anim= 190

[State 191]
Type=AssertSpecial
Trigger1=1
flag=intro

[State 191]
Type=PlaySnd
Trigger1=time=0
value=190,0
channel=1

[State 191, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

