[Statedef -3]

;==========================================
;ブロッキングレベル
[State -3, 1]
type = Varset
triggerall = var(59)
trigger1 = RoundState = 2
var(55) = 2;←←←★ここの数値を変更でブロッキングレベル変化。レベルの幅は1～10。10がMAXレベル。0でブロッキング無し。

IgnoreHitPause = 1
;==========================================





;-------------------------------------------------------------------------------


[State -3]
Type = varset
Triggerall = var(59) = 0 && roundstate < 3
trigger1 = command = "x" ^^ command = "x2"
trigger2 = command = "a" ^^ command = "a2"
trigger3 = command = "y" ^^ command = "y2"
trigger4 = command = "b" ^^ command = "b2"
trigger5 = command = "c" ^^ command = "c2"
trigger6 = command = "z" ^^ command = "z2"
trigger7 = command = "start" ^^ command = "start2"
trigger8 = command = "fwd" ^^ command = "fwd2"
trigger9 = command = "back" ^^ command = "back2"
trigger10 = command = "up" ^^ command = "up2"
trigger11 = command = "down" ^^ command = "down2"
trigger12 = command = "AI0"
trigger13 = command = "AI1"
trigger14 = command = "AI2"
var(59) = 8
ignorehitpause = 1

[State -3]
type = helper
trigger1 = !numhelper(33000)
