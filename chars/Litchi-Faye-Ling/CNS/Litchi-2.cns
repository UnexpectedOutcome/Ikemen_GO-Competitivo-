;-------------------------------------------------------------------------------
[Statedef -2]

;#ADD004BASC PIEs#
;============================================================================
; edited life & power bar
[State -2,1]
type = Helper
triggerall = !IsHelper
trigger1 = NumHelper(10000) = 0
trigger1 = roundstate = 2
helpertype = normal ;player
name = "10000"
ID = 10000
stateno = 10000
pos = 0,-55
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 1
size.xscale = 0.33
size.yscale = 0.33






