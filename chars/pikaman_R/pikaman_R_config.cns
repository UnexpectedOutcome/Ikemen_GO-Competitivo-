[StateDef 30050]
Type = A
movetype = I
ctrl = 0
velset = 0, 0
anim = 9999

[state 99999, 間違いで本体が来たら立ちへ移行]
type = selfstate
trigger1 = !ishelper
value = 0

[state 99999, 不可視化]
type = assertspecial
trigger1 = 1
flag = invisible
flag2= noshadow

[state 99999, 無敵化]
type = nothitby
trigger1 = 1
value = SCA,AA,AP,AT

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;★CONFIGここから
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------



;---------------------------------------------------------------------------
;ゲージ表示設定
;---------------------------------------------------------------------------

;━━━━━━━━━━━━━━━
;●表示設定（0~1）
;━━━━━━━━━━━━━━━

trigger1 = 1 || var(52) := 1			;1：ゲージ表示
										;0：ゲージ非表示
;━━━━━━━━━━━━━━━
;●ゲージ位置設定
;━━━━━━━━━━━━━━━

trigger1 = 1 || var(50) := 0			;数字を大きくすると画面中央に寄ります。
trigger1 = 1 || var(51) := 0			;数字を小さくすると画面上方に寄ります。目安としては-155位に設定するとデフォルトライフバーの少し下くらいの高さになります


;---------------------------------------------------------------------------
;システム設定
;---------------------------------------------------------------------------

;━━━━━━━━━━━━━━━
;●先行入力設定
;━━━━━━━━━━━━━━━

trigger1 = 1 || var(53) := 10			;先行入力受付フレーム設定。高くし過ぎると技が勝手に出たりするので注意。
										;デフォルトは10。

;━━━━━━━━━━━━━━━
;●ボイス設定(voice)
;━━━━━━━━━━━━━━━
[State ];
type = Parentvarset
trigger1= time = 0
var(17) = 1								;1にするとボイス有。0でなし。




































;---------------------------------------------------------------------------
;★CONFIGここまで
;---------------------------------------------------------------------------


;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;動作補助系
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


[state 99999, posset]
type = posset
trigger1 = 1
x = root,pos X
y = 9999

[state 99999, turn]
type = turn
trigger1 = root,facing != facing

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;カウンターヒット判定
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[state -2, ];カウンターヒット判定
type = Parentvarset
triggerall = Roundstate = 2 && Root,var(4) = 0
trigger1 = Enemynear(root,var(53)),Movetype = A
var(4) = 1
IgnoreHitPause = 1

[state -2, ];カウンターヒット判定消滅
type = Parentvarset
triggerall = Root,var(4) != 0
trigger1 = Root,Numtarget
trigger1 = Root,movehit = 1 || Root,Projhittime(0) = 1
trigger2 = Enemynear(root,var(53)),Movetype != A
var(4) = 0
IgnoreHitPause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ゲージ表示
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

;==========　ゲージ表示1P----------------------------------------

[State ];枠
Type = Explod
triggerall = teamside = 1 && var(52)
triggerall = (Roundstate = 2 || (Roundno > 1 && Roundstate <=2))
triggerall = numexplod(30010) = 0
trigger1 = !numpartner
trigger2 = numpartner
trigger2 = partner,ID > root,ID
anim = 30010
ID = 30010
pos = 10+var(50), 230+var(51)
postype = left
bindtime = -1
sprpriority = 7
removetime = -1
supermovetime = 2147483647
pausemovetime = 2147483647

;==========　

[State ];バー(伸びてる時)
Type = Explod
triggerall = teamside = 1 && var(52)
triggerall = (Roundstate = 2 || (Roundno > 1 && Roundstate <=2))
triggerall = numexplod(30011) = 0 && numexplod(30012) = 0 && root,var(40) < 5400
trigger1 = !numpartner
trigger2 = numpartner
trigger2 = partner,ID > root,ID
anim = 30011
ID = 30011
pos = 10+var(50), 230+var(51)
postype = left
bindtime = -1
sprpriority = 8
removetime = -1
supermovetime = 2147483647
pausemovetime = 2147483647


[State , エフェクト変更]
Type = ModifyExplod
trigger1 = numexplod(30011)
ID = 30011
scale = root,var(40)*0.0001851851851851852,1

[State , エフェクト変更]
Type = RemoveExplod
triggerall = numexplod(30011)
trigger1 = root,var(40) >= 5400 || roundstate > 2 
ID = 30011

;==========　

[State ];バー(満タン)
Type = Explod
triggerall = teamside = 1 && var(52)
triggerall = (Roundstate = 2 || (Roundno > 1 && Roundstate <=2))
triggerall = numexplod(30012) = 0 && root,var(40) >= 5400
trigger1 = !numpartner
trigger2 = numpartner
trigger2 = partner,ID > root,ID
anim = 30012
ID = 30012
pos = 10+var(50), 230+var(51)
postype = left
bindtime = -1
sprpriority = 8
removetime = -1
supermovetime = 2147483647
pausemovetime = 2147483647

[State , エフェクト変更]
Type = ModifyExplod
trigger1 = numexplod(30012) && root,var(40) < 5400
ID = 30012
scale = root,var(40)*0.0001851851851851852,1

[State , エフェクト変更]
Type = RemoveExplod
triggerall = numexplod(30012)
trigger1 = (root,var(40) < 5400 && root,var(41) = 0) || roundstate > 2 
ID = 30012

;==========　

[State ];ばってん
Type = Explod
triggerall = teamside = 1 && var(52)
triggerall = (Roundstate = 2 || (Roundno > 1 && Roundstate <=2))
triggerall = numexplod(30013) = 0 && numexplod(30012) = 0 && root,var(40) < 5400
trigger1 = !numpartner
trigger2 = numpartner
trigger2 = partner,ID > root,ID
anim = 30013
ID = 30013
pos = 10+var(50), 230+var(51)
postype = left
bindtime = -1
sprpriority = 9
scale = 0.5,0.5
removetime = -1
supermovetime = 2147483647
pausemovetime = 2147483647

[State , エフェクト変更]
Type = RemoveExplod
triggerall = numexplod(30013)
trigger1 = root,var(40) >= 5400 || roundstate > 2 
ID = 30013


