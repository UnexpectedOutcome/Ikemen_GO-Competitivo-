;==========　OD発動演出補助

[state ]
type = bgPalFX
trigger1 = Root,var(41) = 1
time = 30
add = -64,-64,-64
mul = 256,256,256
sinadd = 64,64,64,120
ignorehitpause = 1

[State , エフェクト変更]
Type = RemoveExplod
triggerall = numexplod(30010)
trigger1 = !alive || roundstate > 2 
ID = 30010





