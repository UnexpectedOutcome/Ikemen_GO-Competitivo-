
;-| Default Values |-------------------------------------------------------
[Defaults]

command.time = 20
command.buffer.time = 1
[Remap]
x = a      ;Ｘボタンの入力判定を実際に押すボタンに割り当てる。
y = x      ;Ｙボタン　　　　　　　　　〃
z = z      ;Ｚボタン　　　　　　　　　〃
a = c      ;Ａボタン　　　　　　　　　〃
b = b      ;Ｂボタン　　　　　　　　　〃
c = y      ;Ｃボタン　　　　　　　　　〃
s = s      ;スタートボタン　　　　　　〃

;-| 超必殺技 |--------------------------------------------------------

[Command]
name = "TripleKFPalm"
command = ~D, DF, F, D, DF, F, x
time = 20

[Command] 
name = "TripleKFPalm"   ;Same name as above
command = ~D, DF, F, D, DF, F, y
time = 20

;-| 必殺技 |------------------------------------------------------

[Command]
name = "623ab"
command = ~F, D, DF, x+b

[Command]
name = "623x"
command = ~F, D, DF, x

[Command]
name = "623b"
command = ~F, D, DF, b

[Command]
name = "623a"
command = ~F, D, DF, a

[Command]
name = "QCF_ab"
command = ~D, DF, F, x+b

[Command]
name = "QCF_x"
command = ~D, DF, F, x

[Command]
name = "QCF_y"
command = ~D, DF, F, y

[Command]
name = "QCF_a"
command = ~D, DF, F, a

[Command]
name = "QCF_b"
command = ~D, DF, F, b

[Command]
name = "QCB_ab"
command = ~D, DB, B, x+b
[Command]
name = "QCB_x"
command = ~D, DB, B, x

[Command]
name = "QCB_b"
command = ~D, DB, B, b

[Command]
name = "QCB_a"
command = ~D, DB, B, a

[Command]
name = "DD_ab"
command = ~D, D, x+b

[Command]
name = "DD_x"
command = ~D, D, x

[Command]
name = "DD_b"
command = ~D, D, b

[Command]
name = "DD_a"
command = ~D, D, a

;※※※※※※※※※※※※※※※※※※※※ハイジャンプコマンド
;下をちょっと押して上を押す、と言う意味。
[Command]
name = "jump"    
command = ~D,UB
time = 7

[Command]
name = "jump"    
command = ~D,UF
time = 7

[Command]
name = "jump"    
command = ~D,U
time = 7

;-| ２回押し技 |-----------------------------------------------------------
[Command]
name = "FF"     
command = F, F
time = 14

[Command]
name = "BB"     
command = B, B
time = 14

;-| ２・３個の同時押し技 |-----------------------------------------------
[Command]
name = "recovery"
command = ~x
time = 1

[Command]
name = "recovery"
command = ~a
time = 1

[Command]
name = "recovery"
command = ~b
time = 1

[Command];攻性
name = "ab"    
command = a+b
time = 10

[Command];小ジャンプ
name = "xb"    
command = x+b
time = 10

[Command];バースト
name = "xy"    
command = x+y
time = 10
;-| 方向とボタンで出す技 |---------------------------------------------------------

;-| ボタン設定（いじらない）|---------------------------------------------------------
[Command]
name = "a"
command = a
time = 1

[Command]
name = "b"
command = b
time = 1

[Command]
name = "c"
command = c
time = 1

[Command]
name = "x"
command = x
time = 1

[Command]
name = "y"
command = y
time = 1

[Command]
name = "z"
command = z
time = 1

[Command]
name = "start"
command = s
time = 1

;-| 押しっぱなし設定（いじらない）-------------------------------------------------------
[Command]
name = "holdfwd"
command = /$F
time = 1

[Command]
name = "holdback"
command = /$B
time = 1

[Command]
name = "holdup" 
command = /$U
time = 1

[Command]
name = "holddown"
command = /$D
time = 1

[Command]
name = "holdc"
command = /$c
time = 1

[Command]
name = "holdb"
command = /$b
time = 1

[Command]
name = "holda"
command = /$a
time = 1

[Command]
name = "holdz"
command = /$z
time = 1

[Command]
name = "holdy"
command = /$y
time = 1

[Command]
name = "holdx"
command = /$x
time = 1

; 下の記述↓は絶対に消さないでください。
[Statedef -1]

;先行入力認識用ヘルパー暴走防止
[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(30050)
value = 99999
ignorehitpause = 1



;===========================================================================
;---------------------------------------------------------------------------
;魔人拳
[State -1, Triple Kung Fu Palm]
type = ChangeState
value = 3500
triggerall = !ishelper && alive
triggerall = command = "c" || helper(99999),var(4) > 0
triggerall = command = "holdfwd"
triggerall = power >= 2000
triggerall = statetype != A
triggerall = Var(41) = 1 || var(40) >= 5400
trigger1 = ctrl || stateno = 100
trigger2 = Movecontact
trigger2 = (Stateno = [200,699]) || (Stateno = [720,722]) || (Stateno = [1000,1002]) || stateno = 1202 || stateno = 750
trigger3 = stateno = 710 && time >= 15
trigger4 = stateno = 712 && time >= 15

;---------------------------------------------------------------------------
;雷
