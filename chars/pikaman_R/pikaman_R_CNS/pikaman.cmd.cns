triggerall = command = "holddown"
triggerall = power >= 2000
trigger1 = ctrl || stateno = 100 || Stateno = 50 || Stateno = 1053 || Stateno = 105 || (Stateno = 1746 && time > 30)
trigger2 = Movecontact
trigger2 = (Stateno = [200,699]) || (Stateno = [720,722]) || (Stateno = [1000,1002]) || stateno = 1202 || stateno = 750
trigger3 = stateno = 710 && time >= 15
trigger4 = stateno = 712 && time >= 15

