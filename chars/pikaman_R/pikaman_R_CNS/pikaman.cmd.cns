;━━━━━━━━━━━━━━━━━━━━━━━
;ダウン回避フラグ
;━━━━━━━━━━━━━━━━━━━━━━━

[State ];CanRecover無視のダウン回避フラグ
type = varset
triggerall = Roundstate = 2 && Alive && !Ishelper
;triggerall = Numhelper(30050)
;triggerall = Helper(30050),var(45) = 1
trigger1 = Prevstateno != [5100,5120]
trigger1 = Stateno = 5000 || Stateno = 5010 || Stateno = 5020 || Stateno = 5070	;ステートを奪われていない攻撃がヒットしている
trigger1 = !Enemynear(var(53)),hitdefattr = SCA,AT
var(50) = 1
ignorehitpuase = 1

[State ];CanRecover無視のダウン回避フラグリセット
type = varset
triggerall = Roundstate = 2 && Alive && !Ishelper
trigger1 = Stateno = [5120,5299]
trigger2 = Stateno = [0,199]
trigger3 = Stateno != [5000,5299]
trigger3 = movetype = H
trigger4 = Stateno = 5000 || Stateno = 5010 || Stateno = 5020 || Stateno = 5070
trigger4 = Enemynear(var(53)),hitdefattr = SCA,AT
var(50) = 0

;---------------------------------------------------------------------------
;ダウン回避
;---------------------------------------------------------------------------

[State ];回避可能ステートへ（auto）
type = ChangeState
triggerall = Roundstate = 2 && Alive && !var(59) && !Ishelper
triggerall = stateno = 5050 && Vel Y > -1 &&  CanRecover && hitover && pos y <= -40
trigger1 = Command = "holda" || Command = "holdb" || Command = "holdc" || Command = "holdx" || Command = "holdy" || Command = "holdz"
value = 5210

[State ];ダウン回避ステート
type = ChangeState
triggerall = Roundstate = 2 && Alive && !var(59) && !Ishelper
triggerall = Vel Y > 0 && (Pos Y = [ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)-10, ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)])
trigger1 = Command = "holda" || Command = "holdb" || Command = "holdc" || Command = "holdx" || Command = "holdy" || Command = "holdz"
trigger1 = Stateno = 5050 || Stateno = 5210
trigger1 = CanRecover && hitover
value = 5201

[State ];CanRecover無視のダウン回避
type = ChangeState
triggerall = Roundstate = 2 && Alive && !var(59) && !Ishelper
trigger1 = Command = "holda" || Command = "holdb" || Command = "holdc" || Command = "holdx" || Command = "holdy" || Command = "holdz"
trigger1 = time = 1
trigger1 = (stateno = 5100 && (Prevstateno = [5030,5050])) || (stateno = 5110 && (Prevstateno = [5070,5071])) 
trigger1 = var(50) = 1
trigger1 = !Gethitvar(fall.damage) && Gethitvar(fall.yvel) >= -4.5 && Gethitvar(fall.recover) = 1
value = 5201
