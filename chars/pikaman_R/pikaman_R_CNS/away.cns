[Statedef 565]
type = A
movetype= H
physics = N
ctrl = 0
sprpriority = 3
anim = 5030

[state 516,吹っ飛び]
type = posset
trigger1 =pos y>-25
y = -25

[state 516,裏周り時の吹き飛び方]
type = turn
trigger1 = p2BodyDist X <=-10
trigger1 = time = 0

[state 516,吹っ飛び]
type = PlayerPush
trigger1 = 1
value = 0

[state 516,吹っ飛び]
type = velset
trigger1 = time >= 0
x = -25
y = -1

;[state 516,吹っ飛び]
;type = veladd
;trigger1 =  pos y < 0
;y = 0.04

[state 516,吹っ飛び]
type = veladd
trigger1 = vel x<0
X =0.2

[state 516,吹っ飛び]
type = velset
trigger1 = vel x>0
x = 0

[state 516,激突]
type = changestate
trigger1 = BackEdgeBodyDist < 10
value = 567

[state 517,相手ステートに戻す]
type = SelfState
trigger1 = pos y >= 0 
trigger1 = time>= 10
value = 5100
