[Statedef 1053]
type = A
physics = A
ctrl = 0
anim = 42

[State 53, 1]
type = velset
trigger1 = time < 2
x = 0
y = 0

[State ]
type = Explod
trigger1 = time = 0
anim = 10010
removetime = -2
ontop = 1
pos = -20,-10
ownpal = 1
scale = 0.5,0.5
bindtime = 1

[State 230, 1]
type = PlaySnd
trigger1 = time = 0
value = 120,1

[State 53, 2]
type = VelSet
trigger1 = Time = 2
x = const(velocity.airjump.fwd.x)
y = const(velocity.airjump.y)

[State 53, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(45)
persistent = 0
value = 45




