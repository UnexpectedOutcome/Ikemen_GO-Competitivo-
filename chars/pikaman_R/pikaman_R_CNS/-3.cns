triggerall = !ishelper && alive && roundstate = 2
Trigger1 = Var(40) < 5400
IgnoreHitPause = 1
V = 40
Value = 1

[State -2, VarSet];殴られたら伸びる
Type = Varadd
triggerall = !ishelper && alive && roundstate = 2
Trigger1 = Var(40) < 5400 && time = 0
IgnoreHitPause = 1
V = 40
Value = ceil(gethitvar(damage))

[State -2, VarSet];止め保険
Type = VarSet
triggerall = !ishelper && alive && roundstate = 2
trigger1 = Var(40) >= 5400
IgnoreHitPause = 1
V = 40
Value = 5400

[State -2, VarSet];OD中減少
Type = Varadd
triggerall = !ishelper && alive && roundstate = 2
trigger1 = Var(41) = 1
IgnoreHitPause = 1
V = 40
Value = -10

[State 1020, Afterimage]
type = AfterImageTime
triggerall = !ishelper
trigger1 = Var(41) = 1 && Var(40) > 0
time = 2
IgnoreHitPause = 1

[State -2, VarSet];OD終了
Type = Varset
triggerall = !ishelper
trigger1 = Var(41) = 1 && Var(40) < 0
trigger2 = roundstate > 2 || !alive
IgnoreHitPause = 1
V = 41
Value = 0


;---------------------------------------------------------------------------
; ここから下は-3のステートを書いてください、ここに書いたものはゲーム中
; に条件が成立すればいつでも開始するステートです。
;---------------------------------------------------------------------------


[Statedef -3]

;先行入力認識用ヘルパー暴走防止
[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(99999)
value = 30050
ignorehitpause = 1

;先行入力認識用ヘルパー
[state -3, 先行入力認識用ヘルパー]
type = helper
trigger1 = !numhelper(99999)
trigger1 = !ishelper
helpertype = normal
name = "commandhelper"
stateno = 30050
ID = 99999
postype = p1
pos = 0,9999
ownpal = 1
keyctrl = 1
pausemovetime = 2147483647
supermovetime = 2147483647

;━━━━━━━━━━━━━━━━━━━━━━━
;ステータス監視
;━━━━━━━━━━━━━━━━━━━━━━━

[State ];ステート番号
type = varset
triggerall = !ishelper
trigger1 = stateno = [0,4999]
trigger1 = var(25) != stateno
var(25) = stateno
ignorehitpause = 1
supermovetime = 2147483647
pausemovetime = 2147483647

[State ];アニメ番号
type = varset
triggerall = !ishelper
trigger1 = stateno = [196,4999]
trigger1 = var(26) != AnimElemNo(0)
var(26) = AnimElemNo(0)
ignorehitpause = 1
supermovetime = 2147483647
pausemovetime = 2147483647

;━━━━━━━━━━━━━━━━━━━━━━━
;裏周り関係補正
;━━━━━━━━━━━━━━━━━━━━━━━

[State ]
type = width
triggerall = Movetype != H && !ishelper && Enemynear(var(53)),backedgebodydist < 5 && P2bodydist X < 0 && vel x > 0
trigger1 = P2Statetype != A && Statetype = A
trigger2 = Numtarget && (P2Statetype = A||P2Statetype = L)
edge = 5,0
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━
;起き上がりの無敵
;━━━━━━━━━━━━━━━━━━━━━━━

[State 5120, 2]
type = varadd
triggerall = !ishelper
trigger1 = var(0) > 0
var(0) = -1

[State 5120, 5] ;Can't be thrown right after getting up
type = HitBy
trigger1 = var(0) > 0 && !ishelper
value = SCA,AA,AP

[State 5120, 6] ;Can't be hit right after getting up (short time)
type = NotHitBy
trigger1 = !ishelper && var(0) >= 7
value = SCA

[State 5120, 2];攻撃行動で無敵削除
type = varset
triggerall = !ishelper
trigger1 = Movetype = A
var(0) = 0

;━━━━━━━━━━━━━━━━━━━━━━━
;ヒットストップ無敵
;━━━━━━━━━━━━━━━━━━━━━━━

[State 5120, 6] ;
type = NotHitBy
trigger1 = var(5)
trigger1 = HitPauseTime && !(MoveReversed)
value = SCA
time = 1
ignorehitpause = 1







