
;---------------------------------------------------------------------------
; ここは-2のステートを書いてください、ヘルパー関係です
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, デバック(変数確認)]
Type = DisplayToClipBoard
Trigger1 = 0
Text = "MC=%d,fvar(30)=%f,var(56)=%d,P2X:%f,P2y :%f"
Params = var(40),fvar(0),moveguarded,fvar(11),(P2dist X)
IgnoreHitPause = 1

;先行入力認識用ヘルパー暴走防止
[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(99999)
value = 30050
ignorehitpause = 1

;---------------------------------------------------------

[State -3];タッグ用生死判別
Type = varset
triggerall = !ishelper
triggerall  = roundstate = 2
Trigger1 = Numenemy >= 2
var(53) = ifelse(Enemynear(0),alive,0,1)
pausemovetime = 2147483647
supermovetime = 2147483647
IgnoreHitPause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━
;ダメージ処理
;━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━

[state ];基本ダメージ一括管理  通常攻撃
type = Null
triggerall = !ishelper
;5A
trigger1 = var(25) = 200
trigger1 = var(10) := 30
;5B
trigger2 = var(25) = 240
trigger2 = var(10) := 60
;5C
trigger3 = var(25) = 230
trigger3 = var(10) := 90
;2A
trigger4 = var(25) = 400
trigger4 = var(10) := 25
;2B
trigger5 = var(25) = 440
trigger5 = var(10) := 55
;2C
trigger6 = var(25) = 430
trigger6 = var(10) := 85
;3B
trigger7 = var(25) = 210
trigger7 = var(10) := 70
;6C
trigger8 = var(25) = 226
trigger8 = var(10) := 75+((var(3)>=40)*50)+((var(3)>=74)*250)
;JA
trigger9 = var(25) = 600
trigger9 = var(10) := 40
;JB
trigger10= var(25) = 640
trigger10= var(10) := 55
;JC
trigger11= var(25) = 630
trigger11= var(10) := 80
;J2C
trigger12= var(25) = 666
trigger12= var(10) := 105
;厚生防御反撃/立ち
trigger13= var(25) = [720,722]
trigger13= var(10) := 50
IgnoreHitPause = 1


[state ];基本ダメージ一括管理  必殺攻撃
type = Null
triggerall = !ishelper
;236A
trigger1 = var(25) = 1000
trigger1 = var(10) := 65
;236B
trigger2 = var(25) = 1001
trigger2 = var(10) := 75
;236C
trigger3 = var(25) = 1002
trigger3 = var(10) := 50

;214ABC
trigger4 = var(25) = [1100,1104]
trigger4 = var(10) := 15
;214A
trigger5 = var(25) = 1110
trigger5 = var(10) := 100
;214B
trigger6 = var(25) = 1111
trigger6 = var(10) := 40
;214C
trigger7 = var(25) = 1112
trigger7 = var(10) := 50+(var(26)>13)*80

;22ABC
trigger8 = var(25) = [1200,1203]
trigger8 = var(10) := 15
;214A
trigger9 = var(25) = 1210
trigger9 = var(10) := 80+(numtarget(1201)*40)+(numtarget(1202)*50)+(numtarget(1203)*120)

;J236C
trigger10 = var(25) = 1300
trigger10 = var(10) := 85

;ロケット
trigger11 = var(25) = 3000
trigger11 = var(10) := 100+(var(26)>8)*80

;禊
trigger12 = var(25) = 3100
trigger12 = var(10) := 350

;魔人拳
trigger13 = var(25) = 3505
trigger13 = var(10) := 700

;ピカマンドライバー
trigger14 = var(25) = 1410
trigger14 = var(10) := 190+(numtarget(1401)*20)+(numtarget(1402)*40)+(numtarget(1403)*90)

;236EX
trigger15 = var(25) = 1003
trigger15 = var(10) := 80

;214EX
trigger16 = var(25) = 1114
trigger16 = var(10) := 160

;━━━━━━━━━━━━━━━━━━━━━━━━
;ダメージ補正値
;━━━━━━━━━━━━━━━━━━━━━━━━

[state -2, varリセット];補正リセット
type = varset
triggerall = !ishelper
triggerall = fvar(10) < 1
trigger1 = roundstate != 2
trigger2 = !Numtarget && P2Movetype != H
trigger3 = Numtarget
trigger3 = target,ctrl = 1
trigger4 = P2Movetype != H && Numenemy > 1
fvar(10) = 1.0
IgnoreHitPause = 1

;1発に付き5％減
;保障20％
;超必殺技は保障40％
;ネオマックスは保障50％

[state -2, var増加]
type = varadd
triggerall = !ishelper
triggerall = fvar(10) > 0
triggerall = Roundstate = 2 && Alive
triggerall = Numtarget
triggerall = target,Movetype = H
triggerall = (target,time = 0&&Movehit = 1) || Projhittime(0) = 1
triggerall = (var(25) != [2000,2199])
triggerall = (var(25) != [2500,3999])
triggerall = var(25) != [800,840]
trigger1 = target,stateno = 5000
trigger2 = target,stateno = 5010
trigger3 = target,stateno = 5020
trigger4 = target,stateno = 5070
trigger5 = target,stateno = 5080
fvar(10) = -0.05
IgnoreHitPause = 1

;━━━━━━━初段補正━━━━━━━━━━━


[state -2, varリセット];補正リセット
type = varset
triggerall = !ishelper
triggerall = fvar(11) < 1
trigger1 = roundstate != 2
trigger2 = !Numtarget && P2Movetype != H
trigger3 = Numtarget
trigger3 = target,ctrl = 1
trigger4 = P2Movetype != H && Numenemy > 1
fvar(11) = 1.0
IgnoreHitPause = 1

[state -2, varセット]
type = null
triggerall = Roundstate = 2 && Alive && !ishelper
triggerall = Numtarget && fvar(11) = 1
triggerall = target,Movetype = H &&((target,time = 0&&Movehit = 1) || Projhittime(0) = 1)
triggerall = target,stateno = 5000|| target,stateno = 5010|| target,stateno = 5020|| target,stateno = 5070|| target,stateno = 5080
trigger1 = var(25) = 200 || var(25) = 400 || var(25) = 600 || var(25) = 720 || var(25) = 721 || var(25) = 722 || var(25) = 750 || var(25) = 430 
trigger1 = fvar(11) := 0.5
trigger2 = var(25) = 240 || var(25) = 440|| var(25) = 666 || var(25) = 630 || var(25) = 226|| (var(25) = [3000,3999])
trigger2 = fvar(11) := 0.65
trigger3 = var(25) = 210 || (var(25) = [1000,1399])
trigger3 = fvar(11) := 0.7
trigger4 = var(25) = 230
trigger4 = fvar(11) := 0.75
trigger5 = var(25) = 640
trigger5 = fvar(11) := 0.6
IgnoreHitPause = 1


;━━━━━━━最終ダメージ式計算━━━━━━━━━━━

[state ]
type = varset
triggerall = !ishelper
trigger1 = alive
var(12) = abs(floor(var(10)*fvar(10)*fvar(11)*(1+.2*(var(4)>0))))

[state ];必殺技最低保障
type = varset
triggerall = !ishelper
trigger1 = alive
trigger1 = var(25) = [200,1999]
trigger1 = var(12) < var(10) * 0.1
var(12) = abs(floor(var(10)*0.1))

[state ];超必殺技最低保障
type = varset
triggerall = !ishelper
trigger1 = alive
trigger1 = var(25) = [3000,3499]
trigger1 = var(12) < var(10) * 0.3
var(12) = abs(floor(var(10)*0.3))

[state ];べオマックス最低保障
type = varset
triggerall = !ishelper
trigger1 = alive
trigger1 = var(25) = [3500,3999]
trigger1 = var(12) < var(10) * 0.5
var(12) = abs(floor(var(10)*0.5))

[state ];最低保障
type = varset
triggerall = !ishelper
trigger1 = var(12) < 4
var(12) = 4

[state ];ダメージ設定リセット
type = varset
triggerall = !ishelper
trigger1 = alive
trigger1 = Movetype = I
var(10) = 0



[state -2, varリセット];特殊ふっとび制限リセット
type = varset
triggerall = !ishelper
triggerall = var(11)
trigger1 = roundstate != 2
trigger2 = !Numtarget && P2Movetype != H
trigger3 = Numtarget
trigger3 = target,ctrl = 1
trigger4 = P2Movetype != H && Numenemy > 1
var(11) = 0
IgnoreHitPause = 1




