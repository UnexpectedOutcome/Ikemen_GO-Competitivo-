ignorehitpause = 1

[State -2, Recovery Roll <--]
type = explod
triggerall = TeamSide = 2 && NumExplod(8112) = 0
trigger1 = stateno = 910
trigger2 = stateno = 920
anim = 8112
ID = 8112
