;【必殺技のステート】
;
;1000	 バーストアタック
;
;1500　　大展開バリア
;1501　　大展開バリア用ヘルパー
;
;2000	 スパイラル・ハート・スプラッシュ
;2001	 スパイラル・ハート・スプラッシュ用ヘルパー
;
;2500	 風月変身
;2501	 風月変身用ヘルパー
;========================================================================
;========================================================================
;========================================================================
;バーストアタック
[Statedef 1000]
type = U
movetype = A
physics	= N
juggle = 4
velset = 0,0
ctrl = 0

[State 1000, チェーンコンボ用var50]
type = VarSet
trigger1 = !var(59) && (Time = 0)
var(50) = 0
IgnoreHitPause = 1

[State 1000, パワーマイナス]
type = PowerAdd
triggerall = Time = 0
trigger1 = (Prevstateno = 600) || (Prevstateno = 605) || (Prevstateno = 650) || (Prevstateno = 655) || (Prevstateno = 750) || (Prevstateno = 755)
trigger2 = (Prevstateno = 850) || (Prevstateno = 855) || (Prevstateno = 900) || (Prevstateno = 905) || (Prevstateno = 950) || (Prevstateno = 955)
value = -100

[State 1000, 光る]
type = PalFX
triggerall = Time = 0
trigger1 = (Prevstateno = 600) || (Prevstateno = 605) || (Prevstateno = 650) || (Prevstateno = 655) || (Prevstateno = 750) || (Prevstateno = 755)
trigger2 = (Prevstateno = 850) || (Prevstateno = 855) || (Prevstateno = 900) || (Prevstateno = 905) || (Prevstateno = 950) || (Prevstateno = 955)
time = 6
add = 100,100,100

[State 1000, 効果音]
type = PlaySnd
triggerall = Time = 0
trigger1 = (Prevstateno = 600) || (Prevstateno = 605) || (Prevstateno = 650) || (Prevstateno = 655) || (Prevstateno = 750) || (Prevstateno = 755)
trigger2 = (Prevstateno = 850) || (Prevstateno = 855) || (Prevstateno = 900) || (Prevstateno = 905) || (Prevstateno = 950) || (Prevstateno = 955)
value = S100,10

[State 1000, 振り向き]
type = Turn
trigger1 = P2dist x < 0
trigger1 = (Time = 0) || (Animtime = 0) || (Movecontact >= 15)

[State 1000, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),1000,1001)+ifelse((var(0) < 0),2,0)

[State 1000, 無敵]
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 30
IgnoreHitPause = 1

[State 1000, 超時止め]
type = SuperPause
trigger1 = Time = 0
time = 30
movetime = 30
anim = -1
sound = S1000,0
darken = 1
p2defmul = 1
poweradd = -1000

[State 1000, カットイン]
type = Explod
trigger1 = Time = 0
ID = 1000
anim = ifelse((var(0) < 0),1060,1010)
pos = 0,0
postype = left
bindtime = -1
removetime = 30
removeongethit = 1
scale = 0.52,0.52
ontop = 1
supermovetime = 999999
persistent = 0

[State 1000, エフェクト]
type = Explod
trigger1 = (Frontedgebodydist >= 25) && (Vel x >= 10) && Ifelse((P2bodydist x = [-10,10]),(Time%3 = 0),1)
ID = ifelse((var(0) < 0),57,55)
anim = ifelse((var(0) < 0),6011,6010)
postype = p1
pos = 0,(-7*const(size.yscale))
random = (20*const(size.xscale)),(22*const(size.yscale))
vel = (var(10)*0.1*const(size.xscale)),(var(11)*0.1*const(size.yscale))
accel = (var(12)*0.001*const(size.xscale)),(var(13)*0.001*const(size.yscale))
scale = const(size.xscale),const(size.yscale)
sprpriority = 2

[State 1000, エフェクト]
type = Explod
trigger1 = (Frontedgebodydist >= 25) && (Vel x >= 10) && Ifelse((P2bodydist x = [-10,10]),(Time%3 = 0),1)
ID = ifelse((var(0) < 0),58,56)
anim = ifelse((var(0) < 0),6011,6010)
postype = p1
pos = 0,(-7*const(size.yscale))
random = (20*const(size.xscale)),(22*const(size.yscale))
vel = (var(12)*0.1*const(size.xscale)),(var(13)*0.1*const(size.yscale))
accel = (var(10)*0.001*const(size.xscale)),(var(11)*0.001*const(size.yscale))
scale = const(size.xscale),const(size.yscale)
sprpriority = 2

[State 1000, 速度ｘｙ]
type = VelSet
trigger1 = Animelem = 3
x = 30
y = ifelse((Statetype = A),15,0)
persistent = 0

[State 1000, 速度ｘｙ]
type = VelMul
trigger1 = Frontedgebodydist < 25
x = 0.5

[State 1000, 速度ｙ]
type = VelSet
trigger1 = (Vel y >= 0) && (Pos y >= 0) && (Statetype = A) && (Animelemtime(3) >= 0)
y = 0

[State 1000, 位置ｙ]
type = PosSet
trigger1 = (Vel y >= 0) && (Pos y >= 0) && (Statetype = A) && (Animelemtime(3) >= 0)
y = 0

[State 1000, ターゲット速度ｘｙ]
type = TargetVelSet
trigger1 = (Time = 0) && (Prevstateno = 605) && Numtarget(ifelse((var(0) < 0),7605,605))
x = 0
y = 0
ID = ifelse((var(0) < 0),7605,605)

[State 1000, ガード不能]
type = AssertSpecial
trigger1 = 1
flag = UnGuardable

[State 1000, ダメージ]
type = HitDef
trigger1 = (var(55) < 40) && (Animelem = 3) && !Movecontact
attr = ,HA
hitflag = MAFDP
guardflag = MA
guard.dist = 150
animtype = Up
ground.type = Low
priority = 5,Hit
damage = ceil(ifelse((var(55) > 9),210,250)*fvar(38)-0.4),ceil(ifelse((var(55) > 9),105,125)*fvar(38)-0.4)
getpower = 0,0
givepower = 0,0
sparkno = Sifelse((var(0) < 0),6101,6100)
sparkxy = -15,-60
hitsound = S100,5
guardsound = S100,5
pausetime = 0,1
ground.slidetime = 10
ground.hittime = 30
guard.hittime = 30
guard.ctrltime = 30
air.hittime = 30
ground.velocity = 10,-10
guard.velocity = -10
air.velocity = 10,-10
fall = 1
fall.recover = 0
ID = ifelse((var(0) < 0),1010,1000)
guard.kill = 1

[State 1000, 効果音]
type = PlaySnd
trigger1 = Movecontact
value = S100,5
volume = 255
persistent = 0

[State 1000, 立ちかジャンプへ]
type = SelfState
trigger1 = (Animtime = 0) || (Movecontact >= 15)
value = ifelse((Pos y >= 0),0,50)
ctrl = 1

