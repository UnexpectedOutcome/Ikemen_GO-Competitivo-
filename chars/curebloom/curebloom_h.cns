trigger1 = (Prevstateno = 600) || (Prevstateno = 605) || (Prevstateno = 650) || (Prevstateno = 655) || (Prevstateno = 750) || (Prevstateno = 755)
trigger2 = (Prevstateno = 850) || (Prevstateno = 855) || (Prevstateno = 900) || (Prevstateno = 905) || (Prevstateno = 950) || (Prevstateno = 955)
time = 6
add = 100,100,100

[State 1500, 効果音]
type = PlaySnd
triggerall = Time = 0
trigger1 = (Prevstateno = 600) || (Prevstateno = 605) || (Prevstateno = 650) || (Prevstateno = 655) || (Prevstateno = 750) || (Prevstateno = 755)
trigger2 = (Prevstateno = 850) || (Prevstateno = 855) || (Prevstateno = 900) || (Prevstateno = 905) || (Prevstateno = 950) || (Prevstateno = 955)
value = S100,10

[State 1500, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),1500,1501)+ifelse((var(0) < 0),2,0)

[State 1500, 無敵]
type = NotHitBy
trigger1 = Time = [0,32]
trigger2 = Numhelper(ifelse((var(0) < 0),1511,1501)) && (Helper(ifelse((var(0) < 0),1511,1501)),time < Helper(ifelse((var(0) < 0),1511,1501)),var(1))
value = SCA
time = 1
IgnoreHitPause = 1

[State 1500, 超時止め]
type = SuperPause
trigger1 = Time = 0
time = 30
movetime = 30
pos = const(size.mid.pos.x),const(size.mid.pos.y)
sound = S1000,0
darken = 1
p2defmul = 1
poweradd = -1000

[State 1500, 大展開バリア用ヘルパー]
type = Helper
trigger1 = Time = 30
helpertype = normal
name = "baria"
ID = ifelse((var(0) < 0),1511,1501)
stateno = 1501
pos = 0,0
postype = p1
ownpal = 1
persistent = 0
IgnoreHitPause = 1

[State 1500, ヘルパーヒット用Explod]
type = Explod
trigger1 = Numhelper(ifelse((var(0) < 0),1511,1501)) && (Helper(ifelse((var(0) < 0),1511,1501)),movecontact = 1)
ID = 5000
anim = 2
pos = 0,0
postype = left
removetime = 40
removeongethit = 1

[State 1500, 立ちへ]
type = SelfState
trigger1 = (Time >= 90) && Ifelse(Numhelper(ifelse((var(0) < 0),1511,1501)),(Helper(ifelse((var(0) < 0),1511,1501)),var(0) >= 60),1)
