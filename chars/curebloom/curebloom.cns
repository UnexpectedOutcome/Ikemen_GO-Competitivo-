;========================================================================
;【基本設定】
;========================================================================
[Data]
life = 1000		  ;ライフ。1000が標準。1000以上なら変えてもおｋ
attack = 100		  ;攻撃力。100が標準。50以上なら変えてもおｋ
defence = 100		  ;防御力。100が標準。50以上なら変えてもおｋ
power = 5000		  ;パワー。3000や10000が標準かも。5000以上なら変えてもおｋ
fall.defence_up = 50	  ;ダウン時防御力。よくわからない
liedown.time = 60	  ;ダウンしてから起き上がるまでの時間。変えない方がいいかも
airjuggle = 60		  ;ジャグルポイント数。よくわからない
sparkno = -1		  ;デフォルトのスパーク番号。変えちゃダメ
guard.sparkno = 40	  ;ガード時のディフォルトスパーク番。変えちゃダメ
KO.echo = 0		  ;1にするとKOされた時に声にエコーかかる。キュアエコーじゃない
volume = 0		  ;音量。0が標準。変えてもおｋ
IntPersistIndex = 0,59	  ;varを持ち越す。変えちゃダメ

[Size]
xscale = 1.2		  ;水平方向縮尺。変えてもおｋ
yscale = 1.2		  ;垂直方向縮尺。変えてもおｋ
ground.front = 20	  ;キャラクター幅・地上前。変えちゃダメ
ground.back = 20	  ;キャラクター幅・地上後。変えちゃダメ
air.front = 20		  ;キャラクター幅・空中前。変えちゃダメ
air.back = 10		  ;キャラクター幅・空中後。変えちゃダメ
height = 75		  ;キャラクター高さ。変えちゃダメ
attack.dist = 0		  ;相手側のガード認識最低距離。変えちゃダメ
proj.attack.dist = 90	  ;相手側の飛び道具ガード認識最低距離。変えちゃダメ
proj.doscale = 1 	  ;発射物縮尺適応。変えちゃダメ
head.pos = 0,-70	  ;頭の大体の座標。変えてもおｋ
mid.pos = 0,-40		  ;体中心の大体の座標。変えてもおｋ
shadowoffset = 0	  ;影の垂直方向オフセット。変えてもおｋ

[Movement]
airjump.num = 1		  ;空中ジャンプの回数。変えてもおｋ
airjump.height = 25	  ;空中ジャンプに必要な最低限の高さ。変えてもおｋ
yaccel = .43		  ;重力。変えてもおｋ
stand.friction = .85	  ;立ち状態での摩擦係数。変えてもおｋ
crouch.friction = .85	  ;しゃがみ状態での摩擦係数。変えてもおｋ

[Velocity]
walk.fwd = 2.7		  ;前方歩きの速度。変えてもおｋ
walk.back = -2.7	  ;後方歩きの速度。変えてもおｋ
run.fwd = 7,0		  ;走る速度。変えてもおｋ
run.back = -6,-5.5	  ;後退ジャンプ速度。変えてもおｋ
jump.neu = 0,-9.1	  ;ジャンプ速度。変えてもおｋ
jump.fwd = 3.2		  ;前方ジャンプ速度。変えてもおｋ
jump.back = -3.2	  ;後方ジャンプ速度。変えてもおｋ
runjump.fwd = 6,-9	  ;前方走りジャンプ速度。変えてもおｋ
runjump.back = -6,-9	  ;後方走りジャンプ速度。変えてもおｋ
airjump.neu = 0,-8.1	  ;空中ジャンプ速度。変えてもおｋ
airjump.fwd = 3.5,-8.1	  ;前方空中ジャンプ速度。変えてもおｋ
airjump.back = -3.5,-8.1  ;後方空中ジャンプ速度。変えてもおｋ

;========================================================================
;【特殊技etcのステート】
;
;40	立ちからジャンプへ
;45	空中ジャンプ
;50	ジャンプ
;52	着地
;105	後退ジャンプ
;106	後退ジャンプ下降
;120	ガードスタート
;130	立ちガード
;131	屈みガード
;132	空中ガード
;140	ガード解除
;150	立ちガード硬直
;151	立ちガード硬直解除
;152	屈みガード硬直
;153	屈みガード硬直解除
;154	空中ガード硬直
;155	空中ガード硬直解除
;160	ガードエフェクト
;161	ガード反撃やられ
;170	タイムオーバー負け
;175	タイムオーバー引き分け
;180	勝利
;190	イントロ
;191	個人用イントロ
;
;700	気溜め
;701	気溜め終了
;
;777	高速回避
;========================================================================
;========================================================================
;========================================================================
;立ちからジャンプヘ
[Statedef 40]
type = U
physics = S
ctrl = 0
sprpriority = 1

[State 40, AI制御]
type = SelfState
trigger1 = (Time = 0) && var(59) && !var(50)
value = 0
ctrl = 1

[State 40, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),40,30)+ifelse(Ishelper,7000,0)

[State 40, システムVar]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, システムVar]
type = VarSet
trigger1 = !var(59) && (command = "holdfwd")
trigger2 = var(59) && ((Abs(p2bodydist x) <= 100) || (P2stateno = 40) || (P2stateno = 45) || (var(50) = 77710) || (var(50) = 77713))
sysvar(1) = 1

[State 40, システムVar]
type = VarSet
trigger1 = Ifelse(var(59),(Inguarddist || (P2movetype = A)),(command = "holdback"))
sysvar(1) = -1

[State 40, 速度ｘｙ]
type = VelSet
trigger1 = Animtime = 0
x = ifelse(sysvar(1),ifelse((sysvar(1) = 1),const(velocity.jump.fwd.x),const(velocity.jump.back.x)),const(velocity.jump.neu.x))
y = const(velocity.jump.y)

[State 40, 速度ｘｙダッシュ中]
type = VelSet
trigger1 = (Animtime = 0) && (Prevstateno = [100,101]) && (sysvar(1) = 1)
x = const(velocity.runjump.fwd.x)

[State 40, 効果音]
type = PlaySnd
trigger1 = Animtime = 0
value = S20,2

[State 40, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 40, ジャンプヘ]
type = SelfState
trigger1 = Animtime = 0
value = 50
ctrl = ifelse((var(59) && (var(50) > 1)),0,1)

;------------------------------------------------------------------------
;空中ジャンプ
[Statedef 45]
type = A
physics = N
ctrl = 0

[State 45, ジャンプ戻し]
type = SelfState
trigger1 = (Time = 0) && (var(14) >= 1+const(movement.airjump.num))
value = 50
ctrl = 1

[State 45, ジャンプ戻し]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0
persistent = 0

[State 45, ジャンプ制限用var14]
type = VarAdd
trigger1 = 1
var(14) = ifelse((var(0) < 0),1,2)
persistent = 0

[State 45, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),40,30)+ifelse(Ishelper,7000,0)

[State 45, システムVar]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, システムVar]
type = VarSet
trigger1 = Ifelse(var(59),((Abs(p2bodydist x) <= 100) || (P2stateno = 40) || (P2stateno = 45)),(command = "holdfwd"))
sysvar(1) = 1

[State 45, システムVar]
type = VarSet
trigger1 = Ifelse(var(59),(Inguarddist || (P2movetype = A)),(command = "holdback"))
sysvar(1) = -1

[State 45, 速度ｘｙ]
type = VelSet
trigger1 = Animtime = 0
x = ifelse(sysvar(1),ifelse((sysvar(1) = 1),const(velocity.airjump.fwd.x),const(velocity.airjump.back.x)),const(velocity.airjump.neu.x))
y = const(velocity.airjump.y)

[State 45, 効果音]
type = PlaySnd
trigger1 = Animtime = 0
value = S20,2

[State 45, ジャンプヘ]
type = SelfState
trigger1 = Animtime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;ジャンプ
[Statedef 50]
type = A
physics = A

[State 50, システムVar]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, アニメ]
type = ChangeAnim
trigger1 = (Anim != Ifelse((Facing = 1),41,31)+Ifelse(Ishelper,7000,0)) && (Anim != Ifelse((Facing = 1),602,603))
value = ifelse((Facing = 1),41,31)+ifelse(Ishelper,7000,0)

[State 50, アニメ]
type = ChangeAnim
trigger1 = Anim = Ifelse((Facing = 1),602,603)
value = ifelse((Facing = 1),602,603)
elem = 2

[State 50, 速度ｘ]
type = VelAdd
trigger1 = (Anim != Ifelse((Facing = 1),602,603)) && (var(50) = 0) && (Vel x < Const(velocity.jump.fwd.x))
trigger1 = Ifelse(var(59),((P2bodydist x > 25)  || (P2dist x < 0)),(command = "holdfwd"))
x = 0.09*const(velocity.jump.fwd.x)

[State 50, 速度ｘ]
type = VelAdd
trigger1 = (Anim != Ifelse((Facing = 1),602,603)) && (var(50) = 0) && (Vel x > Const(velocity.jump.back.x))
trigger1 = Ifelse((var(59) && (var(58) != -1)),((P2bodydist x >= 0) && Inguarddist),(command = "holdback"))
x = 0.09*const(velocity.jump.back.x)

[State 50, 空中ジャンプへ]
type = SelfState
value = 45
trigger1 = Ishelper(7777) && (Roundstate = 2) && (Life > 0) && (var(45) = 1) && (Time > 6)
trigger1 = Anim != Ifelse((Facing = 1),602,603)
trigger1 = (command = "holdup") && (Pos y <= -Const(movement.airjump.height)) && (var(14) = Const(movement.airjump.num))

;---------------------------------------------------------------------------
;着地
[Statedef 52]
type = S
physics = S
ctrl = 0

[State 52, 効果音]
type = PlaySnd
trigger1 = Time = 0
value = S20,1

[State 52, アニメ]
type = ChangeAnim
trigger1 = (Time = 0) && (Anim != Ifelse((Facing = 1),602,603))
value = ifelse((Facing = 1),47,37)+ifelse(Ishelper,7000,0)

[State 52, アニメ]
type = ChangeAnim
trigger1 = (Time = 0) && (Anim = Ifelse((Facing = 1),602,603))
value = ifelse((Facing = 1),604,605)

[State 52, 速度ｙ]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 52, ジャンプヘ]
type = SelfState
triggerall = Roundstate = 2
trigger1 = !var(59) && (command = "holdup")
value = 40

[State 52, 立ちへ]
type = SelfState
trigger1 = Animtime = 0
value = 0
ctrl = 1

;========================================================================
;========================================================================
;後退ジャンプ
[Statedef 105]
type = A
physics = A
ctrl = 0
sprpriority = 1

[State 105, チェーンコンボ用var50]
type = VarSet
trigger1 = !var(59) && (Time = 0)
var(50) = 0
IgnoreHitPause = 1

[State 105, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),105,104)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),105,104)+ifelse(Ishelper,7000,0)

[State 105, 無敵]
type = NotHitBy
trigger1 = Time <= 10
value = SCA

[State 105, 速度ｘｙ]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 105, 後退ジャンプ下降へ]
type = SelfState
trigger1 = ((Time > 25) && (Vel y > 0)) || (Pos y > 0)
value = 106

;------------------------------------------------------------------------
;後退ジャンプ下降
[Statedef 106]
type = C
physics = C
ctrl = 0

[State 106, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),105,104)+ifelse(Ishelper,7000,0)

[State 106, 速度ｙ]
type = VelSet
trigger1 = Time = 0
y = 0

[State 106, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 106, 土埃]
type = MakeDust
trigger1 = Time = [0,5]
pos = -33,0
spacing = 5

[State 106, 効果音]
type = PlaySnd
trigger1 = Time = 0
value = S20,1

[State 106, ジャンプヘ]
type = SelfState
triggerall = Roundstate = 2
trigger1 = !var(59) && (command = "holdup")
value = 40

[State 106, 立ちへ]
type = SelfState
trigger1 = Animtime = 0
value = 0
ctrl = 1

;========================================================================
;ガードスタート
[Statedef 120]
type = U
physics = U

[State 120, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),120,123)+ifelse(Ishelper,7000,0)+(Statetype = C)+(Statetype = A)*2

[State 120, 立ち判定]
type = StateTypeSet
trigger1 = (Time = 0) && (Statetype = S)
physics = S

[State 120, 屈み判定]
type = StateTypeSet
trigger1 = (Time = 0) && (Statetype = C)
physics = C

[State 120, 空中判定]
type = StateTypeSet
trigger1 = (Time = 0) && (Statetype = A)
physics = A

[State 120, 立ちから屈み判定]
type = StateTypeSet
trigger1 = !var(59) && (Statetype = S) && (command = "holddown")
statetype = C
physics = C

[State 120, 屈みから立ち判定]
type = StateTypeSet
trigger1 = !var(59) && (Statetype = C) && (command != "holddown")
statetype = S
physics = S

[State 120, ガード解除へ]
type = SelfState
trigger1 = (!var(59) && (command != "holdback")) || !Inguarddist
value = 140

[State 120, ガードへ]
type = SelfState
trigger1 = 1
value = 130+(Statetype = C)+(Statetype = A)*2

;---------------------------------------------------------------------------
;立ちガード
[Statedef 130]
type = S
physics = S

[State 130, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),130,133)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),130,133)+ifelse(Ishelper,7000,0)

[State 130, 位置ｙ]
type = PosSet
trigger1 = ((Time = 0) && !(Enemy,name = "M-NES Game 1")) || (Pos y > 0)
y = 0

[State 130, エフェクト]
type = Helper
trigger1 = !Numhelper(ifelse((var(0) < 0),161,160))
helpertype = normal
name = "guard"
ID = ifelse((var(0) < 0),161,160)
stateno = 160
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
IgnoreHitPause = 1

[State 130, 屈みガードへ]
type = SelfState
trigger1 = Inguarddist && Ifelse(var(59),((P2statetype = C) || (Enemynear,hitdefattr = C,AA,AP)),(command = "holddown"))
value = 131

[State 130, ガード解除へ]
type = SelfState
trigger1 = (!var(59) && (command != "holdback")) || !Inguarddist
value = 140

;---------------------------------------------------------------------------
;屈みガード
[Statedef 131]
type = C
physics = C

[State 131, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),131,134)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),131,134)+ifelse(Ishelper,7000,0)

[State 131, 位置ｙ]
type = PosSet
trigger1 = Time = 0
y = 0

[State 131, エフェクト]
type = Helper
trigger1 = !Numhelper(ifelse((var(0) < 0),161,160))
helpertype = normal
name = "guard"
ID = ifelse((var(0) < 0),161,160)
stateno = 160
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
IgnoreHitPause = 1

[State 131, 立ちガードへ]
type = SelfState
trigger1 = Inguarddist && Ifelse(var(59),((P2statetype != C) && !(Enemynear,hitdefattr = C,AA,AP)),(command != "holddown"))
value = 130

[State 131, ガード解除へ]
type = SelfState
trigger1 = (!var(59) && (command != "holdback")) || !Inguarddist
value = 140

;---------------------------------------------------------------------------
;空中ガード
[Statedef 132]
type = A
physics = N

[State 132, アニメ]
type = ChangeAnim
trigger1 = Anim != Ifelse((Facing = 1),132,135)+Ifelse(Ishelper,7000,0)
value = ifelse((Facing = 1),132,135)+ifelse(Ishelper,7000,0)

[State 132, 速度ｙ]
type = VelAdd
trigger1 = 1
y = const(movement.yaccel)

[State 132, システムVar]
type = VarSet
trigger1 = 1
sysvar(0) = (Pos y >= 0) && (Vel y > 0)

[State 132, 速度ｙ]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 位置ｙ]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, エフェクト]
type = Helper
trigger1 = !Numhelper(ifelse((var(0) < 0),161,160))
helpertype = normal
name = "guard"
ID = ifelse((var(0) < 0),161,160)
stateno = 160
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
IgnoreHitPause = 1

[State 132, 立ちガードへ]
type = SelfState
trigger1 = sysvar(0) && Inguarddist && Ifelse(var(59),1,(command = "holdback"))
value = 130

[State 132, 着地へ]
type = SelfState
trigger1 = sysvar(0)
value = 52

[State 132, ガード解除へ]
type = SelfState
trigger1 = (!var(59) && (command != "holdback")) || !Inguarddist
value = 140

;---------------------------------------------------------------------------
;ガード解除
[Statedef 140]
type = U
physics = U
ctrl = 1

[State 140, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),140,143)+ifelse(Ishelper,7000,0)+(Statetype = C)+(Statetype = A)*2

[State 140, 立ち判定]
type = StateTypeSet
trigger1 = (Time = 0) && (Statetype = S)
physics = S

[State 140, 屈み判定]
type = StateTypeSet
trigger1 = (Time = 0) && (Statetype = C)
physics = C

[State 140, 空中判定]
type = StateTypeSet
trigger1 = (Time = 0) && (Statetype = A)
physics = A

[State 140, 立ちから屈み判定]
type = StateTypeSet
trigger1 = (Statetype = S) && Ifelse(var(59),((P2statetype = C) || (Enemynear,hitdefattr = C,AA,AP)),(command = "holddown"))
statetype = C
physics = C

[State 140, 屈みから立ち判定]
type = StateTypeSet
trigger1 = (Statetype = C) && Ifelse(var(59),((P2statetype != C) && !(Enemynear,hitdefattr = C,AA,AP)),(command != "holddown"))
statetype = S
physics = S

;---------------------------------------------------------------------------
;立ちガード硬直
[Statedef 150]
type = S
movetype = H
physics = N
velset = 0,0

[State 150, アニメ]
type = ChangeAnim
trigger1 = 1
value = ifelse((Facing = 1),150,153)+ifelse(Ishelper,7000,0)

[State 150, 立ちガード硬直解除または屈みガード硬直解除へAI用]
type = ChangeState
trigger1 = Hitshakeover
value = 151+2*ifelse(var(59),((P2statetype = C) || (Enemynear,hitdefattr = C,AA,AP)),(command = "holddown"))

[State 150, エフェクト]
type = Helper
trigger1 = !Numhelper(ifelse((var(0) < 0),161,160))
helpertype = normal
name = "guard"
ID = ifelse((var(0) < 0),161,160)
stateno = 160
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
IgnoreHitPause = 1

[State 150, 立ちから屈み判定]
type = StateTypeSet
trigger1 = (Statetype = S) && Ifelse(var(59),((P2statetype = C) || (Enemynear,hitdefattr = C,AA,AP)),(command = "holddown"))
statetype = C
physics = C

[State 150, 屈みから立ち判定]
type = StateTypeSet
trigger1 = (Statetype = C) && Ifelse(var(59),((P2statetype != C) && !(Enemynear,hitdefattr = C,AA,AP)),(command != "holddown"))
statetype = S
physics = S

;---------------------------------------------------------------------------
;立ちガード硬直解除
[Statedef 151]
type = S
movetype = H
physics = S

[State 151, アニメ]
type = ChangeAnim
trigger1 = 1
value = ifelse((Facing = 1),150,153)+ifelse(Ishelper,7000,0)

[State 151, 速度ｘ]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 151, 速度ｘ]
type = VelSet
trigger1 = (Time = Gethitvar(slidetime)) || Hitover
x = 0

[State 151, コントロール]
type = CtrlSet
trigger1 = Time = Gethitvar(ctrltime)
value = 1

[State 151, エフェクト]
type = Helper
trigger1 = !Numhelper(ifelse((var(0) < 0),161,160))
helpertype = normal
name = "guard"
ID = ifelse((var(0) < 0),161,160)
stateno = 160
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
IgnoreHitPause = 1

[State 151, 立ちから屈み判定]
type = StateTypeSet
trigger1 = (Statetype = S) && Ifelse(var(59),((P2statetype = C) || (Enemynear,hitdefattr = C,AA,AP)),(command = "holddown"))
statetype = C
physics = C

[State 151, 屈みから立ち判定]
type = StateTypeSet
trigger1 = (Statetype = C) && Ifelse(var(59),((P2statetype != C) && !(Enemynear,hitdefattr = C,AA,AP)),(command != "holddown"))
statetype = S
physics = S

[State 151, 立ちガードへ]
type =  ChangeState
trigger1 = Hitover
value = 130
ctrl = 1

;---------------------------------------------------------------------------
;屈みガード硬直
[Statedef 152]
type = C
movetype = H
physics = N
velset = 0,0

[State 152, アニメ]
type = ChangeAnim
trigger1 = 1
value = ifelse((Facing = 1),151,154)+ifelse(Ishelper,7000,0)

[State 151, 立ちガード硬直解除または屈みガード硬直解除へAI用]
type = ChangeState
trigger1 = Hitshakeover
value = 151+2*ifelse(var(59),((P2statetype = C) || (Enemynear,hitdefattr = C,AA,AP)),(command = "holddown"))

[State 152, エフェクト]
type = Helper
trigger1 = !Numhelper(ifelse((var(0) < 0),161,160))
helpertype = normal
name = "guard"
ID = ifelse((var(0) < 0),161,160)
stateno = 160
ownpal = 1
supermovetime = 999999
pausemovetime = 999999
