trigger1 = Animelem = 2
trigger1 = fvar(0) := (p2dist x)*20/exp(0.5*ln(((p2dist x)*(p2dist x))+((p2dist y)*(p2dist y)))) || 1
trigger1 = fvar(1) := (p2dist y)*20/exp(0.5*ln(((p2dist x)*(p2dist x))+((p2dist y)*(p2dist y)))) || 1
x = fvar(0)
y = ifelse((Statetype = A),fvar(1),0)

