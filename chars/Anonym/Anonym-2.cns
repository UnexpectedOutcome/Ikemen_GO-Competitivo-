[Statedef -2]

;オプション

[State -2,]
type = DisplayToClipboard
trigger1 = 1
text = "var(6)=%d,Dist X=%d,Y=%d,"
params = Var(6) ,floor(P2BodyDist X),floor(P2BodyDist Y)
[State -2, クリップボード（追加専用）]
type = null;AppendToClipboard
trigger1 = 1
text = "fVar(20)=%f,fVar(10)=%f, fVar(11)=%f,fVar(12)=%f,fVar(13)=%f \n"
params = fVar(20),fVar(10),fVar(11),fVar(12),fVar(13)

[State -2, 常駐ヘルパー呼び出し]
type = null;Helper
trigger1 = NumHelper(46000) = 0
stateno = 46000
ID = 46000
keyctrl = 0
postype = p1
supermovetime = 99999999
pausemovetime = 99999999
ownpal = 1
IgnoreHitPause = 1

[State -2, 銃弾メータ呼び出し]
type = Helper
trigger1 = NumHelper(9000) = 0
stateno = 9000
ID = 9000
keyctrl = 0
postype = P1
supermovetime = 99999999
pausemovetime = 99999999
ownpal = 1
IgnoreHitPause = 1

:軸修正

[State -2, Y座標自己修復]
type = PosSet
triggerall = RoundState = 2
trigger1 = stateno = [0,12]      ;立ち＆屈み時
trigger1 = floor(Pos Y) = [-11,5] ;立ち位置が僅かにずれていたらすぐ修正
y = 0

[State -2, Y座標自動修正]
type = PosAdd
triggerall = RoundState = 2
triggerall = Life < LifeMax  ;トレーニングでCtrl+Iを使うときに配慮
trigger1 = stateno = [0,30]  ;歩きも含める
trigger1 = floor(Pos Y) < -2 ;立ち位置が大きくずれていたら移動する
y = 2

[State -2, Y座標自動修正]
type = PosAdd
triggerall = RoundState = 2
triggerall = Life < LifeMax
trigger1 = stateno = [0,30]
trigger1 = floor(Pos Y) > 2 ;同じく
y = -2

;いろいろ(変数)

[State -2,テトラ強化変数カウント]
type = Varadd
trigger1 = var(43) != 0
v=43
value=-1

[State -2,弾数初期化]
type = VarSet
trigger1 = var(6) != 0
trigger1 = RoundState = 1
var(6) = 0

[State -2,キャンセルフラグ初期化]
type = VarSet
trigger1 = var(17) != 0
trigger1 = Movetype != A
var(17) = 0

[State 200, 先行入力リセット]
type = varset
trigger1 = var(2) != 0
trigger1 = Movetype != A
var(2) = 0

[State -2,キャンセルフラグ初期化その２]
type = VarSet
trigger1 = var(19) != 0
trigger1 = Movetype != A
var(19) = 0

[State -2,汎用変数初期化]
type = VarRangeSet
triggerall = movetype != A
trigger1 = stateno != [190,195]
value = 0
first = 0
last = 0

[State -2,汎用変数初期化]
type = VarRangeSet
triggerall = movetype != A
trigger1 = stateno != [190,195]
value = 0
first = 2
last = 4

[State -2,汎用変数初期化]
type = VarRangeSet
triggerall = movetype != A
trigger1 = stateno != [190,195]
fvalue = 0
first = 2
last = 4

[State -2 ,ダメージボイス1]
Type = PlaySnd
triggerall = Alive = 1
triggerall = Time = 1
triggerall = (StateNo = 5000 || StateNo = 5010 || StateNo = 5020)
trigger1 = Anim = 5000 || Anim = 5010 || Anim = 5020
Value = s10, 0
channel = 1
persistent = 0
ignorehitpause = 1

[State -2 ,ダメージボイス2]
