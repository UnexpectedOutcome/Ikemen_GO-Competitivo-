;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 25000]
type    = U
movetype= H
physics = N
velset = 0,0
ctrl = 0

[State NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 25000, Cancel]
type = SelfState
trigger1 = !alive
trigger2 = anim = 5300
value = 5000

[State 25000, Cancel]
type = SelfState
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
value = 5000

[State 25000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 25000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 25000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 25000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 25000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 25000, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 25001 ;HITG_SLIDE

[State 25000, 7]
type = SelfState
trigger1 = HitShakeOver
value = 5030

[State 25000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 25000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 25000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITG_SLIDE
[Statedef 25001]
type    = S
movetype= H
physics = S

[State 25001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 25001, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
value = 5005 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 25001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 25001, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 25001, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 25001, 6]
type = ChangeState
trigger1 = HitOver
value = 25301
ctrl = 1

;---------------------------------------------------------------------------
; DIZZY (Poison)
[Statedef 25301]
type    = S
movetype= I
physics = N
velset = 0,0
anim = 5300
ctrl = 0

[State 25301, End]
type = SelfState
trigger1 = time = 60
value = 0
ctrl = 1