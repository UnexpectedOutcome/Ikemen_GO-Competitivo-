;琉球の巫女　minus state
;
[statedef -2]

;-----------------------------------------------------------------------
[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
text = "psx=%f,psy=%f,Edix=%f,Ediy=%f,1=%d\n"
params =pos x,pos y,p2bodydist x,p2bodydist x,var(0) 

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
trigger1 = command != "holds"
text = "veX=%f,veY=%f,fv(0)=%f,fv(1)=%f,fv(2)=%f"
params =vel x,vel y,fvar(0),fvar(1),fvar(2)

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
trigger1 = command = "holds"
text = "CharaCv(5)=%d,down hit v(4)=%d,jump dir sv(1)=%d,AirD v(7)=%d,GroD v(8)=%d"
params =var(5),var(4),sysvar(1),var(7),var(8)

