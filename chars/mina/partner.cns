;-------------------------------------------よろけ
;-----------------------------さむそぴ防御崩され、氷すべり、ままははつっつきなど
;----------------GGXXシステム　よろけ　　テスト--USEp2SPR-----------------
;------------------------うちみむん時のよろけ、ガード間に合うぐらい短い
[statedef 5600];ヒットストップ中、pausetime？
type    = S
movetype= H
physics = N
poweradd= 0
ctrl = 0
velset = 0,0
sprpriority = 0

[state 2550,]
type = turn
trigger1 = time = 0
trigger1 = enemynear,facing = facing
ignorehitpause = 1

[State 2050,];効かないみたい・・・？
type = velset
triggerall = time = 1
trigger1 = alive =0
trigger2 = life <= 0
y = -5
x = -5
ignorehitpause = 1

[State 2050,];効かないみたい・・・？time = 0だとダメージはいってないみたいだよ
type = selfstate
triggerall = time = 1
trigger1 = alive =0
trigger2 = life <= 0
value = 5050
ignorehitpause = 1

[State 2050,];よろけシステム、よろけ中5003、終了5008
type = ChangeAnim
triggerall =selfanimexist(5003)
Trigger1 = Time = 1
value = ifelse(authorname = "R-R",5003 + var(0),5003)
ignorehitpause = 1

[State 2050,];よろけシステム、ない場合…
type = ChangeAnim2
triggerall = !selfanimexist(5003)
Trigger1 = Time = 1
value = ifelse(authorname = "R-R",850 + var(0),850)
ignorehitpause = 1

[State 2050,]
type = changestate
trigger1 = hitshakeover
value = 5610
ctrl = 0
ignorehitpause = 1

