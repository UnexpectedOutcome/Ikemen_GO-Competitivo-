;----------------------------------------------------スピリッツもーど
;0無印 1怒　２真　３斬 4天　５零　6剣
;---
[Statedef 9000];mode select
type    = A                      
movetype= i                      
physics = n  
ctrl = 0    
anim = 6000  

[State 3620,];
type = AssertSpecial
trigger1 =1
flag = noshadow
flag2 = noautoturn
flag3 = invisible
ignorehitpause = 1

[state 8000x,]
type = nothitby
trigger1 = 1
value = sca,na,nt,np,sa,sp,st,ha,hp,ht
time = 1
ignorehitpause = 1

[State 1430, sound];音
type = PlaySnd
trigger1 = command = "Fr"
trigger2 = command = "Ba"
value = s150,1
channel = 2
ignorehitpause = 1

[state 3160,];
type = parentvarset
trigger1 = command = "Fr"
var(1) = abs((root,var(1) + 1) % 7)

[state 3160,];
type = parentvaradd
trigger1 = command = "Ba"
trigger1 = 1;root,var(1) > 0
var(1) = ifelse(root,var(1) = 0,6,-1) % 7;root,var(1) - 1


[state 3140,]
type = destroyself
trigger1 = roundstate = 2


