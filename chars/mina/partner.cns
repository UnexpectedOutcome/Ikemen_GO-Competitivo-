;s8000 ちゃんぷー
;
;---------ちゃんぷー-----------------------------------------------------------
[statedef 8000];右向き時dist -30が基本位置
type = s
movetype = I
physics = N
velset = 0,0
anim = 20000
sprpriority=4

[State 8021, 1];一回すｔっぷしたフラグ
type = VarSet
trigger1 = time = 0
var(1) = 0

;----------------------------ふりむきさせる
[state 8010,cs]
type = changestate
trigger1 = root,facing != facing
value = 8005

;---------------------------歩き
[state 8010,cs]
type = changestate
trigger1 = rootdist  x > -20
value = 8020

[State 8000,back];後方へ 
type =changestate
trigger1 = rootdist  x < -45
value = 8021 

[state 8010,cs]
type = changestate
trigger1 = root,stateno = [10,11] 
value = 8010

;-----------------------------
[state 8000, state change for loseintro];ステート移動命令
type = changestate
trigger1 = root,var(10)
value = root,var(10)

[State 8000, pos y];強制軸あわせ
type = posset
trigger1 = pos y != 0
y = 0 

;-----------------------------------------------------------------------デバック
[state 8000]
type = displaytoclipboard
triggerall = 1
trigger1 = 1
text = "pos%f Ranim= %d Rdistx= %f Rdisty= %f, %d"
params = pos x, root,anim, rootdist x, rootdist y ,facing

