;　基本データ、イントロ関連  
;var(0) システム予約 var(5),システム予約　var(10)
;fvar(0)=攻撃係数　7.8125=ss3（inS5900）
;h,p,e(200)
;id(0)予約　id（100）　id(300）

[Data]  
life = 1000  ;体力ゲージの初期値
attack = 100  
defence = 95  ;防御力（これ以上に設定すると強くなる）
fall.defence_up = 55  ;コンボをくらっている時にあがる防御力
liedown.time = 60  ;倒れてから起上がるまでのフレーム数
airjuggle = 18  ;空中でどれだけコンボが繋がるか
sparkno = s6200  ;hitdefで設定していない時の基本ヒットスパークナンバー
guard.sparkno = s6150  ;設定してない時のガードナンバー）
KO.echo = 0           ;KOした時に声にエコーをかけるか（１でＯＮ
volume = 255
IntPersistIndex = -1;60
FloatPersistIndex = -1;40

[Size]
xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 15     ;キャラの幅(後方,地上)
ground.front = 16    ;キャラの幅(前方,地上)
air.back = 13        ;キャラの幅(後方,空中)
air.front = 13       ;キャラの幅(前方,空中)
height = 60          ;キャラの高さ
attack.dist = 160    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 90;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = 5, -75   ;頭の大体の座標
mid.pos = -10, -55    ;体の中心の大体の座標
shadowoffset = 0     ;影の垂直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 2.0      ;前進の速度
walk.back = -2.0     ;後退の速度
run.fwd  = 4.5, 0    ;前ダッシュの速度（ホップする時はyを-にする）
run.back = -4.6,-4.1 ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu = 0,-11.4    ;垂直ジャンプの速度
jump.back = -3.00    ;後ジャンプの速度
jump.fwd = 3.00       ;前ジャンプの速度
runjump.back = -3.80,-9.0.1 ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4,-11.8      ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0,-11.4      ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -3.00      ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 3.00         ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 0      ;空中でジャンプする回数
airjump.height = 35  ;空中でジャンプする最低限の高さ
yaccel = 0.41         ;重力
stand.friction = .82  ;立ち状態の摩擦係数
crouch.friction = .80 ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; タイムオーバーで負けた時
[Statedef 170]
type = S
ctrl = 0
velset = 0,0

[State 180, 1];どろー
type = Changeanim
triggerall = time = 0
trigger1 = drawgame
value = 170 + var(0)

[State 180, 1];体力少ない負け
type = Changeanim
triggerall = time = 0
trigger1 = !drawgame
value = 171 + var(0)

[State 180, 1];体力少ない負け
type = varset
triggerall = time = 0
trigger1 = !drawgame
var(10) = 8170

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝った動作 start staet
[Statedef 180]
type = S

[State 180, 1];２本目勝ちへ 
type = ChangeState
trigger1 = time = 0
trigger1 = MatchOver = 1
value = 183

[State 180, 1];1本目勝ちへ
type = ChangeState
triggerall = time = 0
trigger1 = 1
value = 181 + random % 2

;---------------------------------------------------------------------------
; 勝ちポーズ 1本目　s181,win1_1 
[Statedef 181];ほっといて
type = S
ctrl = 0
physics = N
anim = 181+ var(0)
velset = 0,0

[state 180,sikuru order];
type = varset
trigger1 = time = 0
var(10) = 8181

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[state 181,]
type = playsnd
trigger1 = anim = 181 + var(0)
trigger1 = animelem = 3
channel = 0
value = s180,0

[state 181,]
type = changeanim
trigger1 = anim = 181 + var(0)
trigger1 = time >= 70
value = 182 + var(0)

[State 181, 4]
type = AssertSpecial
trigger1 = Time  <= 180
flag = RoundNotOver

