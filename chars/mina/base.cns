trigger1 = anim = var(0) + 190
trigger1 = Time >= 120
value = var(0) + 191
persistent = 0

[State 191, 4] 
type = ChangeState
trigger1 = anim = var(0) + 191
trigger1 = AnimTime = 0
value = 0

