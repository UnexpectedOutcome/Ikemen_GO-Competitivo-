;-----Dancing Doll 
;-Type P #1,#9,#14 #19 #21
;-Type O  [system deleted]
;------Type P ----- Dancing Doll #09L kohaku master side v0.5 -------------
;A5600(5010,0) A5620(5020,0)
[statedef 20000]
type = U
movetype = I
physics = N
ctrl =0
sprpriority = -4

[state 10000,varset];人形anim台がいくつか。LLは10000台、SSは20000・・たぶん
type = varset
trigger1 = time = 0
var(0) = root,var(40) * 10000
ignorehitpause = 1

[state 10000,varset];ID set
type = varset
trigger1 = time = 0
var(2) = root,var(2)
ignorehitpause = 1

[state 10000,varset];ID set
type = varset
trigger1 = time = 0
var(3) = root,var(3)
ignorehitpause = 1

[state 10000,varset];ID set
type = varset
trigger1 = time = 0
var(4) = root,var(4)
ignorehitpause = 1

[state 1000x,nohit];無敵設定
type = NotHitBy
trigger1 = 1
value = SCA, NA, SA, HA, NT, ST, HT ,NP, SP, HP
time = 1
ignorehitpause = 1

[state 20000,v]
type = varset
trigger1 = time = 0
var(49) =  playerID(root,var(2)),stateno
ignorehitpause = 1

[state 20000,v]
type = varset
trigger1 = 1;time = 0
var(50) =  playerID(root,var(2)),anim
ignorehitpause = 1

[state 20000,pos]
type = posset
trigger1 = root,var(0)
x = playerID(root,var(2)),pos x
y = playerID(root,var(2)),pos y
ignorehitpause = 1

[state 20000,pos]
type = posset
triggerall = numhelper(0)
trigger1 = root,var(0) = 0
x = helper(0),pos x
y = helper(0),pos y
ignorehitpause = 1

;--------------------------------------
[state 20000,5];地上5000系の必須指定の場合,最大3枚しかないはずであるっと1  ただし5001,5002,5003,5010,5011,5012,5020,5021,5022
type = changeanim
triggerall  = selfanimexist(var(50) + var(0))
triggerall  = playerID(root,var(2)),anim = [5000,5022]
triggerall = 1;playerID(root,var(2)),statetype != A && playerID(root,var(2)),statetype != L
trigger1 = playerID(root,var(2)),animelemtime(1) >= 0
trigger1 = playerID(root,var(2)),animelemtime(2) < 0
value = var(50) + var(0)
elem = 1

[state 20000,5];5000系の必須指定の場合,最大3枚しかないはずであるっと2
type = changeanim
value = var(50) + var(0)
elem =2
triggerall  = selfanimexist(var(50) + var(0))
triggerall  = playerID(root,var(2)),anim = [5000,5022]
triggerall = 1;playerID(root,var(2)),statetype != A && playerID(root,var(2)),statetype != L
trigger1 = playerID(root,var(2)),animelemtime(2) >= 0
trigger1 = playerID(root,var(2)),animelemtime(3) < 0
persistent = 1
ignorehitpause = 1

[state 20000,5];5000系の必須指定の場合,最大3枚しかないはずであるっと3
type = changeanim
value = var(50) + var(0)
elem =3
triggerall  = selfanimexist(var(50) + var(0))
triggerall  = playerID(root,var(2)),anim = [5000,5022]
triggerall = 1;playerID(root,var(2)),statetype != A && playerID(root,var(2)),statetype != L
trigger1 = playerID(root,var(2)),animelemtime(3) >= 0
trigger1 = playerID(root,var(2)),animelemtime(4) < 0
persistent = 1
ignorehitpause = 1

[state 20000,5];5000系の必須指定の場合
type = changeanim
value = var(50) + var(0)
triggerall  = selfanimexist(var(50) + var(0))
triggerall  = playerID(root,var(2)),anim = [5030,5300]
triggerall = 1;playerID(root,var(2)),statetype != A && playerID(root,var(2)),statetype != L
trigger1 = anim != var(50) + var(0)
persistent = 1
ignorehitpause = 1

;------以下5000系の必須指定でない場合
[state 20000,4];地上立ち、 5610(5010,0) + 10000
type = changeanim
value = var(0) + 5610
triggerall = playerID(root,var(2)),anim != [5000,5300]
trigger1= time = 0
trigger2 = playerID(root,var(2)),statetype = s
trigger2 = playerID(root,var(2)),vel y = 0
trigger2 = playerID(root,var(2)),pos y = 0
ignorehitpause = 1

[state 20000,4];空中停止状態 5030
type = changeanim
value = var(0) + 5030
triggerall = playerID(root,var(2)),anim != [5000,5300]
trigger1= time = 0
trigger1 = playerID(root,var(2)),vel y = 0
trigger1 = playerID(root,var(2)),statetype = A
ignorehitpause = 1

[state 20000,4];地上しゃがみ、停止状態 5620(5020,0)
type = changeanim
value =  var(0) + 5620
triggerall = playerID(root,var(2)),anim != [5000,5300]
triggerall= time = 0
trigger1 = playerID(root,var(2)),statetype = c
trigger1 = playerID(root,var(2)),vel y = 0
trigger1 = playerID(root,var(2)),pos y = 0
ignorehitpause = 1

[state 20000,5];空中吹きとび 上昇 5050(5030,20)
type = changeanim
value = 5050 + var(0)
triggerall = anim != 15050
triggerall = playerID(root,var(2)),anim != [5000,5300]
trigger1 = playerID(root,var(2)),vel y < 0
trigger1 = playerID(root,var(2)),pos y < 0
ignorehitpause = 1

[state 20000,5];空中吹きとび 下降 5060(5030,30-40)
type = changeanim
value = 5060 + var(0)
triggerall = anim != 15060
triggerall = playerID(root,var(2)),anim != [5000,5300]
trigger1 = playerID(root,var(2)),vel y > 2
trigger1 = playerID(root,var(2)),pos y < 0
ignorehitpause = 1

