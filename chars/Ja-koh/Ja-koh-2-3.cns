trigger1 = Roundstate = 2
trigger1 = enemy,GethitVar(hitcount) >= 1
var(3) = 1

[State -2, VarSet]
type = VarSet
triggerall = Roundstate = 2
trigger1 = p2movetype != H
trigger2 = enemy,GethitVar(hitcount) = 0
var(3) = 0

[State -2, VarSet]
type = VarSet
trigger1 = Roundstate = 2
trigger1 = enemy,GethitVar(hitcount) >= 10
var(7) = 1

[State -2, VarSet]
type = VarSet
triggerall = Roundstate = 2
trigger1 = p2movetype != H
trigger2 = enemy,GethitVar(hitcount) = 0
var(7) = 0

