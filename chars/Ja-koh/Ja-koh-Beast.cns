
;---------------------------------------------------------------------------
;Snake
;---------------------------------------------------------------------------
; 召喚

[Statedef 10000]
type     = A
movetype = I
physics  = N
anim     = 10000
;velset   = 0,0
sprpriority = -1

[State 10000, 影無し]
type = Assertspecial
trigger1 = 1
flag = Noshadow
ignorehitpause = 1

[State 10000, 基準に位置を固定]
type = BindToRoot
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 10000, ステート変更、昇蛇招嵐]
type = ChangeState
trigger1 = (Root,stateno = 3000) && (Root,Time = 1)
trigger1 = Root,MoveType != H
value = 10060

[State 10000, ステート変更、蛟地斬を出すため消滅]
type = ChangeState
trigger1 = (Root,stateno = 760) && (Root,Time = 1)
trigger1 = Root,MoveType != H
value = 10042

[State 10000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 10010

