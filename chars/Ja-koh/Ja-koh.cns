
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;基本データ部分
[Data]
life              = 1000  ;体力ゲージの最大値を決めます
power             = 3000  ;パワーゲージ最大値（デフォルトは 3000 = Lv.3 になります・オプション）
attack            = 100   ;攻撃力パーセンテージ（デフォルトは 100% になります）
defence           = 100   ;防御力パーセンテージ（デフォルトは 100% になります）
fall.defence_up   = 50    ;一時的に上昇するダウン時の防御力パーセンテージ
liedown.time      = 40    ;倒れてから起き上がるまでの時間
airjuggle         = 15    ;ジャグルポイント限界値　★１
sparkno           = 2     ;デフォルトのヒットスパーク番号（fightfx.airか、キャラのairから呼び出す）
guard.sparkno     = 40    ;デフォルトのガードスパーク番号（fightfx.airか、キャラのairから呼び出す）
KO.echo           = 0     ;ＫＯ時の声にエコーを掛けるかどうか（0=しない・1=する）
volume            = 128   ;キャラの音量　255が最高
intpersistindex   = 11    ;Varを次のラウンドへ持ち越しが可能 (最小=0, 最大=59)  ★２
floatpersistindex = 40    ;FVarを次のラウンドへ持ち越しが可能 (最小=0, 最大=39) ★２

;---------------------------------------------------------------------------
;サイズ設定
[Size]
xscale           = 1;0.90     ;キャラ画像の横のスケール
yscale           = 1;0.90     ;キャラ画像の縦のスケール
ground.back      = 19       ;キャラの幅（地上後方）
ground.front     = 19       ;キャラの幅（地上前方）
air.back         = 12       ;キャラの幅（空中後方）
air.front        = 12       ;キャラの幅（空中前方）
height           = 60       ;跳び越す相手のためのキャラの高さ
attack.dist      = 140      ;攻撃を出した時に相手がガード体勢に入る最低の距離
proj.attack.dist = 90       ;相手がガード体勢に入る発射物との最低の距離
proj.doscale     = 1        ;xscaleとyscaleが発射物のスケールにも影響するかどうか（0=しない・1=する）
head.pos         = -2, -95  ;BindToTargetの時に必要な頭の座標
mid.pos          = -3, -60  ;BindToTargetの時に必要な体中心の座標
shadowoffset     = 0        ;影の垂直方向の位置
draw.offset      = 0,0      ;キャラ描画表示位置（Ｘ軸,Ｙ軸）

;---------------------------------------------------------------------------
;移動速度設定
[Velocity]
walk.fwd     = 2.7         ;前進歩行速度
walk.back    = -2.5        ;後退歩行速度
run.fwd      = 5.5, 0      ;前に走る時の速度（Ｘ軸,Ｙ軸）
run.back     = -4.5, 0     ;後ろに走る時の速度（Ｘ軸,Ｙ軸）
jump.neu     = 0,-12.0     ;垂直ジャンプ速度（Ｘ軸,Ｙ軸）
jump.back    = -4.0        ;後ジャンプ速度
jump.fwd     = 3.7         ;前ジャンプ速度
runjump.back = -2.55,-8.1  ;後ろに走りながらのジャンプ速度（オプション）
runjump.fwd  = 4,-8.1      ;前に走りながらのジャンプ速度（オプション）
airjump.neu  = 0,-8.1      ;空中垂直ジャンプ速度（オプション）
airjump.back = -2.5        ;空中後ジャンプ速度（オプション）
airjump.fwd  = 2.55        ;空中前ジャンプ速度（オプション）

;---------------------------------------------------------------------------
;動作設定
[Movement]
airjump.num     = 0      ;空中ジャンプが出来る回数（オプション）
airjump.height  = 35     ;空中ジャンプするために必要な最低限の高さ（オプション）
yaccel          = .65    ;重力（垂直下降加速度）
stand.friction  = .83    ;立ち状態の摩擦係数
crouch.friction = .82    ;しゃがみ状態の摩擦係数

;---------------------------------------------------------------------------
; Varの使用状況
; ここに自分が使ったvarをメモしておくといろいろと好都合です。
; var(1)  - コンボ用
; var(2)  - 投げ
; var(3)  - 攻撃力補正
; var(4)  - ビーストゲージ
; var(5)  - 小ジャンプ
; var(6)  - 反撃技
; var(7)  - 攻撃力補正2

; var(10) - カウンター判定
; var(11) - 獣神有無
; var(12) - 獣神セレクト
; var(13) - 獣神通常状態確認（ダッシュ制御用）
; var(14) - ダッシュ状態判断
; var(15) - バックダッシュ状態判断
; var(16) - 獣神通常状態確認

; var(20) - 反撃技ヒット数
; var(21) - 反撃技ダメージ

; var(55) - タッグ時の生死確認
; var(58) - 払い率セット
; var(59) - AI用

; fvar(1) - ビーストホーミング
; fvar(2) - ビーストホーミング
; fvar(3) - タッグ判別

; 横壁ヒットアニメ5823,5824

;---------------------------------------------------------------------------
; 基本行動のステート
;---------------------------------------------------------------------------
; タイムオーバー時

[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, ボイス]
type = PlaySnd
triggerall = AnimElem = 4
trigger1 = Alive
value = 5, 10
channel = 0

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利ポーズ分岐

[Statedef 180]
type = S

[State 180, 勝利ポーズ1]
type = ChangeState
trigger1 = Time = 0
trigger1 = var(11) = 0
trigger2 = RoundState = 0    ;エンディング時はこちらを使う
value = 181

[State 180, 勝利ポーズ2];ビースト召喚時
type = ChangeState
triggerall = RoundState != 0 ;エンディング対策
trigger1 = Time = 0
trigger1 = var(11) = 1
value = 182

;---------------------------------------------------------------------------
; 勝利ポーズ1

[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, ボイス]
type = PlaySnd
triggerall = AnimElem = 10
trigger1 = Alive
value = 8, 2
channel = 0

[state 181, AssertSpecial]
type = AssertSpecial
trigger1 = matchover = 1
trigger1 = Time >= 0
trigger1 = Time <= 150
flag = RoundNotOver

[state 181, 勝利演出]
type = Changestate
trigger1 = Time = 150
trigger1 = Matchover = 1
Trigger1 = (TeamMode = single) || (TeamMode = turns)
value = 20180

;---------------------------------------------------------------------------
; 勝利ポーズ2 ビースト召喚時

[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 182, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 182, Explod];（Snake）
type = Explod
trigger1 = Time = 0
anim = 184
ID = 185
scale = const(size.xscale),const(size.yscale)
pos = ceil(const(size.xscale)*0),ceil(const(size.yscale)*0)
postype = p1
bindtime = 9999999
supermovetime = 9999999
sprpriority = -1
removetime = -2
removeongethit = 1

[State 182, Explod];（Snake）
type = Explod
trigger1 = Time = 6
anim = 10051
ID = 10051
scale = const(size.xscale),const(size.yscale)
pos = ceil(const(size.xscale)*0),ceil(const(size.yscale)*0)
postype = p1
bindtime = 9999999
supermovetime = 9999999
sprpriority = 5
removetime = -2
removeongethit = 1

[State 182, ボイス]
type = PlaySnd
triggerall = AnimElem = 6
trigger1 = Alive
value = 8, 3
channel = 0

[state 182, AssertSpecial]
type = AssertSpecial
trigger1 = matchover = 1
trigger1 = Time >= 0
trigger1 = Time <= 150
flag = RoundNotOver

[state 182, 勝利演出]
type = Changestate
trigger1 = Time = 150
trigger1 = Matchover = 1
Trigger1 = (TeamMode = single) || (TeamMode = turns)
value = 20180

;---------------------------------------------------------------------------
; 勝利演出

[Statedef 20180]
type = S
ctrl = 0
velset = 0,0

[State 20180];ビーストを消す
type = RemoveExplod
trigger1 = NumExplod(185) != 0
trigger1 = Time >= 0
ID = 185
ignorehitpause = 1

[State 20180, AssertSpecial]
type = AssertSpecial
trigger1 = Time >= 0
trigger1 = Time <= 500
flag = RoundNotOver

[State 20180, AssertSpecial]
type = AssertSpecial
trigger1 = Time >= 0
trigger1 = Time <= 600
flag = nobardisplay
flag2 = globalnoshadow
;flag3 = noBG

[State 20180, AssertSpecial]
type = AssertSpecial
trigger1 = Time >= 0
trigger1 = time <= 600
flag = nomusic
flag2 = invisible
flag3 = noFG

[State 20180, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 5
value = 12, 0

[State 20180, ボイス]
type = null;PlaySnd
trigger1 = Time = 5
value = 12, 1

[State 20180, Explod]
type = Explod
trigger1 = Time = 0
anim = 20180
pos = 0,0
postype = left
sprpriority = 7
ownpal = 1
removetime = -1
ontop = 1

;---------------------------------------------------------------------------
; イントロ

[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, アニメ変更]
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 190, 特殊効果]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, パワーゲージを1000に] 
type = powerset
trigger1 = Time = 0
trigger1 = power < 1000
value = 1000

[State 190, varリセット] 
type = varset
trigger1 = var(12) > 0
trigger1 = Time = 0
var(12) = 0

[State 190, Explod];（Snake）
type = Explod
trigger1 = AnimElemTime(3) = 1
anim = 191
ID = 191
scale = const(size.xscale),const(size.yscale)
pos = ceil(const(size.xscale)*0),ceil(const(size.yscale)*0)
postype = p1
bindtime = 9999999
supermovetime = 9999999
sprpriority = -1
removetime = -2
removeongethit = 1

[State 190, 音を鳴らす]
type = null;PlaySnd
trigger1 = Animelem = 7
value = 0, 0

[State 190, ボイス]
type = PlaySnd
trigger1 = AnimElem = 3
value = 8, 9
channel = 0

[State 190, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; 挑発

[Statedef 195]
type     = S
movetype = I
physics  = S
anim     = 195
velset   = 0,0
ctrl     = 0
sprpriority = 2
facep2 = 1

[State 195, パワーが溜まる]
type = PowerAdd
trigger1 = Time = 34
value = ifelse(var(11),0,125)

[State 195, コントロール可否]
type = CtrlSet
trigger1 = Time = 35
value = 1

[State 195, ボイス]
type = PlaySnd
trigger1 = AnimElem = 2
value = 8, 3
channel = 0

[State 195, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


