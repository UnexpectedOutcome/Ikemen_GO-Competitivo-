;---------------------------------------------------------------------------
; 獣神通常状態確認（ダッシュ制御用）

[State -2, VarSet]
type = VarSet
trigger1 = roundstate != 2
var(13) = 0

[State -2, VarSet]
type = VarSet
triggerall = var(13) = 0
trigger1 = NumHelper(10000) = 1
trigger1 = (helper(10000),StateNo = 10010)
var(13) = 1

[State -2, VarSet]
type = VarSet
triggerall = var(13) = 1
trigger1 = NumHelper(10000) = 0
trigger2 = !(helper(10000),StateNo = 10010)
var(13) = 0

;---------------------------------------------------------------------------
; 獣神通常状態確認（削り無効に移行できる状態）

[State -2, VarSet]
type = VarSet
triggerall = var(16) = 0
trigger1 = NumHelper(10000) = 1
trigger1 = (helper(10000),StateNo = 10010) || (helper(10000),StateNo = 11025) || (helper(10000),StateNo = 11026)
var(16) = 1

[State -2, VarSet]
type = VarSet
triggerall = var(16) = 1
trigger1 = NumHelper(10000) = 0
trigger2 = !((helper(10000),StateNo = 10010) || (helper(10000),StateNo = 11025) || (helper(10000),StateNo = 11026))
var(16) = 0

