;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, Remove chibi after palette selector]
type = RemoveExplod
triggerall = numhelper(12345)
trigger1 = (command="a"||command="b"||command="c"||command="x"||command="y"||command="z"||command="start"||roundstate=2)
id = 12347

[State -2, Dizzy ''stars'']
type = Explod
trigger1 = Numexplod(5310) = 0 && anim = 5300
anim = 5310
postype = p1
pos = 0,-110
facing = 1
ID = 5310
sprpriority = 4
removetime = -1
ownpal = 1
bindtime = -1

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = anim != 5300
id = 5310

;Hell Dunk
[State -2]
type=Helper
trigger1=numenemy&&movetype=H&&!numhelper(1422)
trigger1=enemynear,name="Zabel"&&((enemynear,authorname="misao"&&stateno=950&&time=20)||(enemynear,authorname="Zelgadis296"&&stateno=2150&&enemynear,time=6&&enemynear,stateno=2002&&enemynear,movetype=A))
name = "Hell Dunk"
ID=ifelse(enemynear,authorname="misao",1422,1423)
pos=ifelse(enemynear,authorname="misao",130,70),-ifelse(enemynear,authorname="misao",42,55)
postype=p2
stateno=1422
facing=-1

;================================================================================
; ------- Cheap K.O. system By Warusaki3 --------
;===============================================================================
[State -2, 3]
type = ChangeState
trigger1 = !Alive
trigger1 = PrevStateNo = 130 || PrevStateNo = 131 || PrevStateNo = [150,153]
trigger1 = Stateno = [5000,5050]
value = 5950

[State -2,KO]
type = Varset
triggerall = StateNo = [120,159]
trigger1 = StateType = S
ignorehitpause = 1
fvar(1) = 0

[State -2,KO]
type = Varset
triggerall = StateNo = [120,159]
trigger1 = StateType = C
ignorehitpause = 1
fvar(1) = 1

[State -2,KO]
type = Varset
triggerall = StateNo = [120,159]
trigger1 = StateType = A
ignorehitpause = 1
fvar(1) = 2

[State -3, AssertSpecial]
type = AssertSpecial
trigger1 = (StateNo = [5000,5010])
trigger1 = (PrevStateNo = [130,131]) || (PrevStateNo = [140,141]) || (PrevStateNo=[150,153])
flag = NoKOsnd
ignoreHitPause = 1

[State -2, P2 Safe Fall]
type= targetstate
trigger1= numtarget=1 ;Just to prevent Simul mode shenanigans
trigger1= target,command="recovery"
trigger1= target,pos y>=-20 && target,vel y>0
trigger1= target,alive && target,hitfall && target,gethitvar(fall.recover)
trigger1= target,stateno=5030 || target,stateno=5035 || target,stateno=5050 || target,stateno=5071
value= 5205
ignorehitpause= 1

[State -2, P2 Facing]
type= targetfacing
trigger1= movecontact=1 && numtarget=1
trigger1= !(target,hitshakeover) && !(target,hitfall) && (target,time<=1)
value= ifelse(p2dist x>=0, -1, 1)
ignorehitpause= 1

[State -2, StopSnd]
type = StopSnd
trigger1 = movetype = H
channel = 10

[State -2, StopSnd]
type = StopSnd
trigger1 = movetype = H
channel = 20

;================================================================================
; ------- Tick Fix --------
;===============================================================================
[State -2, CtrlSet]
type = CtrlSet
;Gethits
trigger1 = (stateno=52 || stateno=102 || stateno=107 || stateno=5120) && !animtime
trigger2 = (stateno=5001 || stateno=5011 || stateno=151 || stateno=153) && hitover
value = 1

[State -2, CtrlSet]
type = CtrlSet
triggerall = !animtime
triggerall = anim != 7990 ;To fix a bug with this anim
;Basic moves
trigger1 = (stateno = [200,599])
;System moves
trigger2 = (stateno = [310,330])
value = 1

;================================================================================
; ------- NotHitBy fix by Caddie --------
;===============================================================================
[State -2, hitby]
type = hitby
trigger1 = life > 0
trigger1 = stateno = 5100 || stateno = 5110 || stateno = 5120
trigger1 = anim != 5120
value = SCA, NA, SA, HA, NP, SP, HP, NT, ST, HT
time = 1

;================================================================================
; ------- Cybaster Fix --------
;===============================================================================
[State -3, Cybaster fix]
type = StopSnd
trigger1 = stateno != 101
trigger1 = stateno != 190
trigger1 = stateno != 191
trigger1 = stateno != 192
trigger1 = stateno != 193
channel = 27

;================================================================================
; ------- Front corner fix --------
;===============================================================================
;To prevent switching sides while making combos.
[State -2, Width]
type = Width
triggerall = numenemy
trigger1 = facing != enemynear, facing
trigger1 = movetype != H
edge = 8,0
ignorehitpause = 1

[State -2, Damage based on hits]
type=varset
trigger1= numenemy
fvar(12)= enemynear,gethitvar(hitcount)
ignorehitpause=1

[State -2, Reset var when the opponent recovers]
type=varset
trigger1= numenemy
trigger1= (enemynear,movetype!=H)
trigger2= !numenemy
fvar(12)=0

[State -2, Dampener]
type=varset
triggerall = stateno != [3000,3099]
trigger1=1
fvar(10)= cond(fvar(12)<11,cond(fvar(12)=0, 1, cond(fvar(12)=1, .9, .9**fvar(12))),.25)
ignorehitpause=1

[State -3, Attack Scale]
type = AttackMulSet
trigger1 = 1
value = fvar(10)
ignorehitpause = 1

[state -2, No Clones]
type = remappal
triggerall=numenemy && (var(36)=[1,46]);fvar(36)=the number of pals available 
trigger1=var(37)&&!numhelper(12345)&&matchno=1&&roundno=1
trigger1=enemy,authorname="Shimmering Brony & Jarquin10"&&enemy,name="Marceline Abadeer"&&enemy,var(36)=var(36) 
source = 1, 1
dest = 1, Ifelse(teamside!=1 && enemynear,Numhelper(12345)=0,enemy,var(36)+teamside,var(36))
ignorehitpause = 1

[State -2, RMP]
type = remappal
trigger1 = !AIlevel
trigger1 = var(36) && roundstate < 2
source = 1,1
dest = 1,var(36)

[State 0, VarSet]
type = VarSet
trigger1 = !AIlevel
trigger1 = numhelper(12345)
v = 36
value = helper(12345), var(36)

