air.type = High
air.velocity = -5,-7.7
air.hittime = 20
fall = 1
air.fall = 1
fall.recover = 0
fall.recovertime = 0
yaccel = .6
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
