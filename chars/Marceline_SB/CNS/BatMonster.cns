hitflag = MAF                    ;Flags of conditions that move can hit
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 15, 23                 ;Time attacker pauses, time opponent shakes
sparkno = s8002                      ;Spark anim no (Def: set above)
sparkxy = -11, -51               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = s3030, 1                  ;Sound to play on hit
guard.sparkno = s8003
guardsound = s6, 0                ;Sound to play on guard
getpower = 0,0
givepower = 16,16
