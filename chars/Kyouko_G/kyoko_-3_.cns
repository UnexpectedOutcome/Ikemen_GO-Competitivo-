trigger2 = StateNo = [65,67]
trigger3 = StateNo = 110
trigger4 = StateNo = 115
var(5) = 1

[State -3, AirMove_AirDashNum]
type = null;VarAdd
triggerall = Time = 1
trigger1 = StateNo = 115
trigger2 = StateNo = 110
;trigger3 = StateNo = [45,47]
;trigger4 = StateNo = [65,67]
var(5) = 1

[State -3, AirMove_Reset]
type = VarSet
triggerall = var(5) != 0
trigger1 = StateType = S || StateType = C
var(5) = 0
IgnoreHitPause = 1


;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -3, AttackMulCount]
type = VarSet
triggerall = fvar(0) > 0.4
trigger1 = MoveHit = 1
trigger2 = ProjHitTime(0) = 1
trigger3 = PrevStateNo = [1000, 3600)
trigger3 = StateNo > 3499
fvar(0) = fvar(0) -0.1
persistent = 0

[State -3, AttackMulSPChancel]
type = VarSet
triggerall = 0;fvar(0) > 0.35
trigger1 = PrevStateNo = [1000, 3600)
trigger1 = StateNo > 3499
fvar(0) = 0.35
persistent = 0

[State -3, AttackMulReset]
type = VarSet
trigger1 = fvar(0) != 1
trigger1 = P2MoveType != H
fvar(0) = 1.0

[State -3, AttackMulSet]
