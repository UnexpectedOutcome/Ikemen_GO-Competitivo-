; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, AngleSet]
type = AngleSet
trigger1 = Time = 0
value = 0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State -2, StateTypeSet]
type = StateTypeSet
trigger1 = 1
statetype = S
physics = S

[State -2, StateTypeSet]
type = StateTypeSet
trigger1 = Command = "holddown"
statetype = C
physics = C

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0 +(StateType=C)*11
ctrl = 1


