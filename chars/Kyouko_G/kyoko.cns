; HITA_UP (initial going up)　吹っ飛びステート
[Statedef 5030]
type    = A
movetype= H
physics = N
ctrl = 0

[State -1, SelfState] ;追加
type = SelfState
trigger1 = var(3) -ID != -32768 ;!PlayerIDExist(var(3))
trigger1 = HitFall
value = StateNo

[State 5030, 1]
type = VelAdd;Gravity
trigger1 = 1
y = GetHitVar(yaccel)

[State 5030, 2]
