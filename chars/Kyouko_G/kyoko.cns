[Statedef 102, RunFwd]
type = S
physics = S
ctrl = 1
anim = StateNo
sprpriority = 1

[State -1]
type = CtrlSet
trigger1 = var(59) > 0
value = 0

[State -1, NoWalk]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn
flag2 = NoWalk

[State -1, VelSet]
type = VelSet
trigger1 = 1
x = Const(Velocity.Run.Fwd.X)
;y = Const(Velocity.Run.Fwd.Y)

[State -1, ChangeState]
type = ChangeState
;triggerall = !var(59)
trigger1 = Time = 60
trigger2 = var(59) = 0
trigger2 = Command != "holdfwd"
trigger3 = var(59) > 0
trigger3 = var(58) != [104,112]
trigger3 = var(58) != 5
Trigger3 = numhelper(12500) > 0
Trigger3 = inguarddist || ((helper(12500),inguarddist = 1) || p2bodydist x >= 100&&(p2movetype=A))|| (enemynear,numproj > 0)
Trigger3 = Random <= (var(59)%100)*(var(59)%100)*10
trigger3 = (((helper(12500),var(59))-(enemynear,time)) <= 15) || (enemynear,HitDefAttr != SC,AT)
trigger4 = var(59) > 0
trigger4 = p2dist x < 0 || roundstate != 2 || p2bodydist x < -5
trigger4 = var(58) != [104,112]
trigger4 = var(58) != 5
trigger5 = var(59) > 0
trigger5 = p2dist x < 0 || roundstate != 2 || (p2bodydist x < 10) && p2bodydist y > -110
trigger5 = var(58) = [104,112]
trigger5 = var(58) != 110
trigger6 = var(59) > 0
trigger6 = p2dist x < -5 || roundstate != 2
trigger6 = var(58) = 5 || var(58) = 110
value = StateNo +1

