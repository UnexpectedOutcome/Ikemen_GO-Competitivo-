trigger1 = 1
var(10) = 1

[state 60, varset]
type = varset
triggerall = !var(59)
trigger1 = command = "sjump-n"
var(17) = 0

[state 60, varset]
type = varset
triggerall = !var(59)
trigger1 = command = "sjump-f"
var(17) = 1

[state 60, varset]
type = varset
triggerall = !var(59)
trigger1 = command = "sjump-b"
var(17) = -1

[state 60, afterimage]
