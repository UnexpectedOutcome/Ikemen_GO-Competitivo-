[Statedef 5001] ; 変更
type    = S
movetype= H
physics = S

[State 5001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 2] ; 変更
type = ChangeAnim
trigger1 = Anim-5005-(GetHitVar(groundtype)=2)*10 < 0
trigger1 = AnimTime = 0
value = 5+Anim
persistent = 0

[State 5001, ChangeAnim] ; 追加
type = ChangeAnim
trigger1 = Anim = 5005+GetHitVar(animtype)+(GetHitVar(groundtype)=2)*10
trigger1 = Abs(AnimTime) <= GetHitVar(HitTime)
value = Anim

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 5001, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 5001, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 5001, 6] ; 変更
type = ChangeState
trigger1 = HitOver
;trigger1 = AnimTime = 0
value = 0
ctrl = 1

