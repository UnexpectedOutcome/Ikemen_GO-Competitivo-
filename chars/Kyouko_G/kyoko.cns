trigger1 = time = 0
time = 20
length = 16
palcontrast = 192,192,192
paladd = 20,20,20
palmul = 0.7,0.7,0.7
framegap = 4
trans = add1

[state 60, changeanim]
type = changeanim
trigger1 = time = 0
value = 41;+(var(17)=1)+(var(17)=-1)*2
persistent = 0

[state 60, playsnd]
type = playsnd
trigger1 = time = 0
value = 0,1

[state 60, velset]
type = velset
trigger1 = time = 0
x = var(17)*3
y = -17

[state 60, changestate]
type = changestate
trigger1 = time = 2
value = 63
