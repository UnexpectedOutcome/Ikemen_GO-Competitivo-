[Statedef 3000, sa/5]
type = S
movetype = A
physics = S
juggle = 1
;velset = 0, 0
ctrl = 0
anim = StateNo
poweradd = -1000 -1000 *((PrevStateNo>999) +(PrevStateNo>1999))
sprpriority = 2

[State -1, Width]
type = Width
trigger1 = AnimElemTime(2) < 0
player = 20, 0

[State -1, VelSet]
type = VelSet
trigger1 = AnimTime = 0
y = -8.0

[State -1, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = StateNo +1

[State -1, HitDef]
type = HitDef
trigger1 = Time = 0
trigger2 = AnimElemTime(5) = -1
;基礎設定
attr = S, HA	;SCA, NSH, ATP
hitflag = HLAF	;HLAFD+- ("+"コンボ中のみhit可,"-"コンボ中Hit不可
guardflag = HLA	;HLA
animtype = Back	;Light, Medium, Hard, Back, Up, DiagUp
priority = 6, Hit	;1-7(def4), Hit, Miss, Dodge(引き分け)
damage = 60, 6
getpower = 0, 0
givepower = 20, 0
pausetime = 10, 10
;スパーク、音
sparkno = s6050 +Random%4
guard.sparkno = s6100
sparkxy = -10, -20	;相手基準
hitsound = s10, 24
guardsound = s10, 101
;相手状態
ground.type = Low	;High, Low, Trip, None
ground.hittime = 24	;与dm時間(硬直後の全体数値
ground.slidetime = 24	;硬直後の押し戻し数値(hittime以下にする
ground.velocity = 1.0, -7.0
guard.hittime = 16
air.hittime = 30	;項目消すと20固定
air.velocity = 1.0, -7.0
;fall
fall = 1
fall.recover = 0

