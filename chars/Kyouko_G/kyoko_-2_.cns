[Statedef -2]

;;======================
;; Configurable Part
;;======================

[State -2, PowerUP]  ;;;;Powering up when certain partners are present!
type = VarSet
trigger1 = 1
v = 32
value = 1      ;;0 = off    1 = on
ignorehitpause = 1

;==============================================================================
;死亡ボイス処理
;==============================================================================
[State -3]
type = PlaySnd
trigger1 = Alive = 0
triggerall = var(55) = 1
trigger1 = var(39) != 9999
value = 12,0+random%3
channel = -1
ignorehitpause = 1
[State -3, セット]
type = VarSet
trigger1 = Alive = 0
triggerall = var(55) = 1
trigger1 = var(39) != 9999
v = 39
value = 9999
ignorehitpause = 1
[State -3, セット]
type = VarSet
trigger1 = alive = 1
triggerall = var(55) = 1
trigger1 = var(39) = 9999
v = 39
value = 0
ignorehitpause = 1
[State -1, line]
type = RemoveExplod
trigger1 = stateno != 3201
id = 3210
[State -1, line]
type = RemoveExplod
trigger1 = stateno != 3201
id = 3212
[State -1, line]
type = RemoveExplod
trigger1 = stateno != 3201
id = 3214
