size.yscale = 3

[State -2, Pause] ; 時間停止
type = Pause
trigger1 = StateNo = 3500 && AnimElemTime(1) = 1
trigger2 = StateNo = 3000 && AnimElemTime(2) = 0
trigger3 = StateNo = 3005 && AnimElemTime(1) = 1
trigger3 = PrevStateNo < 3000
trigger4 = StateNo = 3010 && AnimElemTime(2) = 0
trigger5 = StateNo = 3600 && AnimElemTime(1) = 1
time = 24		; 停止時間	: default : 30
movetime = 0		; 動作時間	: default : 0

[State -2, Pause] ; 時間停止
type = Pause
trigger1 = StateNo = 3600 && AnimElemTime(1) = 1
time = 40		; 停止時間	: default : 30
movetime = 0		; 動作時間	: default : 0

[State -2, Pause] ; 時間停止
type = Pause
trigger1 = StateNo = 3200 && AnimElemTime(1) = 1
trigger2 = StateNo = 3700 && AnimElemTime(1) = 1
time = 40		; 停止時間	: default : 30
movetime = 40		; 動作時間	: default : 0

[State -2, BGPalFX] ; 暗転
type = BGPalFX
trigger1 = StateNo = 3500 && AnimElemTime(1) = 1
trigger2 = StateNo = 3000 && AnimElemTime(2) = 0
trigger3 = StateNo = 3005 && AnimElemTime(1) = 1
trigger3 = PrevStateNo < 3000
trigger4 = StateNo = 3010 && AnimElemTime(2) = 0
time = 24			; 持続時間 : やられ中も機能する
mul = 100, 100, 100		; 乗算　　 : r/g/b : 白に影響 : r/256を乗算

[State -2, BGPalFX] ; 暗転
type = BGPalFX
trigger1 = StateNo = 3200 && AnimElemTime(1) = 1
trigger2 = StateNo = 3700 && AnimElemTime(1) = 1
trigger3 = StateNo = 3600 && AnimElemTime(1) = 1
time = 40			; 持続時間 : やられ中も機能する
mul = 100, 100, 100		; 乗算　　 : r/g/b : 白に影響 : r/256を乗算

;-------------元気100倍
[state 7000]
type = poweradd
