; デバッグ
[State -2, DisplayToClipboard]
type     = DisplayToClipboard
triggerall = 1
trigger1 = 1
text     = "AI:%d, v8:%d, v4:%d, v55:%d, p2Y:%f \n"
params   = Var(55),var(8),var(4),var(55),fvar(37)-fvar(36) +var(50)
IgnoreHitPause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999
[State -2, 距離確認デバック]
type = AppendToClipboard
triggerall = 1
trigger1 = 1
text =  "P2X:%f,P2Y:%f,Vx%f,Vy%f,Pos y%f \n"
params = P2BodyDist x,P2BodyDist y,vel x,vel y,Pos y
IgnoreHitPause = 1

