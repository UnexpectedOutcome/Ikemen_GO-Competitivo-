ignorehitpause = 1

[state 7000]
type = poweradd
triggerall = var(32)
triggerall = numpartner
triggerall = alive
triggerall = roundstate = 2
trigger1 = Partner,Name = "miki sayaka"
value = ifelse(var(20),6,3)
ignorehitpause = 1

[state 7000]
type = lifeadd
triggerall = var(32)
triggerall = numpartner
triggerall = alive
triggerall = movetype != H
trigger1 = Partner,Name = "miki sayaka"
trigger1 = roundstate = 2
trigger1 = timemod = 4,0
value = 1
ignorehitpause = 1

;-------------元気100倍
[state 7000]
type = defencemulset
trigger1 = palno = 12
value = 0.1
ignorehitpause = 1

[State -3, DefenceMulSet100-20]
type = DefenceMulSet
trigger1 = palno = [1,11]
trigger1 = 1.0*Life/LifeMax <= 0.8
trigger1 = 1.0*Life/LifeMax > 0.2
value = ifelse(power>=4500,0.6,0.75)

[State -3, DefenceMulSet20-]
type = DefenceMulSet
trigger1 = palno = [1,11]
trigger1 = 1.0*Life/LifeMax <= 0.2
value = ifelse(power>=4500,0.4,0.5)

[State -2, AfterImageTime]
type = AfterImage
trigger1 = MoveType = H
trigger2 = StateNo != [50, 51]
trigger2 = StateNo != [60, 99]
trigger2 = StateNo != [100, 119]
time = 0
Trans = Add
Length = 12
TimeGap = 1
FrameFap = 1
PalBright = 0, 0, 0
PalContrast = 220, 220, 220
PalAdd = 0, 0, 0
PalMul = 0.5, 0.5, 0.5
Peresistent = 1

