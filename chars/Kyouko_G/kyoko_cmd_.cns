type = Helper
TriggerAll = (var(59)%100) > 0
trigger1 = numhelper(12500) = 0
trigger1 = roundstate = 2
trigger1 = !ishelper
helpertype = normal
name = "AI"
ID = 12500
keyctrl = 0
stateno = 12500
postype = p1
pos = 0,-50
ownpal = 1
supermovetime = 999999
pausemovetime = 999999


[state -2];端検出
