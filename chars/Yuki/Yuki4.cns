; 立ちモーション
[Statedef 4000]
type = S
physics = S
sprpriority = 0
anim = 4000

[State 00]
type = NotHitBy
trigger1 = 1
value = SCA

;---------------------[腕のエフェクト]
[State removeexplod];前のステートの光消去
type = removeexplod
trigger1 = time = 0
ID = 4000

[State explod];ブレスレットの光
type = Explod
trigger1 = numexplod(4000) = 0
anim = 4001
id = 4000
sprpriority = 2
postype = p1
pos = 0,0
bindtime = -1
removetime = -1
supermove = 1
under = 0

;---------------------[]
[state a]
type = changeanim
trigger1 = p2Dist X < 0
value = 4000

[State removeexplod];前のステートの光消去
type = removeexplod
trigger1 = p2Dist X < 0
ID = 4000

[state a]
type = turn
trigger1 = p2Dist X < 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------[打撃防御]
[state a]
type = reversaldef
trigger1 = 1
attr = S,HA
reversal.attr = SCA,NA,SA,HA
pausetime = 0,4
hitsound = s310,var(6)
numhits = 0

[State 02];カメラ固定
type = screenbound
trigger1 = 1
value = 1
movecamera = 1

;---------------------[]
[state a];前進
type = changestate
trigger1 = command = "holdfwd"
value = 4020

[state a];後退
type = changestate
trigger1 = command = "holdback"
value = 4021

[state a];ジャンプ
type = changestate
trigger1 = command = "holdup"
value = 4040

[state a];メガトンスパーク
type = changestate
trigger1 = command = "メガトンスパーク"
value = 4800

[state a];アトミックパンチ
type = changestate
trigger1 = command = "x"
value = 4200

[state a];アトミックパンチ
type = changestate
trigger1 = command = "y"
value = 4200

[state a];アトミックスライディング
type = changestate
trigger1 = command = "a"
value = 4400

[state a];アトミックスライディング
type = changestate
trigger1 = command = "b"
value = 4400

[state a];変身終了
type = changestate
trigger1 = command = "destranformarse"
trigger2 = var(26) <= 0
value = 4900


