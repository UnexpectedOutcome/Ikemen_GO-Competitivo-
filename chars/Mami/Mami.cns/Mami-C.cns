; HITG_SLIDE
[Statedef 5001]
type    = S
movetype= H
physics = S

[State 5001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 2]
type = ChangeAnim
triggerall = var(10) = 0
trigger1 = AnimTime = 0
value = 5005 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10


[State 5001, 2]
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = AnimTime = 0
value = 35005 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 5001, 2]
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = AnimTime = 0
trigger1 = !alive
value = 5005 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

