;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
triggerall = var(10) = 0
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
triggerall = var(10) = 0
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = 3
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
triggerall = var(10) = 0
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [4,5]
value = 5047 + GetHitVar(animtype) 

[State 5000, 4] ;Freeze anim
type = ChangeAnim
triggerall = var(10) = 0
trigger1 = Time > 0
value = anim


[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),35000,35010) + GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = 3
value = 35030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [4,5]
value = 35047 + GetHitVar(animtype) 



[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = !alive
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = !alive
trigger1 = GetHitVar(animtype) = 3
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = !alive
trigger1 = GetHitVar(animtype) = [4,5]
value = 5047 + GetHitVar(animtype) 



[State 5000, 4] ;Freeze anim
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = Time > 0
value = anim


[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
trigger3 = GetHitVar(animtype) = [3,5]
statetype = a

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
value = ifelse(statetype != A,5001,5030)

[State -1]
type = VarSet
trigger1 = Time = 0
var(25) = 1

[State -1]
type = VarAdd
trigger1 = Time = 0
trigger1 = var(51) <= 350
fvar(20) = 30


[State 5000]; 
type = ChangeState
triggerall = var(59) > 0       
triggerall = fvar(20) = 1200
triggerall = Life > 0
triggerall = helper(27000),var(3) = 1

trigger1 = Command = "by"
trigger2 = var(51) < 50
trigger2 = random <= var(59)*3

trigger3 = var(51) = [50,150]
trigger3 = random <= var(59)*1

trigger4 = var(51) = [150,250]
trigger4 = random <= var(59)*0.1

trigger5 = var(51) < 280
trigger5 = random <= var(59)*10
trigger5 = life < lifemax/10

value = 999

