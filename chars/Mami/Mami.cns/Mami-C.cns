y = const(velocity.jump.y)*0.8

[State ]
type = VelSet
trigger1 = PalNo = [11,12]
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*1.8, const(velocity.jump.back.x)*1.8))
y = const(velocity.jump.y)*0.8

[State ]
