type    = A
movetype= H
physics = N

[State 155]
type = ChangeAnim
triggerall = var(10) = 0
trigger1 = Time = 0
value = 152

[State 155]
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = Time = 0
value = 30152

[State 155, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 155, 2]
