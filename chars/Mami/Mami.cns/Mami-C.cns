;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 5050]
type    = A
movetype= H
physics = N

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
triggerall = var(10) = 0
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = Anim != [(5051), (5052)]
trigger2 = Anim != [(5061), (5062)]
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 5050, 2] ;Coming down anim
type = ChangeAnim
triggerall = var(10) = 0
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
value = anim+10
persistent = 0

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = AnimTime = 0
trigger1 = Anim = 35035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 35035
trigger2 = Anim != [(35051), (35052)]
trigger2 = Anim != [(35061), (35062)]
trigger2 = Anim != 35090 ;Not if hit off ground anim
value = 35050

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
triggerall = var(10) = 1
triggerall = !alive
trigger1 = AnimTime = 0
trigger1 = Anim = 35035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 35035
trigger2 = Anim != [(35051), (35052)]
trigger2 = Anim != [(35061), (35062)]
trigger2 = Anim != 35090 ;Not if hit off ground anim
value = 5050

[State 5050, 2] ;Coming down anim
type = ChangeAnim
triggerall = var(10) = 1
trigger1 = anim = [35050,35059]
trigger1 = Vel Y >= ifelse(anim = 35050, 1, -2)
value = anim+10
persistent = 0

[State 5050, 3] ;Gravity
type = VelAdd
