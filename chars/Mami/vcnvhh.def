[Info]
name = "Kyoko_Sakura"			;Name of character
displayname = "Kyoko_Sakura"		;Name of character to display
versiondate = 05, 20, 2014	;Version date of character (MM-DD-YYYY)
mugenversion = 04, 14, 2002	;Version of M.U.G.E.N character works on
author = "Waribashi"		;Character author name
pal.defaults = 6, 7, 8, 9	;Default palettes in order of preference

; Files for the player
[Files]
sprite   = kyoko_spr.sff	;Sprite
anim     = kyoko_anm.air	;Animation
sound    = kyoko_snd.snd	;Sound
cmd      = kyoko_cmd.cns	;Command set
cns      = kyoko_dat.cns	;Constants
stcommon = common1.cns		;Common states
st       = kyoko_com.cns	;States
st1      = kyoko_atk.cns
st2      = kyoko_etc.cns
;st3      = kyoko_.cns
;st4      = kyoko_.cns
;st5      = kyoko_.cns
;st5      = kyoko_.cns
;st1      = kyoko_.cns
;st8      = kyoko_.cns
;st9      = Config.cns

;Palettes (can have up to 12)
pal1	= act/pal1.act
pal2	= act/pal2.act
pal3	= act/pal3.act
pal4	= act/pal4.act
pal5	= act/pal5.act
pal6	= act/pal6.act
pal7	= act/pal7.act
pal8	= act/pal8.act
pal9	= act/pal9.act
pal10	= act/pal10.act
pal11	= act/pal11.act
pal12	= act/pal12.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
