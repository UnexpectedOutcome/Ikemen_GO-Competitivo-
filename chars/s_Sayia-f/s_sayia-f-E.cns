;-------------LV3じゃない↓-------------
[state 1]
type = nothitby
trigger1 = Prevstateno!=732;K投げ
trigger1 = Prevstateno!=3520;LV3転移投げ後
trigger1 = Prevstateno!=3522;LV3気合後
trigger1 = !Teammode = simul
value = SCA

[state 1]
type = velset
trigger1 = Prevstateno!=3520;LV3転移投げ後
trigger1 = Prevstateno!=3522;LV3気合後
trigger1 = time=10-(Prevstateno=3060)*8;強エデン後
x = -5+(Prevstateno=732)*9
y = -7-(Prevstateno=1121)*3-(Prevstateno=732)*.5

[state 1]
type = veladd
trigger1 = Prevstateno!=3520;LV3転移投げ後
trigger1 = Prevstateno!=3522;LV3気合後
trigger1 = time>10-(Prevstateno=3060)*8;強エデン後
y = .45

[state 1]
type = posadd
trigger1 = Prevstateno!=3060;強エデン後
trigger1 = Prevstateno!=3520;LV3転移投げ後
trigger1 = Prevstateno!=3522;LV3気合後
trigger1 = Time=1||Time=3||Time=5||Time=7||Time=9
x = -1

[state 1]
type = posadd
trigger1 = Prevstateno!=3060;強エデン後
trigger1 = Prevstateno!=3520;LV3転移投げ後
trigger1 = Prevstateno!=3522;LV3気合後
trigger1 = Time=2||Time=4||Time=6||Time=8||Time=10
x = 1
;-------------LV3じゃない↑-------------

;-------------LV3↓-------------
[state 1]
type = nothitby
trigger1 = Prevstateno=3520;LV3転移投げ後
trigger2 = Prevstateno=3522;LV3気合後
value = SCA

[state 1]
type = velset
triggerall = time = 0
trigger1 = Prevstateno=3520;LV3転移投げ後
trigger2 = Prevstateno=3522;LV3気合後
x = -5-(Prevstateno=3522)*3
y = -7

[state 1]
type = veladd
triggerall = time > 0
trigger1 = Prevstateno=3520;LV3転移投げ後
trigger2 = Prevstateno=3522;LV3気合後
y = .45
;-------------LV3↑-------------

