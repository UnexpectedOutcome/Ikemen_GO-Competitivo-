;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

;軸攻撃を解除
[State 1]
type = varset
trigger1 = time=0
sysfvar(1) = 0

;復帰後無敵
[State 1]
type = nothitby
trigger1 = Prevstateno=350||Prevstateno=361||Prevstateno=5201||Prevstateno=5210
trigger1 = time = 0
value = ,AT
time = 3

[State 1]
type = changeanim
trigger1 = anim!=0 && anim!=5
trigger2 = anim=5 && animtime=0
value = 0

[State 1]
type = velset
trigger1 = time=0
y = 0

[State 0,3]
type = velset
trigger1 = abs(vel x)<2
trigger2 = time = 4
trigger3 = var(59)<0
x = 0

;妙な硬直潰し
[State 1]
type = ctrlset
trigger1 = prevstateno=99||prevstateno=[21,22]
value = 1

[State 1,v11]
type = varset
trigger1 = 1
var(11)=0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

;先行入力・発動
[State 0,4]
type = changeState
triggerall = var(59)=0&&!Ishelper&&roundstate=2&&alive&&ctrl
triggerall = time>0
triggerall = fvar(19)>0
trigger1 = power>=1000
trigger1 = fvar(19)=3000||fvar(19)=3050||fvar(19)=3100||fvar(19)=3150
trigger2 = power>=2000
trigger2 = fvar(19)=3200||fvar(19)=3300||fvar(19)=3400&&(!var(3)||fvar(11))
trigger3 = power>=3000
trigger3 = fvar(19)=3500&&(!helper(8888),var(2)&&var(6)=400||fvar(11))
trigger4 = power>=200
trigger4 = fvar(19)=1400||fvar(19)=1350
trigger5 = power>=50
trigger5 = fvar(19)=1300||fvar(19)=1600||fvar(19)=1605||fvar(19)=1610||fvar(19)=1500||fvar(19)=1550||fvar(19)=1570
trigger6 = fvar(19)=1000||fvar(19)=1050||fvar(19)=1100||fvar(19)=1200||fvar(19)=1250||fvar(19)=1450
trigger7 = fvar(19)=[200,440]
value = ceil(fvar(19))

;先行入力・解除
[State 1,fv19]
type = varset
triggerall = fvar(19)>0
trigger1 = time>1
trigger2 = time=0 && (command="holdfwd"||command="holdback"||command="holdup"||command="holddown")
fvar(19)=0

;分身除去
[State 1005,end]
type = Destroyself
trigger1 = time=0
trigger1 = ishelper

[State 0,4]
type = changeState
trigger1 = !alive
value = 5050
