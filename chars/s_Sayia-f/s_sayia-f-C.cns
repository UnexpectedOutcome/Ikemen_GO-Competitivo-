;大ジャンプ
[State 1,v6]
type = varset
triggerall = var(59)>0
triggerall = time=0
trigger1 = P2bodydist X > 150-(Random%3*10)
var(26) = 2

;垂直
[State 1]
type = varset
triggerall = time = 1
triggerall = var(59)>0
triggerall = P2bodydist X = [0,5]
;---デフォ---
trigger1 = enemynear(var(47)),stateno=5120&&animtime=-1||enemynear(var(47)),movetype=I
trigger2 = enemynear(var(47)),statetype=C&&enemynear(var(47)),movetype=A
trigger3 = enemynear(var(47)),statetype=S||enemynear(var(47)),statetype=C
trigger3 = enemynear(var(47)),Movetype=A&&enemynear(var(47)),vel X>0
trigger4 = enemynear(var(47)),statetype=S||enemynear(var(47)),statetype=C
trigger4 = enemynear(var(47)),movetype=A&&enemynear(var(47)),vel X=0
trigger4 = prevstateno=5120
;---デフォ---
sysvar(1)=0

;前
[State 1]
type = varset
triggerall = time = 2
triggerall = var(59)>0
triggerall = P2bodydist X >= 6 || FrontEdgeDist < 50
triggerall = sysvar(1)=-1 || sysvar(1)=0 || sysvar(1)=1
;---デフォ---
trigger1 = enemynear(var(47)),statetype=S||enemynear(var(47)),statetype=C||enemynear(var(47)),stateno=5120||enemynear(var(47)),movetype=I
trigger2 = Enemy,NumProj >= 0
trigger2 = EnemyNear,Movetype = A
trigger2 = EnemyNear,HitDefAttr = SCA,AP,AA,AT
trigger2 = enemynear(var(47)),movetype!=H
trigger3 = enemynear(var(47)),statetype=S||enemynear(var(47)),statetype=C
trigger3 = enemynear(var(47)),movetype=A&&enemynear(var(47)),vel X > 0
trigger4 = enemynear(var(47)),statetype=S||enemynear(var(47)),statetype=C
trigger4 = enemynear(var(47)),movetype=A&&Enemy,NumProj >= 0
;---デフォ---
trigger5 = (100*life/const(data.life))>=30
trigger6 = Teammode = simul
trigger6 = var(13) > 100
trigger6 = partner,alive = 1
sysvar(1)=1

;後
[State 1]
type = varset
triggerall = time=0
triggerall = var(59)>0
trigger1 = BackEdgeDist > 100
trigger1 = (100*life/const(data.life))<=30
trigger1 = power <= 200
trigger2 = Teammode = single || Teammode = turns
trigger2 = Enemy,NumProj = 0
trigger2 = enemynear(var(47)),movetype != A
sysvar(1)=-1

;ジャンプ軌道
[State 1]
type = velset
trigger1 = animtime=0
x = ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))*ifelse(var(26)=2,1.3,1)
y = ifelse(var(26)=1,-6.2,const(velocity.jump.y))

[State 1]
type = changeState
triggerall = var(59)>0
triggerall = time=0
trigger1 = P2statetype = A
trigger2 = teammode = single || teammode = turns
trigger2 = enemy,teammode = single || enemy,teammode = turns
trigger2 = P2bodydist X > 150
value = 0
ctrl = 1

[State 1]
type = changeState
trigger1 = animtime=0
value = 50
ctrl = 1
