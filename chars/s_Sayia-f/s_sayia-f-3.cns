trigger6  = stateno=3505&&(animelem=38,=1||animelem=43,=1||animelem=48,=1||animelem=53,=1||animelem=58,=1||animelem=63,=1);2ヒット扱い
;風龍神召喚２
trigger7  = stateno=3507&&(time=[68,81]);2ヒット扱い
trigger8  = stateno=3507&&(animelem=28)
