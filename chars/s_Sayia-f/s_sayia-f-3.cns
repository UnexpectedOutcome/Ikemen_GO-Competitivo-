trigger1  = stateno=1251&&(animelem=3||animelem=4,=3||animelem=4,=5||animelem=4,=7||animelem=4,=9)
trigger2  = stateno=1251&&(animelem=4,=11||animelem=4,=13||animelem=4,=15||animelem=4,=17||animelem=4,=19)
