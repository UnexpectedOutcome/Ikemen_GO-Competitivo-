;耐魔壁魔方陣
[Statedef 2000]
type = S
movetype = I
physics = S
anim = 2000
juggle = 0
velset = 0,0
ctrl = 0
sprpriority = 10

[State 1]
type = playsnd
trigger1 = time=0
value = s2000,0

[state 1]
type = null
triggerall = time=0
trigger1 = var(0):=root,stateno
trigger1 = var(1):=root,var(26)
trigger1 = var(10):=40

[state 1]
type = bindtoroot
trigger1 = 1
time = -1
facing = 1
pos = var(10),-55

[State 1]
type = AssertSpecial
trigger1 = 1
flag = noshadow

;発生
[State 1]
type = varadd
trigger1 = time<=var(1)
trigger1 = fvar(0)<.15
fvar(0) = .01
[State 1]
type = varadd
trigger1 = time<=var(1)
trigger1 = fvar(1)<.6
fvar(1) = .04

;終了
[State 1]
type = varadd
trigger1 = time>var(1)
fvar(0) = -.01
[State 1]
type = varadd
trigger1 = time>var(1)
fvar(1) = -.04

[State 1]
type = AngleDraw
trigger1 = 1
scale = fvar(0),fvar(1)

[State 1]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,256

[State -2]
type = DisplayToClipboard
trigger1 = 1
text = "(0)=%d (1)=%d f(0)=%f f(1)=%f"
params = var(0),var(1),fvar(0),fvar(1)
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

[State 1]
type = destroyself
trigger1 = root,movetype = H && root,stateno != [120,155]
trigger2 = fvar(0)<0
