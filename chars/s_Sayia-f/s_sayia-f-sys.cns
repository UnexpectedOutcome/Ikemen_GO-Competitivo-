;特殊ヘルパ
;ＴＰゲージ-20000／TP文字-20070／MP文字-20071
;スタン・ガークラゲージ-21000／ガークラ文字-21100／スタン文字-21101
;カウンター文字-21200／デンジャ-21210／超必-950／魔方陣-840／連続詠唱-980
;ダウン効果-870／すり抜け防止-4649
;============================================================================
;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;============================================================================
;ＴＰヘルパー
[Statedef 20000]
type = S
movetype = I
physics = N
anim = 9999
juggle = 0
velset = 0,0
ctrl = 0

;----------------------------------------
;----------【var】----------
;0 ：ＡＩＬＶ／1：possetY=0解除／2：LV3制御／3：ブリスレース有無／4：AIの鉄壁率≪初期値≫
;5 ：画面点滅／6：AIの鉄壁率≪変動値≫／7：気絶有無／8：タッグ仲間／9：vs仲間
;11：ゲージＹ座標補正／13：デンジャ効果タイミング／14：ＡＩの超必制限／
;19：癒し回復時間制御
;23：直ガ系入力≪猶予コンフィグ≫／24：直ガ系入力≪猶予≫／25：直ガ系入力≪成功≫／28：アッシュ／神楽の封印技
;30：先行入力受付猶予／33：タッグ時にＰ１
;58：KOボイス
;----------【fvar】----------
;10:被カウンター
;20:AI用猶予F・立／21:AI用猶予F・屈／22:AI用猶予F・空／
;----------------------------------------
;初期設定保存
[State -2,v3]
type = null
triggerall = time=0;※roundstate<2では、イントロスキップ時はセット出来ない
trigger1 = var(11):=var(33)+var(11)||1;ゲージＹ補正
;----------------------------------------
;変動物
[State -2,195]
type = null
triggerall = root,var(59)=0&&root,stateno=195&&root,fvar(11)
trigger1 = root,command="c"
trigger1 = var(7):=ifelse(var(7),0,1);スタンガークラ切り替え
;----------------------------------------
;待機のpossetY=0解除
[State -2,v1]
type = varset
trigger1 = P2name="M-NES Game 1"&&enemy,authorname="Bane84"  ;マリオステージ
trigger2 = P2name="kimoi"&&enemy,authorname="Kozeni"         ;天空からの使者
var(1) = 1
;----------------------------------------
;ＬＶ３制御
[State -2,v2]
type = null
trigger1 = root,stateno=3500&&root,time=1
trigger1 = var(2):=1     ;ＬＶ３使用
trigger2 = root,alive
trigger2 = (100*root,life/const(data.life))>20
trigger2 = var(2):=0||1  ;体力戻って再使用可能
trigger3 = root,stateno=3507
trigger3 = win
trigger3 = var(2):=2     ;ＬＶ３で勝利
;----------------------------------------
;AIの鉄壁率補正
[State -2,v6]
type = null
triggerall = roundstate=2;最大補正：100+40+200+60=400
trigger1 = var(6):=root,var(59)*10+ceil((root,var(52)/500)*10)+ceil(root,var(6)/2)+(root,stateno=5040||root,stateno=5210)*50
;----------------------------------------
;気絶有無
[State -2,v7]
type = null
trigger1 = roundstate=2
trigger1 = (root,Prevstateno=[190,194])||(root,Prevstateno=[196,199])
trigger1 = root,stateno=0
trigger1 = root,var(57)=1
trigger1 = var(7):=1
;----------------------------------------
;タッグ仲間認識／１：クレア／２：クレス／３：カイル
[State -2,v8]
type = null
triggerall = root,TeamMode = simul
triggerall = Numpartner>0
trigger1 = partner,name="s_crea-f"
trigger1 = var(8):= 1
trigger2 = partner,name="s_cless-f"
trigger2 = var(8):= 2
trigger3 = partner,name="s_kyle-c"
trigger3 = var(8):= 3
;----------------------------------------
;VS時仲間判別／１：サイア／２：クレア／３：クレス／４：カイル
[State -2,v9]
type = null
trigger1 = P2name="s_sayia-f" || P4name="s_sayia-f"
trigger1 = var(9):= 1
trigger2 = P2name="s_crea-f" || P4name="s_crea-f"
trigger2 = var(9):= 2
trigger3 = P2name="s_cless-f" || P4name="s_cless-f"
trigger3 = var(9):= 3
trigger4 = P2name="s_kyle-c" || P4name="s_kyle-c"
trigger4 = var(9):= 4
;----------------------------------------
;デンジャ効果タイミング
[State -2,v13]
type = varadd
triggerall = var(13) < 2
trigger1 = root,var(6)=400
var(13) = 1
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999
;デンジャ効果タイミング
[State -2,v0]
type = varset
trigger1 = root,var(6)!=400
var(13) = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999
;----------------------------------------
;癒し回復時間制御
;※pause無視のヘルパー内で制限時間を組まないと、-2対応側のpause処理時に回復処理が暴走する
[State -2,v19]
type = varset
trigger1 = root,stateno=3400&&root,time=77
var(19) = 50
persistent = 0
[State -2]
type = varset
trigger1 = root,Prevstateno=3400
trigger1 = root,movetype=H
var(19) = 0
[State -2]
type = varadd
trigger1 = root,stateno=3400
trigger1 = var(19)>0
var(19) = -1
;回復制御開始※-2処理で使う本体var
[state 1]
type = ParentVarSet
trigger1 = root,stateno=3400
trigger1 = var(19)>0
var(3) = 1
;回復制御終了※-2処理で使う本体var
[state 1]
type = ParentVarSet
trigger1 = root,stateno=3400
trigger1 = var(19)<=0
trigger2 = root,Prevstateno=3400
trigger2 = root,movetype=H
var(3) = 2
;----------------------------------------
;鉄壁入力
[State -2,v24]
type = varset
triggerall = roundstate = 2 && root,alive
triggerall = root,var(57)=1
;操作・素
trigger1 = root,var(59)<=0 && (root,command="back"||root,command="DB")
trigger1 = !var(24) && root,ctrl && root,stateno!=150&&root,stateno!=152&&root,stateno!=154
;操作・鉄壁からの再入力
trigger2 = root,var(59)<=0 && (root,command="back"||root,command="DB")
trigger2 = var(25)=1 && (root,stateno=[150,155])
;AI・素
trigger3 = root,var(59)>0&&random%48<root,var(59)+(var(6)/100)+var(4);最大値、8+4+4=16
trigger3 = !var(24) && root,stateno=120
trigger3 = root,anim=120&&fvar(20)<5||root,anim=121&&fvar(21)<5||root,anim=122&&fvar(22)<5
;AI・鉄壁からの再入力
trigger4 = root,var(59)>0&&random%64<root,var(59)+(var(6)/100)+var(4);最大値、8+4+4=16
trigger4 = var(25)=1 && (root,stateno=[150,155])
var(24) = var(23)

;入力成功維持
[State -2,v25]
type = varset
triggerall = root,var(57)=1
trigger1 = var(24)>0 && (root,stateno=150||root,stateno=152||root,stateno=154)
var(25) = 1

;解除
[State -2]
type = varset
triggerall = root,var(57)=1
trigger1 = root,movetype=H&&(root,stateno!=[150,155])
trigger2 = var(25)=1&&(root,stateno=120||(root,stateno=150||root,stateno=152||root,stateno=154)&&root,time=[2,3])
trigger3 = root,movetype=A
var(24) = 0

;解除
[State -2,v25]
type = varset
triggerall = root,var(57)=1
trigger1 = root,movetype=H&&(root,stateno!=[150,155])
trigger2 = root,stateno=0||(root,stateno=[10,11])||(root,stateno=[20,22])||(root,stateno=[99,104])||(root,stateno=[120,142])
trigger3 = root,movetype=A
var(25) = 0

;入力猶予時間
[State -2]
type = varadd
triggerall = roundstate = 2 && root,alive
triggerall = var(24)>0
trigger1 = root,var(57)=1;（鉄壁
trigger1 = root,stateno!=150&&root,stateno!=152&&root,stateno!=154
var(24) = -1
;-------------------------------------------------------
;アッシュ／神楽の封印技での動作制限
[State -2]
type = null
triggerall = root,Alive&&!Teammode = simul && !enemy,Teammode = simul
;【jin氏－アッシュ】「ジェルミナール」
trigger1 = enemy,authorname="jin"&&enemy,name="Ash"
trigger1 = enemy,var(40)!=0
trigger1 = root,movetype=H&&root,stateno=3120||enemy,NumHelper(3200)>0
trigger1 = var(28):=enemy,var(40)
;【Sander71113氏－ちずる】「零技の礎」
trigger2 = enemy,authorname="Sander71113" && enemy,name="Chizuru Kagura"
trigger2 = enemy,Numhelper(2001)>0||enemy,Numhelper(2011)>0
trigger2 = var(28):=2 ;※ヘルパーvarなので感知不能。ヘルパー在る間なので『２』で良い
;【MDK氏－ちずる_マキ】「零技の礎／三神技之参／洛水の神亀／簸帝之礼舞」
trigger3 = enemy,authorname="MDK"&&enemy,name="chizuru_maki"
trigger3 = enemy,stateno=2100&&enemy,movehit || enemy,NumHelper(4700)>0&&enemy,var(32)
trigger3 = var(28):=enemy,var(32)
;【別府氏－マキ】「洛水の神亀／零技の礎」
trigger4 = enemy,authorname="beppu"&&enemy,name="MakiXI"
trigger4 = enemy,var(16)!=0
trigger4 = root,movetype=H&&root,stateno=5030 || enemy,NumHelper(1360)>0
trigger4 = var(28):=enemy,var(16)
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

;封印時間解除
[State -2]
type = varset
triggerall = root,Alive
trigger1 = root,stateno!=5150 && (Teammode = simul || enemy,Teammode = simul || var(28)<0)
trigger2 = (enemy,authorname="jin"&&enemy,name="Ash") && (enemy,var(40)=0||!enemy,NumHelper(3200))
trigger3 = (enemy,authorname="Sander71113"&&enemy,name="Chizuru Kagura") && !enemy,NumHelper(2001)&&!enemy,NumHelper(2011)
trigger4 = (enemy,authorname="MDK"&&enemy,name="chizuru_maki") && (enemy,var(32)=0||!enemy,NumHelper(4700))
trigger5 = (enemy,authorname="beppu"&&enemy,name="MakiXI") && (enemy,var(16)=0||!enemy,NumHelper(1360))
var(28) = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

;封印時間解除予備
;相手のvar取得ミス用の保険
[State -2]
type = varadd
trigger1 = root,stateno!=5150
trigger1 = var(28)>0
var(28) = -1
ignorehitpause = 1
;----------------------------------------
;KOボイス
[State 1]
type = varadd
trigger1 = !root,alive
var(58) = 1
;----------------------------------------
;被カウンター／スタン値1.5倍
[State -2,fv10]
type = varset
triggerall = roundstate = 2
triggerall = Numhelper(21000)
triggerall = root,fvar(14) =[0,101]
trigger1 = root,movetype=A
fvar(10) = 1.5

;解除
[State -2]
type = varset
triggerall = roundstate = 2
triggerall = Numhelper(21000)
trigger1 = root,movetype!=A
fvar(10) = 1
ignorehitpause = 1
;----------------------------------------
;AI用入力制限（AIはtime=0を維持するのでtimeの代わり
;def120移動後、5未満のみ鉄壁入力を受け付ける

[State -2,vf20];立
type = varadd
trigger1 = root,anim=120
fvar(20)=1
ignorehitpause = 1
[State -2];屈
type = varadd
trigger1 = root,anim=121
fvar(21)=1
ignorehitpause = 1
[State -2];空
type = varadd
trigger1 = root,anim=122
fvar(22)=1
ignorehitpause = 1

[State -2,vf20]
type = null
trigger1 = root,anim!=120
trigger1 = fvar(20):=0||1
trigger2 = root,anim!=121
trigger2 = fvar(21):=0||1
trigger3 = root,anim!=122
trigger3 = fvar(22):=0||1
ignorehitpause = 1
;----------------------------------------
;----------------------------------------


