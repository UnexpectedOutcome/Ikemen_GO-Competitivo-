trigger1 = !(P2name="Nyarlathotep"&&enemy,authorname="nyal41")
trigger1 = !(P2Name="Demitri Maximoff"&&enemy,Authorname="(^o^)")
value = -1

[State 1]
type = sprpriority
triggerall = root,anim=9020
trigger1 = (P2name="Rucheca"&&enemy,Authorname="Teaf")
trigger2 = (P2name="Nyarlathotep"&&enemy,authorname="nyal41")
trigger3 = (P2Name="Demitri Maximoff"&&enemy,Authorname="(^o^)")
value = 2

[State 1]
