;===================================
;　基本設定・基本動作・通常技 の設定
;  ===================================
[Data]
life = 1000          ;スタート時の体力総計
attack = 90         ;攻撃力パーセンテージ （多いほど強くなります Def:100%）
defence = 100        ;防御力パーセンテージ （多いほど強くなります Def:100%）
fall.defence_up = 50 ;ダウン時に攻撃された時に一時的に上がる防御力のパーセンテージ
liedown.time = 60    ;ダウンしてから起き上がるまでの時間
airjuggle = 60       ;ジャグルポイント数
sparkno = 2        ;ディフォルトのスパーク番号
guard.sparkno = 40 ;ガード時のディフォルトスパーク番
KO.echo = 0          ;1にするとKOされた時に声にエコーがかかります
volume = 155           ;ボリュームオフセット (negative for softer)

[Size]
xscale = 1           ;水平方向の縮尺
yscale = 1           ;垂直方向の縮尺
ground.back = 15     ;キャラクターの幅（後方、地上）
ground.front = 15     ;キャラクターの幅（前方、地上）
air.back = 15        ;キャラクターの幅（後方、空中）
air.front = 15       ;キャラクターの幅（前方、空中）
z.width = 3          ;Player width (into and out)（現在使用されていないと思われます）
height = 50	     ;キャラクターの高さ
attack.width = 4,4   ;Default attack width: back, front（現在使用されていないと思われます）
attack.dist = 160    ;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist = 90 ;相手がガード体勢に入る発射物との最低距離（最大320）
proj.doscale = 0     ;xscale, yscaleの設定が発射物にも適用するかどうか（1で有効）
head.pos = -5, -50   ;頭の大体の座標（BindToTarget使用時に必要です。）
mid.pos = -5, -30    ;体中心の大体の座標（BindToTarget使用時に必要です。）
shadowoffset = 0     ;影の垂直方向オフセット

[Movement]
airjump.num = 1      ;空中ジャンプの回数 （オプション）
airjump.height = 35  ;空中ジャンプに必要な最低限の高さ （オプション）
yaccel = .23         ;垂直方向にかかる加速度（重力）
stand.friction = .85  ;立ち状態での摩擦係数
crouch.friction = .82 ;しゃがみ状態での摩擦係数

[Velocity]
walk.fwd  = 1.5      ;前に歩く時の速度
walk.back = -1.4     ;後ろに歩く時の速度
run.fwd  =  5.5, 0 ;前に走る時の速度 (x, y) ホップさせる時はyを0以下にします
run.back = -5.5, 0 ;後ろに走る時の速度 (x, y) 走らせる時はyを0にします
jump.neu = 0,-7    ;ジャンプ時の垂直移動速度 (x, y)
jump.back = -3.2    ;後ろにジャンプした時の水平移動速度
jump.fwd = 3.2       ;前にジャンプした時の水平移動速度
runjump.back = -2.55,-7.1 ;後ろに走りながらのジャンプ時の速度指定 (オプション)
runjump.fwd = 4,-7      ;前に走りながらのジャンプ時の速度指定 (オプション)
airjump.neu = 0,-7      ;空中ジャンプ時の垂直移動速度  (オプション)
airjump.back = -3.55,-8.1 ;空中で後ろにジャンプした時の水平移動速度
airjump.fwd = 3.5,-8.1    ;空中で前にジャンプした時の水平移動速度



;-----------------------
;敗北
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170 , 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;-----------------------
;---------------------------------------------------------------------------
; 勝利ポーズ分岐
; CNS レベル: 基本
[Statedef 180]
type = S

[State 180, ステート変更]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; 勝利ポーズ
; CNS レベル: 基本
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 200 , 2]
type = PlaySnd
trigger1 = AnimElem= 1
value = s0, 2

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;-----------------------------------------------------------------
;---------------------------------------------------------------------------
; イントロ（試合開始直前のアクション）
; CNS レベル: 基本
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0
poweradd = 1500

[State 191, アニメ変更] ;画面フェードインの間だけアニメーションを繰り返し、止まっているように見せています
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 特殊効果] ;「ROUND1, FIGHT!」のアナウンスが始まるまでは、このコントローラを使ってください
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態になります

[State 200 , 2]
type = PlaySnd
trigger1 = AnimElem= 2
value = s5, 3


[State 191, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0 ;common1.cns参照

;---------------------------------------------------------------------------

;-----------------------------------------------------------
; 前方ダッシュ
[Statedef 100]
Type    = S
Physics = N
Anim    = 100
Ctrl    = 0
VelSet  = 0,0
SprPriority = 1

[State 100, 移動速度]
Type = VelSet
Trigger1 = Time = 6
X = Const(Velocity.Run.Fwd.X)

[State 100, 特殊効果]
Type = AssertSpecial
Trigger1 = 1
Flag = NoWalk
Flag2 = NoAutoTurn

[State 3000, Effect]
type = Explod
trigger1 = time = 0
anim = 3500
scale = 0.5,0.5
postype = p1
pos = 0,-40
sprpriority = 4
;supermove = 1
ownpal = 1
removeongethit = 1

[State 100, 音]
Type = PlaySnd
Trigger1 = Time = 0
Value = s0,3

[State 100, ステート変更]
Type = ChangeState
Trigger1 = command = "holdup"
Trigger1 = Time > 5
Value = 40

[State 100, ステート変更]
Type = ChangeState
Trigger1 = var(59) = 0
Trigger1 = command != "holdfwd"
Trigger1 = Time > 10
Trigger2 = var(59) = 1
Trigger2 = P2BodyDist X < 80
Trigger2 = Time > 10
Trigger3 = Time > 40
Value = 101

[State 100, ステート変更]
Type = ChangeState
Trigger1 = var(59) = 0
Trigger1 = Command = "holdback"
Trigger1 = InGuardDist
Trigger2 = var(59) = 1
Trigger2 = P2MoveType = A
Trigger2 = InGuardDist
Value = 120

;---------------------------------------------------------------------------
