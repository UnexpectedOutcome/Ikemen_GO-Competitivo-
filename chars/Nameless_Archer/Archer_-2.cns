;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]

;---------------------------------------------------------------------------
[state -2];結界時BGM設定
type = varset
trigger1 = 1
var(5) = 1;1でON、0でOFF

[State a]
type = selfstate
triggerall = var(19) != gametime
trigger1 = PalNo = 11
trigger2 = PalNo = 12
value = 750
ctrl = 0

[State 1570, 3]
type = NotHitBy
triggerall = movetype = A
trigger1=PalNo=3
trigger2=PalNo=4
trigger3=PalNo=7
trigger4=PalNo=8
value = SCA

[State 1570, 3]
type = NotHitBy
trigger1=PalNo=10
value = ,AP

[state a]
type=lifeset
triggerall = roundstate <= 1
trigger1=PalNo=9
trigger2=PalNo=10
value=1

[state a]
type=selfstate
triggerall=PalNo=12
triggerall=alive=0
trigger1=1
value=200

[state a]
type=lifeset
trigger1=PalNo=12
value=lifemax
ignorehitpause=1

[state a];アーマー用ヘルパー
type = Helper
triggerall = numhelper(30037) = 0
trigger1 = PalNo = 12 
id = 30037
name = "リアリティ・マーブル"
sprpriority = -999999
pos = 0,0
postype = left
stateno = 30037
helpertype = normal
pausemovetime = 9999999
bindtime = -1
Size.XScale = 1000
Size.YScale = 1000
keyctrl = 0 
ownpal = 1

[State 810, 掴んだ相手の体力ゲージの増減]
type = TargetLifeAdd
trigger1 = PalNo = 11
trigger2 = PalNo = 12 
value = -9999999999999
absolute = 1

[state a]
type = nothitby
trigger1 = PalNo = 11
trigger2 = PalNo = 12 
value = sca

[state a];アーマー用ヘルパー
type = Helper
triggerall = numhelper(37) = 0
trigger1 = PalNo = 11
trigger2 = PalNo = 12 
id = 37
name = "アーマー"
sprpriority = -3
pos = 0,0
postype = p1
stateno = 38
helpertype = normal
pausemovetime = 0
bindtime = -1
keyctrl = 0 
ownpal = 1

[state a]
type=lifeadd
trigger1=1
value=-var(29)
ignorehitpause=1

