;===========================================================================
; 準常時監視ステート（－３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

;■着地音設定
[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ後の着地
trigger2 = stateno = 106 ;バックステップ後の着地
value = s100, 1
volume=-255

;■キャラサイズ設定
[State ];Const(size.xscale)値セット
type = Varset
trigger1 = roundstate=0
fvar(32) = Const(size.xscale)*2

[State ];Const(size.yscale)値セット
type = Varset
trigger1 = roundstate=0
fvar(33) = Const(size.yscale)*2

;■タッチゲージ値セット
[State ]
type = Varset
trigger1 = roundstate = 0
var(28) = 720

;■パートナーキャラセット　縁寿
[State -2]
type = Varset
trigger1 = roundstate <= 1
v = 57
value = 1

;■ラウンドスタート時音声消す
[State ]
type = VarSet
trigger1 = RoundState <= 1&&var(2) = 0
var(2) = 1 

[State  ]
type = StopSnd
trigger1 = RoundState = 2&&var(2) = 1
channel = 0

[State ]
type = VarSet
trigger1 = RoundState = 2&&var(2) = 1
var(2) = 0

;■ラウンド開始時ゲージ類表示制御
[State ]
type=Varset
trigger1=var(5)=0&&RoundState>=2
var(5)=1

;ハイジャンプ
[State ]
type=varset
trigger1=command="holddown"&&time>=5
var(12)=1

[State ]
type=varset
trigger1=var(12)!=1&&ctrl&&statetype!=A&&(command="HJump"||(prevstateno=100&&command="holdup"))
var(11)=1

[State ]
type=varset
trigger1=(var(12)=1&&command="HJump")||movetype=H||movetype=A||stateno=52
var(12)=0

[State ]
type=varset
trigger1=stateno=50&&time=2
var(11)=0

[State ]
type=veladd
trigger1=var(11)=1&&stateno=50
y=-1

[State ]
type=veladd
trigger1=var(11)=1&&stateno=50&&command="holdfwd"
x=.7

[State ]
type=veladd
trigger1=var(11)=1&&stateno=50&&command="holdback"
x=-.7
