;■ダメージ音声
[State -1, VarRandom]
Type = VarRandom
TriggerAll = Time = 1
Trigger1 = StateNo = 5000
Trigger2 = StateNo = 5010
Trigger3 = StateNo = 5020
Trigger4 = StateNo = 5070
Trigger5 = StateNo = 5120
V = 0
Range = 0,16
IgnoreHitPause = 1

[State -2, 喰らい1]
Type = PlaySnd
TriggerAll = Time = 1
TriggerAll = alive
Trigger1 = StateNo = 5000
Trigger2 = StateNo = 5010
Trigger3 = StateNo = 5020
Trigger4 = StateNo = 5070
Value = s2,var(0)
Channel = 0
volume=255

;■起き上がり音声

[State -1, VarRandom]
Type = VarRandom
TriggerAll = Time = 1
Trigger1 = StateNo = 5120
V = 0
Range = 4,5
IgnoreHitPause = 1

[State -2,起き上がり1]
type = PlaySnd
Trigger1 = stateno = 5120
Trigger1 = time =1
Value = s3,var(0)
Channel = 1
Volume=255

[state ];気絶ボイス
type=PlaySnd
trigger1=anim=5300&&animelem=1
value=s2,4+(Random%2)*4
channel=0
