;■debug用
[State -2, デバック]
type = DisplayToClipboard
trigger1 = 1
text =  "___________________________________var(16),%d,var(17),%d,fvar(1),%f,var(19),%d,var(46),%d\n"
params = var(16),var(17),fvar(1),var(19),var(46)
IgnoreHitPause = 1

[State -2, 距離確認デバック]
type = null;AppendToClipboard
trigger1 = 1
text =  "____________________________________P2X:%f,P2Y:%f,Vx%f,Vy%f,Py%f \n"
params = p2bodydist x, p2bodydist y,vel x,vel y,Pos y
IgnoreHitPause = 1

;■常時起動用ヘルパー

[State ];常時起動用ヘルパー
