[Statedef -2]

[State 0, RemapPal]
type = RemapPal
trigger1 = var(2) = 0
source = 1,1
dest = 1,1

[State 0, RemapPal]
type = RemapPal
trigger1 = var(2) = 1
source = 1,1
dest = 1,2

[State 0, Run]
type = ChangeState
triggerall = var(3) = 0
triggerall = stateno != 2060
triggerall = stateno != 2070
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/2
value = 2060

[State 0, Run Atras]
type = ChangeState
triggerall = var(3) = 0
