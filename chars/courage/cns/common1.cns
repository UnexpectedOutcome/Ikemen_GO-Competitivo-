trigger1 = (movecontact) && p2dist x < 30
value = 640

[State 8, 0]
type = ChangeState
triggerall = var(59)
trigger1 = (movecontact) && p2dist x < 30
value = 650

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 5]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno = 45
value = 48

