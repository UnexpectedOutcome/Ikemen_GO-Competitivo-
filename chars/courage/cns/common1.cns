movetype= I
physics = A
anim = 1400
sprpriority = 1

[State 1400, Ctrl]
type = CtrlSet
trigger1 = prevstateno = 4100
value = 0

[State 1400, Ctrl]
type = CtrlSet
triggerall = prevstateno != 4100
trigger1 = Var(12) = 0
value = 0

[State 1400, Ctrl]
type = CtrlSet
triggerall = prevstateno != 4100
trigger1 = Var(12) = 1
value = 1

[State 1400, Turn]
type = Turn
trigger1 = P2Dist X < -5

[State 1400, VelSet]
type = VelSet
trigger1 = FrontEdgeBodyDist <= 0
x = 0

[State 1400, ChangeState]
type = ChangeState
trigger1 = (Pos Y >= 0) && (Vel Y > 0)
value = 52

