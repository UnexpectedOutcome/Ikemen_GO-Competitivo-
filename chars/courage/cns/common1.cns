v = 2
value = 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = var(10) = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 8, 0]
type = ChangeState
triggerall = var(59)
trigger1 = (movecontact) && p2dist x < 30
value = 600

[State 8, 0]
type = ChangeState
triggerall = var(59)
trigger1 = (movecontact) && p2dist x < 30
value = 610

[State 8, 0]
type = ChangeState
