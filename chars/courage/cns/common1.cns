trigger1 = time = 60
value = 304
ctrl = 1

;-------------------------------------------------------------------------------
; P2 descongelado
[StateDef 304]
type    = U
MoveType = H
physics = U
ctrl = 0
VelSet = 0,0
sprpriority = 0

[State 304, 1]
type = PosSet
trigger1 = time = 0
y = 0

[State 304, 2]
type = SelfState
trigger1 = (time = 5) && (PrevStateNo = 305)
value = 5100

[State 304, 3]
type = SelfState
trigger1 = (time = 5) && (PrevStateNo != 305)
value = 0
ctrl = 1

;-------------------------------------------------------------------------------
; P2 frozen in midair
[StateDef 305]
type    = A
MoveType = H
physics = N
ctrl = 0
VelSet = 0,0

[State 305, 0]
type = VelSet
trigger1 = time = 10
x = -3
y = 2

[State 305, 1]
type = VelSet
trigger1 = time = 20
x = -3
y = 5

[State 305, 2]
type = ChangeAnim
trigger1 = (time = 0) && (AnimExist(7991))
value = 7991

[State 305, 3]
type = ChangeAnim2
trigger1 = (time = 0) && (!AnimExist(7991))
ctrl = 0
value = 305

[State 305, 4]
type = ChangeState
trigger1 = (pos y >= 10)
value = 304
;-------------------------------------------------------------
;f starter
[Statedef 7021]
type    = A
movetype= A
physics = N
velset = 0,0
anim = 7019
ctrl = 0
sprpriority = 3

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = unguardable

[State grabby]
type = HitDef
Trigger1 = !movecontact
trigger2 = enemynear,stateno != 7022 && enemynear,stateno != 5120 && enemynear,stateno != 5110
triggerall = enemynear, alive = 1  && !enemynear,pos Y  && enemynear,stateno != 5110 && enemynear,stateno != 70210 && enemynear,stateno != 5120
attr = S, NA
hitflag = MAFD
sparkno = -1
fall = 1
p2stateno = ifelse(p2statetype = L,ifelse(!enemynear,pos Y,70210,5050),7022)
numhits = 0

[State targetLifeAdd]
type = TargetLifeAdd
trigger1 = movehit
value = -9999
kill = 0

[State 0, cambio]
type = ChangeState
;triggerall = (enemynear,authorname = "juano16" && !fvar(15)) || enemynear,authorname != "juano16"
trigger1 = movecontact && p2stateno = 7022
value = 7023
ctrl = 0

[State ]
type = posset
trigger1 = 1
x = floor(enemynear,pos x)
y = floor(enemynear,pos y)

[State end]
type = destroyself
;trigger1 = !animtime && p2stateno = 7022
;trigger1 = enemynear,ctrl = 0
trigger1 = time >= 300


