; introduction cutscene for Courage's story.

[SceneDef]
spr = intro.sff       ;Filename of sprite file to use

[Scene 0]
; Fade parameters
fadein.time = 30       ;30 ticks (0.5 seconds) for fade-in
fadeout.time = 30      ;30 ticks for fade-out
; Layers
layerall.pos = 319,239 ;Default position for all layers
layer0.anim =  0       ;Anim action number to show
layer0.xscale = 0.6
layer0.yscale = 0.6
; music
bgm = Courage the cowardly dog- music theme.mp3        ;name of music file to play
bgm.loop = 1
; Total time
end.time = 150         ;300 ticks = 5 seconds

;Animation to use
[Begin Action 0]
0,0, 0,0, -1

