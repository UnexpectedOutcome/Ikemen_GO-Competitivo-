;Persistent = 0

;***********************************
[State 3000, 無敵]
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 15

[State 3000, 物理的なキャラの幅]
type = Width
trigger1 = (AnimElemTime(4) >= 0) && (AnimElemTime(16) < 0)
player = 40,0
edge = 55,0

[State 3000, 軸位置]
type = PosSet
trigger1 = 1
y = 0

;***********************************
[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 2,13

[State 3000, 音を鳴らす]
type = PlaySnd
triggerall = AnimElemTime(3) = 0
trigger1 = var(28) = [1,80]
value = 5,3

[State 3000, 音を鳴らす]
type = PlaySnd
triggerall = AnimElemTime(3) = 0
trigger1 = var(28) = [81,120]
value = 5,4

[State 3000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElemTime(12) = 0
value = 1,12

;***********************************
[State 3000, ヘルパーを出す];気弾の発射
type = Projectile
triggerall = (Anim = 2000)
trigger1 = AnimElem = 10
attr             = S, SP
damage           = 35,7
getpower         = 0
animtype	= back
air.animtype	= back
pausetime        = 0,12
;-----------------------------------
offset           = 35,-35
velocity         = 6,-1
accel            = 0,0
projID           = 1000
projanim         = ifelse((var(28) = [1,17]),3000,ifelse((var(28) = [18,34]),3001,ifelse((var(28) = [35,51]),3002,ifelse((var(28) = [52,69]),3003,ifelse((var(28) = [70,84]),3004,ifelse((var(28) = [85,102]),3005,3006))))))
projscale        = .8,.8
projshadow       = 0,0,0
projhits         = 3
projmisstime     = 2
projpriority     = 1
projremovetime   = -1
projsprpriority  = 1
;-----------------------------------
HitFlag		= MAFP
guardflag        = MA
priority         = 3
sparkno          = s(var(45))
sparkxy          = 30,0
guard.sparkno    = s4216
hitsound         = s2,9
guardsound       = s0,10
ground.type      = High
ground.slidetime = 16
ground.hittime   = 19
ground.velocity	= -4,-6
guard.velocity	= -14.90625
air.velocity	= -4,-6
air.juggle       = 5
air.fall	= 1
ground.cornerpush.veloff= 0
guard.cornerpush.veloff	= 0
air.cornerpush.veloff	= 0
yaccel		= .5
fall		= 1
fall.recovertime= 25
fall.recover	= 0

