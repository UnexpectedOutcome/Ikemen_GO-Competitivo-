;===========================================================================
; スーパーアーツ
;===========================================================================
;幻影ひこにゃん
[Statedef 3000]
type     = S
movetype = A
physics  = N
ctrl     = 0
anim     = 2000
velset   = 0,0

;***********************************
[State 3000, 超必殺技暗転時間停止]
type = SuperPause
trigger1 = Time = 1
anim = -1
pos = 0,0
sound = s4,0
time = 50
;movetime = 0
darken = 1
poweradd = -1000
;p2defmul = 1.0
;unhittable = 1 

[State 3000, ヘルパーを出す]
type = Helper
triggerall = NumHelper(2300) = 0
trigger1 = Time = 1
name = "SuperArts"
stateno = 2300
ID = 2300
pos = -15,-30
keyctrl = 0
postype = p1
supermovetime = 99999999
pausemovetime = 99999999
ownpal = 0
IgnoreHitPause = 1
Persistent = 0

[State 3000, カットイン]
type = Explod
trigger1 = Time = 0
anim = 3900
postype = Back
pos = 0,0
supermovetime = 99999999
pausemovetime = 99999999
scale = 0.5,0.5
sprpriority = 4
ownpal = 1
IgnoreHitPause = 1
Persistent = 0
ID = 3900

;[State 3000, ヘルパーを出す];スーパーアーツフィニッシュ
;type = Helper
