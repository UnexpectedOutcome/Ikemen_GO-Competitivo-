;イントロ（試合開始前の登場演出アクション）
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0
sprpriority = -1

[State 190, 特殊効果];試合が開始するまではこのコントローラを使おう
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態

[State 190, ステート変更]
type = ChangeState
trigger1 = (Time > 180)
value = 0

[State 190, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
trigger2 = AnimElem = 5
trigger3 = AnimElem = 9
value = 1,6

[State 190, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 17
value = 2,13

