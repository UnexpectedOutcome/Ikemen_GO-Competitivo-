;IgnoreHitPause = 1

[State -2, コントロール]
type = CtrlSet
trigger1 = (PrevStateNo = 1008) && (StateNo = 0)
value = 1
IgnoreHitPause = 1

[State -2, スーパージャンプ用]
type = VelAdd
triggerall = (var(54) = 1) && (var(55) != 0)
trigger1 = (StateNo = 50) && (Time > 0)
x = var(55)*0.08
IgnoreHitPause = 1

[State -2, スーパージャンプ用]
type = Turn
triggerall = (var(54) = 1)
trigger1 = (StateNo = 50) && (P2Dist X < 0)

[State -2, 崩れＫＯ]
type = ChangeState
trigger1 = (PrevStateNo = [120,131]) || (PrevStateNo = [150,153])
trigger1 = (StateNo = 5000) || (StateNo = 5010)
trigger1 = (!Alive) || (Life <= 0) || (Lose)
value = 10004
IgnoreHitPause = 1

;---------------------------------------------------------------------------
[State -2, くらいポーズの声] 
type = VarSet
triggerall = time = 1
trigger1 = stateno = 5000
trigger2 = stateno = 5020
trigger3 = stateno = 5035
trigger4 = stateno = 5070
trigger5 = stateno = 5081
trigger6 = stateno = 5010
v = 4
value = 1

[State -2, くらいポーズの声]
type = VarAdd
trigger1 = var(4) = 1
v = 5
value = 1

[State -2, くらいポーズの声]
type = VarSet
trigger1 = time = 2
trigger1 = var(5) = 4
v = 5 
value = 0 

[State -2, くらいポーズの声];１
type = PlaySnd
trigger1 = var(4) = 1
trigger1 = var(5) = 1
value = 1,7

[State -2, くらいポーズの声];２
type = PlaySnd
trigger1 = var(4) = 1
trigger1 = var(5) = 2
value = 1,8

[State -2,くらいポーズの声];３
type = PlaySnd
trigger1 = var(4) = 1
trigger1 = var(5) = 3
value = 1,9

[State -2,くらいポーズの声];４
type = PlaySnd
trigger1 = var(4) = 1
trigger1 = var(5) = 4
value = 1,10

[State -2,くらいポーズの声]
type = VarSet
trigger1 = var(4) = 1
v = 4
value =0 

;---------------------------------------------------------------------------
; ヘルパー
;---------------------------------------------------------------------------
[State -2, ヘルパーを出す];ゲージ類
type = Helper
triggerall = (RoundState < 3) && (NumEnemy != 0)
trigger1 = (NumHelper(30000) = 0)
name = "Sub-Gauge"
stateno = 30000
ID = 30000
pos = 0,100
keyctrl = 0
postype = p1
ownpal = 1
IgnoreHitPause = 1
Persistent = 0

[State -2, ヘルパーを出す];アナウンス表示
type = Helper
triggerall = (NumEnemy != 0)
triggerall = (NumHelper(31000) = 0)
triggerall = (StateNo != [700,701])
trigger1 = (var(14) = 1) && (var(35) <= 0)
trigger1 = (MoveHit) || (ProjHit = 1,<2)
trigger2 = (var(15) = [1,2]) && (EnemyNear,MoveType = H)
trigger2 = (MoveHit) || (ProjHit = 1,<2)
trigger3 = (var(15) = [1,2]) && (EnemyNear,MoveType = H)
trigger3 = (EnemyNear,GetHitVar(IsBound))
name = "Announce"
stateno = 31000
ID = 31000
pos = 0,1000
keyctrl = 0
postype = p1
supermovetime = 99999999
pausemovetime = 99999999
ownpal = 1
IgnoreHitPause = 1

;===========================================================================
;---------------------------------------------------------------------------
; クリップボード
;---------------------------------------------------------------------------
[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
text = "AI=%d, Button=%d, Player=%d, Blocking=%d,%d \n"
params = var(0),var(53),var(33),var(56),var(57)
IgnoreHitPause = 1

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "BG=%d, O.C.=%d, Tengu=%d, Denjin=%d,%d"
params = var(18),var(35),var(34),var(25),var(26)
IgnoreHitPause = 1

