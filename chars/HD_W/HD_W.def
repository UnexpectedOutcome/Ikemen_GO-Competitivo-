; Definition file for Meguca
; Contains all the filenames needed for the character



;To prevent bugs, make a dummy 5th timelime be a clone of 4th timeline
	;In other words - All of the 5th timeline helpers should be copied and pasted as 5th timeline helpers.


; Player information
[Info]
name = "Homura did Something"        ;Name of character
displayname = "Homura Did (interpretation) Wrong" ;Name of character to display
versiondate = 07,19,2017    ;Version date of character (MM-DD-YYYY or X.XX) ;Production started on 06,25,2017
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Brergrsart"         ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
cmd     = HD_W.cmd           ;Command set
cns     = HD_W.cns           ;Constants
st      = HD_W.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = HD_W.sff           ;Sprite
anim    = HD_W.air           ;Animation
sound   = HD_W.snd           ;Sound
ai      = HD_W.ai            ;AI hints data (not used)

; Maps character selection buttons to palette numbers.
[Palette Keymap]
a = 1 ;Press button X to select palette 1, etc.
b = 2
c = 3
x = 4
y = 5
z = 6
a2 = 7  ;Reverse order (No Godoka, start from 4th)
b2 = 8  ;Perma 1nd timeline
c2 = 9  ;Perma 2rd timeline
x2 = 10 ;Perma 3th timeline 
y2 = 11 ;Perma 4th timeline
z2 = 12 ;Perma 5th timeline

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
