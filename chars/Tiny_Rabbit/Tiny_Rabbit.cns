ignorehitpause = 1
;=========================================================================
;▲現在状態格納
[state -2,ゲージ]
type = varset
trigger1 = stateno !=150
trigger1 = stateno !=152
trigger1 = stateno !=154
trigger1 = stateno !=5000
trigger2 = time > 1
v = 9
value = power
;====================================================================================
;▲アーマー処理
[State -2,アーマーダメージ]
type = Lifeadd
triggerall = numhelper(26000) > 0
trigger1 = helper(26000),stateno = 26100
value = ceil(-1*(helper(26000),GetHitVar(damage)))
absolute = 1
ignorehitpause = 1

[State -2,アーマー時死亡] 
type = ChangeState
triggerall = numhelper(26000) > 0
trigger1 = !alive
trigger1 = Statetype = S
trigger1 = Stateno = [5000,5050]
value = 5950

[State -2,アーマーパレット]
type = Palfx
trigger1 = numhelper(26000)
trigger1 = helper(26000),stateno = 26100
time = 6
add = 250,30,30
sinadd = -100,-30,-30,24
ignorehitpause = 1
;====================================================================================
;▲追撃ジャンプ処理
[State -2,前方加速]
type = Veladd
triggerall = Statetype = A
triggerall = var(11) = 1
triggerall = pos y < -50
triggerall = vel x < 6
trigger1 = var(59) <=1
trigger1 = command ="holdfwd"
x = 0.2

[State -2,後方加速]
type = Veladd
triggerall = Statetype = A
triggerall = var(11) = 1
triggerall = pos y < -50
