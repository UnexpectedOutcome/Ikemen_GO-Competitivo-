;====================================================================================
;====================================================================================
;▲先行入力処理
[state -2,リセットvar(2)]
type = varset
;ctrl状態で入力時間から5フレーム経過したら
triggerall = var(2) > 500
trigger1 = ctrl
trigger1 = gametime - var(3) > 5
;ctrl状態でないときは、入力時間から12フレーム経過したら
trigger2 = stateno != 5120
trigger2 = ctrl = 0
trigger2 = gametime - var(3) > 12
;起き上がりとのときは、入力時間から25フレーム経過したら
trigger3 = stateno = 5120
trigger3 = gametime - var(3) > 25
v = 2
value = 0
ignorehitpause = 1
pausemovetime = 9999
supermovetime = 9999

[state -2,リセットvar(3)]
type = varset
;ctrl状態で入力時間から5フレーム経過したら
trigger1 = gametime - var(3) > 5
trigger1 = ctrl
;ctrl状態でないときは、入力時間から12フレーム経過したら
trigger2 = stateno != 5120
trigger2 = gametime - var(3) > 12
trigger2 = ctrl = 0
;起き上がりとのときは、入力時間から25フレーム経過したら
trigger3 = stateno = 5120
trigger3 = gametime - var(3) > 25
v = 3
value = 0
ignorehitpause = 1
pausemovetime = 9999
supermovetime = 9999

