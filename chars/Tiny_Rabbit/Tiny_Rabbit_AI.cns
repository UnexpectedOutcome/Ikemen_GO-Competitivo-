[statedef -3]
;============================================================================================================================================================
;============================================================================================================================================================
;============================================================================================================================================================
;●●●AIスイッチ
;============================================================================================================================================================
;============================================================================================================================================================
;============================================================================================================================================================
[State -3,◆常時AI]
type = Varset
trigger1 = roundstate < 1
trigger1 = var(59) = 0
v = 59
value = 0
ignorehitpause = 1

;0=操作モード
;1=コンボのみ全自動 AIのコンボテスト用
;2=AIモード 全自動行動
;デフォルトは0
;============================================================================================================================================================
;============================================================================================================================================================
;============================================================================================================================================================
;●●●AIコンフィグ
;============================================================================================================================================================
;============================================================================================================================================================
;============================================================================================================================================================
[State -3,◆AIレベル]
type = Varset
trigger1 = roundstate < 2
v = 57
value = 2

;valueを1～6で指定
;Lv1～3は対人戦を想定しています。
;超反応のカウンターを行いません。
;キャンセルや事前入力できない状況で必殺技を出すとき、方向キー入力っぽい動きをします。
;ガードやコンボのヒット確認が甘かったり、中段攻撃を多用したりします。

;Lv4～6は対AI戦を想定しています。
;現状では超反応カウンターの条件や頻度しかLv差はありません。
;============================================================================================================================================================
;============================================================================================================================================================
;============================================================================================================================================================
;●●●var管理統合
;============================================================================================================================================================
;============================================================================================================================================================
;============================================================================================================================================================
;敵が始めてのラウンドのときに学習内容をリセット
[State -3,学習内容リセットfvar(14)-fvar(39)]
type = VarRangeSet
trigger1 = RoundState <= 1
trigger1 = numenemy
trigger1 = enemy,RoundsExisted = 0
fvalue = 0
first = 14
last = 39

;敵が始めてのラウンドのときに学習内容をリセット
[State -3,学習内容リセットvar(41)-var(41)]
type = VarRangeSet
trigger1 = RoundState <= 1
trigger1 = numenemy
trigger1 = enemy,RoundsExisted = 0
value = 0
first = 41
last = 42

[State -3,一撃狙いたいフラグシングル];自分がラウンドをとっていないときは温存したい
type = Varset
triggerall = alive && roundstate >= 2
triggerall = (teammode = single)||(teammode = simul)
triggerall = numenemy = 1
triggerall = (stateno=500)||(stateno=520)||(stateno=530)||(stateno=550)||(stateno=572)||(stateno=560)||(stateno=600)||(stateno=650)||(stateno=810)
triggerall = numtarget
triggerall = (target,stateno = [5000,5101])||(target,stateno = 580)||(target,stateno = [880,885])
triggerall = (movehit = 1)||(target,stateno = [880,885])
;ラウンドをとっている
trigger1 = fvar(13) > 0
;自分の体力が相手より3割以上少ない
trigger2 = (100*(target,life)/(target,const(data.life)))-(100*life/const(data.life))>30
;自分が死にかけていて、相手をこのコンボで倒せそうにない
trigger3 = (100*life/const(data.life)) < 30
trigger3 = target,life > 100
fv = 10
value = 1
ignorehitpause = 1

[State -3,一撃狙いたいフラグチーム];体力を削られないうちに使ってしまうのもよし
type = Varset
triggerall = alive && roundstate >= 2
triggerall = (teammode = turns)
triggerall = numenemy
triggerall = (stateno=500)||(stateno=520)||(stateno=530)||(stateno=550)||(stateno=572)||(stateno=560)||(stateno=600)||(stateno=650)||(stateno=810)
triggerall = numtarget
triggerall = (target,stateno = [5000,5101])||(target,stateno = 580)||(target,stateno = [880,885])
triggerall = (movehit = 1)||(target,stateno = [880,885])
;ラウンドをとっている
trigger1 = fvar(13) > 0
;自分が死にかけていて、相手をこのコンボで倒せそうにない
trigger2 = (100*life/const(data.life)) < 30
trigger2 = target,life > 100
;相手の体力が4割以上
trigger3 = (100*target,life)/(target,const(data.life))>40
;自分の体力と相手の体力の割合差が3割以下
trigger4 = (100*life/const(data.life))-(100*(target,life)/(target,const(data.life)))<30
fv = 10
value = 1
ignorehitpause = 1

[State -3,一撃狙いたいフラグタッグ];相手が何人残っているか、味方が生きているか
type = Varset
triggerall = alive && roundstate >= 2
triggerall = (teammode = single)||(teammode = simul)
triggerall = numenemy >= 2
triggerall = (stateno=500)||(stateno=520)||(stateno=530)||(stateno=550)||(stateno=572)||(stateno=560)||(stateno=600)||(stateno=650)||(stateno=810)
triggerall = numtarget
triggerall = (target,stateno = [5000,5101])||(target,stateno = 580)||(target,stateno = [880,885])
triggerall = target,alive
triggerall = (movehit = 1)||(target,stateno = [880,885])
;ラウンドをとっていて、敵が片方倒れている
trigger1 = fvar(13) > 0
trigger1 = (enemy(0),alive = 0)||(enemy(1),alive = 0)
;ラウンドをとっていて、味方が生きており、このコンボではターゲットを倒せそうにない
trigger2 = numpartner
trigger2 = partner,life > 200
trigger2 = (100*life/const(data.life)) > 30
trigger2 = partner,movetype != H
trigger2 = target,life > 100
;ラウンドをとっていて、味方が倒れており、残った相手より体力的に勝っている
trigger3 = numpartner
trigger3 = partner,alive = 0
trigger3 = target,life > 100
trigger3 = life > ifelse((target,ID)=(enemy(0),ID),(enemy(1),life),(enemy(0),life))
;ラウンドをとっておらず、2ラウンド目で、敵が両方生きていて、倒せそうにない
trigger4 = fvar(13) = 0
trigger4 = roundno >= 2
trigger4 = enemy(0),alive && enemy(1),alive
trigger4 = target,life > 100
;ラウンドをとっておらず、2ラウンド目で、敵が片方倒れており、味方は倒れている。自分が倒れそうか、体力差が小さい
trigger5 = fvar(13) = 0
trigger5 = roundno >= 2
trigger5 = (enemy(0),alive = 0) || (enemy(1),alive = 0)
trigger5 = numpartner
trigger5 = partner,alive = 0
trigger5 = target,life > 100
trigger5 = ((100*life/const(data.life)) < 30)||((100*life/const(data.life))-(100*(target,life)/(target,const(data.life)))<30)
;ラウンド3である
trigger6 = roundno = 3
trigger6 = (enemy(0),alive = 0)||(enemy(1),alive = 0)||(target,life > 100)
fv = 10
value = 1
ignorehitpause = 1

[State -3,一撃狙いたいフラグリセット]
type = Varset
triggerall = fvar(10) != 0
triggerall = stateno != 810
trigger1 = var(4) = 0
fv = 10
value = 0

[State -3,ブロッキングされた回数0]
type = Varadd
triggerall = fvar(9)>0
triggerall = movehit = 1
triggerall = numtarget = 0
triggerall = numenemy
triggerall = enemy(0),life >= fvar(9)
trigger1 = numenemy = 1
trigger2 = numenemy >=2
trigger2 = enemy(0),alive = 1 && enemy(1),alive = 0
trigger3 = numenemy >=2
trigger3 = fvar(3) > 0 && fvar(4) < 0
trigger4 = numenemy >=2
trigger4 = fvar(3) > 0 && fvar(4) > 0 && fvar(3)<fvar(4)
fv = 26
value = 1

[State -3,ブロッキングされた回数1]
type = Varadd
triggerall = fvar(9)>0
triggerall = movehit = 1
triggerall = numtarget = 0
triggerall = numenemy >=2
triggerall = enemy(1),life >= fvar(9)
trigger1 = enemy(1),alive = 1 && enemy(0),alive = 0
trigger2 = fvar(4) > 0 && fvar(3) < 0
trigger3 = fvar(3) > 0 && fvar(4) > 0 && fvar(4)<fvar(3)
fv = 26
value = 1

[State -3,対空ブロッキングされた回数0]
type = Varadd
triggerall = fvar(9)>0
triggerall = movehit = 1
triggerall = numtarget = 0
triggerall = numenemy
triggerall = enemy(0),life >= fvar(9)
triggerall = enemy(0),statetype = A
triggerall = stateno = 500 || stateno = 660
trigger1 = numenemy = 1
trigger2 = numenemy >=2
trigger2 = enemy(0),alive = 1 && enemy(1),alive = 0
trigger3 = numenemy >=2
trigger3 = fvar(3) > 0 && fvar(4) < 0
trigger4 = numenemy >=2
trigger4 = fvar(3) > 0 && fvar(4) > 0 && fvar(3)<fvar(4)
fv = 25
value = 5

[State -3,対空ブロッキングされた回数1]
type = Varadd
triggerall = fvar(9)>0
triggerall = movehit = 1
triggerall = numtarget = 0
triggerall = numenemy >=2
triggerall = enemy(1),life >= fvar(9)
triggerall = enemy(1),statetype = A
triggerall = stateno = 500 || stateno = 660
trigger1 = enemy(1),alive = 1 && enemy(0),alive = 0
trigger2 = fvar(4) > 0 && fvar(3) < 0
trigger3 = fvar(3) > 0 && fvar(4) > 0 && fvar(4)<fvar(3)
fv = 25
value = 5

[State -3,前方近くにいる敵IDe0]
type = Varset
trigger1 = numenemy = 1
trigger2 = numenemy >= 2
trigger2 = enemy(0),alive
trigger2 = fvar(3) > 0
trigger2 = enemy(1),alive = 0 || fvar(4)<0 || fvar(3)<fvar(4)
v = 40
value = enemy(0),ID
ignorehitpause = 1

[State -3,前方近くにいる敵IDe1]
type = Varset
trigger1 = numenemy >= 2
trigger1 = enemy(1),alive
trigger1 = fvar(4) > 0
trigger1 = enemy(0),alive = 0 || fvar(3)<0 || fvar(4)<fvar(3)
v = 40
value = enemy(1),ID
ignorehitpause = 1

[State -3,SLP空振りフラグ]
type = Varadd
triggerall = stateno = 500
trigger1 = numtarget > 0
trigger1 = numtarget(500) = 0
trigger1 = target,statetype = S
trigger1 = animelemtime(5) = 0
trigger1 = p2bodydist x < 35
fv = 27
value = 1

[State -3,投げ空振りフラグ]
type = Varadd
triggerall = stateno = 801
trigger1 = animelemtime(4) = 0
trigger1 = numtarget = 0
trigger1 = p2dist x >0
trigger1 = p2bodydist x <= 38
trigger1 = p2statetype = S || p2statetype = C
v = 41
value = 1

[State -3,敵移動起き上がりフラグ]
type = Varset
triggerall = fvar(24) = 0
trigger1 = numenemy
trigger1 = enemy,stateno = 5120
trigger1 = enemy,vel x !=0
fv = 24
value = 1

[State -3,グレートボム拾い開始フラグ]
type = Varset
triggerall = stateno = 2100
triggerall = time = 0
trigger1 = numtarget(2200)
trigger1 = (target,backedgebodydist < 5)||ifelse(facing = 1,(helper(25000),var(13)),(helper(25000),var(14))) < 100
trigger2 = numtarget(1500)
trigger2 = target(1500),pos y < -5
trigger2 = (target,backedgebodydist < 5)||ifelse(facing = 1,(helper(25000),var(13)),(helper(25000),var(14))) < 100
v = 42
value = 1

[State -3,グレートボム拾い失敗]
type = Varset
triggerall = stateno = 2100
triggerall = anim = 2100
triggerall = animelemtime(14) = 5
triggerall = var(42) = 1
trigger1 = numhelper(2100)
trigger1 = helper(2100),numtarget = 0
v = 42
value = 2

[State -3,グレートボム拾いフラグリセット]
type = Varset
triggerall = stateno = 2100
triggerall = vel y < 0
triggerall = var(42) = 1
trigger1 = numhelper(2100)
trigger1 = helper(2100),numtarget
v = 42
value = 0

[State -3,キャンセルティーパーティーフラグ開始]
type = Varset
triggerall = stateno = 2300
triggerall = time = 0
trigger1 = (prevstateno = 530)||(prevstateno = 560)
v = 43
value = 1

[State -3,キャンセルティーパーティー失敗]
type = Varset
triggerall = var(43) = 1
trigger1 = stateno = 2300
trigger1 = anim = 2300
trigger1 = animelemtime(11) = 0
trigger2 = stateno = 5000 ||stateno = 5010 ||stateno = 5070
trigger2 = time = 0
v = 43
value = 2
ignorehitpause = 1

[State -3,グレートボム拾いフラグリセット]
type = Varset
triggerall = stateno = 2310
trigger1 = var(43) = 1
v = 43
value = 0

[State -3,ハンガーミサイル飛び降り方向リセット]
type = Varset
trigger1 = stateno != [11550,11561]
trigger1 = stateno != [1500,1560]
trigger1 = var(44) != 0
v = 44
value = 0

[State -3,Lv3以下ジャンプ攻撃ヒットフラグ]
type = Varset
triggerall = stateno = [700,780]
trigger1 = movehit
trigger1 = numtarget
trigger1 = target,statetype != A
fv = 12
value = 1
ignorehitpause = 1

[State -3,Lv3以下ジャンプ攻撃ヒットフラグリセット]
type = Varset
triggerall = fvar(12) != 0
trigger1 = numtarget = 0
trigger2 = var(4) = 0
fv = 12
value = 0
ignorehitpause = 1

[State -3,タッグ用勝利フラグ];自分が倒れていたら勝利ポーズをとれないため
type = Varadd
triggerall = (teammode = simul)
triggerall = win
trigger1 = fvar(13) = 0
fv = 13
value = 1

[State -3,学習シングル地上7F]
type = Varset
triggerall = numenemy = 1
triggerall = stateno = 150 || stateno = 152 ||stateno = 5000 ||stateno = 5010 ||stateno = 5070
triggerall = time = 0
triggerall = enemy(0),HitDefAttr = SC,NA,SA
triggerall = enemy(0),HitCount <2
triggerall = prevstateno !=[130,155]
trigger1 = enemy(0),time = [7,30]
fv = ifelse(fvar(14)=0,14,(ifelse(fvar(15)=0,15,(ifelse(fvar(16)=0,16,(ifelse(fvar(17)=0,17,(ifelse(fvar(18)=0,18,19)))))))))
value = enemy(0),stateno
ignorehitpause = 1

[State -3,学習タッグ地上0_7F]
type = Varset
triggerall = numenemy >= 2
triggerall = enemy(1),alive = 0
triggerall = stateno = 150 || stateno = 152 ||stateno = 5000 ||stateno = 5010 ||stateno = 5070
triggerall = time = 0
triggerall = enemy(0),HitDefAttr = SC,NA,SA
triggerall = enemy(0),HitCount <2
triggerall = prevstateno !=[130,155]
trigger1 = enemy(0),time = [7,30]
fv = ifelse(fvar(14)=0,14,(ifelse(fvar(15)=0,15,16)))
value = enemy(0),stateno
ignorehitpause = 1

[State -3,学習タッグ地上1_7F]
type = Varset
triggerall = numenemy >= 2
triggerall = enemy(0),alive = 0
triggerall = stateno = 150 || stateno = 152 ||stateno = 5000 ||stateno = 5010 ||stateno = 5070
triggerall = time = 0
triggerall = enemy(1),HitDefAttr = SC,NA,SA
triggerall = enemy(1),HitCount <2
triggerall = prevstateno !=[130,155]
trigger1 = enemy(1),time = [7,30]
fv = ifelse(fvar(17)=0,17,(ifelse(fvar(18)=0,18,19)))
value = enemy(1),stateno
ignorehitpause = 1

[State -3,学習シングル地上5,6F]
type = Varset
triggerall = numenemy = 1
triggerall = stateno = 150 || stateno = 152 ||stateno = 5000 ||stateno = 5010 ||stateno = 5070
triggerall = time = 0
triggerall = enemy(0),HitDefAttr = SC,NA,SA
triggerall = enemy(0),HitCount <2
triggerall = prevstateno !=[130,155]
trigger1 = enemy(0),time = [5,6]
fv = ifelse(fvar(20)=0,20,(ifelse(fvar(21)=0,21,(ifelse(fvar(22)=0,22,23)))))
value = enemy(0),stateno
ignorehitpause = 1

[State -3,学習タッグ地上0_5,6F]
type = Varset
triggerall = numenemy >= 2
triggerall = enemy(1),alive = 0
triggerall = stateno = 150 || stateno = 152 ||stateno = 5000 ||stateno = 5010 ||stateno = 5070
triggerall = time = 0
triggerall = enemy(0),HitDefAttr = SC,NA,SA
triggerall = enemy(0),HitCount <2
triggerall = prevstateno !=[130,155]
trigger1 = enemy(0),time = [5,6]
fv = ifelse(fvar(20)=0,20,21)
value = enemy(0),stateno
ignorehitpause = 1

[State -3,学習タッグ地上1_5,6F]
type = Varset
triggerall = numenemy >= 2
triggerall = enemy(0),alive = 0
triggerall = stateno = 150 || stateno = 152 ||stateno = 5000 ||stateno = 5010 ||stateno = 5070
triggerall = time = 0
triggerall = enemy(1),HitDefAttr = SC,NA,SA
triggerall = enemy(1),HitCount <2
triggerall = prevstateno !=[130,155]
trigger1 = enemy(1),time = [5,6]
fv = ifelse(fvar(22)=0,22,23)
value = enemy(1),stateno
ignorehitpause = 1


;============================================================================================================================================================
;▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲タッグ専用▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲
;============================================================================================================================================================
;============================================================================================================================================================
;============================================================================================================================================================
;パートナーが前方でやられてるときのカット。
;囲まれたときや追い詰められたときにグレートボムで仕切り直しを狙う。
;============================================================================================================================================================
;============================================================================================================================================================
;============================================================================================================================================================
[State -3,▲グレートボム]
type = ChangeState
value = 2100
triggerall = var(59) >= 2
triggerall = alive && RoundState = 2
triggerall = statetype != A
triggerall = power >= 1000
triggerall = ctrl || (stateno =[10001,10021])
triggerall = numhelper(20100)
triggerall = numtarget = 0
;敵2体
triggerall = numenemy >= 2
triggerall = enemy(0),alive && enemy(1),alive
triggerall = (enemy(0),stateno != [5000,5210]) && (enemy(1),stateno != [5000,5210])
triggerall = enemy(0),movetype = A || enemy(1),movetype = A
triggerall = random < (var(57)*30)+ifelse((stateno = 140),(var(57)*20),ifelse((prevstateno = 140),(var(57)*20),0))+ifelse(backedgebodydist < 5,(var(57)*20),0)
;敵が両方近距離
trigger1 = fvar(3) = [-80,75]
trigger1 = fvar(4) = [-80,75]

[State -3,▲レーザークローラッシュ]
type = ChangeState
value = 2200
triggerall = var(59) >= 2
triggerall = alive && RoundState = 2
triggerall = statetype != A
triggerall = power >= 1000
triggerall = ctrl || (stateno =[10001,10021])
triggerall = numtarget = 0
;パートナーが生きていて、通常くらい時
triggerall = numpartner
triggerall = partner,alive
triggerall = partner,stateno = [5000,5071]
triggerall = fvar(5) = [-10,100]
trigger1 = enemy(0),alive && enemy(1),alive
trigger1 = (fvar(3) =[0,110])&&(fvar(4) =[0,110])
trigger1 = enemy(0),pos y > -50 && enemy(1),pos y > -50 
trigger1 = enemy(0),movetype = A || enemy(1),movetype = A
trigger1 = random < (var(57)*30)+ifelse((stateno = 140),(var(57)*20),ifelse((prevstateno = 140),(var(57)*20),0))
trigger2 = enemy(0),alive
trigger2 = (fvar(3) =[0,110])
trigger2 = enemy(0),statetype != A
trigger2 = enemy(0),movetype = A && enemy(0),numtarget
trigger2 = random < (var(57)*20)+ifelse((stateno = 140),(var(57)*10),ifelse((prevstateno = 140),(var(57)*10),0))
trigger3 = enemy(1),alive
trigger3 = (fvar(4) =[0,110])
trigger3 = enemy(1),statetype != A
trigger3 = enemy(1),movetype = A && enemy(1),numtarget
trigger3 = random < (var(57)*20)+ifelse((stateno = 140),(var(57)*10),ifelse((prevstateno = 140),(var(57)*10),0))

[State -3,▲レーザーソバット弱]
type = ChangeState
value = 1300
triggerall = var(59) >= 2
triggerall = alive && RoundState = 2
triggerall = statetype != A
triggerall =! Inguarddist
triggerall = numhelper(20100)
triggerall =! helper(20100),Inguarddist
triggerall = ctrl || (stateno =[10001,10021])
triggerall = numtarget = 0
;パートナーが生きていて、通常くらい時
triggerall = numpartner
triggerall = partner,alive
triggerall = partner,stateno = [5000,5071]
triggerall = fvar(5) = [-10,100]
trigger1 = enemy(0),alive && enemy(1),alive
trigger1 = (fvar(3) =[100,125])&&(fvar(4) =[100,125])
trigger1 = enemy(0),pos y > -50 && enemy(1),pos y > -50 
trigger1 = enemy(0),movetype = A || enemy(1),movetype = A
trigger1 = random < (var(57)*20)
trigger2 = enemy(0),alive
trigger2 = (fvar(3) =[100,125])
trigger2 = enemy(0),statetype != A
trigger2 = enemy(0),movetype = A && enemy(0),numtarget
trigger2 = random < (var(57)*10)
trigger3 = enemy(1),alive
trigger3 = (fvar(4) =[100,125])
trigger3 = enemy(1),statetype != A
trigger3 = enemy(1),movetype = A && enemy(1),numtarget
trigger3 = random < (var(57)*10)

[State -3,▲スタンガンネイル弱]
type = ChangeState
value = 1200
triggerall = var(59) >= 2
triggerall = alive && RoundState = 2
triggerall = statetype != A
triggerall =! Inguarddist
triggerall = numhelper(20100)
triggerall =! helper(20100),Inguarddist
triggerall = ctrl || (stateno =[10001,10021])
triggerall = numtarget = 0
;パートナーが生きていて、通常くらい時
triggerall = numpartner
triggerall = partner,alive
triggerall = partner,stateno = [5000,5071]
triggerall = fvar(5) = [-10,100]
trigger1 = enemy(0),alive && enemy(1),alive
trigger1 = (fvar(3) =[100,125])&&(fvar(4) =[100,125])
trigger1 = enemy(0),pos y > -50 && enemy(1),pos y > -50 
trigger1 = enemy(0),movetype = A || enemy(1),movetype = A
trigger1 = random < (var(57)*20)
trigger2 = enemy(0),alive
trigger2 = (fvar(3) =[100,125])
trigger2 = enemy(0),statetype != A
trigger2 = enemy(0),movetype = A && enemy(0),numtarget
trigger2 = random < (var(57)*10)
trigger3 = enemy(1),alive
trigger3 = (fvar(4) =[100,125])
trigger3 = enemy(1),statetype != A
trigger3 = enemy(1),movetype = A && enemy(1),numtarget
trigger3 = random < (var(57)*10)

[State -3,▲グレネード弱]
type = ChangeState
value = 1000
triggerall = var(59) >= 2
triggerall = alive && RoundState = 2
triggerall = statetype != A
triggerall =! Inguarddist
triggerall = numhelper(20100)
triggerall =! helper(20100),Inguarddist
triggerall = numhelper(1000) = 0
triggerall = numtarget = 0
;パートナーが生きていて、通常くらい時
triggerall = numpartner
triggerall = partner,alive
triggerall = partner,stateno = [5000,5071]
triggerall = fvar(5) = [-10,150]
trigger1 = enemy(0),alive && enemy(1),alive
trigger1 = (fvar(3) =[120,160])&&(fvar(4) =[120,160])
trigger1 = enemy(0),statetype != A && statetype != A
trigger1 = enemy(0),movetype = A || enemy(1),movetype = A
trigger1 = random < (var(57)*20)
trigger2 = enemy(0),alive
trigger2 = (fvar(3) =[120,160])
