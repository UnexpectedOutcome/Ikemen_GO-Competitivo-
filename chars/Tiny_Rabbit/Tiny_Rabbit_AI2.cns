;▲AI用垂直ジャンプ
[Statedef 10080]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[state 40,投げ無敵]
type = nothitby
trigger1 = 1
value = ,AT
time = 1

[State -3, ガード]
Type = ChangeState
Value = 120
triggerall = Var(59) >= 2 && alive && RoundState <= 2
triggerall = stateno != [120,155]
trigger1 = InGuardDist
trigger2 = numhelper(20000) > 0
trigger2 = helper(20000),InGuardDist

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
