;AI専用行動
;=====================================================================================================================================
;=====================================================================================================================================
;■AI用行動
;▲何もしない
[Statedef 10001]
type = C
physics = C
sprpriority = 0
ctrl = 0

[State 10001, ヘルパーなら消える]
type = destroyself
trigger1 = Ishelper
ignorehitpause = 1
pausemovetime = 9999
supermovetime = 9999

[state 10001]
type = posset
trigger1 = time = 0
y = 0

[State 10001, 立ちアニメ]
type = ChangeAnim
trigger1 = anim != [10,12]
trigger1 = anim != 0
trigger2 = anim = 12
trigger2 = animtime = 0
value = 0

[State 10001, しゃがみ途中アニメ]
type = ChangeAnim
triggerall = anim != [10,12]
triggerall = p2stateno != [5000,5150]
trigger1 = p2bodydist x < 100
value = 10

[State 10001,ステートタイプ]
type = Statetypeset
trigger1 = anim = 10
trigger1 = animelemtime(1) = 0
statetype = C
physics = C

[State 10001, しゃがみアニメ]
type = Changeanim
trigger1 = anim = 10 && AnimTime = 0
trigger2 = anim = 6 && AnimTime = 0
value = 11

[State 11, 振り向きアニメ]
type = ChangeAnim
trigger1 = anim = 0 && p2dist x < 0
trigger2 = Anim = 11 && p2dist x < 0
value = ifelse(anim = 0,5,6)

[State 11, 振り向き]
type = turn
trigger1 = Anim = 5 && animelemtime(1) = 0
trigger2 = Anim = 6 && animelemtime(1) = 0

[State 10001, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 10001, 立ち途中アニメ]
type = Changeanim
triggerall = anim = 11
trigger1 = p2stateno = [5000,5150]
trigger2 = p2bodydist x >= 100
value = 12

[State 10001,ステートタイプ]
type = Statetypeset
trigger1 = anim = 0 || anim = 12
trigger1 = animelemtime(1) = 0
statetype = S
physics = S

[State 10001, 0に戻る]
type = ChangeState
trigger1 = roundstate !=2
value = ifelse(statetype =C,12,0)
ctrl = 1
;---------------------------------------------------------------------------
;▲AI前進
[Statedef 10020]
type    = S
physics = S
sprpriority = 0
ctrl = 0

[State 10020, 1]
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x)

[State 10020, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 11, 振り向きアニメ]
type = ChangeAnim
trigger1 = anim != 5
trigger1 = p2dist x < 0
value = 5
persistent = 0

[State 11, 振り向き]
type = turn
trigger1 = Anim = 5 && animelemtime(1) = 0
persistent = 0

[State 10020]
type = changestate
triggerall = time >0
trigger1 = Anim = 5 && animelemtime(1) = 0
value = 10021
ctrl = 0

[State 10020]
type = changestate
triggerall = vel x > 0
trigger1 = roundstate != 2
trigger2 = P2BodyDist X <= 45
trigger2 = p2movetype !=I
trigger3 = P2BodyDist X <= 22
value = 10001
ctrl = 0
;---------------------------------------------------------------------------
;▲AI後退
[Statedef 10021]
type    = S
physics = S
sprpriority = 0
ctrl = 0

[State 10021, 2]
type = VelSet
trigger1 = 1
x = const(velocity.walk.back.x)

[State 10021, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 11, 振り向きアニメ]
type = ChangeAnim
trigger1 = anim != 5
trigger1 = p2dist x < 0
value = 5
persistent = 0

[State 11, 振り向き]
type = turn
trigger1 = Anim = 5 && animelemtime(1) = 0
persistent = 0

[State 10020]
type = changestate
triggerall = time >0
trigger1 = Anim = 5 && animelemtime(1) = 0
value = 10020
ctrl = 0


[State 10021]
type = changestate
triggerall = vel x < 0
trigger1 = roundstate != 2
trigger2 = BackEdgeBodyDist <= 10
;trigger3 = p2statetype = L
;trigger3 = p2bodydist x > 120
value = 10001
ctrl = 0
