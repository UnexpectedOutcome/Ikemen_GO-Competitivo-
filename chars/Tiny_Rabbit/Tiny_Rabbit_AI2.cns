;▲AILv3以下・立ちからスタンガンネイル強
[Statedef 11250]
type = C
physics = C
sprpriority = 0
ctrl = 0

[State 11250, ヘルパーなら消える]
type = destroyself
trigger1 = Ishelper
ignorehitpause = 1
pausemovetime = 9999
supermovetime = 9999

[state 11250]
type = posset
trigger1 = time = 0
y = 0

[State 11250,しゃがみ途中アニメ]
type = ChangeAnim
trigger1 = time = 0
trigger1 = anim != [10,11]
value = 10

[State 11250,ステートタイプ]
type = Statetypeset
trigger1 = anim = 10
trigger1 = animelemtime(1) = 0
statetype = C
physics = C

[State 11250,しゃがみアニメ]
type = Changeanim
trigger1 = anim = 10 && AnimTime = 0
trigger2 = anim = 6 && AnimTime = 0
value = 11

[State 11250,振り向きアニメ]
type = ChangeAnim
trigger1 = anim = 21 && p2dist x < 0
trigger2 = Anim = 11 && p2dist x < 0
value = ifelse(anim = 21,5,6)

[State 11250,振り向き]
type = turn
trigger1 = Anim = 5 && animelemtime(1) = 0
trigger2 = Anim = 6 && animelemtime(1) = 0

[State 11250,後退速度]
type = VelSet
trigger1 = time > 3
trigger1 = random < 100
trigger2 = time > 7
trigger3 = anim = 21
x = const(velocity.walk.back.x)

[State 11250,後退アニメ]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 11250,振り向きステート変更]
type = changestate
triggerall = time >0
trigger1 = Anim = 5 && animelemtime(1) = 0
trigger2 = Anim = 6 && animelemtime(1) = 0
value = 10001
ctrl = 0

[State 11250,ステートタイプ]
type = Statetypeset
trigger1 = anim = 21
trigger1 = animelemtime(1) = 0
statetype = S
physics = S

[State 11250,ガード]
Type = ChangeState
Value = 120
triggerall = anim = 21
trigger1 = InGuardDist

[State 11250,スタンガンネイル強へ]
type = changestate
trigger1 = time > 5
trigger1 = random < 100
trigger2 = time > 10
value = 1250
ctrl = 0
