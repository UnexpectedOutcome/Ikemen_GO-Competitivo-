[Statedef 10100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 10100,ダッシュエフェクト]
type = Explod
trigger1 = time = 0
anim = 3300
ID = 3300
pos = -5, 5
postype = p1
bindtime = 1
removetime = -2
scale = 0.5, 0.5
sprpriority = 0
ownpal = 1
supermovetime  = 9999
pausemovetime  = 9999
removeongethit = 0
ignorehitpause = 1
persistent = 0

[State 10100, 音]
type = PlaySnd
trigger1 = animelemtime(3) = 1
trigger2 = animelemtime(9) = 1
value = 100,2

[State 10100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 10100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 10100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 10100, 5]
type = ChangeState
triggerall = animelemtime(3) > 0
trigger1 = roundstate != 2
trigger2 = win || lose
;壁際右向き
trigger3 = numhelper(25000)
trigger3 = facing = 1
trigger3 = helper(25000),var(13) < 50
;壁際左向き
trigger4 = numhelper(25000)
trigger4 = facing = -1
trigger4 = helper(25000),var(14) < 50
;画面端
trigger5 = frontedgebodydist < 30
value = 101
ctrl = 0

