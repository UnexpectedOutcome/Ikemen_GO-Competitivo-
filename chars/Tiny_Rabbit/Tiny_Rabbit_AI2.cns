trigger1 = anim = 41
trigger1 = animelemtime(1) = 0
value = 100,0
persistent = 0

[State 50,1]
type = VarSet
trigger1 = anim = 41
trigger1 = animelemtime(1) = 0
sysvar(1) = 0

[State 11550,飛び降り方向セット]
