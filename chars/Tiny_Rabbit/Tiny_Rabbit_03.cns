;====================================================================================
;■ステート奪取■
;====================================================================================
;崩撃くらい
[Statedef 580]
movetype= H
physics = N
ctrl = 0
velset = 0,0

[State 580,空中なら吹き飛びへ]
type = Changestate
triggerall = time = 0
trigger1 = statetype = A
trigger2 = pos y < 0
value = 590
ctrl = 0

[State 580, 相手のアニメ変更]
type = ChangeAnim2
trigger1 = Time = 0
value = 580

[state 580,無敵]
type = nothitby
trigger1 = anim = 580
trigger1 = animelemtime(21) < 0
trigger2 = anim = 585
value = SCA,AA,AP,AT

[State 580,ステートタイプセット]
type = Statetypeset
trigger1 = anim = 580
trigger1 = animelemtime(2) = 0
statetype = S

[State 580, 相手のアニメ変更]
type = ChangeAnim2
trigger1 = anim = 580
trigger1 = animtime = 0
value = 585

[state 580,飛び倒れ]
type = velset
trigger1 = anim = 585
trigger1 = animelemtime(2) = 0
x = -2
y = -2

[State 580,ステートタイプセット]
type = Statetypeset
trigger1 = anim = 585
trigger1 = animelemtime(2) = 0
statetype = A

[state 580,重力]
type = veladd
trigger1 = anim = 585
trigger1 = animelemtime(2) > 1
y = 0.5

[state 580,着地で自分のステートへ]
type = SelfState
trigger1 = anim = 585
trigger1 = animelemtime(2) > 1
trigger1 = vel y > 0
trigger1 = pos y >= ifelse(const(size.mid.pos.y)<-50,-50-const(size.mid.pos.y),0)
value = 5100
