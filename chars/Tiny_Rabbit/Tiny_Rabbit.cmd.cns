;==============================================================================
;==============================================================================
;一撃技
[State -1,エクストリームランアウェイ]
type = ChangeState
value = 2800
triggerall = var(59) <= 1
triggerall = power >= 1000
triggerall = statetype != A
triggerall = var(53) =[6,9]
triggerall = command = "zc"
trigger1 = ctrl
trigger2 = movecontact
trigger2 = stateno=500||stateno=520||stateno=530||stateno=550||stateno=560||stateno=600||stateno=650
;ダッシュ停止キャンセル
trigger3 = (stateno = 101)
trigger3 = anim = 101 && animelemtime(3) > 0
; 起きあがり
trigger4 = stateno = 5120
trigger4 = animtime = 0
;==============================================================================
;==============================================================================
;先行入力技発動
[State -1,地上1ゲージ技]
type = ChangeState
value = var(2)
triggerall = var(59) <= 1
triggerall = var(2) = [2000,2599]
;triggerall = var(3) > 0
triggerall = power >= 1000
triggerall = statetype != A 
trigger1 = ctrl
trigger2 = movecontact
trigger2 = stateno=500||stateno=520||stateno=530||stateno=550||stateno=560||stateno=600||stateno=650
;ダッシュ停止キャンセル
trigger3 = (stateno = 101)
trigger3 = anim = 101 && animelemtime(3) > 0

;先行入力技発動2
[State -1,1ゲージ技]
type = ChangeState
value = var(2)
triggerall = var(59) <= 1
triggerall = var(2) = [2000,2599]
;triggerall = var(3) > 0
triggerall = power >= 1000
trigger1 = statetype = S || statetype = C
trigger1 = stateno = 5001               ; 喰らい回復
trigger1 = HitOver
trigger2 = statetype = S || statetype = C
trigger2 = stateno = 5011               ; 屈喰らい回復
trigger2 = HitOver
; 起きあがり
trigger3 = stateno = 5120
trigger3 = animtime = 0

;==============================================================================
