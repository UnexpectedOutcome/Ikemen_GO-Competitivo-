trigger3 = StateNo = 530 || StateNo = 541 || StateNo = 542 || StateNo = [511,514]
trigger3 = Movecontact
trigger4 = ((StateNo = 500 || StateNo = 501 || StateNo = 502 || StateNo = 1000) && Animelem = 7,>=0)
trigger5 = StateNo = 1100 || StateNo = 1200 || StateNo = 1300
trigger5 = Movecontact

