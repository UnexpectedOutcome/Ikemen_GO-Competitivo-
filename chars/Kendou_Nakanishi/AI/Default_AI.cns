;---------------------------------------------------------------------------
;AI用
;---------------------------------------------------------------------------
[Statedef -3]

[State -3]
Type = VarRandom
triggerall = var(53) != 0
Trigger1 = Time = 1
Trigger2 = MoveType = I
Trigger2 = 1
V = 55
Range = 0,99

;AI行動認識用
[State -3]
Type = Helper
triggerall = TeamMode = single || TeamMode = turns
Trigger1 = abs(var(53)) > 0
trigger1 = NumHelper(10506) = 0
StateNo = 10506
ID = 10506
name = "AI"
PosType = Left
Pos = 0, 0
SprPriority = -7
Persistent = 0

;---------------------------------------------------------------------------
;AIガード用
;---------------------------------------------------------------------------
[State -3,ガードリセット用]
