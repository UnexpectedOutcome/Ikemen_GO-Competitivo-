Trigger1 = (MoveType = H) && StateNo = [5000,5299]
Trigger1 = Life <= 400 && Var(59) != 0 && Var(58) >= 1 && Var(58) <= 3 && Var(53) = 1
Value    = SAC, NT, ST, HT ,NA, SA, HA ,NP, SP, HP
Time     = 1

[State -2,~吹っ飛ぶ~]
