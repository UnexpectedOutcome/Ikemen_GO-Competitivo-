Value    = GetHitVar(Damage)/1.75
IgnoreHitPause = 1

[State -2,~赤バーは零に~]
Type     = VarSet
Trigger1 = RoundState <= 1
Trigger2 = StateNo = 900 && AnimElem = 6,>= 2
FV       = 6
Value    = 0
IgnoreHitPause = 1
