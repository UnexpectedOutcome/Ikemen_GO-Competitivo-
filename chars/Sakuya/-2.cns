[State -2,~空中ダッシュできる~]
Type     = VarSet
Trigger1 = Command != "holdz"
Trigger2 = Command != "holdfwd" && Command != "holdback"
V        = 2
Value    = 0

[State -2,~空中ダッシュできない~]
Type       = VarSet
TriggerAll = StateNo = 102 && AnimElem = 3,<= 0 || StateNo = 107 && AnimElem = 4,<= 0
Trigger1   = Command = "holdz" && Command = "holdfwd"
Trigger2   = Command = "holdz" && Command = "holdback"
V          = 2
Value      = 1
