[State -2,~垂直起き上がり~]
Type     = VarSet
Trigger1 = StateNo != [5030,5150]
V        = 6
Value    = 0

[State -2,~移動起き上がり~]
Type       = VarSet
TriggerAll = (StateNo = [5030,5150]) && (StateNo != 5120)
Trigger1   = Command = "a" || Command = "b" || Command = "c"
Trigger2   = Command = "x" || Command = "y" || Command = "z"
V          = 6
Value      = IfElse(Command = "holdfwd", 1, IfElse(Command = "holdback", -1, 0))
