[State -2,~Story Mode~]
Type     = VarSet
Trigger1 = TeamMode = Single
Trigger1 = Var(58) = 0
V        = 58
Value    = 1	    ; 1～3以外で使用しない
[State -2,~暗転用~]
Type     = VarSet
Trigger1 = RoundState <= 1
Trigger1 = Var(59) != 0 && Var(58) >= 2 && Var(5) = 0
