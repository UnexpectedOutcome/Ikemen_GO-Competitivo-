[State -2,~残像がきれる~]
Type     = AfterImageTime
Trigger1 = MoveType = H
Trigger2 = StateNo = [0,49]
Trigger3 = StateNo = 52 || StateNo = 101
Trigger4 = StateNo = 102 && Anim = 110 && AnimElem = 12, >= 3
Trigger5 = StateNo = 107 && Anim = 115 && AnimElem = 12, >= 3
Trigger6 = StateNo = [200,3999]
Time     = 1

[State -2,~ガードオブジェ立ち~]
Type     = RemoveExplod
Trigger1 = MoveType = H && StateNo != [120,159]
Trigger2 = StateNo = 750
ID       = 150
[State -2,~ガードオブジェしゃがみ~]
