; Definition file for player
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Save SpaceMouse!"        ;Name of character
displayname = "Save SpaceMouse!" ;Name of character to display
versiondate = 2009/11/12
mugenversion = 1.0
author = "SpaceMouse"
pal.defaults = 1,2,3,4

; Files for the player
[Files]
cmd     = savespacemouse.cmd   ;Command set
cns     = savespacemouse.cns   ;Constants
st      = savespacemouse.cns   ;States
stcommon = savespacemouse.cns ;Common states
sprite  = savespacemouse.sff   ;Sprite
anim    = savespacemouse.air   ;Animation
sound  = savespacemouse.snd   ;Sound
pal1   = ssm01.ACT   ;Palettes (can have up to 12)
pal2   = ssm02.ACT
pal3   = ssm03.ACT
pal4   = ssm04.ACT
pal5   = ssm05.ACT
pal6   = ssm06.ACT
pal7   = ssm07.ACT
pal8   = ssm08.ACT
pal9   = ssm09.ACT
pal10  = ssm10.ACT
pal11  = ssm11.ACT
pal12  = ssm12.ACT
