
; VARIABLES USED:
; var(0) : used in figuring out closest devilmouse
; var(1) : used in figuring out closest devilmouse
; var(2) : devilmouse - random decision
; var(3) : devilmouse - life
; var(4) : devilmouse - how many fireballs should i throw
; var(5) : devilmouse - how many fireballs have i thrown
; var(6) : devilmouse - how long should i do this action
; var(9) : number for the next devilmouse
; var(10): calculation of how many seconds round has gone on for
; var(22): root - total devil mice out at the moment
; var(23): root - maximum devil mice that can be out at once
; var(24): root - am i spawning a devilmouse
; var(30): root - How long before should spit out another mouse
; var(47): root - 100s digit
; var(48): root -  10s digit
; var(49): root -   1s digit
; var(52): root - update explods?
; var(53): root - what mode is the minigame in
; var(55): root - Is enemy a Nazrin
; var(32): root - how many must be killed (set at beginning)
; var(57): root - how many devilmice left / how many you've killed
; var(58): root - what mode is the minigame in

; fvar(32): root: copy of var(32)
; fvar(33): root: copy of var(57)

; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 1000			;Amount of life to start with
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 15		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 0			;Volume offset (negative for softer)
IntPersistIndex = 58
FloatPersistIndex = 40

[Size]
xscale = 0.5         ;Horizontal scaling factor.
yscale = 0.5          ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 16    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4		;Walk forward
walk.back = -2.2		;Walk backward
run.fwd  = 4.6, 0		;Run forward (x, y)
run.back = -4.5,-3.8	;Hop backward (x, y)
jump.neu = 0,-8.4		;Neutral jumping velocity (x, y)
jump.back = -2.55		;Jump back Speed (x, y)
jump.fwd = 2.5		;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1;Running jump speeds (opt)
runjump.fwd = 4,-8.1	;.
airjump.neu = 0,-8.1	;.
airjump.back = -2.55	;Air jump speeds (opt)
airjump.fwd = 2.5		;.

[Movement]
airjump.num = 1		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .44		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...


;=========================
;Base State
[Statedef 0]
type=S
anim=0

[State 0,d] ; if you're a helper turn into a devilmouse
type=ChangeState
trigger1=ishelper
value=6205
ctrl=0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State -2]
type = posset
trigger1 = RoundState > 2
x= ifelse(teamside = 1, -99999, 99999)

[State 0,d]
type=ChangeState
trigger1=Roundstate=2
value=1
ctrl=0
[state 0]
type = changestate
trigger1=!alive
value=5050

;=========================
;Control State
[Statedef 1]
type=S
anim=0

;[State -2]
;type = posset
;trigger1 = var(53) != 0 && RoundState >= 2
;x= ifelse(teamside = 1, -99999, 99999)




[state 0, test]
type = null
triggerall = var(0) := 0 || 1
triggerall = var(1) := 0 || 1
trigger1 = var(1) := ifelse( helper(6200+var(1)), p2dist x > helper(6200+var(0)), p2dist x, var(0), var(1))
trigger1 = (var(0) := var(0) + 1) && 0
trigger2 = var(1) := ifelse( helper(6200+var(1)), p2dist x > helper(6200+var(0)), p2dist x, var(0), var(1))
trigger2 = (var(0) := var(0) + 1) && 0
trigger3 = var(1) := ifelse( helper(6200+var(1)), p2dist x > helper(6200+var(0)), p2dist x, var(0), var(1))
trigger3 = (var(0) := var(0) + 1) && 0
trigger4 = var(1) := ifelse( helper(6200+var(1)), p2dist x > helper(6200+var(0)), p2dist x, var(0), var(1))
trigger4 = (var(0) := var(0) + 1) && 0
;var(1) is the id of the nearest helper

[State 1, PosSet] ; latch on to nearest devilmouse
type = PosSet
trigger1 = var(22) > 0 ; if there are any devilmice out
x = (Helper(6200+var(1)), pos X)

[State 1, PosSet] ; no devilmice, latch onto spawner
type = PosSet
trigger1 = var(22) = 0 ; if there are no devilmice out
x = (Helper(6000), pos X)

[State 1, varset] ; reset spawning var
type = VarSet
trigger1 = time = 0
v = 24
value = 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 1, VarSet]
type = VarSet
trigger1 = time = 0
v = 30
value = (random%60 + 30) ; 0.5-1.5 sec spawn rate

[State 190]
type = Helper
trigger1=!Time&&!Numhelper(6000)
ID=6000
name="Devil Machine"
stateno=6000
pos=100,0
postype = left
helpertype = normal
;ownpal = 1

[State 0]
type=Changestate
trigger1 = time >= var(30)
trigger1 = var(22) < var(23)
value = 2

[State 0]
type=Changestate
trigger1=Time>5&&Roundstate!=2
value=0
ctrl=1

;=========================
;Control State Spawn Mouse
[Statedef 2]
type=S
anim=0

[State 1, varset]
type = VarSet
trigger1 = time = 0
v = 24
value = 1

[state 0, test]
type = null
triggerall = var(0) := 0 || 1
triggerall = var(1) := 0 || 1
trigger1 = var(1) := ifelse( helper(6200+var(1)), p2dist x > helper(6200+var(0)), p2dist x, var(0), var(1))
trigger1 = (var(0) := var(0) + 1) && 0
trigger2 = var(1) := ifelse( helper(6200+var(1)), p2dist x > helper(6200+var(0)), p2dist x, var(0), var(1))
trigger2 = (var(0) := var(0) + 1) && 0
trigger3 = var(1) := ifelse( helper(6200+var(1)), p2dist x > helper(6200+var(0)), p2dist x, var(0), var(1))
trigger3 = (var(0) := var(0) + 1) && 0
trigger4 = var(1) := ifelse( helper(6200+var(1)), p2dist x > helper(6200+var(0)), p2dist x, var(0), var(1))
trigger4 = (var(0) := var(0) + 1) && 0
;var(1) is the id of the nearest helper

[State 1, PosSet] ; latch onto spawner
type = PosSet
trigger1 = 1
x = (Helper(6000), pos X)
y = (Helper(6000), pos Y)

[State 190]
type = Helper
trigger1 = time = 30
ID=6200+var(9)
name="DevilMouse"
stateno=6200
pos=90,-40
postype = p1
helpertype = player
keyctrl = 0
facing = 1
;ownpal = 1

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 0]
type=Changestate
trigger1=time = 60
value = 1

;---------------------------------------------------------------------------
