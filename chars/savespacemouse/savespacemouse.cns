type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;=========================
;Intro
[Statedef 190]
type=S
anim=0

[State 190, 1] 
type = varrandom
trigger1 = time = 1
trigger1 = var(53) = 1
v= 57
range = 10,20
;range = 1,2

[State 190, 1] 
type = varset
trigger1 = time = 1
trigger1 = var(53) = 1
v= 32
value = var(57)

[State -2];百
type = varset
trigger1 = time = 1
v= 47
value = floor(var(57)*0.01)

[State -2];十
type = varset
trigger1 = time = 1
v= 48
value = floor((var(57)-((100*var(47))+var(49)))*0.1)

[State -2];一
type = varset
trigger1 = time = 1
v= 49
value = var(57)-(10*floor(var(57)*0.1))

[State 190]
type = Helper
trigger1=!Time&&!Numhelper(6000)
ID=6000
name="Devil Machine"
stateno=6000
pos=0,0
helpertype = normal
;ownpal = 1

[State 1000, 0] ;sfx
type = PlaySnd
trigger1 = time = 0
value = 41, 0
abspan = 0

[State 190]
type=AssertSpecial
trigger1=1
flag=Intro

[State 190]
type=ChangeState
trigger1=time>50
value=0
ctrl=1

;-------------------------
; HITA_UP (initial going up)
[Statedef 5030]
type    = S
velset=0,0

[State 0]
type=Changestate
trigger1=Time
value=5050

;-------------------------
; HITA_FALL (knocked up, falling)
[Statedef 5050];derrotado
type    = S

[State 5050]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; HIT_LIEDEAD
[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = -3

[State 5050]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 0,d] ; if you're a helper go away
type=DestroySelf
trigger1=ishelper

[State 0,d] ; if you're still alive and somehow ended up here, go back to 0
type=ChangeState
trigger1=life > 0
value=0
ctrl=1

[State 5150, AssertSpecial] ; if truely dead, be invisible and noshadow
type = AssertSpecial
trigger1 = life = 0
flag = Invisible
flag2 = noshadow

;------------------------
[Statedef 5500];Continue?
type = S
ctrl = 0
velset = 0,0

[State 5050]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

