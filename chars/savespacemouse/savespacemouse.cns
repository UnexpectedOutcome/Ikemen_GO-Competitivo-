type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State -2] ; the life set
type = lifeset
trigger1 = roundstate > 2 && enemy,alive
value = 0

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
