
[Info]
Name         = "cureblossom"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "cureblossom"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 03,20,2010     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "marisya"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3,4,5,6        ;ＣＰＵで出てきた時のカラーパレットの順番


[Files]
Cmd     = cureblossom.cmd       ;コマンドファイルの登録
Cns     = cureblossom.cns       ;コンスタンツファイルの登録
St      = cureblossom.cns       ;ステートファイルの登録・最大１１個まで増やせます
                        ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                        ;「St」のみ必要な項目なので省略出来ません
StCommon = common1.cns  ;コモンステートファイルの登録
Sprite  = cureblossom.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = cureblossom.air       ;アニメーションファイルの登録
Sound   = cureblossom.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録


Pal1 = cureblossom.act  ;Ａボタンで決定した色が使えます
Pal2 = blossom1.act
Pal3 = blossom2.act
Pal4 = blossom3.act
Pal5 = blossom4.act
Pal6 = blossom5.act

movelist = movelist.dat