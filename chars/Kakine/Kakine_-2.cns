;===========================================================================
; 常時監視ステート（－２）
;===========================================================================

[Statedef -2]

;-----------------------------------
;ここは「パワー溜め」のステートで発生させた「Explod」のエフェクト画像を
;特定の条件が有効になれば消す、という処理をしています。

[State -2, エフェクトを消す];パワー溜めステート用
type = RemoveExplod
triggerall = NumExplod(130) > 0
                          ;↑はＩＤナンバー「130」のExplodの画面中の数が0よりも多い、
                          ;つまり１枚以上表示されている時
trigger1 = StateNo != 700 ;ステートが７００（パワー溜め）以外の時
trigger2 = MoveType != I  ;MoveTypeが「I（何もしてない）」以外の時
ID = 130                  ;消すExplodの特定のＩＤナンバーを指定



;-----------------------------------
[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
text = "Cancel=%d, Throw=%d, Button=%d, Body-Distance X=%d,Y=%d \n"
params = var(1),var(2),var(5),floor(P2BodyDist X),floor(P2BodyDist Y)

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "Position X=%d,Y=%d, Velocity X=%f,Y=%f, Hit=%d \n"
params = floor(Pos X),floor(Pos Y),(Vel X),(Vel Y),(MoveHit)

;===========================================================================

[State -2];バーストアイコンy軸
	type = Varset
	trigger1 = Numhelper(30000) = 0
	var(33) = 0;デフォルトは0 +方向で下に

[State -2];バーストアイコンx軸
	type = Varset
	trigger1 = Numhelper(30000) = 0
	var(34) = 0;デフォルトは0 -方向で中央に

;===========================================================================
;特殊システム
;===========================================================================
;---------------------------------------------------------------------------
;ダークマターゲージ
;---------------------------------------------------------------------------
[State -2];ダークマターゲージ上限
Type= Varset
Trigger1= var(50) >1000
var(50)=1000

[State -2];ダークマターゲージ下限
Type= Varset
Trigger1= var(50) < 0
var(50)=0

[State -2];ダークマターゲージ上限
Type= Varset
Trigger1= var(51) >1000
var(51)=1000

[State -2];ダークマターゲージ下限
Type= Varset
Trigger1= var(51) < 0
var(51)=0

[State -2];ダークマターゲージ使用不能
Type= Varset
Trigger1= var(17) = 1
var(50)=0

[State -2];ダークマターゲージ使用不能
Type= Varset
Trigger1= var(17) = 1
var(51)=0

[State -2];ゲージ呼び出し
type = Helper
triggerAll = !var(18)
trigger1 = time = 1
trigger1 = Numhelper(9998) = 0
stateno = 9998
ID = 9998
pos = 0,0
postype = left
helpertype = normal
name = "gauge"
keyctrl = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999

[State -2];ゲージ回復
Type= VarAdd
TriggerAll= var(51) =[0,1000]
trigger1 = gethitvar(hitcount)
trigger1 = time < 1
var(51)= 7

[State -2];ゲージ回復
Type= VarAdd
TriggerAll= var(51) =[0,1000]
trigger1 = HitCount
trigger1 = time > 1
var(51)= 1

[State -2];ゲージ呼び出し
type = Helper
triggerAll = !var(18)
trigger1 = time = 1
trigger1 = Numhelper(9999) = 0
stateno = 9999
ID = 9999
pos = 0,0
postype = left
helpertype = normal
name = "gauge"
keyctrl = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999

[State -2];ゲージ回復
Type= VarAdd
TriggerAll= var(50) =[0,1001]
trigger1 = 1
var(50)=1

[State -2];ゲージ減少
Type= VarAdd
TriggerAll= var(50) =[0,1001]
trigger1 = GetHitVar(damage)
var(50)=-25

;==============================================================================
;ダークマター防御一打目
;==============================================================================

[State -2,ガード]
Type     = VarSet
Trigger1 = Ctrl && StateNo%2 && StateNo = [151,155]
Trigger2 = PrevStateNo%2 = 0 && PrevStateNo = [150,154]
Trigger2 = StateNo%2 = 0 && StateNo = [150,154]
V        = 6
Value    = 0
Ignorehitpause = 1

[State -2,ライフ反転]
Type     = VarSet
Trigger1 = MoveType != H
V        = 6
Value    = -Life
Ignorehitpause = 1

[State -2,一打目ダメージ軽減]
Type     = LifeAdd
Trigger1 = MoveType = H
Trigger1 = Life && Alive
Trigger1 = Life < Var(6)
Value = Floor((Var(6)-Life)*FVar(6))
Ignorehitpause = 1
Absolute = 1

[State -2,一打終了]
Type     = VarSet
Trigger1 = MoveType = H
Trigger1 = Life <= Var(6) && Var(6)
V        = 6
Value    = 0
Ignorehitpause = 1

[State -2,ライフ]
Type     = VarSet
Trigger1 = MoveType = H
Trigger1 = Var(6) < 0 && Var(6) > -1-LifeMax
V        = 6
Value    = -Var(6)
Ignorehitpause = 1


