;==============================================================================
[Statedef -1];←この行は絶対に消さないでください。必須の項目です。
;==============================================================================

[State -1, Combo Condition Reset] ;初期化
type = VarSet
trigger1 = 1
var(1) = 0

[State -1, Combo Condition Check]
type = VarSet
triggerall = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,299]) || (stateno = [400,499])
trigger2 = movecontact
trigger3 = stateno = 52
var(1) = 1
ignorehitpause = 1

