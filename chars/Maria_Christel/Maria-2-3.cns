
;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------
;---OPTION--------------------------------------------------------------------

;勝利演出
[State -2, ]
type = varset
Trigger1 = 1
var(13) = 1	; 1:ON  0:OFF（シングル戦のみ）

;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------

[State -2, VarSet]
type = VarSet
trigger1 = Roundstate = 2
var(4) = enemy,GethitVar(hitcount)

[State -2, VarSet]
type = VarSet
triggerall = RoundState = 2
trigger1 = p2movetype != H
trigger2 = enemy,GethitVar(hitcount) = 0
var(4) = 0

;補正
[State -2, VarSet]
type = VarSet
trigger1 = Var(4) = 0
fvar(1) = 100.0;(%)

[State -2, VarSet]
type = VarSet
trigger1 = Var(4) = 1
fvar(1) = 80.0;(%)

[State -2, VarSet]
type = VarSet
trigger1 = Var(4) = 2
fvar(1) = 60.0;(%)

[State -2, VarSet]
type = VarSet
trigger1 = Var(4) = 3
fvar(1) = 40.0;(%)

[State -2, VarSet]
type = VarSet
trigger1 = Var(4) >= 4
fvar(1) = 20.0;(%)

[State -2, 相手の位置確認]
type = varset
trigger1 = 1
trigger1 = Ceil(P2Dist X) >= -10
var(5) = 0

[State -2, 相手の位置確認]
type = varset
trigger1 = 1
trigger1 = Ceil(P2Dist X) < -10
var(5) = 1

[State -2, varadd]
type = varadd
trigger1 = var(6) != 0
var(6) = -1

[State -2, varadd]
type = varadd
trigger1 = var(7) != 0
var(7) = -1

;---------------------------------------------------------------------------
;StateNo 5900について
;
;5900番のステートは、2試合目以降のラウンドコール中に呼び出されます。
;このステートでVarやFVarを初期化しています。
;なのでTurn Modeでは、初登場でも2試合目なのでイントロがありません。

[State -2, 二人目のイントロ]
type = ChangeState             ;二人目でもイントロを作る
value = 190                    ;イントロへ
triggerall = RoundsExisted = 0 ;自分が初参戦時
triggerall = TeamMode = Turns  ;ターンモード
trigger1 = stateno = 5900      ;5900番

[State -2, 勝利バグ解消]
type = CtrlSet                 ;歩きバグ対策
trigger1 = RoundState = 4      ;勝利ポーズ時
trigger1 = Win && Ctrl = 1     ;動ける場合
value = 0                      ;制御不能に

;----------------------------------------------------------------------------
;未完成な相手キャラによって、不具合が起きても自己解決するシステム(仮)

[State -2, Y座標自己修復]
type = PosSet
triggerall = RoundState = 2
trigger1 = stateno = [0,12]      ;立ち＆屈み時
trigger1 = floor(Pos Y) = [-2,3] ;立ち位置が僅かにずれていたらすぐ修正
y = 0

[State -2, Y座標自動修正]
type = PosAdd
triggerall = RoundState = 2
triggerall = Life < LifeMax  ;トレーニングでCtrl+Iを使うときに配慮
trigger1 = stateno = [0,30]  ;歩きも含める
trigger1 = floor(Pos Y) < -2 ;立ち位置が大きくずれていたら移動する
y = 2

[State -2, Y座標自動修正]
type = PosAdd
triggerall = RoundState = 2
triggerall = Life < LifeMax
trigger1 = stateno = [0,30]
trigger1 = floor(Pos Y) > 2 ;同じく
y = -2

;----------------------------------------------------------------------------
;♪
;----------------------------------------------------------------------------

;---------------------------------------------------------------------------------
[Statedef -3];常時監視ステート(p2statenoなどで相手に行動を制御された時は実行しない)
;---------------------------------------------------------------------------------

[State -3, ダメージボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Alive && GameTime % 2 = 0
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020
trigger2 = stateno = 5070 || stateno = 5080 || stateno = 5100
value = 6,0
channel = 0

[State -3, ガードボイス]
type = PlaySnd
triggerall = Time = 2
triggerall = Alive && GameTime % 3 = 0
trigger1 = stateno = 151 || stateno = 153 || stateno = 155
value = 6,1
channel = 0

