; HITG_SHAKE
[Statedef 12600]
type    = S
movetype= H
physics = N
velset = 0,0

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)



[State 12600, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),12600,12610) + GetHitVar(animtype)

[State 12600, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger2 = var(30) <= 0
value = 12630

[State 12600, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(12647 + GetHitVar(animtype)))
value = 12647 + GetHitVar(animtype) ;12651 - 4 + type

[State 12600, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 12600, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 12600, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 12601 ;HITG_SLIDE

[State 12600, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger2 = var(30) <= 0
value = 12630

[State 12600, FFB Light]
type = ForceFeedback
trigger1 = anim = 12600
trigger2 = anim = 12610
persistent = 0
time = 6
waveform = square

[State 12600, FFB Medium]
type = ForceFeedback
trigger1 = anim = 12601
trigger2 = anim = 12611
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 12600, FFB Hard]
type = ForceFeedback
trigger1 = anim = 12612
trigger2 = anim = 12602
trigger3 = anim = 12630
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

