; HITA_FALL (knocked up, falling)
[Statedef 12650]
type    = A
movetype= H
physics = N

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)



[State 126126, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 12635
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 12635
trigger2 = (Anim != [12651, 12659]) && (Anim != [12661, 12669])
trigger2 = Anim != 12690 ;Not if hit off ground anim
value = 12650

[State 12650, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [12650,12659]
trigger1 = Vel Y >= ifelse(anim = 12650, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 12650, 3] ;Gravity
