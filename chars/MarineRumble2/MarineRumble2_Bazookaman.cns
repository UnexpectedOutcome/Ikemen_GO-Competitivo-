;---------------------------------------------------------------------------
; Walk adelante
[Statedef 12020]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x)

[State 0, PlaySnd]
type = PlaySnd
triggerall = Anim = 12020
trigger1 = Animelem = 3
value = S40,0
volume = 50

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = (Anim != 12020 && Anim != 12005)
trigger2 = (Anim = 12005) && AnimTime = 0
value = 12020

[State 0, Golpes]
type = ChangeState
trigger1 = time%50 = 0 && random = [200,300]
value = ifelse(random >= 250, 12300,12200)
ctrl = 1

[State 100:		ChangeState]
type			= ChangeState
trigger1		= time > 20+(random%40)
trigger2		= time = 60
value			= 12000




;---------------------------------------------------------------------------
; Walk Atras
