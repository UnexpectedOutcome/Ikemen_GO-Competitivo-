[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 12011

;---------------------------------------------------------------------------
; Crouching
[Statedef 12011]
type    = C
physics = C
anim = 12011
sprpriority = 0
velset = (PrevStateno = 9000)* 0,(PrevStateno = 9000)* 0
facep2 = !(PrevStateno = 9000)
ctrl = 1

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 12011


