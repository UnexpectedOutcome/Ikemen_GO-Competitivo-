[statedef -2]
;===============================================================================
;option
;===============================================================================
[State -3,AIレベル]
type = varset
triggerall = !ishelper
Trigger1 = 1
v = 16
value = 5;AIのレベル設定が出来ます(1:Easy 2:normal 3:MVS 4:HARD 5:CRAZY(default) 6:KOMBAT)

[State -3,AI常時起動]
type = varset
triggerall = !ishelper
Trigger1 = 1
v = 17
value = 0;1以上でAI常時起動

[State -3,ガーキャンレベル]
type = varset
triggerall = var(59)
Trigger1 = 1
v = 58
value = 2;(1～3でつけられます)

;===============================================================================
;option END
;===============================================================================
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; 空ガ封印
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[State -2, 空ガ封印]
type = assertspecial
trigger1 = 1
flag = noairguard
ignorehitpause = 1
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;先行入力向き修正変数
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2, 向き修正]
type     = Varset
triggerall = !ishelper
triggerall = var(2)=1
trigger1 = (stateno!=52)&&(stateno!=0)&&(stateno!=100)&&(stateno!=105)&&(stateno!=20)
trigger2 = (stateno=100)||(stateno=105)||(stateno=20)
trigger2 = time>1
;trigger1 = ifelse(stateno=0,time>1,0)
var(2) = 0
IgnoreHitPause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;補正セット・リセット
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

;fvar(0) = 補正総合値
;fVar(1) = 技数補正

;-------------------------------------------------[技数補正]

[state -2, 補正用statenoバッファ]
type     = varset
trigger1 = movetype != A
trigger1 = !movehit
trigger1 = hitcount = 0
v = 15
value = 0
ignorehitpause = 1

[State -2, 技数カウント加算]
type     = varadd
trigger1 = hitcount = 1
trigger1 = movehit = 1
trigger1 = var(15) != 0
trigger1 = var(15) < 10000
trigger1 = var(15) := var(15)+10000
var(14) = 1
ignorehitpause = 1

[State -2, 技数カウント解除]
type     = Varset
trigger1 = !numtarget
trigger1 = P2MoveType != H || p2stateno = [120,155]
var(14) = 0
IgnoreHitPause = 1

[State -2, VarSet];初期値は100％（リセット）
Type     = VarSet
trigger1 = !numtarget
trigger1 = P2MoveType != H || p2stateno = [120,155]
trigger2 = var(14) <= 1
fvar(1)  = 1.0
IgnoreHitPause = 1

[State -2, Varset]
Type     = VarSet
triggerall = movetype != A || time = 1 || movetype = A && !movehit && hitcount = 0
trigger1 = var(14) > 0
fvar(1) = 1.0*(10-var(14))/10.0
ignorehitpause = 1

[State -2, VarSet];最小値は10％
Type     = VarSet
Trigger1 = FVar(1) < 0.1
fvar(1)  = 0.1
IgnoreHitPause = 1

;-------------------------------------------------[補正総合]

[State -2, 変数]
Type     = VarSet
Trigger1 = 1
fvar(0)  = fvar(1)
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; デバッグ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[State -2, デバッグ管理]
type = displayToClipboard
text = "BS=%d,GC=%d,katame=%d,shake=%d\n"
params = var(47),var(40) , var(21) , var(41)
trigger1 =1
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;空中追い打ち判定
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2, 一部追撃可能]
type = VarSet
triggerall = var(1) = 0
triggerall = NumTarget
triggerall = (Target,StateNo = [5020,5099]) || (Target,StateNo = [19070,19071]) || ((var(54)%128)/64 = 1 && (enemy,stateno = [19020,19040]))
triggerall = Target,StateType = A
triggerall = Target,NumPartner = 0
trigger1   = NumTarget(440);スラ
var(1) = 1
ignorehitpause = 1

[State -2, 制限リセット]
type = VarSet
triggerall = Var(1) != 0
trigger1 = enemy,statetype != A
var(1) = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ガーキャン
