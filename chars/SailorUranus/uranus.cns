;---------------------------------------------------------------------------
; SGUARDHIT (shaking)
[Statedef 150]
type    = S
movetype= H
physics = N
velset = 0,0

[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150

;-------------------------------------------------[ガーキャン]
[state 200, ガーキャン変数・超必殺]
type     = varset
triggerall = var(59)<=0
trigger1 = power>=3000
trigger1 = command = "car"||(Helper(1*9),var(40)&63)
v = 20
value = 3000

[state 200, ガーキャン変数・一回転強]
type     = varset
triggerall = var(59)<=0
trigger1 = Command = "rollb"  ||(Helper(1*9),var(40)&4032)
v = 20
value = 1250

[state 200, ガーキャン変数・一回転弱]
type     = varset
triggerall = var(59)<=0
trigger1 = Command = "rolla"  ||(Helper(1*9),var(40)&258048) 
v = 20
value = 1200

[state 200, ガーキャン変数・シェイク強]
type     = varset
triggerall = var(59)<=0
Triggerall = (!numhelper(1000))&&(!numhelper(1050))
trigger1 = Command = "632y" ||(Helper(1*9),var(40)&16515072)
v = 20
value = 1050

[state 200, ガーキャン変数・シェイク弱]
type     = varset
triggerall = var(59)<=0
Triggerall = (!numhelper(1000))&&(!numhelper(1050))
trigger1 = command = "632x"||(Helper(1*9),var(40)&1056964608)
v = 20
value = 1000

[state 200, ガーキャン変数・ソード強]
type     = varset
triggerall = var(59)<=0
Triggerall = (!numhelper(1100))&&(!numhelper(1150))
trigger1 = Command = "236y" ||(Helper(1*9),var(41)&63)
v = 20
value = 1150

[state 200, ガーキャン変数・ソード弱]
type     = varset
triggerall = var(59)<=0
Triggerall = (!numhelper(1100))&&(!numhelper(1150))
trigger1 = Command = "236x" ||(Helper(1*9),var(41)&4032)
v = 20
value = 1150

[state 200, ガーキャン変数・ダッシュ]
type     = varset
triggerall = var(59)<=0
trigger1 = command = "FF"||(Helper(1*9),var(11)&31)
v = 20
value = 100

[state 200, ガーキャン変数・バクスキ]
type     = varset
triggerall = var(59)<=0
trigger1 = command = "BB"||(Helper(1*9),var(11)&992)
v = 20
value = 105

;----------------------------------------------------

[State 150, 2]
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")

[State 140, Hi to Lo]
type = StateTypeSet
TriggerAll=Statetype = S
Trigger1 = var(59)<=0
