;---------------------------------------------------------------------------
;ダッシュ
[Statedef 100]
type    = A
physics = N
ctrl = 0
anim = 100 
sprpriority = 1

[State 191, 3]
type = PlaySnd
trigger1 = time = 0
value = s100,0

[State 100, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.fwd.x)
y = const(velocity.run.fwd.y)

[State 100, 2]
type = VelAdd
trigger1 = Time >= 1
y = const(movement.yaccel)

[State 100, 3]
type = ChangeState
triggerall = time > 5
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 101

