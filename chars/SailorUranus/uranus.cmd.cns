TriggerAll = command  = "y"||(Helper(1*9),var(10)&32505856)  ;
triggerall = command  = "holdback"
triggerall = command  != "holddown"
TriggerAll = statetype != A
Trigger1   = Ctrl

[state -1, 810]
type  = ChangeState
value = 810
triggerall = !ishelper
