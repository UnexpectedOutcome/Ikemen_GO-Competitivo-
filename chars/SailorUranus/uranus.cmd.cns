Triggerall = P2Bodydist X<=10
TriggerAll = command = "b"||(Helper(1*9),var(10)&992)
triggerall = command  = "holdfwd"
triggerall = command  != "holddown"
TriggerAll = statetype != A
Trigger1   = Ctrl

[state -1, 830]
type  = ChangeState
value = 830
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
Triggerall = P2Bodydist X<=10
TriggerAll = command = "b"||(Helper(1*9),var(10)&992)
triggerall = command  = "holdback"
triggerall = command  != "holddown"
TriggerAll = statetype != A
Trigger1   = Ctrl

;----------------------------------------------------------------------------------------------------------------
[state -1, 400]
type  = ChangeState
value = 400
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
TriggerAll = command = "x"||(Helper(1*9),var(10)&1015808)   ;
TriggerAll = command  = "holddown"
TriggerAll = statetype != A
Trigger1   = Ctrl
trigger2   = (StateNo = 400) && (time > 9)

[state -1, 410]
type  = ChangeState
value = 410
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
TriggerAll = command = "y"||(Helper(1*9),var(10)&32505856)  ;
TriggerAll = command  = "holddown"
TriggerAll = statetype != A
Trigger1   = Ctrl
trigger2   = (StateNo = 400) && (time > 9)
trigger3   = (StateNo = 430) && (time > 10)

[state -1, 430]
type  = ChangeState
value = 430
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
TriggerAll = command = "a"||(Helper(1*9),var(10)&31)
TriggerAll = command  = "holddown"
TriggerAll = statetype != A
Trigger1   = Ctrl
trigger2   = (StateNo = 400) && (time > 9)
