; 下の記述↓は絶対に消さないでください。
[Statedef -1]

;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;(1*9)は、9のヘルパーがあったら他の数値に置換。
;62000～62999も既にあるなら置換。

[State -1];-1ステートへ置く。
Type = ChangeState
Trigger1 = Ishelper(1*9)
value = 62000+200 ;減算処理ステート
ctrl = 0

[State -1,先行入力認識];-1ステートへ置く。
Type = Helper
Trigger1 = !NumHelper(1*9)
ID = (1*9)
Pos = 0,0;
StateNo = 62000 ;
OwnPal = 1
KeyCtrl = 1
Size.XScale = 0
Size.YScale = 0
SuperMoveTime = 999999999 ;SuperPause中に動ける時間
PauseMoveTime = 999999999 ;Pause中に動ける時間

;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;----------------------------------------------------------------------------
[state -1, デストラクティブ・カーニバル]
type  = ChangeState
value = 3000
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
Triggerall = power>=3000
TriggerAll = Command = "car"||(Helper(1*9),var(40)&63)
TriggerAll = statetype != A
Trigger1   = Ctrl
trigger2   = (stateno=[200,240])&&movecontact=[1,3]
trigger3   = (stateno=[400,440])&&movecontact=[1,3]
trigger4   = (stateno=151)||(stateno=153)

;----------------------------------------------------------------------------
[state -1, 弱ダイビング・ガイア・クラッシュ]
type  = ChangeState
value = 1200
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
TriggerAll = Command = "rolla"  ||(Helper(1*9),var(40)&258048)   ;一回転弱
TriggerAll = statetype != A
Trigger1   = Ctrl||stateno=40
trigger2   = (stateno=151)||(stateno=153)

[state -1, 強ダイビング・ガイア・クラッシュ]
type  = ChangeState
value = 1250
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
TriggerAll = Command = "rollb"  ||(Helper(1*9),var(40)&4032)
TriggerAll = statetype != A
Trigger1   = Ctrl||stateno=40
trigger2   = (stateno=151)||(stateno=153)

[state -1, 弱ワールドシェイキング]
type  = ChangeState
value = 1000
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
Triggerall = (!numhelper(1000))&&(!numhelper(1050))
TriggerAll = command = "632x"||(Helper(1*9),var(40)&1056964608)
TriggerAll = statetype != A
Trigger1   = Ctrl
trigger2   = (stateno=[200,240])&&movecontact=[1,3]
trigger3   = (stateno=[400,440])&&movecontact=[1,3]
trigger4   = (stateno=151)||(stateno=153)

[state -1, 強ワールドシェイキング]
type  = ChangeState
value = 1050
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
Triggerall = (!numhelper(1000))&&(!numhelper(1050))
TriggerAll = Command = "632y" ||(Helper(1*9),var(40)&16515072)
TriggerAll = statetype != A
Trigger1   = Ctrl
trigger2   = (stateno=[200,240])&&movecontact=[1,3]
trigger3   = (stateno=[400,440])&&movecontact=[1,3]
trigger4   = (stateno=151)||(stateno=153)

[state -1, 弱スペースソードブラスター]
type  = ChangeState
value = 1100
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
Triggerall = (!numhelper(1100))&&(!numhelper(1150))
TriggerAll = Command = "236x" ||(Helper(1*9),var(41)&4032)
TriggerAll = statetype != A
Trigger1   = Ctrl
trigger2   = (stateno=[200,240])&&movecontact=[1,3]
trigger3   = (stateno=[400,440])&&movecontact=[1,3]
trigger4   = (stateno=151)||(stateno=153)

[state -1, 強スペースソードブラスター]
type  = ChangeState
value = 1150
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
Triggerall = (!numhelper(1100))&&(!numhelper(1150))
TriggerAll = Command = "236y" ||(Helper(1*9),var(41)&63)
TriggerAll = statetype != A
Trigger1   = Ctrl
trigger2   = (stateno=[200,240])&&movecontact=[1,3]
trigger3   = (stateno=[400,440])&&movecontact=[1,3]
trigger4   = (stateno=151)||(stateno=153)

;---------------------------------------------------------------------------
;ダッシュ
[State -1, Run Fwd]
type = ChangeState
value = 100
triggerall = var(59)<=0
triggerall = (command = "FF"||ifelse(var(2)=0,(Helper(1*9),var(11)&31),(Helper(1*9),var(11)&992)))
triggerall = statetype != A
trigger1 = statetype = S && ctrl
trigger1 = stateno != [100,109]
trigger2 = (stateno=[200,240])&&movecontact=[1,3]
trigger3 = (stateno=[400,440])&&movecontact=[1,3]
trigger4   = (stateno=151)||(stateno=153)

;後退ダッシュ
[State -1, Run Back]
type = ChangeState
value = 105
triggerall = var(59)<=0
triggerall = command = "BB"||ifelse(var(2)=0,(Helper(1*9),var(11)&992),(Helper(1*9),var(11)&31))
triggerall = statetype != A
trigger1 = statetype = S && ctrl
trigger1 = stateno != [100,109]
trigger2   = (stateno=[200,240])&&movecontact=[1,3]
trigger3   = (stateno=[400,440])&&movecontact=[1,3]
trigger4   = (stateno=151)||(stateno=153)

;挑発
[State -1, taunt]
type = ChangeState
value = 195
triggerall = var(59)<=0
trigger1 = command = "s"
trigger1 = statetype = S
trigger1 = ctrl
trigger1 = stateno != [100,109]

;----------------------------------------------------------------------------------------------------------------
[state -1, 800]
type  = ChangeState
value = 800
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
TriggerAll = !var(59)
Triggerall = P2Bodydist X<=10
TriggerAll = command  = "y"||(Helper(1*9),var(10)&32505856)  ;
triggerall = command  = "holdfwd"
triggerall = command  != "holddown"
TriggerAll = statetype != A
Trigger1   = Ctrl

[state -1, 820]
type  = ChangeState
value = 820
triggerall = !ishelper
triggerall = alive
triggerall = roundstate = 2
