;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]

[state -2, アラド風空中制御 on/off] ;0でON
type = varset
trigger1 = 1
fv = 11
value = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; ダメージ調整関係
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ここのvalueでクールタイム、ダメージ比率など色々と変化します。

;■時間系統■
;時間系統は整数にしないと色々と不具合が出ます。 "value = 60" で1秒

[State -2, 史上最強のローキック クールタイム定義]   
type = varset
trigger1 = 1
fv = 14
value = 3600
;デフォルト 3600

[State -2, マッスルシフト クリ率増加時間定義] ;クールタイム兼 
type = varset
trigger1 = 1
fv = 15
value = 300
;デフォルト 300

[State -2, マッスルシフト持続時間定義]
type = varset
trigger1 = 1
fv = 16
value = 1200
;デフォルト 1200

[State -2, マッスルシフト キャンセル可能回数定義]   
type = varset
trigger1 = 1
v = 31
value = 7
;デフォルト 7
;「value -1 = 回数」となっています。回数変更させた場合、カウンターの数値は正常に稼動しなくなります。
;AIもデフォルトの7で組んでるので、数値変えるとAIが怪しい動きになるかもしれません。


;■ランダムダメージ■
;デフォルトのダメージ揺れ幅は85～115
;実際のダメージには「(85～115)*0.01」が乗算されます。
[State -2, ダメージ変動値　最小値]
type = varset
trigger1 = 1
v = 14
value = 85

[State -2, ダメージ変動値　最大値]
type = varset
trigger1 = 1
v = 15
value = 115

;デフォルトのコンボ後の最小値は25～55
[State -2, ランダムダメージ]
type = VarRandom
trigger1 = Stateno !=[3000,4100]
;trigger1 = enemynear,Statetype != A || var(47) >= 1
v = 29
;与えているダメージが3割を超えると、ダメージ倍率が徐々に下がっていくように設定してあります。
;range = floor(ifelse((fvar(20)>0.3),ifelse(var(14)-(fvar(20)*200-60) <25, 25, var(14)-(fvar(20)*200-60)), var(14))), floor(ifelse((fvar(20)>0.3),ifelse(var(15)-(fvar(20)*200-60) <55, 55, var(15)-(fvar(20)*200-60)), var(15)))
;fvar(20) = コンボ中に相手に与えているダメージの割合 （最大HPからの比較）
;「ifelse(fvar(20)>0.3～～)」＝「相手に3割以上ダメージを与えていたら～」
range = ifelse(var(14)-ceil((hitcount*hitcount*0.4)-1) <25,25,var(14)-ceil((hitcount*hitcount*0.4)-1)),ifelse(var(15)-ceil((hitcount*hitcount*0.4)-1) <55,55,var(15)-ceil((hitcount*hitcount*0.4)-1))

[State -2, ランダムダメージ]
type = null;VarRandom
trigger1 = Stateno !=[3000,4100]
trigger1 = enemynear,Statetype = A && var(47) = 0
v = 29
range = var(14) - hitcount**3,var(15) - hitcount**3;ifelse(var(14)-ceil(((hitcount**2)*(1+(hitcount*0.3)))-1) <25,25,var(14)-ceil(((hitcount**2)*(1+(hitcount*0.3)))-1)),ifelse(var(15)-ceil(((hitcount**2)*(1+(hitcount*0.3)))-1) <55,55,var(15)-ceil(((hitcount**2)*(1+(hitcount*0.3)))-1))

[State -2, ランダムダメージ]
type = VarRandom
trigger1 = Stateno =[3000,4100]
v = 29
range = ifelse(var(14)-ceil((hitcount*hitcount*0.2)-1) <25,25,var(14)-ceil((hitcount*hitcount*0.2)-1)),ifelse(var(15)-ceil((hitcount*hitcount*0.2)-1) <55,55,var(15)-ceil((hitcount*hitcount*0.2)-1))

;■最強ロー発動可能状態時の攻撃力上昇■
;最強ローが撃てる状態になったらパワーゲージ量に応じて攻撃力増加
;Lv0 = 1.1   (Power [0,999])
;Lv1 = 1.15  (Power [1000,1999])
;Lv2 = 1.25  (Power [2000,2999])
;Lv3 = 1.4   (Power [3000])
;※投げ系統の攻撃にはこのダメージ増加は適用されません。該当するスキルは以下のもの。
;「ロープリング」「スープレックス」「スパイラルハンマー」「ブレイキングエルボー」「スパイア」「ワイルドマウント」
[State -2, 攻撃力上昇数値];パワー3000
type = varset
trigger1 = var(56) = 1
trigger1 = power = 3000
fv = 6
value = 1.4
persistent = 1
ignorehitpause = 1

[State -2, 攻撃力上昇数値];パワー2000以上
type = varset
trigger1 = var(56) = 1
trigger1 = power = [2000,2999]
fv = 6
value = 1.25
persistent = 1
ignorehitpause = 1

[State -2, 攻撃力上昇数値];パワー1000以上
type = varset
trigger1 = var(56) = 1
trigger1 = power = [1000,1999]
fv = 6
value = 1.15
persistent = 1
ignorehitpause = 1

[State -2, 攻撃力上昇数値];パワー1000未満
type = varset
trigger1 = var(56) = 1
trigger1 = power < 1000
fv = 6
value = 1.1
persistent = 1
ignorehitpause = 1

[State -2, 攻撃力上昇];最強ロー
type = AttackMulSet
trigger1 = var(56) = 1
value = fvar(6)

[State -2, 攻撃力上昇];何もなし
type = AttackMulSet
trigger1 = var(56) = 0
value = 1.0

;■クリティカル■
;クリティカル設定は特殊な扱いをしています。
;ダメージを与えた瞬間にクリティカルの合否を判定すると、ダメージ表示の演出と誤差が発生するため、
;クリティカルが発生するタイミングを固定し、ダメージ表示の演出と同期するようにしてあります。
;「var(30)=15」になったときクリティカル発動となっています。
;攻撃を当てるたびに「var(30)」の値が加算され、var(30)の値が15を超えると、その直後にランダムで0～14を引きます。
;マッスルシフト後の5秒間はこのとき引かれる数値が13～14に設定してあり、たぶんクリ率75%くらいとなっています。
;var(47) = 2  (マッスル後5秒間クリ率増加)
[State -2, ランダムクリティカル]
type = Varset
trigger1 = var(47) = 2
trigger1 = var(30) < 13
v = 30
value = ifelse(random <500,13,14)
ignorehitpause = 1
;デフォルト ifelse(random <500,13,14)

[State -2, ランダムクリティカル]
type = VarRandom
trigger1 = var(30) >= 15
trigger2 = roundstate != 2
v = 30
range = ifelse(var(47) = 2, 13, 0) , 14
ignorehitpause = 1
;デフォルト ifelse(var(47) = 2, 13, 0) , 14

[State -2, クリティカルダメージ倍率定義]
type = varset
trigger1 = 1
fv = 17
value = 1.5
;デフォルト 1.5

[State -2, ランダムクリティカル]
type = VarAdd
triggerall = stateno != 3120
triggerall = stateno != [3600,3606]
triggerall = stateno != 810
triggerall = stateno != 840
triggerall = stateno != 1400
triggerall = stateno != 1407
triggerall = stateno != [1700,1701]
trigger1 = movehit = 1
trigger2 = projhit(1305) = 1
v = 30
value = 1

