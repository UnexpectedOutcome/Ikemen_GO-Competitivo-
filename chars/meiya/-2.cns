;アラド風浮き調整用　コンボ中に与えたダメージ量の比率計算

[State -2, 相手初期HP];浮き設定
type = varset
trigger1 = roundstate = 0
fv = 22
value = P2Life
persistent = 1
ignorehitpause = 1

[State -2, 相手現在HP];浮き設定
type = varset
trigger1 = Enemynear,Movetype != H
fv = 21
value = P2Life
persistent = 1
ignorehitpause = 1

[State -2, 与ダメージ比率];浮き設定
type = varset
trigger1 = Enemynear,Movetype = H
fv = 20
value = (fvar(21)-(P2Life))/fvar(22)
persistent = 1
ignorehitpause = 1

