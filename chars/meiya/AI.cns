[State -3, パワー溜め中 - ガード];パワー溜め削除？
type = ChangeState
Value = 120
triggerall = (Alive) && Enemynear,Alive
triggerall = (NumEnemy)
triggerall = var(59) = 1 && RoundState = 2
triggerall = ctrl ;||stateno = 700
trigger1 = var(55) = 0
Trigger1 = InGuardDist
Trigger1 =! EnemyNear,HitDefAttr = ,NT,ST,HT   ;投げ属性以外の攻撃にのみ
Trigger1 = Random = [0,100]
trigger2 = var(55) = 0
Trigger2 = Enemy,NumHelper > 0           ;相手が出したHelperが一個以上あるとき
Trigger2 = Enemy,NumHelper > Var(5)      ;相手が出したHelperがラウンド開始時よりも多いとき
Trigger2 = InGuardDist                   ;自分がガード可能なとき
Trigger2 = Random = [0,300]
trigger3 = var(55) = 1
Trigger3 = InGuardDist
Trigger3 =! EnemyNear,HitDefAttr = ,NT,ST,HT   ;投げ属性以外の攻撃にのみ
Trigger3 = Random = [0,600]
trigger4 = var(55) = 1
Trigger4 = Enemy,NumHelper > 0           ;相手が出したHelperが一個以上あるとき
Trigger4 = Enemy,NumHelper > Var(5)      ;相手が出したHelperがラウンド開始時よりも多いとき
Trigger4 = InGuardDist                   ;自分がガード可能なとき
Trigger4 = Random = [0,700]

[State -3, 打撃ガード]
Type = ChangeState
Value = 120
triggerall = (Alive) && Enemynear,Alive
triggerall = (NumEnemy)
triggerall = var(59) = 1 && RoundState = 2
TriggerAll = stateno = 700 || ctrl
trigger1 = var(55) = 0
Trigger1 =! EnemyNear,HitDefAttr = ,NT,ST,HT ;投げ属性以外の攻撃にのみ
Trigger1 = InGuardDist
Trigger1 = Random = [0,900]
trigger2 = var(55) = 1
Trigger2 =! EnemyNear,HitDefAttr = ,NT,ST,HT ;投げ属性以外の攻撃にのみ
Trigger2 = InGuardDist
Trigger2 = Random = [0,950]

[State -3, 打撃ガード検証用]
Type = null;ChangeState
